@{
    ViewData["Title"] = "Urunler";
}

<section class="panel-card" id="menuProductsApp">
    <div class="panel-card-header">
        <div>
            <h2>Menu urunleri</h2>
            <p>Fiyat, gorsel, alerjen ve stok durumlari buradan yonetilecek.</p>
        </div>
        <button class="btn btn-dark" type="button" data-bind="click: addProduct"><i class="bi bi-plus-lg me-1"></i>Urun Ekle</button>
    </div>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Urun</th>
                    <th>Kategori</th>
                    <th>Fiyat</th>
                    <th>Alerjen</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody data-bind="foreach: products">
                <tr>
                    <td data-bind="text: name"></td>
                    <td data-bind="text: category"></td>
                    <td data-bind="text: price"></td>
                    <td data-bind="text: allergens"></td>
                    <td><span class="badge" data-bind="text: status, css: badge"></span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-dark" type="button" data-bind="click: $parent.editProduct"><i class="bi bi-pencil"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script src="~/js/MenuProducts.js" asp-append-version="true"></script>
}
