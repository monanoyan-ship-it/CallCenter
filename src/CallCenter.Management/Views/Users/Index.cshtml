@{
    ViewData["Title"] = "Kullanicilar";
}

<div id="users-vm">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Kullanici Adi</th>
                            <th>Ad Soyad</th>
                            <th>Rol</th>
                            <th>Dahili</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: users">
                        <tr>
                            <td data-bind="text: id"></td>
                            <td data-bind="text: username"></td>
                            <td><strong data-bind="text: fullName"></strong></td>
                            <td><span class="badge bg-info" data-bind="text: roleName"></span></td>
                            <td data-bind="text: extension || '-'"></td>
                            <td>
                                <span class="badge" data-bind="text: isActive ? 'Aktif' : 'Pasif', css: isActive ? 'bg-success' : 'bg-danger'"></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="text-center py-4" data-bind="visible: isLoading">
                <div class="spinner-border spinner-border-sm text-primary"></div> Yukleniyor...
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function UsersViewModel() {
    var self = this;
    self.users = ko.observableArray([]);
    self.isLoading = ko.observable(true);

    self.loadData = function() {
        self.isLoading(true);
        $.get('/proxy/users', function(data) {
            var items = Array.isArray(data) ? data : (data.items || data.data || []);
            self.users(items);
        }).always(function() {
            self.isLoading(false);
        });
    };

    self.loadData();
}

ko.applyBindings(new UsersViewModel(), document.getElementById('users-vm'));
</script>
}
