<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CorpLynk Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        :root { --sidebar-width: 250px; }
        body { font-family: 'Segoe UI', system-ui, sans-serif; background: #f0f2f5; }
        .sidebar {
            width: var(--sidebar-width); height: 100vh; position: fixed; top: 0; left: 0;
            background: linear-gradient(180deg, #1a2332 0%, #0f1923 100%);
            color: #fff; overflow-y: auto; z-index: 1000;
        }
        .sidebar .brand { padding: 1rem; font-size: 1.1rem; font-weight: 700; border-bottom: 1px solid rgba(255,255,255,.1); }
        .sidebar .brand span { color: #64b5f6; }
        .sidebar .nav-link { color: rgba(255,255,255,.7); padding: .6rem 1rem; font-size: .875rem; border-radius: 6px; margin: 2px 8px; }
        .sidebar .nav-link:hover { color: #fff; background: rgba(255,255,255,.1); }
        .sidebar .nav-link.active { color: #fff; background: rgba(100,181,246,.2); }
        .sidebar .nav-group-toggle {
            display: flex; align-items: center; width: 100%; padding: .6rem 1rem;
            color: rgba(255,255,255,.5); background: none; border: none;
            font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; cursor: pointer;
        }
        .sidebar .nav-group-toggle:hover { color: rgba(255,255,255,.7); }
        .sidebar .nav-group-toggle span { flex: 1; text-align: left; }
        .sidebar .nav-group-toggle .chevron { font-size: .6rem; transition: transform .2s ease; opacity: .5; }
        .sidebar .nav-group-toggle .chevron.open { transform: rotate(180deg); }
        .sidebar .nav-group-items { max-height: 0; overflow: hidden; transition: max-height .25s ease; }
        .sidebar .nav-group-items.show { max-height: 500px; }
        .content-area { margin-left: var(--sidebar-width); padding: 1.5rem; min-height: 100vh; }
        .topbar {
            background: #fff; border-bottom: 1px solid #e0e0e0; padding: .6rem 1.5rem;
            margin: -1.5rem -1.5rem 1.5rem; display: flex; align-items: center; justify-content: space-between;
        }
        .stat-card { border: none; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,.06); }
        .stat-card .stat-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    @if (Context.Session.GetString("Token") != null)
    {
        var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var custOpen = ctrl is "Customers" or "Users" or "Organizations" or "Personnel";
        var modOpen = ctrl is "Modules";
        // SIP & Cagri Yonetimi kaldirildi — musteri tarafinda yonetiliyor
        var sysOpen = ctrl is "Settings" or "Translations" or "AuditLogs" or "StorageConfig" or "EmailTemplates" or "PaymentConfig";
        var finOpen = ctrl is "ServiceManagement" or "BillingReport";
        var kvkkOpen = ctrl is "Kvkk";
        var advOpen = ctrl is "Licensing" or "Notifications";

        <nav class="sidebar d-print-none">
            <div class="brand">
                <i class="bi bi-gear-wide-connected me-2"></i>CorpLynk <span>Management</span>
            </div>

            <!-- Dashboard -->
            <a class="nav-link mt-2 @(ctrl == "Home" ? "active" : "")" href="/">
                <i class="bi bi-speedometer2 me-2"></i>Dashboard
            </a>

            <!-- Musteri Yonetimi -->
            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span>Musteri Yonetimi</span><i class="bi bi-chevron-down chevron @(custOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(custOpen ? "show" : "")">
                <a class="nav-link @(ctrl == "Customers" ? "active" : "")" href="/Customers"><i class="bi bi-building me-2"></i>Musteriler</a>
                <a class="nav-link @(ctrl == "Users" ? "active" : "")" href="/Users"><i class="bi bi-people me-2"></i>Kullanicilar</a>
                <a class="nav-link @(ctrl == "Organizations" ? "active" : "")" href="/Organizations"><i class="bi bi-diagram-3 me-2"></i>Organizasyonlar</a>
                <a class="nav-link @(ctrl == "Personnel" ? "active" : "")" href="/Personnel"><i class="bi bi-person-badge me-2"></i>Personel</a>
            </div>

            <!-- Odeme Takibi -->
            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span>Odeme Takibi</span><i class="bi bi-chevron-down chevron @(modOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(modOpen ? "show" : "")">
                <a class="nav-link @(ctrl == "Modules" && act == "CallCenter" ? "active" : "")" href="/Modules/CallCenter"><i class="bi bi-telephone me-2"></i>Call Center</a>
                <a class="nav-link @(ctrl == "Modules" && act == "Salon" ? "active" : "")" href="/Modules/Salon"><i class="bi bi-scissors me-2"></i>Salon</a>
                <a class="nav-link @(ctrl == "Modules" && act == "Pricing" ? "active" : "")" href="/Modules/Pricing"><i class="bi bi-tags me-2"></i>Modul Fiyatlari</a>
                <a class="nav-link @(ctrl == "Modules" && act == "Requests" ? "active" : "")" href="/Modules/Requests"><i class="bi bi-inbox me-2"></i>Modul Talepleri</a>
                <a class="nav-link @(ctrl == "Modules" && act == "Inventory" ? "active" : "")" href="/Modules/Inventory"><i class="bi bi-clipboard-check me-2"></i>Modul Envanteri</a>
                <a class="nav-link @(ctrl == "Modules" && act == "Roles" ? "active" : "")" href="/Modules/Roles"><i class="bi bi-shield-lock me-2"></i>Rol Yonetimi</a>
                <a class="nav-link @(ctrl == "Modules" && act == "Subscriptions" ? "active" : "")" href="/Modules/Subscriptions"><i class="bi bi-credit-card me-2"></i>Abonelikler</a>
            </div>

            <!-- Sistem -->
            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span>Sistem</span><i class="bi bi-chevron-down chevron @(sysOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(sysOpen ? "show" : "")">
                <a class="nav-link @(ctrl == "Settings" ? "active" : "")" href="/Settings"><i class="bi bi-gear me-2"></i>Ayarlar</a>
                <a class="nav-link @(ctrl == "Translations" ? "active" : "")" href="/Translations"><i class="bi bi-translate me-2"></i>Dil Yonetimi</a>
                <a class="nav-link @(ctrl == "AuditLogs" ? "active" : "")" href="/AuditLogs"><i class="bi bi-journal-text me-2"></i>Denetim Kayitlari</a>
                <a class="nav-link @(ctrl == "StorageConfig" ? "active" : "")" href="/StorageConfig"><i class="bi bi-cloud me-2"></i>Depolama</a>
                <a class="nav-link @(ctrl == "PaymentConfig" ? "active" : "")" href="/PaymentConfig"><i class="bi bi-credit-card me-2"></i>Odeme Ayarlari</a>
                <a class="nav-link @(ctrl == "EmailTemplates" ? "active" : "")" href="/EmailTemplates"><i class="bi bi-envelope-paper me-2"></i>Email Taslaklari</a>
            </div>

            <!-- Finans -->
            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span>Finans</span><i class="bi bi-chevron-down chevron @(finOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(finOpen ? "show" : "")">
                <a class="nav-link @(ctrl == "ServiceManagement" ? "active" : "")" href="/ServiceManagement"><i class="bi bi-box-seam me-2"></i>Hizmet Yonetimi</a>
                <a class="nav-link @(ctrl == "BillingReport" ? "active" : "")" href="/BillingReport"><i class="bi bi-receipt me-2"></i>Faturalama</a>
            </div>

            <!-- KVKK -->
            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span>KVKK</span><i class="bi bi-chevron-down chevron @(kvkkOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(kvkkOpen ? "show" : "")">
                <a class="nav-link @(ctrl == "Kvkk" && act == "Index" ? "active" : "")" href="/Kvkk"><i class="bi bi-shield me-2"></i>Dashboard</a>
                <a class="nav-link @(act == "PrivacyNotices" ? "active" : "")" href="/Kvkk/PrivacyNotices"><i class="bi bi-file-text me-2"></i>Aydinlatma</a>
                <a class="nav-link @(act == "Consents" ? "active" : "")" href="/Kvkk/Consents"><i class="bi bi-check-circle me-2"></i>Rizalar</a>
                <a class="nav-link @(act == "Requests" ? "active" : "")" href="/Kvkk/Requests"><i class="bi bi-envelope me-2"></i>Basvurular</a>
                <a class="nav-link @(act == "Breaches" ? "active" : "")" href="/Kvkk/Breaches"><i class="bi bi-exclamation-triangle me-2"></i>Ihlaller</a>
                <a class="nav-link @(act == "Transfers" ? "active" : "")" href="/Kvkk/Transfers"><i class="bi bi-globe me-2"></i>Aktarimlar</a>
                <a class="nav-link @(act == "Inventory" ? "active" : "")" href="/Kvkk/Inventory"><i class="bi bi-archive me-2"></i>Envanter</a>
                <a class="nav-link @(act == "KvkkSettings" ? "active" : "")" href="/Kvkk/KvkkSettings"><i class="bi bi-sliders me-2"></i>KVKK Ayarlari</a>
            </div>

            <!-- Gelismis -->
            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span>Gelismis</span><i class="bi bi-chevron-down chevron @(advOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(advOpen ? "show" : "")">
                <a class="nav-link @(ctrl == "Licensing" ? "active" : "")" href="/Licensing"><i class="bi bi-key me-2"></i>Lisanslama</a>
                <a class="nav-link @(ctrl == "Notifications" ? "active" : "")" href="/Notifications"><i class="bi bi-megaphone me-2"></i>Bildirimler</a>
            </div>

            <!-- Alt bar -->
            <div style="position:absolute;bottom:0;width:100%;border-top:1px solid rgba(255,255,255,.1);padding:.8rem 1rem;">
                <div class="d-flex align-items-center justify-content-between">
                    <small class="text-white-50">
                        <i class="bi bi-shield-lock me-1"></i>@Context.Session.GetString("UserName")
                    </small>
                    <a href="/Account/Logout" class="text-white-50" title="Cikis"><i class="bi bi-box-arrow-right"></i></a>
                </div>
            </div>
        </nav>

        <div class="content-area">
            <div class="topbar">
                <h5 class="mb-0">@ViewData["Title"]</h5>
                <small class="text-muted"><i class="bi bi-shield-check me-1"></i>Admin Panel</small>
            </div>
            @RenderBody()
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/knockout@3.5.1/build/output/knockout-latest.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        $.ajaxSetup({
            dataType: 'json',
            error: function(xhr) {
                if (xhr.status === 401) window.location.href = '/Account/Login';
            }
        });
        toastr.options = { closeButton: true, progressBar: true, positionClass: 'toast-top-right', timeOut: 3000 };
        function toggleGroup(btn) {
            var items = btn.nextElementSibling;
            var chevron = btn.querySelector('.chevron');
            items.classList.toggle('show');
            chevron.classList.toggle('open');
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
