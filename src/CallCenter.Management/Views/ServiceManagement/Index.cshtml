@{
    ViewData["Title"] = "Hizmet Yönetimi";
}

<div id="servicemanagement-vm">
    <!-- Donem Listesi + Yeni Donem -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0 text-muted"><i class="bi bi-calendar3 me-1"></i>Fiyatlandırma Dönemleri</h6>
        <button class="btn btn-primary btn-sm" data-bind="click: openNewPeriod"><i class="bi bi-plus-lg me-1"></i>Yeni Dönem</button>
    </div>

    <!-- Donem Kartlari -->
    <div class="row g-3 mb-4" data-bind="foreach: periods">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100" data-bind="css: { 'border-start border-3 border-success': statusId === 1, 'border-start border-3 border-secondary': statusId === 2, 'border-start border-3 border-warning': statusId === 3 }">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <h6 class="mb-1" data-bind="text: name"></h6>
                        <span class="badge" data-bind="text: statusName, css: statusId === 1 ? 'bg-success' : statusId === 2 ? 'bg-secondary' : 'bg-warning text-dark'"></span>
                    </div>
                    <div class="small text-muted" data-bind="text: new Date(startDate).toLocaleDateString('tr-TR') + ' - ' + new Date(endDate).toLocaleDateString('tr-TR')"></div>
                    <div class="small text-muted mt-1" data-bind="text: itemCount + ' hizmet kalemi'"></div>
                    <div class="mt-2 d-flex gap-1">
                        <button class="btn btn-outline-primary btn-sm" data-bind="click: $parent.openPeriodDetail"><i class="bi bi-pencil me-1"></i>Detay</button>
                        <!-- ko if: statusId === 3 -->
                        <button class="btn btn-success btn-sm" data-bind="click: $parent.activatePeriod"><i class="bi bi-check-lg me-1"></i>Aktif Et</button>
                        <button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.deletePeriod"><i class="bi bi-trash"></i></button>
                        <!-- /ko -->
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="text-center text-muted py-4" data-bind="visible: periods().length === 0">
        <i class="bi bi-calendar3 fs-1 d-block mb-2 opacity-25"></i>Henüz dönem oluşturulmamış.
    </div>

    <!-- Donem Detay -->
    <!-- ko if: selectedPeriod() -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong data-bind="text: selectedPeriod().name"></strong>
            <div>
                <button class="btn btn-outline-warning btn-sm me-1" data-bind="click: openBulkAdjust"><i class="bi bi-arrow-up-right me-1"></i>Toplu Fiyat Değiştir</button>
            </div>
        </div>
        <div class="card-body p-0">
            <ul class="nav nav-tabs px-3 pt-2">
                <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabCC"><i class="bi bi-telephone me-1"></i>Call Center</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabSalon"><i class="bi bi-scissors me-1"></i>Salon</button></li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane fade show active" id="tabCC">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light"><tr><th>Hizmet</th><th>Default</th><th>Önceki Fiyat</th><th style="width:160px;">Aylık Fiyat (TL)</th><th>Fark</th></tr></thead>
                            <tbody data-bind="foreach: selectedPeriod().callCenter">
                                <tr>
                                    <td class="fw-medium" data-bind="text: serviceName"></td>
                                    <td><span class="badge" data-bind="text: isDefault ? 'Dahil' : 'Ücretli', css: isDefault ? 'bg-success' : 'bg-warning text-dark'"></span></td>
                                    <td class="small text-muted" data-bind="text: previousPrice != null ? previousPrice.toLocaleString('tr-TR') + ' TL' : '-'"></td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <input type="number" class="form-control" step="0.01" min="0" data-bind="value: monthlyPrice, event: { change: function() { $root.updatePrice(id, monthlyPrice); } }" />
                                            <span class="input-group-text">TL</span>
                                        </div>
                                    </td>
                                    <td>
                                        <!-- ko if: previousPrice != null && monthlyPrice !== previousPrice -->
                                        <span class="badge" data-bind="text: (monthlyPrice > previousPrice ? '+' : '') + (monthlyPrice - previousPrice).toFixed(2) + ' TL',
                                            css: monthlyPrice > previousPrice ? 'bg-danger' : monthlyPrice < previousPrice ? 'bg-success' : 'bg-secondary'"></span>
                                        <!-- /ko -->
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="tab-pane fade" id="tabSalon">
                    <!-- Default moduller -->
                    <!-- ko if: selectedPeriod().salon.filter(function(s) { return s.isDefault; }).length > 0 -->
                    <div class="p-2 bg-light border-bottom">
                        <small class="text-muted fw-bold"><i class="bi bi-check-circle text-success me-1"></i>Temel Paket (Dahil - Ücretsiz)</small>
                        <div class="mt-1">
                            <!-- ko foreach: selectedPeriod().salon.filter(function(s) { return s.isDefault; }) -->
                            <span class="badge bg-success me-1 mb-1" data-bind="text: serviceName"></span>
                            <!-- /ko -->
                        </div>
                    </div>
                    <!-- /ko -->
                    <!-- Gruplu moduller -->
                    <!-- ko if: selectedPeriod().salonGroups -->
                    <div class="accordion" id="salonPricingAccordion">
                        <!-- ko foreach: selectedPeriod().salonGroups -->
                        <div class="accordion-item border-0">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse"
                                    data-bind="attr: { 'data-bs-target': '#spg' + groupId }">
                                    <strong class="small" data-bind="text: groupName"></strong>
                                    <span class="badge bg-secondary ms-2 small" data-bind="text: items.length + ' modül'"></span>
                                </button>
                            </h2>
                            <div class="accordion-collapse collapse" data-bind="attr: { id: 'spg' + groupId }">
                                <div class="table-responsive">
                                    <table class="table table-hover table-sm mb-0">
                                        <thead class="table-light"><tr><th>Modül</th><th>Default</th><th>Önceki</th><th style="width:150px;">Fiyat (TL)</th><th>Fark</th></tr></thead>
                                        <tbody data-bind="foreach: items">
                                            <tr>
                                                <td class="fw-medium small" data-bind="text: serviceName"></td>
                                                <td><span class="badge" data-bind="text: isDefault ? 'Evet' : '-', css: isDefault ? 'bg-info' : 'bg-light text-muted'"></span></td>
                                                <td class="small text-muted" data-bind="text: previousPrice != null ? previousPrice.toLocaleString('tr-TR') : '-'"></td>
                                                <td>
                                                    <div class="input-group input-group-sm">
                                                        <input type="number" class="form-control" step="0.01" min="0" data-bind="value: monthlyPrice, event: { change: function() { $root.updatePrice(id, monthlyPrice); } }" />
                                                        <span class="input-group-text">TL</span>
                                                    </div>
                                                </td>
                                                <td>
                                                    <!-- ko if: previousPrice != null && monthlyPrice !== previousPrice -->
                                                    <span class="badge" data-bind="text: (monthlyPrice > previousPrice ? '+' : '') + (monthlyPrice - previousPrice).toFixed(2),
                                                        css: monthlyPrice > previousPrice ? 'bg-danger' : 'bg-success'"></span>
                                                    <!-- /ko -->
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>
                    <!-- /ko -->
                </div>
            </div>
        </div>
    </div>
    <!-- /ko -->

    <!-- Yeni Donem Modal -->
    <div class="modal fade" id="newPeriodModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header py-2"><h6 class="modal-title">Yeni Dönem</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="mb-2"><label class="form-label small">Dönem Adı *</label><input type="text" class="form-control form-control-sm" data-bind="value: periodForm.name" placeholder="Nisan 2026" /></div>
                    <div class="mb-2"><label class="form-label small">Başlangıç *</label><input type="date" class="form-control form-control-sm" data-bind="value: periodForm.startDate" /></div>
                    <div class="mb-2"><label class="form-label small">Bitiş *</label><input type="date" class="form-control form-control-sm" data-bind="value: periodForm.endDate" /></div>
                    <small class="text-muted">Önceki dönemin fiyatları otomatik kopyalanır.</small>
                </div>
                <div class="modal-footer py-1">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: savePeriod">Oluştur</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toplu Fiyat Modal -->
    <div class="modal fade" id="bulkAdjustModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header py-2"><h6 class="modal-title">Toplu Fiyat Değiştir</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="mb-2"><label class="form-label small">Uygulama</label>
                        <select class="form-select form-select-sm" data-bind="value: bulkForm.productTypeId">
                            <option value="">Tümü</option>
                            <option value="1">Call Center</option>
                            <option value="2">Salon</option>
                        </select>
                    </div>
                    <div class="mb-2"><label class="form-label small">Tür</label>
                        <select class="form-select form-select-sm" data-bind="value: bulkForm.adjustType">
                            <option value="amount">Tutar (TL)</option>
                            <option value="percentage">Oran (%)</option>
                        </select>
                    </div>
                    <div class="mb-2"><label class="form-label small">Değer</label>
                        <input type="number" step="0.01" class="form-control form-control-sm" data-bind="value: bulkForm.value" /></div>
                </div>
                <div class="modal-footer py-1">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-warning btn-sm" data-bind="click: executeBulkAdjust">Uygula</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/ServiceManagement.js" asp-append-version="true"></script>
}
