<div id="servicemanagement-vm">
    <!-- Ozet Kartlar -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-check-circle"></i></div>
                    <div>
                        <div class="text-muted small">Aktif Abonelik</div>
                        <h4 class="mb-0" data-bind="text: summary().totalActiveSubscriptions || 0"></h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-cash-stack"></i></div>
                    <div>
                        <div class="text-muted small">Aylik Gelir</div>
                        <h4 class="mb-0" data-bind="text: (summary().totalMonthlyRevenue || 0).toFixed(2) + ' TL'"></h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-info bg-opacity-10 text-info"><i class="bi bi-box"></i></div>
                    <div>
                        <div class="text-muted small">Hizmet Turu</div>
                        <h4 class="mb-0" data-bind="text: summary().serviceBreakdown ? summary().serviceBreakdown.length : 0"></h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div></div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-warning btn-sm" data-bind="click: openBulkAdjust">
                <i class="bi bi-arrow-up-right me-1"></i>Toplu Fiyat Artir
            </button>
            <button class="btn btn-outline-success btn-sm" data-bind="click: openGenerateBilling">
                <i class="bi bi-receipt me-1"></i>Fatura Olustur
            </button>
        </div>
    </div>

    <!-- Hizmet Tablosu -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <h6 class="mb-0"><i class="bi bi-box me-2"></i>Hizmetler</h6>
        </div>
        <div class="card-body p-0">
            <div class="text-center py-5" data-bind="visible: isLoading"><div class="spinner-border text-primary"></div></div>
            <div class="text-center text-muted py-5" data-bind="visible: !isLoading() && services().length === 0">
                <i class="bi bi-box fs-1 d-block mb-2 opacity-25"></i>Hizmet bulunamadi
            </div>
            <div data-bind="visible: !isLoading() && services().length > 0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Kod</th>
                                <th>Hizmet Adi</th>
                                <th>Kategori</th>
                                <th>Varsayilan</th>
                                <th>Ucretli</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: services">
                            <tr>
                                <td class="fw-medium" data-bind="text: code || '-'"></td>
                                <td data-bind="text: name || '-'"></td>
                                <td><span class="badge bg-secondary" data-bind="text: categoryName || '-'"></span></td>
                                <td><span class="badge" data-bind="text: isDefault ? 'Evet' : 'Hayir', css: isDefault ? 'bg-success' : 'bg-secondary'"></span></td>
                                <td><span class="badge" data-bind="text: isDefault ? 'Hayir' : 'Evet', css: isDefault ? 'bg-secondary' : 'bg-warning'"></span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Toplu Fiyat Artirma Modal -->
    <div class="modal fade" id="bulkAdjustModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title"><i class="bi bi-arrow-up-right me-2"></i>Toplu Fiyat Artirma</h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small">Hizmet</label>
                        <select class="form-select form-select-sm" data-bind="value: bulkForm.serviceId, options: services, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Tum Hizmetler'"></select>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Artis Tipi</label>
                            <select class="form-select form-select-sm" data-bind="value: bulkForm.adjustType">
                                <option value="amount">Tutar (TL)</option>
                                <option value="percentage">Oran (%)</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Deger</label>
                            <input type="number" step="0.01" class="form-control form-control-sm" data-bind="value: bulkForm.value" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-warning btn-sm" data-bind="click: executeBulkAdjust, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Uygula
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Fatura Olustur Modal -->
    <div class="modal fade" id="generateBillingModal" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title"><i class="bi bi-receipt me-2"></i>Hizmet Faturasi Olustur</h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small">Yil</label>
                        <input type="number" class="form-control form-control-sm" data-bind="value: billingYear" min="2020" max="2100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Ay</label>
                        <select class="form-select form-select-sm" data-bind="value: billingMonth">
                            <option value="1">Ocak</option><option value="2">Subat</option><option value="3">Mart</option>
                            <option value="4">Nisan</option><option value="5">Mayis</option><option value="6">Haziran</option>
                            <option value="7">Temmuz</option><option value="8">Agustos</option><option value="9">Eylul</option>
                            <option value="10">Ekim</option><option value="11">Kasim</option><option value="12">Aralik</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-success btn-sm" data-bind="click: executeGenerateBilling, disable: isGenerating">
                        <span data-bind="visible: isGenerating" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-gear me-1" data-bind="visible: !isGenerating()"></i>Olustur
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function ServiceManagementViewModel() {
    var self = this;
    self.services = ko.observableArray([]);
    self.summary = ko.observable({});
    self.isLoading = ko.observable(false);
    self.isSaving = ko.observable(false);
    self.isGenerating = ko.observable(false);

    var now = new Date();
    self.billingYear = ko.observable(now.getFullYear());
    self.billingMonth = ko.observable(now.getMonth() + 1);

    self.bulkForm = {
        serviceId: ko.observable(''), adjustType: ko.observable('amount'), value: ko.observable(0)
    };

    self.loadSummary = function() {
        $.get('/proxy/service-subscriptions/summary', function(data) {
            self.summary(data || {});
        });
    };

    self.loadServices = function() {
        self.isLoading(true);
        $.get('/proxy/services', function(data) {
            var items = Array.isArray(data) ? data : (data.items || data.data || []);
            self.services(items);
        }).always(function() { self.isLoading(false); });
    };

    self.openBulkAdjust = function() {
        self.bulkForm.serviceId(''); self.bulkForm.adjustType('amount'); self.bulkForm.value(0);
        new bootstrap.Modal('#bulkAdjustModal').show();
    };

    self.executeBulkAdjust = function() {
        self.isSaving(true);
        var payload = {
            serviceId: self.bulkForm.serviceId() || null,
            adjustType: self.bulkForm.adjustType(),
            value: parseFloat(self.bulkForm.value())
        };
        $.ajax({
            url: '/proxy/service-subscriptions/bulk-adjust', method: 'POST',
            contentType: 'application/json', data: JSON.stringify(payload),
            success: function() {
                toastr.success('Fiyat artirma uygulandi.');
                bootstrap.Modal.getInstance(document.getElementById('bulkAdjustModal')).hide();
                self.loadSummary();
            },
            error: function() { toastr.error('Islem hatasi.'); }
        }).always(function() { self.isSaving(false); });
    };

    self.openGenerateBilling = function() {
        new bootstrap.Modal('#generateBillingModal').show();
    };

    self.executeGenerateBilling = function() {
        self.isGenerating(true);
        $.ajax({
            url: '/proxy/service-subscriptions/billing/generate', method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ year: parseInt(self.billingYear()), month: parseInt(self.billingMonth()) }),
            success: function() {
                toastr.success('Faturalar olusturuldu.');
                bootstrap.Modal.getInstance(document.getElementById('generateBillingModal')).hide();
            },
            error: function() { toastr.error('Fatura olusturma hatasi.'); }
        }).always(function() { self.isGenerating(false); });
    };

    self.loadSummary();
    self.loadServices();
}

ko.applyBindings(new ServiceManagementViewModel(), document.getElementById('servicemanagement-vm'));
</script>
}
