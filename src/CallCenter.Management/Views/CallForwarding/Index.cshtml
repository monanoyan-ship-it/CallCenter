<div id="callforwarding-vm">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div></div>
        <button class="btn btn-primary btn-sm" data-bind="click: openCreate">
            <i class="bi bi-plus-lg me-1"></i>Yeni Kural
        </button>
    </div>

    <!-- Tablo -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="text-center py-5" data-bind="visible: isLoading"><div class="spinner-border text-primary"></div></div>
            <div class="text-center text-muted py-5" data-bind="visible: !isLoading() && items().length === 0">
                <i class="bi bi-signpost-split fs-1 d-block mb-2 opacity-25"></i>Yonlendirme kurali bulunamadi
            </div>
            <div data-bind="visible: !isLoading() && items().length > 0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Kullanici</th>
                                <th>Tur</th>
                                <th>Hedef Numara</th>
                                <th>Oncelik</th>
                                <th>Timeout</th>
                                <th>Durum</th>
                                <th>Aciklama</th>
                                <th style="width:120px;"></th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: items">
                            <tr>
                                <td class="fw-medium" data-bind="text: userName || '-'"></td>
                                <td>
                                    <span class="badge" data-bind="text: forwardType,
                                        css: forwardType === 'Always' ? 'bg-primary' :
                                             forwardType === 'Busy' ? 'bg-warning' :
                                             forwardType === 'NoAnswer' ? 'bg-info' : 'bg-secondary'"></span>
                                </td>
                                <td data-bind="text: destination || '-'"></td>
                                <td data-bind="text: priority || 0"></td>
                                <td data-bind="text: (timeoutSeconds || 0) + ' sn'"></td>
                                <td><span class="badge" data-bind="text: isActive ? 'Aktif' : 'Pasif', css: isActive ? 'bg-success' : 'bg-danger'"></span></td>
                                <td class="small text-muted" data-bind="text: description || '-'"></td>
                                <td>
                                    <button class="btn btn-outline-secondary btn-sm me-1" title="Duzenle" data-bind="click: $parent.openEdit"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-outline-danger btn-sm" title="Sil" data-bind="click: $parent.confirmDelete"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted">Toplam: <span data-bind="text: totalCount"></span> kayit</small>
                    <nav><ul class="pagination pagination-sm mb-0" data-bind="foreach: pageNumbers()">
                        <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                            <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                        </li>
                    </ul></nav>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Modal -->
    <div class="modal fade" id="forwardModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title" data-bind="text: formTitle"></h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Kullanici *</label>
                            <select class="form-select form-select-sm" data-bind="value: form.userId, options: users, optionsText: function(i) { return i.fullName || i.username; }, optionsValue: 'id', optionsCaption: 'Sec...'"></select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Tur *</label>
                            <select class="form-select form-select-sm" data-bind="value: form.forwardType">
                                <option value="Always">Always</option>
                                <option value="Busy">Busy</option>
                                <option value="NoAnswer">NoAnswer</option>
                                <option value="Offline">Offline</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Hedef Numara *</label>
                            <input class="form-control form-control-sm" data-bind="value: form.destination" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label small">Oncelik</label>
                            <input type="number" class="form-control form-control-sm" data-bind="value: form.priority" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label small">Timeout (sn)</label>
                            <input type="number" class="form-control form-control-sm" data-bind="value: form.timeoutSeconds" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Aciklama</label>
                        <input class="form-control form-control-sm" data-bind="value: form.description" />
                    </div>
                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" data-bind="checked: form.isActive" />
                        <label class="form-check-label small">Aktif</label>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Silme Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-triangle text-danger fs-1 d-block mb-2"></i>
                    <p>Bu kurali silmek istediginize emin misiniz?</p>
                </div>
                <div class="modal-footer py-2 justify-content-center">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-danger btn-sm" data-bind="click: executeDelete">Sil</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function CallForwardingViewModel() {
    var self = this;
    self.items = ko.observableArray([]);
    self.users = ko.observableArray([]);
    self.isLoading = ko.observable(false);
    self.isSaving = ko.observable(false);
    self.currentPage = ko.observable(1);
    self.totalCount = ko.observable(0);
    self.pageSize = 20;
    self.formTitle = ko.observable('Yeni Kural');
    self.deleteId = null;

    self.form = {
        id: ko.observable(null), userId: ko.observable(''), forwardType: ko.observable('Always'),
        destination: ko.observable(''), priority: ko.observable(0), timeoutSeconds: ko.observable(30),
        description: ko.observable(''), isActive: ko.observable(true)
    };

    self.pageNumbers = ko.computed(function() {
        var total = Math.ceil(self.totalCount() / self.pageSize);
        var pages = [];
        for (var i = 1; i <= total; i++) pages.push(i);
        return pages;
    });

    self.goToPage = function(page) { self.currentPage(page); self.loadData(); };

    self.loadUsers = function() {
        $.get('/proxy/users', function(data) {
            self.users(Array.isArray(data) ? data : (data.items || data.data || []));
        });
    };

    self.loadData = function() {
        self.isLoading(true);
        $.get('/proxy/callforwarding', { page: self.currentPage(), pageSize: self.pageSize }, function(data) {
            var items = Array.isArray(data) ? data : (data.items || data.data || []);
            self.items(items);
            self.totalCount(data.totalCount || data.total || items.length);
        }).always(function() { self.isLoading(false); });
    };

    self.resetForm = function() {
        self.form.id(null); self.form.userId(''); self.form.forwardType('Always');
        self.form.destination(''); self.form.priority(0); self.form.timeoutSeconds(30);
        self.form.description(''); self.form.isActive(true);
    };

    self.openCreate = function() { self.resetForm(); self.formTitle('Yeni Kural'); new bootstrap.Modal('#forwardModal').show(); };

    self.openEdit = function(item) {
        self.form.id(item.id); self.form.userId(item.userId || '');
        self.form.forwardType(item.forwardType || 'Always');
        self.form.destination(item.destination || ''); self.form.priority(item.priority || 0);
        self.form.timeoutSeconds(item.timeoutSeconds || 30);
        self.form.description(item.description || ''); self.form.isActive(item.isActive !== false);
        self.formTitle('Kural Duzenle');
        new bootstrap.Modal('#forwardModal').show();
    };

    self.save = function() {
        if (!self.form.userId() || !self.form.destination()) { toastr.warning('Kullanici ve hedef zorunludur.'); return; }
        self.isSaving(true);
        var payload = {
            userId: parseInt(self.form.userId()), forwardType: self.form.forwardType(),
            destination: self.form.destination(), priority: parseInt(self.form.priority()),
            timeoutSeconds: parseInt(self.form.timeoutSeconds()),
            description: self.form.description(), isActive: self.form.isActive()
        };
        var method = self.form.id() ? 'PUT' : 'POST';
        var url = self.form.id() ? '/proxy/callforwarding/' + self.form.id() : '/proxy/callforwarding';
        $.ajax({
            url: url, method: method, contentType: 'application/json', data: JSON.stringify(payload),
            success: function() {
                toastr.success('Kaydedildi.'); bootstrap.Modal.getInstance(document.getElementById('forwardModal')).hide();
                self.loadData();
            },
            error: function() { toastr.error('Kaydetme hatasi.'); }
        }).always(function() { self.isSaving(false); });
    };

    self.confirmDelete = function(item) { self.deleteId = item.id; new bootstrap.Modal('#deleteModal').show(); };

    self.executeDelete = function() {
        $.ajax({
            url: '/proxy/callforwarding/' + self.deleteId, method: 'DELETE',
            success: function() { toastr.success('Silindi.'); bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide(); self.loadData(); },
            error: function() { toastr.error('Silme hatasi.'); }
        });
    };

    self.loadUsers();
    self.loadData();
}

ko.applyBindings(new CallForwardingViewModel(), document.getElementById('callforwarding-vm'));
</script>
}
