@{
    ViewData["Title"] = "Email Taslaklari";
}

<div id="email-templates-vm">
    <!-- Baslik -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div></div>
        <button class="btn btn-primary btn-sm" data-bind="click: openCreate">
            <i class="bi bi-plus-lg me-1"></i>Yeni Taslak
        </button>
    </div>

    <!-- Filtre -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Olay anahtari veya konu ara..."
                               data-bind="value: searchText, valueUpdate: 'afterkeydown'" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" data-bind="value: filterProduct">
                        <option value="">Tum Urunler</option>
                        <option value="Salon">Salon</option>
                        <option value="CallCenter">CallCenter</option>
                        <option value="CRM">CRM</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary btn-sm w-100" data-bind="click: loadData">
                        <i class="bi bi-arrow-clockwise me-1"></i>Yenile
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tablo -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="text-center py-5" data-bind="visible: isLoading">
                <div class="spinner-border text-primary"></div>
            </div>
            <div class="text-center text-muted py-5" data-bind="visible: !isLoading() && filteredTemplates().length === 0">
                <i class="bi bi-envelope-x fs-1 d-block mb-2 opacity-25"></i>Email taslagi bulunamadi
            </div>
            <div data-bind="visible: !isLoading() && filteredTemplates().length > 0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Olay Anahtari</th>
                                <th>Konu</th>
                                <th>Urun</th>
                                <th>Dil</th>
                                <th class="text-center">Durum</th>
                                <th>Aciklama</th>
                                <th class="text-end">Islemler</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: filteredTemplates">
                            <tr>
                                <td><code data-bind="text: eventKey"></code></td>
                                <td data-bind="text: subject"></td>
                                <td>
                                    <span class="badge" data-bind="text: productType || 'Tumu', css: productType === 'Salon' ? 'bg-success' : productType === 'CallCenter' ? 'bg-primary' : productType === 'CRM' ? 'bg-info' : 'bg-secondary'"></span>
                                </td>
                                <td><span class="badge bg-light text-dark" data-bind="text: language"></span></td>
                                <td class="text-center">
                                    <span class="badge" data-bind="text: isActive ? 'Aktif' : 'Pasif', css: isActive ? 'bg-success' : 'bg-danger'"></span>
                                </td>
                                <td><small class="text-muted" data-bind="text: description"></small></td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm me-1" data-bind="click: $parent.openEdit" title="Duzenle">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-info btn-sm me-1" data-bind="click: $parent.openPreview" title="Onizleme">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.confirmDelete" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Create/Edit Modal -->
    <div class="modal fade" id="templateModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" data-bind="text: form.id() ? 'Taslak Duzenle' : 'Yeni Taslak'"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Olay Anahtari <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" placeholder="salon_register_confirm"
                                   data-bind="value: form.eventKey, attr: { readonly: form.id() }" />
                            <small class="text-muted">Benzersiz, degistirilemez (orn: password_reset)</small>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Urun</label>
                            <select class="form-select form-select-sm" data-bind="value: form.productType">
                                <option value="">Tumu</option>
                                <option value="Salon">Salon</option>
                                <option value="CallCenter">CallCenter</option>
                                <option value="CRM">CRM</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Dil</label>
                            <select class="form-select form-select-sm" data-bind="value: form.language">
                                <option value="tr">Turkce</option>
                                <option value="en">English</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Durum</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" data-bind="checked: form.isActive" />
                                <label class="form-check-label" data-bind="text: form.isActive() ? 'Aktif' : 'Pasif'"></label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Konu <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="{{SalonAdi}} - Kayit Onayiniz"
                                   data-bind="value: form.subject" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Aciklama</label>
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="Bu taslak ne icin kullaniliyor?"
                                   data-bind="value: form.description" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Placeholder'lar</label>
                            <input type="text" class="form-control form-control-sm"
                                   placeholder='["SalonAdi","KullaniciAdi","OnayLinki"]'
                                   data-bind="value: form.availablePlaceholders" />
                            <small class="text-muted">JSON dizi formatinda</small>
                        </div>
                        <div class="col-12">
                            <label class="form-label">HTML Icerik <span class="text-danger">*</span></label>
                            <textarea id="htmlEditor" style="height:300px"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save">
                        <i class="bi bi-check-lg me-1"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Preview Modal -->
    <div class="modal fade" id="previewModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Email Onizleme</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2"><strong>Konu:</strong> <span data-bind="text: previewSubject"></span></div>
                    <hr />
                    <div class="border rounded p-3" data-bind="html: previewHtml"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirm Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Taslak Sil</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <code data-bind="text: deleteTarget().eventKey"></code> taslagi silinecek. Emin misiniz?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgec</button>
                    <button type="button" class="btn btn-danger btn-sm" data-bind="click: executeDelete">
                        <i class="bi bi-trash me-1"></i>Sil
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
    <script src="~/js/EmailTemplates.js"></script>
}
