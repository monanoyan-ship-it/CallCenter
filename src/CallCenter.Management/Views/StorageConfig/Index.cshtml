<div id="storageconfig-vm">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div></div>
        <button class="btn btn-primary btn-sm" data-bind="click: openCreate">
            <i class="bi bi-plus-lg me-1"></i>Yeni Yapilandirma
        </button>
    </div>

    <!-- Tablo -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="text-center py-5" data-bind="visible: isLoading"><div class="spinner-border text-primary"></div></div>
            <div class="text-center text-muted py-5" data-bind="visible: !isLoading() && items().length === 0">
                <i class="bi bi-cloud fs-1 d-block mb-2 opacity-25"></i>Yapilandirma bulunamadi
            </div>
            <div data-bind="visible: !isLoading() && items().length > 0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Saglayici</th>
                                <th>Adi</th>
                                <th>Endpoint / Bucket</th>
                                <th>Durum</th>
                                <th style="width:160px;"></th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: items">
                            <tr>
                                <td><span class="badge bg-info" data-bind="text: provider || '-'"></span></td>
                                <td class="fw-medium" data-bind="text: name || '-'"></td>
                                <td class="small text-muted" data-bind="text: (endpoint || '') + ' / ' + (bucket || '')"></td>
                                <td><span class="badge" data-bind="text: isActive ? 'Aktif' : 'Pasif', css: isActive ? 'bg-success' : 'bg-danger'"></span></td>
                                <td>
                                    <button class="btn btn-outline-info btn-sm me-1" title="Test" data-bind="click: $parent.testConnection"><i class="bi bi-plug"></i></button>
                                    <button class="btn btn-outline-secondary btn-sm me-1" title="Duzenle" data-bind="click: $parent.openEdit"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-outline-danger btn-sm" title="Sil" data-bind="click: $parent.confirmDelete"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Modal -->
    <div class="modal fade" id="storageModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title" data-bind="text: formTitle"></h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Saglayici *</label>
                            <select class="form-select form-select-sm" data-bind="value: form.provider">
                                <option value="S3">S3</option>
                                <option value="MinIO">MinIO</option>
                                <option value="GoogleDrive">Google Drive</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Adi *</label>
                            <input class="form-control form-control-sm" data-bind="value: form.name" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Endpoint</label>
                        <input class="form-control form-control-sm" data-bind="value: form.endpoint" />
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Access Key</label>
                            <input class="form-control form-control-sm" data-bind="value: form.accessKey" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Secret Key</label>
                            <input type="password" class="form-control form-control-sm" data-bind="value: form.secretKey" />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Bucket</label>
                            <input class="form-control form-control-sm" data-bind="value: form.bucket" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Region</label>
                            <input class="form-control form-control-sm" data-bind="value: form.region" />
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" data-bind="checked: form.isActive" />
                        <label class="form-check-label small">Aktif</label>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Silme Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-triangle text-danger fs-1 d-block mb-2"></i>
                    <p>Bu yapilandirmayi silmek istediginize emin misiniz?</p>
                </div>
                <div class="modal-footer py-2 justify-content-center">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-danger btn-sm" data-bind="click: executeDelete">Sil</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function StorageConfigViewModel() {
    var self = this;
    self.items = ko.observableArray([]);
    self.isLoading = ko.observable(false);
    self.isSaving = ko.observable(false);
    self.formTitle = ko.observable('Yeni Yapilandirma');
    self.deleteId = null;

    self.form = {
        id: ko.observable(null), provider: ko.observable('S3'), name: ko.observable(''),
        endpoint: ko.observable(''), accessKey: ko.observable(''), secretKey: ko.observable(''),
        bucket: ko.observable(''), region: ko.observable(''), isActive: ko.observable(true)
    };

    self.loadData = function() {
        self.isLoading(true);
        $.get('/proxy/storage/configs', function(data) {
            var items = Array.isArray(data) ? data : (data.items || data.data || []);
            self.items(items);
        }).always(function() { self.isLoading(false); });
    };

    self.resetForm = function() {
        self.form.id(null); self.form.provider('S3'); self.form.name('');
        self.form.endpoint(''); self.form.accessKey(''); self.form.secretKey('');
        self.form.bucket(''); self.form.region(''); self.form.isActive(true);
    };

    self.openCreate = function() { self.resetForm(); self.formTitle('Yeni Yapilandirma'); new bootstrap.Modal('#storageModal').show(); };

    self.openEdit = function(item) {
        self.form.id(item.id); self.form.provider(item.provider || 'S3');
        self.form.name(item.name || ''); self.form.endpoint(item.endpoint || '');
        self.form.accessKey(item.accessKey || ''); self.form.secretKey('');
        self.form.bucket(item.bucket || ''); self.form.region(item.region || '');
        self.form.isActive(item.isActive !== false);
        self.formTitle('Yapilandirma Duzenle');
        new bootstrap.Modal('#storageModal').show();
    };

    self.save = function() {
        if (!self.form.name()) { toastr.warning('Ad zorunludur.'); return; }
        self.isSaving(true);
        var payload = {
            provider: self.form.provider(), name: self.form.name(), endpoint: self.form.endpoint(),
            accessKey: self.form.accessKey(), secretKey: self.form.secretKey(),
            bucket: self.form.bucket(), region: self.form.region(), isActive: self.form.isActive()
        };
        var method = self.form.id() ? 'PUT' : 'POST';
        var url = self.form.id() ? '/proxy/storage/configs/' + self.form.id() : '/proxy/storage/configs';
        $.ajax({
            url: url, method: method, contentType: 'application/json', data: JSON.stringify(payload),
            success: function() {
                toastr.success('Kaydedildi.'); bootstrap.Modal.getInstance(document.getElementById('storageModal')).hide();
                self.loadData();
            },
            error: function() { toastr.error('Kaydetme hatasi.'); }
        }).always(function() { self.isSaving(false); });
    };

    self.testConnection = function(item) {
        toastr.info('Test baslatildi...');
        $.ajax({
            url: '/proxy/storage/configs/' + item.id + '/test', method: 'POST',
            success: function(data) {
                if (data && data.success) toastr.success('Baglanti basarili!');
                else toastr.warning('Test sonucu: ' + (data.message || 'Bilinmeyen'));
            },
            error: function() { toastr.error('Baglanti testi basarisiz.'); }
        });
    };

    self.confirmDelete = function(item) { self.deleteId = item.id; new bootstrap.Modal('#deleteModal').show(); };

    self.executeDelete = function() {
        $.ajax({
            url: '/proxy/storage/configs/' + self.deleteId, method: 'DELETE',
            success: function() { toastr.success('Silindi.'); bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide(); self.loadData(); },
            error: function() { toastr.error('Silme hatasi.'); }
        });
    };

    self.loadData();
}

ko.applyBindings(new StorageConfigViewModel(), document.getElementById('storageconfig-vm'));
</script>
}
