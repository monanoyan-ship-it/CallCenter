<div id="storageconfig-vm">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div></div>
        <button class="btn btn-primary btn-sm" data-bind="click: openCreate">
            <i class="bi bi-plus-lg me-1"></i>Yeni Yapilandirma
        </button>
    </div>

    <!-- Tablo -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="text-center py-5" data-bind="visible: isLoading"><div class="spinner-border text-primary"></div></div>
            <div class="text-center text-muted py-5" data-bind="visible: !isLoading() && items().length === 0">
                <i class="bi bi-cloud fs-1 d-block mb-2 opacity-25"></i>Yapilandirma bulunamadi
            </div>
            <div data-bind="visible: !isLoading() && items().length > 0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Saglayici</th>
                                <th>Temel Yol</th>
                                <th>Firma</th>
                                <th>Durum</th>
                                <th style="width:160px;"></th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: items">
                            <tr>
                                <td><span class="badge bg-info" data-bind="text: providerName || '-'"></span></td>
                                <td class="fw-medium" data-bind="text: $data.basePath || '-'"></td>
                                <td class="small text-muted" data-bind="text: $data.customerName || '-'"></td>
                                <td><span class="badge" data-bind="text: isActive ? 'Aktif' : 'Pasif', css: isActive ? 'bg-success' : 'bg-danger'"></span></td>
                                <td>
                                    <button class="btn btn-outline-info btn-sm me-1" title="Test" data-bind="click: $parent.testConnection"><i class="bi bi-plug"></i></button>
                                    <button class="btn btn-outline-secondary btn-sm me-1" title="Duzenle" data-bind="click: $parent.openEdit"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-outline-danger btn-sm" title="Sil" data-bind="click: $parent.confirmDelete"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Modal -->
    <div class="modal fade" id="storageModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title" data-bind="text: formTitle"></h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Saglayici *</label>
                            <select class="form-select form-select-sm" data-bind="value: form.providerTypeId">
                                <option value="4">Amazon S3</option>
                                <option value="5">MinIO</option>
                                <option value="1">Google Drive</option>
                                <option value="2">OneDrive</option>
                                <option value="3">Yandex Disk</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Temel Yol</label>
                            <input class="form-control form-control-sm" data-bind="value: form.basePath" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Endpoint</label>
                        <input class="form-control form-control-sm" data-bind="value: form.endpoint" />
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Access Key</label>
                            <input class="form-control form-control-sm" data-bind="value: form.accessKey" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Secret Key</label>
                            <input type="password" class="form-control form-control-sm" data-bind="value: form.secretKey" />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Bucket</label>
                            <input class="form-control form-control-sm" data-bind="value: form.bucketName" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Region</label>
                            <input class="form-control form-control-sm" data-bind="value: form.region" />
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" data-bind="checked: form.isActive" />
                        <label class="form-check-label small">Aktif</label>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Silme Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-triangle text-danger fs-1 d-block mb-2"></i>
                    <p>Bu yapilandirmayi silmek istediginize emin misiniz?</p>
                </div>
                <div class="modal-footer py-2 justify-content-center">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-danger btn-sm" data-bind="click: executeDelete">Sil</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/StorageConfig.js" asp-append-version="true"></script>
}
