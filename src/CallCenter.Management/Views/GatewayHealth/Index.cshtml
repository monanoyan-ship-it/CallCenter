<div id="gatewayhealth-vm">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <small class="text-muted">Otomatik yenileme: 30 saniye | Son guncelleme: <span data-bind="text: lastRefresh"></span></small>
        </div>
        <button class="btn btn-outline-secondary btn-sm" data-bind="click: loadData">
            <i class="bi bi-arrow-clockwise me-1"></i>Yenile
        </button>
    </div>

    <!-- Tablo -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="text-center py-5" data-bind="visible: isLoading"><div class="spinner-border text-primary"></div></div>
            <div class="text-center text-muted py-5" data-bind="visible: !isLoading() && items().length === 0">
                <i class="bi bi-heart-pulse fs-1 d-block mb-2 opacity-25"></i>Gateway verisi bulunamadi
            </div>
            <div data-bind="visible: !isLoading() && items().length > 0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Agent</th>
                                <th>Gateway</th>
                                <th>SIP Server</th>
                                <th>Transport</th>
                                <th>Durum</th>
                                <th>Son Guncelleme</th>
                                <th>Hata Mesaji</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: items">
                            <tr>
                                <td class="fw-medium" data-bind="text: agentName || '-'"></td>
                                <td data-bind="text: gatewayName || '-'"></td>
                                <td class="small" data-bind="text: sipServer || '-'"></td>
                                <td><span class="badge bg-info" data-bind="text: transport || '-'"></span></td>
                                <td>
                                    <span class="badge" data-bind="text: statusText || status || '-',
                                        css: status === 'Online' || status === 'Connected' ? 'bg-success' :
                                             status === 'Warning' ? 'bg-warning' :
                                             status === 'Error' || status === 'Offline' ? 'bg-danger' : 'bg-secondary'"></span>
                                </td>
                                <td class="small text-muted" data-bind="text: lastUpdated ? new Date(lastUpdated).toLocaleString('tr-TR') : '-'"></td>
                                <td class="small text-danger" data-bind="text: errorMessage || '-'"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function GatewayHealthViewModel() {
    var self = this;
    self.items = ko.observableArray([]);
    self.isLoading = ko.observable(false);
    self.lastRefresh = ko.observable('-');

    self.loadData = function() {
        self.isLoading(true);
        $.get('/proxy/gateway-health/all', function(data) {
            var items = Array.isArray(data) ? data : (data.items || data.data || []);
            self.items(items);
            self.lastRefresh(new Date().toLocaleTimeString('tr-TR'));
        }).always(function() { self.isLoading(false); });
    };

    self.loadData();
    setInterval(self.loadData, 30000);
}

ko.applyBindings(new GatewayHealthViewModel(), document.getElementById('gatewayhealth-vm'));
</script>
}
