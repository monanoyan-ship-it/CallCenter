<div id="billingreport-vm">
    <!-- Filtreler -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-2">
                    <input type="number" class="form-control form-control-sm" placeholder="Yıl" data-bind="textInput: yearFilter" min="2020" max="2100" />
                </div>
                <div class="col-md-2">
                    <select class="form-select form-select-sm" data-bind="value: monthFilter">
                        <option value="">Tüm Aylar</option>
                        <option value="1">Ocak</option><option value="2">Şubat</option><option value="3">Mart</option>
                        <option value="4">Nisan</option><option value="5">Mayıs</option><option value="6">Haziran</option>
                        <option value="7">Temmuz</option><option value="8">Ağustos</option><option value="9">Eylül</option>
                        <option value="10">Ekim</option><option value="11">Kasım</option><option value="12">Aralık</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select form-select-sm" data-bind="value: statusFilter">
                        <option value="">Tüm Durumlar</option>
                        <option value="1">Tahakkuk</option>
                        <option value="2">Faturalanmış</option>
                        <option value="3">Ödenmiş</option>
                        <option value="4">Gecikmiş</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary btn-sm w-100" data-bind="click: loadData">
                        <i class="bi bi-funnel me-1"></i>Filtrele
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toplu işlemler -->
    <div class="d-flex gap-2 mb-3" data-bind="visible: selectedIds().length > 0">
        <span class="badge bg-primary align-self-center" data-bind="text: selectedIds().length + ' seçili'"></span>
        <button class="btn btn-outline-warning btn-sm" data-bind="click: bulkInvoice">
            <i class="bi bi-receipt me-1"></i>Faturala
        </button>
        <button class="btn btn-outline-success btn-sm" data-bind="click: bulkPaid">
            <i class="bi bi-check-circle me-1"></i>Ödendi
        </button>
    </div>

    <!-- Tablo -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="text-center py-5" data-bind="visible: isLoading"><div class="spinner-border text-primary"></div></div>
            <div class="text-center text-muted py-5" data-bind="visible: !isLoading() && items().length === 0">
                <i class="bi bi-file-earmark-text fs-1 d-block mb-2 opacity-25"></i>Rapor verisi bulunamadı
            </div>
            <div data-bind="visible: !isLoading() && items().length > 0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:40px;">
                                    <input type="checkbox" class="form-check-input" data-bind="checked: selectAll" />
                                </th>
                                <th>Firma</th>
                                <th>Tür</th>
                                <th>Dönem</th>
                                <th class="text-end">Operatör</th>
                                <th class="text-end">Hizmet</th>
                                <th class="text-end">Toplam</th>
                                <th>Durum</th>
                                <th style="width:72px;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: items">
                            <tr>
                                <td>
                                    <input type="checkbox" class="form-check-input" data-bind="checkedValue: periodId, checked: $parent.selectedIds" />
                                </td>
                                <td class="fw-medium" data-bind="text: customerName || '-'"></td>
                                <td class="small text-muted" data-bind="text: billingKindName || '—'"></td>
                                <td data-bind="text: (month || '-') + '/' + (year || '-')"></td>
                                <td class="text-end" data-bind="text: (amount || 0).toFixed(2) + ' TL'"></td>
                                <td class="text-end" data-bind="text: (serviceAmount || 0).toFixed(2) + ' TL'"></td>
                                <td class="text-end fw-semibold" data-bind="text: ((amount || 0) + (serviceAmount || 0)).toFixed(2) + ' TL'"></td>
                                <td>
                                    <span class="badge" data-bind="text: $parent.statusLabel($data),
                                        css: $parent.statusBadge($data)"></span>
                                </td>
                                <td class="text-nowrap">
                                    <button class="btn btn-outline-danger btn-sm py-0 px-1" title="Tahakkuku Sil"
                                        data-bind="visible: $parent.canDeletePeriod($data), click: function() { $parent.deletePeriod($data); }">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted">Toplam: <span data-bind="text: totalCount"></span> kayıt</small>
                    <nav><ul class="pagination pagination-sm mb-0" data-bind="foreach: pageNumbers()">
                        <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                            <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                        </li>
                    </ul></nav>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/BillingReport.js" asp-append-version="true"></script>
}
