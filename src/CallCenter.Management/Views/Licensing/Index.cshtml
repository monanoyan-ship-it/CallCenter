@{
    ViewData["Title"] = "Lisanslama / Paketler";
}

<div id="licensing-vm">
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card stat-card border-start border-primary border-3">
                <div class="card-body py-2">
                    <div class="text-muted small">Toplam Lisans</div>
                    <h4 class="mb-0" data-bind="text: totalLicenses">0</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card border-start border-success border-3">
                <div class="card-body py-2">
                    <div class="text-muted small">Aktif Lisans</div>
                    <h4 class="mb-0 text-success" data-bind="text: activeLicenses">0</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card border-start border-warning border-3">
                <div class="card-body py-2">
                    <div class="text-muted small">Suresi Dolacak (30 gun)</div>
                    <h4 class="mb-0 text-warning" data-bind="text: expiringLicenses">0</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="bi bi-key me-2"></i>Musteri Lisanslari</h6>
            <button class="btn btn-primary btn-sm" data-bind="click: openCreate">
                <i class="bi bi-plus-lg me-1"></i>Lisans Ata
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Musteri</th>
                            <th>Paket</th>
                            <th>Max Kullanici</th>
                            <th>Baslangic</th>
                            <th>Bitis</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: licenses">
                        <tr>
                            <td class="fw-medium" data-bind="text: customerName"></td>
                            <td><span class="badge bg-info" data-bind="text: packageName"></span></td>
                            <td data-bind="text: maxUsers"></td>
                            <td class="small" data-bind="text: startDate"></td>
                            <td class="small" data-bind="text: endDate || 'Suresiz'"></td>
                            <td><span class="badge" data-bind="text: isActive ? 'Aktif' : 'Pasif', css: isActive ? 'bg-success' : 'bg-danger'"></span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="text-center py-4 text-muted" data-bind="visible: licenses().length === 0">
                <i class="bi bi-key fs-1 d-block mb-2 opacity-25"></i>
                Lisanslama sistemi henuz aktif degil. Ileride bu sayfadan musteri paketleri ve limitleri yonetilebilecek.
            </div>
        </div>
    </div>

    <!-- Lisans Atama Modal -->
    <div class="modal fade" id="licenseModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">Lisans Ata</h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small">Musteri</label>
                        <select class="form-select form-select-sm" data-bind="options: customers, optionsText: 'name', optionsValue: 'id', value: form.customerId, optionsCaption: 'Secin...'"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Paket</label>
                        <select class="form-select form-select-sm" data-bind="value: form.packageName">
                            <option value="Starter">Starter</option>
                            <option value="Professional">Professional</option>
                            <option value="Enterprise">Enterprise</option>
                        </select>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Max Kullanici</label>
                            <input type="number" class="form-control form-control-sm" data-bind="value: form.maxUsers" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Bitis Tarihi</label>
                            <input type="date" class="form-control form-control-sm" data-bind="value: form.endDate" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-primary btn-sm" data-bind="click: saveLicense">
                        <i class="bi bi-check-lg me-1"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/Licensing.js" asp-append-version="true"></script>
}
