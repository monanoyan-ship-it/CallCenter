<div id="queues-vm">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div></div>
        <button class="btn btn-primary btn-sm" data-bind="click: openCreate">
            <i class="bi bi-plus-lg me-1"></i>Yeni Kuyruk
        </button>
    </div>

    <!-- Filtre -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Kuyruk adi ara..."
                               data-bind="value: searchText, valueUpdate: 'afterkeydown', event: { keyup: onSearchKeyUp }" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" data-bind="value: customerFilter, options: customers, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Tum Firmalar'"></select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary btn-sm w-100" data-bind="click: loadData">
                        <i class="bi bi-arrow-clockwise me-1"></i>Yenile
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tablo -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="text-center py-5" data-bind="visible: isLoading"><div class="spinner-border text-primary"></div></div>
            <div class="text-center text-muted py-5" data-bind="visible: !isLoading() && items().length === 0">
                <i class="bi bi-inbox fs-1 d-block mb-2 opacity-25"></i>Kuyruk bulunamadi
            </div>
            <div data-bind="visible: !isLoading() && items().length > 0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Kuyruk Adi</th>
                                <th>Firma</th>
                                <th>Aciklama</th>
                                <th class="text-center">Agent</th>
                                <th>Max Bekleme</th>
                                <th>Durum</th>
                                <th style="width:150px;"></th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: items">
                            <tr>
                                <td class="fw-medium" data-bind="text: name"></td>
                                <td class="small" data-bind="text: customerName || '-'"></td>
                                <td class="text-muted small" data-bind="text: description || '-'"></td>
                                <td class="text-center"><span class="badge bg-primary rounded-pill" data-bind="text: agentCount || 0"></span></td>
                                <td data-bind="text: (maxWaitSeconds || 0) + ' sn'"></td>
                                <td><span class="badge" data-bind="text: isActive ? 'Aktif' : 'Pasif', css: isActive ? 'bg-success' : 'bg-danger'"></span></td>
                                <td>
                                    <button class="btn btn-outline-info btn-sm me-1" title="Agent Ata" data-bind="click: $parent.openAgents"><i class="bi bi-people"></i></button>
                                    <button class="btn btn-outline-secondary btn-sm me-1" title="Duzenle" data-bind="click: $parent.openEdit"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-outline-danger btn-sm" title="Sil" data-bind="click: $parent.confirmDelete"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted">Toplam: <span data-bind="text: totalCount"></span> kayit</small>
                    <nav><ul class="pagination pagination-sm mb-0" data-bind="foreach: pageNumbers()">
                        <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                            <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                        </li>
                    </ul></nav>
                </div>
            </div>
        </div>
    </div>

    <!-- Kuyruk Form Modal -->
    <div class="modal fade" id="queueModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title" data-bind="text: formTitle"></h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Kuyruk Adi *</label>
                            <input class="form-control form-control-sm" data-bind="value: form.name" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Firma</label>
                            <select class="form-select form-select-sm" data-bind="value: form.customerId, options: customers, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Sec...'"></select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Aciklama</label>
                        <textarea class="form-control form-control-sm" rows="2" data-bind="value: form.description"></textarea>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Max Bekleme (sn)</label>
                            <input type="number" class="form-control form-control-sm" data-bind="value: form.maxWaitSeconds" />
                        </div>
                        <div class="col-md-6 mb-3 d-flex align-items-end">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" data-bind="checked: form.isActive" />
                                <label class="form-check-label small">Aktif</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Agent Atama Modal -->
    <div class="modal fade" id="agentModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title"><i class="bi bi-people me-2"></i>Agent Atama - <span data-bind="text: selectedQueueName"></span></h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center py-3" data-bind="visible: agentsLoading"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                    <div data-bind="visible: !agentsLoading()">
                        <h6 class="small fw-semibold mb-2">Atanmis Agentlar</h6>
                        <div class="mb-3" data-bind="visible: assignedAgents().length === 0">
                            <span class="text-muted small">Henuz agent atanmamis.</span>
                        </div>
                        <div class="d-flex flex-wrap gap-1 mb-3" data-bind="foreach: assignedAgents">
                            <span class="badge bg-primary d-flex align-items-center gap-1">
                                <span data-bind="text: fullName || username"></span>
                                <button type="button" class="btn-close btn-close-white btn-close-sm ms-1" data-bind="click: $parent.removeAgent" style="font-size:.5rem"></button>
                            </span>
                        </div>
                        <hr />
                        <h6 class="small fw-semibold mb-2">Mevcut Agentlar</h6>
                        <div class="list-group list-group-flush" style="max-height:250px;overflow-y:auto" data-bind="foreach: availableAgents">
                            <button class="list-group-item list-group-item-action py-1 small" data-bind="click: $parent.assignAgent">
                                <i class="bi bi-plus-circle text-success me-1"></i><span data-bind="text: fullName || username"></span>
                            </button>
                        </div>
                        <div class="text-muted small text-center py-2" data-bind="visible: availableAgents().length === 0">Eklenecek agent kalmadi.</div>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Silme Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-triangle text-danger fs-1 d-block mb-2"></i>
                    <p>Bu kuyrugu silmek istediginize emin misiniz?</p>
                </div>
                <div class="modal-footer py-2 justify-content-center">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-danger btn-sm" data-bind="click: executeDelete">Sil</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function QueuesViewModel() {
    var self = this;
    self.items = ko.observableArray([]);
    self.customers = ko.observableArray([]);
    self.isLoading = ko.observable(false);
    self.isSaving = ko.observable(false);
    self.searchText = ko.observable('');
    self.customerFilter = ko.observable('');
    self.currentPage = ko.observable(1);
    self.totalCount = ko.observable(0);
    self.pageSize = 20;
    self.formTitle = ko.observable('Yeni Kuyruk');
    self.deleteId = null;

    // Agent
    self.assignedAgents = ko.observableArray([]);
    self.availableAgents = ko.observableArray([]);
    self.agentsLoading = ko.observable(false);
    self.selectedQueueId = null;
    self.selectedQueueName = ko.observable('');

    self.form = {
        id: ko.observable(null), name: ko.observable(''), customerId: ko.observable(''),
        description: ko.observable(''), maxWaitSeconds: ko.observable(120), isActive: ko.observable(true)
    };

    self.pageNumbers = ko.computed(function() {
        var total = Math.ceil(self.totalCount() / self.pageSize);
        var pages = [];
        for (var i = 1; i <= total; i++) pages.push(i);
        return pages;
    });

    self.goToPage = function(page) { self.currentPage(page); self.loadData(); };
    self.onSearchKeyUp = function(d, e) { if (e.keyCode === 13) { self.currentPage(1); self.loadData(); } return true; };

    self.loadCustomers = function() {
        $.get('/proxy/supervisor/customers', function(data) {
            self.customers(Array.isArray(data) ? data : (data.items || data.data || []));
        });
    };

    self.loadData = function() {
        self.isLoading(true);
        var params = { page: self.currentPage(), pageSize: self.pageSize };
        if (self.searchText()) params.search = self.searchText();
        if (self.customerFilter()) params.customerId = self.customerFilter();
        $.get('/proxy/queues', params, function(data) {
            var items = Array.isArray(data) ? data : (data.items || data.data || []);
            self.items(items);
            self.totalCount(data.totalCount || data.total || items.length);
        }).always(function() { self.isLoading(false); });
    };

    self.customerFilter.subscribe(function() { self.currentPage(1); self.loadData(); });

    self.resetForm = function() {
        self.form.id(null); self.form.name(''); self.form.customerId('');
        self.form.description(''); self.form.maxWaitSeconds(120); self.form.isActive(true);
    };

    self.openCreate = function() { self.resetForm(); self.formTitle('Yeni Kuyruk'); new bootstrap.Modal('#queueModal').show(); };

    self.openEdit = function(item) {
        self.form.id(item.id); self.form.name(item.name || '');
        self.form.customerId(item.customerId || ''); self.form.description(item.description || '');
        self.form.maxWaitSeconds(item.maxWaitSeconds || 120); self.form.isActive(item.isActive !== false);
        self.formTitle('Kuyruk Duzenle');
        new bootstrap.Modal('#queueModal').show();
    };

    self.save = function() {
        if (!self.form.name()) { toastr.warning('Kuyruk adi zorunludur.'); return; }
        self.isSaving(true);
        var payload = {
            name: self.form.name(), customerId: self.form.customerId() || null,
            description: self.form.description(), maxWaitSeconds: parseInt(self.form.maxWaitSeconds()),
            isActive: self.form.isActive()
        };
        var method = self.form.id() ? 'PUT' : 'POST';
        var url = self.form.id() ? '/proxy/queues/' + self.form.id() : '/proxy/queues';
        $.ajax({
            url: url, method: method, contentType: 'application/json', data: JSON.stringify(payload),
            success: function() {
                toastr.success('Kaydedildi.'); bootstrap.Modal.getInstance(document.getElementById('queueModal')).hide();
                self.loadData();
            },
            error: function() { toastr.error('Kaydetme hatasi.'); }
        }).always(function() { self.isSaving(false); });
    };

    self.confirmDelete = function(item) { self.deleteId = item.id; new bootstrap.Modal('#deleteModal').show(); };

    self.executeDelete = function() {
        $.ajax({
            url: '/proxy/queues/' + self.deleteId, method: 'DELETE',
            success: function() { toastr.success('Silindi.'); bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide(); self.loadData(); },
            error: function() { toastr.error('Silme hatasi.'); }
        });
    };

    // Agents
    self.openAgents = function(item) {
        self.selectedQueueId = item.id;
        self.selectedQueueName(item.name || '');
        self.loadAgents();
        new bootstrap.Modal('#agentModal').show();
    };

    self.loadAgents = function() {
        self.agentsLoading(true);
        var queueId = self.selectedQueueId;
        $.when(
            $.get('/proxy/queues/' + queueId + '/agents'),
            $.get('/proxy/users', { roleId: 3, status: 'active' })
        ).done(function(assignedRes, allRes) {
            var assigned = Array.isArray(assignedRes[0]) ? assignedRes[0] : (assignedRes[0].items || assignedRes[0].data || []);
            var all = Array.isArray(allRes[0]) ? allRes[0] : (allRes[0].items || allRes[0].data || []);
            self.assignedAgents(assigned);
            var assignedIds = assigned.map(function(a) { return a.id || a.userId; });
            self.availableAgents(all.filter(function(a) { return assignedIds.indexOf(a.id) === -1; }));
        }).always(function() { self.agentsLoading(false); });
    };

    self.assignAgent = function(agent) {
        $.ajax({
            url: '/proxy/queues/' + self.selectedQueueId + '/agents/' + agent.id, method: 'POST',
            success: function() { toastr.success('Agent atandi.'); self.loadAgents(); self.loadData(); },
            error: function() { toastr.error('Atama hatasi.'); }
        });
    };

    self.removeAgent = function(agent) {
        var agentId = agent.id || agent.userId;
        $.ajax({
            url: '/proxy/queues/' + self.selectedQueueId + '/agents/' + agentId, method: 'DELETE',
            success: function() { toastr.success('Agent cikarildi.'); self.loadAgents(); self.loadData(); },
            error: function() { toastr.error('Cikarma hatasi.'); }
        });
    };

    self.loadCustomers();
    self.loadData();
}

ko.applyBindings(new QueuesViewModel(), document.getElementById('queues-vm'));
</script>
}
