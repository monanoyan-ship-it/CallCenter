<div id="auditlogs-vm">
    <!-- Filtreler -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Ara..."
                               data-bind="value: searchText, valueUpdate: 'afterkeydown', event: { keyup: onSearchKeyUp }" />
                    </div>
                </div>
                <div class="col-md-2">
                    <select class="form-select form-select-sm" data-bind="value: categoryFilter, options: categories, optionsCaption: 'Tum Kategoriler'"></select>
                </div>
                <div class="col-md-2">
                    <select class="form-select form-select-sm" data-bind="value: actionFilter, options: actions, optionsCaption: 'Tum Aksiyonlar'"></select>
                </div>
                <div class="col-md-2">
                    <input type="date" class="form-control form-control-sm" placeholder="Baslangic" data-bind="value: dateFrom" />
                </div>
                <div class="col-md-2">
                    <input type="date" class="form-control form-control-sm" placeholder="Bitis" data-bind="value: dateTo" />
                </div>
                <div class="col-md-1">
                    <button class="btn btn-outline-secondary btn-sm w-100" data-bind="click: function() { currentPage(1); loadData(); }">
                        <i class="bi bi-funnel"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tablo -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="text-center py-5" data-bind="visible: isLoading"><div class="spinner-border text-primary"></div></div>
            <div class="text-center text-muted py-5" data-bind="visible: !isLoading() && items().length === 0">
                <i class="bi bi-journal-text fs-1 d-block mb-2 opacity-25"></i>Kayit bulunamadi
            </div>
            <div data-bind="visible: !isLoading() && items().length > 0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tarih</th>
                                <th>Kategori</th>
                                <th>Aksiyon</th>
                                <th>Kullanici</th>
                                <th>Aciklama</th>
                                <th>Entity</th>
                                <th>IP</th>
                                <th style="width:60px;"></th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: items">
                            <tr>
                                <td class="small" data-bind="text: createdAt ? new Date(createdAt).toLocaleString('tr-TR') : '-'"></td>
                                <td><span class="badge bg-secondary" data-bind="text: category || '-'"></span></td>
                                <td><span class="badge bg-info" data-bind="text: action || '-'"></span></td>
                                <td class="small" data-bind="text: userName || '-'"></td>
                                <td class="small text-muted" data-bind="text: description || '-'"></td>
                                <td class="small" data-bind="text: entityType || '-'"></td>
                                <td class="small text-muted" data-bind="text: ipAddress || '-'"></td>
                                <td>
                                    <button class="btn btn-outline-info btn-sm" title="Detay" data-bind="click: $parent.showDetail"><i class="bi bi-eye"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted">Toplam: <span data-bind="text: totalCount"></span> kayit</small>
                    <nav><ul class="pagination pagination-sm mb-0" data-bind="foreach: pageNumbers()">
                        <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                            <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                        </li>
                    </ul></nav>
                </div>
            </div>
        </div>
    </div>

    <!-- Detay Modal -->
    <div class="modal fade" id="detailModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title"><i class="bi bi-journal-text me-2"></i>Denetim Kaydi Detayi</h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center py-3" data-bind="visible: detailLoading"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                    <!-- ko with: detail -->
                    <div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <small class="text-muted d-block">Kullanici</small>
                                <span data-bind="text: userName || '-'"></span>
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted d-block">IP Adresi</small>
                                <span data-bind="text: ipAddress || '-'"></span>
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted d-block">Tarih</small>
                                <span data-bind="text: createdAt ? new Date(createdAt).toLocaleString('tr-TR') : '-'"></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <small class="text-muted d-block">User Agent</small>
                            <span class="small" data-bind="text: userAgent || '-'"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <small class="text-muted d-block mb-1">Eski Degerler</small>
                                <pre class="bg-light p-2 rounded small" style="max-height:300px;overflow:auto" data-bind="text: oldValues ? JSON.stringify(JSON.parse(oldValues), null, 2) : '-'"></pre>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted d-block mb-1">Yeni Degerler</small>
                                <pre class="bg-light p-2 rounded small" style="max-height:300px;overflow:auto" data-bind="text: newValues ? JSON.stringify(JSON.parse(newValues), null, 2) : '-'"></pre>
                            </div>
                        </div>
                    </div>
                    <!-- /ko -->
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/AuditLogs.js" asp-append-version="true"></script>
}
