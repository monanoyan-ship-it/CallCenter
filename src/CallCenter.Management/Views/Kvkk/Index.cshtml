<div id="kvkk-vm">
    <!-- Ozet Kartlar -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-check-circle"></i></div>
                    <div>
                        <div class="text-muted small">Toplam Onay</div>
                        <h4 class="mb-0" data-bind="text: dashboard().totalConsents || 0"></h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-hourglass-split"></i></div>
                    <div>
                        <div class="text-muted small">Bekleyen Istek</div>
                        <h4 class="mb-0" data-bind="text: dashboard().pendingRequests || 0"></h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-exclamation-triangle"></i></div>
                    <div>
                        <div class="text-muted small">Aktif Ihlal</div>
                        <h4 class="mb-0" data-bind="text: dashboard().activeBreaches || 0"></h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-info bg-opacity-10 text-info"><i class="bi bi-globe"></i></div>
                    <div>
                        <div class="text-muted small">Aktif Transfer</div>
                        <h4 class="mb-0" data-bind="text: dashboard().activeTransfers || 0"></h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hizli Erisim -->
    <div class="row g-3 mb-4">
        <div class="col-md-2"><a href="/Kvkk/PrivacyNotices" class="btn btn-outline-primary btn-sm w-100"><i class="bi bi-file-text me-1"></i>Aydinlatma Metinleri</a></div>
        <div class="col-md-2"><a href="/Kvkk/Consents" class="btn btn-outline-success btn-sm w-100"><i class="bi bi-check2-square me-1"></i>Onaylar</a></div>
        <div class="col-md-2"><a href="/Kvkk/Requests" class="btn btn-outline-warning btn-sm w-100"><i class="bi bi-envelope me-1"></i>Basvurular</a></div>
        <div class="col-md-2"><a href="/Kvkk/Breaches" class="btn btn-outline-danger btn-sm w-100"><i class="bi bi-shield-exclamation me-1"></i>Ihlaller</a></div>
        <div class="col-md-2"><a href="/Kvkk/Transfers" class="btn btn-outline-info btn-sm w-100"><i class="bi bi-globe me-1"></i>Aktarimlar</a></div>
        <div class="col-md-2"><a href="/Kvkk/Inventory" class="btn btn-outline-secondary btn-sm w-100"><i class="bi bi-database me-1"></i>Envanter</a></div>
    </div>

    <!-- Son Aktiviteler -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white">
            <h6 class="mb-0"><i class="bi bi-clock-history me-2"></i>Son Aktiviteler</h6>
        </div>
        <div class="card-body p-0">
            <div class="text-center py-4" data-bind="visible: isLoading"><div class="spinner-border spinner-border-sm text-primary"></div></div>
            <div class="list-group list-group-flush" data-bind="visible: !isLoading(), foreach: recentActivities">
                <div class="list-group-item py-2">
                    <div class="d-flex justify-content-between">
                        <span class="small" data-bind="text: description || '-'"></span>
                        <small class="text-muted" data-bind="text: createdAt ? new Date(createdAt).toLocaleString('tr-TR') : '-'"></small>
                    </div>
                </div>
            </div>
            <div class="text-center text-muted py-3" data-bind="visible: !isLoading() && recentActivities().length === 0">Son aktivite bulunamadi.</div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function KvkkDashboardViewModel() {
    var self = this;
    self.dashboard = ko.observable({});
    self.recentActivities = ko.observableArray([]);
    self.isLoading = ko.observable(false);

    self.loadData = function() {
        self.isLoading(true);
        $.get('/proxy/kvkk/dashboard', function(data) {
            self.dashboard(data || {});
            self.recentActivities(data.recentActivities || []);
        }).always(function() { self.isLoading(false); });
    };

    self.loadData();
}

ko.applyBindings(new KvkkDashboardViewModel(), document.getElementById('kvkk-vm'));
</script>
}
