<div id="privacynotices-vm">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <a href="/Kvkk" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>KVKK Dashboard</a>
        <button class="btn btn-primary btn-sm" data-bind="click: openCreate">
            <i class="bi bi-plus-lg me-1"></i>Yeni Aydinlatma Metni
        </button>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="text-center py-5" data-bind="visible: isLoading"><div class="spinner-border text-primary"></div></div>
            <div class="text-center text-muted py-5" data-bind="visible: !isLoading() && items().length === 0">
                <i class="bi bi-file-text fs-1 d-block mb-2 opacity-25"></i>Aydinlatma metni bulunamadi
            </div>
            <div data-bind="visible: !isLoading() && items().length > 0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Baslik</th>
                                <th>Versiyon</th>
                                <th>Durum</th>
                                <th>Tarih</th>
                                <th style="width:150px;"></th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: items">
                            <tr>
                                <td class="fw-medium" data-bind="text: title || '-'"></td>
                                <td><span class="badge bg-secondary" data-bind="text: version || '-'"></span></td>
                                <td><span class="badge" data-bind="text: isActive ? 'Aktif' : 'Taslak', css: isActive ? 'bg-success' : 'bg-warning'"></span></td>
                                <td class="small text-muted" data-bind="text: createdAt ? new Date(createdAt).toLocaleDateString('tr-TR') : '-'"></td>
                                <td>
                                    <button class="btn btn-outline-success btn-sm me-1" title="Aktif Et" data-bind="click: $parent.activate, visible: !isActive"><i class="bi bi-check-circle"></i></button>
                                    <button class="btn btn-outline-secondary btn-sm me-1" title="Duzenle" data-bind="click: $parent.openEdit"><i class="bi bi-pencil"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Modal -->
    <div class="modal fade" id="noticeModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title" data-bind="text: formTitle"></h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-8 mb-3">
                            <label class="form-label small">Baslik *</label>
                            <input class="form-control form-control-sm" data-bind="value: form.title" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label small">Versiyon</label>
                            <input class="form-control form-control-sm" data-bind="value: form.version" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Icerik *</label>
                        <textarea class="form-control form-control-sm" rows="10" data-bind="value: form.content"></textarea>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/KvkkPrivacyNotices.js" asp-append-version="true"></script>
}
