<div id="consents-vm">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <a href="/Kvkk" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>KVKK Dashboard</a>
        <button class="btn btn-primary btn-sm" data-bind="click: openCreate">
            <i class="bi bi-plus-lg me-1"></i>Yeni Onay
        </button>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="text-center py-5" data-bind="visible: isLoading"><div class="spinner-border text-primary"></div></div>
            <div class="text-center text-muted py-5" data-bind="visible: !isLoading() && items().length === 0">
                <i class="bi bi-check2-square fs-1 d-block mb-2 opacity-25"></i>Onay bulunamadi
            </div>
            <div data-bind="visible: !isLoading() && items().length > 0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Kisi</th>
                                <th>Aydinlatma Metni</th>
                                <th>Onay Tarihi</th>
                                <th>Durum</th>
                                <th style="width:100px;"></th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: items">
                            <tr>
                                <td class="fw-medium" data-bind="text: personName || '-'"></td>
                                <td class="small" data-bind="text: privacyNoticeTitle || '-'"></td>
                                <td class="small text-muted" data-bind="text: consentDate ? new Date(consentDate).toLocaleString('tr-TR') : '-'"></td>
                                <td><span class="badge" data-bind="text: isActive ? 'Aktif' : 'Iptal', css: isActive ? 'bg-success' : 'bg-danger'"></span></td>
                                <td>
                                    <button class="btn btn-outline-danger btn-sm" title="Iptal Et" data-bind="click: $parent.revoke, visible: isActive">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted">Toplam: <span data-bind="text: totalCount"></span> kayit</small>
                    <nav><ul class="pagination pagination-sm mb-0" data-bind="foreach: pageNumbers()">
                        <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                            <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                        </li>
                    </ul></nav>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Modal -->
    <div class="modal fade" id="consentModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">Yeni Onay</h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small">Kisi Bilgisi *</label>
                        <input class="form-control form-control-sm" placeholder="Ad soyad veya kimlik" data-bind="value: form.personName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Aydinlatma Metni *</label>
                        <select class="form-select form-select-sm" data-bind="value: form.privacyNoticeUid, options: privacyNotices, optionsText: 'title', optionsValue: function(i) { return i.uid || i.id; }, optionsCaption: 'Sec...'"></select>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/KvkkConsents.js" asp-append-version="true"></script>
}
