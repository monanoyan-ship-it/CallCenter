<div id="requests-vm">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <a href="/Kvkk" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>KVKK Dashboard</a>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-danger btn-sm" data-bind="click: loadOverdue">
                <i class="bi bi-alarm me-1"></i>Suresi Gecenler
            </button>
            <button class="btn btn-primary btn-sm" data-bind="click: openCreate">
                <i class="bi bi-plus-lg me-1"></i>Yeni Basvuru
            </button>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="text-center py-5" data-bind="visible: isLoading"><div class="spinner-border text-primary"></div></div>
            <div class="text-center text-muted py-5" data-bind="visible: !isLoading() && items().length === 0">
                <i class="bi bi-envelope fs-1 d-block mb-2 opacity-25"></i>Basvuru bulunamadi
            </div>
            <div data-bind="visible: !isLoading() && items().length > 0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Basvuru No</th>
                                <th>Kapsam</th>
                                <th>Kisi</th>
                                <th>Iletisim</th>
                                <th>Tip</th>
                                <th>Durum</th>
                                <th>Tarih</th>
                                <th>Sure</th>
                                <th style="width:100px;"></th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: items">
                            <tr data-bind="css: { 'table-danger': isOverdue }">
                                <td class="fw-medium" data-bind="text: requestNumber || '-'"></td>
                                <td data-bind="text: customerName || '-'"></td>
                                <td data-bind="text: requesterName || '-'"></td>
                                <td class="small text-muted" data-bind="text: requesterContact || '-'"></td>
                                <td>
                                    <span class="badge" data-bind="text: requestTypeName || '-',
                                        css: requestTypeId === 3 ? 'bg-danger' :
                                             requestTypeId === 1 ? 'bg-primary' :
                                             requestTypeId === 4 ? 'bg-warning text-dark' : 'bg-info'"></span>
                                </td>
                                <td>
                                    <span class="badge" data-bind="text: statusName || '-',
                                        css: statusId === 3 ? 'bg-success' :
                                             statusId === 1 ? 'bg-warning text-dark' :
                                             statusId === 4 ? 'bg-danger' : 'bg-secondary'"></span>
                                </td>
                                <td class="small text-muted" data-bind="text: createdAt ? new Date(createdAt).toLocaleDateString('tr-TR') : '-'"></td>
                                <td class="small" data-bind="text: (remainingDays != null ? remainingDays + ' gun' : '-')"></td>
                                <td>
                                    <button class="btn btn-outline-secondary btn-sm" title="Detay" data-bind="click: $parent.openEdit"><i class="bi bi-list-ul"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted">Toplam: <span data-bind="text: totalCount"></span> kayit</small>
                    <nav><ul class="pagination pagination-sm mb-0" data-bind="foreach: pageNumbers()">
                        <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                            <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                        </li>
                    </ul></nav>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Modal -->
    <div class="modal fade" id="requestModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title" data-bind="text: formTitle"></h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Musteri *</label>
                            <select class="form-select form-select-sm" data-bind="options: customers, optionsText: 'name', optionsValue: 'id', value: form.customerId, optionsCaption: 'CorpLynk Platform / seciniz', enable: !form.uid()"></select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Tip *</label>
                            <select class="form-select form-select-sm" data-bind="options: requestTypes, optionsText: 'name', optionsValue: 'id', value: form.requestTypeId, enable: !form.uid()"></select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Basvuran *</label>
                            <input class="form-control form-control-sm" data-bind="value: form.requesterName, enable: !form.uid()" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Iletisim *</label>
                            <input class="form-control form-control-sm" data-bind="value: form.requesterContact, enable: !form.uid()" />
                        </div>
                        <div class="col-12 mb-3" data-bind="visible: !form.uid()">
                            <label class="form-label small">Tanimlayici</label>
                            <input class="form-control form-control-sm" data-bind="value: form.requesterIdentifier" />
                        </div>
                    </div>
                    <div class="mb-3" data-bind="visible: form.uid()">
                        <label class="form-label small">Durum</label>
                        <select class="form-select form-select-sm" data-bind="options: statuses, optionsText: 'name', optionsValue: 'id', value: form.statusId"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Basvuru Aciklamasi</label>
                        <textarea class="form-control form-control-sm" rows="4" data-bind="value: form.requestDescription, enable: !form.uid()"></textarea>
                    </div>
                    <div class="mb-3" data-bind="visible: form.uid()">
                        <label class="form-label small">Yanıt / Islem Notu</label>
                        <textarea class="form-control form-control-sm" rows="3" data-bind="value: form.responseDescription"></textarea>
                    </div>
                    <div class="row g-2" data-bind="visible: form.uid()">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Atanan</label>
                            <input class="form-control form-control-sm" data-bind="value: form.assignedToUserName" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Red Nedeni</label>
                            <input class="form-control form-control-sm" data-bind="value: form.rejectionReason" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/KvkkRequests.js" asp-append-version="true"></script>
}
