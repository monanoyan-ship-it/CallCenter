@{
    ViewData["Title"] = "Dashboard";
}

<div id="dashboard-vm">
    <!-- Ozet Kartlari - Satir 1 -->
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-building"></i></div>
                    <div>
                        <div class="text-muted small">Musteriler</div>
                        <h4 class="mb-0"><span data-bind="text: data().activeCustomers">-</span><small class="text-muted fs-6" data-bind="text: ' / ' + data().totalCustomers"></small></h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-people"></i></div>
                    <div>
                        <div class="text-muted small">Kullanicilar</div>
                        <h4 class="mb-0"><span data-bind="text: data().activeUsers">-</span><small class="text-muted fs-6" data-bind="text: ' / ' + data().totalUsers"></small></h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-info bg-opacity-10 text-info"><i class="bi bi-telephone"></i></div>
                    <div>
                        <div class="text-muted small">Call Center</div>
                        <h4 class="mb-0" data-bind="text: data().totalCallCenterCustomers">-</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-scissors"></i></div>
                    <div>
                        <div class="text-muted small">Salon</div>
                        <h4 class="mb-0" data-bind="text: data().totalSalonCustomers">-</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Ozet Kartlari - Satir 2 (Canli) -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card stat-card border-start border-success border-3">
                <div class="card-body py-2">
                    <div class="text-muted small">Online Agent</div>
                    <h5 class="mb-0 text-success" data-bind="text: data().onlineAgentCount">0</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card border-start border-danger border-3">
                <div class="card-body py-2">
                    <div class="text-muted small">Aktif Cagri</div>
                    <h5 class="mb-0 text-danger" data-bind="text: data().activeCallCount">0</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card border-start border-primary border-3">
                <div class="card-body py-2">
                    <div class="text-muted small">Bugun Toplam</div>
                    <h5 class="mb-0" data-bind="text: data().todayTotalCalls">0</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card border-start border-warning border-3">
                <div class="card-body py-2">
                    <div class="text-muted small">Cevaplanan / Kacan</div>
                    <h5 class="mb-0">
                        <span class="text-success" data-bind="text: data().todayAnsweredCalls">0</span>
                        <small class="text-muted">/</small>
                        <span class="text-danger" data-bind="text: data().todayMissedCalls">0</span>
                    </h5>
                </div>
            </div>
        </div>
    </div>

    <!-- Musteri Modul Kullanim Tablosu -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="bi bi-grid-3x3-gap me-2"></i>Musteri - Modul Kullanimi</h6>
            <button class="btn btn-outline-secondary btn-sm" data-bind="click: loadData">
                <i class="bi bi-arrow-clockwise me-1"></i>Yenile
            </button>
        </div>
        <div class="card-body p-0">
            <div class="text-center py-4" data-bind="visible: isLoading"><div class="spinner-border text-primary"></div></div>
            <div class="table-responsive" data-bind="visible: !isLoading()">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Musteri</th>
                            <th>Urun Tipi</th>
                            <th class="text-center">Personel</th>
                            <th class="text-center">Modul</th>
                            <th>Aktif Moduller</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: data().customerModules || []">
                        <tr data-bind="css: { 'table-secondary': !isActive }">
                            <td>
                                <a class="fw-medium text-decoration-none" data-bind="text: customerName, attr: { href: '/Customers/Detail/' + customerId }"></a>
                            </td>
                            <td>
                                <!-- ko foreach: productTypeNames || [] -->
                                <span class="badge me-1" data-bind="text: $data,
                                    css: $data === 'Call Center' ? 'bg-primary' : 'bg-warning text-dark'"></span>
                                <!-- /ko -->
                                <!-- ko if: !productTypeNames || productTypeNames.length === 0 -->
                                <span class="badge bg-secondary">-</span>
                                <!-- /ko -->
                            </td>
                            <td class="text-center" data-bind="text: personnelCount"></td>
                            <td class="text-center"><span class="badge bg-secondary" data-bind="text: moduleCount"></span></td>
                            <td>
                                <!-- ko foreach: activeModules -->
                                <span class="badge bg-light text-dark border me-1 mb-1" style="font-size:.7rem;" data-bind="text: $data"></span>
                                <!-- /ko -->
                            </td>
                            <td>
                                <span class="badge" data-bind="text: isActive ? 'Aktif' : 'Pasif', css: isActive ? 'bg-success' : 'bg-danger'"></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/Dashboard.js" asp-append-version="true"></script>
}
