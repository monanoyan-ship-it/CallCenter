@{
    ViewData["Title"] = "Sub-Merchants (iyzico Pazaryeri)";
}

<div id="submerchants-vm">
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <span class="text-muted small">Tum salonlarin iyzico Pazaryeri sub-merchant onboarding durumu (PS.12).</span>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <input type="text" class="form-control form-control-sm" placeholder="Salon, slug, key ara..."
                   style="width:240px" data-bind="textInput: search, valueUpdate: 'afterkeydown'" />
            <select class="form-select form-select-sm" style="width:160px"
                    data-bind="value: statusFilter, event: { change: load }">
                <option value="">Hepsi</option>
                <option value="0">Baslamadi</option>
                <option value="1">Beklemede</option>
                <option value="2">Onaylandi</option>
                <option value="3">Reddedildi</option>
            </select>
            <button class="btn btn-outline-secondary btn-sm" data-bind="click: load">
                <i class="bi bi-arrow-repeat"></i>
            </button>
        </div>
    </div>

    <!-- Status sayilari -->
    <div class="row g-2 mb-3">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2">
                    <div class="text-muted small">Onaylandi</div>
                    <div class="fw-bold text-success" data-bind="text: countActive"></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2">
                    <div class="text-muted small">Beklemede</div>
                    <div class="fw-bold text-warning" data-bind="text: countPending"></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2">
                    <div class="text-muted small">Reddedildi</div>
                    <div class="fw-bold text-danger" data-bind="text: countRejected"></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2">
                    <div class="text-muted small">Baslamadi</div>
                    <div class="fw-bold text-secondary" data-bind="text: countNotStarted"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="text-center py-5" data-bind="visible: isLoading">
                <div class="spinner-border text-primary"></div>
            </div>
            <div class="text-center text-muted py-5"
                 data-bind="visible: !isLoading() && filtered().length === 0">
                <i class="bi bi-building fs-1 d-block mb-2 opacity-25"></i>
                Sonuc yok.
            </div>
            <div class="table-responsive" data-bind="visible: !isLoading() && filtered().length > 0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Salon</th>
                            <th>Tip</th>
                            <th>IBAN</th>
                            <th>Iletisim</th>
                            <th>Durum</th>
                            <th>Onboard tarihi</th>
                            <th>Komisyon</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filtered">
                        <tr>
                            <td>
                                <div class="fw-medium" data-bind="text: customerName"></div>
                                <small class="text-muted" data-bind="visible: slug, text: 'slug: ' + slug"></small>
                                <div class="small text-muted text-truncate" style="max-width:220px"
                                     data-bind="visible: iyzicoSubMerchantKey, text: iyzicoSubMerchantKey"></div>
                            </td>
                            <td>
                                <span data-bind="text: $parent.typeLabel(iyzicoSubMerchantType)"></span>
                            </td>
                            <td>
                                <span class="font-monospace small" data-bind="text: iban || '-'"></span>
                            </td>
                            <td>
                                <div data-bind="text: ((contactName || '') + ' ' + (contactSurname || '')).trim() || '-'"></div>
                            </td>
                            <td>
                                <span class="badge"
                                      data-bind="text: onboardingStatus,
                                                 css: $parent.statusBadge(onboardingStatusId)"></span>
                                <div class="small text-danger mt-1"
                                     data-bind="visible: onboardingError, text: onboardingError"></div>
                            </td>
                            <td>
                                <span class="small text-muted"
                                      data-bind="text: onboardedAt ? new Date(onboardedAt).toLocaleDateString('tr-TR') : '-'"></span>
                            </td>
                            <td>
                                <span class="small"
                                      data-bind="text: commissionPercentOverride !== null && commissionPercentOverride !== undefined
                                          ? '%' + commissionPercentOverride + ' (override)'
                                          : '%5 (default)'"></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/SubMerchants.js" asp-append-version="true"></script>
}
