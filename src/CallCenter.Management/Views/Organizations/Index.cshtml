<div id="organizations-vm">
    <!-- Firma Secici -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <select class="form-select form-select-sm" data-bind="value: customerId, options: customers, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Firma Secin...'"></select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary btn-sm w-100" data-bind="click: openCreate, enable: customerId()">
                        <i class="bi bi-plus-lg me-1"></i>Yeni Birim
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3" data-bind="visible: customerId()">
        <!-- Sol Panel: Birim Agaci -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h6 class="mb-0"><i class="bi bi-diagram-3 me-2"></i>Birimler</h6>
                </div>
                <div class="card-body p-0">
                    <div class="text-center py-4" data-bind="visible: isLoading"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                    <div class="text-center text-muted py-4" data-bind="visible: !isLoading() && units().length === 0">Birim bulunamadi.</div>
                    <div class="list-group list-group-flush" data-bind="visible: !isLoading() && units().length > 0, foreach: units">
                        <a href="#" class="list-group-item list-group-item-action py-2" data-bind="click: $parent.selectUnit, css: { active: $parent.selectedUnit() && $parent.selectedUnit().id === id }">
                            <span data-bind="style: { paddingLeft: (level || 0) * 20 + 'px' }">
                                <i class="bi bi-folder2 me-1"></i>
                                <span data-bind="text: name"></span>
                                <small class="text-muted ms-1" data-bind="text: '(' + (unitTypeName || code || '') + ')'"></small>
                            </span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sag Panel: Detay -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm" data-bind="visible: selectedUnit()">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="bi bi-building me-2"></i><span data-bind="text: selectedUnit() ? selectedUnit().name : ''"></span></h6>
                    <div class="d-flex gap-1">
                        <button class="btn btn-outline-secondary btn-sm" data-bind="click: openEditUnit"><i class="bi bi-pencil me-1"></i>Duzenle</button>
                        <button class="btn btn-outline-danger btn-sm" data-bind="click: deleteUnit"><i class="bi bi-trash me-1"></i>Sil</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-4"><small class="text-muted d-block">Kod</small><span data-bind="text: selectedUnit() ? (selectedUnit().code || '-') : '-'"></span></div>
                        <div class="col-md-4"><small class="text-muted d-block">Tip</small><span data-bind="text: selectedUnit() ? (selectedUnit().unitTypeName || '-') : '-'"></span></div>
                        <div class="col-md-4"><small class="text-muted d-block">Ust Birim</small><span data-bind="text: selectedUnit() ? (selectedUnit().parentName || '-') : '-'"></span></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4"><small class="text-muted d-block">Telefon</small><span data-bind="text: selectedUnit() ? (selectedUnit().phone || '-') : '-'"></span></div>
                        <div class="col-md-4"><small class="text-muted d-block">E-posta</small><span data-bind="text: selectedUnit() ? (selectedUnit().email || '-') : '-'"></span></div>
                        <div class="col-md-4"><small class="text-muted d-block">Durum</small><span class="badge" data-bind="visible: selectedUnit(), text: selectedUnit() && selectedUnit().isActive ? 'Aktif' : 'Pasif', css: selectedUnit() && selectedUnit().isActive ? 'bg-success' : 'bg-danger'"></span></div>
                    </div>

                    <hr />
                    <h6 class="small fw-semibold mb-2"><i class="bi bi-people me-1"></i>Personel</h6>
                    <div class="text-center py-3" data-bind="visible: personnelLoading"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                    <table class="table table-sm mb-0" data-bind="visible: !personnelLoading() && personnel().length > 0">
                        <thead class="table-light">
                            <tr><th>Ad Soyad</th><th>Kullanici Adi</th><th style="width:60px;"></th></tr>
                        </thead>
                        <tbody data-bind="foreach: personnel">
                            <tr>
                                <td data-bind="text: fullName || '-'"></td>
                                <td class="small" data-bind="text: username || '-'"></td>
                                <td><button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.removePersonnel"><i class="bi bi-x"></i></button></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="text-muted small py-2" data-bind="visible: !personnelLoading() && personnel().length === 0">Bu birimde personel yok.</div>
                </div>
            </div>
            <div class="card border-0 shadow-sm" data-bind="visible: !selectedUnit()">
                <div class="card-body text-center text-muted py-5">
                    <i class="bi bi-arrow-left-circle fs-1 d-block mb-2 opacity-25"></i>Bir birim secin
                </div>
            </div>
        </div>
    </div>

    <!-- Firma secilmediginde -->
    <div class="card border-0 shadow-sm" data-bind="visible: !customerId()">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-building fs-1 d-block mb-2 opacity-25"></i>Lutfen bir firma secin
        </div>
    </div>

    <!-- Birim Form Modal -->
    <div class="modal fade" id="unitModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title" data-bind="text: formTitle"></h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Birim Adi *</label>
                            <input class="form-control form-control-sm" data-bind="value: form.name" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Kod</label>
                            <input class="form-control form-control-sm" data-bind="value: form.code" />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Tip</label>
                            <select class="form-select form-select-sm" data-bind="value: form.unitType">
                                <option value="Sube">Sube</option>
                                <option value="Departman">Departman</option>
                                <option value="Grup">Grup</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Ust Birim</label>
                            <select class="form-select form-select-sm" data-bind="value: form.parentId, options: units, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Yok'"></select>
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Telefon</label>
                            <input class="form-control form-control-sm" data-bind="value: form.phone" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">E-posta</label>
                            <input class="form-control form-control-sm" data-bind="value: form.email" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Adres</label>
                        <textarea class="form-control form-control-sm" rows="2" data-bind="value: form.address"></textarea>
                    </div>
                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" data-bind="checked: form.isActive" />
                        <label class="form-check-label small">Aktif</label>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/Organizations.js" asp-append-version="true"></script>
}
