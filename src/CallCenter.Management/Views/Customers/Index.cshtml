@{
    ViewData["Title"] = "Musteriler";
}

<div id="customers-vm">
    <!-- Baslik -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div></div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-warning btn-sm" data-bs-toggle="modal" data-bs-target="#billingModal">
                <i class="bi bi-credit-card me-1"></i>Aylik Faturalama
            </button>
            <button class="btn btn-primary btn-sm" data-bind="click: openCreate">
                <i class="bi bi-plus-lg me-1"></i>Yeni Musteri
            </button>
        </div>
    </div>

    <!-- Filtre -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Firma adi, e-posta veya telefon ara..."
                               data-bind="value: searchText, valueUpdate: 'afterkeydown', event: { keyup: onSearchKeyUp }" />
                    </div>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary btn-sm w-100" data-bind="click: loadData">
                        <i class="bi bi-arrow-clockwise me-1"></i>Yenile
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tablo -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="text-center py-5" data-bind="visible: isLoading">
                <div class="spinner-border text-primary"></div>
            </div>
            <div class="text-center text-muted py-5" data-bind="visible: !isLoading() && customers().length === 0">
                <i class="bi bi-building-x fs-1 d-block mb-2 opacity-25"></i>Musteri bulunamadi
            </div>
            <div data-bind="visible: !isLoading() && customers().length > 0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Firma Adi</th>
                                <th>Telefon</th>
                                <th>E-posta</th>
                                <th class="text-center">Personel</th>
                                <th class="text-center">Kuyruk</th>
                                <th class="text-center">SIP</th>
                                <th>Durum</th>
                                <th style="width:170px;"></th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: customers">
                            <tr data-bind="css: { 'table-secondary': !isActive }">
                                <td class="fw-medium" data-bind="text: name"></td>
                                <td class="text-muted small" data-bind="text: phone || '-'"></td>
                                <td class="text-muted small" data-bind="text: email || '-'"></td>
                                <td class="text-center"><span class="badge bg-primary-subtle text-primary rounded-pill" data-bind="text: personnelCount"></span></td>
                                <td class="text-center"><span class="badge bg-info-subtle text-info rounded-pill" data-bind="text: queueCount"></span></td>
                                <td class="text-center"><span class="badge bg-warning-subtle text-warning rounded-pill" data-bind="text: sipAccountCount"></span></td>
                                <td>
                                    <span class="badge" data-bind="text: isActive ? 'Aktif' : 'Pasif', css: isActive ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary'"></span>
                                </td>
                                <td>
                                    <a class="btn btn-outline-primary btn-sm me-1" title="Yonet" data-bind="attr: { href: '/Customers/Detail/' + id }">
                                        <i class="bi bi-sliders2"></i>
                                    </a>
                                    <button class="btn btn-outline-secondary btn-sm me-1" title="Duzenle" data-bind="click: $parent.openEdit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm" title="Sil" data-bind="click: $parent.confirmDelete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted">Toplam: <span data-bind="text: totalCount"></span> kayit</small>
                    <nav>
                        <ul class="pagination pagination-sm mb-0" data-bind="foreach: pageNumbers()">
                            <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                                <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>

    <!-- Musteri Form Modal -->
    <div class="modal fade" id="customerModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title" data-bind="text: formTitle"></h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small">Firma Adi *</label>
                        <input class="form-control form-control-sm" data-bind="value: form.name" />
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Telefon</label>
                            <input class="form-control form-control-sm" data-bind="value: form.phone" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">E-posta</label>
                            <input class="form-control form-control-sm" data-bind="value: form.email" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Urunler</label>
                        <!-- ko foreach: productTypes -->
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <input type="checkbox" class="form-check-input" data-bind="checked: $parent.isProductActive($data.id)" />
                            <span class="small fw-medium" style="min-width:100px" data-bind="text: description"></span>
                            <div class="input-group input-group-sm" style="width:140px">
                                <input type="number" step="0.01" class="form-control form-control-sm"
                                       data-bind="value: $parent.getProductPrice($data.id), enable: $parent.isProductActive($data.id)" placeholder="0.00" />
                                <span class="input-group-text">TL</span>
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Vergi No</label>
                            <input class="form-control form-control-sm" data-bind="value: form.taxNumber" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Max Kullanici</label>
                            <input type="number" class="form-control form-control-sm" data-bind="value: form.maxUsers" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Adres</label>
                        <textarea class="form-control form-control-sm" rows="2" data-bind="value: form.address"></textarea>
                    </div>
                    <!-- Yeni musteri icin admin hesabi -->
                    <div data-bind="visible: !form.id()">
                        <hr />
                        <h6 class="small fw-semibold">Admin Hesabi</h6>
                        <div class="row g-2">
                            <div class="col-md-6 mb-3">
                                <label class="form-label small">Kullanici Adi *</label>
                                <input class="form-control form-control-sm" data-bind="value: form.adminUsername" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label small">Sifre *</label>
                                <input type="password" class="form-control form-control-sm" data-bind="value: form.adminPassword" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-primary btn-sm" data-bind="click: saveCustomer, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Faturalama Modal -->
    <div class="modal fade" id="billingModal" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title"><i class="bi bi-credit-card me-2"></i>Toplu Donem Olustur</h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small">Yil</label>
                        <input type="number" class="form-control form-control-sm" data-bind="value: billingYear" min="2020" max="2100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Ay</label>
                        <select class="form-select form-select-sm" data-bind="value: billingMonth">
                            <option value="1">Ocak</option><option value="2">Subat</option><option value="3">Mart</option>
                            <option value="4">Nisan</option><option value="5">Mayis</option><option value="6">Haziran</option>
                            <option value="7">Temmuz</option><option value="8">Agustos</option><option value="9">Eylul</option>
                            <option value="10">Ekim</option><option value="11">Kasim</option><option value="12">Aralik</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Kapat</button>
                    <button class="btn btn-primary btn-sm" data-bind="click: generateBilling, disable: isGeneratingBilling">
                        <span data-bind="visible: isGeneratingBilling" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-gear me-1"></i>Olustur
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Silme Onay Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-triangle text-danger fs-1 d-block mb-2"></i>
                    <p data-bind="html: deleteMessage"></p>
                </div>
                <div class="modal-footer py-2 justify-content-center">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-danger btn-sm" data-bind="click: executeDelete">Sil</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/Customers.js" asp-append-version="true"></script>
}
