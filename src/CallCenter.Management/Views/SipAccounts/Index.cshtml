<div id="sipaccounts-vm">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div></div>
        <button class="btn btn-primary btn-sm" data-bind="click: openCreate">
            <i class="bi bi-plus-lg me-1"></i>Yeni SIP Hesabi
        </button>
    </div>

    <!-- Filtre -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <select class="form-select form-select-sm" data-bind="value: customerFilter, options: customers, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Tum Firmalar'"></select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary btn-sm w-100" data-bind="click: loadData">
                        <i class="bi bi-arrow-clockwise me-1"></i>Yenile
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tablo -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="text-center py-5" data-bind="visible: isLoading"><div class="spinner-border text-primary"></div></div>
            <div class="text-center text-muted py-5" data-bind="visible: !isLoading() && items().length === 0">
                <i class="bi bi-telephone-x fs-1 d-block mb-2 opacity-25"></i>SIP hesabi bulunamadi
            </div>
            <div data-bind="visible: !isLoading() && items().length > 0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Hesap Adi</th>
                                <th>Firma</th>
                                <th>Sunucu</th>
                                <th>Port</th>
                                <th>Transport</th>
                                <th class="text-center">Hat</th>
                                <th>Durum</th>
                                <th style="width:150px;"></th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: items">
                            <tr>
                                <td class="fw-medium" data-bind="text: name"></td>
                                <td class="small" data-bind="text: customerName || '-'"></td>
                                <td class="small" data-bind="text: server || '-'"></td>
                                <td data-bind="text: port || '-'"></td>
                                <td><span class="badge bg-info" data-bind="text: transport || '-'"></span></td>
                                <td class="text-center"><span class="badge bg-primary rounded-pill" data-bind="text: lineCount || 0"></span></td>
                                <td><span class="badge" data-bind="text: isActive ? 'Aktif' : 'Pasif', css: isActive ? 'bg-success' : 'bg-danger'"></span></td>
                                <td>
                                    <button class="btn btn-outline-info btn-sm me-1" title="Hatlar" data-bind="click: $parent.openLines"><i class="bi bi-list-ul"></i></button>
                                    <button class="btn btn-outline-secondary btn-sm me-1" title="Duzenle" data-bind="click: $parent.openEdit"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-outline-danger btn-sm" title="Sil" data-bind="click: $parent.confirmDelete"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted">Toplam: <span data-bind="text: totalCount"></span> kayit</small>
                    <nav><ul class="pagination pagination-sm mb-0" data-bind="foreach: pageNumbers()">
                        <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                            <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                        </li>
                    </ul></nav>
                </div>
            </div>
        </div>
    </div>

    <!-- SIP Form Modal -->
    <div class="modal fade" id="sipModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title" data-bind="text: formTitle"></h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Hesap Adi *</label>
                            <input class="form-control form-control-sm" data-bind="value: form.name" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Firma</label>
                            <select class="form-select form-select-sm" data-bind="value: form.customerId, options: customers, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Sec...'"></select>
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Sunucu Adresi *</label>
                            <input class="form-control form-control-sm" data-bind="value: form.server" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label small">Port</label>
                            <input type="number" class="form-control form-control-sm" data-bind="value: form.port" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label small">Transport</label>
                            <select class="form-select form-select-sm" data-bind="value: form.transport">
                                <option value="UDP">UDP</option>
                                <option value="TCP">TCP</option>
                                <option value="TLS">TLS</option>
                                <option value="WSS">WSS</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Domain</label>
                            <input class="form-control form-control-sm" data-bind="value: form.domain" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">WebSocket URI</label>
                            <input class="form-control form-control-sm" data-bind="value: form.webSocketUri" />
                        </div>
                    </div>
                    <div class="d-flex gap-3 mb-3">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" data-bind="checked: form.useSrtp" />
                            <label class="form-check-label small">SRTP</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" data-bind="checked: form.isActive" />
                            <label class="form-check-label small">Aktif</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Hatlar Modal -->
    <div class="modal fade" id="linesModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title"><i class="bi bi-list-ul me-2"></i>Hat Yonetimi - <span data-bind="text: selectedAccountName"></span></h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center py-3" data-bind="visible: linesLoading"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                    <div data-bind="visible: !linesLoading()">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Kanal No</th>
                                    <th>Kullanici Adi</th>
                                    <th>Sifre</th>
                                    <th>Aciklama</th>
                                    <th style="width:80px;"></th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: lines">
                                <tr>
                                    <td><input class="form-control form-control-sm" data-bind="value: channelNo" style="width:70px" /></td>
                                    <td><input class="form-control form-control-sm" data-bind="value: username" /></td>
                                    <td><input class="form-control form-control-sm" data-bind="value: password" /></td>
                                    <td><input class="form-control form-control-sm" data-bind="value: description" /></td>
                                    <td>
                                        <button class="btn btn-outline-success btn-sm me-1" title="Kaydet" data-bind="click: $parent.saveLine"><i class="bi bi-check"></i></button>
                                        <button class="btn btn-outline-danger btn-sm" title="Sil" data-bind="click: $parent.deleteLine"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="text-center text-muted py-3" data-bind="visible: lines().length === 0">Hat bulunamadi.</div>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-outline-primary btn-sm" data-bind="click: addLine"><i class="bi bi-plus-lg me-1"></i>Yeni Hat</button>
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Silme Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-triangle text-danger fs-1 d-block mb-2"></i>
                    <p>Bu SIP hesabini silmek istediginize emin misiniz?</p>
                </div>
                <div class="modal-footer py-2 justify-content-center">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-danger btn-sm" data-bind="click: executeDelete">Sil</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function SipAccountsViewModel() {
    var self = this;
    self.items = ko.observableArray([]);
    self.customers = ko.observableArray([]);
    self.isLoading = ko.observable(false);
    self.isSaving = ko.observable(false);
    self.customerFilter = ko.observable('');
    self.currentPage = ko.observable(1);
    self.totalCount = ko.observable(0);
    self.pageSize = 20;
    self.formTitle = ko.observable('Yeni SIP Hesabi');
    self.deleteId = null;

    // Lines
    self.lines = ko.observableArray([]);
    self.linesLoading = ko.observable(false);
    self.selectedAccountId = null;
    self.selectedAccountName = ko.observable('');

    self.form = {
        id: ko.observable(null), name: ko.observable(''), customerId: ko.observable(''),
        server: ko.observable(''), port: ko.observable(5060), transport: ko.observable('UDP'),
        domain: ko.observable(''), webSocketUri: ko.observable(''),
        useSrtp: ko.observable(false), isActive: ko.observable(true)
    };

    self.pageNumbers = ko.computed(function() {
        var total = Math.ceil(self.totalCount() / self.pageSize);
        var pages = [];
        for (var i = 1; i <= total; i++) pages.push(i);
        return pages;
    });

    self.goToPage = function(page) { self.currentPage(page); self.loadData(); };

    self.loadCustomers = function() {
        $.get('/proxy/supervisor/customers', function(data) {
            self.customers(Array.isArray(data) ? data : (data.items || data.data || []));
        });
    };

    self.loadData = function() {
        self.isLoading(true);
        var params = { page: self.currentPage(), pageSize: self.pageSize };
        if (self.customerFilter()) params.customerId = self.customerFilter();
        $.get('/proxy/sipaccounts', params, function(data) {
            var items = Array.isArray(data) ? data : (data.items || data.data || []);
            self.items(items);
            self.totalCount(data.totalCount || data.total || items.length);
        }).always(function() { self.isLoading(false); });
    };

    self.customerFilter.subscribe(function() { self.currentPage(1); self.loadData(); });

    self.resetForm = function() {
        self.form.id(null); self.form.name(''); self.form.customerId('');
        self.form.server(''); self.form.port(5060); self.form.transport('UDP');
        self.form.domain(''); self.form.webSocketUri('');
        self.form.useSrtp(false); self.form.isActive(true);
    };

    self.openCreate = function() {
        self.resetForm(); self.formTitle('Yeni SIP Hesabi');
        new bootstrap.Modal('#sipModal').show();
    };

    self.openEdit = function(item) {
        self.form.id(item.id); self.form.name(item.name || '');
        self.form.customerId(item.customerId || '');
        self.form.server(item.server || ''); self.form.port(item.port || 5060);
        self.form.transport(item.transport || 'UDP');
        self.form.domain(item.domain || ''); self.form.webSocketUri(item.webSocketUri || '');
        self.form.useSrtp(item.useSrtp || false); self.form.isActive(item.isActive !== false);
        self.formTitle('SIP Hesabi Duzenle');
        new bootstrap.Modal('#sipModal').show();
    };

    self.save = function() {
        if (!self.form.name() || !self.form.server()) { toastr.warning('Hesap adi ve sunucu zorunludur.'); return; }
        self.isSaving(true);
        var payload = {
            name: self.form.name(), customerId: self.form.customerId() || null,
            server: self.form.server(), port: parseInt(self.form.port()),
            transport: self.form.transport(), domain: self.form.domain(),
            webSocketUri: self.form.webSocketUri(), useSrtp: self.form.useSrtp(),
            isActive: self.form.isActive()
        };
        var method = self.form.id() ? 'PUT' : 'POST';
        var url = self.form.id() ? '/proxy/sipaccounts/' + self.form.id() : '/proxy/sipaccounts';
        $.ajax({
            url: url, method: method, contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function() {
                toastr.success('Kaydedildi.'); bootstrap.Modal.getInstance(document.getElementById('sipModal')).hide();
                self.loadData();
            },
            error: function() { toastr.error('Kaydetme hatasi.'); }
        }).always(function() { self.isSaving(false); });
    };

    self.confirmDelete = function(item) { self.deleteId = item.id; new bootstrap.Modal('#deleteModal').show(); };

    self.executeDelete = function() {
        $.ajax({
            url: '/proxy/sipaccounts/' + self.deleteId, method: 'DELETE',
            success: function() { toastr.success('Silindi.'); bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide(); self.loadData(); },
            error: function() { toastr.error('Silme hatasi.'); }
        });
    };

    // Lines
    self.openLines = function(item) {
        self.selectedAccountId = item.id;
        self.selectedAccountName(item.name || '');
        self.loadLines();
        new bootstrap.Modal('#linesModal').show();
    };

    self.loadLines = function() {
        self.linesLoading(true);
        $.get('/proxy/sipaccounts/' + self.selectedAccountId + '/lines', function(data) {
            var items = Array.isArray(data) ? data : (data.items || data.data || []);
            self.lines(items.map(function(l) {
                return {
                    id: l.id, channelNo: ko.observable(l.channelNo || ''),
                    username: ko.observable(l.username || ''), password: ko.observable(l.password || ''),
                    description: ko.observable(l.description || '')
                };
            }));
        }).always(function() { self.linesLoading(false); });
    };

    self.addLine = function() {
        self.lines.push({ id: null, channelNo: ko.observable(''), username: ko.observable(''), password: ko.observable(''), description: ko.observable('') });
    };

    self.saveLine = function(line) {
        var payload = { channelNo: line.channelNo(), username: line.username(), password: line.password(), description: line.description() };
        var method = line.id ? 'PUT' : 'POST';
        var url = line.id ? '/proxy/sipaccounts/' + self.selectedAccountId + '/lines/' + line.id
                          : '/proxy/sipaccounts/' + self.selectedAccountId + '/lines';
        $.ajax({
            url: url, method: method, contentType: 'application/json', data: JSON.stringify(payload),
            success: function() { toastr.success('Hat kaydedildi.'); self.loadLines(); self.loadData(); },
            error: function() { toastr.error('Hat kaydetme hatasi.'); }
        });
    };

    self.deleteLine = function(line) {
        if (!line.id) { self.lines.remove(line); return; }
        $.ajax({
            url: '/proxy/sipaccounts/' + self.selectedAccountId + '/lines/' + line.id, method: 'DELETE',
            success: function() { toastr.success('Hat silindi.'); self.loadLines(); self.loadData(); },
            error: function() { toastr.error('Hat silme hatasi.'); }
        });
    };

    self.loadCustomers();
    self.loadData();
}

ko.applyBindings(new SipAccountsViewModel(), document.getElementById('sipaccounts-vm'));
</script>
}
