<div id="ivr-vm">
    <!-- Firma Secici -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <select class="form-select form-select-sm" data-bind="value: customerId, options: customers, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Firma Secin...'"></select>
                </div>
            </div>
        </div>
    </div>

    <!-- Tablar -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabGreetings">Karsilama Mesajlari</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabMenus">IVR Menuler</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabHoldMusic">Bekleme Muzigi</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabBusinessHours">Mesai Saatleri</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabHolidays">Tatiller</a></li>
    </ul>

    <div class="tab-content">
        <!-- Tab 1: Karsilama Mesajlari -->
        <div class="tab-pane fade show active" id="tabGreetings">
            <div class="d-flex justify-content-between mb-2">
                <div></div>
                <button class="btn btn-primary btn-sm" data-bind="click: openCreateGreeting, enable: customerId()">
                    <i class="bi bi-plus-lg me-1"></i>Yeni Mesaj
                </button>
            </div>
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="text-center py-4" data-bind="visible: greetingsLoading"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                    <div data-bind="visible: !greetingsLoading()">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr><th>Tip</th><th>Metin</th><th>Dil</th><th style="width:100px;"></th></tr>
                            </thead>
                            <tbody data-bind="foreach: greetings">
                                <tr>
                                    <td><span class="badge bg-info" data-bind="text: type || '-'"></span></td>
                                    <td class="small" data-bind="text: text || '-'"></td>
                                    <td data-bind="text: language || '-'"></td>
                                    <td>
                                        <button class="btn btn-outline-secondary btn-sm me-1" data-bind="click: $parent.openEditGreeting"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.deleteGreeting"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="text-center text-muted py-3" data-bind="visible: greetings().length === 0">Mesaj bulunamadi.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 2: IVR Menuler -->
        <div class="tab-pane fade" id="tabMenus">
            <div class="d-flex justify-content-between mb-2">
                <div></div>
                <button class="btn btn-primary btn-sm" data-bind="click: openCreateMenu, enable: customerId()">
                    <i class="bi bi-plus-lg me-1"></i>Yeni Menu
                </button>
            </div>
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="text-center py-4" data-bind="visible: menusLoading"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                    <div data-bind="visible: !menusLoading()">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr><th>Menu Adi</th><th>Karsilama</th><th>Secenek Sayisi</th><th style="width:100px;"></th></tr>
                            </thead>
                            <tbody data-bind="foreach: menus">
                                <tr>
                                    <td class="fw-medium" data-bind="text: name || '-'"></td>
                                    <td class="small" data-bind="text: greetingName || '-'"></td>
                                    <td><span class="badge bg-primary rounded-pill" data-bind="text: (options || []).length"></span></td>
                                    <td>
                                        <button class="btn btn-outline-secondary btn-sm me-1" data-bind="click: $parent.openEditMenu"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.deleteMenu"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="text-center text-muted py-3" data-bind="visible: menus().length === 0">Menu bulunamadi.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 3: Bekleme Muzigi -->
        <div class="tab-pane fade" id="tabHoldMusic">
            <div class="d-flex justify-content-between mb-2">
                <div></div>
                <button class="btn btn-primary btn-sm" data-bind="click: openCreateHoldMusic, enable: customerId()">
                    <i class="bi bi-plus-lg me-1"></i>Yeni Muzik
                </button>
            </div>
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="text-center py-4" data-bind="visible: holdMusicLoading"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                    <div data-bind="visible: !holdMusicLoading()">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr><th>Dosya Adi</th><th>Aciklama</th><th style="width:100px;"></th></tr>
                            </thead>
                            <tbody data-bind="foreach: holdMusic">
                                <tr>
                                    <td class="fw-medium" data-bind="text: fileName || name || '-'"></td>
                                    <td class="small text-muted" data-bind="text: description || '-'"></td>
                                    <td>
                                        <button class="btn btn-outline-secondary btn-sm me-1" data-bind="click: $parent.openEditHoldMusic"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.deleteHoldMusic"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="text-center text-muted py-3" data-bind="visible: holdMusic().length === 0">Muzik bulunamadi.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 4: Mesai Saatleri -->
        <div class="tab-pane fade" id="tabBusinessHours">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-center py-4" data-bind="visible: businessHoursLoading"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                    <div data-bind="visible: !businessHoursLoading()">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr><th>Gun</th><th>Baslangic</th><th>Bitis</th></tr>
                            </thead>
                            <tbody data-bind="foreach: businessHours">
                                <tr>
                                    <td class="fw-medium" data-bind="text: dayName"></td>
                                    <td><input type="time" class="form-control form-control-sm" style="width:130px" data-bind="value: startTime" /></td>
                                    <td><input type="time" class="form-control form-control-sm" style="width:130px" data-bind="value: endTime" /></td>
                                </tr>
                            </tbody>
                        </table>
                        <button class="btn btn-primary btn-sm mt-3" data-bind="click: saveBusinessHours, enable: customerId()">
                            <i class="bi bi-check-lg me-1"></i>Kaydet
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 5: Tatiller -->
        <div class="tab-pane fade" id="tabHolidays">
            <div class="d-flex justify-content-between mb-2">
                <div></div>
                <button class="btn btn-primary btn-sm" data-bind="click: openCreateHoliday, enable: customerId()">
                    <i class="bi bi-plus-lg me-1"></i>Yeni Tatil
                </button>
            </div>
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="text-center py-4" data-bind="visible: holidaysLoading"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                    <div data-bind="visible: !holidaysLoading()">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr><th>Tarih</th><th>Ad</th><th>Yinelenen</th><th style="width:100px;"></th></tr>
                            </thead>
                            <tbody data-bind="foreach: holidays">
                                <tr>
                                    <td data-bind="text: date || '-'"></td>
                                    <td class="fw-medium" data-bind="text: name || '-'"></td>
                                    <td><span class="badge" data-bind="text: isRecurring ? 'Evet' : 'Hayir', css: isRecurring ? 'bg-success' : 'bg-secondary'"></span></td>
                                    <td>
                                        <button class="btn btn-outline-secondary btn-sm me-1" data-bind="click: $parent.openEditHoliday"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.deleteHoliday"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="text-center text-muted py-3" data-bind="visible: holidays().length === 0">Tatil bulunamadi.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Karsilama Modal -->
    <div class="modal fade" id="greetingModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title" data-bind="text: greetingFormTitle"></h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Tip *</label>
                            <select class="form-select form-select-sm" data-bind="value: greetingForm.type">
                                <option value="TTS">TTS</option>
                                <option value="File">Dosya</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Dil</label>
                            <select class="form-select form-select-sm" data-bind="value: greetingForm.language">
                                <option value="tr">Turkce</option>
                                <option value="en">English</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Metin *</label>
                        <textarea class="form-control form-control-sm" rows="3" data-bind="value: greetingForm.text"></textarea>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-primary btn-sm" data-bind="click: saveGreeting"><i class="bi bi-check-lg me-1"></i>Kaydet</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Menu Modal -->
    <div class="modal fade" id="menuModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title" data-bind="text: menuFormTitle"></h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Menu Adi *</label>
                            <input class="form-control form-control-sm" data-bind="value: menuForm.name" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Karsilama Mesaji</label>
                            <select class="form-select form-select-sm" data-bind="value: menuForm.greetingId, options: greetings, optionsText: 'text', optionsValue: 'id', optionsCaption: 'Sec...'"></select>
                        </div>
                    </div>
                    <h6 class="small fw-semibold mt-2">Menu Secenekleri</h6>
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th style="width:60px">Tus</th><th>Aksiyon</th><th>Hedef</th><th style="width:60px"></th></tr>
                        </thead>
                        <tbody data-bind="foreach: menuForm.options">
                            <tr>
                                <td><input class="form-control form-control-sm" data-bind="value: digit" style="width:50px" /></td>
                                <td>
                                    <select class="form-select form-select-sm" data-bind="value: action">
                                        <option value="Queue">Kuyruk</option>
                                        <option value="Extension">Dahili</option>
                                        <option value="Menu">Alt Menu</option>
                                        <option value="Voicemail">Sesli Mesaj</option>
                                        <option value="Hangup">Kapat</option>
                                    </select>
                                </td>
                                <td><input class="form-control form-control-sm" data-bind="value: target" /></td>
                                <td><button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.removeMenuOption"><i class="bi bi-trash"></i></button></td>
                            </tr>
                        </tbody>
                    </table>
                    <button class="btn btn-outline-primary btn-sm mt-2" data-bind="click: addMenuOption"><i class="bi bi-plus-lg me-1"></i>Secenek Ekle</button>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-primary btn-sm" data-bind="click: saveMenu"><i class="bi bi-check-lg me-1"></i>Kaydet</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bekleme Muzigi Modal -->
    <div class="modal fade" id="holdMusicModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title" data-bind="text: holdMusicFormTitle"></h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small">Dosya Adi *</label>
                        <input class="form-control form-control-sm" data-bind="value: holdMusicForm.fileName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Aciklama</label>
                        <input class="form-control form-control-sm" data-bind="value: holdMusicForm.description" />
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-primary btn-sm" data-bind="click: saveHoldMusic"><i class="bi bi-check-lg me-1"></i>Kaydet</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tatil Modal -->
    <div class="modal fade" id="holidayModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title" data-bind="text: holidayFormTitle"></h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Tarih *</label>
                            <input type="date" class="form-control form-control-sm" data-bind="value: holidayForm.date" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small">Ad *</label>
                            <input class="form-control form-control-sm" data-bind="value: holidayForm.name" />
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" data-bind="checked: holidayForm.isRecurring" />
                        <label class="form-check-label small">Her yil tekrarlanan</label>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button class="btn btn-primary btn-sm" data-bind="click: saveHoliday"><i class="bi bi-check-lg me-1"></i>Kaydet</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
var dayNames = ['Pazartesi', 'Sali', 'Carsamba', 'Persembe', 'Cuma', 'Cumartesi', 'Pazar'];

function IvrViewModel() {
    var self = this;
    self.customers = ko.observableArray([]);
    self.customerId = ko.observable('');

    // Greetings
    self.greetings = ko.observableArray([]);
    self.greetingsLoading = ko.observable(false);
    self.greetingFormTitle = ko.observable('Yeni Mesaj');
    self.greetingForm = { id: ko.observable(null), type: ko.observable('TTS'), text: ko.observable(''), language: ko.observable('tr') };

    // Menus
    self.menus = ko.observableArray([]);
    self.menusLoading = ko.observable(false);
    self.menuFormTitle = ko.observable('Yeni Menu');
    self.menuForm = { id: ko.observable(null), name: ko.observable(''), greetingId: ko.observable(''), options: ko.observableArray([]) };

    // Hold Music
    self.holdMusic = ko.observableArray([]);
    self.holdMusicLoading = ko.observable(false);
    self.holdMusicFormTitle = ko.observable('Yeni Muzik');
    self.holdMusicForm = { id: ko.observable(null), fileName: ko.observable(''), description: ko.observable('') };

    // Business Hours
    self.businessHours = ko.observableArray([]);
    self.businessHoursLoading = ko.observable(false);

    // Holidays
    self.holidays = ko.observableArray([]);
    self.holidaysLoading = ko.observable(false);
    self.holidayFormTitle = ko.observable('Yeni Tatil');
    self.holidayForm = { id: ko.observable(null), date: ko.observable(''), name: ko.observable(''), isRecurring: ko.observable(false) };

    self.loadCustomers = function() {
        $.get('/proxy/supervisor/customers', function(data) {
            self.customers(Array.isArray(data) ? data : (data.items || data.data || []));
        });
    };

    self.customerId.subscribe(function(val) { if (val) self.loadAll(); });

    self.loadAll = function() {
        self.loadGreetings(); self.loadMenus(); self.loadHoldMusic();
        self.loadBusinessHours(); self.loadHolidays();
    };

    // Greetings CRUD
    self.loadGreetings = function() {
        self.greetingsLoading(true);
        $.get('/proxy/ivr/greetings', { customerId: self.customerId() }, function(data) {
            self.greetings(Array.isArray(data) ? data : (data.items || data.data || []));
        }).always(function() { self.greetingsLoading(false); });
    };

    self.openCreateGreeting = function() {
        self.greetingForm.id(null); self.greetingForm.type('TTS'); self.greetingForm.text(''); self.greetingForm.language('tr');
        self.greetingFormTitle('Yeni Mesaj');
        new bootstrap.Modal('#greetingModal').show();
    };

    self.openEditGreeting = function(item) {
        self.greetingForm.id(item.id); self.greetingForm.type(item.type || 'TTS');
        self.greetingForm.text(item.text || ''); self.greetingForm.language(item.language || 'tr');
        self.greetingFormTitle('Mesaj Duzenle');
        new bootstrap.Modal('#greetingModal').show();
    };

    self.saveGreeting = function() {
        var payload = { customerId: parseInt(self.customerId()), type: self.greetingForm.type(), text: self.greetingForm.text(), language: self.greetingForm.language() };
        var method = self.greetingForm.id() ? 'PUT' : 'POST';
        var url = self.greetingForm.id() ? '/proxy/ivr/greetings/' + self.greetingForm.id() : '/proxy/ivr/greetings';
        $.ajax({ url: url, method: method, contentType: 'application/json', data: JSON.stringify(payload),
            success: function() { toastr.success('Kaydedildi.'); bootstrap.Modal.getInstance(document.getElementById('greetingModal')).hide(); self.loadGreetings(); },
            error: function() { toastr.error('Hata.'); }
        });
    };

    self.deleteGreeting = function(item) {
        if (!confirm('Silmek istediginize emin misiniz?')) return;
        $.ajax({ url: '/proxy/ivr/greetings/' + item.id, method: 'DELETE',
            success: function() { toastr.success('Silindi.'); self.loadGreetings(); },
            error: function() { toastr.error('Silme hatasi.'); }
        });
    };

    // Menus CRUD
    self.loadMenus = function() {
        self.menusLoading(true);
        $.get('/proxy/ivr/menus', { customerId: self.customerId() }, function(data) {
            self.menus(Array.isArray(data) ? data : (data.items || data.data || []));
        }).always(function() { self.menusLoading(false); });
    };

    self.openCreateMenu = function() {
        self.menuForm.id(null); self.menuForm.name(''); self.menuForm.greetingId(''); self.menuForm.options([]);
        self.menuFormTitle('Yeni Menu');
        new bootstrap.Modal('#menuModal').show();
    };

    self.openEditMenu = function(item) {
        self.menuForm.id(item.id); self.menuForm.name(item.name || ''); self.menuForm.greetingId(item.greetingId || '');
        var opts = (item.options || []).map(function(o) { return { digit: ko.observable(o.digit), action: ko.observable(o.action), target: ko.observable(o.target) }; });
        self.menuForm.options(opts);
        self.menuFormTitle('Menu Duzenle');
        new bootstrap.Modal('#menuModal').show();
    };

    self.addMenuOption = function() {
        self.menuForm.options.push({ digit: ko.observable(''), action: ko.observable('Queue'), target: ko.observable('') });
    };

    self.removeMenuOption = function(opt) { self.menuForm.options.remove(opt); };

    self.saveMenu = function() {
        var opts = self.menuForm.options().map(function(o) { return { digit: o.digit(), action: o.action(), target: o.target() }; });
        var payload = { customerId: parseInt(self.customerId()), name: self.menuForm.name(), greetingId: self.menuForm.greetingId() || null, options: opts };
        var method = self.menuForm.id() ? 'PUT' : 'POST';
        var url = self.menuForm.id() ? '/proxy/ivr/menus/' + self.menuForm.id() : '/proxy/ivr/menus';
        $.ajax({ url: url, method: method, contentType: 'application/json', data: JSON.stringify(payload),
            success: function() { toastr.success('Kaydedildi.'); bootstrap.Modal.getInstance(document.getElementById('menuModal')).hide(); self.loadMenus(); },
            error: function() { toastr.error('Hata.'); }
        });
    };

    self.deleteMenu = function(item) {
        if (!confirm('Silmek istediginize emin misiniz?')) return;
        $.ajax({ url: '/proxy/ivr/menus/' + item.id, method: 'DELETE',
            success: function() { toastr.success('Silindi.'); self.loadMenus(); },
            error: function() { toastr.error('Silme hatasi.'); }
        });
    };

    // Hold Music CRUD
    self.loadHoldMusic = function() {
        self.holdMusicLoading(true);
        $.get('/proxy/ivr/hold-music', { customerId: self.customerId() }, function(data) {
            self.holdMusic(Array.isArray(data) ? data : (data.items || data.data || []));
        }).always(function() { self.holdMusicLoading(false); });
    };

    self.openCreateHoldMusic = function() {
        self.holdMusicForm.id(null); self.holdMusicForm.fileName(''); self.holdMusicForm.description('');
        self.holdMusicFormTitle('Yeni Muzik');
        new bootstrap.Modal('#holdMusicModal').show();
    };

    self.openEditHoldMusic = function(item) {
        self.holdMusicForm.id(item.id); self.holdMusicForm.fileName(item.fileName || item.name || '');
        self.holdMusicForm.description(item.description || '');
        self.holdMusicFormTitle('Muzik Duzenle');
        new bootstrap.Modal('#holdMusicModal').show();
    };

    self.saveHoldMusic = function() {
        var payload = { customerId: parseInt(self.customerId()), fileName: self.holdMusicForm.fileName(), description: self.holdMusicForm.description() };
        var method = self.holdMusicForm.id() ? 'PUT' : 'POST';
        var url = self.holdMusicForm.id() ? '/proxy/ivr/hold-music/' + self.holdMusicForm.id() : '/proxy/ivr/hold-music';
        $.ajax({ url: url, method: method, contentType: 'application/json', data: JSON.stringify(payload),
            success: function() { toastr.success('Kaydedildi.'); bootstrap.Modal.getInstance(document.getElementById('holdMusicModal')).hide(); self.loadHoldMusic(); },
            error: function() { toastr.error('Hata.'); }
        });
    };

    self.deleteHoldMusic = function(item) {
        if (!confirm('Silmek istediginize emin misiniz?')) return;
        $.ajax({ url: '/proxy/ivr/hold-music/' + item.id, method: 'DELETE',
            success: function() { toastr.success('Silindi.'); self.loadHoldMusic(); },
            error: function() { toastr.error('Silme hatasi.'); }
        });
    };

    // Business Hours
    self.loadBusinessHours = function() {
        self.businessHoursLoading(true);
        $.get('/proxy/ivr/business-hours', { customerId: self.customerId() }, function(data) {
            var items = Array.isArray(data) ? data : (data.items || data.data || []);
            if (items.length === 0) {
                items = dayNames.map(function(d, i) { return { dayOfWeek: i, dayName: d, startTime: ko.observable('09:00'), endTime: ko.observable('18:00') }; });
            } else {
                items = items.map(function(h) {
                    return { dayOfWeek: h.dayOfWeek, dayName: dayNames[h.dayOfWeek] || h.dayName, startTime: ko.observable(h.startTime || '09:00'), endTime: ko.observable(h.endTime || '18:00'), id: h.id };
                });
            }
            self.businessHours(items);
        }).always(function() { self.businessHoursLoading(false); });
    };

    self.saveBusinessHours = function() {
        var payload = self.businessHours().map(function(h) {
            return { customerId: parseInt(self.customerId()), dayOfWeek: h.dayOfWeek, startTime: h.startTime(), endTime: h.endTime() };
        });
        $.ajax({ url: '/proxy/ivr/business-hours?customerId=' + self.customerId(), method: 'POST', contentType: 'application/json', data: JSON.stringify(payload),
            success: function() { toastr.success('Mesai saatleri kaydedildi.'); },
            error: function() { toastr.error('Kaydetme hatasi.'); }
        });
    };

    // Holidays CRUD
    self.loadHolidays = function() {
        self.holidaysLoading(true);
        $.get('/proxy/ivr/holidays', { customerId: self.customerId() }, function(data) {
            self.holidays(Array.isArray(data) ? data : (data.items || data.data || []));
        }).always(function() { self.holidaysLoading(false); });
    };

    self.openCreateHoliday = function() {
        self.holidayForm.id(null); self.holidayForm.date(''); self.holidayForm.name(''); self.holidayForm.isRecurring(false);
        self.holidayFormTitle('Yeni Tatil');
        new bootstrap.Modal('#holidayModal').show();
    };

    self.openEditHoliday = function(item) {
        self.holidayForm.id(item.id); self.holidayForm.date(item.date || '');
        self.holidayForm.name(item.name || ''); self.holidayForm.isRecurring(item.isRecurring || false);
        self.holidayFormTitle('Tatil Duzenle');
        new bootstrap.Modal('#holidayModal').show();
    };

    self.saveHoliday = function() {
        var payload = { customerId: parseInt(self.customerId()), date: self.holidayForm.date(), name: self.holidayForm.name(), isRecurring: self.holidayForm.isRecurring() };
        var method = self.holidayForm.id() ? 'PUT' : 'POST';
        var url = self.holidayForm.id() ? '/proxy/ivr/holidays/' + self.holidayForm.id() : '/proxy/ivr/holidays';
        $.ajax({ url: url, method: method, contentType: 'application/json', data: JSON.stringify(payload),
            success: function() { toastr.success('Kaydedildi.'); bootstrap.Modal.getInstance(document.getElementById('holidayModal')).hide(); self.loadHolidays(); },
            error: function() { toastr.error('Hata.'); }
        });
    };

    self.deleteHoliday = function(item) {
        if (!confirm('Silmek istediginize emin misiniz?')) return;
        $.ajax({ url: '/proxy/ivr/holidays/' + item.id, method: 'DELETE',
            success: function() { toastr.success('Silindi.'); self.loadHolidays(); },
            error: function() { toastr.error('Silme hatasi.'); }
        });
    };

    self.loadCustomers();
}

ko.applyBindings(new IvrViewModel(), document.getElementById('ivr-vm'));
</script>
}
