@{
    ViewData["Title"] = "Salon Odeme Takibi";
}

<div id="salon-billing-vm">
    <!-- Filtreler -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-2">
                    <input type="number" class="form-control form-control-sm" placeholder="Yil" data-bind="value: yearFilter" min="2020" max="2100" />
                </div>
                <div class="col-md-2">
                    <select class="form-select form-select-sm" data-bind="value: monthFilter">
                        <option value="">Tum Aylar</option>
                        <option value="1">Ocak</option><option value="2">Subat</option><option value="3">Mart</option>
                        <option value="4">Nisan</option><option value="5">Mayis</option><option value="6">Haziran</option>
                        <option value="7">Temmuz</option><option value="8">Agustos</option><option value="9">Eylul</option>
                        <option value="10">Ekim</option><option value="11">Kasim</option><option value="12">Aralik</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select form-select-sm" data-bind="value: statusFilter">
                        <option value="">Tum Durumlar</option>
                        <option value="1">Tahakkuk</option>
                        <option value="2">Faturalanmis</option>
                        <option value="3">Odenmis</option>
                        <option value="4">Gecikme</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary btn-sm w-100" data-bind="click: loadData">
                        <i class="bi bi-funnel me-1"></i>Filtrele
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Ozet Kartlari -->
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card stat-card border-start border-primary border-3">
                <div class="card-body py-2">
                    <div class="text-muted small">Toplam Tahakkuk</div>
                    <h4 class="mb-0" data-bind="text: summary().totalCount || 0"></h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card border-start border-warning border-3">
                <div class="card-body py-2">
                    <div class="text-muted small">Odeme Bekleyen</div>
                    <h4 class="mb-0 text-warning" data-bind="text: summary().unpaidCount || 0"></h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card border-start border-success border-3">
                <div class="card-body py-2">
                    <div class="text-muted small">Odenmis</div>
                    <h4 class="mb-0 text-success" data-bind="text: summary().paidCount || 0"></h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card border-start border-danger border-3">
                <div class="card-body py-2">
                    <div class="text-muted small">Geciken</div>
                    <h4 class="mb-0 text-danger" data-bind="text: summary().overdueCount || 0"></h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Toplu Islemler -->
    <div class="d-flex gap-2 mb-3" data-bind="visible: selectedIds().length > 0">
        <span class="badge bg-primary align-self-center" data-bind="text: selectedIds().length + ' secili'"></span>
        <button class="btn btn-outline-success btn-sm" data-bind="click: function() { showPaymentModal('bulk'); }">
            <i class="bi bi-credit-card me-1"></i>Odeme Al
        </button>
        <button class="btn btn-outline-warning btn-sm" data-bind="click: bulkInvoice">
            <i class="bi bi-receipt me-1"></i>Fatura Kes
        </button>
    </div>

    <!-- Tablo -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="text-center py-5" data-bind="visible: isLoading"><div class="spinner-border text-primary"></div></div>
            <div class="text-center text-muted py-5" data-bind="visible: !isLoading() && items().length === 0">
                <i class="bi bi-file-earmark-text fs-1 d-block mb-2 opacity-25"></i>Kayit bulunamadi
            </div>
            <div data-bind="visible: !isLoading() && items().length > 0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:40px;"><input type="checkbox" class="form-check-input" data-bind="checked: selectAll" /></th>
                                <th>Salon</th>
                                <th>Donem</th>
                                <th class="text-end">Temel + şube</th>
                                <th class="text-end">Hizmet paketleri</th>
                                <th class="text-end">Dönem toplamı</th>
                                <th>Odeme</th>
                                <th>Durum</th>
                                <th style="width:150px;">Islem</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: items">
                            <tr>
                                <td><input type="checkbox" class="form-check-input" data-bind="checkedValue: periodId, checked: $parent.selectedIds" /></td>
                                <td class="fw-medium" data-bind="text: customerName || '-'"></td>
                                <td data-bind="text: (month || '-') + '/' + (year || '-')"></td>
                                <td class="text-end" data-bind="text: (amount || 0).toFixed(2) + ' TL'"></td>
                                <td class="text-end" data-bind="text: (serviceAmount || 0).toFixed(2) + ' TL'"></td>
                                <td class="text-end fw-semibold" data-bind="text: ((amount || 0) + (serviceAmount || 0)).toFixed(2) + ' TL'"></td>
                                <td>
                                    <span data-bind="if: paymentMethodName">
                                        <span class="badge bg-secondary" data-bind="text: paymentMethodName"></span>
                                    </span>
                                    <span class="text-muted small" data-bind="if: !paymentMethodName">-</span>
                                </td>
                                <td>
                                    <span class="badge" data-bind="text: statusName || 'Tahakkuk',
                                        css: statusId === 3 ? 'bg-success' :
                                             statusId === 2 ? 'bg-info' :
                                             statusId === 4 ? 'bg-danger' : 'bg-warning text-dark'"></span>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1" title="Tahakkuk Kalemleri"
                                        data-bind="click: function() { $parent.showTahakkukDetail(periodId); }">
                                        <i class="bi bi-list-ul"></i>
                                    </button>
                                    <!-- Sadece hic islem gormemis tahakkuk silinebilir -->
                                    <button class="btn btn-outline-danger btn-sm py-0 px-1" title="Tahakkuku Sil"
                                        data-bind="visible: $parent.canDeletePeriod($data), click: function() { $parent.deletePeriod($data); }">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    <!-- Tahakkuk veya Gecikme -> Odeme Al -->
                                    <button class="btn btn-outline-success btn-sm py-0 px-1" title="Odeme Al"
                                        data-bind="visible: statusId === 1 || statusId === 4, click: function() { $parent.showPaymentModal('single', periodId); }">
                                        <i class="bi bi-credit-card"></i>
                                    </button>
                                    <!-- Odenmis ama faturalanmamis -> Fatura Kes -->
                                    <button class="btn btn-outline-warning btn-sm py-0 px-1" title="Fatura Kes"
                                        data-bind="visible: statusId === 3 && !$parent.isInvoiced(periodId), click: function() { $parent.markInvoiced(periodId); }">
                                        <i class="bi bi-receipt"></i>
                                    </button>
                                    <!-- Faturalanmis ama odenmemis -> Odeme Al -->
                                    <button class="btn btn-outline-primary btn-sm py-0 px-1" title="Odeme Al"
                                        data-bind="visible: statusId === 2, click: function() { $parent.showPaymentModal('single', periodId); }">
                                        <i class="bi bi-credit-card"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted">
                        Toplam: <span data-bind="text: items().length"></span> kayit |
                        Toplam tutar: <span data-bind="text: summary().totalAmount + ' TL'"></span>
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Tahakkuk detay modali -->
    <div class="modal fade" id="salonTahakkukDetailModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title mb-0">Tahakkuk kalemleri</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center py-4" data-bind="visible: tahakkukDetailLoading">
                        <div class="spinner-border spinner-border-sm text-primary"></div>
                    </div>
                    <div class="alert alert-danger py-2 small mb-0" data-bind="visible: tahakkukDetailError, text: tahakkukDetailError"></div>
                    <div data-bind="with: tahakkukDetail">
                        <div class="small text-muted mb-2">
                            <strong data-bind="text: customerName"></strong>
                            <span class="mx-1">-</span>
                            <span data-bind="text: 'Donem: ' + (month || '-') + '/' + (year || '-')"></span>
                        </div>

                        <div class="row g-2 small mb-3">
                            <div class="col-md-4">
                                <div class="border rounded p-2 bg-light">
                                    <div class="text-muted">Temel + sube</div>
                                    <div class="fw-semibold" data-bind="text: Number(operatorAmount || 0).toFixed(2) + ' TL'"></div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="border rounded p-2 bg-light">
                                    <div class="text-muted">Hizmet paketleri</div>
                                    <div class="fw-semibold" data-bind="text: Number(serviceAmount || 0).toFixed(2) + ' TL'"></div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="border rounded p-2 bg-light">
                                    <div class="text-muted">Toplam</div>
                                    <div class="fw-semibold" data-bind="text: Number((operatorAmount || 0) + (serviceAmount || 0)).toFixed(2) + ' TL'"></div>
                                </div>
                            </div>
                        </div>

                        <h6 class="small text-uppercase text-muted mb-2">Temel paket ve subeler</h6>
                        <div class="table-responsive mb-3">
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Kalem</th>
                                        <th class="text-end" style="width:120px;">Adet</th>
                                        <th class="text-end" style="width:120px;">Tutar</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Temel paket ve aktif sube kullanimi</td>
                                        <td class="text-end font-monospace" data-bind="text: userCount || 0"></td>
                                        <td class="text-end font-monospace" data-bind="text: Number(operatorAmount || 0).toFixed(2)"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <h6 class="small text-uppercase text-muted mb-2">Hizmet paketleri</h6>
                        <div class="table-responsive" data-bind="visible: salonModuleLines && salonModuleLines.length > 0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Paket</th>
                                        <th class="text-end" style="width:120px;">Aylik birim</th>
                                        <th class="text-end" style="width:120px;">Tutar</th>
                                    </tr>
                                </thead>
                                <tbody data-bind="foreach: salonModuleLines">
                                    <tr>
                                        <td data-bind="text: moduleDisplayName"></td>
                                        <td class="text-end font-monospace" data-bind="text: Number(monthlyUnitPrice || 0).toFixed(2)"></td>
                                        <td class="text-end font-monospace" data-bind="text: Number(lineAmount || 0).toFixed(2)"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <p class="text-muted small mb-0" data-bind="visible: !salonModuleLines || salonModuleLines.length === 0">Ek hizmet paketi yok.</p>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Odeme Yontemi Modali -->
<div class="modal fade" id="salonPaymentModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title">Odeme Al</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label small">Odeme Yontemi</label>
                <select class="form-select form-select-sm" id="salonPaymentMethodSelect">
                    <option value="3">Kredi Karti</option>
                    <option value="1">Havale / EFT</option>
                    <option value="2">Mail Order</option>
                </select>
                <label class="form-label small mt-2">Not (opsiyonel)</label>
                <input type="text" class="form-control form-control-sm" id="salonPaymentNotes" placeholder="Dekont no, aciklama vb." />
            </div>
            <div class="modal-footer py-1">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                <button type="button" class="btn btn-success btn-sm" id="salonConfirmPaymentBtn">Onayla</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/SalonBilling.js" asp-append-version="true"></script>
}
