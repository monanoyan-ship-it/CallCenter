@{
    ViewData["Title"] = "Fiyat Dönemleri";
}

<div id="periods-vm">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <small class="text-muted">Her dönem için modül ve paket fiyatlarını ayrı ayrı tanımlayabilirsiniz. Yeni dönem açıldığında önceki dönemin fiyatları kopyalanır. Mevcut abonelikler kayıt oldukları dönem fiyatını kullanmaya devam eder (grandfather).</small>
        <button class="btn btn-primary btn-sm" data-bind="click: openNewPeriod">
            <i class="bi bi-plus-lg me-1"></i>Yeni Dönem
        </button>
    </div>

    <div class="row g-3">
        <!-- Dönem Listesi -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold small">
                    <i class="bi bi-calendar-range me-1"></i>Dönemler
                </div>
                <div class="list-group list-group-flush" data-bind="foreach: periods">
                    <a href="javascript:void(0)" class="list-group-item list-group-item-action py-2"
                       data-bind="click: $root.selectPeriod, css: { active: $root.selectedPeriodId() === id }">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold small" data-bind="text: name"></div>
                                <div class="text-muted" style="font-size:.75rem;"
                                     data-bind="text: new Date(startDate).toLocaleDateString('tr-TR') + ' - ' + new Date(endDate).toLocaleDateString('tr-TR')"></div>
                            </div>
                            <span class="badge" style="font-size:.65rem;"
                                  data-bind="text: statusName,
                                             css: statusId === 1 ? 'bg-success' : statusId === 2 ? 'bg-secondary' : 'bg-warning text-dark'"></span>
                        </div>
                    </a>
                </div>
                <!-- ko if: periods().length === 0 -->
                <div class="p-3 text-center text-muted small">
                    <i class="bi bi-calendar-x" style="font-size:1.5rem;"></i>
                    <p class="mt-2 mb-0">Henüz dönem yok. Yeni dönem açarak başlayın.</p>
                </div>
                <!-- /ko -->
            </div>
        </div>

        <!-- Dönem Detayı -->
        <div class="col-md-9">
            <!-- ko if: !selectedPeriod() -->
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5 text-muted">
                    <i class="bi bi-arrow-left" style="font-size:2rem;"></i>
                    <p class="mt-2 mb-0">Sol taraftan bir dönem seçin veya yeni dönem açın.</p>
                </div>
            </div>
            <!-- /ko -->

            <!-- ko if: selectedPeriod() -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <div>
                        <strong data-bind="text: selectedPeriod().name"></strong>
                        <small class="text-muted ms-2"
                               data-bind="text: new Date(selectedPeriod().startDate).toLocaleDateString('tr-TR') + ' - ' + new Date(selectedPeriod().endDate).toLocaleDateString('tr-TR')"></small>
                    </div>
                    <div class="d-flex gap-1">
                        <!-- ko if: selectedPeriod().statusId !== 1 -->
                        <button class="btn btn-success btn-sm" data-bind="click: activateSelected">
                            <i class="bi bi-check-circle me-1"></i>Aktif Et
                        </button>
                        <!-- /ko -->
                        <!-- ko if: selectedPeriod().statusId !== 1 -->
                        <button class="btn btn-outline-danger btn-sm" data-bind="click: deleteSelected">
                            <i class="bi bi-trash"></i>
                        </button>
                        <!-- /ko -->
                    </div>
                </div>
            </div>

            <!-- Paketler -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold">
                    <i class="bi bi-box-seam me-1 text-purple"></i>Salon Paketleri
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Paket</th>
                                <th style="width:180px;">Aylık Fiyat (₺)</th>
                                <th style="width:140px;">Önceki Dönem</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: selectedPeriod().salonPackages">
                            <tr>
                                <td class="fw-semibold" data-bind="text: name"></td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input type="number" class="form-control" min="0" step="0.01"
                                               data-bind="value: monthlyPrice, event: { change: function() { $root.saveItemPrice(id, monthlyPrice); } }" />
                                        <span class="input-group-text">₺</span>
                                    </div>
                                </td>
                                <td class="text-muted small" data-bind="text: previousPrice != null ? previousPrice.toLocaleString('tr-TR') + ' ₺' : '-'"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Şube indirim eşikleri (dönem bazlı) -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span><i class="bi bi-buildings me-1 text-purple"></i>Şube indirim eşikleri</span>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: saveBranchTiers, disable: isSavingTiers">
                        <span data-bind="visible: isSavingTiers" class="spinner-border spinner-border-sm me-1"></span>Kaydet
                    </button>
                </div>
                <div class="card-body py-2">
                    <p class="small text-muted mb-2">
                        <strong>2 ve üzeri aktif şubede</strong> brüt şube tutarı <strong>şube sayısı × Temel Paket (dönem)</strong> ile hesaplanır;
                        bu aralığa göre belirlenen yüzde bu brüt tutara uygulanır. Tek şubede şube satırı yoktur (Temel Paket üst satırda).
                    </p>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="min-width:100px;">Min şube</th>
                                    <th style="min-width:100px;">Max şube</th>
                                    <th style="min-width:100px;">İndirim %</th>
                                    <th style="min-width:72px;">Sıra</th>
                                    <th style="width:48px;"></th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: branchTierRows">
                                <tr>
                                    <td><input type="number" class="form-control form-control-sm" min="1" data-bind="value: minBranches" /></td>
                                    <td><input type="number" class="form-control form-control-sm" min="1" data-bind="value: maxBranches" /></td>
                                    <td><input type="number" class="form-control form-control-sm" min="0" max="100" step="0.01" data-bind="value: discountPercent" /></td>
                                    <td><input type="number" class="form-control form-control-sm" min="0" data-bind="value: sortOrder" /></td>
                                    <td><button type="button" class="btn btn-outline-danger btn-sm py-0" data-bind="click: $parent.removeBranchTierRow" title="Satırı sil">&times;</button></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm mt-2" data-bind="click: addBranchTierRow">
                        <i class="bi bi-plus-lg me-1"></i>Satır ekle
                    </button>
                </div>
            </div>

            <!-- Salon Modülleri (grup bazlı) -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold">
                    <i class="bi bi-puzzle me-1 text-purple"></i>Salon Modülleri (tek tek)
                </div>
                <div class="accordion accordion-flush" data-bind="foreach: selectedPeriod().salonGroups">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bind="attr: { 'data-bs-target': '#grp-' + groupId }">
                                <span data-bind="text: groupName"></span>
                                <span class="text-muted small ms-2" data-bind="text: '(' + items.length + ' modül)'"></span>
                            </button>
                        </h2>
                        <div class="accordion-collapse collapse" data-bind="attr: { id: 'grp-' + groupId }">
                            <div class="accordion-body p-0">
                                <table class="table table-sm mb-0">
                                    <tbody data-bind="foreach: items">
                                        <tr>
                                            <td class="small" data-bind="text: serviceName"></td>
                                            <td style="width:180px;">
                                                <div class="input-group input-group-sm">
                                                    <input type="number" class="form-control" min="0" step="0.01"
                                                           data-bind="value: monthlyPrice, event: { change: function() { $root.saveItemPrice(id, monthlyPrice); } }" />
                                                    <span class="input-group-text">₺</span>
                                                </div>
                                            </td>
                                            <td class="text-muted small" style="width:140px;" data-bind="text: previousPrice != null ? previousPrice.toLocaleString('tr-TR') + ' ₺' : '-'"></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CallCenter modülleri -->
            <!-- ko if: selectedPeriod().callCenter && selectedPeriod().callCenter.length > 0 -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold">
                    <i class="bi bi-headset me-1 text-purple"></i>CallCenter Hizmetleri
                </div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Hizmet</th>
                                <th style="width:180px;">Aylık Fiyat (₺)</th>
                                <th style="width:140px;">Önceki Dönem</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: selectedPeriod().callCenter">
                            <tr>
                                <td class="small" data-bind="text: serviceName"></td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input type="number" class="form-control" min="0" step="0.01"
                                               data-bind="value: monthlyPrice, event: { change: function() { $root.saveItemPrice(id, monthlyPrice); } }" />
                                        <span class="input-group-text">₺</span>
                                    </div>
                                </td>
                                <td class="text-muted small" data-bind="text: previousPrice != null ? previousPrice.toLocaleString('tr-TR') + ' ₺' : '-'"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- /ko -->
            <!-- /ko -->
        </div>
    </div>

    <!-- Yeni Dönem Modal -->
    <div class="modal fade" id="newPeriodModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">Yeni Fiyat Dönemi</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small">Dönem Adı *</label>
                        <input type="text" class="form-control form-control-sm" data-bind="value: newPeriod.name" placeholder="2026 Yaz Dönemi" />
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small">Başlangıç *</label>
                            <input type="date" class="form-control form-control-sm" data-bind="value: newPeriod.startDate" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Bitiş *</label>
                            <input type="date" class="form-control form-control-sm" data-bind="value: newPeriod.endDate" />
                        </div>
                    </div>
                    <div class="alert alert-info small mt-3 mb-0">
                        <i class="bi bi-info-circle me-1"></i>Yeni dönem açıldığında önceki dönemin fiyatları otomatik kopyalanır. Kopyalanan fiyatları düzenleyip "Aktif Et" diyene kadar taslak olarak kalır.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: createPeriod, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Oluştur
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>.text-purple { color:#7b1fa2; }</style>

@section Scripts {
<script src="~/js/PricingPeriods.js" asp-append-version="true"></script>
}
