@{
    ViewData["Title"] = "Salon Rol Yönetimi";
}

<div id="roles-vm">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <small class="text-muted">Tüm salonlar için geçerli merkezi rol-izin matrisi. Bir rolün hangi sayfalara erişebileceğini düzenleyin.</small>
        <div>
            <button class="btn btn-outline-secondary btn-sm me-1" data-bind="click: seedFromStatic, visible: !hasData()">
                <i class="bi bi-database-add me-1"></i>Mevcut Yapıyı Yükle
            </button>
            <button class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                <i class="bi bi-check-lg me-1"></i>Kaydet
            </button>
        </div>
    </div>

    <div class="text-center py-3" data-bind="visible: isLoading"><div class="spinner-border spinner-border-sm text-primary"></div></div>

    <div data-bind="visible: !isLoading()">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered mb-0" style="font-size:.8rem;">
                        <thead class="table-light">
                            <tr>
                                <th class="sticky-top bg-light" style="min-width:140px;">Sayfa</th>
                                <!-- ko foreach: roles -->
                                <th class="text-center sticky-top bg-light" style="min-width:90px;">
                                    <i class="bi d-block" data-bind="attr: { 'class': 'bi ' + icon }"></i>
                                    <span data-bind="text: name" class="small"></span>
                                </th>
                                <!-- /ko -->
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: pages">
                            <tr>
                                <td class="fw-medium" data-bind="text: name"></td>
                                <!-- ko foreach: $parent.roles -->
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input"
                                        data-bind="checked: $parents[1].isAllowed($data.id, $parent.name),
                                                   click: function() { $parents[1].toggle($data.id, $parent.name); return true; }" />
                                </td>
                                <!-- /ko -->
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/Roles.js" asp-append-version="true"></script>
}
