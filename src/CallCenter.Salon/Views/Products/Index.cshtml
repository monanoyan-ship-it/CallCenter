@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.products.auto.title", "Ürünler");
    var productsHasStockFinancePro = true;
}

@section Styles {
    <style>
        .products-search { max-width: 280px; }
        .products-category-filter { width: 160px; }
        .products-actions-wide { width: 170px; }
        .products-actions-narrow { width: 120px; }
        .products-empty-icon { font-size: 2rem; }
        .autocomplete-clear { cursor: pointer; z-index: 2; }
        .autocomplete-menu-scroll { max-height: 220px; overflow-y: auto; }
    </style>
}

<div id="products-vm" data-stock-finance-pro="@(productsHasStockFinancePro ? "true" : "false")">
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button type="button" class="nav-link" data-bind="css: { active: activeProductsTab() === 'products' }, click: showProductsTab">
                <i class="bi bi-box-seam me-1"></i><t key="salon.products.tab.products">Urunler</t>
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link" data-bind="css: { active: activeProductsTab() === 'brands' }, click: showBrandsTab">
                <i class="bi bi-tags me-1"></i><t key="salon.products.tab.brands">Markalar</t>
            </button>
        </li>
    </ul>

    <div data-bind="visible: activeProductsTab() === 'products'">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <div class="input-group products-search">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="@(Translation.T("salon.products.auto.urun_ara", "Ürün ara..."))" data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
            </div>
            <select class="form-select form-select-sm products-category-filter" data-bind="options: categories, optionsText: 'name', optionsValue: 'name', value: selectedCategoryName, optionsCaption: 'Tum Kategoriler'"></select>
        </div>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i><t key="salon.products.auto.yeni_urun">Yeni Ürün</t>
        </button>
    </div>

    <div class="alert alert-info py-2 small d-flex flex-wrap justify-content-between align-items-center gap-2" data-bind="visible: !hasStockFinancePro()">
        <span>
            <i class="bi bi-info-circle me-1"></i>
            <t key="salon.products.stock_finance_pro_notice">Temel pakette ürün ve basit stok takibi açık. Tedarikçi cari, alış kaydı, transfer, sayım ve tedarik siparişleri için Stok Tedarik / Finans paketi gerekir.</t>
        </span>
        <a href="/Modules" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-box-seam me-1"></i><t key="salon.products.view_stock_finance_package">Paketi İncele</t>
        </a>
    </div>

    <div class="alert alert-secondary py-2 small" data-bind="visible: isAllBranchesStockContext">
        <i class="bi bi-diagram-3 me-1"></i>
        <t key="salon.products.branch_stock_notice">Tüm şubeler seçiliyken stok toplamı gösterilir. Stok değiştiren işlemlerde işlem şubesini seçin.</t>
    </div>

    <div class="alert alert-warning py-2" data-bind="visible: lowStockProducts().length > 0">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="fw-semibold small">
                <i class="bi bi-exclamation-triangle-fill me-1"></i><t key="salon.products.critical_stock_title">Kritik stok uyarilari</t>
            </div>
            <span class="badge bg-danger" data-bind="text: lowStockProducts().length"></span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <tbody data-bind="foreach: lowStockProducts">
                    <tr>
                        <td class="small fw-semibold" data-bind="text: productName"></td>
                        <td class="small text-muted">
                            <span data-bind="text: stockQuantity"></span> /
                            <span data-bind="text: minStockLevel"></span>
                            <span data-bind="text: unit"></span>
                        </td>
                        <td class="small">
                            <t key="salon.products.suggested_order">Onerilen siparis</t>:
                            <strong data-bind="text: suggestedOrderQuantity"></strong>
                            <span data-bind="text: unit"></span>
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-outline-dark btn-sm" data-bind="click: $parent.openSupplierOrder, visible: $parent.hasStockFinancePro">
                                <i class="bi bi-truck me-1"></i><t key="salon.products.create_supplier_order">Tedarik siparisi</t>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th><t key="salon.products.auto.urun_adi">Ürün Adı</t></th>
                            <th><t key="salon.reports.category">Kategori</t></th>
                            <th><t key="salon.products.auto.marka">Marka</t></th>
                            <th><t key="salon.products.auto.barkod">Barkod</t></th>
                            <th><t key="salon.products.auto.stok">Stok</t></th>
                            <th><t key="salon.products.auto.alis_fiyati">Alış Fiyatı</t></th>
                            <th><t key="salon.products.auto.satis_fiyati">Satış Fiyatı</t></th>
                            <th class="products-actions-wide"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredProducts">
                        <tr data-bind="css: { 'table-danger': stockQuantity <= minStockLevel && minStockLevel > 0 }">
                            <td class="small fw-semibold" data-bind="text: name"></td>
                            <td class="small" data-bind="text: categoryName"></td>
                            <td class="small" data-bind="text: brandName || '-'"></td>
                            <td class="small text-muted" data-bind="text: barcode || '-'"></td>
                            <td class="small">
                                <span data-bind="text: stockQuantity, css: { 'text-danger fw-bold': stockQuantity <= minStockLevel && minStockLevel > 0 }"></span>
                                <!-- ko if: stockQuantity <= minStockLevel && minStockLevel > 0 -->
                                <i class="bi bi-exclamation-triangle-fill text-danger ms-1" title="@(Translation.T("salon.products.auto.title_dusuk_stok", "Düşük stok"))"></i>
                                <!-- /ko -->
                            </td>
                            <td class="small" data-bind="text: (purchasePrice || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></td>
                            <td class="small" data-bind="text: (salePrice || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" title="@(Translation.T("salon.products.auto.duzenle", "Düzenle"))" data-bind="click: $parent.openEdit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <!-- ko if: $parent.hasStockFinancePro -->
                                    <button class="btn btn-outline-success" title="@(Translation.T("salon.products.auto.alis_ekle", "Alış Ekle"))" data-bind="click: $parent.openPurchase">
                                        <i class="bi bi-cart-plus"></i>
                                    </button>
                                    <button class="btn btn-outline-dark" title="@(Translation.T("salon.products.create_supplier_order", "Tedarik siparisi"))" data-bind="click: $parent.openSupplierOrder">
                                        <i class="bi bi-truck"></i>
                                    </button>
                                    <button class="btn btn-outline-primary" title="@(Translation.T("salon.products.auto.title_transfer", "Transfer"))" data-bind="click: $parent.openStockTransfer">
                                        <i class="bi bi-arrow-left-right"></i>
                                    </button>
                                    <button class="btn btn-outline-warning" title="@(Translation.T("salon.products.auto.title_sayim", "Sayım"))" data-bind="click: $parent.openStockCount">
                                        <i class="bi bi-clipboard-check"></i>
                                    </button>
                                    <!-- /ko -->
                                    <button class="btn btn-outline-danger" title="@(Translation.T("salon.common.btn.delete_tooltip", "Sil"))" data-bind="click: $parent.remove">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: filteredProducts().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-box-seam products-empty-icon"></i>
                <p class="mt-2 small"><t key="salon.products.auto.henuz_urun_eklenmemis">Henüz ürün eklenmemiş</t></p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    </div>

    <div data-bind="visible: activeProductsTab() === 'brands'">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="input-group products-search">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="@(Translation.T("salon.products.brand_search", "Marka ara..."))" data-bind="value: brandSearchQuery, valueUpdate: 'afterkeydown'" />
            </div>
            <button class="btn btn-primary btn-sm" data-bind="click: openNewBrand">
                <i class="bi bi-plus-lg me-1"></i><t key="salon.products.new_brand">Yeni Marka</t>
            </button>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th><t key="salon.products.auto.marka">Marka</t></th>
                                <th><t key="salon.products.linked_product_count">Urun Sayisi</t></th>
                                <th class="products-actions-narrow"></th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: filteredBrands">
                            <tr>
                                <td class="small fw-semibold" data-bind="text: name"></td>
                                <td class="small" data-bind="text: $parent.brandProductCount($data)"></td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary" title="@(Translation.T("salon.products.auto.duzenle", "Duzenle"))" data-bind="click: $parent.openEditBrand">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" title="@(Translation.T("salon.common.btn.delete_tooltip", "Sil"))" data-bind="click: $parent.removeBrand">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <!-- ko if: filteredBrands().length === 0 -->
                <div class="text-center text-muted py-4">
                    <i class="bi bi-tags products-empty-icon"></i>
                    <p class="mt-2 small"><t key="salon.products.no_brands">Henuz marka eklenmemis</t></p>
                </div>
                <!-- /ko -->
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="productModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditing() ? salonT('salon.products.auto.urun_duzenle', 'Ürün Düzenle') : salonT('salon.products.auto.yeni_urun', 'Yeni Ürün')"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.products.auto.urun_adi_2">Ürün Adı *</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="textInput: form.name" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.reports.category">Kategori</t></label>
                            <div class="position-relative">
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="@(Translation.T("salon.products.auto.kategori_yazin", "Kategori yazin..."))"
                                       autocomplete="off"
                                       data-bind="textInput: categoryAutocomplete.query,
                                                  event: { focus: categoryAutocomplete.onFocus, blur: categoryAutocomplete.onBlur, keydown: categoryAutocomplete.onKeydown }" />
                                <!-- ko if: categoryAutocomplete.selectedName() -->
                                <span class="position-absolute top-50 end-0 translate-middle-y me-2 autocomplete-clear"
                                      data-bind="click: categoryAutocomplete.clear" title="@(Translation.T("salon.memberships.clear", "Temizle"))">
                                    <i class="bi bi-x-circle text-muted"></i>
                                </span>
                                <!-- /ko -->
                                <div class="dropdown-menu w-100 shadow-sm autocomplete-menu-scroll"
                                     data-bind="css: { show: categoryAutocomplete.showDropdown }">
                                    <!-- ko foreach: categoryAutocomplete.filteredItems -->
                                    <a class="dropdown-item small py-1 px-2" href="#"
                                       data-bind="text: $parent.categoryAutocomplete.getDisplayText($data), click: $parent.categoryAutocomplete.select,
                                                  css: { active: $parent.categoryAutocomplete.highlightIndex() === $index() },
                                                  event: { mousedown: function(){ $parent.categoryAutocomplete.select($data); } }"></a>
                                    <!-- /ko -->
                                    <!-- ko if: categoryAutocomplete.filteredItems().length === 0 && categoryAutocomplete.query().length > 0 -->
                                    <span class="dropdown-item-text small text-muted"><t key="salon.common.search.no_results">Sonuç bulunamadı</t></span>
                                    <!-- /ko -->
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.products.auto.marka_2">Marka</t></label>
                            <div class="position-relative">
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="@(Translation.T("salon.products.auto.placeholder_marka_yazin", "Marka yazın..."))"
                                       autocomplete="off"
                                       data-bind="textInput: brandAutocomplete.query,
                                                  event: { focus: brandAutocomplete.onFocus, blur: brandAutocomplete.onBlur, keydown: brandAutocomplete.onKeydown }" />
                                <!-- ko if: brandAutocomplete.selectedName() -->
                                <span class="position-absolute top-50 end-0 translate-middle-y me-2 autocomplete-clear"
                                      data-bind="click: brandAutocomplete.clear" title="@(Translation.T("salon.memberships.clear", "Temizle"))">
                                    <i class="bi bi-x-circle text-muted"></i>
                                </span>
                                <!-- /ko -->
                                <div class="dropdown-menu w-100 shadow-sm autocomplete-menu-scroll"
                                     data-bind="css: { show: brandAutocomplete.showDropdown }">
                                    <!-- ko foreach: brandAutocomplete.filteredItems -->
                                    <a class="dropdown-item small py-1 px-2" href="#"
                                       data-bind="text: $parent.brandAutocomplete.getDisplayText($data), click: $parent.brandAutocomplete.select,
                                                  css: { active: $parent.brandAutocomplete.highlightIndex() === $index() },
                                                  event: { mousedown: function(){ $parent.brandAutocomplete.select($data); } }"></a>
                                    <!-- /ko -->
                                    <!-- ko if: brandAutocomplete.filteredItems().length === 0 && brandAutocomplete.query().length > 0 -->
                                    <span class="dropdown-item-text small text-muted"><t key="salon.common.search.no_results">Sonuç bulunamadı</t></span>
                                    <!-- /ko -->
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.products.auto.barkod_2">Barkod</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="textInput: form.barcode" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.products.auto.birim">Birim</t></label>
                            <input type="text" class="form-control form-control-sm" placeholder="@(Translation.T("salon.products.auto.adet_litre_kutu", "Adet, Litre, Kutu..."))" data-bind="textInput: form.unit" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.products.auto.stok_2">Stok</t></label>
                            <input type="number" class="form-control form-control-sm" data-bind="textInput: form.stockQuantity" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.common.branch_target">Şube hedefi *</t></label>
                            <select class="form-select form-select-sm"
                                    data-bind="options: branchTargetOptions,
                                               optionsText: 'name',
                                               optionsValue: 'id',
                                               value: form.branchTarget,
                                               optionsCaption: salonT('salon.common.select_branch_or_all', 'Şube seçin veya Tüm Şubeler')"></select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.products.auto.min_stok">Min Stok</t></label>
                            <input type="number" class="form-control form-control-sm" data-bind="textInput: form.minStockLevel" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.products.auto.alis_fiyati_tl_required">Alış Fiyatı (TL) *</t></label>
                            <input type="number" class="form-control form-control-sm" step="0.01" data-bind="textInput: form.purchasePrice" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.products.auto.satis_fiyati_tl">Satış Fiyatı (TL) *</t></label>
                            <input type="number" class="form-control form-control-sm" step="0.01" data-bind="textInput: form.salePrice" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i><t key="salon.common.btn.save">Kaydet</t>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="brandModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: brandForm.id() ? salonT('salon.products.edit_brand', 'Marka Duzenle') : salonT('salon.products.new_brand', 'Yeni Marka')"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label small"><t key="salon.products.brand_name">Marka Adi *</t></label>
                    <input type="text" class="form-control form-control-sm" data-bind="textInput: brandForm.name" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">Iptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: saveBrand, disable: isBrandSaving">
                        <span data-bind="visible: isBrandSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isBrandSaving()"></i><t key="salon.common.btn.save">Kaydet</t>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Alis Modal -->
    <div class="modal fade" id="purchaseModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><t key="salon.products.auto.alis_kaydi">Alış Kaydı</t></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- ko if: purchaseProduct -->
                    <div class="mb-3">
                        <div class="small text-muted"><t key="salon.sidebar.products">Ürün</t></div>
                        <div class="fw-semibold" data-bind="text: purchaseProduct().name"></div>
                    </div>
                    <!-- /ko -->
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.products.auto.tedarikci">Tedarikci *</t></label>
                            <select class="form-select form-select-sm"
                                    data-bind="options: suppliers,
                                               optionsText: 'name',
                                               optionsValue: 'id',
                                               value: purchaseForm.supplierId,
                                               optionsCaption: salonT('salon.products.auto.tedarikci_secin', 'Tedarikçi seçin')"></select>
                        </div>
                        <div class="col-12" data-bind="visible: hasMultipleBranches">
                            <label class="form-label small"><t key="salon.products.stock_branch">Stok Şubesi</t></label>
                            <select class="form-select form-select-sm"
                                    data-bind="options: branches,
                                               optionsText: 'name',
                                               optionsValue: 'id',
                                               value: purchaseForm.branchId,
                                               optionsCaption: salonT('salon.products.select_branch', 'Şube seçin')"></select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">
                                <t key="salon.products.auto.miktar">Miktar</t>
                                <!-- ko if: purchaseProduct -->
                                <span class="text-muted" data-bind="text: '(' + purchaseProduct().unit + ')'"></span>
                                <!-- /ko -->
                            </label>
                            <input type="number" class="form-control form-control-sm" min="0" step="0.01" data-bind="value: purchaseForm.quantity, valueUpdate: 'afterkeydown'" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.products.auto.birim_alis_fiyati_tl">Birim Alış Fiyatı (TL)</t></label>
                            <input type="number" class="form-control form-control-sm" min="0" step="0.01" data-bind="value: purchaseForm.unitPrice, valueUpdate: 'afterkeydown'" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.appointments.notes">Not</t></label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: purchaseForm.notes"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center border-top pt-3">
                                <span class="small text-muted"><t key="salon.products.auto.toplam">Toplam</t></span>
                                <span class="fw-bold" data-bind="text: purchaseTotal().toLocaleString(document.documentElement.lang || undefined) + ' TL'"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-success btn-sm" data-bind="click: savePurchase, disable: isPurchaseSaving">
                        <span data-bind="visible: isPurchaseSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isPurchaseSaving()"></i><t key="salon.common.btn.save">Kaydet</t>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Stok Operasyon Modal -->
    <div class="modal fade" id="stockOperationModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: stockOperationMode() === 'transfer' ? 'Stok Transferi' : 'Stok Sayimi'"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- ko if: stockOperationProduct -->
                    <div class="mb-3">
                        <div class="small text-muted"><t key="salon.sidebar.products">Ürün</t></div>
                        <div class="fw-semibold" data-bind="text: stockOperationProduct().name"></div>
                        <div class="small text-muted"><t key="salon.products.auto.mevcut_global_stok">Görünen stok:</t> <span data-bind="text: stockOperationProduct().stockQuantity"></span></div>
                    </div>
                    <!-- /ko -->

                    <div data-bind="visible: stockOperationMode() === 'transfer'">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small"><t key="salon.products.auto.kaynak_sube">Kaynak şube</t></label>
                                <select class="form-select form-select-sm"
                                        data-bind="options: branches,
                                                   optionsText: 'name',
                                                   optionsValue: 'id',
                                                   value: stockOperationForm.fromBranchId,
                                                   optionsCaption: salonT('salon.products.select_branch', 'Şube seçin')"></select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small"><t key="salon.products.auto.hedef_sube">Hedef şube *</t></label>
                                <select class="form-select form-select-sm"
                                        data-bind="options: branches,
                                                   optionsText: 'name',
                                                   optionsValue: 'id',
                                                   value: stockOperationForm.toBranchId,
                                                   optionsCaption: salonT('salon.products.auto.sube_secin', 'Şube seçin')"></select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small"><t key="salon.products.auto.miktar">Miktar</t></label>
                                <input type="number" class="form-control form-control-sm" min="0" step="0.01" data-bind="value: stockOperationForm.quantity" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small"><t key="salon.appointments.notes">Not</t></label>
                                <input type="text" class="form-control form-control-sm" data-bind="value: stockOperationForm.notes" />
                            </div>
                        </div>
                    </div>

                    <div data-bind="visible: stockOperationMode() === 'count'">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small"><t key="salon.products.stock_count_branch">Sayım şubesi</t></label>
                                <select class="form-select form-select-sm"
                                        data-bind="options: branches,
                                                   optionsText: 'name',
                                                   optionsValue: 'id',
                                                   value: stockOperationForm.branchId,
                                                   optionsCaption: salonT('salon.products.select_branch', 'Şube seçin')"></select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small"><t key="salon.products.counted_stock">Sayılan stok</t></label>
                                <input type="number" class="form-control form-control-sm" min="0" step="0.01" data-bind="value: stockOperationForm.countedQuantity" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small"><t key="salon.appointments.notes">Not</t></label>
                                <textarea class="form-control form-control-sm" rows="2" data-bind="value: stockOperationForm.notes"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info py-2 small mt-3 mb-0">
                        <t key="salon.products.stock_operation_hint">Transfer global stok toplamını değiştirmez; sayım farkı global stok değerini sayılan miktara göre günceller ve audit hareketi yazar.</t>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: saveStockOperation, disable: isStockOperationSaving">
                        <span data-bind="visible: isStockOperationSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isStockOperationSaving()"></i><t key="salon.common.btn.save">Kaydet</t>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="supplierOrderModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><t key="salon.products.supplier_order_modal_title">Tedarik Siparisi</t></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- ko if: supplierOrderProduct -->
                    <div class="mb-3">
                        <div class="small text-muted"><t key="salon.sidebar.products">Urun</t></div>
                        <div class="fw-semibold" data-bind="text: supplierOrderProduct().productName"></div>
                        <div class="small text-muted">
                            <t key="salon.products.current_min_stock">Mevcut / min stok</t>:
                            <span data-bind="text: supplierOrderProduct().stockQuantity"></span> /
                            <span data-bind="text: supplierOrderProduct().minStockLevel"></span>
                            <span data-bind="text: supplierOrderProduct().unit"></span>
                        </div>
                    </div>
                    <!-- /ko -->
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.products.auto.tedarikci">Tedarikci *</t></label>
                            <select class="form-select form-select-sm"
                                    data-bind="options: suppliers,
                                               optionsText: 'name',
                                               optionsValue: 'id',
                                               value: supplierOrderForm.supplierId,
                                               optionsCaption: salonT('salon.products.auto.tedarikci_secin', 'Tedarikci secin')"></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small"><t key="salon.products.auto.miktar">Miktar</t></label>
                            <input type="number" class="form-control form-control-sm" min="0" step="0.01" data-bind="value: supplierOrderForm.quantity, valueUpdate: 'afterkeydown'" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small"><t key="salon.products.auto.birim_alis_fiyati_tl">Birim Alis Fiyati (TL)</t></label>
                            <input type="number" class="form-control form-control-sm" min="0" step="0.01" data-bind="value: supplierOrderForm.unitPrice, valueUpdate: 'afterkeydown'" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small"><t key="salon.products.expected_date">Beklenen tarih</t></label>
                            <input type="date" class="form-control form-control-sm" data-bind="value: supplierOrderForm.expectedDate" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small"><t key="salon.products.auto.toplam">Toplam</t></label>
                            <div class="form-control form-control-sm bg-light" data-bind="text: supplierOrderTotal().toLocaleString(document.documentElement.lang || undefined) + ' TL'"></div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.appointments.notes">Not</t></label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: supplierOrderForm.notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">Iptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: saveSupplierOrder, disable: isSupplierOrderSaving">
                        <span data-bind="visible: isSupplierOrderSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSupplierOrderSaving()"></i><t key="salon.common.btn.save">Kaydet</t>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Products.js" asp-append-version="true"></script>
}
