@{
    ViewData["Title"] = "Urunler";
}

<div id="products-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <div class="input-group" style="max-width: 280px;">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="Urun ara..." data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
            </div>
            <select class="form-select form-select-sm" style="width:160px;" data-bind="options: categories, optionsText: 'name', optionsValue: 'name', value: selectedCategoryName, optionsCaption: 'Tum Kategoriler'"></select>
        </div>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i>Yeni Urun
        </button>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Urun Adi</th>
                            <th>Kategori</th>
                            <th>Marka</th>
                            <th>Barkod</th>
                            <th>Stok</th>
                            <th>Alis Fiyati</th>
                            <th>Satis Fiyati</th>
                            <th style="width: 170px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredProducts">
                        <tr data-bind="css: { 'table-danger': stockQuantity <= minStockLevel && minStockLevel > 0 }">
                            <td class="small fw-semibold" data-bind="text: name"></td>
                            <td class="small" data-bind="text: categoryName"></td>
                            <td class="small" data-bind="text: brandName || '-'"></td>
                            <td class="small text-muted" data-bind="text: barcode || '-'"></td>
                            <td class="small">
                                <span data-bind="text: stockQuantity, css: { 'text-danger fw-bold': stockQuantity <= minStockLevel && minStockLevel > 0 }"></span>
                                <!-- ko if: stockQuantity <= minStockLevel && minStockLevel > 0 -->
                                <i class="bi bi-exclamation-triangle-fill text-danger ms-1" title="Dusuk stok"></i>
                                <!-- /ko -->
                            </td>
                            <td class="small" data-bind="text: (purchasePrice || 0).toLocaleString('tr-TR') + ' TL'"></td>
                            <td class="small" data-bind="text: (salePrice || 0).toLocaleString('tr-TR') + ' TL'"></td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" title="Duzenle" data-bind="click: $parent.openEdit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-success" title="Alis Ekle" data-bind="click: $parent.openPurchase">
                                        <i class="bi bi-cart-plus"></i>
                                    </button>
                                    <button class="btn btn-outline-primary" title="Transfer" data-bind="click: $parent.openStockTransfer">
                                        <i class="bi bi-arrow-left-right"></i>
                                    </button>
                                    <button class="btn btn-outline-warning" title="Sayim" data-bind="click: $parent.openStockCount">
                                        <i class="bi bi-clipboard-check"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" title="Sil" data-bind="click: $parent.remove">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: filteredProducts().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-box-seam" style="font-size: 2rem;"></i>
                <p class="mt-2 small">Henuz urun eklenmemis</p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="productModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditing() ? 'Urun Duzenle' : 'Yeni Urun'"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small">Urun Adi *</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.name" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Kategori</label>
                            <div class="position-relative" data-bind="with: categoryAutocomplete">
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="Kategori yazin..."
                                       autocomplete="off"
                                       data-bind="value: query, valueUpdate: 'afterkeydown',
                                                  event: { focus: onFocus, blur: onBlur, keydown: onKeydown }" />
                                <!-- ko if: selectedName() -->
                                <span class="position-absolute top-50 end-0 translate-middle-y me-2" style="cursor:pointer; z-index:2;"
                                      data-bind="click: clear" title="Temizle">
                                    <i class="bi bi-x-circle text-muted"></i>
                                </span>
                                <!-- /ko -->
                                <div class="dropdown-menu w-100 shadow-sm" style="max-height:220px; overflow-y:auto;"
                                     data-bind="css: { show: showDropdown }">
                                    <!-- ko foreach: filteredItems -->
                                    <a class="dropdown-item small py-1 px-2" href="#"
                                       data-bind="text: $parent.getDisplayText($data), click: $parent.select,
                                                  css: { active: $parent.highlightIndex() === $index() },
                                                  event: { mousedown: function(){ $parent.select($data); } }"></a>
                                    <!-- /ko -->
                                    <!-- ko if: filteredItems().length === 0 && query().length > 0 -->
                                    <span class="dropdown-item-text small text-muted">Sonuc bulunamadi</span>
                                    <!-- /ko -->
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Marka</label>
                            <div class="position-relative" data-bind="with: brandAutocomplete">
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="Marka yazin..."
                                       autocomplete="off"
                                       data-bind="value: query, valueUpdate: 'afterkeydown',
                                                  event: { focus: onFocus, blur: onBlur, keydown: onKeydown }" />
                                <!-- ko if: selectedName() -->
                                <span class="position-absolute top-50 end-0 translate-middle-y me-2" style="cursor:pointer; z-index:2;"
                                      data-bind="click: clear" title="Temizle">
                                    <i class="bi bi-x-circle text-muted"></i>
                                </span>
                                <!-- /ko -->
                                <div class="dropdown-menu w-100 shadow-sm" style="max-height:220px; overflow-y:auto;"
                                     data-bind="css: { show: showDropdown }">
                                    <!-- ko foreach: filteredItems -->
                                    <a class="dropdown-item small py-1 px-2" href="#"
                                       data-bind="text: $parent.getDisplayText($data), click: $parent.select,
                                                  css: { active: $parent.highlightIndex() === $index() },
                                                  event: { mousedown: function(){ $parent.select($data); } }"></a>
                                    <!-- /ko -->
                                    <!-- ko if: filteredItems().length === 0 && query().length > 0 -->
                                    <span class="dropdown-item-text small text-muted">Sonuc bulunamadi</span>
                                    <!-- /ko -->
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Barkod</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.barcode" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Birim</label>
                            <input type="text" class="form-control form-control-sm" placeholder="Adet, Litre, Kutu..." data-bind="value: form.unit" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Stok</label>
                            <input type="number" class="form-control form-control-sm" data-bind="value: form.stockQuantity" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Min Stok</label>
                            <input type="number" class="form-control form-control-sm" data-bind="value: form.minStockLevel" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Alis Fiyati (TL) *</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" data-bind="value: form.purchasePrice" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Satis Fiyati (TL) *</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" data-bind="value: form.salePrice" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Alis Modal -->
    <div class="modal fade" id="purchaseModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">Alis Kaydi</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- ko if: purchaseProduct -->
                    <div class="mb-3">
                        <div class="small text-muted">Urun</div>
                        <div class="fw-semibold" data-bind="text: purchaseProduct().name"></div>
                    </div>
                    <!-- /ko -->
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small">Tedarikci *</label>
                            <select class="form-select form-select-sm"
                                    data-bind="options: suppliers,
                                               optionsText: 'name',
                                               optionsValue: 'id',
                                               value: purchaseForm.supplierId,
                                               optionsCaption: 'Tedarikci secin'"></select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">
                                Miktar
                                <!-- ko if: purchaseProduct -->
                                <span class="text-muted" data-bind="text: '(' + purchaseProduct().unit + ')'"></span>
                                <!-- /ko -->
                            </label>
                            <input type="number" class="form-control form-control-sm" min="0" step="0.01" data-bind="value: purchaseForm.quantity, valueUpdate: 'afterkeydown'" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Birim Alis Fiyati (TL)</label>
                            <input type="number" class="form-control form-control-sm" min="0" step="0.01" data-bind="value: purchaseForm.unitPrice, valueUpdate: 'afterkeydown'" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Not</label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: purchaseForm.notes"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center border-top pt-3">
                                <span class="small text-muted">Toplam</span>
                                <span class="fw-bold" data-bind="text: purchaseTotal().toLocaleString('tr-TR') + ' TL'"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-success btn-sm" data-bind="click: savePurchase, disable: isPurchaseSaving">
                        <span data-bind="visible: isPurchaseSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isPurchaseSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Stok Operasyon Modal -->
    <div class="modal fade" id="stockOperationModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: stockOperationMode() === 'transfer' ? 'Stok Transferi' : 'Stok Sayimi'"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- ko if: stockOperationProduct -->
                    <div class="mb-3">
                        <div class="small text-muted">Urun</div>
                        <div class="fw-semibold" data-bind="text: stockOperationProduct().name"></div>
                        <div class="small text-muted">Mevcut global stok: <span data-bind="text: stockOperationProduct().stockQuantity"></span></div>
                    </div>
                    <!-- /ko -->

                    <div data-bind="visible: stockOperationMode() === 'transfer'">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small">Kaynak sube</label>
                                <select class="form-select form-select-sm"
                                        data-bind="options: branches,
                                                   optionsText: 'name',
                                                   optionsValue: 'id',
                                                   value: stockOperationForm.fromBranchId,
                                                   optionsCaption: 'Merkez / belirsiz'"></select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Hedef sube *</label>
                                <select class="form-select form-select-sm"
                                        data-bind="options: branches,
                                                   optionsText: 'name',
                                                   optionsValue: 'id',
                                                   value: stockOperationForm.toBranchId,
                                                   optionsCaption: 'Sube secin'"></select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Miktar</label>
                                <input type="number" class="form-control form-control-sm" min="0" step="0.01" data-bind="value: stockOperationForm.quantity" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Not</label>
                                <input type="text" class="form-control form-control-sm" data-bind="value: stockOperationForm.notes" />
                            </div>
                        </div>
                    </div>

                    <div data-bind="visible: stockOperationMode() === 'count'">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small">Sayim subesi</label>
                                <select class="form-select form-select-sm"
                                        data-bind="options: branches,
                                                   optionsText: 'name',
                                                   optionsValue: 'id',
                                                   value: stockOperationForm.branchId,
                                                   optionsCaption: 'Genel stok'"></select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Sayilan stok</label>
                                <input type="number" class="form-control form-control-sm" min="0" step="0.01" data-bind="value: stockOperationForm.countedQuantity" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small">Not</label>
                                <textarea class="form-control form-control-sm" rows="2" data-bind="value: stockOperationForm.notes"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info py-2 small mt-3 mb-0">
                        Transfer global stok toplamını değiştirmez; sayım farkı global stok değerini sayılan miktara göre günceller ve audit hareketi yazar.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: saveStockOperation, disable: isStockOperationSaving">
                        <span data-bind="visible: isStockOperationSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isStockOperationSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Products.js" asp-append-version="true"></script>
}
