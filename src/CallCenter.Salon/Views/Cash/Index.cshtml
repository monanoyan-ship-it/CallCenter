@{
    ViewData["Title"] = "Kasa";
}

<div id="cash-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <h5 class="mb-0">Kasa Yonetimi</h5>
        </div>
        <button class="btn btn-primary btn-sm" data-bind="click: openNewRegister">
            <i class="bi bi-plus-lg me-1"></i>Yeni Kasa
        </button>
    </div>

    <!-- Kasa Kartlari -->
    <div class="row g-3 mb-3">
        <!-- ko foreach: cashRegisters -->
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                    <h6 class="mb-0" data-bind="text: name"></h6>
                    <span class="badge" data-bind="text: isActive ? 'Aktif' : 'Pasif', css: isActive ? 'bg-success' : 'bg-secondary'"></span>
                </div>
                <div class="card-body py-2">
                    <div class="row text-center">
                        <div class="col-6">
                            <div class="text-muted" style="font-size: .7rem;">Bakiye</div>
                            <div class="fw-bold" data-bind="text: (balance || 0).toLocaleString('tr-TR') + ' TL', css: balance >= 0 ? 'text-success' : 'text-danger'"></div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted" style="font-size: .7rem;">Tur</div>
                            <div class="small" data-bind="text: typeName"></div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white border-top-0 py-2">
                    <div class="btn-group btn-group-sm w-100">
                        <button class="btn btn-outline-primary" data-bind="click: $parent.viewTransactions">
                            <i class="bi bi-list-ul me-1"></i>Hareketler
                        </button>
                        <button class="btn btn-outline-success" data-bind="click: $parent.openNewTransaction">
                            <i class="bi bi-plus-lg me-1"></i>Islem
                        </button>
                        <button class="btn btn-outline-info" data-bind="click: $parent.openCashRegister">
                            <i class="bi bi-unlock me-1"></i>Kasa Ac
                        </button>
                        <button class="btn btn-outline-secondary" data-bind="click: $parent.openZReport">
                            <i class="bi bi-file-earmark-bar-graph me-1"></i>Z Raporu
                        </button>
                        <button class="btn btn-outline-warning" data-bind="click: $parent.openClosing">
                            <i class="bi bi-lock me-1"></i>Gun Sonu
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <!-- /ko -->
        <!-- ko if: cashRegisters().length === 0 -->
        <div class="col-12">
            <div class="text-center text-muted py-5">
                <i class="bi bi-safe" style="font-size: 2rem;"></i>
                <p class="mt-2 small">Henuz kasa tanimlanmamis</p>
            </div>
        </div>
        <!-- /ko -->
    </div>

    <!-- Hareketler Tablosu (secili kasa) -->
    <!-- ko if: selectedRegister() -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
            <h6 class="mb-0">
                <i class="bi bi-arrow-left-circle me-1" style="cursor:pointer;" data-bind="click: clearSelection"></i>
                <span data-bind="text: selectedRegister().name"></span> - Hareketler
            </h6>
            <button class="btn btn-success btn-sm" data-bind="click: function() { openNewTransaction(selectedRegister()); }">
                <i class="bi bi-plus-lg me-1"></i>Yeni Islem
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih</th>
                            <th>Tur</th>
                            <th>Aciklama</th>
                            <th>Tutar</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: transactions">
                        <tr>
                            <td class="small" data-bind="text: createdAt ? new Date(createdAt).toLocaleDateString('tr-TR') : '-'"></td>
                            <td>
                                <span class="badge" data-bind="text: typeName, css: transactionTypeId === 1 ? 'bg-success' : 'bg-danger'"></span>
                            </td>
                            <td class="small" data-bind="text: description"></td>
                            <td class="small fw-semibold" data-bind="text: (amount || 0).toLocaleString('tr-TR') + ' TL', css: transactionTypeId === 1 ? 'text-success' : 'text-danger'"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: transactions().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-arrow-left-right" style="font-size: 2rem;"></i>
                <p class="mt-2 small">Bu kasada henuz hareket yok</p>
            </div>
            <!-- /ko -->
        </div>
    </div>
    <!-- /ko -->

    <!-- Yeni Kasa Modal -->
    <div class="modal fade" id="registerModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">Yeni Kasa</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small">Kasa Adi *</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: registerForm.name" />
                        </div>
                        <!-- ko if: branches().length > 1 -->
                        <div class="col-12">
                            <label class="form-label small">Sube *</label>
                            <select class="form-select form-select-sm" data-bind="value: registerForm.branchId,
                                options: branches,
                                optionsText: function(b){ return b.name + (b.isHeadquarter ? ' (Merkez)' : ''); },
                                optionsValue: 'id',
                                optionsCaption: 'Sube seciniz'"></select>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: saveRegister, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Gun Sonu Kapama Gecmisi -->
    <div class="card border-0 shadow-sm mt-3" data-bind="visible: closings().length > 0">
        <div class="card-header bg-white fw-semibold py-2">
            <i class="bi bi-lock me-2"></i>Gun Sonu Kapama Gecmisi
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>Tarih</th><th>Kasa</th><th>Sistem</th><th>Sayilan</th><th>Fark</th><th>Not</th></tr>
                    </thead>
                    <tbody data-bind="foreach: closings">
                        <tr>
                            <td class="small" data-bind="text: new Date(closingDate).toLocaleDateString('tr-TR')"></td>
                            <td class="small" data-bind="text: registerName"></td>
                            <td class="small" data-bind="text: systemTotal.toLocaleString('tr-TR') + ' TL'"></td>
                            <td class="small" data-bind="text: countedTotal.toLocaleString('tr-TR') + ' TL'"></td>
                            <td class="small fw-semibold" data-bind="text: difference.toLocaleString('tr-TR') + ' TL', css: difference >= 0 ? 'text-success' : 'text-danger'"></td>
                            <td class="small text-muted" data-bind="text: notes || '-'"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Gun Sonu Kapama Modal -->
    <div class="modal fade" id="closingModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning bg-opacity-10">
                    <h6 class="modal-title"><i class="bi bi-lock me-2"></i>Gun Sonu Kasa Kapama</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- ko if: dailySummary() -->
                    <div class="row g-3 mb-3">
                        <div class="col-4 text-center">
                            <div class="text-muted small">Gelir</div>
                            <div class="fw-bold text-success" data-bind="text: dailySummary().income.toLocaleString('tr-TR') + ' TL'"></div>
                        </div>
                        <div class="col-4 text-center">
                            <div class="text-muted small">Gider</div>
                            <div class="fw-bold text-danger" data-bind="text: dailySummary().expense.toLocaleString('tr-TR') + ' TL'"></div>
                        </div>
                        <div class="col-4 text-center">
                            <div class="text-muted small">Sistem Net</div>
                            <div class="fw-bold text-primary" data-bind="text: dailySummary().net.toLocaleString('tr-TR') + ' TL'"></div>
                        </div>
                    </div>
                    <hr />
                    <!-- /ko -->
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small">Sayilan Tutar (TL) *</label>
                            <input type="number" class="form-control" step="0.01" data-bind="value: closingForm.countedTotal" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Not</label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: closingForm.notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-warning btn-sm" data-bind="click: saveClosing, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-lock me-1" data-bind="visible: !isSaving()"></i>Kapamayi Tamamla
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Kasa Ac Modal -->
    <div class="modal fade" id="openRegisterModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-info bg-opacity-10">
                    <h6 class="modal-title"><i class="bi bi-unlock me-2"></i>Kasa Ac (Gun Basi)</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Acilis Bakiyesi</label>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="openBalanceType" id="openBalanceAuto" value="auto"
                                   data-bind="checked: openRegisterForm.balanceType" />
                            <label class="form-check-label small" for="openBalanceAuto">
                                Onceki kapanistan otomatik tasi
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="openBalanceType" id="openBalanceManual" value="manual"
                                   data-bind="checked: openRegisterForm.balanceType" />
                            <label class="form-check-label small" for="openBalanceManual">
                                Manuel bakiye gir
                            </label>
                        </div>
                        <!-- ko if: openRegisterForm.balanceType() === 'manual' -->
                        <div class="mt-2">
                            <label class="form-label small">Bakiye (TL)</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" data-bind="value: openRegisterForm.openingBalance" />
                        </div>
                        <!-- /ko -->
                        <!-- ko if: openRegisterForm.balanceType() === 'auto' && openRegisterForm.lastClosingBalance() !== null -->
                        <div class="alert alert-info py-2 mt-2 small">
                            <i class="bi bi-info-circle me-1"></i>Son kapanistan tasinacak bakiye:
                            <strong data-bind="text: (openRegisterForm.lastClosingBalance() || 0).toLocaleString('tr-TR') + ' TL'"></strong>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-info btn-sm" data-bind="click: saveOpenRegister, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-unlock me-1" data-bind="visible: !isSaving()"></i>Kasayi Ac
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Z Raporu Modal -->
    <div class="modal fade" id="zReportModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><i class="bi bi-file-earmark-bar-graph me-2"></i>Z Raporu</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- ko if: zReportLoading() -->
                    <div class="text-center py-4">
                        <div class="spinner-border spinner-border-sm text-primary"></div>
                        <p class="small text-muted mt-2">Rapor yukleniyor...</p>
                    </div>
                    <!-- /ko -->
                    <!-- ko if: !zReportLoading() && zReport() -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="card bg-light border-0">
                                <div class="card-body py-2 text-center">
                                    <div class="text-muted" style="font-size:.7rem;">Acilis Bakiyesi</div>
                                    <div class="fw-bold" data-bind="text: (zReport().openingBalance || 0).toLocaleString('tr-TR') + ' TL'"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card bg-light border-0">
                                <div class="card-body py-2 text-center">
                                    <div class="text-muted" style="font-size:.7rem;">Kapanis Bakiyesi</div>
                                    <div class="fw-bold" data-bind="text: (zReport().closingBalance || 0).toLocaleString('tr-TR') + ' TL'"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <table class="table table-sm table-bordered mb-0">
                        <thead class="table-light">
                            <tr><th></th><th class="text-end">Gelir</th><th class="text-end">Gider</th></tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="small fw-semibold">Nakit</td>
                                <td class="small text-end text-success" data-bind="text: (zReport().cashIncome || 0).toLocaleString('tr-TR') + ' TL'"></td>
                                <td class="small text-end text-danger" data-bind="text: (zReport().cashExpense || 0).toLocaleString('tr-TR') + ' TL'"></td>
                            </tr>
                            <tr>
                                <td class="small fw-semibold">Kredi Karti</td>
                                <td class="small text-end text-success" data-bind="text: (zReport().creditCardIncome || 0).toLocaleString('tr-TR') + ' TL'"></td>
                                <td class="small text-end text-danger" data-bind="text: (zReport().creditCardExpense || 0).toLocaleString('tr-TR') + ' TL'"></td>
                            </tr>
                            <tr class="table-light fw-bold">
                                <td class="small">Toplam</td>
                                <td class="small text-end text-success" data-bind="text: (zReport().totalIncome || 0).toLocaleString('tr-TR') + ' TL'"></td>
                                <td class="small text-end text-danger" data-bind="text: (zReport().totalExpense || 0).toLocaleString('tr-TR') + ' TL'"></td>
                            </tr>
                        </tbody>
                    </table>
                    <!-- /ko -->
                    <!-- ko if: !zReportLoading() && !zReport() -->
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-file-earmark-bar-graph" style="font-size:2rem;"></i>
                        <p class="mt-2 small">Rapor verisi bulunamadi</p>
                    </div>
                    <!-- /ko -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Yeni Islem Modal -->
    <div class="modal fade" id="transactionModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">Yeni Kasa Islemi</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small">Islem Turu *</label>
                            <select class="form-select form-select-sm" data-bind="value: transactionForm.transactionTypeId">
                                <option value="1">Gelir</option>
                                <option value="2">Gider</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Tutar (TL) *</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" data-bind="value: transactionForm.amount" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Odeme Yontemi</label>
                            <select class="form-select form-select-sm" data-bind="value: transactionForm.paymentMethodId">
                                <option value="1">Nakit</option>
                                <option value="2">Kredi Karti</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Aciklama *</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: transactionForm.description" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: saveTransaction, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Cash.js" asp-append-version="true"></script>
}
