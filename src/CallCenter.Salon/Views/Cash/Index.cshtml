@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.cash.auto.kasa", "Kasa");
}

<div id="cash-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <h5 class="mb-0"><t key="salon.cash.auto.kasa_yonetimi">Kasa Yönetimi</t></h5>
        </div>
        <button class="btn btn-primary btn-sm" data-bind="click: openNewRegister">
            <i class="bi bi-plus-lg me-1"></i><t key="salon.cash.auto.yeni_kasa">Yeni Kasa</t>
        </button>
    </div>

    <!-- Kasa Tablosu -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th><t key="salon.cash.auto.kasa">Kasa</t></th>
                            <th class="text-end"><t key="salon.cash.auto.bakiye">Bakiye</t></th>
                            <th><t key="salon.cash.auto.tur">Tür</t></th>
                            <th><t key="salon.common.branch">Şube</t></th>
                            <th><t key="salon.common.status">Durum</t></th>
                            <th class="text-end" style="min-width: 320px;"><t key="salon.common.actions">İşlemler</t></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: cashRegisters">
                        <tr>
                            <td class="fw-semibold small" data-bind="text: name"></td>
                            <td class="small fw-bold text-end" data-bind="text: (balance || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL', css: balance >= 0 ? 'text-success' : 'text-danger'"></td>
                            <td class="small" data-bind="text: typeName"></td>
                            <td class="small" data-bind="text: branchName || '-'"></td>
                            <td class="small">
                                <span class="badge" data-bind="text: isActive ? salonT('salon.common.status_active', 'Aktif') : salonT('salon.common.status_inactive', 'Pasif'), css: isActive ? 'bg-success' : 'bg-secondary'"></span>
                            </td>
                            <td>
                                <div class="d-flex flex-wrap justify-content-end gap-1">
                                    <button class="btn btn-outline-primary btn-sm text-nowrap" title="@(Translation.T("salon.cash.auto.hareketler", "Hareketler"))" data-bind="click: $parent.viewTransactions">
                                        <i class="bi bi-list-ul"></i><span class="d-none d-xl-inline ms-1"><t key="salon.cash.auto.hareketler">Hareketler</t></span>
                                    </button>
                                    <button class="btn btn-outline-success btn-sm text-nowrap" title="@(Translation.T("salon.cash.auto.islem", "İşlem"))" data-bind="click: $parent.openNewTransaction">
                                        <i class="bi bi-plus-lg"></i><span class="d-none d-xl-inline ms-1"><t key="salon.cash.auto.islem">İşlem</t></span>
                                    </button>
                                    <button class="btn btn-outline-info btn-sm text-nowrap" title="@(Translation.T("salon.cash.auto.kasa_ac", "Kasa Aç"))" data-bind="click: $parent.openCashRegister">
                                        <i class="bi bi-unlock"></i><span class="d-none d-xl-inline ms-1"><t key="salon.cash.auto.kasa_ac">Kasa Aç</t></span>
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm text-nowrap" title="@(Translation.T("salon.cash.auto.z_raporu", "Z Raporu"))" data-bind="click: $parent.openZReport">
                                        <i class="bi bi-file-earmark-bar-graph"></i><span class="d-none d-xl-inline ms-1"><t key="salon.cash.auto.z_raporu">Z Raporu</t></span>
                                    </button>
                                    <button class="btn btn-outline-warning btn-sm text-nowrap" title="@(Translation.T("salon.cash.auto.gun_sonu", "Gün Sonu"))" data-bind="click: $parent.openClosing">
                                        <i class="bi bi-lock"></i><span class="d-none d-xl-inline ms-1"><t key="salon.cash.auto.gun_sonu">Gün Sonu</t></span>
                                    </button>
                                    <button class="btn btn-outline-dark btn-sm text-nowrap" title="@(Translation.T("salon.cash.auto.duzenle", "Düzenle"))" data-bind="click: $parent.editRegister">
                                        <i class="bi bi-pencil"></i><span class="d-none d-xl-inline ms-1"><t key="salon.cash.auto.duzenle">Düzenle</t></span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: cashRegisters().length === 0 -->
            <div class="text-center text-muted py-5">
                <i class="bi bi-safe" style="font-size: 2rem;"></i>
                <p class="mt-2 small"><t key="salon.cash.auto.henuz_kasa_tanimlanmamis">Henüz kasa tanımlanmamış</t></p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Hareketler Tablosu (secili kasa) -->
    <!-- ko if: selectedRegister() -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
            <h6 class="mb-0">
                <i class="bi bi-arrow-left-circle me-1" style="cursor:pointer;" data-bind="click: clearSelection"></i>
                <span data-bind="text: selectedRegister().name"></span> <t key="salon.cash.auto.hareketler_2">- Hareketler</t>
            </h6>
            <button class="btn btn-success btn-sm" data-bind="click: function() { openNewTransaction(selectedRegister()); }">
                <i class="bi bi-plus-lg me-1"></i><t key="salon.cash.auto.yeni_islem">Yeni İşlem</t>
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th><t key="salon.panel.payments.date">Tarih</t></th>
                            <th><t key="salon.panel.payments.type">Tür</t></th>
                            <th><t key="salon.common.description">Açıklama</t></th>
                            <th><t key="salon.panel.payments.amount">Tutar</t></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: transactions">
                        <tr>
                            <td class="small" data-bind="text: createdAt ? new Date(createdAt).toLocaleDateString(document.documentElement.lang || undefined) : '-'"></td>
                            <td>
                                <span class="badge" data-bind="text: typeName, css: transactionTypeId === 1 ? 'bg-success' : 'bg-danger'"></span>
                            </td>
                            <td class="small" data-bind="text: description"></td>
                            <td class="small fw-semibold" data-bind="text: (amount || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL', css: transactionTypeId === 1 ? 'text-success' : 'text-danger'"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: transactions().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-arrow-left-right" style="font-size: 2rem;"></i>
                <p class="mt-2 small"><t key="salon.cash.auto.bu_kasada_henuz_hareket_yok">Bu kasada henüz hareket yok</t></p>
            </div>
            <!-- /ko -->
        </div>
    </div>
    <!-- /ko -->

    <!-- Yeni Kasa Modal -->
    <div class="modal fade" id="registerModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: registerForm.id() ? salonT('salon.cash.auto.kasa_duzenle', 'Kasa Düzenle') : salonT('salon.cash.auto.yeni_kasa', 'Yeni Kasa')"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.cash.auto.kasa_adi">Kasa Adı *</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="textInput: registerForm.name" />
                        </div>
                        <!-- ko if: branches().length > 1 -->
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.cash.auto.sube">Şube *</t></label>
                            <select class="form-select form-select-sm" data-bind="value: registerForm.branchId,
                                options: branches,
                                optionsText: function(b){ return b.name + (b.isHeadquarter ? ' (Merkez)' : ''); },
                                optionsValue: 'id',
                                optionsCaption: salonT('salon.cash.auto.sube_seciniz', 'Şube seçiniz')"></select>
                        </div>
                        <!-- /ko -->
                        <!-- ko if: registerForm.id() -->
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="regIsActive" data-bind="checked: registerForm.isActive" />
                                <label class="form-check-label small" for="regIsActive"><t key="salon.common.status_active">Aktif</t></label>
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: saveRegister, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i><t key="salon.common.btn.save">Kaydet</t>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Gun Sonu Kapama Gecmisi -->
    <div class="card border-0 shadow-sm mt-3" data-bind="visible: closings().length > 0">
        <div class="card-header bg-white fw-semibold py-2">
            <i class="bi bi-lock me-2"></i><t key="salon.cash.auto.gun_sonu_kapama_gecmisi">Gün Sonu Kapama Geçmişi</t>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr><th><t key="salon.panel.payments.date">Tarih</t></th><th><t key="salon.cash.auto.kasa">Kasa</t></th><th><t key="salon.cash.auto.sistem">Sistem</t></th><th><t key="salon.cash.auto.sayilan">Sayılan</t></th><th><t key="salon.cash.auto.fark">Fark</t></th><th><t key="salon.appointments.notes">Not</t></th></tr>
                    </thead>
                    <tbody data-bind="foreach: closings">
                        <tr>
                            <td class="small" data-bind="text: new Date(closingDate).toLocaleDateString(document.documentElement.lang || undefined)"></td>
                            <td class="small" data-bind="text: registerName"></td>
                            <td class="small" data-bind="text: systemTotal.toLocaleString(document.documentElement.lang || undefined) + ' TL'"></td>
                            <td class="small" data-bind="text: countedTotal.toLocaleString(document.documentElement.lang || undefined) + ' TL'"></td>
                            <td class="small fw-semibold" data-bind="text: difference.toLocaleString(document.documentElement.lang || undefined) + ' TL', css: difference >= 0 ? 'text-success' : 'text-danger'"></td>
                            <td class="small text-muted" data-bind="text: notes || '-'"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Gun Sonu Kapama Modal -->
    <div class="modal fade" id="closingModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning bg-opacity-10">
                    <h6 class="modal-title"><i class="bi bi-lock me-2"></i><t key="salon.cash.auto.gun_sonu_kasa_kapama">Gun Sonu Kasa Kapama</t></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- ko if: dailySummary() -->
                    <div class="row g-3 mb-3">
                        <div class="col-4 text-center">
                            <div class="text-muted small"><t key="salon.cash.auto.gelir">Gelir</t></div>
                            <div class="fw-bold text-success" data-bind="text: dailySummary().income.toLocaleString(document.documentElement.lang || undefined) + ' TL'"></div>
                        </div>
                        <div class="col-4 text-center">
                            <div class="text-muted small"><t key="salon.cash.auto.gider">Gider</t></div>
                            <div class="fw-bold text-danger" data-bind="text: dailySummary().expense.toLocaleString(document.documentElement.lang || undefined) + ' TL'"></div>
                        </div>
                        <div class="col-4 text-center">
                            <div class="text-muted small"><t key="salon.cash.auto.sistem_net">Sistem Net</t></div>
                            <div class="fw-bold text-primary" data-bind="text: dailySummary().net.toLocaleString(document.documentElement.lang || undefined) + ' TL'"></div>
                        </div>
                    </div>
                    <hr />
                    <!-- /ko -->
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.cash.auto.sayilan_tutar_tl">Sayilan Tutar (TL) *</t></label>
                            <input type="number" class="form-control" step="0.01" data-bind="value: closingForm.countedTotal" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.appointments.notes">Not</t></label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: closingForm.notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-warning btn-sm" data-bind="click: saveClosing, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-lock me-1" data-bind="visible: !isSaving()"></i><t key="salon.cash.auto.kapamayi_tamamla">Kapamayı Tamamla</t>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Kasa Ac Modal -->
    <div class="modal fade" id="openRegisterModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-info bg-opacity-10">
                    <h6 class="modal-title"><i class="bi bi-unlock me-2"></i><t key="salon.cash.auto.kasa_ac_gun_basi">Kasa Ac (Gun Basi)</t></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold"><t key="salon.cash.auto.acilis_bakiyesi">Açılış Bakiyesi</t></label>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="openBalanceType" id="openBalanceAuto" value="auto"
                                   data-bind="checked: openRegisterForm.balanceType" />
                            <label class="form-check-label small" for="openBalanceAuto">
                                <t key="salon.cash.auto.onceki_kapanistan_otomatik_tasi">Önceki kapanıştan otomatik taşı</t>
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="openBalanceType" id="openBalanceManual" value="manual"
                                   data-bind="checked: openRegisterForm.balanceType" />
                            <label class="form-check-label small" for="openBalanceManual">
                                <t key="salon.cash.auto.manuel_bakiye_gir">Manuel bakiye gir</t>
                            </label>
                        </div>
                        <!-- ko if: openRegisterForm.balanceType() === 'manual' -->
                        <div class="mt-2">
                            <label class="form-label small"><t key="salon.cash.auto.bakiye_tl">Bakiye (TL)</t></label>
                            <input type="number" class="form-control form-control-sm" step="0.01" data-bind="value: openRegisterForm.openingBalance" />
                        </div>
                        <!-- /ko -->
                        <!-- ko if: openRegisterForm.balanceType() === 'auto' && openRegisterForm.lastClosingBalance() !== null -->
                        <div class="alert alert-info py-2 mt-2 small">
                            <i class="bi bi-info-circle me-1"></i><t key="salon.cash.auto.son_kapanistan_tasinacak_bakiye">Son kapanıştan taşınacak bakiye:</t>
                            <strong data-bind="text: (openRegisterForm.lastClosingBalance() || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></strong>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-info btn-sm" data-bind="click: saveOpenRegister, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-unlock me-1" data-bind="visible: !isSaving()"></i><t key="salon.cash.auto.kasayi_ac">Kasayı Aç</t>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Z Raporu Modal -->
    <div class="modal fade" id="zReportModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><i class="bi bi-file-earmark-bar-graph me-2"></i><t key="salon.cash.auto.z_raporu">Z Raporu</t></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- ko if: zReportLoading() -->
                    <div class="text-center py-4">
                        <div class="spinner-border spinner-border-sm text-primary"></div>
                        <p class="small text-muted mt-2"><t key="salon.cash.auto.rapor_yukleniyor">Rapor yukleniyor...</t></p>
                    </div>
                    <!-- /ko -->
                    <!-- ko if: !zReportLoading() && zReport() -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="card bg-light border-0">
                                <div class="card-body py-2 text-center">
                                    <div class="text-muted" style="font-size:.7rem;"><t key="salon.cash.auto.acilis_bakiyesi">Açılış Bakiyesi</t></div>
                                    <div class="fw-bold" data-bind="text: (zReport().openingBalance || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card bg-light border-0">
                                <div class="card-body py-2 text-center">
                                    <div class="text-muted" style="font-size:.7rem;"><t key="salon.cash.auto.kapanis_bakiyesi">Kapanış Bakiyesi</t></div>
                                    <div class="fw-bold" data-bind="text: (zReport().closingBalance || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <table class="table table-sm table-bordered mb-0">
                        <thead class="table-light">
                            <tr><th></th><th class="text-end"><t key="salon.cash.auto.gelir">Gelir</t></th><th class="text-end"><t key="salon.cash.auto.gider">Gider</t></th></tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="small fw-semibold"><t key="salon.cash.auto.nakit">Nakit</t></td>
                                <td class="small text-end text-success" data-bind="text: (zReport().cashIncome || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></td>
                                <td class="small text-end text-danger" data-bind="text: (zReport().cashExpense || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></td>
                            </tr>
                            <tr>
                                <td class="small fw-semibold"><t key="salon.cash.auto.kredi_karti">Kredi Kartı</t></td>
                                <td class="small text-end text-success" data-bind="text: (zReport().creditCardIncome || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></td>
                                <td class="small text-end text-danger" data-bind="text: (zReport().creditCardExpense || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></td>
                            </tr>
                            <tr class="table-light fw-bold">
                                <td class="small"><t key="salon.cash.auto.toplam">Toplam</t></td>
                                <td class="small text-end text-success" data-bind="text: (zReport().totalIncome || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></td>
                                <td class="small text-end text-danger" data-bind="text: (zReport().totalExpense || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></td>
                            </tr>
                        </tbody>
                    </table>
                    <!-- /ko -->
                    <!-- ko if: !zReportLoading() && !zReport() -->
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-file-earmark-bar-graph" style="font-size:2rem;"></i>
                        <p class="mt-2 small"><t key="salon.cash.auto.rapor_verisi_bulunamadi">Rapor verisi bulunamadi</t></p>
                    </div>
                    <!-- /ko -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.cash.auto.kapat">Kapat</t></button>
                </div>
            </div>
        </div>
    </div>

    <!-- Yeni Islem Modal -->
    <div class="modal fade" id="transactionModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><t key="salon.cash.auto.yeni_kasa_islemi">Yeni Kasa Islemi</t></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.cash.auto.islem_turu_required">İşlem Türü *</t></label>
                            <select class="form-select form-select-sm" data-bind="value: transactionForm.transactionTypeId">
                                <option value="1"><t key="salon.cash.auto.gelir_2">Gelir</t></option>
                                <option value="2"><t key="salon.cash.auto.gider_2">Gider</t></option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.cash.auto.tutar_tl">Tutar (TL) *</t></label>
                            <input type="number" class="form-control form-control-sm" step="0.01" data-bind="value: transactionForm.amount" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.cash.auto.odeme_yontemi">Ödeme Yontemi</t></label>
                            <select class="form-select form-select-sm" data-bind="value: transactionForm.paymentMethodId">
                                <option value="1"><t key="salon.cash.auto.nakit">Nakit</t></option>
                                <option value="2"><t key="salon.cash.auto.kredi_karti">Kredi Kartı</t></option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.cash.auto.aciklama">Açıklama *</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: transactionForm.description" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: saveTransaction, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i><t key="salon.common.btn.save">Kaydet</t>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Cash.js" asp-append-version="true"></script>
}
