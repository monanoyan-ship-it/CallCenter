@inject CallCenter.Shared.Services.ITranslationService Translation

<div id="loyalty-program-vm">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="text-muted small flex-grow-1">
            <t key="salon.loyalty.program.hint">"10 fon yaptirana 1 bedava" tarzi programlar burada tanimlanir. Her tanimli hizmet adisyona girince musterinin sayim ilerler; esige varan odul kazanir.</t>
        </div>
        <button class="btn btn-primary btn-sm" data-bind="click: openNewProgram">
            <i class="bi bi-plus-lg me-1"></i><t key="salon.loyalty.program.new">Yeni Program</t>
        </button>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-md-3">
            <div class="border rounded p-2 h-100">
                <div class="small text-muted"><t key="salon.loyalty.program.stat.programs">Program Sayisi</t></div>
                <div class="fs-5 fw-semibold" data-bind="text: programs().length"></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="border rounded p-2 h-100">
                <div class="small text-muted"><t key="salon.loyalty.program.stat.active_progress">Aktif Musteri Sayimi</t></div>
                <div class="fs-5 fw-semibold" data-bind="text: progresses().length"></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="border rounded p-2 h-100">
                <div class="small text-muted"><t key="salon.loyalty.program.stat.total_earned">Toplam Kazanilan Odul</t></div>
                <div class="fs-5 fw-semibold" data-bind="text: totalEarned()"></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="border rounded p-2 h-100">
                <div class="small text-muted"><t key="salon.loyalty.program.stat.available">Kullanilabilir Odul</t></div>
                <div class="fs-5 fw-semibold" data-bind="text: totalAvailable()"></div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white"><strong><t key="salon.loyalty.program.programs_title">Program Tanimlari</t></strong></div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th><t key="salon.loyalty.program.col.name">Ad</t></th>
                            <th><t key="salon.loyalty.program.col.service">Sayilan Hizmet</t></th>
                            <th><t key="salon.loyalty.program.col.required">Esik</t></th>
                            <th><t key="salon.loyalty.program.col.reward">Odul Hizmeti</t></th>
                            <th><t key="salon.loyalty.program.col.valid_days">Gecerlilik (Gun)</t></th>
                            <th><t key="salon.loyalty.program.col.status">Durum</t></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: programs">
                        <tr>
                            <td data-bind="text: $data.name"></td>
                            <td data-bind="text: $data.serviceName"></td>
                            <td data-bind="text: $data.requiredVisits"></td>
                            <td data-bind="text: $data.rewardServiceName"></td>
                            <td data-bind="text: $data.rewardValidDays || '—'"></td>
                            <td>
                                <span class="badge" data-bind="css: $data.isActive ? 'bg-success' : 'bg-secondary',
                                                                text: $data.isActive ? slnJsT('salon.common.status_active', 'Aktif') : slnJsT('salon.common.status_passive', 'Pasif')"></span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary" data-bind="click: $parent.openEditProgram"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.removeProgram"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white"><strong><t key="salon.loyalty.program.progress_title">Musteri Ilerleme</t></strong></div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th><t key="salon.loyalty.program.col.client">Musteri</t></th>
                            <th><t key="salon.loyalty.program.col.program">Program</t></th>
                            <th><t key="salon.loyalty.program.col.progress">Ilerleme</t></th>
                            <th><t key="salon.loyalty.program.col.next">Kalan</t></th>
                            <th><t key="salon.loyalty.program.col.earned">Kazanildi</t></th>
                            <th><t key="salon.loyalty.program.col.used">Kullanildi</t></th>
                            <th><t key="salon.loyalty.program.col.available">Kalan</t></th>
                            <th><t key="salon.loyalty.program.col.last_visit">Son Ziyaret</t></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: progresses">
                        <tr>
                            <td data-bind="text: $data.clientName || '—'"></td>
                            <td data-bind="text: $data.programName"></td>
                            <td>
                                <div class="small" data-bind="text: $data.visitCount + ' / ' + $data.requiredVisits"></div>
                                <div class="progress" style="height:6px;">
                                    <div class="progress-bar" role="progressbar"
                                         data-bind="style: { width: $parent.progressPct($data) + '%' }"></div>
                                </div>
                            </td>
                            <td data-bind="text: $data.visitsToNextReward"></td>
                            <td data-bind="text: $data.rewardsEarned"></td>
                            <td data-bind="text: $data.rewardsUsed"></td>
                            <td><span class="badge bg-info" data-bind="text: $data.availableRewards"></span></td>
                            <td data-bind="text: $parent.formatDateTime($data.lastVisitAt)"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Program Modal -->
    <div class="modal fade" id="loyaltyProgramModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">
                        <span data-bind="text: isEditing() ? slnJsT('salon.loyalty.program.edit', 'Programi Duzenle') : slnJsT('salon.loyalty.program.new', 'Yeni Program')"></span>
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small"><t key="salon.loyalty.program.col.name">Ad</t></label>
                        <input type="text" class="form-control form-control-sm" data-bind="value: form.name" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small"><t key="salon.loyalty.program.col.service">Sayilan Hizmet</t></label>
                        <select class="form-select form-select-sm" data-bind="options: services, optionsText: 'name', optionsValue: 'id', value: form.serviceId, optionsCaption: '—'"></select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small"><t key="salon.loyalty.program.col.required">Esik (orn. 10)</t></label>
                        <input type="number" min="1" class="form-control form-control-sm" data-bind="value: form.requiredVisits" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small"><t key="salon.loyalty.program.col.reward">Odul Hizmeti</t></label>
                        <select class="form-select form-select-sm" data-bind="options: services, optionsText: 'name', optionsValue: 'id', value: form.rewardServiceId, optionsCaption: '—'"></select>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small"><t key="salon.loyalty.program.col.valid_days">Odul Gecerlilik (gun, opsiyonel)</t></label>
                            <input type="number" min="1" class="form-control form-control-sm" data-bind="value: form.rewardValidDays" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small"><t key="salon.loyalty.program.col.max_rewards">Maks Odul/Musteri (opsiyonel)</t></label>
                            <input type="number" min="1" class="form-control form-control-sm" data-bind="value: form.maxRewardsPerClient" />
                        </div>
                    </div>
                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" data-bind="checked: form.isActive" />
                        <label class="form-check-label small"><t key="salon.common.status_active">Aktif</t></label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">Iptal</t></button>
                    <button class="btn btn-primary btn-sm" data-bind="click: saveProgram, disable: isSaving"><t key="salon.common.btn.save">Kaydet</t></button>
                </div>
            </div>
        </div>
    </div>
</div>
