@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.sales.auto.hizli_satis", "Hızlı Satış");
}

<div id="sales-vm">
    <div class="row g-0" style="margin: -1.5rem; min-height: calc(100vh - 60px);">

        <!-- SOL: Kategori + Hizmetler -->
        <div class="col-md-8 p-3" style="background: #f8f9fa;">
            <!-- Recete + Kategori Tablari -->
            <div class="d-flex flex-wrap gap-2 mb-3">
                <!-- ko if: recipes().length > 0 -->
                <button class="btn btn-sm px-3 py-2 d-flex align-items-center gap-2"
                        data-bind="click: toggleRecipes,
                                   css: showRecipes() ? 'btn-warning' : 'btn-outline-warning'">
                    <i class="bi bi-journal-bookmark-fill"></i>
                    <span class="small fw-semibold"><t key="salon.sales.auto.receteler">Reçeteler</t></span>
                </button>
                <!-- /ko -->
            <!-- ko foreach: categories -->
                <button class="btn btn-sm px-3 py-2 d-flex align-items-center gap-2"
                        data-bind="click: $parent.selectCategory,
                                   css: $parent.selectedCategoryId() === id ? 'btn-dark' : 'btn-outline-secondary',
                                   style: { borderColor: color || '#6c757d' }">
                    <i data-bind="attr: { 'class': iconClass || 'bi bi-tag' }, style: { color: $parent.selectedCategoryId() === id ? '#fff' : (color || '#6c757d') }"></i>
                    <span data-bind="text: name" class="small fw-semibold"></span>
                </button>
            <!-- /ko -->
            </div>

            <!-- Urun Barkod Arama -->
            <div class="mb-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-upc-scan"></i></span>
                    <input type="text" class="form-control" placeholder="@(Translation.T("salon.sales.auto.urun_barkodu_veya_adi", "Ürün barkodu veya adı"))"
                           autocomplete="off"
                           data-bind="value: productSearchQuery,
                                      valueUpdate: 'afterkeydown',
                                      event: { keydown: onProductSearchKeydown }" />
                    <button class="btn btn-outline-success" data-bind="click: addProductBySearch">
                        <i class="bi bi-cart-plus"></i>
                    </button>
                </div>
                <!-- ko if: filteredProducts().length > 0 -->
                <div class="d-flex flex-wrap gap-1 mt-2" data-bind="foreach: filteredProducts">
                    <button class="btn btn-sm py-1 px-2"
                            data-bind="click: $parent.addProductToCart,
                                       css: (stockQuantity || 0) > 0 ? 'btn-outline-success' : 'btn-outline-secondary',
                                       enable: (stockQuantity || 0) > 0">
                        <span data-bind="text: name"></span>
                        <span class="ms-1 opacity-75" data-bind="text: (salePrice || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></span>
                        <span class="ms-1 text-muted" data-bind="text: 'Stok ' + (stockQuantity || 0)"></span>
                    </button>
                </div>
                <!-- /ko -->
            </div>

            <!-- Seans Satislari -->
            <!-- ko if: filteredSessionDefinitions().length > 0 -->
            <div class="mb-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-box-seam text-info"></i>
                    <span class="small fw-semibold"><t key="salon.sales.session_sales">Seans Satışları</t></span>
                </div>
                <div class="row g-2" data-bind="foreach: filteredSessionDefinitions">
                    <div class="col-6 col-lg-4 col-xl-3">
                        <div class="card border-0 shadow-sm h-100 service-card" style="cursor:pointer; border-left: 3px solid #0dcaf0 !important;"
                             data-bind="click: $parent.addSessionDefinitionToCart">
                            <div class="card-body p-3 text-center">
                                <div class="fw-semibold small" data-bind="text: name"></div>
                                <div class="text-muted" style="font-size:.7rem;" data-bind="text: serviceName"></div>
                                <div class="badge bg-info-subtle text-info-emphasis mt-1">
                                    <span data-bind="text: totalSessions"></span>
                                    <span><t key="salon.services.package_sessions">seans</t></span>
                                </div>
                                <div class="fw-bold text-primary mt-1" data-bind="text: (price || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- /ko -->

            <!-- Recete Grid -->
            <div class="row g-2 mb-3" data-bind="visible: showRecipes(), foreach: recipes">
                <div class="col-6 col-lg-4 col-xl-3">
                    <div class="card border-0 shadow-sm h-100" style="cursor:pointer; border-left: 3px solid #ff9800 !important;"
                         data-bind="click: $parent.addRecipeToCart">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center mb-1">
                                <i class="me-2" data-bind="attr: { 'class': iconClass || 'bi bi-journal-bookmark' }" style="color:#ff9800;"></i>
                                <span class="fw-semibold small" data-bind="text: name"></span>
                            </div>
                            <div class="text-muted" style="font-size:.65rem;" data-bind="text: (description || '')"></div>
                            <div class="mt-1">
                                <span class="fw-bold text-warning" data-bind="text: (estimatedCost || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hizmet Grid -->
            <div class="row g-2" data-bind="foreach: filteredServices">
                <div class="col-6 col-lg-4 col-xl-3">
                    <div class="card border-0 shadow-sm h-100 service-card" style="cursor:pointer;"
                         data-bind="click: $parent.addToCart">
                        <div class="card-body p-3 text-center">
                            <div class="fw-semibold small" data-bind="text: name"></div>
                            <div class="text-muted" style="font-size:.7rem;" data-bind="text: durationMinutes + ' dk'"></div>
                            <div class="fw-bold text-primary mt-1" data-bind="text: price.toLocaleString(document.documentElement.lang || undefined) + ' TL'"></div>
                            <!-- ko if: $parent.sessionDefinitionLabel($data) -->
                            <div class="badge bg-info-subtle text-info-emphasis mt-1" data-bind="text: $parent.sessionDefinitionLabel($data)"></div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- ko if: filteredServices().length === 0 -->
            <div class="text-center text-muted py-5">
                <i class="bi bi-scissors" style="font-size: 3rem; opacity:.3;"></i>
                <p class="mt-2 small"><t key="salon.sales.auto.bir_kategori_seciniz">Bir kategori seçiniz</t></p>
            </div>
            <!-- /ko -->
        </div>

        <!-- SAG: Sepet -->
        <div class="col-md-4 d-flex flex-column" style="background: #fff; border-left: 1px solid #dee2e6; position: sticky; top: 60px; height: calc(100vh - 60px);">
            <!-- Randevu Çek + Müşteri -->
            <div class="p-2 border-bottom d-flex gap-1">
                <button class="btn btn-outline-info btn-sm flex-fill" data-bind="click: openAppointments">
                    <i class="bi bi-calendar-check me-1"></i><t key="salon.sales.auto.randevu_cek">Randevu Çek</t>
                </button>
                <!-- ko if: linkedAppointmentId() -->
                <span class="badge bg-info align-self-center" data-bind="text: salonT('salon.sales.auto.randevu', 'Randevu #') + linkedAppointmentId()"></span>
                <button class="btn btn-outline-secondary btn-sm py-0" data-bind="click: unlinkAppointment" title="@(Translation.T("salon.sales.auto.randevu_baglantisini_kaldir", "Randevu bağlantısını kaldır"))"><i class="bi bi-x"></i></button>
                <!-- /ko -->
            </div>

            <!-- Musteri Secimi -->
            <div class="p-3 border-bottom">
                <div class="position-relative" data-bind="with: clientAutocomplete">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input type="text" class="form-control" placeholder="@(Translation.T("salon.sales.auto.musteri_opsiyonel", "Müşteri (opsiyonel)"))"
                               autocomplete="off"
                               data-bind="value: query, valueUpdate: 'afterkeydown',
                                          event: { focus: onFocus, blur: onBlur, keydown: onKeydown }" />
                        <!-- ko if: selectedName() -->
                        <button class="btn btn-outline-secondary" data-bind="click: clear"><i class="bi bi-x"></i></button>
                        <!-- /ko -->
                    </div>
                    <div class="dropdown-menu w-100 shadow-sm" style="max-height:200px;overflow-y:auto;" data-bind="css: { show: showDropdown }">
                        <!-- ko foreach: filteredItems -->
                        <a class="dropdown-item small py-1 px-2" href="#"
                           data-bind="text: $parent.getDisplayText($data), click: $parent.select,
                                      css: { active: $parent.highlightIndex() === $index() },
                                      event: { mousedown: function(){ $parent.select($data); } }"></a>
                        <!-- /ko -->
                    </div>
                </div>
                <div class="small text-muted mt-2" data-bind="visible: packageDefinitions().length > 0">
                    <i class="bi bi-info-circle me-1"></i><t key="salon.sales.session_plan_auto_sale_note">Seanslı hizmetlerde takip, ödeme alındığında otomatik açılır.</t>
                </div>
            </div>

            <!-- Musteri Seanslari -->
            <div class="p-3 border-bottom" data-bind="visible: clientId">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="small fw-semibold">
                        <i class="bi bi-clipboard2-pulse me-1 text-primary"></i>Müşteri Seansları
                    </div>
                    <button type="button" class="btn btn-link btn-sm p-0" data-bind="click: function(){ loadClientPackages(clientId()); }">
                        Yenile
                    </button>
                </div>
                <!-- ko if: activeClientPackages().length > 0 -->
                <div class="d-grid gap-2" data-bind="foreach: activeClientPackages">
                    <button type="button" class="btn btn-outline-primary btn-sm text-start"
                            data-bind="click: $parent.openSessionUsage">
                        <div class="d-flex justify-content-between gap-2">
                            <span class="fw-semibold" data-bind="text: packageName"></span>
                            <span class="badge bg-primary-subtle text-primary-emphasis" data-bind="text: $parent.sessionUsageSummary($data)"></span>
                        </div>
                        <div class="text-muted small" data-bind="text: serviceName"></div>
                    </button>
                </div>
                <!-- /ko -->
                <!-- ko if: activeClientPackages().length === 0 -->
                <div class="text-muted small">Bu müşterinin aktif seans paketi yok.</div>
                <!-- /ko -->
            </div>

            <!-- Sepet Kalemleri -->
            <div class="flex-grow-1 overflow-auto p-3">
                <div data-bind="foreach: cartItems">
                    <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                        <div class="flex-grow-1">
                            <div class="small fw-semibold" data-bind="text: name"></div>
                            <div class="d-flex align-items-center gap-1" style="font-size:.75rem;">
                                <span class="text-muted" data-bind="text: quantity() + ' x'"></span>
                                <input type="number" class="form-control form-control-sm py-0 text-end" style="width:65px; font-size:.75rem;"
                                       step="0.01" min="0" data-bind="value: editPrice" />
                                <span class="text-muted">TL</span>
                            </div>
                            <div class="small text-success" data-bind="visible: benefitText && benefitText(), text: benefitText"></div>
                            <!-- ko if: serviceId && $data.forceSessionSale !== true -->
                            <button type="button" class="btn btn-sm py-0 px-2 mt-1"
                                    data-bind="click: $parent.openMaterials, css: $parent.materialButtonClass($data)">
                                <i class="bi bi-droplet-half me-1"></i><span data-bind="text: $parent.materialSummary($data)"></span>
                            </button>
                            <!-- /ko -->
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <button class="btn btn-outline-secondary btn-sm px-1 py-0" data-bind="click: $parent.decreaseQty" style="font-size:.7rem;">
                                <i class="bi bi-dash"></i>
                            </button>
                            <span class="badge bg-secondary" data-bind="text: quantity()" style="min-width:24px;"></span>
                            <button class="btn btn-outline-secondary btn-sm px-1 py-0" data-bind="click: $parent.increaseQty" style="font-size:.7rem;">
                                <i class="bi bi-plus"></i>
                            </button>
                            <span class="fw-bold small ms-2" style="min-width:60px; text-align:right;"
                                  data-bind="text: (quantity() * (parseFloat(editPrice()) || 0)).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></span>
                            <button class="btn btn-outline-danger btn-sm px-1 py-0 ms-1" data-bind="click: $parent.removeFromCart" style="font-size:.7rem;">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ko if: cartItems().length === 0 -->
                <div class="text-center text-muted py-4">
                    <i class="bi bi-cart3" style="font-size: 2rem; opacity:.3;"></i>
                    <p class="mt-2 small"><t key="salon.sales.auto.sepet_bos">Sepet boş</t></p>
                </div>
                <!-- /ko -->
            </div>

            <!-- Cok Seansli Hizmet (B): aktif plan chip listesi -->
            <div class="p-3 border-top" style="background:#e7f3ff;" data-bind="visible: clientId() && serviceSessionPlans().length > 0">
                <div class="small fw-semibold mb-1"><i class="bi bi-calendar2-check text-primary me-1"></i><t key="salon.sales.session_plans.active">Aktif Cok Seansli Hizmet Planlari</t></div>
                <div class="d-flex flex-wrap gap-1" data-bind="foreach: serviceSessionPlans">
                    <button type="button" class="btn btn-sm btn-outline-primary" data-bind="click: $parent.addPlanSessionToCart">
                        <i class="bi bi-plus-circle me-1"></i>
                        <span data-bind="text: $data.serviceName"></span>
                        <span class="text-muted small ms-1" data-bind="text: ($data.remainingSessions || 0) + '/' + ($data.totalSessions || 0) + ' kalan'"></span>
                    </button>
                </div>
            </div>

            <!-- Sadakat: D odul chip listesi + C puan ile odeme -->
            <div class="p-3 border-top" style="background:#fff8e7;" data-bind="visible: clientId() && (loyaltyRewards().length > 0 || (clientLoyaltyBalance() > 0))">
                <!-- ko if: loyaltyRewards().length > 0 -->
                <div class="mb-2">
                    <div class="small fw-semibold mb-1"><i class="bi bi-stars text-warning me-1"></i><t key="salon.sales.loyalty.rewards">Kullanilabilir Sadakat Odulleri</t></div>
                    <div class="d-flex flex-wrap gap-1" data-bind="foreach: loyaltyRewards">
                        <button type="button" class="btn btn-sm btn-outline-warning" data-bind="click: $parent.addRewardToCart">
                            <i class="bi bi-plus-circle me-1"></i>
                            <span data-bind="text: $data.rewardServiceName"></span>
                            <span class="text-muted small ms-1" data-bind="text: $data.programName"></span>
                        </button>
                    </div>
                </div>
                <!-- /ko -->
                <!-- ko if: clientLoyaltyBalance() > 0 -->
                <div>
                    <div class="small fw-semibold mb-1"><i class="bi bi-coin text-warning me-1"></i><t key="salon.sales.loyalty.points">Puanla Ode</t> <span class="text-muted">(<t key="salon.sales.loyalty.balance">Bakiye</t>: <span data-bind="text: clientLoyaltyBalance()"></span> <t key="salon.sales.loyalty.points_unit">puan</t>)</span></div>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><t key="salon.sales.loyalty.use">Kullan</t></span>
                        <input type="number" min="0" class="form-control" data-bind="value: loyaltyPointsToRedeem, valueUpdate: 'afterkeydown'" />
                        <span class="input-group-text">=</span>
                        <input type="text" class="form-control" readonly data-bind="value: loyaltyPointsTlValue().toFixed(2) + ' TL'" />
                    </div>
                </div>
                <!-- /ko -->
            </div>

            <!-- Personel + Odeme -->
            <div class="p-3 border-top" style="background:#fff;" data-bind="visible: cartItems().length > 0">
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <select class="form-select form-select-sm" data-bind="value: selectedPersonnelId,
                            options: staffList, optionsText: 'fullName', optionsValue: 'id', optionsCaption: salonT('salon.sidebar.staff', 'Personel')"></select>
                    </div>
                    <div class="col-6">
                        <select class="form-select form-select-sm" data-bind="value: paymentMethodId">
                            <option value="1"><t key="salon.sales.auto.nakit">Nakit</t></option>
                            <option value="2"><t key="salon.sales.auto.kredi_karti">Kredi Kartı</t></option>
                            <option value="3"><t key="salon.sales.auto.karma">Çoklu İşlem</t></option>
                            <option value="5"><t key="salon.sales.auto.hediye_karti">Hediye Kartı</t></option>
                        </select>
                    </div>
                </div>
                <!-- ko if: parseInt(paymentMethodId()) === 5 -->
                <div class="input-group input-group-sm mb-2">
                    <span class="input-group-text"><i class="bi bi-gift"></i></span>
                    <input type="text" class="form-control" placeholder="@(Translation.T("salon.sales.auto.placeholder_hediye_karti_kodu", "Hediye kartı kodu"))" data-bind="value: giftCardCode, valueUpdate: 'afterkeydown'" />
                </div>
                <!-- /ko -->
            </div>

            <!-- Toplam + Ode -->
            <div class="p-3 border-top shadow-sm" style="background: #f8f9fa; position: sticky; bottom: 0; z-index: 3;" data-bind="visible: cartItems().length > 0">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small"><t key="salon.sales.auto.ara_toplam">Ara Toplam</t></span>
                    <span class="fw-bold" data-bind="text: subtotal().toLocaleString(document.documentElement.lang || undefined) + ' TL'"></span>
                </div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="text-muted small"><t key="salon.sales.auto.indirim">İndirim</t></span>
                    <div class="input-group input-group-sm" style="max-width:110px;">
                        <input type="number" class="form-control text-end" data-bind="value: discountAmount" min="0" step="1" />
                        <span class="input-group-text">TL</span>
                    </div>
                    <span class="text-muted small ms-2"><t key="salon.sales.auto.bahsis">Bahşiş</t></span>
                    <div class="input-group input-group-sm" style="max-width:110px;">
                        <input type="number" class="form-control text-end" data-bind="value: tipAmount" min="0" step="1" />
                        <span class="input-group-text">TL</span>
                    </div>
                </div>
                <!-- ko if: (parseFloat(tipAmount()) || 0) > 0 -->
                <div class="form-check form-switch mb-2 ms-1">
                    <input class="form-check-input" type="checkbox" id="tipIncludeChk" data-bind="checked: tipIncludeInTotal" />
                    <label class="form-check-label small text-muted" for="tipIncludeChk"><t key="salon.sales.auto.bahsisi_toplama_dahil_et">Bahşişi toplama dahil et</t></label>
                </div>
                <!-- /ko -->
                <!-- ko if: isPrepaid() -->
                <div class="alert alert-info py-1 small mb-2">
                    <i class="bi bi-credit-card me-1"></i><t key="salon.sales.auto.online_on_odeme">Online ön ödeme:</t> <strong data-bind="text: prepaidAmount().toLocaleString(document.documentElement.lang || undefined) + ' TL'"></strong>
                    <!-- ko if: remainingAmount() > 0 -->
                    <br /><t key="salon.sales.auto.kalan_tutar">Kalan tutar:</t> <strong class="text-danger" data-bind="text: remainingAmount().toLocaleString(document.documentElement.lang || undefined) + ' TL'"></strong>
                    <!-- /ko -->
                    <!-- ko if: remainingAmount() <= 0 -->
                    <br /><span class="text-success"><i class="bi bi-check-circle me-1"></i><t key="salon.sales.auto.tamami_odenmis">Tamamı ödenmiş</t></span>
                    <!-- /ko -->
                </div>
                <!-- /ko -->
                <div class="d-flex justify-content-end mb-3">
                    <span class="fw-bold fs-5 text-success" data-bind="text: (isPrepaid() ? remainingAmount() : grandTotal()).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></span>
                </div>
                <button class="btn btn-success w-100 py-2" data-bind="click: checkout, disable: isSaving">
                    <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                    <i class="bi bi-check-circle me-1" data-bind="visible: !isSaving()"></i>
                    <span class="fw-bold">Tahsilat Al</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Seans Kullanim Modal -->
    <div class="modal fade" id="sessionUsageModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">
                        <i class="bi bi-clipboard2-pulse me-2"></i>
                        Seans İşlemi
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- ko if: sessionUsagePackage -->
                    <div class="border rounded p-2 mb-3 small">
                        <div class="d-flex justify-content-between gap-2">
                            <div>
                                <div class="fw-semibold" data-bind="text: sessionUsagePackage().packageName"></div>
                                <div class="text-muted" data-bind="text: sessionUsagePackage().serviceName"></div>
                            </div>
                            <span class="badge bg-primary align-self-start" data-bind="text: sessionUsageSummary(sessionUsagePackage())"></span>
                        </div>
                    </div>
                    <!-- /ko -->
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small">Bölge / işlem</label>
                            <input class="form-control form-control-sm" placeholder="Örn: Tüm bacak lazer" data-bind="textInput: sessionUseForm.area" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">Kullanılan ürün</label>
                            <select class="form-select form-select-sm"
                                    data-bind="value: sessionUseForm.productId,
                                               options: products,
                                               optionsText: 'name',
                                               optionsValue: 'id',
                                               optionsCaption: 'Ürün seç...'"></select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Miktar</label>
                            <input class="form-control form-control-sm" placeholder="Örn: 20 ml" data-bind="textInput: sessionUseForm.amount" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Cihaz</label>
                            <select class="form-select form-select-sm"
                                    data-bind="value: sessionUseForm.deviceType,
                                               options: laserDevices,
                                               optionsText: 'name',
                                               optionsValue: 'id',
                                               optionsCaption: 'Cihaz seç...'"></select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Marka / model</label>
                            <input class="form-control form-control-sm" placeholder="Örn: Candela GentleMax Pro" data-bind="textInput: sessionUseForm.deviceModel" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Ayarlar</label>
                            <input class="form-control form-control-sm" placeholder="Örn: 12J / 20ms" data-bind="textInput: sessionUseForm.settings" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">Cilt / reaksiyon</label>
                            <input class="form-control form-control-sm" placeholder="Örn: Normal kızarıklık" data-bind="textInput: sessionUseForm.reaction" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">Sonraki seans</label>
                            <input type="date" class="form-control form-control-sm" data-bind="value: sessionUseForm.nextDate" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Not</label>
                            <textarea class="form-control form-control-sm" rows="3" data-bind="textInput: sessionUseForm.notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: confirmSessionUsage, disable: isSaving">
                        <i class="bi bi-check2-circle me-1"></i>Seansı Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Hizmet Malzemeleri Modal -->
    <div class="modal fade" id="materialModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">
                        <i class="bi bi-droplet-half me-2"></i>
                        <span data-bind="text: currentMaterialItem() ? currentMaterialItem().name : 'Hizmet Malzemeleri'"></span>
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="small text-muted">Bu hizmette kullanılan malzemeler ödeme alınca stoktan düşer.</div>
                        <button type="button" class="btn btn-outline-primary btn-sm" data-bind="click: addMaterialUsage">
                            <i class="bi bi-plus me-1"></i>Malzeme Ekle
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bind="click: markNoMaterialUsed">
                            <i class="bi bi-slash-circle me-1"></i>Malzeme yok
                        </button>
                    </div>

                    <!-- ko if: currentMaterialItem() && currentMaterialItem().materialUsages().length > 0 -->
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Malzeme</th>
                                    <th style="width:110px;">Miktar</th>
                                    <th style="width:110px;">Birim</th>
                                    <th style="width:180px;">Not</th>
                                    <th style="width:42px;"></th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: currentMaterialItem().materialUsages">
                                <tr>
                                    <td>
                                        <select class="form-select form-select-sm"
                                                data-bind="value: productId,
                                                           options: $parent.products,
                                                           optionsText: 'name',
                                                           optionsValue: 'id',
                                                           optionsCaption: 'Malzeme sec...'"></select>
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm text-end" min="0" step="0.01" data-bind="value: quantity" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" data-bind="value: unit" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" data-bind="value: notes" />
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-outline-danger btn-sm px-1 py-0"
                                                data-bind="click: $parent.removeMaterialUsage">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- /ko -->

                    <!-- ko if: currentMaterialItem() && currentMaterialItem().materialUsages().length === 0 -->
                    <div class="text-center text-muted py-4 small">
                        Bu hizmet için malzeme girilmedi.
                    </div>
                    <!-- /ko -->
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-primary btn-sm" data-bs-dismiss="modal">
                        <i class="bi bi-check-lg me-1"></i>Tamam
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Randevu Çek Modal -->
    <!-- ko if: false -->
    <div class="modal fade" id="packageAssignModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title"><i class="bi bi-box-seam me-2"></i><t key="salon.sales.assign_session_package">Seans Paketi Ata</t></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info py-2 small">
                        <t key="salon.sales.package_assign_hint">Paket müşteriye hak olarak atanır. Tahsilat her seans hızlı satış adisyonunda ayrı alınır.</t>
                    </div>
                    <label class="form-label small"><t key="salon.packages.auto.paket">Paket</t></label>
                    <select class="form-select form-select-sm" data-bind="value: assignPackageDefinitionId">
                        <!-- ko foreach: packageDefinitions -->
                        <option data-bind="value: id, text: name + ' - ' + serviceName + ' (' + totalSessions + ' ' + salonT('salon.services.package_sessions', 'seans') + ')'"></option>
                        <!-- /ko -->
                    </select>

                    <!-- ko if: selectedAssignPackageDefinition() -->
                    <div class="border rounded p-2 mt-3 small">
                        <div class="fw-semibold" data-bind="text: selectedAssignPackageDefinition().name"></div>
                        <div class="text-muted" data-bind="text: selectedAssignPackageDefinition().serviceName"></div>
                        <div class="d-flex justify-content-between mt-2">
                            <span><t key="salon.services.package_sessions">Seans</t>: <strong data-bind="text: selectedAssignPackageDefinition().totalSessions"></strong></span>
                            <span><t key="salon.packages.plan_price">Plan fiyatı</t>: <strong data-bind="text: formatMoney(selectedAssignPackageDefinition().price)"></strong></span>
                        </div>
                    </div>
                    <!-- /ko -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">Iptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: confirmPackageAssign, disable: isSaving">
                        <i class="bi bi-check2-circle me-1"></i><t key="salon.sales.assign_package_confirm">Müşteriye Ata</t>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- /ko -->

    <div class="modal fade" id="appointmentModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title"><i class="bi bi-calendar-check me-2"></i><t key="salon.sales.auto.bugunun_randevulari">Bugünün Randevuları</t></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="text-center py-3" data-bind="visible: appointmentsLoading"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                    <div class="text-center py-3 text-muted" data-bind="visible: !appointmentsLoading() && todayAppointments().length === 0"><t key="salon.sales.auto.bugun_randevu_yok">Bugün randevu yok.</t></div>
                    <div class="table-responsive" data-bind="visible: todayAppointments().length > 0">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr><th><t key="salon.reports.hour">Saat</t></th><th><t key="salon.panel.payments.customer">Müşteri</t></th><th><t key="salon.sidebar.staff">Personel</t></th><th><t key="salon.sidebar.services">Hizmetler</t></th><th><t key="salon.appointments.status">Durum</t></th><th></th></tr>
                            </thead>
                            <tbody data-bind="foreach: todayAppointments">
                                <tr>
                                    <td class="fw-medium" data-bind="text: startTimeText"></td>
                                    <td data-bind="text: clientName"></td>
                                    <td class="small" data-bind="text: personnelName || '-'"></td>
                                    <td class="small" data-bind="text: serviceNamesText"></td>
                                    <td>
                                        <span class="badge" data-bind="text: statusId === 1 ? 'Bekliyor' : statusId === 2 ? 'Devam' : statusId === 3 ? salonT('salon.sales.auto.tamamlandi', 'Tamamlandı') : salonT('salon.common.btn.cancel', 'İptal'),
                                            css: statusId === 1 ? 'bg-warning text-dark' : statusId === 2 ? 'bg-primary' : statusId === 3 ? 'bg-success' : 'bg-danger'"></span>
                                        <!-- ko if: $data.isPrepaid -->
                                        <span class="badge bg-info ms-1"><t key="salon.sales.auto.on_odemeli">Ön Ödemeli</t></span>
                                        <!-- /ko -->
                                    </td>
                                    <td>
                                        <!-- ko if: statusId < 3 -->
                                        <button class="btn btn-primary btn-sm py-0" data-bind="click: $parent.selectAppointment">
                                            <i class="bi bi-cart-plus me-1"></i><t key="salon.sales.auto.sepete_al">Sepete Al</t>
                                        </button>
                                        <!-- /ko -->
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
    .service-card:hover { transform: translateY(-2px); transition: .15s; box-shadow: 0 4px 12px rgba(0,0,0,.15) !important; }
    .service-card:active { transform: scale(.97); }
    .service-card { transition: .15s; }
</style>
}

@section Scripts {
    <script src="~/js/Sales.js" asp-append-version="true"></script>
}
