@{
    ViewData["Title"] = "Hizli Satis";
}

<div id="sales-vm">
    <div class="row g-0" style="margin: -1.5rem; min-height: calc(100vh - 60px);">

        <!-- SOL: Kategori + Hizmetler -->
        <div class="col-md-8 p-3" style="background: #f8f9fa;">
            <!-- Recete + Kategori Tablari -->
            <div class="d-flex flex-wrap gap-2 mb-3">
                <!-- ko if: recipes().length > 0 -->
                <button class="btn btn-sm px-3 py-2 d-flex align-items-center gap-2"
                        data-bind="click: toggleRecipes,
                                   css: showRecipes() ? 'btn-warning' : 'btn-outline-warning'">
                    <i class="bi bi-journal-bookmark-fill"></i>
                    <span class="small fw-semibold">Receteler</span>
                </button>
                <!-- /ko -->
            <!-- ko foreach: categories -->
                <button class="btn btn-sm px-3 py-2 d-flex align-items-center gap-2"
                        data-bind="click: $parent.selectCategory,
                                   css: $parent.selectedCategoryId() === id ? 'btn-dark' : 'btn-outline-secondary',
                                   style: { borderColor: color || '#6c757d' }">
                    <i data-bind="attr: { 'class': iconClass || 'bi bi-tag' }, style: { color: $parent.selectedCategoryId() === id ? '#fff' : (color || '#6c757d') }"></i>
                    <span data-bind="text: name" class="small fw-semibold"></span>
                </button>
            <!-- /ko -->
            </div>

            <!-- Recete Grid -->
            <div class="row g-2 mb-3" data-bind="visible: showRecipes(), foreach: recipes">
                <div class="col-6 col-lg-4 col-xl-3">
                    <div class="card border-0 shadow-sm h-100" style="cursor:pointer; border-left: 3px solid #ff9800 !important;"
                         data-bind="click: $parent.addRecipeToCart">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center mb-1">
                                <i class="me-2" data-bind="attr: { 'class': iconClass || 'bi bi-journal-bookmark' }" style="color:#ff9800;"></i>
                                <span class="fw-semibold small" data-bind="text: name"></span>
                            </div>
                            <div class="text-muted" style="font-size:.65rem;" data-bind="text: (description || '')"></div>
                            <div class="mt-1">
                                <span class="fw-bold text-warning" data-bind="text: totalPrice.toLocaleString('tr-TR') + ' TL'"></span>
                                <small class="text-muted ms-1" data-bind="text: totalDurationMinutes + ' dk'"></small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hizmet Grid -->
            <div class="row g-2" data-bind="foreach: filteredServices">
                <div class="col-6 col-lg-4 col-xl-3">
                    <div class="card border-0 shadow-sm h-100 service-card" style="cursor:pointer;"
                         data-bind="click: $parent.addToCart">
                        <div class="card-body p-3 text-center">
                            <div class="fw-semibold small" data-bind="text: name"></div>
                            <div class="text-muted" style="font-size:.7rem;" data-bind="text: durationMinutes + ' dk'"></div>
                            <div class="fw-bold text-primary mt-1" data-bind="text: price.toLocaleString('tr-TR') + ' TL'"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ko if: filteredServices().length === 0 -->
            <div class="text-center text-muted py-5">
                <i class="bi bi-scissors" style="font-size: 3rem; opacity:.3;"></i>
                <p class="mt-2 small">Bir kategori seciniz</p>
            </div>
            <!-- /ko -->
        </div>

        <!-- SAG: Sepet -->
        <div class="col-md-4 d-flex flex-column" style="background: #fff; border-left: 1px solid #dee2e6;">
            <!-- Randevu Çek + Müşteri -->
            <div class="p-2 border-bottom d-flex gap-1">
                <button class="btn btn-outline-info btn-sm flex-fill" data-bind="click: openAppointments">
                    <i class="bi bi-calendar-check me-1"></i>Randevu Çek
                </button>
                <!-- ko if: linkedAppointmentId() -->
                <span class="badge bg-info align-self-center" data-bind="text: 'Randevu #' + linkedAppointmentId()"></span>
                <button class="btn btn-outline-secondary btn-sm py-0" data-bind="click: unlinkAppointment" title="Randevu bağlantısını kaldır"><i class="bi bi-x"></i></button>
                <!-- /ko -->
            </div>

            <!-- Musteri Secimi -->
            <div class="p-3 border-bottom">
                <div class="position-relative" data-bind="with: clientAutocomplete">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input type="text" class="form-control" placeholder="Musteri (opsiyonel)"
                               autocomplete="off"
                               data-bind="value: query, valueUpdate: 'afterkeydown',
                                          event: { focus: onFocus, blur: onBlur, keydown: onKeydown }" />
                        <!-- ko if: selectedName() -->
                        <button class="btn btn-outline-secondary" data-bind="click: clear"><i class="bi bi-x"></i></button>
                        <!-- /ko -->
                    </div>
                    <div class="dropdown-menu w-100 shadow-sm" style="max-height:200px;overflow-y:auto;" data-bind="css: { show: showDropdown }">
                        <!-- ko foreach: filteredItems -->
                        <a class="dropdown-item small py-1 px-2" href="#"
                           data-bind="text: $parent.getDisplayText($data), click: $parent.select,
                                      css: { active: $parent.highlightIndex() === $index() },
                                      event: { mousedown: function(){ $parent.select($data); } }"></a>
                        <!-- /ko -->
                    </div>
                </div>
            </div>

            <!-- Sepet Kalemleri -->
            <div class="flex-grow-1 overflow-auto p-3">
                <div data-bind="foreach: cartItems">
                    <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                        <div class="flex-grow-1">
                            <div class="small fw-semibold" data-bind="text: name"></div>
                            <div class="text-muted" style="font-size:.7rem;">
                                <span data-bind="text: quantity() + ' x ' + unitPrice.toLocaleString('tr-TR') + ' TL'"></span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <button class="btn btn-outline-secondary btn-sm px-1 py-0" data-bind="click: $parent.decreaseQty" style="font-size:.7rem;">
                                <i class="bi bi-dash"></i>
                            </button>
                            <span class="badge bg-secondary" data-bind="text: quantity()" style="min-width:24px;"></span>
                            <button class="btn btn-outline-secondary btn-sm px-1 py-0" data-bind="click: $parent.increaseQty" style="font-size:.7rem;">
                                <i class="bi bi-plus"></i>
                            </button>
                            <span class="fw-bold small ms-2" style="min-width:60px; text-align:right;"
                                  data-bind="text: (quantity() * unitPrice).toLocaleString('tr-TR') + ' TL'"></span>
                            <button class="btn btn-outline-danger btn-sm px-1 py-0 ms-1" data-bind="click: $parent.removeFromCart" style="font-size:.7rem;">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ko if: cartItems().length === 0 -->
                <div class="text-center text-muted py-4">
                    <i class="bi bi-cart3" style="font-size: 2rem; opacity:.3;"></i>
                    <p class="mt-2 small">Sepet bos</p>
                </div>
                <!-- /ko -->
            </div>

            <!-- Personel + Odeme -->
            <div class="p-3 border-top" data-bind="visible: cartItems().length > 0">
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <select class="form-select form-select-sm" data-bind="value: selectedPersonnelId,
                            options: staffList, optionsText: 'fullName', optionsValue: 'id', optionsCaption: 'Personel'"></select>
                    </div>
                    <div class="col-6">
                        <select class="form-select form-select-sm" data-bind="value: paymentMethodId">
                            <option value="1">Nakit</option>
                            <option value="2">Kredi Karti</option>
                            <option value="3">Karma</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Toplam + Ode -->
            <div class="p-3 border-top" style="background: #f8f9fa;" data-bind="visible: cartItems().length > 0">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small">Ara Toplam</span>
                    <span class="fw-bold" data-bind="text: subtotal().toLocaleString('tr-TR') + ' TL'"></span>
                </div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="text-muted small">Indirim</span>
                    <div class="input-group input-group-sm" style="max-width:110px;">
                        <input type="number" class="form-control text-end" data-bind="value: discountAmount" min="0" step="1" />
                        <span class="input-group-text">TL</span>
                    </div>
                    <span class="text-muted small ms-2">Bahsis</span>
                    <div class="input-group input-group-sm" style="max-width:110px;">
                        <input type="number" class="form-control text-end" data-bind="value: tipAmount" min="0" step="1" />
                        <span class="input-group-text">TL</span>
                    </div>
                </div>
                <div class="d-flex justify-content-end mb-3">
                    <span class="fw-bold fs-5 text-success" data-bind="text: grandTotal().toLocaleString('tr-TR') + ' TL'"></span>
                </div>
                <button class="btn btn-success w-100 py-2" data-bind="click: checkout, disable: isSaving">
                    <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                    <i class="bi bi-check-circle me-1" data-bind="visible: !isSaving()"></i>
                    <span class="fw-bold">Odeme Al</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Randevu Çek Modal -->
    <div class="modal fade" id="appointmentModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title"><i class="bi bi-calendar-check me-2"></i>Bugünün Randevuları</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="text-center py-3" data-bind="visible: appointmentsLoading"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                    <div class="text-center py-3 text-muted" data-bind="visible: !appointmentsLoading() && todayAppointments().length === 0">Bugün randevu yok.</div>
                    <div class="table-responsive" data-bind="visible: todayAppointments().length > 0">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr><th>Saat</th><th>Müşteri</th><th>Personel</th><th>Hizmetler</th><th>Durum</th><th></th></tr>
                            </thead>
                            <tbody data-bind="foreach: todayAppointments">
                                <tr>
                                    <td class="fw-medium" data-bind="text: startTimeText"></td>
                                    <td data-bind="text: clientName"></td>
                                    <td class="small" data-bind="text: personnelName || '-'"></td>
                                    <td class="small" data-bind="text: serviceNamesText"></td>
                                    <td>
                                        <span class="badge" data-bind="text: statusId === 1 ? 'Bekliyor' : statusId === 2 ? 'Devam' : statusId === 3 ? 'Tamamlandı' : 'İptal',
                                            css: statusId === 1 ? 'bg-warning text-dark' : statusId === 2 ? 'bg-primary' : statusId === 3 ? 'bg-success' : 'bg-danger'"></span>
                                    </td>
                                    <td>
                                        <!-- ko if: statusId < 3 -->
                                        <button class="btn btn-primary btn-sm py-0" data-bind="click: $parent.selectAppointment">
                                            <i class="bi bi-cart-plus me-1"></i>Sepete Al
                                        </button>
                                        <!-- /ko -->
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
    .service-card:hover { transform: translateY(-2px); transition: .15s; box-shadow: 0 4px 12px rgba(0,0,0,.15) !important; }
    .service-card:active { transform: scale(.97); }
    .service-card { transition: .15s; }
</style>
}

@section Scripts {
    <script src="~/js/Sales.js" asp-append-version="true"></script>
}
