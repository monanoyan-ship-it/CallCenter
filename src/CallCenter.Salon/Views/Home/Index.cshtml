@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.sidebar.dashboard", "Dashboard");
    var dashboardJwt = CallCenter.Shared.Auth.JwtIdentityExtensions.GetJwtIdentity(Context);
    var isSalonOwner = dashboardJwt.CustomerRoleId <= 0
        || dashboardJwt.CustomerRoleId == CallCenter.Shared.Enums.SalonRoles.Ids.SalonOwner;
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-purple bg-opacity-10 p-3 me-3">
                        <i class="bi bi-people-fill text-purple fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small"><t key="salon.dashboard.total_clients">Toplam Müşteri</t></div>
                        <div class="fw-bold fs-5" id="totalClients">-</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                        <i class="bi bi-calendar-check text-success fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small"><t key="salon.dashboard.today_appointments">Bugünün Randevuları</t></div>
                        <div class="fw-bold fs-5" id="todayAppointments">-</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                        <i class="bi bi-cash-stack text-warning fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small"><t key="salon.dashboard.today_revenue">Bugünün Cirosu</t></div>
                        <div class="fw-bold fs-5" id="todayRevenue">-</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">
                        <i class="bi bi-person-badge text-info fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small"><t key="salon.dashboard.active_staff">Aktif Personel</t></div>
                        <div class="fw-bold fs-5" id="activeStaff">-</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 fw-semibold">
                <i class="bi bi-calendar-check me-2"></i><t key="salon.dashboard.today_appointments">Bugünün Randevuları</t>
            </div>
            <div class="card-body" id="todayApptList">
                <p class="text-muted small mb-0"><t key="salon.common.loading">Yükleniyor...</t></p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <!-- Abonelik kartı -->
        <div class="card border-0 shadow-sm mb-3" id="subscriptionCard" style="display:none;">
            <div class="card-header bg-white border-0 fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-credit-card-2-front me-2 text-purple"></i><t key="salon.dashboard.subscription">Aboneliğim</t></span>
                <span class="badge" id="subStatusBadge"></span>
            </div>
            <div class="card-body">
                <div class="mb-2 small text-muted"><t key="salon.dashboard.active_packages">Aktif Paketler:</t></div>
                <div id="subPackages" class="d-flex flex-wrap gap-1 mb-2">
                    <span class="badge bg-secondary-subtle text-dark"><t key="salon.modules.base_package">Temel Paket</t></span>
                </div>
                <div class="d-flex justify-content-between align-items-center border-top pt-2">
                    <span class="small text-muted"><t key="salon.dashboard.monthly_total">Aylık Toplam</t></span>
                    <span class="fw-bold text-purple" id="subMonthlyTotal">-</span>
                </div>
                <div class="small text-muted text-end mt-1" id="subBranchInfo" style="display:none;"></div>
                <div class="d-flex justify-content-between align-items-center mt-1">
                    <span class="small text-muted"><t key="salon.modules.next_billing">Sonraki Tahakkuk</t></span>
                    <span class="small" id="subNextBilling">-</span>
                </div>
                @if (isSalonOwner)
                {
                <div class="d-flex gap-2 mt-2">
                    <a href="/Modules" class="btn btn-sm btn-outline-purple flex-fill" style="border-color:#7b1fa2;color:#7b1fa2;">
                        <i class="bi bi-puzzle me-1"></i><t key="salon.dashboard.manage_modules">Modülleri Yönet</t>
                    </a>
                    <a id="subPaymentBtn" href="/Modules?pay=subscription" class="btn btn-sm btn-purple flex-fill" style="background:#7b1fa2;border-color:#7b1fa2;color:#fff;display:none;">
                        <i class="bi bi-credit-card me-1"></i><t key="salon.dashboard.pay">Ödeme Yap</t>
                    </a>
                </div>
                <div class="small text-muted mt-2" id="subPaymentInfo" style="display:none;"></div>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-0 fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-exclamation-triangle me-2 text-danger"></i><t key="salon.dashboard.critical_stock">Kritik Stok</t></span>
                <span class="badge bg-danger" id="lowStockCount">0</span>
            </div>
            <div class="card-body" id="lowStockList">
                <p class="text-muted small mb-0"><t key="salon.common.loading">Yükleniyor...</t></p>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 fw-semibold">
                <i class="bi bi-bell me-2"></i><t key="salon.dashboard.reminders">Hatırlatmalar</t>
            </div>
            <div class="card-body" id="reminderList">
                <p class="text-muted small mb-0"><t key="salon.common.loading">Yükleniyor...</t></p>
            </div>
        </div>
    </div>
</div>

<style>
    .text-purple { color: #7b1fa2 !important; }
    .bg-purple { background-color: #7b1fa2 !important; }
    .bg-purple-subtle { background-color: rgba(123,31,162,0.12) !important; }
</style>

@section Scripts {
    <script src="~/js/SlnDashboard.js" asp-append-version="true"></script>
}
