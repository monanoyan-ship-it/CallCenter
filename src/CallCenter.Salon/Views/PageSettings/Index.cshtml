@{
    ViewData["Title"] = "Sayfa Ayarlari";
}

<div id="pagesettings-vm">
    <div class="text-center py-3" data-bind="visible: isLoading">
        <div class="spinner-border spinner-border-sm text-primary"></div>
    </div>

    <div data-bind="visible: !isLoading()">
        <!-- ko if: !profileExists() -->
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Once <a href="/Profile">Salon Profili</a> sayfasindan profil olusturun.
        </div>
        <!-- /ko -->

        <!-- ko if: profileExists() -->
        <!-- Onizleme Linki -->
        <div class="alert alert-info py-2 d-flex justify-content-between align-items-center">
            <small>
                <i class="bi bi-globe me-1"></i>Public sayfa:
                <a data-bind="attr: { href: '/salon/' + slug() }, text: '/salon/' + slug()" target="_blank" class="fw-semibold"></a>
            </small>
            <span class="badge" data-bind="text: isPublished() ? 'Yayinda' : 'Taslak', css: isPublished() ? 'bg-success' : 'bg-secondary'"></span>
        </div>

        <!-- Bolum Toggle'lari -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white py-2">
                <h6 class="mb-0 small"><i class="bi bi-layout-text-sidebar me-1"></i>Sayfa Bolumleri</h6>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">Public sayfanizda hangi bolumlerin gorunecegini secin. Siralamak icin surukleyin.</p>

                <div id="sectionList" class="list-group">
                    <!-- ko foreach: sections -->
                    <div class="list-group-item d-flex justify-content-between align-items-center py-2" data-bind="attr: { 'data-key': key }">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-grip-vertical me-2 text-muted" style="cursor:grab;"></i>
                            <i class="me-2" data-bind="attr: { 'class': icon }"></i>
                            <span class="small fw-medium" data-bind="text: label"></span>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" data-bind="checked: enabled" />
                        </div>
                    </div>
                    <!-- /ko -->
                </div>
            </div>
        </div>

        <!-- Kaydet -->
        <button class="btn btn-primary w-100" data-bind="click: save, disable: isSaving">
            <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
            <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
        </button>
        <!-- /ko -->
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>
    <script src="~/js/PageSettings.js" asp-append-version="true"></script>
}
