@inject CallCenter.Shared.Services.ITranslationService Translation

<div id="emailcampaigns-vm">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0"><t key="salon.emailcampaigns.auto.e_posta_kampanyalari">E-posta Kampanyaları</t></h6>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i><t key="salon.emailcampaigns.auto.yeni_kampanya"><t key="salon.emailcampaigns.auto.yeni_kampanya">Yeni Kampanya</t></t>
        </button>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th><t key="salon.emailcampaigns.auto.konu">Konu</t></th>
                            <th><t key="salon.appointments.status">Durum</t></th>
                            <th><t key="salon.emailcampaigns.auto.alici">Alıcı</t></th>
                            <th><t key="salon.emailcampaigns.auto.gonderilen">Gönderilen</t></th>
                            <th><t key="salon.emailcampaigns.auto.acilma">Açılma</t></th>
                            <th><t key="salon.emailcampaigns.auto.tiklama">Tıklama</t></th>
                            <th><t key="salon.emailcampaigns.auto.zamanlama">Zamanlama</t></th>
                            <th style="width:120px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: campaigns">
                        <tr>
                            <td class="fw-semibold small" data-bind="text: subject"></td>
                            <td class="small">
                                <span class="badge" data-bind="text: $parent.statusText(statusId), css: $parent.statusBadge(statusId)"></span>
                            </td>
                            <td class="small" data-bind="text: totalRecipients"></td>
                            <td class="small" data-bind="text: sentCount"></td>
                            <td class="small" data-bind="text: openCount"></td>
                            <td class="small" data-bind="text: clickCount"></td>
                            <td class="small" data-bind="text: scheduledAt ? new Date(scheduledAt).toLocaleDateString(document.documentElement.lang || undefined) : '-'"></td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <!-- ko if: statusId < 3 -->
                                    <button class="btn btn-outline-primary" title="@(Translation.T("salon.common.btn.edit_tooltip", "Düzenle"))" data-bind="click: $parent.openEdit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <!-- /ko -->
                                    <!-- ko if: statusId <= 2 -->
                                    <button class="btn btn-outline-success" title="@(Translation.T("salon.emailcampaigns.auto.gonder", "Gonder"))" data-bind="click: $parent.send">
                                        <i class="bi bi-send"></i>
                                    </button>
                                    <!-- /ko -->
                                    <button class="btn btn-outline-danger" title="@(Translation.T("salon.common.btn.delete_tooltip", "Sil"))" data-bind="click: $parent.remove">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: campaigns().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-envelope" style="font-size:2rem;"></i>
                <p class="mt-2 small"><t key="salon.emailcampaigns.auto.henuz_e_posta_kampanyasi_olusturulmamis">Henüz e-posta kampanyası oluşturulmamış</t></p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Kampanya Modal -->
    <div class="modal fade" id="emailCampaignModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditing() ? salonT('salon.emailcampaigns.auto.kampanya_duzenle', 'Kampanya Düzenle') : salonT('salon.emailcampaigns.auto.yeni_e_posta_kampanyasi', 'Yeni E-posta Kampanyası')"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.emailcampaigns.auto.konu_required">Konu *</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="textInput: form.subject" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.common.branch_target">Şube hedefi *</t></label>
                            <select class="form-select form-select-sm"
                                    data-bind="options: branchTargetOptions,
                                               optionsText: 'name',
                                               optionsValue: 'id',
                                               value: form.branchTarget,
                                               optionsCaption: salonT('salon.common.select_branch_or_all', 'Şube seçin veya Tüm Şubeler')"></select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.emailcampaigns.auto.html_icerik_required">HTML İçerik *</t></label>
                            <textarea class="form-control form-control-sm" rows="8" data-bind="textInput: form.htmlBody"></textarea>
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.emailcampaigns.auto.segment_filtresi_json">Müşteri Filtresi (JSON)</t></label>
                            <input type="text" class="form-control form-control-sm" placeholder='{"genderId":1}' data-bind="textInput: form.segmentFilter" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small"><t key="salon.emailcampaigns.auto.zamanlama_bos_taslak">Zamanlama (boş = taslak)</t></label>
                            <input type="datetime-local" class="form-control form-control-sm" data-bind="textInput: form.scheduledAt" />
                        </div>
                        <div class="col-3 d-flex align-items-end">
                            <button type="button" class="btn btn-outline-info btn-sm" data-bind="click: previewSegment">
                                <i class="bi bi-eye me-1"></i><t key="salon.emailcampaigns.auto.onizle">Önizle</t>
                            </button>
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.emailcampaigns.auto.hazir_segmentler">Hazır Müşteri Grupları</t></label>
                            <div class="d-flex flex-wrap gap-2" data-bind="foreach: segmentPresets">
                                <button type="button" class="btn btn-outline-secondary btn-sm text-start" data-bind="click: $parent.applySegmentPreset, attr: { title: description }">
                                    <span class="fw-semibold" data-bind="text: name"></span>
                                    <span class="badge bg-light text-dark ms-1" data-bind="text: emailReachableClients + '/' + matchingClients"></span>
                                </button>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="d-flex flex-wrap gap-2 small text-muted">
                                <span><t key="salon.emailcampaigns.auto.hedef">Hedef:</t> <strong data-bind="text: segmentPreviewCount"></strong></span>
                                <span><t key="salon.emailcampaigns.auto.e_posta_uygun">E-posta uygun:</t> <strong data-bind="text: segmentEmailReachableCount"></strong></span>
                                <span><t key="salon.emailcampaigns.auto.e_posta_eksik">E-posta eksik:</t> <strong data-bind="text: segmentMissingEmailCount"></strong></span>
                                <span><t key="salon.emailcampaigns.auto.gonderim_disi">Gönderim dışı:</t> <strong data-bind="text: segmentExcludedCount"></strong></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i><t key="salon.common.btn.save"><t key="salon.common.btn.save">Kaydet</t></t>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
