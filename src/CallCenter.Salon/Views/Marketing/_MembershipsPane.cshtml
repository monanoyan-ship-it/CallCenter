@inject CallCenter.Shared.Services.ITranslationService Translation

<div id="memberships-vm">
    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-plans"><i class="bi bi-card-list me-1"></i><t key="salon.memberships.tabs.plans">Planlar</t></button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-members"><i class="bi bi-people me-1"></i><t key="salon.memberships.tabs.members">Üyeler</t></button></li>
    </ul>

    <div class="tab-content">
        <!-- Planlar -->
        <div class="tab-pane fade show active" id="tab-plans">
            <div class="d-flex justify-content-end mb-3">
                <button class="btn btn-primary btn-sm" data-bind="click: openNewPlan"><i class="bi bi-plus-lg me-1"></i><t key="salon.memberships.new_plan">Yeni Plan</t></button>
            </div>
            <div class="row g-3" data-bind="foreach: plans">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100" data-bind="style: { borderTop: '3px solid ' + (color || '#7b1fa2') }">
                        <div class="card-body text-center">
                            <i class="fs-2" data-bind="attr: { 'class': iconClass || 'bi bi-award' }, style: { color: color || '#7b1fa2' }"></i>
                            <h5 class="mt-2 mb-1" data-bind="text: name"></h5>
                            <p class="small text-muted" data-bind="text: description || ''"></p>
                            <div class="fs-4 fw-bold" data-bind="text: ($data.price || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></div>
                            <small class="text-muted" data-bind="text: $data.durationType === 1 ? ($data.durationDays + ' ' + salonT('salon.memberships.days', 'Gün')) : salonT('salon.memberships.usage_based', 'Kullanımlık')"></small>
                            <hr />
                            <div class="small text-start">
                                <div><i class="bi bi-check-circle text-success me-1"></i>%<span data-bind="text: discountPercent"></span> <t key="salon.profile.membership.discount_suffix">indirim</t></div>
                                <!-- ko if: priorityBooking -->
                                <div><i class="bi bi-check-circle text-success me-1"></i><t key="salon.memberships.priority_booking">Öncelikli randevu</t></div>
                                <!-- /ko -->
                                <!-- ko if: serviceDetails && serviceDetails.length > 0 -->
                                <hr class="my-2" />
                                <div class="text-muted" style="font-size:.75rem;"><i class="bi bi-list-check me-1"></i><t key="salon.memberships.included_services">Dahil Hizmetler:</t></div>
                                <!-- ko foreach: serviceDetails -->
                                <div style="font-size:.8rem;">
                                    <i class="bi bi-dot text-primary"></i><span data-bind="text: serviceName"></span>
                                    <!-- ko if: $data.freeCount > 0 -->
                                    <span class="badge bg-success ms-1" style="font-size:.6rem;" data-bind="text: $parent.durationType === 1 ? ($data.freeCount + 'x/' + salonT('salon.memberships.period', 'dönem')) : ($data.freeCount + ' ' + salonT('salon.memberships.right', 'hak'))"></span>
                                    <!-- /ko -->
                                    <!-- ko if: discountPercent > 0 && ($data.freeCount || 0) === 0 -->
                                    <span class="badge bg-warning text-dark ms-1" style="font-size:.6rem;" data-bind="text: '%' + discountPercent + ' ' + salonT('salon.profile.membership.discount_suffix', 'indirim')"></span>
                                    <!-- /ko -->
                                </div>
                                <!-- /ko -->
                                <!-- /ko -->
                            </div>
                            <div class="mt-2">
                                <span class="badge bg-info" data-bind="text: activeMembers + ' ' + salonT('salon.memberships.member_suffix', 'üye')"></span>
                            </div>
                            <div class="mt-2 btn-group btn-group-sm">
                                <button class="btn btn-outline-success" data-bind="click: $parent.openNewMember" title="@(Translation.T("salon.memberships.make_member", "Üye Yap"))"><i class="bi bi-person-plus"></i></button>
                                <button class="btn btn-outline-secondary" data-bind="click: $parent.openEditPlan"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-outline-danger" data-bind="click: $parent.removePlan"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- ko if: plans().length === 0 -->
            <div class="text-center text-muted py-5"><i class="bi bi-award" style="font-size:3rem;opacity:.3;"></i><p class="mt-2 small"><t key="salon.memberships.empty_plans">Henüz üyelik planı tanımlanmamış</t></p></div>
            <!-- /ko -->
        </div>

        <!-- Uyeler -->
        <div class="tab-pane fade" id="tab-members">
            <div class="d-flex justify-content-end mb-3">
                <button class="btn btn-success btn-sm" data-bind="click: openNewMember"><i class="bi bi-person-plus me-1"></i><t key="salon.memberships.add_member">Üye Ekle</t></button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm">
                    <thead class="table-light"><tr><th><t key="salon.panel.payments.customer">Müşteri</t></th><th><t key="salon.memberships.plan">Plan</t></th><th><t key="salon.memberships.start">Başlangıç</t></th><th><t key="salon.memberships.end">Bitiş</t></th><th><t key="salon.memberships.period_title">Dönem</t></th><th><t key="salon.panel.payments.status">Durum</t></th><th></th></tr></thead>
                    <tbody data-bind="foreach: memberships">
                        <tr>
                            <td class="small fw-semibold" data-bind="text: clientName"></td>
                            <td><span class="badge" data-bind="text: planName, style: { background: planColor || '#7b1fa2' }"></span></td>
                            <td class="small" data-bind="text: new Date(startDate).toLocaleDateString(document.documentElement.lang || undefined)"></td>
                            <td class="small" data-bind="text: $data.durationType === 1 && $data.endDate ? new Date($data.endDate).toLocaleDateString(document.documentElement.lang || undefined) : salonT('salon.memberships.until_rights_end', 'Hak bitince')"></td>
                            <td class="small" data-bind="text: $data.durationType === 1 && $data.currentPeriodStart && $data.currentPeriodEnd ? (new Date($data.currentPeriodStart).toLocaleDateString(document.documentElement.lang || undefined) + ' - ' + new Date($data.currentPeriodEnd).toLocaleDateString(document.documentElement.lang || undefined)) : '-'"></td>
                            <td>
                                <span class="badge" data-bind="text: statusId === 1 ? salonT('salon.common.status_active', 'Aktif') : statusId === 2 ? salonT('salon.memberships.status.frozen', 'Dondurulmuş') : salonT('salon.panel.cancel.confirm', 'İptal'),
                                    css: statusId === 1 ? 'bg-success' : statusId === 2 ? 'bg-warning text-dark' : 'bg-danger'"></span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <!-- ko if: statusId === 1 -->
                                    <button class="btn btn-outline-warning btn-sm" data-bind="click: $parent.freezeMember" title="@(Translation.T("salon.memberships.freeze", "Dondur"))"><i class="bi bi-pause"></i></button>
                                    <button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.cancelMember" title="@(Translation.T("salon.panel.cancel.confirm", "İptal"))"><i class="bi bi-x"></i></button>
                                    <!-- /ko -->
                                    <!-- ko if: statusId === 2 -->
                                    <button class="btn btn-outline-success btn-sm" data-bind="click: $parent.reactivateMember" title="@(Translation.T("salon.memberships.activate", "Aktif Et"))"><i class="bi bi-play"></i></button>
                                    <!-- /ko -->
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Plan Modal -->
    <div class="modal fade" id="planModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header py-2"><h6 class="modal-title" data-bind="text: isEditingPlan() ? salonT('salon.memberships.edit_plan', 'Plan Düzenle') : salonT('salon.memberships.new_plan', 'Yeni Plan')"></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body p-0">
                    <div class="row g-0">
                        <!-- SOL: Plan bilgileri + Hizmet seçimi -->
                        <div class="col-md-6 p-3 border-end" style="background:#f8f9fa;">
                            <div class="row g-2 mb-3">
                                <div class="col-12">
                                    <label class="form-label small"><t key="salon.common.branch_target">Şube hedefi *</t></label>
                                    <select class="form-select form-select-sm"
                                            data-bind="options: branchTargetOptions,
                                                       optionsText: 'name',
                                                       optionsValue: 'id',
                                                       value: planForm.branchTarget,
                                                       optionsCaption: salonT('salon.common.select_branch_or_all', 'Şube seçin veya Tüm Şubeler')"></select>
                                </div>
                                <div class="col-8"><label class="form-label small"><t key="salon.memberships.plan_name">Plan Adı *</t></label><input type="text" class="form-control form-control-sm" data-bind="textInput: planForm.name" /></div>
                                <div class="col-4"><label class="form-label small"><t key="salon.memberships.color">Renk</t></label><input type="color" class="form-control form-control-sm form-control-color" data-bind="value: planForm.color" /></div>
                                <div class="col-12"><label class="form-label small"><t key="salon.common.description">Açıklama</t></label><input type="text" class="form-control form-control-sm" data-bind="textInput: planForm.description" /></div>
                                <div class="col-4"><label class="form-label small"><t key="salon.memberships.plan_price">Plan Ücreti *</t></label><input type="number" class="form-control form-control-sm" step="1" data-bind="textInput: planForm.price" /></div>
                                <div class="col-4"><label class="form-label small"><t key="salon.memberships.general_discount">Genel İndirim %</t></label><input type="number" class="form-control form-control-sm" min="0" max="100" data-bind="textInput: planForm.discountPercent" /></div>
                                <div class="col-4"><div class="form-check mt-4"><input type="checkbox" class="form-check-input" data-bind="checked: planForm.priorityBooking" /><label class="form-check-label small"><t key="salon.memberships.priority_booking">Öncelikli Randevu</t></label></div></div>
                                <div class="col-12">
                                    <label class="form-label small"><t key="salon.memberships.duration_type">Süre Tipi</t></label>
                                    <div class="btn-group btn-group-sm w-100">
                                        <button type="button" class="btn" data-bind="click: function() { planForm.durationType(1); }, css: planForm.durationType() === 1 ? 'btn-dark' : 'btn-outline-secondary'"><t key="salon.memberships.duration_limited">Süreli</t></button>
                                        <button type="button" class="btn" data-bind="click: function() { planForm.durationType(2); }, css: planForm.durationType() === 2 ? 'btn-dark' : 'btn-outline-secondary'"><t key="salon.memberships.usage_based">Kullanımlık</t></button>
                                    </div>
                                </div>
                                <!-- ko if: planForm.durationType() === 1 -->
                                <div class="col-12">
                                    <label class="form-label small"><t key="salon.memberships.duration">Süre</t></label>
                                    <div class="btn-group btn-group-sm w-100">
                                        <button type="button" class="btn" data-bind="click: function() { planForm.durationDays(30); }, css: planForm.durationDays() === 30 ? 'btn-primary' : 'btn-outline-secondary'">30 <t key="salon.memberships.days">Gün</t></button>
                                        <button type="button" class="btn" data-bind="click: function() { planForm.durationDays(90); }, css: planForm.durationDays() === 90 ? 'btn-primary' : 'btn-outline-secondary'">90 <t key="salon.memberships.days">Gün</t></button>
                                        <button type="button" class="btn" data-bind="click: function() { planForm.durationDays(180); }, css: planForm.durationDays() === 180 ? 'btn-primary' : 'btn-outline-secondary'">180 <t key="salon.memberships.days">Gün</t></button>
                                        <button type="button" class="btn" data-bind="click: function() { planForm.durationDays(365); }, css: planForm.durationDays() === 365 ? 'btn-primary' : 'btn-outline-secondary'">365 <t key="salon.memberships.days">Gün</t></button>
                                    </div>
                                </div>
                                <!-- /ko -->
                            </div>
                            <hr class="my-2" />
                            <label class="form-label small fw-bold"><i class="bi bi-list-check me-1"></i><t key="salon.memberships.choose_service">Hizmet Seç (tıkla ekle)</t></label>
                            <div class="d-flex flex-wrap gap-1 mb-2" data-bind="foreach: serviceCategories">
                                <button type="button" class="btn py-1 px-2" style="font-size:.75rem; min-height:28px;"
                                    data-bind="text: name,
                                               click: function() { $root.selectedCategoryId($data.id); },
                                               css: $root.selectedCategoryId() === $data.id ? 'btn-dark' : 'btn-outline-secondary'">
                                </button>
                            </div>
                            <!-- ko if: selectedCategoryServices().length > 0 -->
                            <div class="d-flex flex-wrap gap-1" data-bind="foreach: selectedCategoryServices">
                                <button type="button" class="btn py-1 px-2" style="font-size:.75rem; min-height:28px;"
                                    data-bind="click: function() { $root.togglePlanService($data.id); },
                                               css: $root.planForm.serviceIds().indexOf($data.id) >= 0 ? 'btn-primary' : 'btn-outline-secondary'">
                                    <span data-bind="text: name"></span>
                                </button>
                            </div>
                            <!-- /ko -->
                        </div>

                        <!-- SAĞ: Seçilen hizmetler + haklar -->
                        <div class="col-md-6 p-3">
                            <label class="form-label small fw-bold"><i class="bi bi-card-checklist me-1"></i><t key="salon.memberships.plan_services">Plana Dahil Hizmetler</t></label>
                            <!-- ko if: planServiceDetails().length === 0 -->
                            <div class="text-center text-muted py-4 small"><i class="bi bi-arrow-left me-1"></i><t key="salon.memberships.select_service_left">Soldan hizmet seçin</t></div>
                            <!-- /ko -->
                            <!-- ko if: planServiceDetails().length > 0 -->
                            <div class="table-responsive">
                                <table class="table table-sm mb-0" style="font-size:.8rem;">
                                    <thead class="table-light">
                                        <tr>
                                            <th><t key="salon.book.summary.service">Hizmet</t></th>
                                            <th style="width:100px;" data-bind="text: planForm.durationType() === 1 ? salonT('salon.memberships.per_period', 'Dönem Başına') : salonT('salon.memberships.total_rights', 'Toplam Hak'), attr: { title: planForm.durationType() === 1 ? salonT('salon.memberships.period_reset_hint', 'Her dönem sıfırlanır') : salonT('salon.memberships.ends_when_used_hint', 'Bitince biter') }"></th>
                                            <th style="width:80px;"><t key="salon.memberships.discount_percent">İndirim %</t></th>
                                            <th style="width:25px;"></th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: planServiceDetails">
                                        <tr>
                                            <td class="fw-medium" data-bind="text: name"></td>
                                            <td><input type="number" class="form-control form-control-sm py-0 text-center" min="0" data-bind="textInput: freeCount" /></td>
                                            <td><input type="number" class="form-control form-control-sm py-0 text-center" min="0" max="100" data-bind="textInput: discount" /></td>
                                            <td><i class="bi bi-x-circle text-danger" style="cursor:pointer;" data-bind="click: function() { $root.togglePlanService(serviceId); }"></i></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="mt-2 small text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                <span data-bind="text: planForm.durationType() === 1 ? salonT('salon.memberships.per_period_help', 'Dönem Başına: Her dönemde kaç kez ücretsiz.') : salonT('salon.memberships.total_rights_help', 'Toplam Hak: Toplam kaç kez kullanılabilir.')"></span>
                                <t key="salon.memberships.discount_help">İndirim: 100 = tamamen ücretsiz, 50 = yarı fiyat.</t>
                            </div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button><button type="button" class="btn btn-primary btn-sm" data-bind="click: savePlan, disable: isSaving"><t key="salon.common.btn.save">Kaydet</t></button></div>
            </div>
        </div>
    </div>

    <!-- Uye Ekle Modal -->
    <div class="modal fade" id="memberModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h6 class="modal-title"><t key="salon.memberships.add_member">Üye Ekle</t></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label small"><t key="salon.memberships.plan_required">Plan *</t></label>
                        <select class="form-select form-select-sm" data-bind="value: memberForm.planId, options: plans, optionsText: 'name', optionsValue: 'id', optionsCaption: salonT('salon.memberships.select_plan', 'Plan seçiniz')"></select></div>
                    <div class="mb-3"><label class="form-label small"><t key="salon.memberships.customer_required">Müşteri *</t></label>
                        <div class="position-relative" data-bind="with: clientAutocomplete">
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="@(Translation.T("salon.memberships.customer_placeholder", "Müşteri adı yazın..."))"
                                   autocomplete="off"
                                   data-bind="textInput: query,
                                              event: { focus: onFocus, blur: onBlur, keydown: onKeydown }" />
                            <!-- ko if: selectedName() -->
                            <span class="position-absolute top-50 end-0 translate-middle-y me-2" style="cursor:pointer; z-index:2;"
                                  data-bind="click: clear" title="@(Translation.T("salon.memberships.clear", "Temizle"))">
                                <i class="bi bi-x-circle text-muted"></i>
                            </span>
                            <!-- /ko -->
                            <div class="dropdown-menu w-100 shadow-sm" style="max-height:220px; overflow-y:auto;"
                                 data-bind="css: { show: showDropdown }">
                                <!-- ko foreach: filteredItems -->
                                <a class="dropdown-item small py-1 px-2" href="#"
                                   data-bind="text: $parent.getDisplayText($data),
                                              click: $parent.select,
                                              css: { active: $parent.highlightIndex() === $index() },
                                              event: { mousedown: function(){ $parent.select($data); } }"></a>
                                <!-- /ko -->
                                <!-- ko if: filteredItems().length === 0 && query().length > 0 -->
                                <a class="dropdown-item small py-1 px-2 text-primary fw-semibold" href="#"
                                   data-bind="event: { mousedown: function() { $root.showNewClient(query()); } }">
                                    <i class="bi bi-person-plus me-1"></i><t key="salon.memberships.create_new_customer">Yeni müşteri oluştur</t>
                                </a>
                                <!-- /ko -->
                            </div>
                        </div>
                        <!-- Yeni Musteri Inline Form -->
                        <div class="border rounded p-2 mt-1 bg-light" data-bind="visible: newClientVisible" style="display:none;">
                            <div class="row g-1">
                                <div class="col-5">
                                    <input type="text" class="form-control form-control-sm" placeholder="@(Translation.T("salon.book.fullname", "Ad Soyad *"))" data-bind="textInput: newClientForm.fullName" />
                                </div>
                                <div class="col-4">
                                    <div data-bind="phoneInput: newClientForm.phone"></div>
                                </div>
                                <div class="col-3 d-flex gap-1">
                                    <button class="btn btn-primary btn-sm py-0 flex-fill" data-bind="click: saveNewClient, disable: isCreatingClient">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm py-0" data-bind="click: hideNewClient">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button><button type="button" class="btn btn-success btn-sm" data-bind="click: saveMember, disable: isSaving"><t key="salon.memberships.make_member">Üye Yap</t></button></div>
            </div>
        </div>
    </div>
</div>
