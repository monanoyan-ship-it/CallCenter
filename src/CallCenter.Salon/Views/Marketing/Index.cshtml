@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.modules.package.salon_crm", "Salon CRM");
    var activeTab = (ViewData["MarketingTab"] as string) ?? "campaigns";
    var visibleTabs = new HashSet<string>(
        (ViewData["MarketingTabs"] as System.Collections.Generic.IEnumerable<string>) ?? new[] { activeTab },
        StringComparer.OrdinalIgnoreCase);
    bool Active(string tab) => string.Equals(activeTab, tab, StringComparison.OrdinalIgnoreCase);
    bool Show(string tab) => visibleTabs.Contains(tab);
}

<h5 class="mb-3"><t key="salon.modules.package.salon_crm">Salon CRM</t></h5>

<div class="row g-2 mb-3">
    @if (Show("campaigns") || Show("email") || Show("winback"))
    {
        <div class="col-lg-4">
            <div class="border rounded bg-white p-3 h-100">
                <div class="fw-semibold small mb-1"><i class="bi bi-send me-1"></i><t key="salon.marketing.intent.reach">Müşteriye ulaş</t></div>
                <div class="text-muted small mb-2"><t key="salon.marketing.intent.reach_desc">SMS, e-posta ve eski müşterileri yeniden davet etme araçları.</t></div>
                <div class="d-flex flex-wrap gap-2">
                    @if (Show("campaigns"))
                    {
                        <button class="btn btn-outline-secondary btn-sm" data-marketing-tab="campaigns" type="button"><t key="salon.sidebar.campaigns">Kampanyalar</t></button>
                    }
                    @if (Show("email"))
                    {
                        <button class="btn btn-outline-secondary btn-sm" data-marketing-tab="email" type="button"><t key="salon.sidebar.email_campaigns">E-posta</t></button>
                    }
                    @if (Show("winback"))
                    {
                        <button class="btn btn-outline-secondary btn-sm" data-marketing-tab="winback" type="button"><t key="salon.sidebar.winback">Geri Kazanım</t></button>
                    }
                </div>
            </div>
        </div>
    }
    @if (Show("memberships") || Show("giftcards"))
    {
        <div class="col-lg-4">
            <div class="border rounded bg-white p-3 h-100">
                <div class="fw-semibold small mb-1"><i class="bi bi-stars me-1"></i><t key="salon.marketing.intent.loyalty">Sadakat ve üyelik</t></div>
                <div class="text-muted small mb-2"><t key="salon.marketing.intent.loyalty_desc">Üyelik ve hediye kartlarını takip edin.</t></div>
                <div class="d-flex flex-wrap gap-2">
                    @if (Show("memberships"))
                    {
                        <button class="btn btn-outline-secondary btn-sm" data-marketing-tab="memberships" type="button"><t key="salon.sidebar.memberships">Üyelik</t></button>
                    }
                    @if (Show("giftcards"))
                    {
                        <button class="btn btn-outline-secondary btn-sm" data-marketing-tab="giftcards" type="button"><t key="salon.sidebar.gift_cards">Hediye Kartı</t></button>
                    }
                </div>
            </div>
        </div>
    }
    @if (Show("reviews"))
    {
        <div class="col-lg-4">
            <div class="border rounded bg-white p-3 h-100">
                <div class="fw-semibold small mb-1"><i class="bi bi-chat-square-heart me-1"></i><t key="salon.marketing.intent.reputation">Yorumlar</t></div>
                <div class="text-muted small mb-2"><t key="salon.marketing.intent.reputation_desc">Müşteri yorumlarını ve geri bildirimleri takip edin.</t></div>
                <button class="btn btn-outline-secondary btn-sm" data-marketing-tab="reviews" type="button"><t key="salon.sidebar.reviews">Yorumlar</t></button>
            </div>
        </div>
    }
</div>

<ul class="nav nav-pills flex-wrap gap-2 mb-3" role="tablist">
    @if (Show("campaigns"))
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Active("campaigns") ? "active" : "")" data-bs-toggle="pill" data-bs-target="#marketing-campaigns" type="button" role="tab">
                <i class="bi bi-megaphone me-1"></i><t key="salon.sidebar.campaigns">Kampanyalar</t>
            </button>
        </li>
    }
    @if (Show("email"))
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Active("email") ? "active" : "")" data-bs-toggle="pill" data-bs-target="#marketing-email" type="button" role="tab">
                <i class="bi bi-envelope me-1"></i><t key="salon.sidebar.email_campaigns">E-posta Kampanyalari</t>
            </button>
        </li>
    }
    @if (Show("winback"))
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Active("winback") ? "active" : "")" data-bs-toggle="pill" data-bs-target="#marketing-winback" type="button" role="tab">
                <i class="bi bi-arrow-repeat me-1"></i><t key="salon.sidebar.winback">Geri Kazanım</t>
            </button>
        </li>
    }
    @if (Show("memberships"))
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Active("memberships") ? "active" : "")" data-bs-toggle="pill" data-bs-target="#marketing-memberships" type="button" role="tab">
                <i class="bi bi-award me-1"></i><t key="salon.sidebar.memberships">Uyelik Planlari</t>
            </button>
        </li>
    }
    @if (Show("giftcards"))
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Active("giftcards") ? "active" : "")" data-bs-toggle="pill" data-bs-target="#marketing-giftcards" type="button" role="tab">
                <i class="bi bi-gift me-1"></i><t key="salon.sidebar.gift_cards">Hediye Kartlari</t>
            </button>
        </li>
    }
    @if (Show("reviews"))
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Active("reviews") ? "active" : "")" data-bs-toggle="pill" data-bs-target="#marketing-reviews" type="button" role="tab">
                <i class="bi bi-chat-square-text me-1"></i><t key="salon.sidebar.reviews">Yorumlar</t>
            </button>
        </li>
    }
</ul>

<div class="tab-content">
    @if (Show("campaigns"))
    {
        <div class="tab-pane fade @(Active("campaigns") ? "show active" : "")" id="marketing-campaigns" role="tabpanel">
            @await Html.PartialAsync("_CampaignsPane")
        </div>
    }
    @if (Show("email"))
    {
        <div class="tab-pane fade @(Active("email") ? "show active" : "")" id="marketing-email" role="tabpanel">
            @await Html.PartialAsync("_EmailCampaignsPane")
        </div>
    }
    @if (Show("winback"))
    {
        <div class="tab-pane fade @(Active("winback") ? "show active" : "")" id="marketing-winback" role="tabpanel">
            @await Html.PartialAsync("_WinbackPane")
        </div>
    }
    @if (Show("memberships"))
    {
        <div class="tab-pane fade @(Active("memberships") ? "show active" : "")" id="marketing-memberships" role="tabpanel">
            @await Html.PartialAsync("_MembershipsPane")
        </div>
    }
    @if (Show("giftcards"))
    {
        <div class="tab-pane fade @(Active("giftcards") ? "show active" : "")" id="marketing-giftcards" role="tabpanel">
            @await Html.PartialAsync("_GiftCardsPane")
        </div>
    }
    @if (Show("reviews"))
    {
        <div class="tab-pane fade @(Active("reviews") ? "show active" : "")" id="marketing-reviews" role="tabpanel">
            @await Html.PartialAsync("_ReviewsPane")
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/Marketing.js" asp-append-version="true"></script>
    @if (Show("campaigns"))
    {
        <script src="~/js/Campaigns.js" asp-append-version="true"></script>
    }
    @if (Show("email"))
    {
        <script src="~/js/EmailCampaigns.js" asp-append-version="true"></script>
    }
    @if (Show("winback"))
    {
        <script src="~/js/Winback.js" asp-append-version="true"></script>
    }
    @if (Show("memberships"))
    {
        <script src="~/js/Memberships.js" asp-append-version="true"></script>
    }
    @if (Show("giftcards"))
    {
        <script src="~/js/GiftCards.js" asp-append-version="true"></script>
    }
    @if (Show("reviews"))
    {
        <script src="~/js/Reviews.js" asp-append-version="true"></script>
    }
}
