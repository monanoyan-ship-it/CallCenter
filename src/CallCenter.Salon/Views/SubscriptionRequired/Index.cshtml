@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.subscription_required.title", "Abonelik Gerekli");
    string T(string key, string fallback) => Translation.T(key, fallback);
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center p-5">
                    <i class="bi bi-lock-fill text-warning" style="font-size:3rem;"></i>
                    <h4 class="mt-3">@T("salon.subscription_required.heading", "Salon erişimi kısıtlandı")</h4>
                    <p class="text-muted mb-3 text-start small">
                        @T("salon.subscription_required.service_packages_grace_info", "Son ödeme tarihi henüz gelmediyse panel tam kilitlenmez; üstteki bilgilendirme süresi içinde çalışmaya devam edebilirsiniz. Ödenmemiş platform tahakkuku için Hizmet Paketleri sayfasından kredi kartı ile tahakkuk ödemesi yapabilirsiniz (Iyzico).")
                    </p>
                    <p class="text-muted mb-3 text-start small">
                        @T("salon.subscription_required.reason", "Panel erişimi deneme süresi sonu veya ödeme süresi dolmuş ödenmemiş platform tahakkuku nedeniyle kapatılmış olabilir.")
                    </p>
                    <p class="text-muted mb-3 text-start small">
                        @T("salon.subscription_required.new_registration", "Yeni kayıt: İlk platform faturası genelde deneme süresi sonunda oluşur; bu aşamada birkaç dakika sonra oturumu yenileyin. Sorun sürerse destek ile iletişime geçin.")
                    </p>
                    <p class="text-muted mb-4 text-start small">
                        @T("salon.subscription_required.invoice_note", "Salon adisyonları müşteri faturalarıdır ve panel açıldığında Adisyonlar menüsündedir; bunlar platform tahakkukundan farklıdır.")
                    </p>
                    <div class="d-grid gap-2">
                        <a href="/Modules" class="btn btn-primary">
                            <i class="bi bi-puzzle me-1"></i>@T("salon.subscription_required.service_packages_payment", "Hizmet Paketleri - tahakkuk KK ödemesi")
                        </a>
                        <a href="/Home/Index" class="btn btn-outline-secondary">
                            <i class="bi bi-house me-1"></i>@T("salon.sidebar.dashboard", "Ana sayfa")
                        </a>
                        <form method="post" action="/Account/Logout" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-link text-muted">@T("salon.subscription_required.logout", "Çıkış yap")</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="text-center mt-3">
                <small class="text-muted">
                    @T("salon.subscription_required.refresh_hint", "Ödeme veya abonelik güncellendiyse oturumu yenileyin.")
                </small>
            </div>
        </div>
    </div>
</div>
