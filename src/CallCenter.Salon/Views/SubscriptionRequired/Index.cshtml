@{
    ViewData["Title"] = "Abonelik Gerekli";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center p-5">
                    <i class="bi bi-lock-fill text-warning" style="font-size:3rem;"></i>
                    <h4 class="mt-3">Salon erişimi kısıtlandı</h4>
                    <p class="text-muted mb-3 text-start small">
                        <strong>Son ödeme tarihi henüz gelmediyse</strong> panel tam kilitlenmez; üstteki bilgilendirme süresi içinde çalışmaya devam edebilirsiniz.
                        <strong>Ödenmemiş platform tahakkuku</strong> için <strong>Modüller</strong> sayfasından <strong>kredi kartı ile tahakkuk ödemesi</strong> yapabilirsiniz (Iyzico).
                    </p>
                    <p class="text-muted mb-3 text-start small">
                        Panel erişimi deneme süresi sonu veya ödenmemiş <strong>platform tahakkuku</strong> (ödeme süresi dolduktan sonra) nedeniyle kapatılmış olabilir.
                    </p>
                    <p class="text-muted mb-3 text-start small">
                        <strong>Yeni kayıt:</strong> İlk platform faturası genelde deneme süresi sonunda oluşur; bu aşamada birkaç dakika sonra
                        <a href="/Account/RefreshSession">oturumu yenileyin</a>; sorun sürerse destek ile iletişime geçin.
                    </p>
                    <p class="text-muted mb-4 text-start small">
                        <strong>Salon adisyonları</strong> (müşteri faturaları) panel açıldığında <strong>Adisyonlar</strong> menüsündedir;
                        bunlar platform tahakkukundan farklıdır.
                    </p>
                    <div class="d-grid gap-2">
                        <a href="/Modules" class="btn btn-primary">
                            <i class="bi bi-puzzle me-1"></i>Modüller — tahakkuk KK ödemesi
                        </a>
                        <a href="/Home/Index" class="btn btn-outline-secondary">
                            <i class="bi bi-house me-1"></i>Ana sayfa
                        </a>
                        <form method="post" action="/Account/Logout" class="d-inline">
                            <button type="submit" class="btn btn-link text-muted">Çıkış yap</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="text-center mt-3">
                <small class="text-muted">
                    Ödeme veya abonelik güncellendiyse
                    <a href="/Account/RefreshSession">oturumu yenileyin</a>.
                </small>
            </div>
        </div>
    </div>
</div>
