@{
    ViewData["Title"] = "Abonelik Gerekli";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center p-5">
                    <i class="bi bi-lock-fill text-warning" style="font-size:3rem;"></i>
                    <h4 class="mt-3">Aktif Abonelik Gerekli</h4>
                    <p class="text-muted mb-4">
                        Salon panelini kullanabilmek için aktif bir aboneliğiniz olması gerekiyor.
                        Lütfen yönetim ekibi ile iletişime geçiniz veya mevcut faturalarınızı ödeyiniz.
                    </p>
                    <div class="d-grid gap-2">
                        <a href="/Invoices" class="btn btn-primary">
                            <i class="bi bi-receipt me-1"></i>Faturalarımı Gör
                        </a>
                        <a href="/Home/Index" class="btn btn-outline-secondary">
                            <i class="bi bi-house me-1"></i>Ana Sayfa
                        </a>
                        <form method="post" action="/Account/Logout" class="d-inline">
                            <button type="submit" class="btn btn-link text-muted">Çıkış Yap</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="text-center mt-3">
                <small class="text-muted">
                    Abonelik sorununu çözdüyseniz oturumu yenilemek için
                    <a href="/Account/RefreshSession">tıklayın</a>.
                </small>
            </div>
        </div>
    </div>
</div>
