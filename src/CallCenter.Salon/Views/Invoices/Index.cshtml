@{
    ViewData["Title"] = "Adisyonlar";
}

<div id="invoices-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <div class="input-group" style="max-width: 280px;">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="Adisyon veya musteri ara..." data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
            </div>
            <select class="form-select form-select-sm" style="width:140px;" data-bind="value: filterStatus">
                <option value="">Tum Durumlar</option>
                <option value="1">Acik</option>
                <option value="2">Odendi</option>
                <option value="3">Iptal</option>
            </select>
            <input type="date" class="form-control form-control-sm" style="width:150px;" data-bind="value: filterStartDate" />
            <span class="small text-muted">-</span>
            <input type="date" class="form-control form-control-sm" style="width:150px;" data-bind="value: filterEndDate" />
        </div>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i>Yeni Adisyon
        </button>
    </div>

    <!-- Ozet Kartlari -->
    <div class="row g-2 mb-3">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .7rem;">Toplam Adisyon</div>
                    <div class="fw-bold" data-bind="text: summary().totalCount || 0"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .7rem;">Toplam Tutar</div>
                    <div class="fw-bold text-success" data-bind="text: (summary().totalAmount || 0).toLocaleString('tr-TR') + ' TL'"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .7rem;">Acik Adisyon</div>
                    <div class="fw-bold text-warning" data-bind="text: summary().openCount || 0"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .7rem;">Ortalama</div>
                    <div class="fw-bold text-info" data-bind="text: (summary().averageAmount || 0).toLocaleString('tr-TR') + ' TL'"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Adisyon No</th>
                            <th>Tarih</th>
                            <th>Musteri</th>
                            <th>Personel</th>
                            <th>Hizmetler / Urunler</th>
                            <th>Tutar</th>
                            <th>Odeme</th>
                            <th>Durum</th>
                            <th style="width: 80px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredInvoices">
                        <tr>
                            <td class="small fw-semibold" data-bind="text: invoiceNo"></td>
                            <td class="small" data-bind="text: new Date(invoiceDate).toLocaleDateString('tr-TR')"></td>
                            <td class="small" data-bind="text: clientName"></td>
                            <td class="small" data-bind="text: personnelName || '-'"></td>
                            <td class="small text-muted" data-bind="text: itemsSummary || '-'"></td>
                            <td class="small fw-semibold" data-bind="text: (totalAmount || 0).toLocaleString('tr-TR') + ' TL'"></td>
                            <td class="small" data-bind="text: paymentMethodText"></td>
                            <td><span class="badge" data-bind="text: statusText, css: statusCss"></span></td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" title="Detay" data-bind="click: $parent.openDetail">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" title="Iptal" data-bind="click: $parent.cancelInvoice, visible: statusId === 1">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: filteredInvoices().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-receipt" style="font-size: 2rem;"></i>
                <p class="mt-2 small">Adisyon bulunamadi</p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Modal: Yeni Adisyon -->
    <div class="modal fade" id="invoiceModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditing() ? 'Adisyon Detay' : 'Yeni Adisyon'"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small">Musteri *</label>
                            <div class="position-relative" data-bind="with: clientAutocomplete">
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="Musteri yazin..."
                                       autocomplete="off"
                                       data-bind="value: query, valueUpdate: 'afterkeydown',
                                                  event: { focus: onFocus, blur: onBlur, keydown: onKeydown }" />
                                <!-- ko if: selectedName() -->
                                <span class="position-absolute top-50 end-0 translate-middle-y me-2" style="cursor:pointer; z-index:2;"
                                      data-bind="click: clear" title="Temizle">
                                    <i class="bi bi-x-circle text-muted"></i>
                                </span>
                                <!-- /ko -->
                                <div class="dropdown-menu w-100 shadow-sm" style="max-height:220px; overflow-y:auto;"
                                     data-bind="css: { show: showDropdown }">
                                    <!-- ko foreach: filteredItems -->
                                    <a class="dropdown-item small py-1 px-2" href="#"
                                       data-bind="text: $parent.getDisplayText($data), click: $parent.select,
                                                  css: { active: $parent.highlightIndex() === $index() },
                                                  event: { mousedown: function(){ $parent.select($data); } }"></a>
                                    <!-- /ko -->
                                    <!-- ko if: filteredItems().length === 0 && query().length > 0 -->
                                    <span class="dropdown-item-text small text-muted">Sonuc bulunamadi</span>
                                    <!-- /ko -->
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">POS Cihazi</label>
                            <select class="form-select form-select-sm" data-bind="value: form.posDeviceId">
                                <option value="">Secilmedi</option>
                            </select>
                        </div>
                    </div>

                    <!-- Kalemler -->
                    <h6 class="mt-3 mb-2">Kalemler</h6>
                    <div data-bind="foreach: form.items">
                        <div class="row g-2 mb-2 align-items-end">
                            <div class="col-1">
                                <label class="form-label small">Tur</label>
                                <select class="form-select form-select-sm" data-bind="value: type">
                                    <option value="Service">Hizmet</option>
                                    <option value="Product">Urun</option>
                                </select>
                            </div>
                            <div class="col-4">
                                <label class="form-label small">Kalem *</label>
                                <select class="form-select form-select-sm" data-bind="options: type() === 'Service' ? $parent.serviceList() : $parent.productList(), optionsText: 'name', optionsValue: 'id', value: itemId, optionsCaption: 'Seciniz'"></select>
                            </div>
                            <div class="col-2">
                                <label class="form-label small">Adet</label>
                                <input type="number" class="form-control form-control-sm" min="1" data-bind="value: quantity" />
                            </div>
                            <div class="col-2">
                                <label class="form-label small">Fiyat</label>
                                <input type="number" class="form-control form-control-sm" step="0.01" data-bind="value: unitPrice" />
                            </div>
                            <div class="col-2">
                                <label class="form-label small">Toplam</label>
                                <input type="text" class="form-control form-control-sm" readonly data-bind="value: ((parseFloat(quantity()) || 0) * (parseFloat(unitPrice()) || 0)).toLocaleString('tr-TR') + ' TL'" />
                            </div>
                            <div class="col-1">
                                <button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.removeItem" title="Kaldir">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <button class="btn btn-outline-primary btn-sm mt-1" data-bind="click: addItem">
                        <i class="bi bi-plus-lg me-1"></i>Kalem Ekle
                    </button>

                    <hr />
                    <div class="row g-3">
                        <div class="col-4">
                            <label class="form-label small">Indirim (TL)</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" data-bind="value: form.discountAmount" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Odeme Yontemi</label>
                            <select class="form-select form-select-sm" data-bind="value: form.paymentMethodId">
                                <option value="1">Nakit</option>
                                <option value="2">Kredi Karti</option>
                                <option value="3">Karma</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Genel Toplam</label>
                            <div class="form-control form-control-sm bg-light fw-bold" data-bind="text: grandTotal().toLocaleString('tr-TR') + ' TL'"></div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label small">Not</label>
                        <textarea class="form-control form-control-sm" rows="2" data-bind="value: form.notes"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Invoices.js" asp-append-version="true"></script>
}
