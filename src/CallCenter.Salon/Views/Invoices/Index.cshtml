@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.invoices.auto.title", "Adisyonlar");
}

<div id="invoices-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <div class="input-group" style="max-width: 280px;">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="@(Translation.T("salon.invoices.auto.adisyon_veya_musteri_ara", "Adisyon veya müşteri ara..."))" data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
            </div>
            <select class="form-select form-select-sm" style="width:140px;" data-bind="value: filterStatus">
                <option value=""><t key="salon.invoices.auto.tum_durumlar">Tüm Durumlar</t></option>
                <option value="1"><t key="salon.invoices.auto.acik">Açık</t></option>
                <option value="2"><t key="salon.invoices.auto.odendi">Ödendi</t></option>
                <option value="3"><t key="salon.common.btn.cancel">İptal</t></option>
            </select>
            <input type="date" class="form-control form-control-sm" style="width:150px;" data-bind="value: filterStartDate" />
            <span class="small text-muted">-</span>
            <input type="date" class="form-control form-control-sm" style="width:150px;" data-bind="value: filterEndDate" />
        </div>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i><t key="salon.invoices.auto.yeni_adisyon">Yeni Adisyon</t>
        </button>
    </div>

    <!-- Ozet Kartlari -->
    <div class="row g-2 mb-3">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm"><div class="card-body py-2 text-center">
                <div class="text-muted" style="font-size:.7rem;"><t key="salon.invoices.auto.toplam_adisyon">Toplam Adisyon</t></div>
                <div class="fw-bold" data-bind="text: summary().totalCount || 0"></div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm"><div class="card-body py-2 text-center">
                <div class="text-muted" style="font-size:.7rem;"><t key="salon.invoices.auto.toplam_tutar">Toplam Tutar</t></div>
                <div class="fw-bold text-success" data-bind="text: (summary().totalAmount || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm"><div class="card-body py-2 text-center">
                <div class="text-muted" style="font-size:.7rem;"><t key="salon.invoices.auto.acik_adisyon">Açık Adisyon</t></div>
                <div class="fw-bold text-warning" data-bind="text: summary().openCount || 0"></div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm"><div class="card-body py-2 text-center">
                <div class="text-muted" style="font-size:.7rem;"><t key="salon.invoices.auto.ortalama">Ortalama</t></div>
                <div class="fw-bold text-info" data-bind="text: (summary().averageAmount || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></div>
            </div></div>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th><t key="salon.invoices.auto.adisyon_no">Adisyon No</t></th><th><t key="salon.panel.payments.date">Tarih</t></th><th><t key="salon.panel.payments.customer">Müşteri</t></th>
                            <th><t key="salon.invoices.services_products">Hizmetler / Ürünler</t></th><th><t key="salon.panel.payments.amount">Tutar</t></th><th><t key="salon.modules.payment_method">Ödeme</t></th><th><t key="salon.appointments.status">Durum</t></th><th style="width:80px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredInvoices">
                        <tr>
                            <td class="small fw-semibold" data-bind="text: invoiceNo"></td>
                            <td class="small" data-bind="text: new Date(invoiceDate).toLocaleDateString(document.documentElement.lang || undefined)"></td>
                            <td class="small" data-bind="text: clientName"></td>
                            <td class="small text-muted" data-bind="text: itemsSummary || '-'"></td>
                            <td class="small fw-semibold" data-bind="text: (totalAmount || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></td>
                            <td class="small" data-bind="text: paymentMethodText"></td>
                            <td><span class="badge" data-bind="text: statusText, css: statusCss"></span></td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" title="@(Translation.T("salon.common.detail", "Detay"))" data-bind="click: $parent.openDetail"><i class="bi bi-eye"></i></button>
                                    <button class="btn btn-outline-warning" title="@(Translation.T("salon.invoices.auto.title_iade", "İade"))" data-bind="click: $parent.openRefund, visible: statusId === 2"><i class="bi bi-arrow-return-left"></i></button>
                                    <button class="btn btn-outline-danger" title="@(Translation.T("salon.common.btn.cancel", "İptal"))" data-bind="click: $parent.cancelInvoice, visible: statusId === 1"><i class="bi bi-x-lg"></i></button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: filteredInvoices().length === 0 -->
            <div class="text-center text-muted py-4"><i class="bi bi-receipt" style="font-size:2rem;"></i><p class="mt-2 small"><t key="salon.invoices.auto.adisyon_bulunamadi">Adisyon bulunamadı</t></p></div>
            <!-- /ko -->
        </div>
    </div>

    <!-- ═══ Modal: Iade ═══ -->
    <div class="modal fade" id="refundModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning bg-opacity-10">
                    <h6 class="modal-title"><i class="bi bi-arrow-return-left me-2"></i><t key="salon.invoices.auto.iade">İade</t></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- ko if: refundInvoice() -->
                    <div class="alert alert-info py-2 small mb-3">
                        <t key="salon.invoices.auto.adisyon">Adisyon:</t> <strong data-bind="text: refundInvoice().invoiceNo"></strong> |
                        <t key="salon.panel.payments.amount">Tutar</t>: <strong data-bind="text: (refundInvoice().totalAmount || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></strong>
                    </div>
                    <!-- /ko -->
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.invoices.auto.iade_tutari_tl_required">İade Tutarı (TL) *</t></label>
                            <input type="number" class="form-control form-control-sm" step="0.01" data-bind="value: refundForm.amount" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.invoices.auto.iade_yontemi_required">İade Yöntemi *</t></label>
                            <select class="form-select form-select-sm" data-bind="value: refundForm.paymentMethodId">
                                <option value="1"><t key="salon.invoices.auto.nakit">Nakit</t></option>
                                <option value="2"><t key="salon.invoices.auto.kredi_karti">Kredi Kartı</t></option>
                                <option value="4"><t key="salon.invoices.auto.havale">Havale</t></option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.invoices.auto.iade_sebebi_required">İade Sebebi *</t></label>
                            <textarea class="form-control form-control-sm" rows="2" placeholder="@(Translation.T("salon.invoices.auto.placeholder_iade_sebebini_yaziniz", "İade sebebini yazınız..."))" data-bind="value: refundForm.reason"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-warning btn-sm" data-bind="click: saveRefund, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-arrow-return-left me-1" data-bind="visible: !isSaving()"></i><t key="salon.invoices.auto.iade_yap">İade Yap</t>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ Modal: Yeni Adisyon ═══ -->
    <div class="modal fade" id="invoiceModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title" data-bind="text: isEditing() ? 'Adisyon Detay' : salonT('salon.invoices.auto.yeni_adisyon', 'Yeni Adisyon')"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Musteri -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold"><t key="salon.panel.payments.customer">Müşteri</t></label>
                        <div class="position-relative" data-bind="with: clientAutocomplete">
                            <input type="text" class="form-control form-control-sm" placeholder="@(Translation.T("salon.invoices.auto.musteri_adi_yazin", "Müşteri adi yazin..."))" autocomplete="off"
                                   data-bind="value: query, valueUpdate: 'afterkeydown', event: { focus: onFocus, blur: onBlur, keydown: onKeydown }" />
                            <!-- ko if: selectedName() -->
                            <span class="position-absolute top-50 end-0 translate-middle-y me-2" style="cursor:pointer;z-index:2;" data-bind="click: clear"><i class="bi bi-x-circle text-muted"></i></span>
                            <!-- /ko -->
                            <div class="dropdown-menu w-100 shadow-sm" style="max-height:200px;overflow-y:auto;" data-bind="css: { show: showDropdown }">
                                <!-- ko foreach: filteredItems -->
                                <a class="dropdown-item small py-1 px-2" href="#" data-bind="text: $parent.getDisplayText($data), event: { mousedown: function(){ $parent.select($data); } }, css: { active: $parent.highlightIndex() === $index() }"></a>
                                <!-- /ko -->
                                <!-- ko if: filteredItems().length === 0 && query().length > 0 -->
                                <a class="dropdown-item small py-1 px-2 text-primary fw-semibold" href="#" data-bind="event: { mousedown: function() { $root.showNewClient(query()); } }">
                                    <i class="bi bi-person-plus me-1"></i><t key="salon.invoices.auto.yeni_musteri_olustur">Yeni musteri olustur</t>
                                </a>
                                <!-- /ko -->
                            </div>
                        </div>
                        <!-- Yeni Musteri Inline -->
                        <div class="border rounded p-2 mt-1 bg-light" data-bind="visible: newClientVisible" style="display:none;">
                            <div class="row g-1">
                                <div class="col-5"><input type="text" class="form-control form-control-sm" placeholder="Ad Soyad *" data-bind="value: newClientForm.fullName" /></div>
                                <div class="col-4"><div data-bind="phoneInput: newClientForm.phone"></div></div>
                                <div class="col-3 d-flex gap-1">
                                    <button class="btn btn-primary btn-sm py-0 flex-fill" data-bind="click: saveNewClient, disable: isCreatingClient"><i class="bi bi-check-lg"></i></button>
                                    <button class="btn btn-outline-secondary btn-sm py-0" data-bind="click: hideNewClient"><i class="bi bi-x-lg"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Hizmet Sec (tikla ekle) -->
                    <div class="mb-2">
                        <label class="form-label small fw-semibold"><t key="salon.invoices.auto.hizmet_ekle">Hizmet Ekle</t> <small class="text-muted fw-normal"><t key="salon.invoices.auto.tikla">(tikla)</t></small></label>
                        <!-- ko foreach: serviceCategories -->
                        <div class="mb-1">
                            <small class="text-muted" data-bind="text: name" style="font-size:.7rem;"></small>
                            <div class="d-flex flex-wrap gap-1">
                                <!-- ko foreach: ($data.services || []) -->
                                <button class="btn btn-sm py-0 px-2" style="font-size:.78rem;"
                                    data-bind="click: function() { $root.addServiceItem($data); },
                                               css: $root.isItemAdded($data.id, 'Service') ? 'btn-primary' : 'btn-outline-secondary'">
                                    <span data-bind="text: name"></span>
                                    <span class="ms-1 opacity-75" data-bind="text: price.toLocaleString(document.documentElement.lang || undefined) + '₺'"></span>
                                </button>
                                <!-- /ko -->
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>

                    <!-- Urun Ekle (tikla) -->
                    <!-- ko if: productList().length > 0 -->
                    <div class="mb-2">
                        <label class="form-label small fw-semibold"><t key="salon.invoices.auto.urun_ekle">Ürün Ekle</t> <small class="text-muted fw-normal"><t key="salon.invoices.auto.tikla_2">(tikla)</t></small></label>
                        <div class="d-flex flex-wrap gap-1">
                            <!-- ko foreach: productList -->
                            <button class="btn btn-sm py-0 px-2" style="font-size:.78rem;"
                                data-bind="click: function() { $root.addProductItem($data); },
                                           css: $root.isItemAdded($data.id, 'Product') ? 'btn-info' : 'btn-outline-secondary'">
                                <span data-bind="text: name"></span>
                                <span class="ms-1 opacity-75" data-bind="text: (salePrice || 0).toLocaleString(document.documentElement.lang || undefined) + '₺'"></span>
                            </button>
                            <!-- /ko -->
                        </div>
                    </div>
                    <!-- /ko -->

                    <!-- Secilen Kalemler -->
                    <!-- ko if: form.items().length > 0 -->
                    <div class="mb-3 mt-3">
                        <table class="table table-sm table-bordered mb-0">
                            <thead class="table-light">
                                <tr><th><t key="salon.invoices.auto.hizmet_urun">Hizmet/Ürün</t></th><th style="width:90px;"><t key="salon.invoices.auto.fiyat">Fiyat</t></th><th style="width:80px;"><t key="salon.invoices.auto.iskonto">İskonto</t></th><th style="width:60px;"><t key="salon.invoices.auto.kdv">KDV%</t></th><th style="width:70px;"><t key="salon.invoices.auto.kdv_2">KDV</t></th><th style="width:130px;"><t key="salon.sidebar.staff">Personel</t></th><th style="width:80px;"><t key="salon.invoices.auto.toplam_2">Toplam</t></th><th style="width:30px;"></th></tr>
                            </thead>
                            <tbody data-bind="foreach: form.items">
                                <tr>
                                    <td class="small fw-medium align-middle" data-bind="text: itemName"></td>
                                    <td class="small align-middle text-end" data-bind="text: unitPrice().toLocaleString(document.documentElement.lang || undefined) + ' ₺'"></td>
                                    <td><input type="number" class="form-control form-control-sm text-center" step="1" min="0" data-bind="value: discountAmount" /></td>
                                    <td class="small align-middle text-center" data-bind="text: '%' + (taxRate() || 0)"></td>
                                    <td class="small align-middle text-end text-muted" data-bind="text: taxAmount()"></td>
                                    <td>
                                        <select class="form-select form-select-sm" data-bind="options: $root.staffList, optionsText: 'fullName', optionsValue: 'id', value: personnelId, optionsCaption: '-'"></select>
                                    </td>
                                    <td class="fw-bold small text-end align-middle" data-bind="text: lineTotal()"></td>
                                    <td class="align-middle"><button class="btn btn-outline-danger btn-sm py-0 px-1" data-bind="click: $parent.removeItem"><i class="bi bi-x"></i></button></td>
                                </tr>
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="4" class="small text-end fw-semibold"><t key="salon.invoices.auto.kdv_toplam">KDV Toplam:</t></td>
                                    <td class="small text-end fw-semibold" data-bind="text: totalTax()"></td>
                                    <td class="small text-end fw-semibold"><t key="salon.invoices.auto.genel_toplam">Genel Toplam:</t></td>
                                    <td class="small text-end fw-bold text-success" data-bind="text: grandTotal().toLocaleString(document.documentElement.lang || undefined) + ' ₺'"></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <!-- /ko -->

                    <!-- Odeme + Toplam -->
                    <div class="row g-2 align-items-end mt-2">
                        <div class="col-5">
                            <label class="form-label small fw-semibold"><t key="salon.modules.payment_method">Ödeme</t></label>
                            <div class="btn-group w-100">
                                <button class="btn btn-sm" data-bind="click: function() { form.paymentMethodId(1); }, css: form.paymentMethodId() == 1 ? 'btn-success' : 'btn-outline-secondary'"><i class="bi bi-cash me-1"></i><t key="salon.cash.auto.nakit">Nakit</t></button>
                                <button class="btn btn-sm" data-bind="click: function() { form.paymentMethodId(2); }, css: form.paymentMethodId() == 2 ? 'btn-primary' : 'btn-outline-secondary'"><i class="bi bi-credit-card me-1"></i><t key="salon.invoices.auto.kart">Kart</t></button>
                                <button class="btn btn-sm" data-bind="click: function() { form.paymentMethodId(4); }, css: form.paymentMethodId() == 4 ? 'btn-info' : 'btn-outline-secondary'"><i class="bi bi-bank me-1"></i><t key="salon.invoices.auto.havale">Havale</t></button>
                                <button class="btn btn-sm" data-bind="click: function() { form.paymentMethodId(3); }, css: form.paymentMethodId() == 3 ? 'btn-warning' : 'btn-outline-secondary'"><i class="bi bi-shuffle me-1"></i><t key="salon.invoices.auto.karma">Karma</t></button>
                            </div>
                        </div>
                        <!-- Karma Odeme Detay -->
                        <!-- ko if: form.paymentMethodId() == 3 -->
                        <div class="col-12 mt-2">
                            <div class="card border-warning border-opacity-50 bg-warning bg-opacity-10">
                                <div class="card-body py-2">
                                    <div class="small fw-semibold mb-2"><i class="bi bi-shuffle me-1"></i><t key="salon.invoices.auto.karma_odeme_detay">Karma Ödeme Detay</t></div>
                                    <div class="row g-2">
                                        <div class="col-4">
                                            <label class="form-label small"><t key="salon.invoices.auto.nakit_tl">Nakit (TL)</t></label>
                                            <input type="number" class="form-control form-control-sm" step="0.01" data-bind="value: form.splitCash" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label small"><t key="salon.invoices.auto.kredi_karti_tl">Kredi Kartı (TL)</t></label>
                                            <input type="number" class="form-control form-control-sm" step="0.01" data-bind="value: form.splitCreditCard" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label small"><t key="salon.invoices.auto.havale_tl">Havale (TL)</t></label>
                                            <input type="number" class="form-control form-control-sm" step="0.01" data-bind="value: form.splitTransfer" />
                                        </div>
                                    </div>
                                    <div class="small text-muted mt-1" data-bind="text: salonT('salon.invoices.auto.toplam', 'Toplam:') + splitTotal().toLocaleString(document.documentElement.lang || undefined) + ' TL'"></div>
                                </div>
                            </div>
                        </div>
                        <!-- /ko -->
                        <div class="col-2">
                            <label class="form-label small"><t key="salon.invoices.auto.indirim">İndirim</t></label>
                            <input type="number" class="form-control form-control-sm" step="1" data-bind="value: form.discountAmount" />
                        </div>
                        <div class="col-2">
                            <label class="form-label small"><t key="salon.invoices.auto.bahsis">Bahşiş</t></label>
                            <input type="number" class="form-control form-control-sm" step="1" data-bind="value: form.tipAmount" />
                        </div>
                        <div class="col-3">
                            <div class="card bg-light border-0">
                                <div class="card-body py-2 text-center">
                                    <small class="text-muted"><t key="salon.invoices.auto.toplam_3">TOPLAM</t></small>
                                    <div class="fs-5 fw-bold text-success" data-bind="text: grandTotal().toLocaleString(document.documentElement.lang || undefined) + ' ₺'"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-1">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-success btn-sm px-4" data-bind="click: save, disable: isSaving, visible: !isEditing()">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i><t key="salon.common.btn.save">Kaydet</t>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Invoices.js" asp-append-version="true"></script>
}
