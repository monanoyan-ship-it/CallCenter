@{
    ViewData["Title"] = "Adisyonlar";
}

<div id="invoices-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <div class="input-group" style="max-width: 280px;">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="Adisyon veya musteri ara..." data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
            </div>
            <select class="form-select form-select-sm" style="width:140px;" data-bind="value: filterStatus">
                <option value="">Tum Durumlar</option>
                <option value="1">Acik</option>
                <option value="2">Odendi</option>
                <option value="3">Iptal</option>
            </select>
            <input type="date" class="form-control form-control-sm" style="width:150px;" data-bind="value: filterStartDate" />
            <span class="small text-muted">-</span>
            <input type="date" class="form-control form-control-sm" style="width:150px;" data-bind="value: filterEndDate" />
        </div>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i>Yeni Adisyon
        </button>
    </div>

    <!-- Ozet Kartlari -->
    <div class="row g-2 mb-3">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm"><div class="card-body py-2 text-center">
                <div class="text-muted" style="font-size:.7rem;">Toplam Adisyon</div>
                <div class="fw-bold" data-bind="text: summary().totalCount || 0"></div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm"><div class="card-body py-2 text-center">
                <div class="text-muted" style="font-size:.7rem;">Toplam Tutar</div>
                <div class="fw-bold text-success" data-bind="text: (summary().totalAmount || 0).toLocaleString('tr-TR') + ' TL'"></div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm"><div class="card-body py-2 text-center">
                <div class="text-muted" style="font-size:.7rem;">Acik Adisyon</div>
                <div class="fw-bold text-warning" data-bind="text: summary().openCount || 0"></div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm"><div class="card-body py-2 text-center">
                <div class="text-muted" style="font-size:.7rem;">Ortalama</div>
                <div class="fw-bold text-info" data-bind="text: (summary().averageAmount || 0).toLocaleString('tr-TR') + ' TL'"></div>
            </div></div>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Adisyon No</th><th>Tarih</th><th>Musteri</th>
                            <th>Hizmetler / Urunler</th><th>Tutar</th><th>Odeme</th><th>Durum</th><th style="width:80px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredInvoices">
                        <tr>
                            <td class="small fw-semibold" data-bind="text: invoiceNo"></td>
                            <td class="small" data-bind="text: new Date(invoiceDate).toLocaleDateString('tr-TR')"></td>
                            <td class="small" data-bind="text: clientName"></td>
                            <td class="small text-muted" data-bind="text: itemsSummary || '-'"></td>
                            <td class="small fw-semibold" data-bind="text: (totalAmount || 0).toLocaleString('tr-TR') + ' TL'"></td>
                            <td class="small" data-bind="text: paymentMethodText"></td>
                            <td><span class="badge" data-bind="text: statusText, css: statusCss"></span></td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" title="Detay" data-bind="click: $parent.openDetail"><i class="bi bi-eye"></i></button>
                                    <button class="btn btn-outline-warning" title="Iade" data-bind="click: $parent.openRefund, visible: statusId === 2"><i class="bi bi-arrow-return-left"></i></button>
                                    <button class="btn btn-outline-danger" title="Iptal" data-bind="click: $parent.cancelInvoice, visible: statusId === 1"><i class="bi bi-x-lg"></i></button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: filteredInvoices().length === 0 -->
            <div class="text-center text-muted py-4"><i class="bi bi-receipt" style="font-size:2rem;"></i><p class="mt-2 small">Adisyon bulunamadi</p></div>
            <!-- /ko -->
        </div>
    </div>

    <!-- ═══ Modal: Iade ═══ -->
    <div class="modal fade" id="refundModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning bg-opacity-10">
                    <h6 class="modal-title"><i class="bi bi-arrow-return-left me-2"></i>Iade</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- ko if: refundInvoice() -->
                    <div class="alert alert-info py-2 small mb-3">
                        Adisyon: <strong data-bind="text: refundInvoice().invoiceNo"></strong> |
                        Tutar: <strong data-bind="text: (refundInvoice().totalAmount || 0).toLocaleString('tr-TR') + ' TL'"></strong>
                    </div>
                    <!-- /ko -->
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small">Iade Tutari (TL) *</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" data-bind="value: refundForm.amount" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Iade Yontemi *</label>
                            <select class="form-select form-select-sm" data-bind="value: refundForm.paymentMethodId">
                                <option value="1">Nakit</option>
                                <option value="2">Kredi Karti</option>
                                <option value="4">Havale</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Iade Sebebi *</label>
                            <textarea class="form-control form-control-sm" rows="2" placeholder="Iade sebebini yaziniz..." data-bind="value: refundForm.reason"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-warning btn-sm" data-bind="click: saveRefund, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-arrow-return-left me-1" data-bind="visible: !isSaving()"></i>Iade Yap
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ Modal: Yeni Adisyon ═══ -->
    <div class="modal fade" id="invoiceModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title" data-bind="text: isEditing() ? 'Adisyon Detay' : 'Yeni Adisyon'"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Musteri -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Musteri</label>
                        <div class="position-relative" data-bind="with: clientAutocomplete">
                            <input type="text" class="form-control form-control-sm" placeholder="Musteri adi yazin..." autocomplete="off"
                                   data-bind="value: query, valueUpdate: 'afterkeydown', event: { focus: onFocus, blur: onBlur, keydown: onKeydown }" />
                            <!-- ko if: selectedName() -->
                            <span class="position-absolute top-50 end-0 translate-middle-y me-2" style="cursor:pointer;z-index:2;" data-bind="click: clear"><i class="bi bi-x-circle text-muted"></i></span>
                            <!-- /ko -->
                            <div class="dropdown-menu w-100 shadow-sm" style="max-height:200px;overflow-y:auto;" data-bind="css: { show: showDropdown }">
                                <!-- ko foreach: filteredItems -->
                                <a class="dropdown-item small py-1 px-2" href="#" data-bind="text: $parent.getDisplayText($data), event: { mousedown: function(){ $parent.select($data); } }, css: { active: $parent.highlightIndex() === $index() }"></a>
                                <!-- /ko -->
                                <!-- ko if: filteredItems().length === 0 && query().length > 0 -->
                                <a class="dropdown-item small py-1 px-2 text-primary fw-semibold" href="#" data-bind="event: { mousedown: function() { $root.showNewClient(query()); } }">
                                    <i class="bi bi-person-plus me-1"></i>Yeni musteri olustur
                                </a>
                                <!-- /ko -->
                            </div>
                        </div>
                        <!-- Yeni Musteri Inline -->
                        <div class="border rounded p-2 mt-1 bg-light" data-bind="visible: newClientVisible" style="display:none;">
                            <div class="row g-1">
                                <div class="col-5"><input type="text" class="form-control form-control-sm" placeholder="Ad Soyad *" data-bind="value: newClientForm.fullName" /></div>
                                <div class="col-4"><input type="tel" class="form-control form-control-sm" placeholder="Telefon *" data-bind="value: newClientForm.phone" /></div>
                                <div class="col-3 d-flex gap-1">
                                    <button class="btn btn-primary btn-sm py-0 flex-fill" data-bind="click: saveNewClient, disable: isCreatingClient"><i class="bi bi-check-lg"></i></button>
                                    <button class="btn btn-outline-secondary btn-sm py-0" data-bind="click: hideNewClient"><i class="bi bi-x-lg"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Hizmet Sec (tikla ekle) -->
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Hizmet Ekle <small class="text-muted fw-normal">(tikla)</small></label>
                        <!-- ko foreach: serviceCategories -->
                        <div class="mb-1">
                            <small class="text-muted" data-bind="text: name" style="font-size:.7rem;"></small>
                            <div class="d-flex flex-wrap gap-1">
                                <!-- ko foreach: services -->
                                <button class="btn btn-sm py-0 px-2" style="font-size:.78rem;"
                                    data-bind="click: function() { $root.addServiceItem($data); },
                                               css: $root.isItemAdded($data.id, 'Service') ? 'btn-primary' : 'btn-outline-secondary'">
                                    <span data-bind="text: name"></span>
                                    <span class="ms-1 opacity-75" data-bind="text: price.toLocaleString('tr-TR') + '₺'"></span>
                                </button>
                                <!-- /ko -->
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>

                    <!-- Urun Ekle (tikla) -->
                    <!-- ko if: productList().length > 0 -->
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Urun Ekle <small class="text-muted fw-normal">(tikla)</small></label>
                        <div class="d-flex flex-wrap gap-1">
                            <!-- ko foreach: productList -->
                            <button class="btn btn-sm py-0 px-2" style="font-size:.78rem;"
                                data-bind="click: function() { $root.addProductItem($data); },
                                           css: $root.isItemAdded($data.id, 'Product') ? 'btn-info' : 'btn-outline-secondary'">
                                <span data-bind="text: name"></span>
                                <span class="ms-1 opacity-75" data-bind="text: (salePrice || 0).toLocaleString('tr-TR') + '₺'"></span>
                            </button>
                            <!-- /ko -->
                        </div>
                    </div>
                    <!-- /ko -->

                    <!-- Secilen Kalemler -->
                    <!-- ko if: form.items().length > 0 -->
                    <div class="mb-3 mt-3">
                        <table class="table table-sm table-bordered mb-0">
                            <thead class="table-light">
                                <tr><th>Hizmet/Urun</th><th style="width:90px;">Fiyat</th><th style="width:80px;">Iskonto</th><th style="width:60px;">KDV%</th><th style="width:70px;">KDV</th><th style="width:130px;">Personel</th><th style="width:80px;">Toplam</th><th style="width:30px;"></th></tr>
                            </thead>
                            <tbody data-bind="foreach: form.items">
                                <tr>
                                    <td class="small fw-medium align-middle" data-bind="text: itemName"></td>
                                    <td class="small align-middle text-end" data-bind="text: unitPrice().toLocaleString('tr-TR') + ' ₺'"></td>
                                    <td><input type="number" class="form-control form-control-sm text-center" step="1" min="0" data-bind="value: discountAmount" /></td>
                                    <td class="small align-middle text-center" data-bind="text: '%' + (taxRate() || 0)"></td>
                                    <td class="small align-middle text-end text-muted" data-bind="text: taxAmount()"></td>
                                    <td>
                                        <select class="form-select form-select-sm" data-bind="options: $root.staffList, optionsText: 'fullName', optionsValue: 'id', value: personnelId, optionsCaption: '-'"></select>
                                    </td>
                                    <td class="fw-bold small text-end align-middle" data-bind="text: lineTotal()"></td>
                                    <td class="align-middle"><button class="btn btn-outline-danger btn-sm py-0 px-1" data-bind="click: $parent.removeItem"><i class="bi bi-x"></i></button></td>
                                </tr>
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="4" class="small text-end fw-semibold">KDV Toplam:</td>
                                    <td class="small text-end fw-semibold" data-bind="text: totalTax()"></td>
                                    <td class="small text-end fw-semibold">Genel Toplam:</td>
                                    <td class="small text-end fw-bold text-success" data-bind="text: grandTotal().toLocaleString('tr-TR') + ' ₺'"></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <!-- /ko -->

                    <!-- Odeme + Toplam -->
                    <div class="row g-2 align-items-end mt-2">
                        <div class="col-5">
                            <label class="form-label small fw-semibold">Odeme</label>
                            <div class="btn-group w-100">
                                <button class="btn btn-sm" data-bind="click: function() { form.paymentMethodId(1); }, css: form.paymentMethodId() == 1 ? 'btn-success' : 'btn-outline-secondary'"><i class="bi bi-cash me-1"></i>Nakit</button>
                                <button class="btn btn-sm" data-bind="click: function() { form.paymentMethodId(2); }, css: form.paymentMethodId() == 2 ? 'btn-primary' : 'btn-outline-secondary'"><i class="bi bi-credit-card me-1"></i>Kart</button>
                                <button class="btn btn-sm" data-bind="click: function() { form.paymentMethodId(4); }, css: form.paymentMethodId() == 4 ? 'btn-info' : 'btn-outline-secondary'"><i class="bi bi-bank me-1"></i>Havale</button>
                                <button class="btn btn-sm" data-bind="click: function() { form.paymentMethodId(3); }, css: form.paymentMethodId() == 3 ? 'btn-warning' : 'btn-outline-secondary'"><i class="bi bi-shuffle me-1"></i>Karma</button>
                            </div>
                        </div>
                        <!-- Karma Odeme Detay -->
                        <!-- ko if: form.paymentMethodId() == 3 -->
                        <div class="col-12 mt-2">
                            <div class="card border-warning border-opacity-50 bg-warning bg-opacity-10">
                                <div class="card-body py-2">
                                    <div class="small fw-semibold mb-2"><i class="bi bi-shuffle me-1"></i>Karma Odeme Detay</div>
                                    <div class="row g-2">
                                        <div class="col-4">
                                            <label class="form-label small">Nakit (TL)</label>
                                            <input type="number" class="form-control form-control-sm" step="0.01" data-bind="value: form.splitCash" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label small">Kredi Karti (TL)</label>
                                            <input type="number" class="form-control form-control-sm" step="0.01" data-bind="value: form.splitCreditCard" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label small">Havale (TL)</label>
                                            <input type="number" class="form-control form-control-sm" step="0.01" data-bind="value: form.splitTransfer" />
                                        </div>
                                    </div>
                                    <div class="small text-muted mt-1" data-bind="text: 'Toplam: ' + splitTotal().toLocaleString('tr-TR') + ' TL'"></div>
                                </div>
                            </div>
                        </div>
                        <!-- /ko -->
                        <div class="col-2">
                            <label class="form-label small">Indirim</label>
                            <input type="number" class="form-control form-control-sm" step="1" data-bind="value: form.discountAmount" />
                        </div>
                        <div class="col-2">
                            <label class="form-label small">Bahsis</label>
                            <input type="number" class="form-control form-control-sm" step="1" data-bind="value: form.tipAmount" />
                        </div>
                        <div class="col-3">
                            <div class="card bg-light border-0">
                                <div class="card-body py-2 text-center">
                                    <small class="text-muted">TOPLAM</small>
                                    <div class="fs-5 fw-bold text-success" data-bind="text: grandTotal().toLocaleString('tr-TR') + ' ₺'"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-1">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-success btn-sm px-4" data-bind="click: save, disable: isSaving, visible: !isEditing()">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Invoices.js" asp-append-version="true"></script>
}
