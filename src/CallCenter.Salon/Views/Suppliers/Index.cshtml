@{
    ViewData["Title"] = "Tedarikciler";
}

<div id="suppliers-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="input-group" style="max-width: 320px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="Tedarikci ara..." data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
        </div>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i>Yeni Tedarikci
        </button>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Firma Adi</th>
                            <th>Yetkili</th>
                            <th>Telefon</th>
                            <th>E-posta</th>
                            <th>Bakiye</th>
                            <th style="width: 80px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredSuppliers">
                        <tr>
                            <td class="small fw-semibold" data-bind="text: name"></td>
                            <td class="small" data-bind="text: contactPerson || '-'"></td>
                            <td class="small" data-bind="text: phone"></td>
                            <td class="small" data-bind="text: email || '-'"></td>
                            <td class="small fw-semibold" data-bind="text: (balance || 0).toLocaleString('tr-TR') + ' TL', css: { 'text-danger': (balance || 0) < 0, 'text-success': (balance || 0) >= 0 }"></td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" title="Duzenle" data-bind="click: $parent.openEdit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" title="Sil" data-bind="click: $parent.remove">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: filteredSuppliers().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-truck" style="font-size: 2rem;"></i>
                <p class="mt-2 small">Henuz tedarikci eklenmemis</p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Cari Ozet -->
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-header bg-white fw-semibold">
            <i class="bi bi-bank me-2"></i>Cari Hesap Ozeti
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-12 text-center">
                    <div class="text-muted small">Toplam Bakiye</div>
                    <div class="fw-bold" data-bind="text: totalBalance().toLocaleString('tr-TR') + ' TL', css: { 'text-danger': totalBalance() < 0, 'text-success': totalBalance() >= 0 }"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="supplierModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditing() ? 'Tedarikci Duzenle' : 'Yeni Tedarikci'"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small">Firma Adi *</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.name" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Yetkili Kisi</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.contactPerson" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Telefon *</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.phone" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">E-posta</label>
                            <input type="email" class="form-control form-control-sm" data-bind="value: form.email" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Vergi No</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.taxNumber" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Adres</label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: form.address"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Not</label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: form.notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Suppliers.js" asp-append-version="true"></script>
}
