@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.suppliers.auto.title", "Tedarikçiler");
}

<div id="suppliers-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="input-group" style="max-width: 320px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="@(Translation.T("salon.suppliers.auto.tedarikci_ara", "Tedarikçi ara..."))" data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
        </div>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i><t key="salon.suppliers.auto.yeni_tedarikci">Yeni Tedarikci</t>
        </button>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th><t key="salon.suppliers.auto.firma_adi">Firma Adı</t></th>
                            <th><t key="salon.suppliers.auto.yetkili">Yetkili</t></th>
                            <th><t key="salon.account.phone">Telefon</t></th>
                            <th><t key="salon.account.email">E-posta</t></th>
                            <th><t key="salon.suppliers.auto.bakiye">Bakiye</t></th>
                            <th style="width: 80px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredSuppliers">
                        <tr>
                            <td class="small fw-semibold" data-bind="text: name"></td>
                            <td class="small" data-bind="text: contactPerson || '-'"></td>
                            <td class="small" data-bind="text: phone"></td>
                            <td class="small" data-bind="text: email || '-'"></td>
                            <td class="small fw-semibold" data-bind="text: (balance || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL', css: { 'text-danger': (balance || 0) > 0, 'text-success': (balance || 0) <= 0 }"></td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" title="@(Translation.T("salon.suppliers.auto.duzenle", "Düzenle"))" data-bind="click: $parent.openEdit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" title="@(Translation.T("salon.common.btn.delete_tooltip", "Sil"))" data-bind="click: $parent.remove">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: filteredSuppliers().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-truck" style="font-size: 2rem;"></i>
                <p class="mt-2 small"><t key="salon.suppliers.auto.henuz_tedarikci_eklenmemis">Henüz tedarikçi eklenmemiş</t></p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Tedarik Siparisleri -->
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
            <span><i class="bi bi-clipboard-check me-2"></i>Tedarik Siparişleri</span>
            <button type="button" class="btn btn-outline-secondary btn-sm py-0" data-bind="click: loadData">
                <i class="bi bi-arrow-clockwise me-1"></i>Yenile
            </button>
        </div>
        <div class="card-body p-0">
            <!-- ko if: filteredSupplierOrders().length > 0 -->
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Sipariş No</th>
                            <th>Tedarikçi</th>
                            <th>Ürünler</th>
                            <th>Durum</th>
                            <th>Tarih</th>
                            <th class="text-end">Toplam</th>
                            <th style="width: 110px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredSupplierOrders">
                        <tr>
                            <td class="small fw-semibold" data-bind="text: orderNo"></td>
                            <td class="small" data-bind="text: supplierName || '-'"></td>
                            <td class="small text-muted" data-bind="text: $parent.orderProductSummary($data)"></td>
                            <td><span class="badge" data-bind="text: statusName, css: $parent.statusBadgeClass(statusId)"></span></td>
                            <td class="small" data-bind="text: orderDate ? new Date(orderDate).toLocaleDateString(document.documentElement.lang || undefined) : '-'"></td>
                            <td class="small text-end fw-semibold" data-bind="text: (totalAmount || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></td>
                            <td class="text-end">
                                <button type="button" class="btn btn-success btn-sm py-0"
                                        data-bind="click: $parent.approveReceived, visible: statusId !== 4 && statusId !== 5">
                                    <i class="bi bi-check2-circle me-1"></i>Onayla
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- /ko -->
            <!-- ko if: filteredSupplierOrders().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-clipboard-x" style="font-size: 2rem;"></i>
                <p class="mt-2 small">Henüz tedarik siparişi görünmüyor</p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Cari Ozet -->
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-header bg-white fw-semibold">
            <i class="bi bi-bank me-2"></i><t key="salon.suppliers.auto.cari_hesap_ozeti">Cari Hesap Özeti</t>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-12 text-center">
                    <div class="text-muted small"><t key="salon.suppliers.auto.toplam_bakiye">Toplam Bakiye</t></div>
                    <div class="fw-bold" data-bind="text: totalBalance().toLocaleString(document.documentElement.lang || undefined) + ' TL', css: { 'text-danger': totalBalance() > 0, 'text-success': totalBalance() <= 0 }"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="supplierModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditing() ? salonT('salon.suppliers.auto.tedarikci_duzenle', 'Tedarikçi Düzenle') : salonT('salon.suppliers.auto.yeni_tedarikci', 'Yeni Tedarikçi')"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.suppliers.auto.firma_adi_required">Firma Adı *</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="textInput: form.name" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.suppliers.auto.yetkili_kisi">Yetkili Kişi</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="textInput: form.contactPerson" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.account.phone">Telefon *</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="textInput: form.phone" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.account.email">E-posta</t></label>
                            <input type="email" class="form-control form-control-sm" data-bind="textInput: form.email" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.suppliers.auto.vergi_no">Vergi No</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="textInput: form.taxNumber" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.suppliers.auto.adres">Adres</t></label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="textInput: form.address"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.appointments.notes">Not</t></label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="textInput: form.notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i><t key="salon.common.btn.save">Kaydet</t>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Suppliers.js" asp-append-version="true"></script>
}
