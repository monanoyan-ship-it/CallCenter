@{
    var moduleId = ViewData["ModuleId"] as int?;
    var moduleName = ViewData["ModuleName"]?.ToString() ?? "Bu hizmet";
    var moduleIcon = ViewData["ModuleIcon"]?.ToString() ?? "bi-puzzle";
    ViewData["Title"] = "Hizmet Paketi Gerekli";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center p-5">
                    <i class="bi @moduleIcon text-warning" style="font-size:3rem;"></i>
                    <h4 class="mt-3">Bu hizmet aktif degil</h4>
                    <p class="text-muted mb-4">
                        <strong>@moduleName</strong> paketinizde yok. Bu ekrani kullanmak icin hizmeti satin alin.
                    </p>
                    <div class="d-grid gap-2">
                        @if (moduleId.HasValue)
                        {
                            <a href="/Modules/Purchase?moduleId=@moduleId.Value" class="btn btn-primary">
                                <i class="bi bi-cart-plus me-1"></i>Sat&#305;n Al
                            </a>
                        }
                        <a href="/Modules" class="btn btn-outline-secondary">
                            <i class="bi bi-puzzle me-1"></i>Hizmet Paketleri
                        </a>
                        <a href="/Home" class="btn btn-link text-muted">
                            <i class="bi bi-house me-1"></i>Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
