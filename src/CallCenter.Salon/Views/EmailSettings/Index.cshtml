@{
    ViewData["Title"] = "E-posta Ayarlari";
}

<div id="emailsettings-vm">
    <!-- Bagli Hesaplar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0"><i class="bi bi-envelope-at me-2"></i>Bagli E-posta Hesaplari</h6>
    </div>

    <div class="text-center py-3" data-bind="visible: isLoading">
        <div class="spinner-border spinner-border-sm text-primary"></div>
    </div>

    <!-- Entegrasyon Kartlari -->
    <div data-bind="foreach: integrations, visible: !isLoading()">
        <div class="card border-0 shadow-sm mb-2">
            <div class="card-body py-2 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <i class="me-3 fs-4" data-bind="css: providerIcon + ' ' + providerCss.replace('bg-','text-')"></i>
                    <div>
                        <div class="fw-semibold small">
                            <span data-bind="text: displayName"></span>
                            <!-- ko if: isDefault -->
                            <span class="badge bg-primary ms-1" style="font-size:.65rem;">Varsayilan</span>
                            <!-- /ko -->
                        </div>
                        <div class="text-muted" style="font-size:.8rem;" data-bind="text: senderEmail"></div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <!-- Test durumu -->
                    <!-- ko if: lastTestSuccess === true -->
                    <span class="badge bg-success" style="font-size:.65rem;"><i class="bi bi-check-circle me-1"></i>Calisiyor</span>
                    <!-- /ko -->
                    <!-- ko if: lastTestSuccess === false -->
                    <span class="badge bg-danger" style="font-size:.65rem;"><i class="bi bi-x-circle me-1"></i>Hata</span>
                    <!-- /ko -->
                    <!-- ko if: lastTestSuccess === null || lastTestSuccess === undefined -->
                    <span class="badge bg-secondary" style="font-size:.65rem;">Test edilmedi</span>
                    <!-- /ko -->

                    <button class="btn btn-outline-primary btn-sm py-0 px-1" title="Test Gonder"
                        data-bind="click: $parent.testSend, disable: $parent.isTesting">
                        <i class="bi bi-send"></i>
                    </button>
                    <!-- ko if: !isDefault -->
                    <button class="btn btn-outline-warning btn-sm py-0 px-1" title="Varsayilan Yap"
                        data-bind="click: $parent.setDefault">
                        <i class="bi bi-star"></i>
                    </button>
                    <!-- /ko -->
                    <button class="btn btn-outline-danger btn-sm py-0 px-1" title="Kaldir"
                        data-bind="click: $parent.remove">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ko if: !isLoading() && integrations().length === 0 -->
    <div class="text-center text-muted py-4">
        <i class="bi bi-envelope-x" style="font-size:2rem;"></i>
        <p class="mt-2 small">Henuz e-posta hesabi baglanmamis.</p>
    </div>
    <!-- /ko -->

    <!-- Yeni Hesap Bagla -->
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-header bg-white py-2">
            <h6 class="mb-0 small"><i class="bi bi-plus-circle me-1"></i>E-posta Hesabi Bagla</h6>
        </div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-3">
                    <button class="btn btn-outline-danger w-100" data-bind="click: connectGmail">
                        <i class="bi bi-google me-2"></i>Gmail
                    </button>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-outline-primary w-100" data-bind="click: connectOffice365">
                        <i class="bi bi-microsoft me-2"></i>Office 365
                    </button>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-outline-warning w-100" data-bind="click: openYandexModal">
                        <i class="bi bi-cloud-fill me-2"></i>Yandex
                    </button>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-outline-secondary w-100" data-bind="click: openSmtpModal">
                        <i class="bi bi-envelope-fill me-2"></i>Diger SMTP
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Yandex Modal -->
<div class="modal fade" id="yandexModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title"><i class="bi bi-cloud-fill me-2 text-warning"></i>Yandex Mail</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label small">E-posta *</label>
                    <input type="email" class="form-control form-control-sm" placeholder="salon@yandex.com" data-bind="value: yandexForm.email" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">Uygulama Sifresi *</label>
                    <input type="password" class="form-control form-control-sm" data-bind="value: yandexForm.appPassword" />
                    <div class="form-text" style="font-size:.7rem;">Yandex hesap ayarlarindan "Uygulama sifreleri" bolumunde olusturun.</div>
                </div>
                <div class="mb-2">
                    <label class="form-label small">Gorunen Ad</label>
                    <input type="text" class="form-control form-control-sm" placeholder="Salon Adi" data-bind="value: yandexForm.senderName" />
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" data-bind="checked: yandexForm.isDefault" />
                    <label class="form-check-label small">Varsayilan olarak ayarla</label>
                </div>
            </div>
            <div class="modal-footer py-1">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                <button class="btn btn-warning btn-sm" data-bind="click: saveYandex, disable: isSaving">
                    <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<!-- SMTP Modal -->
<div class="modal fade" id="smtpModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title"><i class="bi bi-envelope-fill me-2"></i>SMTP Ayarlari</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2">
                    <div class="col-8">
                        <label class="form-label small">SMTP Sunucu *</label>
                        <input type="text" class="form-control form-control-sm" placeholder="mail.example.com" data-bind="value: smtpForm.host" />
                    </div>
                    <div class="col-4">
                        <label class="form-label small">Port *</label>
                        <input type="number" class="form-control form-control-sm" placeholder="587" data-bind="value: smtpForm.port" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small">E-posta / Kullanici Adi *</label>
                        <input type="text" class="form-control form-control-sm" data-bind="value: smtpForm.username" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small">Sifre *</label>
                        <input type="password" class="form-control form-control-sm" data-bind="value: smtpForm.password" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small">Gonderici E-posta</label>
                        <input type="email" class="form-control form-control-sm" placeholder="Bos birakirsaniz kullanici adi kullanilir" data-bind="value: smtpForm.senderEmail" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small">Gorunen Ad</label>
                        <input type="text" class="form-control form-control-sm" placeholder="Salon Adi" data-bind="value: smtpForm.senderName" />
                    </div>
                    <div class="col-6">
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" data-bind="checked: smtpForm.useSsl" />
                            <label class="form-check-label small">SSL/TLS</label>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" data-bind="checked: smtpForm.isDefault" />
                            <label class="form-check-label small">Varsayilan</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-1">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                <button class="btn btn-primary btn-sm" data-bind="click: saveSmtp, disable: isSaving">
                    <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Test Gonder Modal -->
<div class="modal fade" id="testModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title">Test E-postasi Gonder</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label small">Alici E-posta *</label>
                <input type="email" class="form-control form-control-sm" data-bind="value: testEmail" placeholder="test@example.com" />
            </div>
            <div class="modal-footer py-1">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                <button class="btn btn-primary btn-sm" data-bind="click: confirmTestSend, disable: isTesting">
                    <span data-bind="visible: isTesting" class="spinner-border spinner-border-sm me-1"></span>Gonder
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/EmailSettings.js" asp-append-version="true"></script>
}
