@{
    ViewData["Title"] = "Receteler";
}

<div id="recipes-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="input-group" style="max-width: 320px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="Recete ara..." data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
        </div>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i>Yeni Recete
        </button>
    </div>

    <!-- Recipe Cards -->
    <div class="row g-3" data-bind="foreach: filteredRecipes">
        <div class="col-md-4 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fs-4 me-2" data-bind="attr: { 'class': iconClass || 'bi bi-journal-text' }" style="color:#7b1fa2;"></i>
                        <div class="flex-grow-1 min-width-0">
                            <div class="fw-semibold" data-bind="text: name"></div>
                            <small class="text-muted" data-bind="text: (description || '')"></small>
                        </div>
                    </div>
                    <!-- ko if: $parent.getServiceName(serviceId) -->
                    <span class="badge bg-info bg-opacity-10 text-info mb-2" data-bind="text: $parent.getServiceName(serviceId)"></span>
                    <!-- /ko -->
                    <div class="mb-2">
                        <!-- ko foreach: items -->
                        <div class="small text-muted">
                            <span data-bind="text: (quantity || '') + (unit ? unit : '') + ' ' + (productName || '')"></span>
                        </div>
                        <!-- /ko -->
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-bold text-primary" data-bind="text: (estimatedCost || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' TL'"></span>
                            <small class="text-muted ms-1">maliyet</small>
                        </div>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary" data-bind="click: $parent.openEdit"><i class="bi bi-pencil"></i></button>
                            <button class="btn btn-outline-danger" data-bind="click: $parent.remove"><i class="bi bi-trash"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ko if: filteredRecipes().length === 0 -->
    <div class="text-center text-muted py-5">
        <i class="bi bi-journal-text" style="font-size: 3rem; opacity:.3;"></i>
        <p class="mt-2 small">Henuz recete olusturulmamis</p>
        <p class="small">Receteler, hizmetler icin gereken malzeme ve miktarlari tanimlamanizi saglar.</p>
    </div>
    <!-- /ko -->

    <!-- Modal -->
    <div class="modal fade" id="recipeModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditing() ? 'Recete Duzenle' : 'Yeni Recete'"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-8">
                            <label class="form-label small">Recete Adi *</label>
                            <input type="text" class="form-control form-control-sm" placeholder="Orn: Siyahtan Sariya" data-bind="value: form.name" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Ikon</label>
                            <input type="text" class="form-control form-control-sm" placeholder="bi-palette" data-bind="value: form.iconClass" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Aciklama</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.description" />
                        </div>
                        <!-- Hizmet Secimi (opsiyonel) -->
                        <div class="col-12">
                            <label class="form-label small">Hizmet (opsiyonel)</label>
                            <div class="position-relative" data-bind="with: serviceAutocomplete">
                                <div class="input-group input-group-sm">
                                    <input type="text" class="form-control" placeholder="Hizmet secin..."
                                           data-bind="value: query, valueUpdate: 'afterkeydown',
                                                      event: { focus: onFocus, blur: onBlur, keydown: onKeydown }" />
                                    <!-- ko if: selectedName() -->
                                    <button class="btn btn-outline-secondary" data-bind="click: clear"><i class="bi bi-x"></i></button>
                                    <!-- /ko -->
                                </div>
                                <div class="dropdown-menu w-100 shadow-sm" style="max-height:200px;overflow-y:auto;"
                                     data-bind="css: { show: showDropdown() && filteredItems().length > 0 }">
                                    <!-- ko foreach: filteredItems -->
                                    <a class="dropdown-item small py-1 px-2" href="#"
                                       data-bind="text: $parent.getDisplayText($data), click: $parent.select,
                                                  css: { active: $parent.highlightIndex() === $index() },
                                                  event: { mousedown: function(){ $parent.select($data); } }"></a>
                                    <!-- /ko -->
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Malzeme Kalemleri -->
                    <div class="mt-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label small mb-0">Malzemeler</label>
                            <button class="btn btn-outline-primary btn-sm" data-bind="click: addItem">
                                <i class="bi bi-plus me-1"></i>Malzeme Ekle
                            </button>
                        </div>
                        <div data-bind="visible: form.items().length > 0">
                            <table class="table table-sm align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Urun</th>
                                        <th style="width:90px;">Miktar</th>
                                        <th style="width:90px;">Birim</th>
                                        <th style="width:130px;">Not</th>
                                        <th style="width:90px;" class="text-end">Maliyet</th>
                                        <th style="width:40px;"></th>
                                    </tr>
                                </thead>
                                <tbody data-bind="foreach: form.items">
                                    <tr>
                                        <td>
                                            <div class="position-relative" data-bind="with: productAutocomplete">
                                                <input type="text" class="form-control form-control-sm" placeholder="Urun ara..."
                                                       data-bind="value: query, valueUpdate: 'afterkeydown',
                                                                  event: { focus: onFocus, blur: onBlur, keydown: onKeydown }" />
                                                <div class="dropdown-menu w-100 shadow-sm" style="max-height:180px;overflow-y:auto;z-index:1060;"
                                                     data-bind="css: { show: showDropdown() && filteredItems().length > 0 }">
                                                    <!-- ko foreach: filteredItems -->
                                                    <a class="dropdown-item small py-1 px-2" href="#"
                                                       data-bind="text: $parent.getDisplayText($data), click: $parent.select,
                                                                  css: { active: $parent.highlightIndex() === $index() },
                                                                  event: { mousedown: function(){ $parent.select($data); } }"></a>
                                                    <!-- /ko -->
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm" step="0.1" min="0"
                                                   data-bind="value: quantity" />
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm"
                                                    data-bind="value: unit, options: unitOptions"></select>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" placeholder="Not..."
                                                   data-bind="value: notes" />
                                        </td>
                                        <td class="text-end small pt-2" data-bind="text: $parent.getItemCost($data)"></td>
                                        <td>
                                            <button class="btn btn-outline-danger btn-sm px-1" data-bind="click: $parent.removeItem"><i class="bi bi-x"></i></button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-end gap-3 mt-2" data-bind="visible: form.items().length > 0">
                            <span class="text-muted small">Tahmini Maliyet: <strong class="text-primary" data-bind="text: calculatedCost().toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' TL'"></strong></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Recipes.js" asp-append-version="true"></script>
}
