@{
    ViewData["Title"] = "Receteler";
}

<div id="recipes-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="input-group" style="max-width: 320px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="Recete ara..." data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
        </div>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i>Yeni Recete
        </button>
    </div>

    <!-- Recipe Cards -->
    <div class="row g-3" data-bind="foreach: filteredRecipes">
        <div class="col-md-4 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fs-4 me-2" data-bind="attr: { 'class': iconClass || 'bi bi-journal-text' }" style="color:#7b1fa2;"></i>
                        <div>
                            <div class="fw-semibold" data-bind="text: name"></div>
                            <small class="text-muted" data-bind="text: (description || '')"></small>
                        </div>
                    </div>
                    <div class="mb-2">
                        <!-- ko foreach: items -->
                        <div class="small text-muted">
                            <span data-bind="text: quantity > 1 ? quantity + 'x ' : ''"></span>
                            <span data-bind="text: serviceName"></span>
                        </div>
                        <!-- /ko -->
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-bold text-primary" data-bind="text: totalPrice.toLocaleString('tr-TR') + ' TL'"></span>
                            <small class="text-muted ms-1" data-bind="text: totalDurationMinutes + ' dk'"></small>
                        </div>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary" data-bind="click: $parent.openEdit"><i class="bi bi-pencil"></i></button>
                            <button class="btn btn-outline-danger" data-bind="click: $parent.remove"><i class="bi bi-trash"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ko if: filteredRecipes().length === 0 -->
    <div class="text-center text-muted py-5">
        <i class="bi bi-journal-text" style="font-size: 3rem; opacity:.3;"></i>
        <p class="mt-2 small">Henuz recete olusturulmamis</p>
        <p class="small">Receteler, sik kullanilan hizmet kombinasyonlarini tek tikla uygulamanizi saglar.</p>
    </div>
    <!-- /ko -->

    <!-- Modal -->
    <div class="modal fade" id="recipeModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditing() ? 'Recete Duzenle' : 'Yeni Recete'"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-8">
                            <label class="form-label small">Recete Adi *</label>
                            <input type="text" class="form-control form-control-sm" placeholder="Orn: Siyahtan Sariya" data-bind="value: form.name" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Ikon</label>
                            <input type="text" class="form-control form-control-sm" placeholder="bi-palette" data-bind="value: form.iconClass" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Aciklama</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.description" />
                        </div>
                    </div>

                    <!-- Hizmet Kalemleri -->
                    <div class="mt-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label small mb-0">Hizmet Kalemleri</label>
                            <button class="btn btn-outline-primary btn-sm" data-bind="click: addItem">
                                <i class="bi bi-plus me-1"></i>Kalem Ekle
                            </button>
                        </div>
                        <table class="table table-sm" data-bind="visible: form.items().length > 0">
                            <thead class="table-light">
                                <tr>
                                    <th>Hizmet</th>
                                    <th style="width:80px;">Adet</th>
                                    <th style="width:100px;">Fiyat</th>
                                    <th style="width:40px;"></th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: form.items">
                                <tr>
                                    <td>
                                        <select class="form-select form-select-sm" data-bind="value: serviceId,
                                            options: $parent.serviceList, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Hizmet seciniz'"></select>
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm" min="1" data-bind="value: quantity" />
                                    </td>
                                    <td class="text-end small pt-2" data-bind="text: $parent.getItemTotal($data)"></td>
                                    <td>
                                        <button class="btn btn-outline-danger btn-sm px-1" data-bind="click: $parent.removeItem"><i class="bi bi-x"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="d-flex justify-content-end gap-3 mt-2" data-bind="visible: form.items().length > 0">
                            <span class="text-muted small">Toplam Sure: <strong data-bind="text: calculatedDuration() + ' dk'"></strong></span>
                            <span class="text-muted small">Toplam Fiyat: <strong class="text-primary" data-bind="text: calculatedPrice().toLocaleString('tr-TR') + ' TL'"></strong></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Recipes.js" asp-append-version="true"></script>
}
