@{
    ViewData["Title"] = "Kayit Ol";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CorpLynk Salon - Kayit Ol</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: linear-gradient(135deg, #2d1b3d 0%, #1a1028 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .register-card { background: #fff; border-radius: 12px; padding: 2.5rem; width: 100%; max-width: 480px; box-shadow: 0 8px 32px rgba(0,0,0,.2); }
        .brand { color: #2d1b3d; font-weight: 700; font-size: 1.5rem; }
        .brand span { color: #ce93d8; }
        .btn-salon { background: #7b1fa2; border: none; color: #fff; }
        .btn-salon:hover { background: #6a1b9a; color: #fff; }
    </style>
</head>
<body>
    <div class="register-card">
        <div class="text-center mb-4">
            <div class="brand"><i class="bi bi-scissors me-2"></i>CorpLynk <span>Salon</span></div>
            <small class="text-muted">Ucretsiz Salon Hesabi Olustur</small>
        </div>

        <div id="errorAlert" class="alert alert-danger py-2 small d-none"></div>

        <form id="registerForm">
            <div class="alert alert-info py-2 small">
                <i class="bi bi-info-circle me-1"></i>Kayıt bilgileriniz aynı zamanda fatura bilgileriniz olarak kullanılacaktır. Lütfen eksiksiz ve doğru doldurunuz.
            </div>
            <div class="mb-3">
                <label class="form-label small">Salon / Firma Adı</label>
                <input type="text" name="salonName" class="form-control" placeholder="Ornek: Guzellik Merkezi" required />
            </div>
            <div class="mb-3">
                <label class="form-label small">Ad Soyad</label>
                <input type="text" name="ownerFullName" class="form-control" required />
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label small">E-posta</label>
                    <input type="email" name="email" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label small">Telefon</label>
                    <div class="input-group">
                        <select id="phoneCountry" class="form-select" style="max-width:120px;">
                            <option value="+90" selected>🇹🇷 +90</option>
                            <option value="+49">🇩🇪 +49</option>
                            <option value="+44">🇬🇧 +44</option>
                            <option value="+1">🇺🇸 +1</option>
                            <option value="+33">🇫🇷 +33</option>
                            <option value="+31">🇳🇱 +31</option>
                            <option value="+43">🇦🇹 +43</option>
                            <option value="+41">🇨🇭 +41</option>
                            <option value="+46">🇸🇪 +46</option>
                            <option value="+32">🇧🇪 +32</option>
                            <option value="+7">🇷🇺 +7</option>
                            <option value="+971">🇦🇪 +971</option>
                        </select>
                        <input type="tel" name="phone" class="form-control" id="phoneInput" placeholder="5XX XXX XX XX" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label small">Kullanici Adi</label>
                    <input type="text" name="userName" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label small">Sifre</label>
                    <input type="password" name="password" class="form-control" minlength="6" required />
                </div>
            </div>
            <button type="submit" class="btn btn-salon w-100" id="btnRegister">
                <i class="bi bi-person-plus me-1"></i>Kayit Ol
            </button>
        </form>

        <div class="text-center mt-3">
            <small class="text-muted">Zaten hesabiniz var mi? <a href="/Account/Login" class="text-decoration-none" style="color:#7b1fa2">Giris Yap</a></small>
        </div>
    </div>

    <script>
        function normalizePhoneValue() {
            var code = document.getElementById('phoneCountry').value;
            var raw = document.getElementById('phoneInput').value.replace(/[\s\-\(\)]/g, '').replace(/\D/g, '');
            if (raw.startsWith('0')) raw = raw.substring(1);
            return code + raw;
        }

        document.getElementById('registerForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            var btn = document.getElementById('btnRegister');
            var errDiv = document.getElementById('errorAlert');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Kaydediliyor...';
            errDiv.classList.add('d-none');

            var fd = new FormData(this);
            var body = {
                salonName: fd.get('salonName'),
                ownerFullName: fd.get('ownerFullName'),
                email: fd.get('email'),
                phone: normalizePhoneValue(),
                userName: fd.get('userName'),
                password: fd.get('password')
            };

            try {
                var resp = await fetch('/Account/DoRegister', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });
                var data = await resp.json();
                if (data.success) {
                    window.location.href = '/';
                } else {
                    errDiv.textContent = data.error || 'Kayit sirasinda bir hata olustu.';
                    errDiv.classList.remove('d-none');
                }
            } catch (ex) {
                errDiv.textContent = 'Baglanti hatasi. Lutfen tekrar deneyin.';
                errDiv.classList.remove('d-none');
            }
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-person-plus me-1"></i>Kayit Ol';
        });
    </script>
</body>
</html>
