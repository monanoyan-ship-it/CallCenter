@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.account.auto.kayit_ol", "Kayıt Ol");
    Layout = null;
    var pageLang = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    string T(string key, string fallback) => Translation.T(key, fallback);
}
<!DOCTYPE html>
<html lang="@pageLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@T("salon.account.auto.corplynk_salon_kayit_ol", "CorpLynk Salon - Kayıt Ol")</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: linear-gradient(135deg, #2d1b3d 0%, #1a1028 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .register-card { background: #fff; border-radius: 12px; padding: 2.5rem; width: 100%; max-width: 760px; box-shadow: 0 8px 32px rgba(0,0,0,.2); }
        .brand { color: #2d1b3d; font-weight: 700; font-size: 1.5rem; }
        .brand span { color: #ce93d8; }
        .btn-salon { background: #7b1fa2; border: none; color: #fff; }
        .btn-salon:hover { background: #6a1b9a; color: #fff; }
        .subscription-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
        .subscription-option { border: 1px solid #e5d7ec; border-radius: 8px; padding: .85rem; cursor: pointer; transition: border-color .15s ease, box-shadow .15s ease, background .15s ease; min-height: 116px; }
        .subscription-option.active { border-color: #7b1fa2; background: #faf5ff; box-shadow: 0 0 0 3px rgba(123,31,162,.12); }
        .subscription-title { font-weight: 700; color: #2d1b3d; }
        .subscription-price { font-size: 1.05rem; font-weight: 700; color: #7b1fa2; }
        .subscription-meta { font-size: .78rem; color: #6c757d; }
        @@media (max-width: 576px) {
            body { align-items: flex-start; padding: 1rem; }
            .register-card { padding: 1.5rem; }
            .subscription-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="register-card">
        <a href="/" class="text-decoration-none small text-muted d-inline-flex align-items-center mb-3">
            <i class="bi bi-arrow-left me-1"></i>Geri
        </a>
        <div class="text-center mb-4">
            <div class="brand"><i class="bi bi-scissors me-2"></i>CorpLynk <span><t key="salon.account.auto.salon">Salon</t></span></div>
            <small class="text-muted"><t key="salon.account.auto.ucretsiz_salon_hesabi_olustur">Ücretsiz Salon Hesabı Oluştur</t></small>
        </div>

        <div id="errorAlert" class="alert alert-danger py-2 small d-none"></div>

        <form id="registerForm" autocomplete="off">
            <div class="alert alert-info py-2 small">
                <i class="bi bi-info-circle me-1"></i>@T("salon.account.register.billing_info_notice", "Kayıt bilgileriniz aynı zamanda fatura bilgileriniz olarak kullanılacaktır. Lütfen eksiksiz ve doğru doldurunuz.")
            </div>
            <div class="mb-3">
                <label class="form-label small"><t key="salon.account.auto.salon_firma_adi">Salon / Firma Adı</t></label>
                <input type="text" name="salonName" class="form-control" placeholder="Ornek: Guzellik Merkezi" required />
            </div>
            <div class="mb-3">
                <label class="form-label small">Ad Soyad</label>
                <input type="text" name="ownerFullName" class="form-control" required />
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label small">E-posta</label>
                    <input type="email" name="email" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label small">Telefon</label>
                    <div class="input-group">
                        <select id="phoneCountry" class="form-select" style="max-width:120px;">
                            <option value="+90" selected>🇹🇷 +90</option>
                            <option value="+49">🇩🇪 +49</option>
                            <option value="+44">🇬🇧 +44</option>
                            <option value="+1">🇺🇸 +1</option>
                            <option value="+33">🇫🇷 +33</option>
                            <option value="+31">🇳🇱 +31</option>
                            <option value="+43">🇦🇹 +43</option>
                            <option value="+41">🇨🇭 +41</option>
                            <option value="+46">🇸🇪 +46</option>
                            <option value="+32">🇧🇪 +32</option>
                            <option value="+7">🇷🇺 +7</option>
                            <option value="+971">🇦🇪 +971</option>
                        </select>
                        <input type="tel" name="phone" class="form-control" id="phoneInput" placeholder="5XX XXX XX XX" />
                    </div>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label small">Platform Aboneligi *</label>
                <div id="planLoading" class="border rounded-3 p-3 small text-muted">
                    <span class="spinner-border spinner-border-sm me-1"></span><t key="salon.account.auto.planlar_yukleniyor"><t key="salon.account.auto.planlar_yukleniyor">Planlar yukleniyor...</t></t>
                </div>
                <div id="planList" class="subscription-grid d-none"></div>
                <input type="hidden" name="subscriptionPlanId" id="subscriptionPlanId" />
                <div id="trialInfo" class="alert alert-light border py-2 small mt-2 mb-0 d-none">
                    <div><strong>Demo:</strong> <span id="trialText"></span></div>
                    <div><strong>Ilk tahsilat:</strong> <span id="firstBillingText"></span></div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label small">Kullanici Adi</label>
                    <input type="text" name="userName" class="form-control" required autocomplete="off" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label small"><t key="salon.account.password">Şifre</t></label>
                    <input type="password" name="password" class="form-control" minlength="6" required autocomplete="new-password" />
                </div>
            </div>
            <button type="submit" class="btn btn-salon w-100" id="btnRegister">
                <i class="bi bi-person-plus me-1"></i><t key="salon.account.auto.kayit_ol">Kayıt Ol</t>
            </button>
        </form>

        <div class="text-center mt-3">
            <small class="text-muted">Zaten hesabiniz var mi? <a href="/Account/Login" class="text-decoration-none" style="color:#7b1fa2"><t key="salon.account.auto.giris_yap">Giriş Yap</t></a></small>
        </div>
    </div>

    <script>
        function normalizePhoneValue() {
            var code = document.getElementById('phoneCountry').value;
            var raw = document.getElementById('phoneInput').value.replace(/[\s\-\(\)]/g, '').replace(/\D/g, '');
            if (raw.startsWith('0')) raw = raw.substring(1);
            return code + raw;
        }

        var registerOptions = {
            trialDays: 5,
            coreMonthlyPrice: 1700,
            plans: []
        };

        function formatMoney(value) {
            return (Number(value) || 0).toLocaleString(document.documentElement.lang || undefined, { minimumFractionDigits: 0, maximumFractionDigits: 2 }) + ' TL';
        }

        function addDays(date, days) {
            var next = new Date(date.getTime());
            next.setDate(next.getDate() + days);
            return next;
        }

        function normalizeOptionKeys(data) {
            return {
                trialDays: data.trialDays || data.TrialDays || 5,
                coreMonthlyPrice: data.coreMonthlyPrice || data.CoreMonthlyPrice || 1700,
                plans: data.plans || data.Plans || []
            };
        }

        function planValue(plan, key) {
            var pascal = key.charAt(0).toUpperCase() + key.slice(1);
            return plan[key] != null ? plan[key] : plan[pascal];
        }

        function renderPlans(options) {
            registerOptions = normalizeOptionKeys(options || {});
            var plans = registerOptions.plans;
            var loading = document.getElementById('planLoading');
            var list = document.getElementById('planList');

            if (!plans.length) {
                loading.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i>@T("salon.account.register.plans_load_failed", "Abonelik planları yüklenemedi. Kayıt sırasında varsayılan aylık plan seçilecek.")';
                return;
            }

            list.innerHTML = plans.map(function (plan) {
                var id = planValue(plan, 'id');
                var idAttr = id == null ? '' : String(id);
                var name = planValue(plan, 'name') || ('Plan #' + id);
                var interval = Number(planValue(plan, 'intervalMonths')) || 1;
                var discount = Number(planValue(plan, 'discountPercent')) || 0;
                var periodPrice = Number(planValue(plan, 'periodPrice')) || 0;
                var monthlyEquivalent = Number(planValue(plan, 'monthlyEquivalent')) || 0;
                var discountText = discount > 0 ? '%' + discount.toLocaleString(document.documentElement.lang || undefined) + ' @T("salon.account.register.discount_suffix", "indirim")' : '@T("salon.account.register.no_discount", "İndirimsiz")';

                return '<button type="button" class="subscription-option text-start bg-white" data-plan-id="' + idAttr + '">' +
                    '<div class="d-flex justify-content-between align-items-start gap-2">' +
                    '<div class="subscription-title">' + name + '</div>' +
                    '<span class="badge bg-light text-dark border">' + interval + ' @T("salon.account.register.month_suffix", "ay")</span>' +
                    '</div>' +
                    '<div class="subscription-price mt-2">' + formatMoney(periodPrice) + '</div>' +
                    '<div class="subscription-meta">@T("salon.account.register.period_collection", "Dönem tahsilatı")</div>' +
                    '<div class="subscription-meta mt-1">' + formatMoney(monthlyEquivalent) + ' / @T("salon.account.register.month_equivalent", "ay eşdeğeri") - ' + discountText + '</div>' +
                    '</button>';
            }).join('');

            loading.classList.add('d-none');
            list.classList.remove('d-none');

            list.querySelectorAll('[data-plan-id]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    selectPlan(this.getAttribute('data-plan-id'));
                });
            });

            var defaultPlan = plans.find(function (p) { return planValue(p, 'isDefault') === true; }) || plans[0];
            selectPlan(planValue(defaultPlan, 'id'));
        }

        function selectPlan(planId) {
            var idText = planId == null ? '' : String(planId);
            var selected = registerOptions.plans.find(function (p) {
                var id = planValue(p, 'id');
                return (id == null ? '' : String(id)) === idText;
            });
            if (!selected) return;

            document.getElementById('subscriptionPlanId').value = idText;
            document.querySelectorAll('.subscription-option').forEach(function (btn) {
                btn.classList.toggle('active', btn.getAttribute('data-plan-id') === idText);
            });

            var trialDays = Number(registerOptions.trialDays) || 5;
            var firstPaymentDate = addDays(new Date(), trialDays);
            var interval = Number(planValue(selected, 'intervalMonths')) || 1;
            var periodPrice = Number(planValue(selected, 'periodPrice')) || 0;

            document.getElementById('trialText').textContent = '@T("salon.account.register.trial_prefix", "Kayıt tarihinden itibaren") ' + trialDays + ' @T("salon.account.register.trial_suffix", "gün ücretsiz kullanım.")';
            document.getElementById('firstBillingText').textContent =
                firstPaymentDate.toLocaleDateString(document.documentElement.lang || undefined) + ' tarihinde ' + formatMoney(periodPrice) +
                ' @T("salon.account.register.first_billing_suffix", "tahsilat; sonraki tahakkuk") ' + interval + ' @T("salon.account.register.every_months_suffix", "ayda bir.")';
            document.getElementById('trialInfo').classList.remove('d-none');
        }

        async function loadRegisterOptions() {
            try {
                var resp = await fetch('/Account/RegisterOptions');
                if (!resp.ok) throw new Error('@T("salon.account.register.plans_load_failed_short", "Planlar yüklenemedi")');
                renderPlans(await resp.json());
            } catch (ex) {
                renderPlans({
                    trialDays: 5,
                    coreMonthlyPrice: 1700,
                    plans: [{
                        id: null,
                        name: '@T("salon.account.register.default_monthly_plan", "1 Aylık Abonelik")',
                        intervalMonths: 1,
                        discountPercent: 0,
                        periodPrice: 1700,
                        monthlyEquivalent: 1700,
                        isDefault: true
                    }]
                });
            }
        }

        document.getElementById('registerForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            var btn = document.getElementById('btnRegister');
            var errDiv = document.getElementById('errorAlert');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>@T("salon.account.register.saving", "Kaydediliyor...")';
            errDiv.classList.add('d-none');

            var fd = new FormData(this);
            var body = {
                salonName: fd.get('salonName'),
                ownerFullName: fd.get('ownerFullName'),
                email: fd.get('email'),
                phone: normalizePhoneValue(),
                userName: fd.get('userName'),
                password: fd.get('password'),
                subscriptionPlanId: document.getElementById('subscriptionPlanId').value
                    ? parseInt(document.getElementById('subscriptionPlanId').value)
                    : null
            };

            if (!body.subscriptionPlanId && registerOptions.plans.length > 1) {
                errDiv.textContent = '@T("salon.account.register.select_plan", "Lütfen abonelik planınızı seçin.")';
                errDiv.classList.remove('d-none');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-person-plus me-1"></i>@T("salon.account.auto.kayit_ol", "Kayıt Ol")';
                return;
            }

            try {
                var resp = await fetch('/Account/DoRegister', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });
                var data = await resp.json();
                if (data.success) {
                    window.location.href = '/';
                } else {
                    errDiv.textContent = data.error || '@T("salon.account.register.failed", "Kayıt sırasında bir hata oluştu.")';
                    errDiv.classList.remove('d-none');
                }
            } catch (ex) {
                errDiv.textContent = '@T("salon.account.register.connection_error", "Bağlantı hatası. Lütfen tekrar deneyin.")';
                errDiv.classList.remove('d-none');
            }
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-person-plus me-1"></i>@T("salon.account.auto.kayit_ol", "Kayıt Ol")';
        });

        loadRegisterOptions();
    </script>
</body>
</html>
