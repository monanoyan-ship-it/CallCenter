@using System.Globalization
@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.account.login_title", "Giriş");
    Layout = null;
    var registeredFlag = string.Equals(Context.Request.Query["registered"], "1", StringComparison.Ordinal);
    var pageLang = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    string T(string key, string fallback) => Translation.T(key, fallback);
}
<!DOCTYPE html>
<html lang="@pageLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@T("salon.account.auto.corplynk_salon_giris", "CorpLynk Salon - Giriş")</title>
    <link href="/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: linear-gradient(135deg, #2d1b3d 0%, #1a1028 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .login-card { background: #fff; border-radius: 12px; padding: 2.5rem; width: 100%; max-width: 400px; box-shadow: 0 8px 32px rgba(0,0,0,.2); }
        .brand { color: #2d1b3d; font-weight: 700; font-size: 1.5rem; }
        .brand span { color: #ce93d8; }
        .btn-salon { background: #7b1fa2; border: none; color: #fff; }
        .btn-salon:hover { background: #6a1b9a; color: #fff; }
        .language-holder { position: absolute; top: 10px; right: 10px; }
    </style>
</head>
<body>
    <div class="language-holder">
        @await Html.PartialAsync("_LanguageMenu", "auth")
    </div>

    <div class="login-card">
        <a href="/" class="text-decoration-none small text-muted d-inline-flex align-items-center mb-3">
            <i class="bi bi-arrow-left me-1"></i><t key="salon.book.btn.back">Geri</t>
        </a>
        <div class="text-center mb-4">
            <div class="brand"><i class="bi bi-scissors me-2"></i>CorpLynk <span><t key="salon.account.auto.salon">Salon</t></span></div>
            <small class="text-muted"><t key="salon.account.auto.salon_yonetim_sistemi">Salon Yönetim Sistemi</t></small>
        </div>

        @if (registeredFlag)
        {
            <div class="alert alert-info py-2 small">
                <i class="bi bi-envelope-check me-1"></i>
                <t key="salon.account.register.email_sent">Kayıt başarılı. Doğrulama bağlantısı e-posta adresine gönderildi. Giriş yapmadan önce mail kutunu kontrol et.</t>
            </div>
        }
        @if (ViewBag.ErrorKey != null)
        {
            <div class="alert alert-danger py-2 small"><t key="@ViewBag.ErrorKey">@ViewBag.ErrorFallback</t></div>
        }
        else if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 small">@ViewBag.Error</div>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label small"><t key="salon.account.username">Kullanıcı Adı</t></label>
                <input type="text" name="username" class="form-control" value="@ViewBag.Username" required autofocus />
            </div>
            <div class="mb-3">
                <label class="form-label small"><t key="salon.account.password">Şifre</t></label>
                <input type="password" name="password" class="form-control" required />
            </div>
            <div class="mb-3 form-check">
                <input type="checkbox" name="rememberMe" value="true" class="form-check-input" id="rememberMe" />
                <label class="form-check-label small" for="rememberMe">
                    <t key="salon.account.auto.beni_hatirla">Beni hatırla</t>
                    <span class="text-muted"><t key="salon.account.auto.30_gun">(30 gün)</t></span>
                </label>
            </div>
            <button type="submit" class="btn btn-salon w-100"><t key="salon.account.btn.login">Giriş Yap</t></button>
        </form>

        <div class="d-flex justify-content-between mt-3 small">
            <a href="/Account/ForgotPassword" class="text-decoration-none text-muted"><t key="salon.account.forgot_link">Şifremi unuttum</t></a>
            <a href="/Account/ResendVerification" class="text-decoration-none text-muted"><t key="salon.account.resend_link">Doğrulama maili gelmedi</t></a>
        </div>

        <div class="text-center mt-3">
            <small class="text-muted">
                <t key="salon.account.no_account">Hesabınız yok mu?</t>
                <a href="/Account/Register" class="text-decoration-none" style="color:#7b1fa2"><t key="salon.account.auto.ucretsiz_kayit_ol">Ücretsiz Kayıt Ol</t></a>
            </small>
        </div>
    </div>
</body>
</html>
