@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.account.verify.title", "Email Doğrulama");
    Layout = null;
    var success = ViewBag.Success != null && (bool)ViewBag.Success;
    var message = ViewBag.Message as string ?? "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><t key="salon.account.verify.page_title">CorpLynk Salon - Email Doğrulama</t></title>
    <link href="/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: linear-gradient(135deg, #2d1b3d 0%, #1a1028 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .login-card { background: #fff; border-radius: 12px; padding: 2.5rem; width: 100%; max-width: 440px; box-shadow: 0 8px 32px rgba(0,0,0,.2); text-align: center; }
        .brand { color: #2d1b3d; font-weight: 700; font-size: 1.5rem; }
        .brand span { color: #ce93d8; }
        .btn-salon { background: #7b1fa2; border: none; color: #fff; }
        .btn-salon:hover { background: #6a1b9a; color: #fff; }
        .icon-status { font-size: 3rem; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="brand mb-4"><i class="bi bi-scissors me-2"></i>CorpLynk <span><t key="salon.account.auto.salon">Salon</t></span></div>
        @if (success)
        {
            <i class="bi bi-check-circle-fill icon-status text-success mb-3 d-block"></i>
            <h5 class="mb-3"><t key="salon.account.verify.success_title">Email doğrulandı</t></h5>
            <p class="text-muted small mb-4">@message</p>
            <a href="/Account/Login" class="btn btn-salon w-100"><t key="salon.account.verify.go_login">Giriş Yap</t></a>
        }
        else
        {
            <i class="bi bi-exclamation-triangle-fill icon-status text-warning mb-3 d-block"></i>
            <h5 class="mb-3"><t key="salon.account.verify.fail_title">Doğrulama başarısız</t></h5>
            <p class="text-muted small mb-4">@message</p>
            <a href="/Account/ResendVerification" class="btn btn-salon w-100"><t key="salon.account.verify.resend_link">Doğrulama Mailini Tekrar Gönder</t></a>
            <a href="/Account/Login" class="btn btn-link mt-2 small text-muted"><t key="salon.account.back_to_login">Giriş sayfasına dön</t></a>
        }
    </div>
</body>
</html>
