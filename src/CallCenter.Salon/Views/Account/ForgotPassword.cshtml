@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.account.forgot.title", "Şifremi Unuttum");
    Layout = null;
    var submitted = ViewBag.Submitted != null && (bool)ViewBag.Submitted;
    var message = ViewBag.Message as string ?? "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><t key="salon.account.forgot.page_title">CorpLynk Salon - Şifremi Unuttum</t></title>
    <link href="/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: linear-gradient(135deg, #2d1b3d 0%, #1a1028 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .login-card { background: #fff; border-radius: 12px; padding: 2.5rem; width: 100%; max-width: 400px; box-shadow: 0 8px 32px rgba(0,0,0,.2); }
        .brand { color: #2d1b3d; font-weight: 700; font-size: 1.5rem; }
        .brand span { color: #ce93d8; }
        .btn-salon { background: #7b1fa2; border: none; color: #fff; }
        .btn-salon:hover { background: #6a1b9a; color: #fff; }
    </style>
</head>
<body>
    <div class="login-card">
        <a href="/Account/Login" class="text-decoration-none small text-muted d-inline-flex align-items-center mb-3">
            <i class="bi bi-arrow-left me-1"></i><t key="salon.account.back_to_login">Geri</t>
        </a>
        <div class="text-center mb-4">
            <div class="brand"><i class="bi bi-key me-2"></i><t key="salon.account.forgot.heading">Şifremi Unuttum</t></div>
            <small class="text-muted"><t key="salon.account.forgot.subtitle">Sıfırlama bağlantısını email adresine gönderelim.</t></small>
        </div>

        @if (submitted)
        {
            <div class="alert alert-info py-2 small">@message</div>
            <a href="/Account/Login" class="btn btn-salon w-100"><t key="salon.account.back_to_login_btn">Giriş sayfasına dön</t></a>
        }
        else
        {
            <form method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label small"><t key="salon.account.username">Kullanıcı Adı</t></label>
                    <input type="text" name="username" class="form-control" required autofocus />
                </div>
                <button type="submit" class="btn btn-salon w-100"><t key="salon.account.forgot.submit">Sıfırlama Bağlantısı Gönder</t></button>
            </form>
        }
    </div>
</body>
</html>
