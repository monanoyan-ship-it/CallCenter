@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.waitlist.auto.title", "Bekleme Listesi");
}

<div id="waitlist-vm">
    <!-- Sekmeler -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="tab" href="#tab-appointments">
                <i class="bi bi-calendar-check me-1"></i><t key="salon.waitlist.auto.bugunun_randevulari">Bugünün Randevuları</t>
                <span class="badge bg-primary ms-1" data-bind="text: todayAppointments().length, visible: todayAppointments().length > 0"></span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#tab-waitlist">
                <i class="bi bi-clock-history me-1"></i><t key="salon.sidebar.waitlist">Bekleme Listesi</t>
                <span class="badge bg-warning text-dark ms-1" data-bind="text: waitlistEntries().length, visible: waitlistEntries().length > 0"></span>
            </a>
        </li>
    </ul>

    <div class="tab-content">
        <!-- ═══ TAB 1: Bugunun Randevulari ═══ -->
        <div class="tab-pane fade show active" id="tab-appointments">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                    <small class="text-muted">
                        <i class="bi bi-calendar3 me-1"></i><span data-bind="text: todayLabel"></span>
                        &mdash; <strong data-bind="text: todayAppointments().length"></strong><t key="salon.waitlist.auto.randevu">randevu</t>
                    </small>
                    <button class="btn btn-outline-secondary btn-sm py-0" data-bind="click: loadTodayAppointments">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="text-center py-3" data-bind="visible: isLoadingAppts">
                        <div class="spinner-border spinner-border-sm text-primary"></div>
                    </div>
                    <!-- ko if: !isLoadingAppts() && todayAppointments().length === 0 -->
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-calendar-x" style="font-size:2rem;"></i>
                        <p class="mt-2 small"><t key="salon.waitlist.auto.bugun_icin_randevu_yok">Bugün için randevu yok</t></p>
                    </div>
                    <!-- /ko -->
                    <div class="table-responsive" data-bind="visible: !isLoadingAppts() && todayAppointments().length > 0">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:60px;"><t key="salon.reports.hour">Saat</t></th>
                                    <th><t key="salon.panel.payments.customer">Müşteri</t></th>
                                    <th><t key="salon.sidebar.services">Hizmetler</t></th>
                                    <th><t key="salon.sidebar.staff">Personel</t></th>
                                    <th class="text-center" style="width:60px;"><t key="salon.waitlist.auto.sure">Süre</t></th>
                                    <th style="width:100px;"><t key="salon.appointments.status">Durum</t></th>
                                    <th style="width:140px;"></th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: todayAppointments">
                                <tr data-bind="css: { 'table-success': statusId === 3, 'table-secondary': statusId === 4 || statusId === 5 }">
                                    <td class="fw-semibold" data-bind="text: startTimeFormatted"></td>
                                    <td class="small" data-bind="text: clientName"></td>
                                    <td class="small" data-bind="text: serviceNamesText"></td>
                                    <td class="small" data-bind="text: personnelName"></td>
                                    <td class="text-center small" data-bind="text: durationMinutes ? durationMinutes + ' dk' : '-'"></td>
                                    <td>
                                        <span class="badge" data-bind="text: statusText, css: statusCss"></span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <!-- Planlanmis/Onaylandi -> Gerceklesti -->
                                            <!-- ko if: statusId === 1 || statusId === 2 -->
                                            <button class="btn btn-outline-success py-0 px-1" title="@(Translation.T("salon.waitlist.auto.title_gerceklesti", "Gerçekleşti"))"
                                                data-bind="click: $parent.apptComplete">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                            <button class="btn btn-outline-secondary py-0 px-1" title="@(Translation.T("salon.waitlist.auto.title_gelmedi", "Gelmedi"))"
                                                data-bind="click: $parent.apptNoShow">
                                                <i class="bi bi-person-x"></i>
                                            </button>
                                            <button class="btn btn-outline-danger py-0 px-1" title="@(Translation.T("salon.common.btn.cancel", "İptal"))"
                                                data-bind="click: $parent.apptCancel">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                            <!-- /ko -->
                                            <!-- Tamamlandi -> geri al -->
                                            <!-- ko if: statusId === 3 -->
                                            <span class="text-success small"><i class="bi bi-check-circle-fill me-1"></i><t key="salon.appointments.status.completed">Tamam</t></span>
                                            <!-- /ko -->
                                            <!-- Iptal/Gelmedi bilgi -->
                                            <!-- ko if: statusId === 4 -->
                                            <span class="text-danger small"><i class="bi bi-x-circle-fill me-1"></i><t key="salon.common.btn.cancel">İptal</t></span>
                                            <!-- /ko -->
                                            <!-- ko if: statusId === 5 -->
                                            <span class="text-secondary small"><i class="bi bi-person-x-fill me-1"></i><t key="salon.appointments.status.no_show">Gelmedi</t></span>
                                            <!-- /ko -->
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ TAB 2: Bekleme Listesi ═══ -->
        <div class="tab-pane fade" id="tab-waitlist">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="input-group" style="max-width: 320px;">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="@(Translation.T("salon.waitlist.auto.musteri_veya_hizmet_ara", "Müşteri veya hizmet ara..."))" data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
                </div>
                <div class="d-flex gap-1">
                    <button class="btn btn-outline-secondary btn-sm" data-bind="click: normalizeBranches"
                            title="@(Translation.T("salon.waitlist.auto.sube_bilgisi_olmayan_eski_kayitlari_personelin_merkezin_sube", "Şube bilgisi olmayan eski kayitlari personelin/merkezin subesine bagla"))">
                        <i class="bi bi-shuffle me-1"></i><t key="salon.waitlist.auto.sube_normalize">Şube Normalize</t>
                    </button>
                    <button class="btn btn-primary btn-sm" data-bind="click: openNew">
                        <i class="bi bi-plus-lg me-1"></i><t key="salon.waitlist.auto.yeni_kayit">Yeni Kayıt</t>
                    </button>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th><t key="salon.panel.payments.customer">Müşteri</t></th>
                                    <th><t key="salon.book.summary.service">Hizmet</t></th>
                                    <th><t key="salon.waitlist.auto.tercih_edilen_personel">Tercih Edilen Personel</t></th>
                                    <th><t key="salon.panel.payments.date">Tarih</t></th>
                                    <th><t key="salon.waitlist.auto.saat_dilimi">Saat Dilimi</t></th>
                                    <th><t key="salon.appointments.status">Durum</t></th>
                                    <th style="width:150px;"></th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: filteredEntries">
                                <tr>
                                    <td class="fw-semibold small" data-bind="text: clientName"></td>
                                    <td class="small" data-bind="text: serviceName"></td>
                                    <td class="small" data-bind="text: preferredPersonnelName || '-'"></td>
                                    <td class="small" data-bind="text: $parent.formatDate(preferredDate)"></td>
                                    <td class="small" data-bind="text: preferredTimeSlot || '-'"></td>
                                    <td class="small">
                                        <span class="badge" data-bind="text: $parent.wlStatusText(statusId), css: $parent.wlStatusBadge(statusId)"></span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <!-- ko if: statusId === 1 -->
                                            <button class="btn btn-outline-info py-0 px-1" title="@(Translation.T("salon.waitlist.auto.title_bildir", "Bildir"))" data-bind="click: $parent.notifyEntry">
                                                <i class="bi bi-bell"></i>
                                            </button>
                                            <!-- /ko -->
                                            <!-- ko if: statusId <= 2 -->
                                            <button class="btn btn-outline-primary py-0 px-1" title="@(Translation.T("salon.waitlist.auto.title_randevuya_donustur", "Randevuya Dönüştür"))" data-bind="click: $parent.openConvert">
                                                <i class="bi bi-calendar-plus"></i>
                                            </button>
                                            <button class="btn btn-outline-success py-0 px-1" title="@(Translation.T("salon.waitlist.auto.randevu_alindi_manuel", "Randevu Alindi (Manuel)"))" data-bind="click: $parent.appointmentMade">
                                                <i class="bi bi-calendar-check"></i>
                                            </button>
                                            <!-- /ko -->
                                            <!-- ko if: statusId === 3 -->
                                            <button class="btn btn-outline-primary py-0 px-1" title="@(Translation.T("salon.waitlist.auto.title_gerceklesti", "Gerçekleşti"))" data-bind="click: $parent.markCompleted">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                            <!-- /ko -->
                                            <!-- ko if: statusId !== 5 && statusId !== 4 -->
                                            <button class="btn btn-outline-danger py-0 px-1" title="@(Translation.T("salon.common.btn.delete_tooltip", "Sil"))" data-bind="click: $parent.removeEntry">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                            <!-- /ko -->
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- ko if: filteredEntries().length === 0 -->
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-clock-history" style="font-size:2rem;"></i>
                        <p class="mt-2 small"><t key="salon.waitlist.auto.bekleme_listesinde_kayit_yok">Bekleme listesinde kayıt yok</t></p>
                    </div>
                    <!-- /ko -->
                </div>
            </div>
        </div>
    </div>

    <!-- Randevuya Donustur Modal -->
    <div class="modal fade" id="convertModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><i class="bi bi-calendar-plus me-2"></i><t key="salon.waitlist.auto.bekleme_kaydini_randevuya_donustur">Bekleme Kaydını Randevuya Dönüştür</t></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info py-2 small mb-3">
                        <strong data-bind="text: convertCtx.clientName"></strong> &mdash;
                        <span data-bind="text: convertCtx.serviceName"></span>
                        <span class="text-muted" data-bind="visible: convertCtx.preferredPersonnelName">
                            <t key="salon.waitlist.auto.tercih">(Tercih:</t> <span data-bind="text: convertCtx.preferredPersonnelName"></span>)
                        </span>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.waitlist.auto.tarih">Tarih *</t></label>
                            <input type="date" class="form-control form-control-sm" data-bind="value: convertForm.date" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.waitlist.auto.saat">Saat *</t></label>
                            <input type="time" class="form-control form-control-sm" data-bind="value: convertForm.time" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.waitlist.auto.personel">Personel *</t></label>
                            <select class="form-select form-select-sm"
                                    data-bind="options: staff, optionsText: 'fullName', optionsValue: 'id', value: convertForm.personnelId, optionsCaption: 'Secin...'"></select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.appointments.notes">Not</t></label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: convertForm.notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: submitConvert, disable: isConverting">
                        <span data-bind="visible: isConverting" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isConverting()"></i><t key="salon.waitlist.auto.randevu_olustur">Randevu Oluştur</t>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Yeni Bekleme Kayit Modal -->
    <div class="modal fade" id="waitlistModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><i class="bi bi-clock-history me-2"></i><t key="salon.waitlist.auto.bekleme_listesine_ekle">Bekleme Listesine Ekle</t></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.waitlist.auto.musteri">Müşteri *</t></label>
                            <select class="form-select form-select-sm" data-bind="options: clients, optionsText: 'fullName', optionsValue: 'id', value: form.slnClientId, optionsCaption: 'Secin...'"></select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.waitlist.auto.hizmet">Hizmet *</t></label>
                            <select class="form-select form-select-sm" data-bind="options: services, optionsText: 'name', optionsValue: 'id', value: form.serviceId, optionsCaption: 'Secin...'"></select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.waitlist.auto.tercih_edilen_personel">Tercih Edilen Personel</t></label>
                            <select class="form-select form-select-sm" data-bind="options: staff, optionsText: 'fullName', optionsValue: 'id', value: form.preferredPersonnelId, optionsCaption: 'Farketmez'"></select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.waitlist.auto.tercih_edilen_tarih">Tercih Edilen Tarih *</t></label>
                            <input type="date" class="form-control form-control-sm" data-bind="value: form.preferredDate" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.waitlist.auto.saat_dilimi">Saat Dilimi</t></label>
                            <select class="form-select form-select-sm" data-bind="value: form.preferredTimeSlot">
                                <option value=""><t key="salon.waitlist.auto.farketmez">Farketmez</t></option>
                                <option value="Sabah"><t key="salon.waitlist.auto.sabah_09_12">Sabah (09-12)</t></option>
                                <option value="Ogle"><t key="salon.waitlist.auto.ogle_12_15">Öğle (12-15)</t></option>
                                <option value="Aksam"><t key="salon.waitlist.auto.aksam_15_19">Akşam (15-19)</t></option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.appointments.notes">Not</t></label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: form.notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i><t key="salon.common.btn.save">Kaydet</t>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Waitlist.js" asp-append-version="true"></script>
}
