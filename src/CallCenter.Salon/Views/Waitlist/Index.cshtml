@{
    ViewData["Title"] = "Bekleme Listesi";
}

<div id="waitlist-vm">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="input-group" style="max-width: 320px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="Musteri veya hizmet ara..." data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
        </div>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i>Yeni Kayit
        </button>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Musteri</th>
                            <th>Hizmet</th>
                            <th>Tercih Edilen Personel</th>
                            <th>Tarih</th>
                            <th>Saat Dilimi</th>
                            <th>Durum</th>
                            <th style="width:150px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredEntries">
                        <tr>
                            <td class="fw-semibold small" data-bind="text: clientName"></td>
                            <td class="small" data-bind="text: serviceName"></td>
                            <td class="small" data-bind="text: preferredPersonnelName || '-'"></td>
                            <td class="small" data-bind="text: new Date(preferredDate).toLocaleDateString('tr-TR')"></td>
                            <td class="small" data-bind="text: preferredTimeSlot || '-'"></td>
                            <td class="small">
                                <span class="badge" data-bind="text: $parent.statusText(statusId), css: $parent.statusBadge(statusId)"></span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <!-- ko if: statusId === 1 -->
                                    <button class="btn btn-outline-info" title="Bildir" data-bind="click: $parent.notifyEntry">
                                        <i class="bi bi-bell"></i>
                                    </button>
                                    <!-- /ko -->
                                    <!-- ko if: statusId <= 2 -->
                                    <button class="btn btn-outline-success" title="Randevu Alindi" data-bind="click: $parent.appointmentMade">
                                        <i class="bi bi-calendar-check"></i>
                                    </button>
                                    <!-- /ko -->
                                    <button class="btn btn-outline-danger" title="Sil" data-bind="click: $parent.removeEntry">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: filteredEntries().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-clock-history" style="font-size:2rem;"></i>
                <p class="mt-2 small">Bekleme listesinde kayit yok</p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Yeni Kayit Modal -->
    <div class="modal fade" id="waitlistModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><i class="bi bi-clock-history me-2"></i>Bekleme Listesine Ekle</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small">Musteri *</label>
                            <select class="form-select form-select-sm" data-bind="options: clients, optionsText: 'fullName', optionsValue: 'id', value: form.slnClientId, optionsCaption: 'Secin...'"></select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Hizmet *</label>
                            <select class="form-select form-select-sm" data-bind="options: services, optionsText: 'name', optionsValue: 'id', value: form.serviceId, optionsCaption: 'Secin...'"></select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Tercih Edilen Personel</label>
                            <select class="form-select form-select-sm" data-bind="options: staff, optionsText: 'fullName', optionsValue: 'id', value: form.preferredPersonnelId, optionsCaption: 'Farketmez'"></select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Tercih Edilen Tarih *</label>
                            <input type="date" class="form-control form-control-sm" data-bind="value: form.preferredDate" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Saat Dilimi</label>
                            <select class="form-select form-select-sm" data-bind="value: form.preferredTimeSlot">
                                <option value="">Farketmez</option>
                                <option value="Sabah">Sabah (09-12)</option>
                                <option value="Ogle">Ogle (12-15)</option>
                                <option value="Aksam">Aksam (15-19)</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Not</label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: form.notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Waitlist.js" asp-append-version="true"></script>
}
