@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.services.auto.title", "Hizmetler");
}

<div id="services-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="input-group" style="max-width: 320px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="@(Translation.T("salon.services.auto.hizmet_ara", "Hizmet ara..."))" data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm" data-bind="click: openResourceManager">
                <i class="bi bi-boxes me-1"></i><t key="salon.services.resources">Kaynaklar</t>
            </button>
            <button class="btn btn-outline-primary btn-sm" data-bind="click: openNewCategory">
                <i class="bi bi-folder-plus me-1"></i><t key="salon.services.auto.yeni_kategori">Yeni Kategori</t>
            </button>
            <button class="btn btn-primary btn-sm" data-bind="click: openNewService">
                <i class="bi bi-plus-lg me-1"></i><t key="salon.services.auto.yeni_hizmet">Yeni Hizmet</t>
            </button>
        </div>
    </div>

    <!-- Kategori Bazli Hizmet Listesi -->
    <div data-bind="foreach: filteredCategories">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0">
                    <i class="bi bi-folder me-2 text-purple"></i><span data-bind="text: name"></span>
                    <span class="badge bg-secondary ms-1" data-bind="text: services.length"></span>
                </h6>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-secondary" title="@(Translation.T("salon.services.auto.kategori_duzenle", "Kategori Düzenle"))" data-bind="click: $parent.openEditCategory">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-outline-danger" title="@(Translation.T("salon.services.auto.kategori_sil", "Kategori Sil"))" data-bind="click: $parent.removeCategory">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th><t key="salon.services.auto.hizmet_adi">Hizmet Adı</t></th>
                                <th><t key="salon.services.auto.sure_dk">Süre (dk)</t></th>
                                <th><t key="salon.services.resources">Kaynaklar</t></th>
                                <th><t key="salon.services.auto.fiyat">Fiyat</t></th>
                                <th><t key="salon.appointments.status">Durum</t></th>
                                <th style="width: 80px;"></th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: services">
                            <tr>
                                <td class="small fw-semibold" data-bind="text: name"></td>
                                <td class="small" data-bind="text: durationMinutes + ' dk'"></td>
                                <td class="small text-muted" data-bind="text: $parents[1].resourceSummary($data)"></td>
                                <td class="small" data-bind="text: (price || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></td>
                                <td>
                                    <span class="badge" data-bind="text: isActive ? 'Aktif' : 'Pasif', css: isActive ? 'bg-success' : 'bg-secondary'"></span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary" title="@(Translation.T("salon.services.auto.duzenle", "Düzenle"))" data-bind="click: $parents[1].openEditService">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" title="@(Translation.T("salon.common.btn.delete_tooltip", "Sil"))" data-bind="click: $parents[1].removeService">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <!-- ko if: services.length === 0 -->
                <div class="text-center text-muted py-3 small"><t key="salon.services.auto.bu_kategoride_hizmet_yok">Bu kategoride hizmet yok</t></div>
                <!-- /ko -->
            </div>
        </div>
    </div>

    <!-- Kategorisiz Hizmetler -->
    <!-- ko if: uncategorizedServices().length > 0 -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white">
            <h6 class="mb-0 text-muted"><i class="bi bi-folder me-2"></i><t key="salon.services.auto.kategorisiz">Kategorisiz</t></h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th><t key="salon.services.auto.hizmet_adi">Hizmet Adı</t></th>
                            <th><t key="salon.services.auto.sure_dk_2">Süre (dk)</t></th>
                            <th><t key="salon.services.resources">Kaynaklar</t></th>
                            <th><t key="salon.services.auto.fiyat_2">Fiyat</t></th>
                            <th><t key="salon.appointments.status">Durum</t></th>
                            <th style="width: 80px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: uncategorizedServices">
                        <tr>
                            <td class="small fw-semibold" data-bind="text: name"></td>
                            <td class="small" data-bind="text: durationMinutes + ' dk'"></td>
                            <td class="small text-muted" data-bind="text: $parent.resourceSummary($data)"></td>
                            <td class="small" data-bind="text: (price || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></td>
                            <td>
                                <span class="badge" data-bind="text: isActive ? 'Aktif' : 'Pasif', css: isActive ? 'bg-success' : 'bg-secondary'"></span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" title="@(Translation.T("salon.services.auto.duzenle", "Düzenle"))" data-bind="click: $parent.openEditService">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" title="@(Translation.T("salon.common.btn.delete_tooltip", "Sil"))" data-bind="click: $parent.removeService">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <!-- /ko -->

    <!-- ko if: filteredCategories().length === 0 && uncategorizedServices().length === 0 -->
    <div class="text-center text-muted py-5">
        <i class="bi bi-list-check" style="font-size: 2rem;"></i>
        <p class="mt-2 small"><t key="salon.services.auto.henuz_hizmet_eklenmemis">Henüz hizmet eklenmemis</t></p>
    </div>
    <!-- /ko -->

    <!-- Kategori Modal -->
    <div class="modal fade" id="categoryModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditingCategory() ? salonT('salon.services.auto.kategori_duzenle', 'Kategori Düzenle') : salonT('salon.services.auto.yeni_kategori', 'Yeni Kategori')"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small"><t key="salon.services.auto.kategori_adi">Kategori Adı *</t></label>
                        <input type="text" class="form-control form-control-sm" data-bind="value: categoryForm.name" />
                    </div>
                    <div>
                        <label class="form-label small"><t key="salon.services.auto.sira_no">Sıra No</t></label>
                        <input type="number" class="form-control form-control-sm" data-bind="value: categoryForm.sortOrder" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: saveCategory, disable: isSaving">
                        <i class="bi bi-check-lg me-1"></i><t key="salon.common.btn.save">Kaydet</t>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Hizmet Modal -->
    <div class="modal fade" id="serviceModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditingService() ? salonT('salon.services.auto.hizmet_duzenle', 'Hizmet Düzenle') : salonT('salon.services.auto.yeni_hizmet', 'Yeni Hizmet')"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.services.auto.hizmet_adi_2">Hizmet Adı *</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: serviceForm.name" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.reports.category">Kategori</t></label>
                            <div class="position-relative">
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="@(Translation.T("salon.services.auto.kategori_yazin", "Kategori yazin..."))"
                                       autocomplete="off"
                                       data-bind="value: categoryAutocomplete.query, valueUpdate: 'afterkeydown',
                                                  event: { focus: categoryAutocomplete.onFocus, blur: categoryAutocomplete.onBlur, keydown: categoryAutocomplete.onKeydown }" />
                                <!-- ko if: categoryAutocomplete.selectedName() -->
                                <span class="position-absolute top-50 end-0 translate-middle-y me-2" style="cursor:pointer; z-index:2;"
                                      data-bind="click: categoryAutocomplete.clear" title="@(Translation.T("salon.memberships.clear", "Temizle"))">
                                    <i class="bi bi-x-circle text-muted"></i>
                                </span>
                                <!-- /ko -->
                                <div class="dropdown-menu w-100 shadow-sm" style="max-height:220px; overflow-y:auto;"
                                     data-bind="css: { show: categoryAutocomplete.showDropdown }">
                                    <!-- ko foreach: categoryAutocomplete.filteredItems -->
                                    <a class="dropdown-item small py-1 px-2" href="#"
                                       data-bind="text: $parent.categoryAutocomplete.getDisplayText($data), click: $parent.categoryAutocomplete.select,
                                                  css: { active: $parent.categoryAutocomplete.highlightIndex() === $index() },
                                                  event: { mousedown: function(){ $parent.categoryAutocomplete.select($data); } }"></a>
                                    <!-- /ko -->
                                    <!-- ko if: categoryAutocomplete.filteredItems().length === 0 && categoryAutocomplete.query().length > 0 -->
                                    <span class="dropdown-item-text small text-muted"><t key="salon.common.search.no_results">Sonuç bulunamadı</t></span>
                                    <!-- /ko -->
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.services.auto.sure_dk_required">Süre (dk) *</t></label>
                            <input type="number" class="form-control form-control-sm" data-bind="value: serviceForm.durationMinutes" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.services.auto.fiyat_tl_required">Fiyat (TL) *</t></label>
                            <input type="number" class="form-control form-control-sm" step="0.01" data-bind="value: serviceForm.price" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.services.parent_service">Ana hizmet / varyant</t></label>
                            <select class="form-select form-select-sm" data-bind="value: serviceForm.parentServiceId">
                                <option value=""><t key="salon.common.none">Yok</t></option>
                                <!-- ko foreach: parentServiceOptions -->
                                <option data-bind="value: id, text: name"></option>
                                <!-- /ko -->
                            </select>
                        </div>
                        <div class="col-6"></div>
                        <div class="col-4">
                            <label class="form-label small"><t key="salon.services.buffer_before">Hazirlik (dk)</t></label>
                            <input type="number" class="form-control form-control-sm" data-bind="value: serviceForm.bufferBeforeMinutes" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small"><t key="salon.services.processing">Islem/Bekleme (dk)</t></label>
                            <input type="number" class="form-control form-control-sm" data-bind="value: serviceForm.processingMinutes" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small"><t key="salon.services.buffer_after">Toparlama (dk)</t></label>
                            <input type="number" class="form-control form-control-sm" data-bind="value: serviceForm.bufferAfterMinutes" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.appointments.status">Durum</t></label>
                            <select class="form-select form-select-sm" data-bind="value: serviceForm.isActive">
                                <option value="true"><t key="salon.common.status_active">Aktif</t></option>
                                <option value="false"><t key="salon.common.status_inactive">Pasif</t></option>
                            </select>
                        </div>
                        <div class="col-6 d-flex align-items-end">
                            <div class="d-flex flex-wrap gap-3 small">
                                <label class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" data-bind="checked: serviceForm.isAddOn" />
                                    <span class="form-check-label"><t key="salon.services.addon">Ek hizmet</t></span>
                                </label>
                                <label class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" data-bind="checked: serviceForm.requiresConsultation" />
                                    <span class="form-check-label"><t key="salon.services.requires_consultation">On gorusme</t></span>
                                </label>
                                <label class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" data-bind="checked: serviceForm.requiresPatchTest" />
                                    <span class="form-check-label"><t key="salon.services.requires_patch_test">Patch test</t></span>
                                </label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.services.prerequisite_notes">On kosul / uyarilar</t></label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: serviceForm.prerequisiteNotes"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.services.resource_requirements">Kaynak/oda/cihaz ihtiyaci</t></label>
                            <!-- ko if: serviceResourceSelections().length > 0 -->
                            <div class="row g-2" data-bind="foreach: serviceResourceSelections">
                                <div class="col-md-6">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text flex-grow-1 text-start" data-bind="text: name"></span>
                                        <input type="number" min="0" class="form-control" style="max-width:90px;" data-bind="value: quantityRequired" />
                                    </div>
                                </div>
                            </div>
                            <!-- /ko -->
                            <!-- ko if: serviceResourceSelections().length === 0 -->
                            <div class="text-muted small"><t key="salon.services.no_resources_yet">Once Kaynaklar butonundan cihaz/oda ekleyin.</t></div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: saveService, disable: isSaving">
                        <i class="bi bi-check-lg me-1"></i><t key="salon.common.btn.save">Kaydet</t>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="resourceModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><t key="salon.services.resources">Kaynaklar</t></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small"><t key="salon.services.resource_name">Kaynak adi</t></label>
                            <input class="form-control form-control-sm" data-bind="value: resourceForm.name" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small"><t key="salon.services.resource_kind">Tip</t></label>
                            <input class="form-control form-control-sm" placeholder="Oda, cihaz, masa..." data-bind="value: resourceForm.resourceKind" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small"><t key="salon.services.quantity">Adet</t></label>
                            <input type="number" min="1" class="form-control form-control-sm" data-bind="value: resourceForm.quantity" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small"><t key="salon.appointments.status">Durum</t></label>
                            <select class="form-select form-select-sm" data-bind="value: resourceForm.isActive">
                                <option value="true"><t key="salon.common.status_active">Aktif</t></option>
                                <option value="false"><t key="salon.common.status_inactive">Pasif</t></option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.appointments.notes">Not</t></label>
                            <input class="form-control form-control-sm" data-bind="value: resourceForm.notes" />
                        </div>
                        <div class="col-12 text-end">
                            <button class="btn btn-primary btn-sm" data-bind="click: saveResource">
                                <i class="bi bi-check-lg me-1"></i><t key="salon.common.btn.save">Kaydet</t>
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th><t key="salon.services.resource_name">Kaynak adi</t></th>
                                    <th><t key="salon.services.resource_kind">Tip</t></th>
                                    <th><t key="salon.services.quantity">Adet</t></th>
                                    <th><t key="salon.appointments.status">Durum</t></th>
                                    <th style="width:90px;"></th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: resources">
                                <tr>
                                    <td data-bind="text: name"></td>
                                    <td data-bind="text: resourceKind || '-'"></td>
                                    <td data-bind="text: quantity"></td>
                                    <td><span class="badge" data-bind="text: isActive ? salonT('salon.common.status_active', 'Aktif') : salonT('salon.common.status_inactive', 'Pasif'), css: isActive ? 'bg-success' : 'bg-secondary'"></span></td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-secondary" data-bind="click: $parent.editResource"><i class="bi bi-pencil"></i></button>
                                            <button class="btn btn-outline-danger" data-bind="click: $parent.removeResource"><i class="bi bi-trash"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="comboModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><t key="salon.services.combos">Combos</t></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-5">
                            <label class="form-label small"><t key="salon.services.combo_name">Combo adi</t></label>
                            <input class="form-control form-control-sm" data-bind="value: comboForm.name" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small"><t key="salon.services.auto.fiyat">Fiyat</t></label>
                            <input type="number" step="0.01" class="form-control form-control-sm" data-bind="value: comboForm.price" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small"><t key="salon.appointments.status">Durum</t></label>
                            <select class="form-select form-select-sm" data-bind="value: comboForm.isActive">
                                <option value="true"><t key="salon.common.status_active">Aktif</t></option>
                                <option value="false"><t key="salon.common.status_inactive">Pasif</t></option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.services.combo_description">Aciklama</t></label>
                            <input class="form-control form-control-sm" data-bind="value: comboForm.description" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.appointments.services_required">Hizmetler *</t></label>
                            <div class="d-flex flex-wrap gap-1" data-bind="foreach: allServicesFlat">
                                <button type="button" class="btn btn-sm"
                                        data-bind="click: function(){ $parent.toggleComboService(id); },
                                                   css: $parent.comboForm.serviceIds().indexOf(id) >= 0 ? 'btn-success' : 'btn-outline-secondary'">
                                    <span data-bind="text: name"></span>
                                </button>
                            </div>
                        </div>
                        <div class="col-12 text-end">
                            <button class="btn btn-primary btn-sm" data-bind="click: saveCombo">
                                <i class="bi bi-check-lg me-1"></i><t key="salon.common.btn.save">Kaydet</t>
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th><t key="salon.services.combo_name">Combo adi</t></th>
                                    <th><t key="salon.appointments.services">Hizmetler</t></th>
                                    <th><t key="salon.services.auto.fiyat">Fiyat</t></th>
                                    <th><t key="salon.services.auto.sure_dk">Sure (dk)</t></th>
                                    <th style="width:90px;"></th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: combos">
                                <tr>
                                    <td data-bind="text: name"></td>
                                    <td class="small text-muted" data-bind="text: $parent.comboSummary($data)"></td>
                                    <td data-bind="text: (price || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></td>
                                    <td data-bind="text: durationMinutes"></td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-secondary" data-bind="click: $parent.editCombo"><i class="bi bi-pencil"></i></button>
                                            <button class="btn btn-outline-danger" data-bind="click: $parent.removeCombo"><i class="bi bi-trash"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-purple { color: #7b1fa2 !important; }
</style>

@section Scripts {
    <script src="~/js/Services.js" asp-append-version="true"></script>
}
