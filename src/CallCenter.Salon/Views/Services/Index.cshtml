@{
    ViewData["Title"] = "Hizmetler";
}

<div id="services-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="input-group" style="max-width: 320px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="Hizmet ara..." data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary btn-sm" data-bind="click: openNewCategory">
                <i class="bi bi-folder-plus me-1"></i>Yeni Kategori
            </button>
            <button class="btn btn-primary btn-sm" data-bind="click: openNewService">
                <i class="bi bi-plus-lg me-1"></i>Yeni Hizmet
            </button>
        </div>
    </div>

    <!-- Kategori Bazli Hizmet Listesi -->
    <div data-bind="foreach: filteredCategories">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0">
                    <i class="bi bi-folder me-2 text-purple"></i><span data-bind="text: name"></span>
                    <span class="badge bg-secondary ms-1" data-bind="text: services.length"></span>
                </h6>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-secondary" title="Kategori Duzenle" data-bind="click: $parent.openEditCategory">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-outline-danger" title="Kategori Sil" data-bind="click: $parent.removeCategory">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Hizmet Adi</th>
                                <th>Sure (dk)</th>
                                <th>Fiyat</th>
                                <th>Durum</th>
                                <th style="width: 80px;"></th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: services">
                            <tr>
                                <td class="small fw-semibold" data-bind="text: name"></td>
                                <td class="small" data-bind="text: duration + ' dk'"></td>
                                <td class="small" data-bind="text: price.toLocaleString('tr-TR') + ' TL'"></td>
                                <td>
                                    <span class="badge" data-bind="text: isActive ? 'Aktif' : 'Pasif', css: isActive ? 'bg-success' : 'bg-secondary'"></span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary" title="Duzenle" data-bind="click: $parents[1].openEditService">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" title="Sil" data-bind="click: $parents[1].removeService">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <!-- ko if: services.length === 0 -->
                <div class="text-center text-muted py-3 small">Bu kategoride hizmet yok</div>
                <!-- /ko -->
            </div>
        </div>
    </div>

    <!-- Kategorisiz Hizmetler -->
    <!-- ko if: uncategorizedServices().length > 0 -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white">
            <h6 class="mb-0 text-muted"><i class="bi bi-folder me-2"></i>Kategorisiz</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Hizmet Adi</th>
                            <th>Sure (dk)</th>
                            <th>Fiyat</th>
                            <th>Durum</th>
                            <th style="width: 80px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: uncategorizedServices">
                        <tr>
                            <td class="small fw-semibold" data-bind="text: name"></td>
                            <td class="small" data-bind="text: duration + ' dk'"></td>
                            <td class="small" data-bind="text: price.toLocaleString('tr-TR') + ' TL'"></td>
                            <td>
                                <span class="badge" data-bind="text: isActive ? 'Aktif' : 'Pasif', css: isActive ? 'bg-success' : 'bg-secondary'"></span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" title="Duzenle" data-bind="click: $parent.openEditService">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" title="Sil" data-bind="click: $parent.removeService">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <!-- /ko -->

    <!-- ko if: filteredCategories().length === 0 && uncategorizedServices().length === 0 -->
    <div class="text-center text-muted py-5">
        <i class="bi bi-list-check" style="font-size: 2rem;"></i>
        <p class="mt-2 small">Henuz hizmet eklenmemis</p>
    </div>
    <!-- /ko -->

    <!-- Kategori Modal -->
    <div class="modal fade" id="categoryModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditingCategory() ? 'Kategori Duzenle' : 'Yeni Kategori'"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small">Kategori Adi *</label>
                        <input type="text" class="form-control form-control-sm" data-bind="value: categoryForm.name" />
                    </div>
                    <div>
                        <label class="form-label small">Sira No</label>
                        <input type="number" class="form-control form-control-sm" data-bind="value: categoryForm.sortOrder" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: saveCategory, disable: isSaving">
                        <i class="bi bi-check-lg me-1"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Hizmet Modal -->
    <div class="modal fade" id="serviceModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditingService() ? 'Hizmet Duzenle' : 'Yeni Hizmet'"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small">Hizmet Adi *</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: serviceForm.name" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Kategori</label>
                            <div class="position-relative" data-bind="with: categoryAutocomplete">
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="Kategori yazin..."
                                       autocomplete="off"
                                       data-bind="value: query, valueUpdate: 'afterkeydown',
                                                  event: { focus: onFocus, blur: onBlur, keydown: onKeydown }" />
                                <!-- ko if: selectedName() -->
                                <span class="position-absolute top-50 end-0 translate-middle-y me-2" style="cursor:pointer; z-index:2;"
                                      data-bind="click: clear" title="Temizle">
                                    <i class="bi bi-x-circle text-muted"></i>
                                </span>
                                <!-- /ko -->
                                <div class="dropdown-menu w-100 shadow-sm" style="max-height:220px; overflow-y:auto;"
                                     data-bind="css: { show: showDropdown }">
                                    <!-- ko foreach: filteredItems -->
                                    <a class="dropdown-item small py-1 px-2" href="#"
                                       data-bind="text: $parent.getDisplayText($data), click: $parent.select,
                                                  css: { active: $parent.highlightIndex() === $index() },
                                                  event: { mousedown: function(){ $parent.select($data); } }"></a>
                                    <!-- /ko -->
                                    <!-- ko if: filteredItems().length === 0 && query().length > 0 -->
                                    <span class="dropdown-item-text small text-muted">Sonuc bulunamadi</span>
                                    <!-- /ko -->
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Sure (dk) *</label>
                            <input type="number" class="form-control form-control-sm" data-bind="value: serviceForm.duration" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Fiyat (TL) *</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" data-bind="value: serviceForm.price" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Durum</label>
                            <select class="form-select form-select-sm" data-bind="value: serviceForm.isActive">
                                <option value="true">Aktif</option>
                                <option value="false">Pasif</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Aciklama</label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: serviceForm.description"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: saveService, disable: isSaving">
                        <i class="bi bi-check-lg me-1"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-purple { color: #7b1fa2 !important; }
</style>

@section Scripts {
    <script src="~/js/Services.js" asp-append-version="true"></script>
}
