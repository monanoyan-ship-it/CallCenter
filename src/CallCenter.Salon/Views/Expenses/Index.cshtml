@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.expenses.auto.title", "Masraflar");
}

<div id="expenses-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <div class="input-group" style="max-width: 280px;">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="@(Translation.T("salon.expenses.auto.masraf_ara", "Masraf ara..."))" data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
            </div>
            <select class="form-select form-select-sm" style="width:160px;" data-bind="options: expenseCategories, optionsText: 'name', optionsValue: 'name', value: selectedCategoryName, optionsCaption: 'Tüm Kategoriler'"></select>
            <input type="date" class="form-control form-control-sm" style="width:150px;" data-bind="value: filterStartDate" />
            <span class="small text-muted">-</span>
            <input type="date" class="form-control form-control-sm" style="width:150px;" data-bind="value: filterEndDate" />
        </div>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i><t key="salon.expenses.auto.yeni_masraf">Yeni Masraf</t>
        </button>
    </div>

    <!-- Ozet -->
    <div class="row g-2 mb-3">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .7rem;"><t key="salon.expenses.auto.toplam_masraf">Toplam Masraf</t></div>
                    <div class="fw-bold text-danger" data-bind="text: (totalExpense() || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .7rem;"><t key="salon.expenses.auto.bu_ayin_masrafi">Bu Ayın Masrafı</t></div>
                    <div class="fw-bold text-warning" data-bind="text: (monthlyExpense() || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .7rem;"><t key="salon.expenses.auto.kayit_sayisi">Kayıt Sayısı</t></div>
                    <div class="fw-bold" data-bind="text: filteredExpenses().length"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th><t key="salon.panel.payments.date">Tarih</t></th>
                            <th><t key="salon.reports.category">Kategori</t></th>
                            <th><t key="salon.common.description">Açıklama</t></th>
                            <th><t key="salon.panel.payments.amount">Tutar</t></th>
                            <th><t key="salon.modules.payment_method">Ödeme</t></th>
                            <th><t key="salon.appointments.status">Durum</t></th>
                            <th style="width: 140px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredExpenses">
                        <tr>
                            <td class="small" data-bind="text: new Date(expenseDate).toLocaleDateString(document.documentElement.lang || undefined)"></td>
                            <td class="small" data-bind="text: categoryName"></td>
                            <td class="small fw-semibold" data-bind="text: description"></td>
                            <td class="small fw-semibold text-danger" data-bind="text: (amount || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></td>
                            <td class="small" data-bind="text: paymentMethodText"></td>
                            <td>
                                <span class="badge" data-bind="text: statusText, css: statusCss"></span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <!-- ko if: statusId === 1 -->
                                    <button class="btn btn-outline-success" title="@(Translation.T("salon.common.btn.confirm", "Onayla"))" data-bind="click: $parent.approveExpense">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" title="@(Translation.T("salon.expenses.auto.title_reddet", "Reddet"))" data-bind="click: $parent.rejectExpense">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                    <!-- /ko -->
                                    <button class="btn btn-outline-secondary" title="@(Translation.T("salon.expenses.auto.duzenle", "Düzenle"))" data-bind="click: $parent.openEdit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" title="@(Translation.T("salon.common.btn.delete_tooltip", "Sil"))" data-bind="click: $parent.remove">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: filteredExpenses().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-credit-card" style="font-size: 2rem;"></i>
                <p class="mt-2 small"><t key="salon.expenses.auto.masraf_kaydi_bulunamadi">Masraf kaydı bulunamadı</t></p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="expenseModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditing() ? salonT('salon.expenses.auto.masraf_duzenle', 'Masraf Düzenle') : salonT('salon.expenses.auto.yeni_masraf', 'Yeni Masraf')"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.expenses.auto.tarih">Tarih *</t></label>
                            <input type="date" class="form-control form-control-sm" data-bind="value: form.expenseDate" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.expenses.auto.kategori">Kategori *</t></label>
                            <div class="position-relative">
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="@(Translation.T("salon.expenses.auto.kategori_yazin", "Kategori yazın..."))"
                                       autocomplete="off"
                                       data-expense-category-input="1"
                                       data-bind="textInput: categoryAutocomplete.query,
                                                  event: { focus: categoryAutocomplete.onFocus, blur: categoryAutocomplete.onBlur, keydown: categoryAutocomplete.onKeydown }" />
                                <!-- ko if: categoryAutocomplete.selectedName() -->
                                <span class="position-absolute top-50 end-0 translate-middle-y me-2" style="cursor:pointer; z-index:2;"
                                      data-bind="click: categoryAutocomplete.clear" title="@(Translation.T("salon.memberships.clear", "Temizle"))">
                                    <i class="bi bi-x-circle text-muted"></i>
                                </span>
                                <!-- /ko -->
                                <div class="dropdown-menu w-100 shadow-sm" style="max-height:220px; overflow-y:auto;"
                                     data-bind="css: { show: categoryAutocomplete.showDropdown }">
                                    <!-- ko foreach: categoryAutocomplete.filteredItems -->
                                    <a class="dropdown-item small py-1 px-2" href="#"
                                       data-bind="text: $parent.categoryAutocomplete.getDisplayText($data), click: $parent.categoryAutocomplete.select,
                                                  css: { active: $parent.categoryAutocomplete.highlightIndex() === $index() },
                                                  event: { mousedown: function(){ $parent.categoryAutocomplete.select($data); } }"></a>
                                    <!-- /ko -->
                                    <!-- ko if: categoryAutocomplete.filteredItems().length === 0 && categoryAutocomplete.query().length > 0 -->
                                    <span class="dropdown-item-text small text-muted"><t key="salon.common.search.no_results">Sonuç bulunamadı</t></span>
                                    <!-- /ko -->
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.expenses.auto.aciklama">Açıklama *</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="textInput: form.description" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.expenses.auto.tutar_tl">Tutar (TL) *</t></label>
                            <input type="number" class="form-control form-control-sm" step="0.01" data-bind="textInput: form.amount" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.expenses.auto.odeme_yontemi">Ödeme Yöntemi</t></label>
                            <select class="form-select form-select-sm" data-bind="value: form.paymentMethodId">
                                <option value="1"><t key="salon.expenses.auto.nakit">Nakit</t></option>
                                <option value="2"><t key="salon.expenses.auto.kredi_karti">Kredi Kartı</t></option>
                                <option value="3"><t key="salon.expenses.auto.havale_eft">Havale/EFT</t></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i><t key="salon.common.btn.save">Kaydet</t>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Expenses.js" asp-append-version="true"></script>
}
