@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.branches.title", "Şubeler");
}

<div id="branches-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0"><t key="salon.branches.auto.sube_yonetimi">Şube Yönetimi</t></h6>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i><t key="salon.branches.auto.yeni_sube">Yeni Şube</t>
        </button>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th><t key="salon.common.branch">Şube</t></th>
                            <th>Slug</th>
                            <th><t key="salon.common.address">Adres</t></th>
                            <th><t key="salon.common.phone">Telefon</t></th>
                            <th><t key="salon.common.manager">Müdür</t></th>
                            <th><t key="salon.appointments.status">Durum</t></th>
                            <th style="width:100px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: branches">
                        <tr>
                            <td class="fw-semibold small">
                                <!-- ko if: photoUrl -->
                                <img data-bind="attr: { src: photoUrl, alt: name }" class="me-2" style="width:28px;height:28px;border-radius:50%;object-fit:cover;" />
                                <!-- /ko -->
                                <span data-bind="text: name"></span>
                                <!-- ko if: isHeadquarter -->
                                <span class="badge bg-primary ms-1" style="font-size:0.65rem;"><t key="salon.branches.auto.merkez">Merkez</t></span>
                                <!-- /ko -->
                            </td>
                            <td class="small text-muted" data-bind="text: slug || '-'"></td>
                            <td class="small" data-bind="text: (city || '') + (district ? ' / ' + district : '') || address || '-'"></td>
                            <td class="small" data-bind="text: phone || '-'"></td>
                            <td class="small" data-bind="text: managerName || '-'"></td>
                            <td class="small">
                                <span class="badge" data-bind="text: isActive ? salonT('salon.status.active', 'Aktif') : salonT('salon.status.passive', 'Pasif'), css: isActive ? 'bg-success' : 'bg-secondary'"></span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-dark" title="@(Translation.T("salon.branches.auto.title_qr_kod", "QR Kod"))" data-bind="click: $parent.showQr">
                                        <i class="bi bi-qr-code"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary" title="@(Translation.T("salon.branches.auto.duzenle", "Düzenle"))" data-bind="click: $parent.openEdit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <!-- ko if: !isHeadquarter -->
                                    <button class="btn btn-outline-danger" title="@(Translation.T("salon.common.btn.delete_tooltip", "Sil"))" data-bind="click: $parent.remove">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    <!-- /ko -->
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: branches().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-building" style="font-size:2rem;"></i>
                <p class="mt-2 small"><t key="salon.branches.auto.henuz_sube_eklenmemis">Henüz şube eklenmemiş</t></p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- QR Modal -->
    <div class="modal fade" id="qrModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><i class="bi bi-qr-code me-1"></i><t key="salon.branches.auto.sube_qr_kodu">Şube QR Kodu</t></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <h6 class="mb-1" data-bind="text: qrBranchName"></h6>
                    <div class="text-muted small mb-3"><t key="salon.branches.auto.musteri_okuttugunda_su_sayfa_acilir">Müşteri okuttugunda su sayfa acilir:</t></div>
                    <div class="text-break small text-primary mb-3" style="font-family:monospace;" data-bind="text: qrUrl"></div>
                    <div id="qrCanvas" class="d-inline-block p-3 bg-white border rounded shadow-sm"></div>
                    <div class="mt-3 small text-muted">
                        <t key="salon.branches.qr_print_hint">Bu QR kodu yazdırıp cama asın. Okutan müşteri doğrudan şubenizin randevu sayfasına gider.</t>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.branches.auto.kapat">Kapat</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: downloadQr">
                        <i class="bi bi-download me-1"></i><t key="salon.branches.download_png">PNG indir</t>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="branchModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditing() ? salonT('salon.branches.auto.sube_duzenle', 'Şube Düzenle') : salonT('salon.branches.auto.yeni_sube', 'Yeni Şube')"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Genel Bilgiler -->
                    <h6 class="text-muted small fw-bold mb-2"><i class="bi bi-building me-1"></i><t key="salon.branches.general_info">Genel Bilgiler</t></h6>
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.branches.auto.sube_adi_2">Şube Adı *</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.name" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.branches.profile_slug">Profil Adresi (slug)</t></label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">corplynk.com/salon/</span>
                                <input type="text" class="form-control" data-bind="value: form.slug" placeholder="@(Translation.T("salon.branches.auto.sube_adi", "şube-adi"))" />
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.common.address">Adres</t></label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: form.address"></textarea>
                        </div>
                        <div class="col-4">
                            <label class="form-label small"><t key="salon.common.city">İl</t></label>
                            <input type="text" class="form-control form-control-sm" list="tr-cities-list"
                                   data-bind="value: form.city, event: { blur: function(d,e){ if (window.normalizeTrCity) form.city(window.normalizeTrCity(e.target.value)); } }" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small"><t key="salon.common.district">İlçe</t></label>
                            <input type="text" class="form-control form-control-sm"
                                   data-bind="value: form.district, event: { blur: function(d,e){ if (window.normalizeTrCity) form.district(window.normalizeTrCity(e.target.value)); } }" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small"><t key="salon.common.phone">Telefon</t></label>
                            <div data-bind="phoneInput: form.phone"></div>
                        </div>
                        <div class="col-4">
                            <label class="form-label small"><t key="salon.account.email">E-posta</t></label>
                            <input type="email" class="form-control form-control-sm" data-bind="value: form.email" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small d-flex align-items-center justify-content-between">
                                <span><i class="bi bi-geo-alt me-1"></i><t key="salon.branches.map_location">Harita Konumu</t></span>
                                <button type="button" class="btn btn-outline-primary btn-sm py-0" data-bind="click: geocodeAddress, disable: isGeocoding">
                                    <span data-bind="visible: isGeocoding" class="spinner-border spinner-border-sm me-1"></span>
                                    <i class="bi bi-search me-1" data-bind="visible: !isGeocoding()"></i>
                                    <span data-bind="text: isGeocoding() ? salonT('salon.branches.auto.araniyor', 'Aranıyor...') : salonT('salon.branches.find_from_address', 'Adresten Bul')"></span>
                                </button>
                            </label>
                            <div id="branch-map-picker" style="height:220px;border-radius:8px;border:1px solid #dee2e6;"></div>
                            <div class="d-flex gap-2 mt-1">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text"><t key="salon.branches.latitude">Enlem</t></span>
                                    <input type="number" step="0.000001" class="form-control" data-bind="value: form.latitude, event: { change: onLatLonManualChange }" placeholder="41.034" />
                                </div>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text"><t key="salon.branches.longitude">Boylam</t></span>
                                    <input type="number" step="0.000001" class="form-control" data-bind="value: form.longitude, event: { change: onLatLonManualChange }" placeholder="29.179" />
                                </div>
                            </div>
                            <div class="text-muted small mt-1"><i class="bi bi-info-circle me-1"></i><t key="salon.branches.map_hint">Haritada tıklayın veya pini sürükleyerek tam konumu ayarlayın. Google Maps linki otomatik dolar.</t></div>
                        </div>
                        <div class="col-8">
                            <label class="form-label small"><t key="salon.branches.google_maps_link">Google Maps Linki</t></label>
                            <input type="url" class="form-control form-control-sm" data-bind="value: form.googleMapsUrl" placeholder="@(Translation.T("salon.branches.map_selected_auto", "Haritadan seçilince otomatik dolar"))" readonly style="background:#f8f9fa;" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small"><t key="salon.branches.auto.sube_muduru">Şube Müdürü</t></label>
                            <select class="form-select form-select-sm" data-bind="value: form.managerPersonnelId, options: staffList, optionsText: 'title', optionsValue: 'id', optionsCaption: salonT('salon.common.select', 'Seçiniz')"></select>
                        </div>
                        <div class="col-4">
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" id="branchHQ" data-bind="checked: form.isHeadquarter" />
                                <label class="form-check-label small" for="branchHQ"><t key="salon.branches.auto.ana_sube_merkez">Ana Şube (Merkez)</t></label>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" id="branchActive" data-bind="checked: form.isActive" />
                                <label class="form-check-label small" for="branchActive"><t key="salon.common.status_active">Aktif</t></label>
                            </div>
                        </div>
                    </div>

                    <!-- Dekorasyon Gorselleri -->
                    <h6 class="text-muted small fw-bold mb-2"><i class="bi bi-images me-1"></i><t key="salon.branches.decor.title">Şube Dekorasyonu</t></h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label small"><t key="salon.branches.decor.photo">Şube Profil Görseli</t></label>
                            <div class="border rounded p-2 text-center">
                                <!-- ko if: form.photoUrl() -->
                                <img data-bind="attr: { src: form.photoUrl }" style="width:96px;height:96px;border-radius:50%;object-fit:cover;" class="mb-2" />
                                <div>
                                    <button type="button" class="btn btn-outline-danger btn-sm py-0" data-bind="click: function() { removeSingleImage('photo'); }">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                                <!-- /ko -->
                                <!-- ko ifnot: form.photoUrl() -->
                                <div class="py-3 text-muted">
                                    <i class="bi bi-shop fs-2 d-block mb-1 opacity-25"></i>
                                    <small><t key="salon.branches.decor.photo_empty">Görsel yok</t></small>
                                </div>
                                <!-- /ko -->
                                <label class="btn btn-outline-primary btn-sm mt-2">
                                    <i class="bi bi-upload me-1"></i><t key="salon.common.upload">Yükle</t>
                                    <input type="file" accept="image/jpeg,image/png,image/webp" style="display:none;" data-bind="event: { change: function(d,e) { uploadSingleImage('photo', e); } }" />
                                </label>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small"><t key="salon.branches.decor.cover">Kapak Görseli</t></label>
                            <div class="border rounded p-2 text-center">
                                <!-- ko if: form.coverImageUrl() -->
                                <img data-bind="attr: { src: form.coverImageUrl }" style="height:150px;width:100%;object-fit:cover;border-radius:6px;" class="mb-2" />
                                <div>
                                    <button type="button" class="btn btn-outline-danger btn-sm py-0" data-bind="click: function() { removeSingleImage('cover'); }">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                                <!-- /ko -->
                                <!-- ko ifnot: form.coverImageUrl() -->
                                <div class="py-4 text-muted">
                                    <i class="bi bi-card-image fs-2 d-block mb-1 opacity-25"></i>
                                    <small><t key="salon.branches.decor.cover_empty">Kapak görseli yok</t></small>
                                </div>
                                <!-- /ko -->
                                <label class="btn btn-outline-primary btn-sm mt-2">
                                    <i class="bi bi-upload me-1"></i><t key="salon.branches.decor.cover_upload">Kapak Yükle</t>
                                    <input type="file" accept="image/jpeg,image/png,image/webp" style="display:none;" data-bind="event: { change: function(d,e) { uploadSingleImage('cover', e); } }" />
                                </label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label small mb-0"><t key="salon.branches.decor.gallery">Dekorasyon Galerisi</t></label>
                                <label class="btn btn-outline-primary btn-sm py-0 mb-0">
                                    <i class="bi bi-plus-lg me-1"></i><t key="salon.common.add">Ekle</t>
                                    <input type="file" accept="image/jpeg,image/png,image/webp" multiple style="display:none;" data-bind="event: { change: uploadGalleryImages }" />
                                </label>
                            </div>
                            <div class="border rounded p-2">
                                <!-- ko if: form.galleryImages().length === 0 -->
                                <p class="text-muted small text-center mb-0"><t key="salon.branches.decor.gallery_empty">Henüz dekorasyon görseli eklenmemiş.</t></p>
                                <!-- /ko -->
                                <div class="row g-2" data-bind="foreach: form.galleryImages">
                                    <div class="col-4 col-md-3 col-lg-2 position-relative">
                                        <img data-bind="attr: { src: $data }" style="width:100%;height:96px;object-fit:cover;border-radius:6px;" />
                                        <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1 py-0 px-1" style="font-size:.7rem;"
                                                data-bind="click: function() { $parent.removeGalleryImage($index()); }">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Çalışma Saatleri -->
                    <h6 class="text-muted small fw-bold mb-2"><i class="bi bi-clock me-1"></i><t key="salon.branches.working_hours">Çalışma Saatleri</t></h6>
                    <div class="mb-4">
                        <!-- ko foreach: workingDays -->
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="small fw-medium" style="min-width:75px;" data-bind="text: label"></span>
                            <div class="form-check form-switch me-2">
                                <input class="form-check-input" type="checkbox" data-bind="checked: isOpen" />
                            </div>
                            <!-- ko if: isOpen() -->
                            <input type="time" class="form-control form-control-sm" style="max-width:110px;" data-bind="value: open" />
                            <span class="small">-</span>
                            <input type="time" class="form-control form-control-sm" style="max-width:110px;" data-bind="value: close" />
                            <!-- /ko -->
                            <!-- ko ifnot: isOpen() -->
                            <span class="text-muted small" data-bind="text: salonT('salon.branches.closed', 'Kapalı')"></span>
                            <!-- /ko -->
                        </div>
                        <!-- /ko -->
                    </div>

                    <!-- Fatura Bilgileri -->
                    <h6 class="text-muted small fw-bold mb-2"><i class="bi bi-receipt me-1"></i><t key="salon.branches.auto.fatura_bilgileri">Fatura Bilgileri</t></h6>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.branches.company_title">Ticari Unvan</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.companyTitle" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.branches.tax_office">Vergi Dairesi</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.taxOffice" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.branches.tax_number">Vergi No</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.taxNumber" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.branches.auto.mersis_no">MERSİS No</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.mersisNo" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i><t key="salon.common.btn.save">Kaydet</t>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />
    <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
    <script src="~/lib/qrcodejs/qrcode.min.js"></script>
    <script src="~/js/tr-cities.js" asp-append-version="true"></script>
    <script src="~/js/Branches.js" asp-append-version="true"></script>
    <datalist id="tr-cities-list">
        <!-- TR_CITIES window globaline bagli, page load'da script tag'i aciklama ekler -->
    </datalist>
    <script>
        (function () {
            var dl = document.getElementById('tr-cities-list');
            if (dl && window.TR_CITIES) {
                window.TR_CITIES.forEach(function (c) {
                    var opt = document.createElement('option');
                    opt.value = c;
                    dl.appendChild(opt);
                });
            }
        })();
    </script>
}
