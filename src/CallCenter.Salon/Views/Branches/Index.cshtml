@{
    ViewData["Title"] = "Subeler";
}

<div id="branches-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0">Sube Yonetimi</h6>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i>Yeni Sube
        </button>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Sube</th>
                            <th>Slug</th>
                            <th>Adres</th>
                            <th>Telefon</th>
                            <th>Mudur</th>
                            <th>Durum</th>
                            <th style="width:100px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: branches">
                        <tr>
                            <td class="fw-semibold small">
                                <span data-bind="text: name"></span>
                                <!-- ko if: isHeadquarter -->
                                <span class="badge bg-primary ms-1" style="font-size:0.65rem;">Merkez</span>
                                <!-- /ko -->
                            </td>
                            <td class="small text-muted" data-bind="text: slug || '-'"></td>
                            <td class="small" data-bind="text: (city || '') + (district ? ' / ' + district : '') || address || '-'"></td>
                            <td class="small" data-bind="text: phone || '-'"></td>
                            <td class="small" data-bind="text: managerName || '-'"></td>
                            <td class="small">
                                <span class="badge" data-bind="text: isActive ? 'Aktif' : 'Pasif', css: isActive ? 'bg-success' : 'bg-secondary'"></span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" title="Duzenle" data-bind="click: $parent.openEdit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <!-- ko if: !isHeadquarter -->
                                    <button class="btn btn-outline-danger" title="Sil" data-bind="click: $parent.remove">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    <!-- /ko -->
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: branches().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-building" style="font-size:2rem;"></i>
                <p class="mt-2 small">Henuz sube eklenmemis</p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="branchModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditing() ? 'Sube Duzenle' : 'Yeni Sube'"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Genel Bilgiler -->
                    <h6 class="text-muted small fw-bold mb-2"><i class="bi bi-building me-1"></i>Genel Bilgiler</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <label class="form-label small">Sube Adi *</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.name" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Profil Adresi (slug)</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">corplynk.com/salon/</span>
                                <input type="text" class="form-control" data-bind="value: form.slug" placeholder="sube-adi" />
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Adres</label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: form.address"></textarea>
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Il</label>
                            <input type="text" class="form-control form-control-sm" list="tr-cities-list"
                                   data-bind="value: form.city, event: { blur: function(d,e){ if (window.normalizeTrCity) form.city(window.normalizeTrCity(e.target.value)); } }" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Ilce</label>
                            <input type="text" class="form-control form-control-sm"
                                   data-bind="value: form.district, event: { blur: function(d,e){ if (window.normalizeTrCity) form.district(window.normalizeTrCity(e.target.value)); } }" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Telefon</label>
                            <div data-bind="phoneInput: form.phone"></div>
                        </div>
                        <div class="col-4">
                            <label class="form-label small">E-posta</label>
                            <input type="email" class="form-control form-control-sm" data-bind="value: form.email" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Google Maps</label>
                            <input type="url" class="form-control form-control-sm" data-bind="value: form.googleMapsUrl" placeholder="https://maps.google.com/..." />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Sube Muduru</label>
                            <select class="form-select form-select-sm" data-bind="value: form.managerPersonnelId, options: staffList, optionsText: 'title', optionsValue: 'id', optionsCaption: 'Seciniz'"></select>
                        </div>
                        <div class="col-4">
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" id="branchHQ" data-bind="checked: form.isHeadquarter" />
                                <label class="form-check-label small" for="branchHQ">Ana Sube (Merkez)</label>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" id="branchActive" data-bind="checked: form.isActive" />
                                <label class="form-check-label small" for="branchActive">Aktif</label>
                            </div>
                        </div>
                    </div>

                    <!-- Calisma Saatleri -->
                    <h6 class="text-muted small fw-bold mb-2"><i class="bi bi-clock me-1"></i>Calisma Saatleri</h6>
                    <div class="mb-4">
                        <!-- ko foreach: workingDays -->
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="small fw-medium" style="min-width:75px;" data-bind="text: label"></span>
                            <div class="form-check form-switch me-2">
                                <input class="form-check-input" type="checkbox" data-bind="checked: isOpen" />
                            </div>
                            <!-- ko if: isOpen() -->
                            <input type="time" class="form-control form-control-sm" style="max-width:110px;" data-bind="value: open" />
                            <span class="small">-</span>
                            <input type="time" class="form-control form-control-sm" style="max-width:110px;" data-bind="value: close" />
                            <!-- /ko -->
                            <!-- ko ifnot: isOpen() -->
                            <span class="text-muted small">Kapali</span>
                            <!-- /ko -->
                        </div>
                        <!-- /ko -->
                    </div>

                    <!-- Fatura Bilgileri -->
                    <h6 class="text-muted small fw-bold mb-2"><i class="bi bi-receipt me-1"></i>Fatura Bilgileri</h6>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small">Ticari Unvan</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.companyTitle" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Vergi Dairesi</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.taxOffice" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Vergi No</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.taxNumber" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Mersis No</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.mersisNo" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/tr-cities.js" asp-append-version="true"></script>
    <script src="~/js/Branches.js" asp-append-version="true"></script>
    <datalist id="tr-cities-list">
        <!-- TR_CITIES window globaline bagli, page load'da script tag'i aciklama ekler -->
    </datalist>
    <script>
        (function () {
            var dl = document.getElementById('tr-cities-list');
            if (dl && window.TR_CITIES) {
                window.TR_CITIES.forEach(function (c) {
                    var opt = document.createElement('option');
                    opt.value = c;
                    dl.appendChild(opt);
                });
            }
        })();
    </script>
}
