@inject CallCenter.Shared.Services.ITranslationService Translation
@inject IConfiguration Configuration
@{
    var __layoutLang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var __layoutTranslations = await Translation.GetAllAsync(__layoutLang);
    var __layoutTranslationsJson = System.Text.Json.JsonSerializer.Serialize(__layoutTranslations);
}
<!DOCTYPE html>
<html lang="@__layoutLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CorpLynk Salon</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link href="/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        :root { --sidebar-width: 240px; }
        body { font-family: 'Segoe UI', system-ui, sans-serif; background: #f0f2f5; }
        .sidebar {
            width: var(--sidebar-width); height: 100vh; position: fixed; top: 0; left: 0;
            background: linear-gradient(180deg, #2d1b3d 0%, #1a1028 100%);
            color: #fff; overflow-y: auto; z-index: 1000;
        }
        .sidebar .brand { padding: .75rem .85rem; border-bottom: 1px solid rgba(255,255,255,.1); }
        .app-switcher { display: flex; gap: .45rem; align-items: center; }
        .app-switcher .app-link {
            width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center;
            color: rgba(255,255,255,.72); background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.1);
            border-radius: 8px; text-decoration: none; font-size: 1.05rem;
        }
        .app-switcher .app-link:hover { color: #fff; background: rgba(255,255,255,.14); }
        .app-switcher .app-link.active { color: #fff; background: rgba(206,147,216,.24); border-color: rgba(206,147,216,.55); }
        .sidebar .nav-link { color: rgba(255,255,255,.7); padding: .6rem 1rem; font-size: .875rem; border-radius: 6px; margin: 2px 8px; }
        .sidebar .nav-link:hover { color: #fff; background: rgba(255,255,255,.1); }
        .sidebar .nav-link.active { color: #fff; background: rgba(206,147,216,.2); }
        .sidebar .nav-section { color: rgba(255,255,255,.4); font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; padding: .8rem 1rem .3rem; }
        .sidebar .nav-group-toggle {
            display: flex; align-items: center; width: 100%; padding: .6rem 1rem;
            color: rgba(255,255,255,.5); background: none; border: none;
            font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; cursor: pointer;
        }
        .sidebar .nav-group-toggle:hover { color: rgba(255,255,255,.7); }
        .sidebar .nav-group-toggle span { flex: 1; text-align: left; }
        .sidebar .nav-group-toggle .chevron { font-size: .6rem; transition: transform .2s ease; opacity: .5; }
        .sidebar .nav-group-toggle .chevron.open { transform: rotate(180deg); }
        .sidebar .nav-group-items { display: none; }
        .sidebar .nav-group-items.show { display: block; }
        .content-area { margin-left: var(--sidebar-width); padding: 1.5rem; min-height: 100vh; }
        .topbar { background: #fff; border-bottom: 1px solid #e0e0e0; padding: .6rem 1.5rem; margin: -1.5rem -1.5rem 1.5rem; display: flex; align-items: center; justify-content: space-between; }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    @{
        var __jwt = CallCenter.Shared.Auth.JwtIdentityExtensions.GetJwtIdentity(Context);
        var __layoutRoleId = __jwt.CustomerRoleId > 0 ? __jwt.CustomerRoleId : 101;
        var __layoutSessionKey = $"{__jwt.UserName}|{__layoutRoleId}|{__jwt.BranchId?.ToString() ?? ""}";
    }
    <div id="salon-layout-data"
         hidden
         data-authenticated="@(__jwt.IsAuthenticated ? "true" : "false")"
         data-role-id="@__layoutRoleId"
         data-personnel-id="@(__jwt.CustomerPersonnelId > 0 ? __jwt.CustomerPersonnelId.ToString() : "")"
         data-full-name="@__jwt.FullName"
         data-jwt-branch="@(__jwt.BranchId?.ToString() ?? "")"
         data-session-key="@__layoutSessionKey"
         data-translations="@__layoutTranslationsJson"></div>
    @if (__jwt.IsAuthenticated)
    {
        var __crmBaseUrl = (Configuration["CrmBaseUrl"] ?? "https://crm.corplynk.com").TrimEnd('/');
        var __callCenterBaseUrl = (Configuration["CallCenterBaseUrl"] ?? "https://cc.corplynk.com").TrimEnd('/');
        var __brandModuleIds = __jwt.CustomerModules.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(s => int.TryParse(s.Trim(), out var mid) ? mid : 0)
            .Where(id => id > 0)
            .ToHashSet();
        var __hasCallCenterAccess = __brandModuleIds.Any(id => CallCenter.Shared.Enums.PortalModules.GetById(id) != null);
        var __hasCrmAccess = __brandModuleIds.Any(id => CallCenter.Shared.Enums.CrmModules.GetById(id) != null)
            || __brandModuleIds.Any(id => CallCenter.Shared.Enums.SalonModuleGroups.GetGroupId(id) == CallCenter.Shared.Enums.SalonModuleGroups.Ids.LoyaltyMarketing);

        <nav class="sidebar d-print-none">
            <div class="brand">
                <div class="app-switcher" aria-label="Uygulama gecisi">
                    @if (__hasCallCenterAccess)
                    {
                        <a class="app-link" href="@__callCenterBaseUrl" title="CallCenter" aria-label="CallCenter">
                            <i class="bi bi-headset"></i>
                        </a>
                    }
                    @if (__hasCrmAccess)
                    {
                        <a class="app-link" href="@__crmBaseUrl" title="CRM" aria-label="CRM">
                            <i class="bi bi-person-lines-fill"></i>
                        </a>
                    }
                    <a class="app-link active" href="/Home" title="Salon" aria-label="Salon" aria-current="page">
                        <i class="bi bi-scissors"></i>
                    </a>
                </div>
            </div>
            @{
                var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                var roleId = __jwt.CustomerRoleId > 0 ? __jwt.CustomerRoleId : 101;
                var can = CallCenter.Shared.Enums.SalonRolePermissions.GetAccessiblePages(roleId);

                var modulesCsv = __jwt.CustomerModules;
                var activeModuleIds = modulesCsv.Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(s => int.TryParse(s.Trim(), out var mid) ? mid : 0)
                    .Where(id => id > 0)
                    .ToHashSet();

                bool canShow(string page) => can.Contains(page)
                    && CallCenter.Shared.Enums.SalonModuleControllerMap.HasModule(activeModuleIds, page);

                var mainOpen = ctrl is "Home" or "Clients" or "Appointments" or "Waitlist";
                var opsOpen = ctrl is "Services" or "Staff" or "Recipes" or "PersonnelPrices";
                var stockOpen = ctrl is "Products" or "Suppliers";
                var financeOpen = ctrl is "Invoices" or "Cash" or "Expenses" or "GiftCards" or "Packages";
                var reportOpen = ctrl is "Reports";
                var marketingOpen = ctrl is "Marketing" or "Campaigns" or "Loyalty" or "Memberships" or "EmailCampaigns" or "Reviews" or "Winback";
                var managementOpen = ctrl is "Branches" or "Profile" or "NoShowPolicy" or "ConsentForms" or "BeforeAfter" or "EmailSettings" or "PageSettings" or "PaymentInfo" or "DataImport";
            }

            @if (canShow("Sales"))
            {
                <a class="nav-link mt-2 @(ctrl == "Sales" ? "active" : "")" href="/Sales" style="font-size:.95rem;">
                    <i class="bi bi-cart-check-fill me-2"></i><strong><t key="salon.sidebar.quick_sales">Hizli Satis</t></strong>
                </a>
            }

            @{ var salonLinks = new[] { "Home", "Clients", "Appointments", "Waitlist" }.Where(p => canShow(p)).ToArray(); }
            @if (salonLinks.Length > 0)
            {
                <button type="button" class="nav-group-toggle mt-1" data-nav-group-toggle="1">
                    <span><t key="salon.sidebar.salon">Salon</t></span><i class="bi bi-chevron-down chevron @(mainOpen ? "open" : "")"></i>
                </button>
                <div class="nav-group-items @(mainOpen ? "show" : "")">
                    @if (canShow("Home")) { <a class="nav-link @(ctrl == "Home" ? "active" : "")" href="/Home"><i class="bi bi-speedometer2 me-2"></i><t key="salon.sidebar.dashboard">Dashboard</t></a> }
                    @if (canShow("Clients")) { <a class="nav-link @(ctrl == "Clients" ? "active" : "")" href="/Clients"><i class="bi bi-people-fill me-2"></i><t key="salon.sidebar.clients">Musteriler</t></a> }
                    @if (canShow("Appointments")) { <a class="nav-link @(ctrl == "Appointments" ? "active" : "")" href="/Appointments"><i class="bi bi-calendar-check me-2"></i><t key="salon.sidebar.appointments">Randevular</t></a> }
                    @if (canShow("Waitlist")) { <a class="nav-link @(ctrl == "Waitlist" ? "active" : "")" href="/Waitlist"><i class="bi bi-clock-history me-2"></i><t key="salon.sidebar.waitlist">Bekleme Listesi</t></a> }
                </div>
            }

            @{ var opsLinks = new[] { "Services", "Staff", "Recipes", "PersonnelPrices" }.Where(p => canShow(p)).ToArray(); }
            @if (opsLinks.Length > 0)
            {
                <button type="button" class="nav-group-toggle mt-1" data-nav-group-toggle="1">
                    <span><t key="salon.sidebar.operations">Operasyon</t></span><i class="bi bi-chevron-down chevron @(opsOpen ? "open" : "")"></i>
                </button>
                <div class="nav-group-items @(opsOpen ? "show" : "")">
                    @if (canShow("Services")) { <a class="nav-link @(ctrl == "Services" ? "active" : "")" href="/Services"><i class="bi bi-list-check me-2"></i><t key="salon.sidebar.services">Hizmetler</t></a> }
                    @if (canShow("Staff")) { <a class="nav-link @(ctrl == "Staff" ? "active" : "")" href="/Staff"><i class="bi bi-person-badge me-2"></i><t key="salon.sidebar.staff">Personel</t></a> }
                    @if (canShow("Recipes")) { <a class="nav-link @(ctrl == "Recipes" ? "active" : "")" href="/Recipes"><i class="bi bi-journal-bookmark me-2"></i><t key="salon.sidebar.recipes">Receteler</t></a> }
                    @if (canShow("PersonnelPrices")) { <a class="nav-link @(ctrl == "PersonnelPrices" ? "active" : "")" href="/PersonnelPrices"><i class="bi bi-currency-exchange me-2"></i><t key="salon.sidebar.personnel_prices">Personel Fiyatlari</t></a> }
                </div>
            }

            @{ var stockLinks = new[] { "Products", "Suppliers" }.Where(p => canShow(p)).ToArray(); }
            @if (stockLinks.Length > 0)
            {
                <button type="button" class="nav-group-toggle mt-1" data-nav-group-toggle="1">
                    <span><t key="salon.sidebar.inventory">Stok</t></span><i class="bi bi-chevron-down chevron @(stockOpen ? "open" : "")"></i>
                </button>
                <div class="nav-group-items @(stockOpen ? "show" : "")">
                    @if (canShow("Products")) { <a class="nav-link @(ctrl == "Products" ? "active" : "")" href="/Products"><i class="bi bi-box-seam me-2"></i><t key="salon.sidebar.products">Urunler</t></a> }
                    @if (canShow("Suppliers")) { <a class="nav-link @(ctrl == "Suppliers" ? "active" : "")" href="/Suppliers"><i class="bi bi-truck me-2"></i><t key="salon.sidebar.suppliers">Tedarikciler</t></a> }
                </div>
            }

            @{
                var financePages = new List<string> { "Invoices", "Cash", "Expenses", "Packages" };
                if (!canShow("Marketing"))
                {
                    financePages.Insert(3, "GiftCards");
                }
                var finLinks = financePages.Where(p => canShow(p)).ToArray();
            }
            @if (finLinks.Length > 0)
            {
                <button type="button" class="nav-group-toggle mt-1" data-nav-group-toggle="1">
                    <span><t key="salon.sidebar.finance">Finans</t></span><i class="bi bi-chevron-down chevron @(financeOpen ? "open" : "")"></i>
                </button>
                <div class="nav-group-items @(financeOpen ? "show" : "")">
                    @if (canShow("Invoices")) { <a class="nav-link @(ctrl == "Invoices" ? "active" : "")" href="/Invoices"><i class="bi bi-receipt me-2"></i><t key="salon.sidebar.invoices">Adisyonlar</t></a> }
                    @if (canShow("Cash")) { <a class="nav-link @(ctrl == "Cash" ? "active" : "")" href="/Cash"><i class="bi bi-cash-stack me-2"></i><t key="salon.sidebar.cash">Kasa</t></a> }
                    @if (canShow("Expenses")) { <a class="nav-link @(ctrl == "Expenses" ? "active" : "")" href="/Expenses"><i class="bi bi-credit-card me-2"></i><t key="salon.sidebar.expenses">Masraflar</t></a> }
                    @if (financePages.Contains("GiftCards") && canShow("GiftCards")) { <a class="nav-link @(ctrl == "GiftCards" ? "active" : "")" href="/GiftCards"><i class="bi bi-gift me-2"></i><t key="salon.sidebar.gift_cards">Hediye Kartlari</t></a> }
                    @if (canShow("Packages")) { <a class="nav-link @(ctrl == "Packages" ? "active" : "")" href="/Packages"><i class="bi bi-box-seam me-2"></i><t key="salon.sidebar.packages">Seans Paketleri</t></a> }
                </div>
            }

            @{
                var legacyMarketingPages = new[] { "Campaigns", "Memberships", "Loyalty", "EmailCampaigns", "Reviews", "Winback" };
                var mktLinks = canShow("Marketing")
                    ? new[] { "Marketing" }
                    : legacyMarketingPages.Where(p => canShow(p)).ToArray();
            }
            @if (mktLinks.Length > 0)
            {
                <button type="button" class="nav-group-toggle mt-1" data-nav-group-toggle="1">
                    <span><t key="salon.sidebar.customer_relations">Müşteri İlişkileri</t></span><i class="bi bi-chevron-down chevron @(marketingOpen ? "open" : "")"></i>
                </button>
                <div class="nav-group-items @(marketingOpen ? "show" : "")">
                    @if (canShow("Marketing"))
                    {
                        <a class="nav-link @(marketingOpen ? "active" : "")" href="/Marketing"><i class="bi bi-person-heart me-2"></i><t key="salon.modules.package.salon_crm">Salon CRM</t></a>
                    }
                    else
                    {
                        @if (canShow("Campaigns")) { <a class="nav-link @(ctrl == "Campaigns" ? "active" : "")" href="/Campaigns"><i class="bi bi-megaphone me-2"></i><t key="salon.sidebar.campaigns">Kampanyalar</t></a> }
                        @if (canShow("Memberships")) { <a class="nav-link @(ctrl == "Memberships" ? "active" : "")" href="/Memberships"><i class="bi bi-award me-2"></i><t key="salon.sidebar.memberships">Uyelik Planlari</t></a> }
                        @if (canShow("Loyalty")) { <a class="nav-link @(ctrl == "Loyalty" ? "active" : "")" href="/Loyalty"><i class="bi bi-star me-2"></i><t key="salon.sidebar.loyalty">Sadakat Programi</t></a> }
                        @if (canShow("EmailCampaigns")) { <a class="nav-link @(ctrl == "EmailCampaigns" ? "active" : "")" href="/EmailCampaigns"><i class="bi bi-envelope me-2"></i><t key="salon.sidebar.email_campaigns">E-posta Kampanyalari</t></a> }
                        @if (canShow("Reviews")) { <a class="nav-link @(ctrl == "Reviews" ? "active" : "")" href="/Reviews"><i class="bi bi-chat-square-text me-2"></i><t key="salon.sidebar.reviews">Yorumlar</t></a> }
                        @if (canShow("Winback")) { <a class="nav-link @(ctrl == "Winback" ? "active" : "")" href="/Winback"><i class="bi bi-arrow-repeat me-2"></i><t key="salon.sidebar.winback">Geri Kazanım</t></a> }
                    }
                </div>
            }

            @if (canShow("Reports"))
            {
                <button type="button" class="nav-group-toggle mt-1" data-nav-group-toggle="1">
                    <span><t key="salon.sidebar.reports">Raporlar</t></span><i class="bi bi-chevron-down chevron @(reportOpen ? "open" : "")"></i>
                </button>
                <div class="nav-group-items @(reportOpen ? "show" : "")">
                    <a class="nav-link @(ctrl == "Reports" ? "active" : "")" href="/Reports"><i class="bi bi-bar-chart-line me-2"></i><t key="salon.sidebar.reports">Raporlar</t></a>
                </div>
            }

            @{ var mngLinks = new[] { "Profile", "Branches", "DataImport", "NoShowPolicy", "ConsentForms", "BeforeAfter", "EmailSettings", "PageSettings", "PaymentInfo", "Modules" }.Where(p => canShow(p)).ToArray(); }
            @if (mngLinks.Length > 0)
            {
                <button type="button" class="nav-group-toggle mt-1" data-nav-group-toggle="1">
                    <span><t key="salon.sidebar.management">Yonetim</t></span><i class="bi bi-chevron-down chevron @(managementOpen ? "open" : "")"></i>
                </button>
                <div class="nav-group-items @(managementOpen ? "show" : "")">
                    @if (canShow("Profile")) { <a class="nav-link @(ctrl == "Profile" ? "active" : "")" href="/Profile"><i class="bi bi-shop me-2"></i><t key="salon.sidebar.profile">Salon Profili</t></a> }
                    @if (canShow("Branches")) { <a class="nav-link @(ctrl == "Branches" ? "active" : "")" href="/Branches"><i class="bi bi-building me-2"></i><t key="salon.sidebar.branches">Subeler</t></a> }
                    @if (canShow("DataImport")) { <a class="nav-link @(ctrl == "DataImport" ? "active" : "")" href="/DataImport"><i class="bi bi-database-up me-2"></i><t key="salon.sidebar.data_import">Veri Aktarimi</t></a> }
                    @if (canShow("NoShowPolicy")) { <a class="nav-link @(ctrl == "NoShowPolicy" ? "active" : "")" href="/NoShowPolicy"><i class="bi bi-shield-exclamation me-2"></i><t key="salon.sidebar.noshow_policy">Randevu Kurallari</t></a> }
                    @if (canShow("ConsentForms")) { <a class="nav-link @(ctrl == "ConsentForms" ? "active" : "")" href="/ConsentForms"><i class="bi bi-file-earmark-text me-2"></i><t key="salon.sidebar.consent_forms">Onay Formlari</t></a> }
                    @if (canShow("BeforeAfter")) { <a class="nav-link @(ctrl == "BeforeAfter" ? "active" : "")" href="/BeforeAfter"><i class="bi bi-images me-2"></i><t key="salon.sidebar.before_after">Once/Sonra</t></a> }
                    @if (canShow("EmailSettings")) { <a class="nav-link @(ctrl == "EmailSettings" ? "active" : "")" href="/EmailSettings"><i class="bi bi-envelope-at me-2"></i><t key="salon.sidebar.email_settings">E-posta Ayarlari</t></a> }
                    @if (canShow("PageSettings")) { <a class="nav-link @(ctrl == "PageSettings" ? "active" : "")" href="/PageSettings"><i class="bi bi-layout-text-sidebar me-2"></i><t key="salon.sidebar.page_settings">Sayfa Ayarlari</t></a> }
                    @if (canShow("PaymentInfo")) { <a class="nav-link @(ctrl == "PaymentInfo" ? "active" : "")" href="/PaymentInfo"><i class="bi bi-bank me-2"></i><t key="salon.sidebar.payment_info">Odeme Bilgileri</t></a> }
                    @if (canShow("Modules")) { <a class="nav-link @(ctrl == "Modules" ? "active" : "")" href="/Modules"><i class="bi bi-grid-3x3-gap me-2"></i><t key="salon.sidebar.service_packages">Hizmet Paketleri</t></a> }
                </div>
            }

            <div style="position:absolute;bottom:0;width:100%;border-top:1px solid rgba(255,255,255,.1);padding:.8rem 1rem;">
                <div class="d-flex align-items-center justify-content-between">
                    <small class="text-white-50">
                        <i class="bi bi-person-circle me-1"></i>@__jwt.FullName
                    </small>
                    <a href="/Account/Logout" class="text-white-50" title="@(Translation.T("salon.common.logout_tooltip", "Cikis"))"><i class="bi bi-box-arrow-right"></i></a>
                </div>
            </div>
        </nav>

        <div class="content-area">
            <div class="topbar">
                <h5 class="mb-0">@ViewData["Title"]</h5>
                <div class="d-flex align-items-center gap-3">
                    <div id="branchSelector"></div>
                    <small class="text-muted">@__jwt.CustomerName</small>
                </div>
            </div>
            <div id="slnBillingBanners" class="d-print-none"></div>
            @RenderBody()
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/knockout/knockout-latest.min.js"></script>
    <link href="/lib/toastr/toastr.min.css" rel="stylesheet" />
    <script src="/lib/toastr/toastr.min.js"></script>
    <script src="~/js/confirm-modal.js" asp-append-version="true"></script>
    <script src="~/js/autocomplete-helper.js" asp-append-version="true"></script>
    <script src="~/js/phone-input.js" asp-append-version="true"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    @if (__jwt.IsAuthenticated)
    {
        <script src="~/js/layout-banners.js" asp-append-version="true"></script>
    }
    @RenderSection("Scripts", required: false)
</body>
</html>
