@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    var __layoutLang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var __layoutTranslations = await Translation.GetAllAsync(__layoutLang);
    var __layoutTranslationsJson = System.Text.Json.JsonSerializer.Serialize(__layoutTranslations);
}
<!DOCTYPE html>
<html lang="@__layoutLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CorpLynk Salon</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link href="/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        :root { --sidebar-width: 240px; }
        body { font-family: 'Segoe UI', system-ui, sans-serif; background: #f0f2f5; }
        .sidebar {
            width: var(--sidebar-width); height: 100vh; position: fixed; top: 0; left: 0;
            background: linear-gradient(180deg, #2d1b3d 0%, #1a1028 100%);
            color: #fff; overflow-y: auto; z-index: 1000;
        }
        .sidebar .brand { padding: 1rem; font-size: 1.1rem; font-weight: 700; border-bottom: 1px solid rgba(255,255,255,.1); }
        .sidebar .brand span { color: #ce93d8; }
        .sidebar .nav-link { color: rgba(255,255,255,.7); padding: .6rem 1rem; font-size: .875rem; border-radius: 6px; margin: 2px 8px; }
        .sidebar .nav-link:hover { color: #fff; background: rgba(255,255,255,.1); }
        .sidebar .nav-link.active { color: #fff; background: rgba(206,147,216,.2); }
        .sidebar .nav-section { color: rgba(255,255,255,.4); font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; padding: .8rem 1rem .3rem; }
        .sidebar .nav-group-toggle {
            display: flex; align-items: center; width: 100%; padding: .6rem 1rem;
            color: rgba(255,255,255,.5); background: none; border: none;
            font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; cursor: pointer;
        }
        .sidebar .nav-group-toggle:hover { color: rgba(255,255,255,.7); }
        .sidebar .nav-group-toggle span { flex: 1; text-align: left; }
        .sidebar .nav-group-toggle .chevron { font-size: .6rem; transition: transform .2s ease; opacity: .5; }
        .sidebar .nav-group-toggle .chevron.open { transform: rotate(180deg); }
        .sidebar .nav-group-items { max-height: 0; overflow: hidden; transition: max-height .25s ease; }
        .sidebar .nav-group-items.show { max-height: 500px; }
        .content-area { margin-left: var(--sidebar-width); padding: 1.5rem; min-height: 100vh; }
        .topbar { background: #fff; border-bottom: 1px solid #e0e0e0; padding: .6rem 1.5rem; margin: -1.5rem -1.5rem 1.5rem; display: flex; align-items: center; justify-content: space-between; }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    @{ var __jwt = CallCenter.Shared.Auth.JwtIdentityExtensions.GetJwtIdentity(Context); }
    @if (__jwt.IsAuthenticated)
    {
        <nav class="sidebar d-print-none">
            <div class="brand">
                <i class="bi bi-scissors me-2"></i>CorpLynk <span><t key="salon.shared.auto.salon">Salon</t></span>
            </div>
            @{
                var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                var roleId = __jwt.CustomerRoleId > 0 ? __jwt.CustomerRoleId : 101;
                var can = CallCenter.Shared.Enums.SalonRolePermissions.GetAccessiblePages(roleId);

                // Modul filtresi: aktif olmayan modullerin sayfalari sidebar'da gorunmez
                var modulesCsv = __jwt.CustomerModules;
                var activeModuleIds = modulesCsv.Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(s => int.TryParse(s.Trim(), out var mid) ? mid : 0)
                    .Where(id => id > 0)
                    .ToHashSet();
                // Cift katmanli kontrol: rol erisimi + modul aktif
                bool canShow(string page) => can.Contains(page)
                    && CallCenter.Shared.Enums.SalonModuleControllerMap.HasModule(activeModuleIds, page);

                // Grup acik/kapali durumu
                var mainOpen = ctrl is "Home" or "Clients" or "Appointments" or "Waitlist";
                var opsOpen = ctrl is "Services" or "Staff" or "Recipes" or "PersonnelPrices";
                var stockOpen = ctrl is "Products" or "Suppliers";
                var financeOpen = ctrl is "Invoices" or "Cash" or "Expenses" or "GiftCards" or "Packages";
                var reportOpen = ctrl is "Reports";
                var marketingOpen = ctrl is "Campaigns" or "Loyalty" or "Memberships" or "EmailCampaigns" or "Reviews" or "Winback";
                var managementOpen = ctrl is "Branches" or "Profile" or "NoShowPolicy" or "ConsentForms" or "BeforeAfter" or "EmailSettings" or "PageSettings" or "PaymentInfo";
            }

            @if (canShow("Sales")) {
            <a class="nav-link mt-2 @(ctrl == "Sales" ? "active" : "")" href="/Sales" style="font-size:.95rem;">
                <i class="bi bi-cart-check-fill me-2"></i><strong><t key="salon.sidebar.quick_sales">Hızlı Satış</t></strong>
            </a>
            }

            @{ var salonLinks = new[] { "Home", "Clients", "Appointments", "Waitlist" }.Where(p => canShow(p)).ToArray(); }
            @if (salonLinks.Length > 0) {
            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span><t key="salon.sidebar.salon">Salon</t></span><i class="bi bi-chevron-down chevron @(mainOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(mainOpen ? "show" : "")">
                @if (canShow("Home")) { <a class="nav-link @(ctrl == "Home" ? "active" : "")" href="/Home"><i class="bi bi-speedometer2 me-2"></i><t key="salon.sidebar.dashboard">Dashboard</t></a> }
                @if (canShow("Clients")) { <a class="nav-link @(ctrl == "Clients" ? "active" : "")" href="/Clients"><i class="bi bi-people-fill me-2"></i><t key="salon.sidebar.clients">Müşteriler</t></a> }
                @if (canShow("Appointments")) { <a class="nav-link @(ctrl == "Appointments" ? "active" : "")" href="/Appointments"><i class="bi bi-calendar-check me-2"></i><t key="salon.sidebar.appointments">Randevular</t></a> }
                @if (canShow("Waitlist")) { <a class="nav-link @(ctrl == "Waitlist" ? "active" : "")" href="/Waitlist"><i class="bi bi-clock-history me-2"></i><t key="salon.sidebar.waitlist">Bekleme Listesi</t></a> }
            </div>
            }

            @{ var opsLinks = new[] { "Services", "Staff", "Recipes", "PersonnelPrices" }.Where(p => canShow(p)).ToArray(); }
            @if (opsLinks.Length > 0) {
            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span><t key="salon.sidebar.operations">Operasyon</t></span><i class="bi bi-chevron-down chevron @(opsOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(opsOpen ? "show" : "")">
                @if (canShow("Services")) { <a class="nav-link @(ctrl == "Services" ? "active" : "")" href="/Services"><i class="bi bi-list-check me-2"></i><t key="salon.sidebar.services">Hizmetler</t></a> }
                @if (canShow("Staff")) { <a class="nav-link @(ctrl == "Staff" ? "active" : "")" href="/Staff"><i class="bi bi-person-badge me-2"></i><t key="salon.sidebar.staff">Personel</t></a> }
                @if (canShow("Recipes")) { <a class="nav-link @(ctrl == "Recipes" ? "active" : "")" href="/Recipes"><i class="bi bi-journal-bookmark me-2"></i><t key="salon.sidebar.recipes">Reçeteler</t></a> }
                @if (canShow("PersonnelPrices")) { <a class="nav-link @(ctrl == "PersonnelPrices" ? "active" : "")" href="/PersonnelPrices"><i class="bi bi-currency-exchange me-2"></i><t key="salon.sidebar.personnel_prices">Personel Fiyatları</t></a> }
            </div>
            }

            @{ var stockLinks = new[] { "Products", "Suppliers" }.Where(p => canShow(p)).ToArray(); }
            @if (stockLinks.Length > 0) {
            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span><t key="salon.sidebar.inventory">Stok</t></span><i class="bi bi-chevron-down chevron @(stockOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(stockOpen ? "show" : "")">
                @if (canShow("Products")) { <a class="nav-link @(ctrl == "Products" ? "active" : "")" href="/Products"><i class="bi bi-box-seam me-2"></i><t key="salon.sidebar.products">Ürünler</t></a> }
                @if (canShow("Suppliers")) { <a class="nav-link @(ctrl == "Suppliers" ? "active" : "")" href="/Suppliers"><i class="bi bi-truck me-2"></i><t key="salon.sidebar.suppliers">Tedarikçiler</t></a> }
            </div>
            }

            @{ var finLinks = new[] { "Invoices", "Cash", "Expenses", "GiftCards", "Packages" }.Where(p => canShow(p)).ToArray(); }
            @if (finLinks.Length > 0) {
            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span><t key="salon.sidebar.finance">Finans</t></span><i class="bi bi-chevron-down chevron @(financeOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(financeOpen ? "show" : "")">
                @if (canShow("Invoices")) { <a class="nav-link @(ctrl == "Invoices" ? "active" : "")" href="/Invoices"><i class="bi bi-receipt me-2"></i><t key="salon.sidebar.invoices">Adisyonlar</t></a> }
                @if (canShow("Cash")) { <a class="nav-link @(ctrl == "Cash" ? "active" : "")" href="/Cash"><i class="bi bi-cash-stack me-2"></i><t key="salon.sidebar.cash">Kasa</t></a> }
                @if (canShow("Expenses")) { <a class="nav-link @(ctrl == "Expenses" ? "active" : "")" href="/Expenses"><i class="bi bi-credit-card me-2"></i><t key="salon.sidebar.expenses">Masraflar</t></a> }
                @if (canShow("GiftCards")) { <a class="nav-link @(ctrl == "GiftCards" ? "active" : "")" href="/GiftCards"><i class="bi bi-gift me-2"></i><t key="salon.sidebar.gift_cards">Hediye Kartları</t></a> }
                @if (canShow("Packages")) { <a class="nav-link @(ctrl == "Packages" ? "active" : "")" href="/Packages"><i class="bi bi-box-seam me-2"></i><t key="salon.sidebar.packages">Seans Paketleri</t></a> }
            </div>
            }

            @{ var mktLinks = new[] { "Campaigns", "Memberships", "Loyalty", "EmailCampaigns", "Reviews", "Winback" }.Where(p => canShow(p)).ToArray(); }
            @if (mktLinks.Length > 0) {
            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span><t key="salon.sidebar.marketing">Pazarlama</t></span><i class="bi bi-chevron-down chevron @(marketingOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(marketingOpen ? "show" : "")">
                @if (canShow("Campaigns")) { <a class="nav-link @(ctrl == "Campaigns" ? "active" : "")" href="/Campaigns"><i class="bi bi-megaphone me-2"></i><t key="salon.sidebar.campaigns">Kampanyalar</t></a> }
                @if (canShow("Memberships")) { <a class="nav-link @(ctrl == "Memberships" ? "active" : "")" href="/Memberships"><i class="bi bi-award me-2"></i><t key="salon.sidebar.memberships">Üyelik Planları</t></a> }
                @if (canShow("Loyalty")) { <a class="nav-link @(ctrl == "Loyalty" ? "active" : "")" href="/Loyalty"><i class="bi bi-star me-2"></i><t key="salon.sidebar.loyalty">Sadakat Programı</t></a> }
                @if (canShow("EmailCampaigns")) { <a class="nav-link @(ctrl == "EmailCampaigns" ? "active" : "")" href="/EmailCampaigns"><i class="bi bi-envelope me-2"></i><t key="salon.sidebar.email_campaigns">E-posta Kampanyaları</t></a> }
                @if (canShow("Reviews")) { <a class="nav-link @(ctrl == "Reviews" ? "active" : "")" href="/Reviews"><i class="bi bi-chat-square-text me-2"></i><t key="salon.sidebar.reviews">Yorumlar</t></a> }
                @if (canShow("Winback")) { <a class="nav-link @(ctrl == "Winback" ? "active" : "")" href="/Winback"><i class="bi bi-arrow-repeat me-2"></i><t key="salon.sidebar.winback">Geri Kazanım</t></a> }
            </div>
            }

            @if (canShow("Reports")) {
            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span><t key="salon.sidebar.reports">Raporlar</t></span><i class="bi bi-chevron-down chevron @(reportOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(reportOpen ? "show" : "")">
                <a class="nav-link @(ctrl == "Reports" ? "active" : "")" href="/Reports"><i class="bi bi-bar-chart-line me-2"></i><t key="salon.sidebar.reports">Raporlar</t></a>
            </div>
            }

            @{ var mngLinks = new[] { "Profile", "Branches", "NoShowPolicy", "ConsentForms", "BeforeAfter", "EmailSettings", "PageSettings", "PaymentInfo", "Modules" }.Where(p => canShow(p)).ToArray(); }
            @if (mngLinks.Length > 0) {
            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span><t key="salon.sidebar.management">Yönetim</t></span><i class="bi bi-chevron-down chevron @(managementOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(managementOpen ? "show" : "")">
                @if (canShow("Profile")) { <a class="nav-link @(ctrl == "Profile" ? "active" : "")" href="/Profile"><i class="bi bi-shop me-2"></i><t key="salon.sidebar.profile">Salon Profili</t></a> }
                @if (canShow("Branches")) { <a class="nav-link @(ctrl == "Branches" ? "active" : "")" href="/Branches"><i class="bi bi-building me-2"></i><t key="salon.sidebar.branches">Şubeler</t></a> }
                @if (canShow("NoShowPolicy")) { <a class="nav-link @(ctrl == "NoShowPolicy" ? "active" : "")" href="/NoShowPolicy"><i class="bi bi-shield-exclamation me-2"></i><t key="salon.sidebar.noshow_policy">Randevu Kuralları</t></a> }
                @if (canShow("ConsentForms")) { <a class="nav-link @(ctrl == "ConsentForms" ? "active" : "")" href="/ConsentForms"><i class="bi bi-file-earmark-text me-2"></i><t key="salon.sidebar.consent_forms">Onay Formları</t></a> }
                @if (canShow("BeforeAfter")) { <a class="nav-link @(ctrl == "BeforeAfter" ? "active" : "")" href="/BeforeAfter"><i class="bi bi-images me-2"></i><t key="salon.sidebar.before_after">Önce/Sonra</t></a> }
                @if (canShow("EmailSettings")) { <a class="nav-link @(ctrl == "EmailSettings" ? "active" : "")" href="/EmailSettings"><i class="bi bi-envelope-at me-2"></i><t key="salon.sidebar.email_settings">E-posta Ayarları</t></a> }
                @if (canShow("PageSettings")) { <a class="nav-link @(ctrl == "PageSettings" ? "active" : "")" href="/PageSettings"><i class="bi bi-layout-text-sidebar me-2"></i><t key="salon.sidebar.page_settings">Sayfa Ayarları</t></a> }
                @if (canShow("PaymentInfo")) { <a class="nav-link @(ctrl == "PaymentInfo" ? "active" : "")" href="/PaymentInfo"><i class="bi bi-bank me-2"></i><t key="salon.sidebar.payment_info">Ödeme Bilgileri</t></a> }
                @if (canShow("Modules")) { <a class="nav-link @(ctrl == "Modules" ? "active" : "")" href="/Modules"><i class="bi bi-puzzle me-2"></i><t key="salon.sidebar.modules">Modüller</t></a> }
            </div>
            }

            <div style="position:absolute;bottom:0;width:100%;border-top:1px solid rgba(255,255,255,.1);padding:.8rem 1rem;">
                <div class="d-flex align-items-center justify-content-between">
                    <small class="text-white-50">
                        <i class="bi bi-person-circle me-1"></i>@__jwt.FullName
                    </small>
                    <a href="/Account/Logout" class="text-white-50" title="@(Translation.T("salon.common.logout_tooltip", "Çıkış"))"><i class="bi bi-box-arrow-right"></i></a>
                </div>
            </div>
        </nav>

        <div class="content-area">
            <div class="topbar">
                <h5 class="mb-0">@ViewData["Title"]</h5>
                <div class="d-flex align-items-center gap-3">
                    <div id="branchSelector"></div>
                    <small class="text-muted">@__jwt.CustomerName</small>
                </div>
            </div>
            <div id="slnBillingBanners" class="d-print-none"></div>
            @RenderBody()
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/knockout/knockout-latest.min.js"></script>
    <link href="/lib/toastr/toastr.min.css" rel="stylesheet" />
    <script src="/lib/toastr/toastr.min.js"></script>
    <script src="~/js/confirm-modal.js" asp-append-version="true"></script>
    <script src="~/js/autocomplete-helper.js" asp-append-version="true"></script>
    <script src="~/js/phone-input.js" asp-append-version="true"></script>
    <script>
        window.salonTranslations = Object.assign({}, window.salonTranslations || {}, @Html.Raw(__layoutTranslationsJson));
        window.salonT = window.salonT || function(key, fallback) {
            return (window.salonTranslations && window.salonTranslations[key]) || fallback || key;
        };

        // AJAX hata yonetimi — sadece 401 (oturum suresi doldu) login'e yonlendirir.
        // 403 (modul aktif degil / yetki yok) redirect tetiklemez; sayfa kendi hatasini gosterir.
        var _redirecting = false;
        // Varsayilan json cevirici: bos veya sadece bosluk → JSON.parse "Unexpected end of input" uretmesin.
        // Tum sayfalardaki $.get/otomatik MIME json yolu buradan gecer (or. /Modules, proxy 200 + bos govde).
        $.ajaxSetup({
            converters: {
                'text json': function (data) {
                    if (data == null || data === '') return null;
                    var t = (typeof data === 'string' ? data : String(data)).trim();
                    if (!t) return null;
                    try { return JSON.parse(t); } catch (e) { return null; }
                }
            },
            error: function(xhr) {
                if (xhr.status === 401 && !_redirecting
                    && !location.pathname.match(/^\/Account\/Login/i)) {
                    _redirecting = true;
                    window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(location.pathname + location.search);
                }
            }
        });

        // Toastr ayarlari
        toastr.options = { closeButton: true, progressBar: true, positionClass: 'toast-top-right', timeOut: 3000 };

        function toggleGroup(btn) {
            var items = btn.nextElementSibling;
            var chevron = btn.querySelector('.chevron');
            var isOpen = items.classList.contains('show');

            // Accordion: diger acik gruplari kapat
            document.querySelectorAll('.nav-group-items.show').forEach(function(el) {
                el.classList.remove('show');
                var prev = el.previousElementSibling;
                if (prev) { var c = prev.querySelector('.chevron'); if (c) c.classList.remove('open'); }
            });

            // Tiklanani toggle et
            if (!isOpen) {
                items.classList.add('show');
                chevron.classList.add('open');
            }
        }

        // ═══ Sube Secici — sessionStorage tabanli (cookie yok) ═══
        // UI secim sessionStorage'da; her API cagrisi proxy/SlnProxyHelper query'sine branchId ekler.
        // Eski SelectedBranch cookie'si varsa temizle (geri uyumluluk).
        document.cookie = 'SelectedBranch=;path=/;max-age=0';

        window.slnGetBranch = function() {
            var v = sessionStorage.getItem('slnBranchId');
            return v ? v : '';
        };
        (function() {
            var roleId = parseInt('@(__jwt.CustomerRoleId > 0 ? __jwt.CustomerRoleId : 101)');
            var jwtBranch = '@(__jwt.BranchId?.ToString() ?? "")';
            var sessionKey = '@__jwt.UserName' + '|' + roleId + '|' + (jwtBranch || '');
            var previousSessionKey = sessionStorage.getItem('slnBranchSessionKey');
            if (previousSessionKey !== sessionKey) {
                if (jwtBranch) sessionStorage.setItem('slnBranchId', jwtBranch);
                else sessionStorage.removeItem('slnBranchId');
                sessionStorage.setItem('slnBranchSessionKey', sessionKey);
            }
            // JWT'de BranchId varsa (personel) baglantiyi sessionStorage'a her zaman senkronla.
            if (jwtBranch) {
                sessionStorage.setItem('slnBranchId', jwtBranch);
            }
            var currentBranch = window.slnGetBranch();
            if (roleId !== 101) return; // Sadece salon sahibi sube degistirebilir

            $.ajax({ url: '/proxy/sln-branches?_nb=1', dataType: 'text', cache: false })
                .done(function (text, _st, xhr) {
                    if (xhr && (xhr.status === 204 || xhr.status === 205)) return;
                    var t = text == null ? '' : String(text).trim();
                    if (!t || t === 'null') return;
                    var data;
                    try { data = JSON.parse(t); } catch (e) { return; }
                    var branches = Array.isArray(data) ? data : ((data && data.items) || []);
                    if (branches.length <= 1) return;

                    var html = '<select class="form-select form-select-sm" style="width:auto; min-width:150px;" onchange="switchBranch(this.value)">';
                    html += '<option value=""' + (currentBranch === '' ? ' selected' : '') + '>' + salonT('salon.common.all_branches', 'Tüm Şubeler') + '</option>';
                    branches.forEach(function (b) {
                        html += '<option value="' + b.id + '"' + (currentBranch == b.id ? ' selected' : '') + '>' + b.name + '</option>';
                    });
                    html += '</select>';
                    document.getElementById('branchSelector').innerHTML = html;
                })
                .fail(function () { /* tek sube veya yetki */ });
        })();

        function switchBranch(branchId) {
            if (!branchId) sessionStorage.removeItem('slnBranchId');
            else sessionStorage.setItem('slnBranchId', branchId);
            window.location.reload();
        }

        // ═══ Sube branchId enjektoru ═══
        // jQuery $.ajax HEM ajaxPrefilter HEM de wrapper ile garantilenir
        // (ajaxPrefilter bazi cagrilarda atlanabiliyor — wrapper kesin ceker)
        function _injectBranch(url) {
            if (!url || url.indexOf('/proxy/') < 0) return url;
            if (url.indexOf('_nb=1') >= 0) return url;
            if (/([?&])branchId=/.test(url)) return url;
            var b = window.slnGetBranch();
            if (!b) return url;
            return url + (url.indexOf('?') >= 0 ? '&' : '?') + 'branchId=' + encodeURIComponent(b);
        }
        $.ajaxPrefilter(function(opts) {
            opts.url = _injectBranch(opts.url);
        });
        // Wrap $.ajax (aksi takdirde $.get/$.post path'i bypass edilebiliyor)
        var _origAjax = $.ajax;
        $.ajax = function(urlOrOpts, maybeOpts) {
            var opts = (typeof urlOrOpts === 'string') ? Object.assign({ url: urlOrOpts }, maybeOpts || {}) : (urlOrOpts || {});
            opts.url = _injectBranch(opts.url);
            return _origAjax.call(this, opts);
        };
        // fetch() icin: kullanan sayfalar manuel eklesin (public Discover/Book slug tabanli)
        var _origFetch = window.fetch;
        if (_origFetch) {
            window.fetch = function(input, init) {
                if (typeof input === 'string') input = _injectBranch(input);
                return _origFetch.call(this, input, init);
            };
        }
    </script>
    @if (__jwt.IsAuthenticated)
    {
        <script src="~/js/layout-banners.js" asp-append-version="true"></script>
    }
    @RenderSection("Scripts", required: false)
</body>
</html>
