<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CorpLynk Salon</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        :root { --sidebar-width: 240px; }
        body { font-family: 'Segoe UI', system-ui, sans-serif; background: #f0f2f5; }
        .sidebar {
            width: var(--sidebar-width); height: 100vh; position: fixed; top: 0; left: 0;
            background: linear-gradient(180deg, #2d1b3d 0%, #1a1028 100%);
            color: #fff; overflow-y: auto; z-index: 1000;
        }
        .sidebar .brand { padding: 1rem; font-size: 1.1rem; font-weight: 700; border-bottom: 1px solid rgba(255,255,255,.1); }
        .sidebar .brand span { color: #ce93d8; }
        .sidebar .nav-link { color: rgba(255,255,255,.7); padding: .6rem 1rem; font-size: .875rem; border-radius: 6px; margin: 2px 8px; }
        .sidebar .nav-link:hover { color: #fff; background: rgba(255,255,255,.1); }
        .sidebar .nav-link.active { color: #fff; background: rgba(206,147,216,.2); }
        .sidebar .nav-section { color: rgba(255,255,255,.4); font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; padding: .8rem 1rem .3rem; }
        .sidebar .nav-group-toggle {
            display: flex; align-items: center; width: 100%; padding: .6rem 1rem;
            color: rgba(255,255,255,.5); background: none; border: none;
            font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; cursor: pointer;
        }
        .sidebar .nav-group-toggle:hover { color: rgba(255,255,255,.7); }
        .sidebar .nav-group-toggle span { flex: 1; text-align: left; }
        .sidebar .nav-group-toggle .chevron { font-size: .6rem; transition: transform .2s ease; opacity: .5; }
        .sidebar .nav-group-toggle .chevron.open { transform: rotate(180deg); }
        .sidebar .nav-group-items { max-height: 0; overflow: hidden; transition: max-height .25s ease; }
        .sidebar .nav-group-items.show { max-height: 500px; }
        .content-area { margin-left: var(--sidebar-width); padding: 1.5rem; min-height: 100vh; }
        .topbar { background: #fff; border-bottom: 1px solid #e0e0e0; padding: .6rem 1.5rem; margin: -1.5rem -1.5rem 1.5rem; display: flex; align-items: center; justify-content: space-between; }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    @if (Context.Session.GetString("Token") != null)
    {
        <nav class="sidebar d-print-none">
            <div class="brand">
                <i class="bi bi-scissors me-2"></i>CorpLynk <span>Salon</span>
            </div>
            @{
                var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                var mainOpen = ctrl is "Home" or "Clients" or "Appointments";
                var opsOpen = ctrl is "Services" or "Staff";
                var stockOpen = ctrl is "Products" or "Suppliers";
                var financeOpen = ctrl is "Invoices" or "Cash" or "Expenses";
                var reportOpen = ctrl is "Reports";
                var marketingOpen = ctrl is "Campaigns";
                var managementOpen = ctrl is "Branches";
            }

            <button class="nav-group-toggle mt-2" onclick="toggleGroup(this)">
                <span>Salon</span>
                <i class="bi bi-chevron-down chevron @(mainOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(mainOpen ? "show" : "")">
                <a class="nav-link @(ctrl == "Home" ? "active" : "")" href="/">
                    <i class="bi bi-speedometer2 me-2"></i>Dashboard
                </a>
                <a class="nav-link @(ctrl == "Clients" ? "active" : "")" href="/Clients">
                    <i class="bi bi-people-fill me-2"></i>Musteriler
                </a>
                <a class="nav-link @(ctrl == "Appointments" ? "active" : "")" href="/Appointments">
                    <i class="bi bi-calendar-check me-2"></i>Randevular
                </a>
            </div>

            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span>Operasyon</span>
                <i class="bi bi-chevron-down chevron @(opsOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(opsOpen ? "show" : "")">
                <a class="nav-link @(ctrl == "Services" ? "active" : "")" href="/Services">
                    <i class="bi bi-list-check me-2"></i>Hizmetler
                </a>
                <a class="nav-link @(ctrl == "Staff" ? "active" : "")" href="/Staff">
                    <i class="bi bi-person-badge me-2"></i>Personel
                </a>
            </div>

            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span>Stok</span>
                <i class="bi bi-chevron-down chevron @(stockOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(stockOpen ? "show" : "")">
                <a class="nav-link @(ctrl == "Products" ? "active" : "")" href="/Products">
                    <i class="bi bi-box-seam me-2"></i>Urunler
                </a>
                <a class="nav-link @(ctrl == "Suppliers" ? "active" : "")" href="/Suppliers">
                    <i class="bi bi-truck me-2"></i>Tedarikciler
                </a>
            </div>

            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span>Finans</span>
                <i class="bi bi-chevron-down chevron @(financeOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(financeOpen ? "show" : "")">
                <a class="nav-link @(ctrl == "Invoices" ? "active" : "")" href="/Invoices">
                    <i class="bi bi-receipt me-2"></i>Adisyonlar
                </a>
                <a class="nav-link @(ctrl == "Cash" ? "active" : "")" href="/Cash">
                    <i class="bi bi-cash-stack me-2"></i>Kasa
                </a>
                <a class="nav-link @(ctrl == "Expenses" ? "active" : "")" href="/Expenses">
                    <i class="bi bi-credit-card me-2"></i>Masraflar
                </a>
            </div>

            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span>Pazarlama</span>
                <i class="bi bi-chevron-down chevron @(marketingOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(marketingOpen ? "show" : "")">
                <a class="nav-link @(ctrl == "Campaigns" ? "active" : "")" href="/Campaigns">
                    <i class="bi bi-megaphone me-2"></i>Kampanyalar
                </a>
            </div>

            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span>Raporlar</span>
                <i class="bi bi-chevron-down chevron @(reportOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(reportOpen ? "show" : "")">
                <a class="nav-link @(ctrl == "Reports" ? "active" : "")" href="/Reports">
                    <i class="bi bi-bar-chart-line me-2"></i>Raporlar
                </a>
            </div>

            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span>Yonetim</span>
                <i class="bi bi-chevron-down chevron @(managementOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(managementOpen ? "show" : "")">
                <a class="nav-link @(ctrl == "Branches" ? "active" : "")" href="/Branches">
                    <i class="bi bi-building me-2"></i>Subeler
                </a>
            </div>

            <div style="position:absolute;bottom:0;width:100%;border-top:1px solid rgba(255,255,255,.1);padding:.8rem 1rem;">
                <div class="d-flex align-items-center justify-content-between">
                    <small class="text-white-50">
                        <i class="bi bi-person-circle me-1"></i>@Context.Session.GetString("UserName")
                    </small>
                    <a href="/Account/Logout" class="text-white-50" title="Cikis"><i class="bi bi-box-arrow-right"></i></a>
                </div>
            </div>
        </nav>

        <div class="content-area">
            <div class="topbar">
                <h5 class="mb-0">@ViewData["Title"]</h5>
                <small class="text-muted">@Context.Session.GetString("CustomerName")</small>
            </div>
            @RenderBody()
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/knockout@3.5.1/build/output/knockout-latest.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/autocomplete-helper.js"></script>
    <script>
        // AJAX hata yonetimi (401 -> login)
        $.ajaxSetup({
            error: function(xhr) {
                if (xhr.status === 401) window.location.href = '/Account/Login';
            }
        });

        // Toastr ayarlari
        toastr.options = { closeButton: true, progressBar: true, positionClass: 'toast-top-right', timeOut: 3000 };

        function toggleGroup(btn) {
            var items = btn.nextElementSibling;
            var chevron = btn.querySelector('.chevron');
            items.classList.toggle('show');
            chevron.classList.toggle('open');
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
