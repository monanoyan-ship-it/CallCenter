<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CorpLynk Salon</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        :root { --sidebar-width: 240px; }
        body { font-family: 'Segoe UI', system-ui, sans-serif; background: #f0f2f5; }
        .sidebar {
            width: var(--sidebar-width); height: 100vh; position: fixed; top: 0; left: 0;
            background: linear-gradient(180deg, #2d1b3d 0%, #1a1028 100%);
            color: #fff; overflow-y: auto; z-index: 1000;
        }
        .sidebar .brand { padding: 1rem; font-size: 1.1rem; font-weight: 700; border-bottom: 1px solid rgba(255,255,255,.1); }
        .sidebar .brand span { color: #ce93d8; }
        .sidebar .nav-link { color: rgba(255,255,255,.7); padding: .6rem 1rem; font-size: .875rem; border-radius: 6px; margin: 2px 8px; }
        .sidebar .nav-link:hover { color: #fff; background: rgba(255,255,255,.1); }
        .sidebar .nav-link.active { color: #fff; background: rgba(206,147,216,.2); }
        .sidebar .nav-section { color: rgba(255,255,255,.4); font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; padding: .8rem 1rem .3rem; }
        .sidebar .nav-group-toggle {
            display: flex; align-items: center; width: 100%; padding: .6rem 1rem;
            color: rgba(255,255,255,.5); background: none; border: none;
            font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; cursor: pointer;
        }
        .sidebar .nav-group-toggle:hover { color: rgba(255,255,255,.7); }
        .sidebar .nav-group-toggle span { flex: 1; text-align: left; }
        .sidebar .nav-group-toggle .chevron { font-size: .6rem; transition: transform .2s ease; opacity: .5; }
        .sidebar .nav-group-toggle .chevron.open { transform: rotate(180deg); }
        .sidebar .nav-group-items { max-height: 0; overflow: hidden; transition: max-height .25s ease; }
        .sidebar .nav-group-items.show { max-height: 500px; }
        .content-area { margin-left: var(--sidebar-width); padding: 1.5rem; min-height: 100vh; }
        .topbar { background: #fff; border-bottom: 1px solid #e0e0e0; padding: .6rem 1.5rem; margin: -1.5rem -1.5rem 1.5rem; display: flex; align-items: center; justify-content: space-between; }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    @{ var __jwt = CallCenter.Shared.Auth.JwtIdentityExtensions.GetJwtIdentity(Context); }
    @if (__jwt.IsAuthenticated)
    {
        <nav class="sidebar d-print-none">
            <div class="brand">
                <i class="bi bi-scissors me-2"></i>CorpLynk <span>Salon</span>
            </div>
            @{
                var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                var roleId = __jwt.CustomerRoleId > 0 ? __jwt.CustomerRoleId : 101;
                var can = CallCenter.Shared.Enums.SalonRolePermissions.GetAccessiblePages(roleId);

                // Modul filtresi: aktif olmayan modullerin sayfalari sidebar'da gorunmez
                var modulesCsv = __jwt.CustomerModules;
                var activeModuleIds = modulesCsv.Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(s => int.TryParse(s.Trim(), out var mid) ? mid : 0)
                    .Where(id => id > 0)
                    .ToHashSet();
                // Cift katmanli kontrol: rol erisimi + modul aktif
                bool canShow(string page) => can.Contains(page)
                    && CallCenter.Shared.Enums.SalonModuleControllerMap.HasModule(activeModuleIds, page);

                // Grup acik/kapali durumu
                var mainOpen = ctrl is "Home" or "Clients" or "Appointments" or "Waitlist";
                var opsOpen = ctrl is "Services" or "Staff" or "Recipes" or "PersonnelPrices";
                var stockOpen = ctrl is "Products" or "Suppliers";
                var financeOpen = ctrl is "Invoices" or "Cash" or "Expenses" or "GiftCards" or "Packages";
                var reportOpen = ctrl is "Reports";
                var marketingOpen = ctrl is "Campaigns" or "Loyalty" or "Memberships" or "EmailCampaigns" or "Reviews" or "Winback";
                var managementOpen = ctrl is "Branches" or "Profile" or "NoShowPolicy" or "ConsentForms" or "BeforeAfter" or "EmailSettings" or "PageSettings";
            }

            @if (canShow("Sales")) {
            <a class="nav-link mt-2 @(ctrl == "Sales" ? "active" : "")" href="/Sales" style="font-size:.95rem;">
                <i class="bi bi-cart-check-fill me-2"></i><strong>Hizli Satis</strong>
            </a>
            }

            @{ var salonLinks = new[] { "Home", "Clients", "Appointments", "Waitlist" }.Where(p => canShow(p)).ToArray(); }
            @if (salonLinks.Length > 0) {
            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span>Salon</span><i class="bi bi-chevron-down chevron @(mainOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(mainOpen ? "show" : "")">
                @if (canShow("Home")) { <a class="nav-link @(ctrl == "Home" ? "active" : "")" href="/Home"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a> }
                @if (canShow("Clients")) { <a class="nav-link @(ctrl == "Clients" ? "active" : "")" href="/Clients"><i class="bi bi-people-fill me-2"></i>Musteriler</a> }
                @if (canShow("Appointments")) { <a class="nav-link @(ctrl == "Appointments" ? "active" : "")" href="/Appointments"><i class="bi bi-calendar-check me-2"></i>Randevular</a> }
                @if (canShow("Waitlist")) { <a class="nav-link @(ctrl == "Waitlist" ? "active" : "")" href="/Waitlist"><i class="bi bi-clock-history me-2"></i>Bekleme Listesi</a> }
            </div>
            }

            @{ var opsLinks = new[] { "Services", "Staff", "Recipes", "PersonnelPrices" }.Where(p => canShow(p)).ToArray(); }
            @if (opsLinks.Length > 0) {
            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span>Operasyon</span><i class="bi bi-chevron-down chevron @(opsOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(opsOpen ? "show" : "")">
                @if (canShow("Services")) { <a class="nav-link @(ctrl == "Services" ? "active" : "")" href="/Services"><i class="bi bi-list-check me-2"></i>Hizmetler</a> }
                @if (canShow("Staff")) { <a class="nav-link @(ctrl == "Staff" ? "active" : "")" href="/Staff"><i class="bi bi-person-badge me-2"></i>Personel</a> }
                @if (canShow("Recipes")) { <a class="nav-link @(ctrl == "Recipes" ? "active" : "")" href="/Recipes"><i class="bi bi-journal-bookmark me-2"></i>Receteler</a> }
                @if (canShow("PersonnelPrices")) { <a class="nav-link @(ctrl == "PersonnelPrices" ? "active" : "")" href="/PersonnelPrices"><i class="bi bi-currency-exchange me-2"></i>Personel Fiyatlari</a> }
            </div>
            }

            @{ var stockLinks = new[] { "Products", "Suppliers" }.Where(p => canShow(p)).ToArray(); }
            @if (stockLinks.Length > 0) {
            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span>Stok</span><i class="bi bi-chevron-down chevron @(stockOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(stockOpen ? "show" : "")">
                @if (canShow("Products")) { <a class="nav-link @(ctrl == "Products" ? "active" : "")" href="/Products"><i class="bi bi-box-seam me-2"></i>Urunler</a> }
                @if (canShow("Suppliers")) { <a class="nav-link @(ctrl == "Suppliers" ? "active" : "")" href="/Suppliers"><i class="bi bi-truck me-2"></i>Tedarikciler</a> }
            </div>
            }

            @{ var finLinks = new[] { "Invoices", "Cash", "Expenses", "GiftCards", "Packages" }.Where(p => canShow(p)).ToArray(); }
            @if (finLinks.Length > 0) {
            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span>Finans</span><i class="bi bi-chevron-down chevron @(financeOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(financeOpen ? "show" : "")">
                @if (canShow("Invoices")) { <a class="nav-link @(ctrl == "Invoices" ? "active" : "")" href="/Invoices"><i class="bi bi-receipt me-2"></i>Adisyonlar</a> }
                @if (canShow("Cash")) { <a class="nav-link @(ctrl == "Cash" ? "active" : "")" href="/Cash"><i class="bi bi-cash-stack me-2"></i>Kasa</a> }
                @if (canShow("Expenses")) { <a class="nav-link @(ctrl == "Expenses" ? "active" : "")" href="/Expenses"><i class="bi bi-credit-card me-2"></i>Masraflar</a> }
                @if (canShow("GiftCards")) { <a class="nav-link @(ctrl == "GiftCards" ? "active" : "")" href="/GiftCards"><i class="bi bi-gift me-2"></i>Hediye Kartlari</a> }
                @if (canShow("Packages")) { <a class="nav-link @(ctrl == "Packages" ? "active" : "")" href="/Packages"><i class="bi bi-box-seam me-2"></i>Seans Paketleri</a> }
            </div>
            }

            @{ var mktLinks = new[] { "Campaigns", "Memberships", "Loyalty", "EmailCampaigns", "Reviews", "Winback" }.Where(p => canShow(p)).ToArray(); }
            @if (mktLinks.Length > 0) {
            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span>Pazarlama</span><i class="bi bi-chevron-down chevron @(marketingOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(marketingOpen ? "show" : "")">
                @if (canShow("Campaigns")) { <a class="nav-link @(ctrl == "Campaigns" ? "active" : "")" href="/Campaigns"><i class="bi bi-megaphone me-2"></i>Kampanyalar</a> }
                @if (canShow("Memberships")) { <a class="nav-link @(ctrl == "Memberships" ? "active" : "")" href="/Memberships"><i class="bi bi-award me-2"></i>Uyelik Planlari</a> }
                @if (canShow("Loyalty")) { <a class="nav-link @(ctrl == "Loyalty" ? "active" : "")" href="/Loyalty"><i class="bi bi-star me-2"></i>Sadakat Programi</a> }
                @if (canShow("EmailCampaigns")) { <a class="nav-link @(ctrl == "EmailCampaigns" ? "active" : "")" href="/EmailCampaigns"><i class="bi bi-envelope me-2"></i>E-posta Kampanyalari</a> }
                @if (canShow("Reviews")) { <a class="nav-link @(ctrl == "Reviews" ? "active" : "")" href="/Reviews"><i class="bi bi-chat-square-text me-2"></i>Yorumlar</a> }
                @if (canShow("Winback")) { <a class="nav-link @(ctrl == "Winback" ? "active" : "")" href="/Winback"><i class="bi bi-arrow-repeat me-2"></i>Geri Kazanim</a> }
            </div>
            }

            @if (canShow("Reports")) {
            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span>Raporlar</span><i class="bi bi-chevron-down chevron @(reportOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(reportOpen ? "show" : "")">
                <a class="nav-link @(ctrl == "Reports" ? "active" : "")" href="/Reports"><i class="bi bi-bar-chart-line me-2"></i>Raporlar</a>
            </div>
            }

            @{ var mngLinks = new[] { "Profile", "Branches", "NoShowPolicy", "ConsentForms", "BeforeAfter", "EmailSettings", "PageSettings", "Modules" }.Where(p => can.Contains(p)).ToArray(); }
            @if (mngLinks.Length > 0) {
            <button class="nav-group-toggle mt-1" onclick="toggleGroup(this)">
                <span>Yonetim</span><i class="bi bi-chevron-down chevron @(managementOpen ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(managementOpen ? "show" : "")">
                @if (canShow("Profile")) { <a class="nav-link @(ctrl == "Profile" ? "active" : "")" href="/Profile"><i class="bi bi-shop me-2"></i>Salon Profili</a> }
                @if (canShow("Branches")) { <a class="nav-link @(ctrl == "Branches" ? "active" : "")" href="/Branches"><i class="bi bi-building me-2"></i>Subeler</a> }
                @if (canShow("NoShowPolicy")) { <a class="nav-link @(ctrl == "NoShowPolicy" ? "active" : "")" href="/NoShowPolicy"><i class="bi bi-shield-exclamation me-2"></i>Randevu Kurallari</a> }
                @if (canShow("ConsentForms")) { <a class="nav-link @(ctrl == "ConsentForms" ? "active" : "")" href="/ConsentForms"><i class="bi bi-file-earmark-text me-2"></i>Onay Formlari</a> }
                @if (canShow("BeforeAfter")) { <a class="nav-link @(ctrl == "BeforeAfter" ? "active" : "")" href="/BeforeAfter"><i class="bi bi-images me-2"></i>Once/Sonra</a> }
                @if (canShow("EmailSettings")) { <a class="nav-link @(ctrl == "EmailSettings" ? "active" : "")" href="/EmailSettings"><i class="bi bi-envelope-at me-2"></i>E-posta Ayarlari</a> }
                @if (canShow("PageSettings")) { <a class="nav-link @(ctrl == "PageSettings" ? "active" : "")" href="/PageSettings"><i class="bi bi-layout-text-sidebar me-2"></i>Sayfa Ayarlari</a> }
                @if (can.Contains("Modules")) { <a class="nav-link @(ctrl == "Modules" ? "active" : "")" href="/Modules"><i class="bi bi-puzzle me-2"></i>Moduller</a> }
            </div>
            }

            <div style="position:absolute;bottom:0;width:100%;border-top:1px solid rgba(255,255,255,.1);padding:.8rem 1rem;">
                <div class="d-flex align-items-center justify-content-between">
                    <small class="text-white-50">
                        <i class="bi bi-person-circle me-1"></i>@__jwt.FullName
                    </small>
                    <a href="/Account/Logout" class="text-white-50" title="Cikis"><i class="bi bi-box-arrow-right"></i></a>
                </div>
            </div>
        </nav>

        <div class="content-area">
            <div class="topbar">
                <h5 class="mb-0">@ViewData["Title"]</h5>
                <div class="d-flex align-items-center gap-3">
                    <div id="branchSelector"></div>
                    <small class="text-muted">@__jwt.CustomerName</small>
                </div>
            </div>
            @RenderBody()
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/knockout@3.5.1/build/output/knockout-latest.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/confirm-modal.js" asp-append-version="true"></script>
    <script src="~/js/autocomplete-helper.js" asp-append-version="true"></script>
    <script src="~/js/phone-input.js" asp-append-version="true"></script>
    <script>
        // AJAX hata yonetimi (401/403 -> login, tek seferlik yonlendirme + zaten Login'deysek dokunma)
        var _redirecting = false;
        $.ajaxSetup({
            dataType: 'json',
            error: function(xhr) {
                if ((xhr.status === 401 || xhr.status === 403) && !_redirecting
                    && !location.pathname.match(/^\/Account\/Login/i)) {
                    _redirecting = true;
                    window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(location.pathname + location.search);
                }
            }
        });

        // Toastr ayarlari
        toastr.options = { closeButton: true, progressBar: true, positionClass: 'toast-top-right', timeOut: 3000 };

        function toggleGroup(btn) {
            var items = btn.nextElementSibling;
            var chevron = btn.querySelector('.chevron');
            var isOpen = items.classList.contains('show');

            // Accordion: diger acik gruplari kapat
            document.querySelectorAll('.nav-group-items.show').forEach(function(el) {
                el.classList.remove('show');
                var prev = el.previousElementSibling;
                if (prev) { var c = prev.querySelector('.chevron'); if (c) c.classList.remove('open'); }
            });

            // Tiklanani toggle et
            if (!isOpen) {
                items.classList.add('show');
                chevron.classList.add('open');
            }
        }

        // ═══ Sube Secici — sessionStorage tabanli (cookie yok) ═══
        // UI secim sessionStorage'da; her API cagrisi proxy/SlnProxyHelper query'sine branchId ekler.
        // Eski SelectedBranch cookie'si varsa temizle (geri uyumluluk).
        document.cookie = 'SelectedBranch=;path=/;max-age=0';

        window.slnGetBranch = function() {
            var v = sessionStorage.getItem('slnBranchId');
            return v ? v : '';
        };
        (function() {
            var roleId = parseInt('@(__jwt.CustomerRoleId > 0 ? __jwt.CustomerRoleId : 101)');
            var jwtBranch = '@(__jwt.BranchId?.ToString() ?? "")';
            // JWT'de BranchId varsa (personel) baglantiyi sessionStorage'a senkronla.
            if (jwtBranch && !sessionStorage.getItem('slnBranchId')) {
                sessionStorage.setItem('slnBranchId', jwtBranch);
            }
            var currentBranch = window.slnGetBranch();
            if (roleId !== 101) return; // Sadece salon sahibi sube degistirebilir

            $.get('/proxy/sln-branches?_nb=1', function(data) {
                var branches = Array.isArray(data) ? data : (data.items || []);
                if (branches.length <= 1) return; // Tek sube varsa gosterme

                var html = '<select class="form-select form-select-sm" style="width:auto; min-width:150px;" onchange="switchBranch(this.value)">';
                html += '<option value=""' + (currentBranch === '' ? ' selected' : '') + '>Tüm Şubeler</option>';
                branches.forEach(function(b) {
                    html += '<option value="' + b.id + '"' + (currentBranch == b.id ? ' selected' : '') + '>' + b.name + '</option>';
                });
                html += '</select>';
                document.getElementById('branchSelector').innerHTML = html;
            });
        })();

        function switchBranch(branchId) {
            if (!branchId) sessionStorage.removeItem('slnBranchId');
            else sessionStorage.setItem('slnBranchId', branchId);
            window.location.reload();
        }

        // ═══ Sube branchId enjektoru ═══
        // jQuery $.ajax HEM ajaxPrefilter HEM de wrapper ile garantilenir
        // (ajaxPrefilter bazi cagrilarda atlanabiliyor — wrapper kesin ceker)
        function _injectBranch(url) {
            if (!url || url.indexOf('/proxy/') < 0) return url;
            if (url.indexOf('_nb=1') >= 0) return url;
            if (/([?&])branchId=/.test(url)) return url;
            var b = window.slnGetBranch();
            if (!b) return url;
            return url + (url.indexOf('?') >= 0 ? '&' : '?') + 'branchId=' + encodeURIComponent(b);
        }
        $.ajaxPrefilter(function(opts) {
            opts.url = _injectBranch(opts.url);
        });
        // Wrap $.ajax (aksi takdirde $.get/$.post path'i bypass edilebiliyor)
        var _origAjax = $.ajax;
        $.ajax = function(urlOrOpts, maybeOpts) {
            var opts = (typeof urlOrOpts === 'string') ? Object.assign({ url: urlOrOpts }, maybeOpts || {}) : (urlOrOpts || {});
            opts.url = _injectBranch(opts.url);
            return _origAjax.call(this, opts);
        };
        // fetch() icin: kullanan sayfalar manuel eklesin (public Discover/Book slug tabanli)
        var _origFetch = window.fetch;
        if (_origFetch) {
            window.fetch = function(input, init) {
                if (typeof input === 'string') input = _injectBranch(input);
                return _origFetch.call(this, input, init);
            };
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
