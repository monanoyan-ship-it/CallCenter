@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.appointments.title", "Randevular");
    var __appointmentsJwt = CallCenter.Shared.Auth.JwtIdentityExtensions.GetJwtIdentity(Context);
    var __appointmentsRoleId = __appointmentsJwt.CustomerRoleId > 0 ? __appointmentsJwt.CustomerRoleId : CallCenter.Shared.Enums.SalonRoles.Ids.SalonOwner;
    var __canNormalizeAppointmentBranches = !__appointmentsJwt.BranchId.HasValue
        && (__appointmentsRoleId == CallCenter.Shared.Enums.SalonRoles.Ids.SalonOwner
            || __appointmentsRoleId == CallCenter.Shared.Enums.SalonRoles.Ids.Manager);
}

<div id="appointments-vm">
    <!-- ═══ Filtre Karti ═══ -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-start">
                <!-- Sol: Tarih Araligi -->
                <div class="col-lg-8">
                    <label class="form-label small fw-semibold mb-1">
                        <i class="bi bi-calendar-range me-1"></i><t key="salon.appointments.date_range">Tarih Aralığı</t>
                    </label>

                    <!-- Preset Butonlari -->
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <!-- ko foreach: presetGroups -->
                        <div class="btn-group btn-group-sm">
                            <!-- ko foreach: items -->
                            <button class="btn" data-bind="text: label, click: $root.addPreset, css: $parent.css"></button>
                            <!-- /ko -->
                        </div>
                        <!-- /ko -->
                    </div>

                    <!-- Manuel Aralik Ekleme -->
                    <div class="d-flex align-items-center gap-1 mb-2">
                        <input type="date" class="form-control form-control-sm" style="width:140px;" data-bind="value: manualFrom" />
                        <span class="text-muted small">-</span>
                        <input type="date" class="form-control form-control-sm" style="width:140px;" data-bind="value: manualTo" />
                        <button class="btn btn-outline-primary btn-sm" data-bind="click: addManualRange" title="@(Translation.T("salon.common.add", "Ekle"))">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                        <!-- ko if: dateRanges().length > 1 -->
                        <button class="btn btn-outline-danger btn-sm" data-bind="click: clearAllRanges" title="@(Translation.T("salon.appointments.clear_all", "Tümünü temizle"))">
                            <i class="bi bi-trash"></i>
                        </button>
                        <!-- /ko -->
                    </div>

                    <!-- Aktif Aralik Chip'leri -->
                    <div class="d-flex flex-wrap gap-1">
                        <!-- ko foreach: dateRanges -->
                        <span class="badge bg-primary d-inline-flex align-items-center gap-1" style="font-size:.8rem;">
                            <i class="bi bi-calendar-range"></i>
                            <span data-bind="text: label"></span>
                            <i class="bi bi-x" style="cursor:pointer;" data-bind="click: $root.removeRange"></i>
                        </span>
                        <!-- /ko -->
                        <!-- ko if: dateRanges().length === 0 -->
                        <span class="text-muted small fst-italic"><t key="salon.appointments.select_date_range">Tarih aralığı seçin</t></span>
                        <!-- /ko -->
                    </div>
                </div>

                <!-- Sag: Personel Filtresi + Yeni Randevu -->
                <div class="col-lg-4">
                    <label class="form-label small fw-semibold mb-1">
                        <i class="bi bi-people me-1"></i><t key="salon.sidebar.staff">Personel</t>
                    </label>
                    <div class="position-relative">
                        <div class="form-control form-control-sm d-flex flex-wrap align-items-center gap-1"
                             style="min-height:31px; height:auto; cursor:text;"
                             data-bind="click: function(d,e){ e.currentTarget.querySelector('input').focus(); }">
                            <!-- ko foreach: staffFilterAutocomplete.selectedItems -->
                            <span class="badge bg-secondary d-inline-flex align-items-center gap-1" style="font-size:.75rem;">
                                <span data-bind="text: $parent.staffFilterAutocomplete.getDisplayText($data)"></span>
                                <i class="bi bi-x" style="cursor:pointer;" data-bind="click: $parent.staffFilterAutocomplete.remove"></i>
                            </span>
                            <!-- /ko -->
                            <input type="text" class="border-0 flex-grow-1 bg-transparent"
                                   style="min-width:80px; outline:none; font-size:.875rem;"
                                   autocomplete="off"
                                   data-bind="textInput: staffFilterAutocomplete.query,
                                              event: { focus: staffFilterAutocomplete.onFocus, blur: staffFilterAutocomplete.onBlur, keydown: staffFilterAutocomplete.onKeydown },
                                              attr: { placeholder: staffFilterAutocomplete.selectedItems().length ? '' : salonT('salon.appointments.all_staff_placeholder', 'Tüm personel...') }" />
                        </div>
                        <div class="dropdown-menu w-100 shadow-sm" style="max-height:220px; overflow-y:auto;"
                             data-bind="css: { show: staffFilterAutocomplete.showDropdown }">
                            <!-- ko foreach: staffFilterAutocomplete.filteredItems -->
                            <a class="dropdown-item small py-1 px-2" href="#"
                               data-bind="text: $parent.staffFilterAutocomplete.getDisplayText($data), click: $parent.staffFilterAutocomplete.select,
                                          css: { active: $parent.staffFilterAutocomplete.highlightIndex() === $index() },
                                          event: { mousedown: function(){ $parent.staffFilterAutocomplete.select($data); } }"></a>
                            <!-- /ko -->
                        </div>
                    </div>
                    <div class="mt-2 text-end d-flex gap-1 justify-content-end">
                        @if (__canNormalizeAppointmentBranches)
                        {
                            <button class="btn btn-outline-secondary btn-sm" data-bind="click: normalizeBranches"
                                    title="@(Translation.T("salon.appointments.normalize_tooltip", "Şube bilgisi olmayan randevuları merkez şubeye bağla"))">
                                <i class="bi bi-shuffle me-1"></i><t key="salon.appointments.normalize_branches">Şube Normalize</t>
                            </button>
                        }
                        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
                            <i class="bi bi-plus-lg me-1"></i><t key="salon.appointments.new_appointment">Yeni Randevu</t>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ Personel Raporu ═══ -->
    <!-- ko if: personnelReport().length > 0 -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 small"><i class="bi bi-bar-chart me-1"></i><t key="salon.appointments.staff_summary">Personel Özeti</t></h6>
            <small class="text-muted" data-bind="text: filteredAppointments().length + ' ' + salonT('salon.appointments.appointment_suffix', 'randevu')"></small>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm table-borderless mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="small"><t key="salon.sidebar.staff">Personel</t></th>
                        <th class="small text-center"><t key="salon.reports.count">Toplam</t></th>
                        <th class="small text-center"><t key="salon.reports.completed">Tamamlanan</t></th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: personnelReport">
                    <tr>
                        <td class="small" data-bind="text: personnelName"></td>
                        <td class="small text-center"><span class="badge bg-primary" data-bind="text: total"></span></td>
                        <td class="small text-center"><span class="badge bg-success" data-bind="text: completed"></span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <!-- /ko -->

    <!-- ═══ Randevu Tablosu ═══ -->
    <!-- ko if: isLoadingAppointments() -->
    <div class="text-center py-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden"><t key="salon.common.loading">Yükleniyor...</t></span>
        </div>
    </div>
    <!-- /ko -->

    <!-- ko ifnot: isLoadingAppointments() -->
    <!-- ko if: filteredAppointments().length > 0 -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h6 class="mb-0 small" data-bind="text: rangesDescription"></h6>
            <small class="text-muted" data-bind="text: filteredAppointments().length + ' ' + salonT('salon.appointments.appointment_suffix', 'randevu')"></small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:90px;"><t key="salon.panel.payments.date">Tarih</t></th>
                            <th style="width:60px;"><t key="salon.reports.hour">Saat</t></th>
                            <th><t key="salon.panel.payments.customer">Müşteri</t></th>
                            <th><t key="salon.appointments.services">Hizmetler</t></th>
                            <th><t key="salon.sidebar.staff">Personel</t></th>
                            <th><t key="salon.common.branch">Şube</t></th>
                            <th><t key="salon.appointments.duration">Süre</t></th>
                            <th><t key="salon.appointments.prepayment">Ön Ödeme</t></th>
                            <th><t key="salon.appointments.status">Durum</t></th>
                            <th style="width:100px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredAppointments">
                        <tr data-bind="css: { 'table-success': statusId === 3, 'table-warning': statusId === 2 || statusId === 6, 'table-danger': statusId === 4, 'table-secondary': statusId === 5 }">
                            <td class="small" data-bind="text: dateFormatted || '-'"></td>
                            <td class="small fw-semibold" data-bind="text: startTimeFormatted || '-'"></td>
                            <td class="small">
                                <a data-bind="text: clientName, attr: { href: '/Clients/Detail/' + slnClientId }" class="text-decoration-none"></a>
                                <!-- ko if: clientIsBlacklisted -->
                                <span class="badge bg-danger ms-1" title="@(Translation.T("salon.appointments.client_blocked_tooltip", "Müşteri engelli"))"><i class="bi bi-slash-circle me-1"></i><t key="salon.appointments.client_blocked">Engelli</t></span>
                                <!-- /ko -->
                                <!-- ko if: !clientIsBlacklisted && clientNoShowCount >= 2 -->
                                <span class="badge bg-warning text-dark ms-1" data-bind="attr: { title: salonT('salon.appointments.client_noshow_tooltip', 'Bu müşterinin gelmedigi randevu sayısı') }"><i class="bi bi-exclamation-triangle me-1"></i><span data-bind="text: clientNoShowCount"></span> <t key="salon.appointments.noshow_short">no-show</t></span>
                                <!-- /ko -->
                            </td>
                            <td class="small">
                                <div data-bind="text: serviceNamesText"></div>
                                <!-- ko if: notes -->
                                <div class="text-muted mt-1">
                                    <i class="bi bi-card-text me-1"></i><span data-bind="text: notes"></span>
                                </div>
                                <!-- /ko -->
                            </td>
                            <td class="small" data-bind="text: personnelName"></td>
                            <td class="small">
                                <!-- ko if: branchName -->
                                <span class="badge bg-light text-dark border" data-bind="text: branchName"></span>
                                <!-- /ko -->
                                <!-- ko ifnot: branchName -->
                                <span class="text-muted">-</span>
                                <!-- /ko -->
                            </td>
                            <td class="small" data-bind="text: durationMinutes ? durationMinutes + ' ' + salonT('salon.common.minute_abbr', 'dk') : '-'"></td>
                            <td class="small">
                                <!-- ko if: isPrepaid && prepaidAmount > 0 -->
                                <span class="badge bg-success" data-bind="text: salonT('salon.appointments.paid_prefix', 'Ödenmiş') + ': ' + prepaidAmount.toLocaleString(document.documentElement.lang || undefined) + ' TL'" title="@(Translation.T("salon.appointments.online_prepayment_received", "Online ön ödeme alındı"))"></span>
                                <!-- /ko -->
                                <!-- ko if: statusId === 6 && depositAmount > 0 -->
                                <span class="badge bg-warning text-dark" data-bind="text: salonT('salon.appointments.status.payment_pending', 'Ödeme bekliyor') + ': ' + depositAmount.toLocaleString(document.documentElement.lang || undefined) + ' TL'"></span>
                                <!-- /ko -->
                                <!-- ko if: statusId !== 6 && !isPrepaid && depositAmount > 0 -->
                                <span class="badge bg-info text-dark" data-bind="text: salonT('salon.appointments.deposit_prefix', 'Depozito') + ': ' + depositAmount.toLocaleString(document.documentElement.lang || undefined) + ' TL'"></span>
                                <!-- /ko -->
                                <!-- ko if: statusId !== 6 && !isPrepaid && (!depositAmount || depositAmount === 0) -->
                                <span class="text-muted">-</span>
                                <!-- /ko -->
                            </td>
                            <td>
                                <span class="badge" data-bind="text: statusText, css: statusCss"></span>
                                <!-- ko if: statusId === 1 && !isPrepaid && (!depositAmount || depositAmount === 0) -->
                                <span class="badge bg-warning text-dark ms-1" title="@(Translation.T("salon.appointments.pending_approval_tooltip", "Online randevu — ödeme alınmadı, sizin onayınız ya da saat değişikliğiniz bekleniyor"))"><i class="bi bi-hourglass-split me-1"></i><t key="salon.appointments.pending_approval">Onay Bekliyor</t></span>
                                <!-- /ko -->
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <!-- Planlanmis (1): once Onayla -->
                                    <button class="btn btn-outline-info" title="@(Translation.T("salon.appointments.confirm", "Onayla"))" data-bind="click: $parent.confirm, visible: statusId === 1">
                                        <i class="bi bi-check"></i>
                                    </button>
                                    <!-- Onaylandi (2): Tamamla -->
                                    <button class="btn btn-outline-success" title="@(Translation.T("salon.appointments.complete", "Tamamla"))" data-bind="click: $parent.complete, visible: statusId === 2">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary" title="@(Translation.T("salon.common.btn.edit_tooltip", "Düzenle"))" data-bind="click: $parent.openEdit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" title="@(Translation.T("salon.common.btn.cancel", "İptal"))" data-bind="click: $parent.cancel, visible: statusId !== 3 && statusId !== 4 && statusId !== 5">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                    <button class="btn btn-outline-dark" title="@(Translation.T("salon.appointments.no_show", "Gelmedi"))" data-bind="click: $parent.markNoShow, visible: statusId === 1 || statusId === 2">
                                        <i class="bi bi-person-x"></i>
                                    </button>
                                    <a class="btn btn-outline-info" title="@(Translation.T("salon.appointments.create_invoice", "Adisyon Oluştur"))" data-bind="visible: statusId === 3,
                                        attr: { href: '/Invoices?fromAppt=1&clientId=' + slnClientId + '&clientName=' + encodeURIComponent(clientName || '') + '&serviceIds=' + (serviceIds || []).join(',') + '&personnelId=' + (personnelId || '') }">
                                        <i class="bi bi-receipt"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <!-- /ko -->

    <!-- ko if: filteredAppointments().length === 0 && dateRanges().length > 0 -->
    <div class="card border-0 shadow-sm appointment-empty-state">
        <div class="card-body">
            <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3">
                <div class="d-flex gap-3">
                    <span class="appointment-empty-icon"><i class="bi bi-calendar-x"></i></span>
                    <div>
                        <h6 class="mb-1"><t key="salon.appointments.empty_title">Seçili aralıkta randevu yok</t></h6>
                        <p class="text-muted small mb-2"><t key="salon.appointments.empty_desc">Takvimi boş bırakmamak için yeni randevu ekleyebilir veya bekleme listesindeki müşterileri uygun saate taşıyabilirsiniz.</t></p>
                        <!-- ko if: activeWaitlistCount() > 0 -->
                        <span class="badge bg-warning-subtle text-warning-emphasis border">
                            <i class="bi bi-clock-history me-1"></i>
                            <span data-bind="text: activeWaitlistCount"></span>
                            <t key="salon.appointments.empty_waitlist_badge">aktif bekleme kaydı</t>
                        </span>
                        <!-- /ko -->
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-primary btn-sm" data-bind="click: openNew">
                        <i class="bi bi-plus-lg me-1"></i><t key="salon.appointments.new_appointment">Yeni Randevu</t>
                    </button>
                    <a class="btn btn-outline-primary btn-sm" href="/Waitlist">
                        <i class="bi bi-clock-history me-1"></i><t key="salon.sidebar.waitlist">Bekleme Listesi</t>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <!-- /ko -->

    <!-- ko if: dateRanges().length === 0 -->
    <div class="card border-0 shadow-sm appointment-empty-state">
        <div class="card-body">
            <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3">
                <div class="d-flex gap-3">
                    <span class="appointment-empty-icon"><i class="bi bi-calendar-plus"></i></span>
                    <div>
                        <h6 class="mb-1"><t key="salon.appointments.no_range_title">Takvim aralığı seçilmedi</t></h6>
                        <p class="text-muted small mb-0"><t key="salon.appointments.no_range_desc">Bugünü açarak hızlıca başlayabilir veya üstteki kısa tarih aralıklarından birini seçebilirsiniz.</t></p>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-primary btn-sm" data-bind="click: addTodayRange">
                        <i class="bi bi-calendar-day me-1"></i><t key="salon.appointments.show_today">Bugünü Göster</t>
                    </button>
                    <a class="btn btn-outline-primary btn-sm" href="/Waitlist">
                        <i class="bi bi-clock-history me-1"></i><t key="salon.sidebar.waitlist">Bekleme Listesi</t>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <!-- /ko -->
    <!-- /ko -->

    <!-- ═══ Randevu Modal ═══ -->
    <div class="modal fade" id="appointmentModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditing() ? salonT('salon.appointments.edit_appointment', 'Randevu Düzenle') : salonT('salon.appointments.new_appointment', 'Yeni Randevu')"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.appointments.customer_required">Müşteri *</t></label>
                            <div class="position-relative">
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="@(Translation.T("salon.appointments.customer_placeholder", "Müşteri adı yazın..."))"
                                       autocomplete="off"
                                       data-bind="textInput: clientAutocomplete.query,
                                                  event: { focus: clientAutocomplete.onFocus, blur: clientAutocomplete.onBlur, keydown: clientAutocomplete.onKeydown }" />
                                <!-- ko if: clientAutocomplete.selectedName() -->
                                <span class="position-absolute top-50 end-0 translate-middle-y me-2" style="cursor:pointer; z-index:2;"
                                      data-bind="click: clientAutocomplete.clear" title="@(Translation.T("salon.memberships.clear", "Temizle"))">
                                    <i class="bi bi-x-circle text-muted"></i>
                                </span>
                                <!-- /ko -->
                                <div class="dropdown-menu w-100 shadow-sm" style="max-height:220px; overflow-y:auto;"
                                     data-bind="css: { show: clientAutocomplete.showDropdown }">
                                    <!-- ko foreach: clientAutocomplete.filteredItems -->
                                    <a class="dropdown-item small py-1 px-2" href="#"
                                       data-bind="text: $parent.clientAutocomplete.getDisplayText($data), click: $parent.clientAutocomplete.select,
                                                  css: { active: $parent.clientAutocomplete.highlightIndex() === $index() },
                                                  event: { mousedown: function(){ $parent.clientAutocomplete.select($data); } }"></a>
                                    <!-- /ko -->
                                    <!-- ko if: clientAutocomplete.filteredItems().length === 0 && clientAutocomplete.query().length > 0 -->
                                    <a class="dropdown-item small py-1 px-2 text-primary fw-semibold" href="#"
                                       data-bind="event: { mousedown: function() { showNewClient(clientAutocomplete.query()); } }">
                                        <i class="bi bi-person-plus me-1"></i><t key="salon.appointments.create_new_customer">Yeni müşteri oluştur</t>
                                    </a>
                                    <!-- /ko -->
                                </div>
                            </div>
                            <!-- Yeni Musteri Inline Form -->
                            <div class="border rounded p-2 mt-1 bg-light" data-bind="visible: newClientVisible" style="display:none;">
                                <div class="row g-1">
                                    <div class="col-5">
                                        <input type="text" class="form-control form-control-sm" placeholder="@(Translation.T("salon.appointments.full_name_required", "Ad Soyad *"))" data-bind="textInput: newClientForm.fullName" />
                                    </div>
                                    <div class="col-4">
                                        <div data-bind="phoneInput: newClientForm.phone"></div>
                                    </div>
                                    <div class="col-3 d-flex gap-1">
                                        <button class="btn btn-primary btn-sm py-0 flex-fill" data-bind="click: saveNewClient, disable: isCreatingClient">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm py-0" data-bind="click: hideNewClient">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Tarih/Saat asagida personel secildikten sonra slot olarak gosterilir -->
<div class="col-12">
                            <label class="form-label small"><t key="salon.appointments.category">Kategori</t> <small class="text-muted fw-normal"><t key="salon.appointments.click_to_select">(tıkla seç)</t></small></label>
                            <div class="d-flex flex-wrap gap-1 mb-2" data-bind="foreach: serviceList">
                                <button type="button" class="btn py-1 px-3" style="font-size:.85rem; min-height:36px;"
                                    data-bind="text: name,
                                               click: function() { $root.selectedCategoryId($data.id); },
                                               css: $root.selectedCategoryId() === $data.id ? 'btn-dark' : 'btn-outline-secondary'">
                                </button>
                            </div>
                        </div>
                        <!-- ko if: selectedCategoryServices().length > 0 -->
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.appointments.services_required">Hizmetler *</t> <small class="text-muted fw-normal"><t key="salon.appointments.click_to_select">(tıkla seç)</t></small></label>
                            <div class="d-flex flex-wrap gap-1" data-bind="foreach: selectedCategoryServices">
                                <button type="button" class="btn py-1 px-2" style="font-size:.85rem; min-height:36px;"
                                    data-bind="click: function() { $root.toggleService($data.id); },
                                               css: $root.form.serviceIds().indexOf($data.id) >= 0 ? 'btn-primary' : 'btn-outline-secondary'">
                                    <span data-bind="text: name"></span>
                                    <small class="ms-1 opacity-75" data-bind="text: durationMinutes + salonT('salon.common.minute_abbr', 'dk')"></small>
                                </button>
                            </div>
                        </div>
                        <!-- /ko -->
                        <!-- Secilen hizmetler -->
                        <!-- ko if: selectedServiceNames().length > 0 -->
                        <div class="col-12">
                            <div class="d-flex flex-wrap gap-1">
                                <!-- ko foreach: selectedServiceNames -->
                                <span class="badge bg-primary d-inline-flex align-items-center gap-1 py-1 px-2" style="font-size:.8rem;">
                                    <span data-bind="text: name"></span>
                                    <i class="bi bi-x" style="cursor:pointer;" data-bind="click: $root.removeSelectedService"></i>
                                </span>
                                <!-- /ko -->
                            </div>
                        </div>
                        <!-- /ko -->
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.appointments.staff_required">Personel *</t> <small class="text-muted fw-normal"><t key="salon.appointments.click_to_select">(tıkla seç)</t></small></label>
                            <!-- ko if: availableStaffForService().length > 0 -->
                            <div class="d-flex flex-wrap gap-1" data-bind="foreach: availableStaffForService">
                                <button type="button" class="btn py-1 px-3" style="font-size:.85rem; min-height:36px;"
                                    data-bind="text: name,
                                               click: function() { $root.form.personnelId($data.id); },
                                               css: $root.form.personnelId() === $data.id ? 'btn-success' : 'btn-outline-secondary'">
                                </button>
                            </div>
                            <!-- /ko -->
                            <!-- ko if: availableStaffForService().length === 0 -->
                            <div class="d-flex flex-wrap gap-1" data-bind="foreach: staffList">
                                <button type="button" class="btn py-1 px-3" style="font-size:.85rem; min-height:36px;"
                                    data-bind="text: fullName,
                                               click: function() { $root.form.personnelId($data.id); },
                                               css: $root.form.personnelId() === $data.id ? 'btn-success' : 'btn-outline-secondary'">
                                </button>
                            </div>
                            <!-- /ko -->
                        </div>
                        <!-- Tarih + Musait Saatler -->
                        <div class="col-4">
                            <label class="form-label small"><t key="salon.appointments.date_required">Tarih *</t></label>
                            <input type="date" class="form-control form-control-sm" data-bind="value: slotDate" />
                        </div>
                        <div class="col-8">
                            <label class="form-label small"><t key="salon.appointments.time_required">Saat *</t> <small class="text-muted fw-normal"><t key="salon.appointments.click_available_slots">(müsait saatleri tıkla)</t></small></label>
                            <!-- ko if: slotsLoading() -->
                            <div class="text-muted small"><span class="spinner-border spinner-border-sm me-1"></span><t key="salon.common.loading">Yükleniyor...</t></div>
                            <!-- /ko -->
                            <!-- ko if: !slotsLoading() && availableSlots().length > 0 -->
                            <div class="d-flex flex-wrap gap-1">
                                <!-- ko foreach: availableSlots -->
                                <button type="button" class="btn py-0 px-2" style="font-size:.8rem;"
                                    data-bind="text: timeText,
                                               click: $root.selectSlot,
                                               css: !available ? 'btn-outline-danger disabled' : ($root.form.startTime().indexOf(timeText) >= 0 ? 'btn-primary' : 'btn-outline-success'),
                                               attr: { disabled: !available }">
                                </button>
                                <!-- /ko -->
                            </div>
                            <!-- /ko -->
                            <!-- ko if: !slotsLoading() && availableSlots().length === 0 && form.personnelId() && slotDate() -->
                            <div class="text-muted small"><t key="salon.appointments.no_available_slots">Müsait saat bulunamadı</t></div>
                            <!-- /ko -->
                            <!-- ko if: !form.personnelId() || !slotDate() -->
                            <div class="text-muted small"><t key="salon.appointments.select_staff_and_date_first">Önce personel ve tarih seçiniz</t></div>
                            <!-- /ko -->
                        </div>
                        <input type="hidden" data-bind="value: form.startTime" />
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.appointments.notes">Not</t></label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="textInput: form.notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i><t key="salon.common.btn.save">Kaydet</t>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .appointment-empty-state { border: 1px solid rgba(15, 23, 42, .08) !important; }
    .appointment-empty-icon {
        width: 2.75rem;
        height: 2.75rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: .5rem;
        background: rgba(13, 110, 253, .1);
        color: #0d6efd;
        flex: 0 0 auto;
        font-size: 1.25rem;
    }
</style>

@section Scripts {
    <script src="~/js/Appointments.js" asp-append-version="true"></script>
}
