@{
    ViewData["Title"] = "Randevular";
}

<div id="appointments-vm">
    <!-- ═══ Filtre Karti ═══ -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-start">
                <!-- Sol: Tarih Araligi -->
                <div class="col-lg-8">
                    <label class="form-label small fw-semibold mb-1">
                        <i class="bi bi-calendar-range me-1"></i>Tarih Araligi
                    </label>

                    <!-- Preset Butonlari -->
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <!-- ko foreach: presetGroups -->
                        <div class="btn-group btn-group-sm">
                            <!-- ko foreach: items -->
                            <button class="btn" data-bind="text: label, click: $root.addPreset, css: $parent.css"></button>
                            <!-- /ko -->
                        </div>
                        <!-- /ko -->
                    </div>

                    <!-- Manuel Aralik Ekleme -->
                    <div class="d-flex align-items-center gap-1 mb-2">
                        <input type="date" class="form-control form-control-sm" style="width:140px;" data-bind="value: manualFrom" />
                        <span class="text-muted small">-</span>
                        <input type="date" class="form-control form-control-sm" style="width:140px;" data-bind="value: manualTo" />
                        <button class="btn btn-outline-primary btn-sm" data-bind="click: addManualRange" title="Ekle">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                        <!-- ko if: dateRanges().length > 1 -->
                        <button class="btn btn-outline-danger btn-sm" data-bind="click: clearAllRanges" title="Tumu temizle">
                            <i class="bi bi-trash"></i>
                        </button>
                        <!-- /ko -->
                    </div>

                    <!-- Aktif Aralik Chip'leri -->
                    <div class="d-flex flex-wrap gap-1">
                        <!-- ko foreach: dateRanges -->
                        <span class="badge bg-primary d-inline-flex align-items-center gap-1" style="font-size:.8rem;">
                            <i class="bi bi-calendar-range"></i>
                            <span data-bind="text: label"></span>
                            <i class="bi bi-x" style="cursor:pointer;" data-bind="click: $root.removeRange"></i>
                        </span>
                        <!-- /ko -->
                        <!-- ko if: dateRanges().length === 0 -->
                        <span class="text-muted small fst-italic">Tarih araligi secin</span>
                        <!-- /ko -->
                    </div>
                </div>

                <!-- Sag: Personel Filtresi + Yeni Randevu -->
                <div class="col-lg-4">
                    <label class="form-label small fw-semibold mb-1">
                        <i class="bi bi-people me-1"></i>Personel
                    </label>
                    <div class="position-relative" data-bind="with: staffFilterAutocomplete">
                        <div class="form-control form-control-sm d-flex flex-wrap align-items-center gap-1"
                             style="min-height:31px; height:auto; cursor:text;"
                             data-bind="click: function(d,e){ e.currentTarget.querySelector('input').focus(); }">
                            <!-- ko foreach: selectedItems -->
                            <span class="badge bg-secondary d-inline-flex align-items-center gap-1" style="font-size:.75rem;">
                                <span data-bind="text: $parent.getDisplayText($data)"></span>
                                <i class="bi bi-x" style="cursor:pointer;" data-bind="click: $parent.remove"></i>
                            </span>
                            <!-- /ko -->
                            <input type="text" class="border-0 flex-grow-1 bg-transparent"
                                   style="min-width:80px; outline:none; font-size:.875rem;"
                                   autocomplete="off"
                                   data-bind="value: query, valueUpdate: 'afterkeydown',
                                              event: { focus: onFocus, blur: onBlur, keydown: onKeydown },
                                              attr: { placeholder: selectedItems().length ? '' : 'Tum personel...' }" />
                        </div>
                        <div class="dropdown-menu w-100 shadow-sm" style="max-height:220px; overflow-y:auto;"
                             data-bind="css: { show: showDropdown }">
                            <!-- ko foreach: filteredItems -->
                            <a class="dropdown-item small py-1 px-2" href="#"
                               data-bind="text: $parent.getDisplayText($data), click: $parent.select,
                                          css: { active: $parent.highlightIndex() === $index() },
                                          event: { mousedown: function(){ $parent.select($data); } }"></a>
                            <!-- /ko -->
                        </div>
                    </div>
                    <div class="mt-2 text-end">
                        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
                            <i class="bi bi-plus-lg me-1"></i>Yeni Randevu
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ Personel Raporu ═══ -->
    <!-- ko if: personnelReport().length > 0 -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 small"><i class="bi bi-bar-chart me-1"></i>Personel Ozeti</h6>
            <small class="text-muted" data-bind="text: filteredAppointments().length + ' randevu'"></small>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm table-borderless mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="small">Personel</th>
                        <th class="small text-center">Toplam</th>
                        <th class="small text-center">Tamamlanan</th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: personnelReport">
                    <tr>
                        <td class="small" data-bind="text: personnelName"></td>
                        <td class="small text-center"><span class="badge bg-primary" data-bind="text: total"></span></td>
                        <td class="small text-center"><span class="badge bg-success" data-bind="text: completed"></span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <!-- /ko -->

    <!-- ═══ Randevu Tablosu ═══ -->
    <!-- ko if: isLoadingAppointments() -->
    <div class="text-center py-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Yukleniyor...</span>
        </div>
    </div>
    <!-- /ko -->

    <!-- ko ifnot: isLoadingAppointments() -->
    <!-- ko if: filteredAppointments().length > 0 -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h6 class="mb-0 small" data-bind="text: rangesDescription"></h6>
            <small class="text-muted" data-bind="text: filteredAppointments().length + ' randevu'"></small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:90px;">Tarih</th>
                            <th style="width:60px;">Saat</th>
                            <th>Musteri</th>
                            <th>Hizmetler</th>
                            <th>Personel</th>
                            <th>Sure</th>
                            <th>Durum</th>
                            <th style="width:100px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredAppointments">
                        <tr data-bind="css: { 'table-success': statusId === 3, 'table-warning': statusId === 2, 'table-danger': statusId === 4 }">
                            <td class="small" data-bind="text: dateFormatted || '-'"></td>
                            <td class="small fw-semibold" data-bind="text: startTimeFormatted || '-'"></td>
                            <td class="small">
                                <a data-bind="text: clientName, attr: { href: '/Clients/Detail/' + slnClientId }" class="text-decoration-none"></a>
                            </td>
                            <td class="small" data-bind="text: serviceNamesText"></td>
                            <td class="small" data-bind="text: personnelName"></td>
                            <td class="small" data-bind="text: durationMinutes ? durationMinutes + ' dk' : '-'"></td>
                            <td><span class="badge" data-bind="text: statusText, css: statusCss"></span></td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-success" title="Tamamla" data-bind="click: $parent.complete, visible: statusId !== 3 && statusId !== 4">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary" title="Duzenle" data-bind="click: $parent.openEdit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" title="Iptal" data-bind="click: $parent.cancel, visible: statusId !== 3 && statusId !== 4">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                    <a class="btn btn-outline-info" title="Adisyon Olustur" data-bind="visible: statusId === 3,
                                        attr: { href: '/Invoices?fromAppt=1&clientId=' + slnClientId + '&clientName=' + encodeURIComponent(clientName || '') + '&serviceIds=' + (serviceIds || []).join(',') + '&personnelId=' + (personnelId || '') }">
                                        <i class="bi bi-receipt"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <!-- /ko -->

    <!-- ko if: filteredAppointments().length === 0 && dateRanges().length > 0 -->
    <div class="text-center text-muted py-4">
        <i class="bi bi-calendar-x" style="font-size: 2rem;"></i>
        <p class="mt-2 small">Secilen tarih araliginda randevu bulunamadi</p>
    </div>
    <!-- /ko -->

    <!-- ko if: dateRanges().length === 0 -->
    <div class="text-center text-muted py-4">
        <i class="bi bi-calendar-plus" style="font-size: 2rem;"></i>
        <p class="mt-2 small">Randevulari gormek icin tarih araligi secin</p>
    </div>
    <!-- /ko -->
    <!-- /ko -->

    <!-- ═══ Randevu Modal ═══ -->
    <div class="modal fade" id="appointmentModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditing() ? 'Randevu Duzenle' : 'Yeni Randevu'"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small">Musteri *</label>
                            <div class="position-relative" data-bind="with: clientAutocomplete">
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="Musteri adi yazin..."
                                       autocomplete="off"
                                       data-bind="value: query, valueUpdate: 'afterkeydown',
                                                  event: { focus: onFocus, blur: onBlur, keydown: onKeydown }" />
                                <!-- ko if: selectedName() -->
                                <span class="position-absolute top-50 end-0 translate-middle-y me-2" style="cursor:pointer; z-index:2;"
                                      data-bind="click: clear" title="Temizle">
                                    <i class="bi bi-x-circle text-muted"></i>
                                </span>
                                <!-- /ko -->
                                <div class="dropdown-menu w-100 shadow-sm" style="max-height:220px; overflow-y:auto;"
                                     data-bind="css: { show: showDropdown }">
                                    <!-- ko foreach: filteredItems -->
                                    <a class="dropdown-item small py-1 px-2" href="#"
                                       data-bind="text: $parent.getDisplayText($data), click: $parent.select,
                                                  css: { active: $parent.highlightIndex() === $index() },
                                                  event: { mousedown: function(){ $parent.select($data); } }"></a>
                                    <!-- /ko -->
                                    <!-- ko if: filteredItems().length === 0 && query().length > 0 -->
                                    <a class="dropdown-item small py-1 px-2 text-primary fw-semibold" href="#"
                                       data-bind="event: { mousedown: function() { $root.showNewClient(query()); } }">
                                        <i class="bi bi-person-plus me-1"></i>Yeni musteri olustur
                                    </a>
                                    <!-- /ko -->
                                </div>
                            </div>
                            <!-- Yeni Musteri Inline Form -->
                            <div class="border rounded p-2 mt-1 bg-light" data-bind="visible: newClientVisible" style="display:none;">
                                <div class="row g-1">
                                    <div class="col-5">
                                        <input type="text" class="form-control form-control-sm" placeholder="Ad Soyad *" data-bind="value: newClientForm.fullName" />
                                    </div>
                                    <div class="col-4">
                                        <div data-bind="phoneInput: newClientForm.phone"></div>
                                    </div>
                                    <div class="col-3 d-flex gap-1">
                                        <button class="btn btn-primary btn-sm py-0 flex-fill" data-bind="click: saveNewClient, disable: isCreatingClient">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm py-0" data-bind="click: hideNewClient">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Tarih ve Saat *</label>
                            <input type="datetime-local" class="form-control form-control-sm" data-bind="value: form.startTime" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Kategori <small class="text-muted fw-normal">(tikla sec)</small></label>
                            <div class="d-flex flex-wrap gap-1 mb-2" data-bind="foreach: serviceList">
                                <button type="button" class="btn py-1 px-3" style="font-size:.85rem; min-height:36px;"
                                    data-bind="text: name,
                                               click: function() { $root.selectedCategoryId($data.id); },
                                               css: $root.selectedCategoryId() === $data.id ? 'btn-dark' : 'btn-outline-secondary'">
                                </button>
                            </div>
                        </div>
                        <!-- ko if: selectedCategoryServices().length > 0 -->
                        <div class="col-12">
                            <label class="form-label small">Hizmetler * <small class="text-muted fw-normal">(tikla sec)</small></label>
                            <div class="d-flex flex-wrap gap-1" data-bind="foreach: selectedCategoryServices">
                                <button type="button" class="btn py-1 px-2" style="font-size:.85rem; min-height:36px;"
                                    data-bind="click: function() { $root.toggleService($data.id); },
                                               css: $root.form.serviceIds().indexOf($data.id) >= 0 ? 'btn-primary' : 'btn-outline-secondary'">
                                    <span data-bind="text: name"></span>
                                    <small class="ms-1 opacity-75" data-bind="text: durationMinutes + 'dk'"></small>
                                </button>
                            </div>
                        </div>
                        <!-- /ko -->
                        <!-- Secilen hizmetler -->
                        <!-- ko if: selectedServiceNames().length > 0 -->
                        <div class="col-12">
                            <div class="d-flex flex-wrap gap-1">
                                <!-- ko foreach: selectedServiceNames -->
                                <span class="badge bg-primary d-inline-flex align-items-center gap-1 py-1 px-2" style="font-size:.8rem;">
                                    <span data-bind="text: name"></span>
                                    <i class="bi bi-x" style="cursor:pointer;" data-bind="click: $root.removeSelectedService"></i>
                                </span>
                                <!-- /ko -->
                            </div>
                        </div>
                        <!-- /ko -->
                        <div class="col-12">
                            <label class="form-label small">Personel * <small class="text-muted fw-normal">(tikla sec)</small></label>
                            <div class="d-flex flex-wrap gap-1" data-bind="foreach: staffList">
                                <button type="button" class="btn py-1 px-3" style="font-size:.85rem; min-height:36px;"
                                    data-bind="text: fullName,
                                               click: function() { $root.form.personnelId($data.id); },
                                               css: $root.form.personnelId() === $data.id ? 'btn-success' : 'btn-outline-secondary'">
                                </button>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Not</label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: form.notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Appointments.js" asp-append-version="true"></script>
}
