@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.profile.auto.salon_profili", "Salon Profili");
}

<div id="profile-vm">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold"><i class="bi bi-shop me-2"></i><t key="salon.profile.auto.firma_bilgileri">Firma Bilgileri</t></div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.profile.description">Açıklama</t></label>
                            <textarea class="form-control form-control-sm" rows="3" data-bind="value: form.description" placeholder="@Translation.T("salon.profile.description_placeholder", "Salonunuz hakkında kısa bilgi...")"></textarea>
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.profile.website">Web Sitesi</t></label>
                            <input type="url" class="form-control form-control-sm" data-bind="value: form.website" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.common.status">Durum</t></label>
                            <select class="form-select form-select-sm" data-bind="value: form.isPublished">
                                <option value="true"><t key="salon.status.published">Yayında</t></option>
                                <option value="false"><t key="salon.status.draft">Taslak</t></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mt-3">
                <div class="card-header bg-white fw-semibold"><i class="bi bi-globe me-2"></i><t key="salon.profile.social_media">Sosyal Medya</t></div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small"><i class="bi bi-instagram me-1"></i>Instagram</label>
                            <input type="text" class="form-control form-control-sm" placeholder="@@salonadi" data-bind="value: form.instagramHandle" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><i class="bi bi-facebook me-1"></i>Facebook</label>
                            <input type="url" class="form-control form-control-sm" data-bind="value: form.facebookUrl" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold"><i class="bi bi-receipt me-2"></i><t key="salon.profile.billing">Faturalama</t></div>
                <div class="card-body">
                    <label class="form-label small"><t key="salon.profile.billing_preference">Faturalama Tercihi</t></label>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="billingType" id="bt1" value="1" data-bind="checked: form.billingType" />
                        <label class="form-check-label small" for="bt1">
                            <strong><t key="salon.profile.auto.tek_fatura">Tek Fatura</t></strong><br />
                            <span class="text-muted"><t key="salon.profile.auto.tum_subeler_icin_merkez_sube_fatura_bilgileri_kullanilir">Tüm şubeler için merkez şube fatura bilgileri kullanılır</t></span>
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="billingType" id="bt2" value="2" data-bind="checked: form.billingType" />
                        <label class="form-check-label small" for="bt2">
                            <strong><t key="salon.profile.auto.sube_bazli">Şube Bazlı</t></strong><br />
                            <span class="text-muted"><t key="salon.profile.auto.her_sube_kendi_fatura_bilgilerini_kullanir">Her şube kendi fatura bilgilerini kullanır</t></span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mt-3">
                <div class="card-body text-center text-muted small">
                    <i class="bi bi-info-circle me-1"></i><t key="salon.profile.branch_managed_info">Adres, telefon, çalışma saatleri ve fatura bilgileri</t>
                    <a href="/Branches"><strong><t key="salon.branches.title">Şubeler</t></strong></a> <t key="salon.profile.branch_managed_suffix">sayfasından yönetilir.</t>
                </div>
            </div>

            <button class="btn btn-primary w-100 mt-3" data-bind="click: save, disable: isSaving">
                <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i><t key="salon.profile.auto.profili_kaydet">Profili Kaydet</t>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Profile.js" asp-append-version="true"></script>
}
