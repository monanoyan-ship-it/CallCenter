@{
    ViewData["Title"] = "Salon Profili";
}

<div id="profile-vm">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold"><i class="bi bi-shop me-2"></i>Salon Bilgileri</div>
                <div class="card-body">
                    <div class="alert alert-warning py-2 small mb-3">
                        <i class="bi bi-exclamation-triangle me-1"></i><strong>Önemli:</strong> Bu bilgiler aynı zamanda fatura bilgileriniz olarak kullanılmaktadır. Lütfen firma adı, adres ve vergi bilgilerinizi eksiksiz ve doğru doldurunuz.
                    </div>
                    <div class="row g-3">
                        <div class="col-8">
                            <label class="form-label small">Profil Adresi (slug) *</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">corplynk.com/salon/</span>
                                <input type="text" class="form-control" data-bind="value: form.slug" placeholder="salon-adiniz" />
                            </div>
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Durum</label>
                            <select class="form-select form-select-sm" data-bind="value: form.isPublished">
                                <option value="true">Yayinda</option>
                                <option value="false">Taslak</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Aciklama</label>
                            <textarea class="form-control form-control-sm" rows="3" data-bind="value: form.description" placeholder="Salonunuz hakkinda kisa bilgi..."></textarea>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Telefon</label>
                            <div data-bind="phoneInput: form.phone"></div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">E-posta</label>
                            <input type="email" class="form-control form-control-sm" data-bind="value: form.email" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Sehir</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.city" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Ilce</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.district" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Web Sitesi</label>
                            <input type="url" class="form-control form-control-sm" data-bind="value: form.website" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Adres</label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: form.address"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mt-3">
                <div class="card-header bg-white fw-semibold"><i class="bi bi-globe me-2"></i>Sosyal Medya</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small"><i class="bi bi-instagram me-1"></i>Instagram</label>
                            <input type="text" class="form-control form-control-sm" placeholder="@@salonadi" data-bind="value: form.instagramHandle" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><i class="bi bi-facebook me-1"></i>Facebook</label>
                            <input type="url" class="form-control form-control-sm" data-bind="value: form.facebookUrl" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><i class="bi bi-geo-alt me-1"></i>Google Maps Linki</label>
                            <input type="url" class="form-control form-control-sm" data-bind="value: form.googleMapsUrl" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold"><i class="bi bi-clock me-2"></i>Calisma Saatleri</div>
                <div class="card-body">
                    <!-- ko foreach: workingDays -->
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="small" style="min-width:60px;" data-bind="text: label"></span>
                        <input type="time" class="form-control form-control-sm" style="max-width:100px;" data-bind="value: open" />
                        <span class="small">-</span>
                        <input type="time" class="form-control form-control-sm" style="max-width:100px;" data-bind="value: close" />
                    </div>
                    <!-- /ko -->
                </div>
            </div>

            <button class="btn btn-primary w-100 mt-3" data-bind="click: save, disable: isSaving">
                <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Profili Kaydet
            </button>

            <!-- ko if: form.slug() && form.isPublished() === 'true' -->
            <a class="btn btn-outline-success w-100 mt-2" data-bind="attr: { href: 'https://corplynk.com/salon/' + form.slug() }" target="_blank">
                <i class="bi bi-box-arrow-up-right me-1"></i>Profili Goruntule
            </a>
            <!-- /ko -->
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Profile.js" asp-append-version="true"></script>
}
