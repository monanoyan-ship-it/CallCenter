@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.reports.title", "Raporlar");
}

<div id="reports-vm">
    <!-- Tarih Araligi -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="row align-items-center g-2">
                <div class="col-auto">
                    <label class="form-label small mb-0"><t key="salon.reports.date_from">Başlangıç:</t></label>
                </div>
                <div class="col-auto">
                    <input type="date" class="form-control form-control-sm" data-bind="value: dateFrom" />
                </div>
                <div class="col-auto">
                    <label class="form-label small mb-0"><t key="salon.reports.date_to">Bitiş:</t></label>
                </div>
                <div class="col-auto">
                    <input type="date" class="form-control form-control-sm" data-bind="value: dateTo" />
                </div>
                <div class="col-auto">
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary" data-bind="click: setToday"><t key="salon.reports.today">Bugün</t></button>
                        <button class="btn btn-outline-secondary" data-bind="click: setWeek"><t key="salon.reports.this_week">Bu Hafta</t></button>
                        <button class="btn btn-outline-secondary" data-bind="click: setMonth"><t key="salon.reports.this_month">Bu Ay</t></button>
                    </div>
                </div>
                <div class="col-auto">
                    <button class="btn btn-sm btn-primary" data-bind="click: refreshReports">
                        <i class="bi bi-arrow-clockwise me-1"></i><t key="salon.reports.auto.yenile">Yenile</t>
                    </button>
                </div>
                <div class="col-auto ms-auto">
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-success" data-bind="click: exportCsv, enable: !isLoading()">
                            <i class="bi bi-filetype-csv me-1"></i>CSV
                        </button>
                        <button type="button" class="btn btn-outline-primary" data-bind="click: exportExcel, enable: !isLoading()">
                            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Excel
                        </button>
                        <button type="button" class="btn btn-outline-danger" data-bind="click: exportPdf, enable: !isLoading()">
                            <i class="bi bi-filetype-pdf me-1"></i>PDF
                        </button>
                        <button type="button" class="btn btn-outline-secondary" data-bind="click: openEmailModal, enable: !isLoading()">
                            <i class="bi bi-envelope me-1"></i><t key="salon.account.email">E-posta</t>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Genel KPI -->
    <!-- ko if: overview() -->
    <div class="row g-3 mb-3">
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <small class="text-muted"><t key="salon.reports.revenue">Gelir</t></small>
                    <h5 class="text-success mb-1" data-bind="text: formatMoney(overview().totalRevenue)"></h5>
                    <div class="small text-muted">
                        <span data-bind="text: overview().invoiceCount"></span> <t key="salon.reports.invoice_suffix">adisyon</t> · <t key="salon.reports.avg_abbr">Ort.</t>
                        <span data-bind="text: formatMoney(overview().averageTicket)"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <small class="text-muted"><t key="salon.reports.occupancy">Doluluk</t></small>
                    <h5 class="text-primary mb-1" data-bind="text: formatPercent(overview().occupancyPercent)"></h5>
                    <div class="small text-muted">
                        <span data-bind="text: formatNumber(overview().bookedHours, 1)"></span> /
                        <span data-bind="text: formatNumber(overview().capacityHours, 1)"></span> <t key="salon.reports.hour_lower">saat</t>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <small class="text-muted"><t key="salon.reports.repeat_visit">Tekrar Ziyaret</t></small>
                    <h5 class="text-info mb-1" data-bind="text: formatPercent(overview().repeatVisitRatePercent)"></h5>
                    <div class="small text-muted">
                        <span data-bind="text: overview().repeatClientCount"></span> <t key="salon.reports.repeat_clients_suffix">tekrar eden</t> /
                        <span data-bind="text: overview().activeClientCount"></span> <t key="salon.reports.active_customer">aktif müşteri</t>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <small class="text-muted"><t key="salon.reports.ltv">LTV</t></small>
                    <h5 class="mb-1" data-bind="text: formatMoney(overview().averageLifetimeValue)"></h5>
                    <div class="small text-muted">
                        <t key="salon.reports.period_per_person">Dönem kişi başı</t> <span data-bind="text: formatMoney(overview().periodSpendPerClient)"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <small class="text-muted"><t key="salon.reports.staff_efficiency">Personel Verimliliği</t></small>
                    <h5 class="mb-1" data-bind="text: formatMoney(overview().revenuePerActiveStaff)"></h5>
                    <div class="small text-muted">
                        <t key="salon.reports.per_person_hour">Kişi başı · Saat başı</t> <span data-bind="text: formatMoney(overview().revenuePerBookedHour)"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- /ko -->

    <!-- Aksiyon Onerileri -->
    <!-- ko if: overview() -->
    <div class="mb-3">
        <div class="d-flex align-items-end justify-content-between gap-2 mb-2">
            <div>
                <h6 class="mb-1"><i class="bi bi-lightning-charge me-1"></i><t key="salon.reports.actions.title">Aksiyon Önerileri</t></h6>
                <div class="text-muted small"><t key="salon.reports.actions.desc">Rapor metriklerini yapılacak işe çevirir; ilgili ekrana tek tıkla geçebilirsiniz.</t></div>
            </div>
            <span class="badge bg-light text-dark border" data-bind="text: reportActions().length + ' ' + salonT('salon.reports.actions.count_suffix', 'öneri')"></span>
        </div>

        <!-- ko if: reportActions().length > 0 -->
        <div class="row g-2" data-bind="foreach: reportActions">
            <div class="col-md-6 col-xl-4">
                <button type="button" class="btn text-start border bg-white w-100 h-100 p-3 shadow-sm" data-bind="click: $root.openReportAction">
                    <div class="d-flex gap-2 align-items-start">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light border flex-shrink-0" style="width:34px;height:34px;">
                            <i class="bi" data-bind="css: icon"></i>
                        </span>
                        <span class="d-block">
                            <span class="d-flex align-items-center gap-2 mb-1">
                                <span class="fw-semibold small" data-bind="text: title"></span>
                                <span class="badge" data-bind="text: $root.priorityLabel(priority), css: $root.priorityBadgeClass(priority)"></span>
                            </span>
                            <span class="d-block text-muted small" data-bind="text: description"></span>
                            <span class="d-block text-primary small mt-2">
                                <span data-bind="text: source"></span>
                                <i class="bi bi-arrow-right-short"></i>
                            </span>
                        </span>
                    </div>
                </button>
            </div>
        </div>
        <!-- /ko -->
        <!-- ko if: reportActions().length === 0 -->
        <div class="border rounded bg-white p-3 text-muted small">
            <i class="bi bi-check-circle text-success me-1"></i><t key="salon.reports.actions.empty">Bu aralıkta kritik aksiyon görünmüyor. Tabları açtıkça stok, finans ve müşteri önerileri de güncellenir.</t>
        </div>
        <!-- /ko -->
    </div>
    <!-- /ko -->

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="tab" href="#sales-tab" data-bind="click: loadSales"><t key="salon.reports.tabs.sales">Satış</t></a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#staff-tab" data-bind="click: loadStaff"><t key="salon.sidebar.staff">Personel</t></a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#branches-tab" data-bind="click: loadBranchComparison"><t key="salon.sidebar.branches">Şubeler</t></a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#stock-tab" data-bind="click: loadStock"><t key="salon.sidebar.inventory">Stok</t></a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#finance-tab" data-bind="click: loadFinance"><t key="salon.sidebar.finance">Finans</t></a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#clients-tab" data-bind="click: loadClients"><t key="salon.panel.payments.customer">Müşteri</t></a>
        </li>
    </ul>

    <div class="tab-content">
        <!-- Satis Tab -->
        <div class="tab-pane fade show active" id="sales-tab">
            <!-- ko if: sales() -->
            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.total_revenue">Toplam Gelir</t></small>
                        <h5 class="text-success mb-0" data-bind="text: formatMoney(sales().totalRevenue)"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.invoice_count">Adisyon Sayısı</t></small>
                        <h5 class="mb-0" data-bind="text: sales().totalInvoices"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.service_revenue">Hizmet Geliri</t></small>
                        <h5 class="text-primary mb-0" data-bind="text: formatMoney(sales().serviceRevenue)"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.product_revenue">Ürün Geliri</t></small>
                        <h5 class="text-info mb-0" data-bind="text: formatMoney(sales().productRevenue)"></h5>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white"><small class="fw-semibold"><t key="salon.reports.daily_sales">Günlük Satış</t></small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr><th><t key="salon.panel.payments.date">Tarih</t></th><th><t key="salon.reports.invoice">Adisyon</t></th><th><t key="salon.reports.revenue">Gelir</t></th></tr>
                                </thead>
                                <tbody data-bind="foreach: sales().dailySales">
                                    <tr>
                                        <td class="small" data-bind="text: new Date(date).toLocaleDateString(document.documentElement.lang || undefined)"></td>
                                        <td class="small" data-bind="text: invoiceCount"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(revenue)"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white"><small class="fw-semibold"><t key="salon.reports.payment_method_breakdown">Ödeme Yöntemi Dağılımı</t></small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr><th><t key="salon.modules.payment_method">Yöntem</t></th><th><t key="salon.reports.count">Adet</t></th><th><t key="salon.panel.payments.amount">Tutar</t></th></tr>
                                </thead>
                                <tbody data-bind="foreach: sales().paymentMethodBreakdown">
                                    <tr>
                                        <td class="small" data-bind="text: paymentMethodName"></td>
                                        <td class="small" data-bind="text: count"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(amount)"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- /ko -->
            <!-- ko if: !sales() && !isLoading() -->
            <div class="text-center text-muted py-4"><p><t key="salon.reports.data_will_load">Rapor verisi yüklenecek...</t></p></div>
            <!-- /ko -->
        </div>

        <!-- Personel Tab -->
        <div class="tab-pane fade" id="staff-tab">
            <!-- ko if: staff() -->
            <!-- ko if: overview() && overview().staffEfficiency.length > 0 -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white"><small class="fw-semibold"><t key="salon.reports.efficiency_summary">Verimlilik Özeti</t></small></div>
                <div class="card-body p-0">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr><th><t key="salon.sidebar.staff">Personel</t></th><th><t key="salon.sidebar.appointments">Randevu</t></th><th><t key="salon.reports.completed">Tamamlanan</t></th><th><t key="salon.reports.hour">Saat</t></th><th><t key="salon.reports.turnover">Ciro</t></th><th><t key="salon.reports.per_hour">Saat Başı</t></th><th><t key="salon.reports.per_service">Hizmet Başı</t></th></tr>
                        </thead>
                        <tbody data-bind="foreach: overview().staffEfficiency">
                            <tr>
                                <td class="fw-semibold small" data-bind="text: personnelName"></td>
                                <td class="small" data-bind="text: appointmentCount"></td>
                                <td class="small" data-bind="text: completedAppointmentCount"></td>
                                <td class="small" data-bind="text: $parent.formatNumber(bookedHours, 1)"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(revenue)"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(revenuePerBookedHour)"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(revenuePerService)"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- /ko -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr><th><t key="salon.sidebar.staff">Personel</t></th><th><t key="salon.reports.service_count">Hizmet Sayısı</t></th><th><t key="salon.reports.turnover">Ciro</t></th><th><t key="salon.reports.commission">Prim</t></th></tr>
                        </thead>
                        <tbody data-bind="foreach: staff().staff">
                            <tr>
                                <td class="fw-semibold small" data-bind="text: personnelName"></td>
                                <td class="small" data-bind="text: serviceCount"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(revenue)"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(commission)"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- /ko -->
        </div>

        <!-- Sube Karsilastirma Tab -->
        <div class="tab-pane fade" id="branches-tab">
            <!-- ko if: branchComparison() -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white"><small class="fw-semibold"><t key="salon.reports.branch_summaries">Şube Özetleri</t></small></div>
                <div class="card-body p-0">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr><th><t key="salon.common.branch">Şube</t></th><th><t key="salon.reports.turnover">Ciro</t></th><th><t key="salon.reports.share">Pay</t></th><th><t key="salon.reports.invoice">Adisyon</t></th><th><t key="salon.reports.average_basket">Ort. Sepet</t></th><th><t key="salon.book.summary.service">Hizmet</t></th><th><t key="salon.sidebar.products">Ürün</t></th><th><t key="salon.sidebar.appointments">Randevu</t></th><th><t key="salon.panel.payments.customer">Müşteri</t></th></tr>
                        </thead>
                        <tbody data-bind="foreach: branchComparison().branches">
                            <tr>
                                <td class="fw-semibold small" data-bind="text: branchName"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(totalRevenue)"></td>
                                <td class="small" data-bind="text: $parent.formatPercent(revenueSharePercent)"></td>
                                <td class="small" data-bind="text: invoiceCount"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(averageTicket)"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(serviceRevenue)"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(productRevenue)"></td>
                                <td class="small">
                                    <span data-bind="text: completedAppointmentCount"></span>/<span data-bind="text: appointmentCount"></span>
                                </td>
                                <td class="small" data-bind="text: activeClientCount"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold"><t key="salon.reports.service_dimension">Hizmet Boyutu</t></small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light"><tr><th><t key="salon.common.branch">Şube</t></th><th><t key="salon.book.summary.service">Hizmet</t></th><th><t key="salon.reports.count">Adet</t></th><th><t key="salon.reports.turnover">Ciro</t></th></tr></thead>
                                <tbody data-bind="foreach: branchComparison().services">
                                    <tr>
                                        <td class="small" data-bind="text: branchName"></td>
                                        <td class="small" data-bind="text: dimensionName"></td>
                                        <td class="small" data-bind="text: count"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(revenue)"></td>
                                    </tr>
                                </tbody>
                            </table>
                            <!-- ko if: branchComparison().services.length === 0 -->
                            <div class="text-center text-muted small py-3"><t key="salon.reports.no_service_revenue">Hizmet geliri yok.</t></div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold"><t key="salon.reports.staff_dimension">Personel Boyutu</t></small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light"><tr><th><t key="salon.common.branch">Şube</t></th><th><t key="salon.sidebar.staff">Personel</t></th><th><t key="salon.reports.count">Adet</t></th><th><t key="salon.reports.turnover">Ciro</t></th></tr></thead>
                                <tbody data-bind="foreach: branchComparison().personnel">
                                    <tr>
                                        <td class="small" data-bind="text: branchName"></td>
                                        <td class="small" data-bind="text: dimensionName"></td>
                                        <td class="small" data-bind="text: count"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(revenue)"></td>
                                    </tr>
                                </tbody>
                            </table>
                            <!-- ko if: branchComparison().personnel.length === 0 -->
                            <div class="text-center text-muted small py-3"><t key="salon.reports.no_staff_revenue">Personel bazlı gelir yok.</t></div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold"><t key="salon.reports.product_dimension">Ürün Boyutu</t></small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light"><tr><th><t key="salon.common.branch">Şube</t></th><th><t key="salon.sidebar.products">Ürün</t></th><th><t key="salon.reports.count">Adet</t></th><th><t key="salon.reports.turnover">Ciro</t></th></tr></thead>
                                <tbody data-bind="foreach: branchComparison().products">
                                    <tr>
                                        <td class="small" data-bind="text: branchName"></td>
                                        <td class="small" data-bind="text: dimensionName"></td>
                                        <td class="small" data-bind="text: count"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(revenue)"></td>
                                    </tr>
                                </tbody>
                            </table>
                            <!-- ko if: branchComparison().products.length === 0 -->
                            <div class="text-center text-muted small py-3"><t key="salon.reports.no_product_revenue">Ürün geliri yok.</t></div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
            </div>
            <!-- /ko -->
        </div>

        <!-- Stok Tab -->
        <div class="tab-pane fade" id="stock-tab">
            <!-- ko if: stock() -->
            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.total_products">Toplam Ürün</t></small>
                        <h5 class="mb-0" data-bind="text: stock().totalProducts"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.low_stock">Düşük Stok</t></small>
                        <h5 class="text-danger mb-0" data-bind="text: stock().lowStockCount"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.stock_cost">Stok Maliyeti</t></small>
                        <h5 class="text-primary mb-0" data-bind="text: formatMoney(stock().totalStockValue)"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.retail_value">Raf Satış Değeri</t></small>
                        <h5 class="text-info mb-0" data-bind="text: formatMoney(stock().totalRetailValue)"></h5>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.estimated_gross_profit">Tahmini Brüt Kar</t></small>
                        <h5 class="mb-0" data-bind="text: formatMoney(stock().potentialGrossProfit), css: { 'text-success': stock().potentialGrossProfit >= 0, 'text-danger': stock().potentialGrossProfit < 0 }"></h5>
                        <small class="text-muted" data-bind="text: formatPercent(stock().averageMarginPercent) + ' ' + salonT('salon.reports.margin', 'Marj').toLowerCase()"></small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.estimated_vat">Tahmini KDV</t></small>
                        <h5 class="text-warning mb-0" data-bind="text: formatMoney(stock().estimatedVatTotal)"></h5>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.supplier_debt">Tedarikçi Borcu</t></small>
                        <h5 class="mb-0" data-bind="text: formatMoney(stock().supplierDebtTotal), css: { 'text-danger': stock().supplierDebtTotal > 0, 'text-success': stock().supplierDebtTotal <= 0 }"></h5>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold"><t key="salon.reports.vat_breakdown">KDV Kırılımı</t></small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr><th><t key="salon.reports.vat">KDV</t></th><th><t key="salon.sidebar.products">Ürün</t></th><th><t key="salon.reports.stock_cost">Stok Maliyeti</t></th><th><t key="salon.reports.sales_value">Satış Değeri</t></th><th><t key="salon.reports.estimated_vat">Tahmini KDV</t></th></tr>
                                </thead>
                                <tbody data-bind="foreach: stock().taxBreakdown">
                                    <tr>
                                        <td class="small" data-bind="text: $parent.formatPercent(taxRate)"></td>
                                        <td class="small" data-bind="text: productCount"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(stockValue)"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(retailValue)"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(estimatedVatAmount)"></td>
                                    </tr>
                                </tbody>
                            </table>
                            <!-- ko if: stock().taxBreakdown.length === 0 -->
                            <div class="text-center text-muted small py-3"><t key="salon.reports.no_vat_products">KDV kırılımı için ürün yok.</t></div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold"><t key="salon.reports.supplier_debts">Tedarikçi Borçları</t></small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr><th><t key="salon.sidebar.suppliers">Tedarikçi</t></th><th><t key="salon.reports.balance">Bakiye</t></th><th><t key="salon.reports.last_activity">Son Hareket</t></th></tr>
                                </thead>
                                <tbody data-bind="foreach: stock().supplierDebtBreakdown">
                                    <tr>
                                        <td class="small" data-bind="text: supplierName"></td>
                                        <td class="small fw-semibold" data-bind="text: $parent.formatMoney(balance), css: { 'text-danger': balance > 0, 'text-success': balance <= 0 }"></td>
                                        <td class="small" data-bind="text: lastTransactionDate ? new Date(lastTransactionDate).toLocaleDateString(document.documentElement.lang || undefined) : '-'"></td>
                                    </tr>
                                </tbody>
                            </table>
                            <!-- ko if: stock().supplierDebtBreakdown.length === 0 -->
                            <div class="text-center text-muted small py-3"><t key="salon.reports.no_supplier_balance">Açık tedarikçi bakiyesi yok.</t></div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white"><small class="fw-semibold"><t key="salon.reports.product_stock_margin_detail">Ürün Stok ve Marj Detayı</t></small></div>
                <div class="card-body p-0">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr><th><t key="salon.sidebar.products">Ürün</t></th><th><t key="salon.reports.category">Kategori</t></th><th><t key="salon.sidebar.inventory">Stok</t></th><th><t key="salon.reports.min">Min</t></th><th><t key="salon.reports.vat">KDV</t></th><th><t key="salon.reports.cost">Maliyet</t></th><th><t key="salon.reports.sales_value">Satış Değeri</t></th><th><t key="salon.reports.margin">Marj</t></th></tr>
                        </thead>
                        <tbody data-bind="foreach: stock().items">
                            <tr data-bind="css: { 'table-danger': isLowStock }">
                                <td class="small" data-bind="text: productName"></td>
                                <td class="small" data-bind="text: categoryName"></td>
                                <td class="small" data-bind="text: stockQuantity"></td>
                                <td class="small" data-bind="text: minStockLevel"></td>
                                <td class="small" data-bind="text: $parent.formatPercent(taxRate)"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(stockValue)"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(retailValue)"></td>
                                <td class="small fw-semibold" data-bind="text: $parent.formatMoney(potentialGrossProfit) + ' / ' + $parent.formatPercent(marginPercent), css: { 'text-success': potentialGrossProfit >= 0, 'text-danger': potentialGrossProfit < 0 }"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- /ko -->
        </div>

        <!-- Finans Tab -->
        <div class="tab-pane fade" id="finance-tab">
            <!-- ko if: finance() -->
            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.total_revenue">Toplam Gelir</t></small>
                        <h5 class="text-success mb-0" data-bind="text: formatMoney(finance().totalIncome)"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.total_expense">Toplam Gider</t></small>
                        <h5 class="text-danger mb-0" data-bind="text: formatMoney(finance().totalExpense)"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.net_profit">Net Kâr</t></small>
                        <h5 class="mb-0" data-bind="text: formatMoney(finance().netProfit), css: { 'text-success': finance().netProfit >= 0, 'text-danger': finance().netProfit < 0 }"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.invoice_short">Fatura</t></small>
                        <h5 class="mb-0" data-bind="text: finance().invoiceCount"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.sales_vat">Satış KDV</t></small>
                        <h5 class="text-warning mb-0" data-bind="text: formatMoney(finance().salesVatTotal)"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.expense_vat">Gider KDV</t></small>
                        <h5 class="text-info mb-0" data-bind="text: formatMoney(finance().expenseVatTotal)"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.vat_payable">Ödenecek KDV</t></small>
                        <h5 class="mb-0" data-bind="text: formatMoney(finance().vatPayable), css: { 'text-danger': finance().vatPayable > 0, 'text-success': finance().vatPayable <= 0 }"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.cash_net">Kasa Net</t></small>
                        <h5 class="mb-0" data-bind="text: formatMoney(finance().cashNet), css: { 'text-success': finance().cashNet >= 0, 'text-danger': finance().cashNet < 0 }"></h5>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold"><t key="salon.reports.invoice_summary">Fatura Özeti</t></small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <tbody>
                                    <tr><td class="small"><t key="salon.reports.gross_sales">Brüt Satış</t></td><td class="small text-end" data-bind="text: formatMoney(finance().grossRevenue)"></td></tr>
                                    <tr><td class="small"><t key="salon.profile.membership.discount_suffix">İndirim</t></td><td class="small text-end" data-bind="text: formatMoney(finance().discountTotal)"></td></tr>
                                    <tr><td class="small"><t key="salon.reports.service_revenue">Hizmet Geliri</t></td><td class="small text-end" data-bind="text: formatMoney(finance().serviceRevenue)"></td></tr>
                                    <tr><td class="small"><t key="salon.reports.product_revenue">Ürün Geliri</t></td><td class="small text-end" data-bind="text: formatMoney(finance().productRevenue)"></td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold"><t key="salon.reports.cash_summary">Kasa Özeti</t></small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <tbody>
                                    <tr><td class="small"><t key="salon.reports.cash_in">Kasa Giriş</t></td><td class="small text-end text-success" data-bind="text: formatMoney(finance().cashIncome)"></td></tr>
                                    <tr><td class="small"><t key="salon.reports.cash_out">Kasa Çıkış</t></td><td class="small text-end text-danger" data-bind="text: formatMoney(finance().cashExpense)"></td></tr>
                                    <tr><td class="small"><t key="salon.reports.period_net">Dönem Net</t></td><td class="small text-end" data-bind="text: formatMoney(finance().cashNet)"></td></tr>
                                    <tr><td class="small"><t key="salon.reports.period_end_balance">Dönem Sonu Bakiye</t></td><td class="small text-end fw-semibold" data-bind="text: formatMoney(finance().cashBalance)"></td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold"><t key="salon.reports.stock_value">Stok Değeri</t></small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <tbody>
                                    <tr><td class="small"><t key="salon.reports.stock_cost">Stok Maliyeti</t></td><td class="small text-end" data-bind="text: formatMoney(finance().stockValue)"></td></tr>
                                    <tr><td class="small"><t key="salon.reports.retail_value">Raf Satış Değeri</t></td><td class="small text-end" data-bind="text: formatMoney(finance().retailStockValue)"></td></tr>
                                    <tr><td class="small"><t key="salon.reports.auto.tahmini_stok_kdv">Tahmini Stok KDV</t></td><td class="small text-end" data-bind="text: formatMoney(finance().estimatedStockVat)"></td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold"><t key="salon.reports.payment_methods">Ödeme Yöntemleri</t></small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light"><tr><th><t key="salon.modules.payment_method">Yöntem</t></th><th><t key="salon.reports.count">Adet</t></th><th><t key="salon.panel.payments.amount">Tutar</t></th></tr></thead>
                                <tbody data-bind="foreach: finance().paymentMethodBreakdown">
                                    <tr>
                                        <td class="small" data-bind="text: paymentMethodName"></td>
                                        <td class="small" data-bind="text: count"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(amount)"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold"><t key="salon.reports.sales_vat_breakdown">Satış KDV Kırılımı</t></small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light"><tr><th><t key="salon.reports.vat">KDV</t></th><th><t key="salon.reports.line">Satır</t></th><th><t key="salon.reports.taxable_amount">Matrah</t></th><th><t key="salon.panel.payments.amount">Tutar</t></th></tr></thead>
                                <tbody data-bind="foreach: finance().taxBreakdown">
                                    <tr>
                                        <td class="small" data-bind="text: $parent.formatPercent(taxRate)"></td>
                                        <td class="small" data-bind="text: lineCount"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(taxableAmount)"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(taxAmount)"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold"><t key="salon.reports.expense_breakdown">Masraf Dağılımı</t></small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light"><tr><th><t key="salon.reports.category">Kategori</t></th><th><t key="salon.reports.count">Adet</t></th><th><t key="salon.panel.payments.amount">Tutar</t></th></tr></thead>
                                <tbody data-bind="foreach: finance().expenseBreakdown">
                                    <tr>
                                        <td class="small" data-bind="text: categoryName"></td>
                                        <td class="small" data-bind="text: count"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(amount)"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- /ko -->
        </div>

        <!-- Musteri Tab -->
        <div class="tab-pane fade" id="clients-tab">
            <!-- ko if: clientReport() -->
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.dashboard.total_clients">Toplam Müşteri</t></small>
                        <h5 class="mb-0" data-bind="text: clientReport().totalClients"></h5>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.new_in_period">Dönemde Yeni</t></small>
                        <h5 class="text-primary mb-0" data-bind="text: clientReport().newClientsInPeriod"></h5>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted"><t key="salon.reports.avg_visit_frequency">Ort. Ziyaret Sıklığı</t></small>
                        <h5 class="mb-0" data-bind="text: clientReport().averageVisitFrequency.toFixed(1)"></h5>
                    </div>
                </div>
            </div>
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white"><small class="fw-semibold"><t key="salon.reports.top_clients">En Değerli Müşteriler</t></small></div>
                <div class="card-body p-0">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr><th><t key="salon.panel.payments.customer">Müşteri</t></th><th><t key="salon.reports.visit">Ziyaret</t></th><th><t key="salon.reports.total_spent">Toplam Harcama</t></th><th><t key="salon.reports.last_visit">Son Ziyaret</t></th></tr>
                        </thead>
                        <tbody data-bind="foreach: clientReport().topClients">
                            <tr>
                                <td class="fw-semibold small" data-bind="text: clientName"></td>
                                <td class="small" data-bind="text: visitCount"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(totalSpent)"></td>
                                <td class="small" data-bind="text: lastVisit ? new Date(lastVisit).toLocaleDateString(document.documentElement.lang || undefined) : '-'"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Loading -->
    <!-- ko if: isLoading() -->
    <div class="text-center py-4">
        <div class="spinner-border spinner-border-sm text-primary"></div>
        <span class="ms-2 text-muted small"><t key="salon.common.loading">Yükleniyor...</t></span>
    </div>
    <!-- /ko -->

    <div class="modal fade" id="reportEmailModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title"><i class="bi bi-envelope me-1"></i><t key="salon.reports.email_modal.title">Raporu E-posta ile Gönder</t></h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small"><t key="salon.reports.email_modal.recipients">Alıcılar</t></label>
                        <textarea class="form-control form-control-sm" rows="2" placeholder="@(Translation.T("salon.reports.email_modal.recipients_placeholder", "ornek@firma.com; muhasebe@firma.com"))" data-bind="value: emailForm.toAddresses"></textarea>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-2">
                            <label class="form-label small"><t key="salon.reports.email_modal.format">Format</t></label>
                            <select class="form-select form-select-sm" data-bind="value: emailForm.format">
                                <option value="pdf">PDF</option>
                                <option value="xlsx">Excel</option>
                                <option value="csv">CSV</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label small"><t key="salon.reports.email_modal.schedule">Zamanla</t></label>
                            <input type="datetime-local" class="form-control form-control-sm" data-bind="value: emailForm.scheduledAt" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small"><t key="salon.reports.email_modal.subject">Konu</t></label>
                        <input class="form-control form-control-sm" data-bind="value: emailForm.subject" placeholder="@(Translation.T("salon.reports.email_modal.subject_placeholder", "Boş bırakılırsa otomatik oluşturulur"))" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small"><t key="salon.reports.email_modal.message">Mesaj</t></label>
                        <textarea class="form-control form-control-sm" rows="2" data-bind="value: emailForm.message" placeholder="@(Translation.T("salon.reports.email_modal.message_placeholder", "E-posta gövdesine eklenecek not"))"></textarea>
                    </div>
                    <div class="text-muted small">
                        <t key="salon.reports.email_modal.help">Zaman alanı boş ise rapor hemen gönderilir. Gönderim, tanımlı salon e-posta entegrasyonunu kullanır.</t>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: sendReportEmail, disable: isEmailSending">
                        <span class="spinner-border spinner-border-sm me-1" data-bind="visible: isEmailSending"></span>
                        <i class="bi bi-send me-1" data-bind="visible: !isEmailSending()"></i><t key="salon.reports.email_modal.send_schedule">Gönder / Zamanla</t>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Reports.js" asp-append-version="true"></script>
}
