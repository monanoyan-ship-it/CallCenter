@{
    ViewData["Title"] = "Raporlar";
}

<div id="reports-vm">
    <!-- Tarih Araligi -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="row align-items-center g-2">
                <div class="col-auto">
                    <label class="form-label small mb-0">Baslangic:</label>
                </div>
                <div class="col-auto">
                    <input type="date" class="form-control form-control-sm" data-bind="value: dateFrom" />
                </div>
                <div class="col-auto">
                    <label class="form-label small mb-0">Bitis:</label>
                </div>
                <div class="col-auto">
                    <input type="date" class="form-control form-control-sm" data-bind="value: dateTo" />
                </div>
                <div class="col-auto">
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary" data-bind="click: setToday">Bugun</button>
                        <button class="btn btn-outline-secondary" data-bind="click: setWeek">Bu Hafta</button>
                        <button class="btn btn-outline-secondary" data-bind="click: setMonth">Bu Ay</button>
                    </div>
                </div>
                <div class="col-auto">
                    <button class="btn btn-sm btn-primary" data-bind="click: refreshReports">
                        <i class="bi bi-arrow-clockwise me-1"></i>Yenile
                    </button>
                </div>
                <div class="col-auto ms-auto">
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-success" data-bind="click: exportCsv, enable: !isLoading()">
                            <i class="bi bi-filetype-csv me-1"></i>CSV
                        </button>
                        <button type="button" class="btn btn-outline-primary" data-bind="click: exportExcel, enable: !isLoading()">
                            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Excel
                        </button>
                        <button type="button" class="btn btn-outline-danger" data-bind="click: exportPdf, enable: !isLoading()">
                            <i class="bi bi-filetype-pdf me-1"></i>PDF
                        </button>
                        <button type="button" class="btn btn-outline-secondary" data-bind="click: openEmailModal, enable: !isLoading()">
                            <i class="bi bi-envelope me-1"></i>E-posta
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Genel KPI -->
    <!-- ko if: overview() -->
    <div class="row g-3 mb-3">
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <small class="text-muted">Gelir</small>
                    <h5 class="text-success mb-1" data-bind="text: formatMoney(overview().totalRevenue)"></h5>
                    <div class="small text-muted">
                        <span data-bind="text: overview().invoiceCount"></span> adisyon · Ort.
                        <span data-bind="text: formatMoney(overview().averageTicket)"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <small class="text-muted">Doluluk</small>
                    <h5 class="text-primary mb-1" data-bind="text: formatPercent(overview().occupancyPercent)"></h5>
                    <div class="small text-muted">
                        <span data-bind="text: formatNumber(overview().bookedHours, 1)"></span> /
                        <span data-bind="text: formatNumber(overview().capacityHours, 1)"></span> saat
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <small class="text-muted">Tekrar Ziyaret</small>
                    <h5 class="text-info mb-1" data-bind="text: formatPercent(overview().repeatVisitRatePercent)"></h5>
                    <div class="small text-muted">
                        <span data-bind="text: overview().repeatClientCount"></span> tekrar eden /
                        <span data-bind="text: overview().activeClientCount"></span> aktif musteri
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <small class="text-muted">LTV</small>
                    <h5 class="mb-1" data-bind="text: formatMoney(overview().averageLifetimeValue)"></h5>
                    <div class="small text-muted">
                        Donem kisi basi <span data-bind="text: formatMoney(overview().periodSpendPerClient)"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <small class="text-muted">Personel Verimliligi</small>
                    <h5 class="mb-1" data-bind="text: formatMoney(overview().revenuePerActiveStaff)"></h5>
                    <div class="small text-muted">
                        Kisi basi · Saat basi <span data-bind="text: formatMoney(overview().revenuePerBookedHour)"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- /ko -->

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="tab" href="#sales-tab" data-bind="click: loadSales">Satis</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#staff-tab" data-bind="click: loadStaff">Personel</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#branches-tab" data-bind="click: loadBranchComparison">Subeler</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#stock-tab" data-bind="click: loadStock">Stok</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#finance-tab" data-bind="click: loadFinance">Finans</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#clients-tab" data-bind="click: loadClients">Musteri</a>
        </li>
    </ul>

    <div class="tab-content">
        <!-- Satis Tab -->
        <div class="tab-pane fade show active" id="sales-tab">
            <!-- ko if: sales() -->
            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Toplam Gelir</small>
                        <h5 class="text-success mb-0" data-bind="text: formatMoney(sales().totalRevenue)"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Adisyon Sayisi</small>
                        <h5 class="mb-0" data-bind="text: sales().totalInvoices"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Hizmet Geliri</small>
                        <h5 class="text-primary mb-0" data-bind="text: formatMoney(sales().serviceRevenue)"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Urun Geliri</small>
                        <h5 class="text-info mb-0" data-bind="text: formatMoney(sales().productRevenue)"></h5>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white"><small class="fw-semibold">Gunluk Satis</small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr><th>Tarih</th><th>Adisyon</th><th>Gelir</th></tr>
                                </thead>
                                <tbody data-bind="foreach: sales().dailySales">
                                    <tr>
                                        <td class="small" data-bind="text: new Date(date).toLocaleDateString('tr-TR')"></td>
                                        <td class="small" data-bind="text: invoiceCount"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(revenue)"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white"><small class="fw-semibold">Odeme Yontemi Dagilimi</small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr><th>Yontem</th><th>Adet</th><th>Tutar</th></tr>
                                </thead>
                                <tbody data-bind="foreach: sales().paymentMethodBreakdown">
                                    <tr>
                                        <td class="small" data-bind="text: paymentMethodName"></td>
                                        <td class="small" data-bind="text: count"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(amount)"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- /ko -->
            <!-- ko if: !sales() && !isLoading() -->
            <div class="text-center text-muted py-4"><p>Rapor verisi yuklenecek...</p></div>
            <!-- /ko -->
        </div>

        <!-- Personel Tab -->
        <div class="tab-pane fade" id="staff-tab">
            <!-- ko if: staff() -->
            <!-- ko if: overview() && overview().staffEfficiency.length > 0 -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white"><small class="fw-semibold">Verimlilik Ozeti</small></div>
                <div class="card-body p-0">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Personel</th><th>Randevu</th><th>Tamamlanan</th><th>Saat</th><th>Ciro</th><th>Saat Basi</th><th>Hizmet Basi</th></tr>
                        </thead>
                        <tbody data-bind="foreach: overview().staffEfficiency">
                            <tr>
                                <td class="fw-semibold small" data-bind="text: personnelName"></td>
                                <td class="small" data-bind="text: appointmentCount"></td>
                                <td class="small" data-bind="text: completedAppointmentCount"></td>
                                <td class="small" data-bind="text: $parent.formatNumber(bookedHours, 1)"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(revenue)"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(revenuePerBookedHour)"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(revenuePerService)"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- /ko -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Personel</th><th>Hizmet Sayisi</th><th>Ciro</th><th>Prim</th></tr>
                        </thead>
                        <tbody data-bind="foreach: staff().staff">
                            <tr>
                                <td class="fw-semibold small" data-bind="text: personnelName"></td>
                                <td class="small" data-bind="text: serviceCount"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(revenue)"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(commission)"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- /ko -->
        </div>

        <!-- Sube Karsilastirma Tab -->
        <div class="tab-pane fade" id="branches-tab">
            <!-- ko if: branchComparison() -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white"><small class="fw-semibold">Sube Ozetleri</small></div>
                <div class="card-body p-0">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Sube</th><th>Ciro</th><th>Pay</th><th>Adisyon</th><th>Ort. Sepet</th><th>Hizmet</th><th>Urun</th><th>Randevu</th><th>Musteri</th></tr>
                        </thead>
                        <tbody data-bind="foreach: branchComparison().branches">
                            <tr>
                                <td class="fw-semibold small" data-bind="text: branchName"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(totalRevenue)"></td>
                                <td class="small" data-bind="text: $parent.formatPercent(revenueSharePercent)"></td>
                                <td class="small" data-bind="text: invoiceCount"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(averageTicket)"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(serviceRevenue)"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(productRevenue)"></td>
                                <td class="small">
                                    <span data-bind="text: completedAppointmentCount"></span>/<span data-bind="text: appointmentCount"></span>
                                </td>
                                <td class="small" data-bind="text: activeClientCount"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold">Hizmet Boyutu</small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light"><tr><th>Sube</th><th>Hizmet</th><th>Adet</th><th>Ciro</th></tr></thead>
                                <tbody data-bind="foreach: branchComparison().services">
                                    <tr>
                                        <td class="small" data-bind="text: branchName"></td>
                                        <td class="small" data-bind="text: dimensionName"></td>
                                        <td class="small" data-bind="text: count"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(revenue)"></td>
                                    </tr>
                                </tbody>
                            </table>
                            <!-- ko if: branchComparison().services.length === 0 -->
                            <div class="text-center text-muted small py-3">Hizmet geliri yok.</div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold">Personel Boyutu</small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light"><tr><th>Sube</th><th>Personel</th><th>Adet</th><th>Ciro</th></tr></thead>
                                <tbody data-bind="foreach: branchComparison().personnel">
                                    <tr>
                                        <td class="small" data-bind="text: branchName"></td>
                                        <td class="small" data-bind="text: dimensionName"></td>
                                        <td class="small" data-bind="text: count"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(revenue)"></td>
                                    </tr>
                                </tbody>
                            </table>
                            <!-- ko if: branchComparison().personnel.length === 0 -->
                            <div class="text-center text-muted small py-3">Personel bazli gelir yok.</div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold">Urun Boyutu</small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light"><tr><th>Sube</th><th>Urun</th><th>Adet</th><th>Ciro</th></tr></thead>
                                <tbody data-bind="foreach: branchComparison().products">
                                    <tr>
                                        <td class="small" data-bind="text: branchName"></td>
                                        <td class="small" data-bind="text: dimensionName"></td>
                                        <td class="small" data-bind="text: count"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(revenue)"></td>
                                    </tr>
                                </tbody>
                            </table>
                            <!-- ko if: branchComparison().products.length === 0 -->
                            <div class="text-center text-muted small py-3">Urun geliri yok.</div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
            </div>
            <!-- /ko -->
        </div>

        <!-- Stok Tab -->
        <div class="tab-pane fade" id="stock-tab">
            <!-- ko if: stock() -->
            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Toplam Urun</small>
                        <h5 class="mb-0" data-bind="text: stock().totalProducts"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Dusuk Stok</small>
                        <h5 class="text-danger mb-0" data-bind="text: stock().lowStockCount"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Stok Maliyeti</small>
                        <h5 class="text-primary mb-0" data-bind="text: formatMoney(stock().totalStockValue)"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Raf Satis Degeri</small>
                        <h5 class="text-info mb-0" data-bind="text: formatMoney(stock().totalRetailValue)"></h5>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Tahmini Brut Kar</small>
                        <h5 class="mb-0" data-bind="text: formatMoney(stock().potentialGrossProfit), css: { 'text-success': stock().potentialGrossProfit >= 0, 'text-danger': stock().potentialGrossProfit < 0 }"></h5>
                        <small class="text-muted" data-bind="text: formatPercent(stock().averageMarginPercent) + ' marj'"></small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Tahmini KDV</small>
                        <h5 class="text-warning mb-0" data-bind="text: formatMoney(stock().estimatedVatTotal)"></h5>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Tedarikci Borcu</small>
                        <h5 class="mb-0" data-bind="text: formatMoney(stock().supplierDebtTotal), css: { 'text-danger': stock().supplierDebtTotal > 0, 'text-success': stock().supplierDebtTotal <= 0 }"></h5>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold">KDV Kirilimi</small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr><th>KDV</th><th>Urun</th><th>Stok Maliyeti</th><th>Satis Degeri</th><th>Tahmini KDV</th></tr>
                                </thead>
                                <tbody data-bind="foreach: stock().taxBreakdown">
                                    <tr>
                                        <td class="small" data-bind="text: $parent.formatPercent(taxRate)"></td>
                                        <td class="small" data-bind="text: productCount"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(stockValue)"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(retailValue)"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(estimatedVatAmount)"></td>
                                    </tr>
                                </tbody>
                            </table>
                            <!-- ko if: stock().taxBreakdown.length === 0 -->
                            <div class="text-center text-muted small py-3">KDV kirilimi icin urun yok.</div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold">Tedarikci Borclari</small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr><th>Tedarikci</th><th>Bakiye</th><th>Son Hareket</th></tr>
                                </thead>
                                <tbody data-bind="foreach: stock().supplierDebtBreakdown">
                                    <tr>
                                        <td class="small" data-bind="text: supplierName"></td>
                                        <td class="small fw-semibold" data-bind="text: $parent.formatMoney(balance), css: { 'text-danger': balance > 0, 'text-success': balance <= 0 }"></td>
                                        <td class="small" data-bind="text: lastTransactionDate ? new Date(lastTransactionDate).toLocaleDateString('tr-TR') : '-'"></td>
                                    </tr>
                                </tbody>
                            </table>
                            <!-- ko if: stock().supplierDebtBreakdown.length === 0 -->
                            <div class="text-center text-muted small py-3">Acik tedarikci bakiyesi yok.</div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white"><small class="fw-semibold">Urun Stok ve Marj Detayi</small></div>
                <div class="card-body p-0">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Urun</th><th>Kategori</th><th>Stok</th><th>Min</th><th>KDV</th><th>Maliyet</th><th>Satis Degeri</th><th>Marj</th></tr>
                        </thead>
                        <tbody data-bind="foreach: stock().items">
                            <tr data-bind="css: { 'table-danger': isLowStock }">
                                <td class="small" data-bind="text: productName"></td>
                                <td class="small" data-bind="text: categoryName"></td>
                                <td class="small" data-bind="text: stockQuantity"></td>
                                <td class="small" data-bind="text: minStockLevel"></td>
                                <td class="small" data-bind="text: $parent.formatPercent(taxRate)"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(stockValue)"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(retailValue)"></td>
                                <td class="small fw-semibold" data-bind="text: $parent.formatMoney(potentialGrossProfit) + ' / ' + $parent.formatPercent(marginPercent), css: { 'text-success': potentialGrossProfit >= 0, 'text-danger': potentialGrossProfit < 0 }"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- /ko -->
        </div>

        <!-- Finans Tab -->
        <div class="tab-pane fade" id="finance-tab">
            <!-- ko if: finance() -->
            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Toplam Gelir</small>
                        <h5 class="text-success mb-0" data-bind="text: formatMoney(finance().totalIncome)"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Toplam Gider</small>
                        <h5 class="text-danger mb-0" data-bind="text: formatMoney(finance().totalExpense)"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Net Kar</small>
                        <h5 class="mb-0" data-bind="text: formatMoney(finance().netProfit), css: { 'text-success': finance().netProfit >= 0, 'text-danger': finance().netProfit < 0 }"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Fatura</small>
                        <h5 class="mb-0" data-bind="text: finance().invoiceCount"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Satis KDV</small>
                        <h5 class="text-warning mb-0" data-bind="text: formatMoney(finance().salesVatTotal)"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Gider KDV</small>
                        <h5 class="text-info mb-0" data-bind="text: formatMoney(finance().expenseVatTotal)"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Odenecek KDV</small>
                        <h5 class="mb-0" data-bind="text: formatMoney(finance().vatPayable), css: { 'text-danger': finance().vatPayable > 0, 'text-success': finance().vatPayable <= 0 }"></h5>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Kasa Net</small>
                        <h5 class="mb-0" data-bind="text: formatMoney(finance().cashNet), css: { 'text-success': finance().cashNet >= 0, 'text-danger': finance().cashNet < 0 }"></h5>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold">Fatura Ozeti</small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <tbody>
                                    <tr><td class="small">Brut Satis</td><td class="small text-end" data-bind="text: formatMoney(finance().grossRevenue)"></td></tr>
                                    <tr><td class="small">Indirim</td><td class="small text-end" data-bind="text: formatMoney(finance().discountTotal)"></td></tr>
                                    <tr><td class="small">Hizmet Geliri</td><td class="small text-end" data-bind="text: formatMoney(finance().serviceRevenue)"></td></tr>
                                    <tr><td class="small">Urun Geliri</td><td class="small text-end" data-bind="text: formatMoney(finance().productRevenue)"></td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold">Kasa Ozeti</small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <tbody>
                                    <tr><td class="small">Kasa Giris</td><td class="small text-end text-success" data-bind="text: formatMoney(finance().cashIncome)"></td></tr>
                                    <tr><td class="small">Kasa Cikis</td><td class="small text-end text-danger" data-bind="text: formatMoney(finance().cashExpense)"></td></tr>
                                    <tr><td class="small">Donem Net</td><td class="small text-end" data-bind="text: formatMoney(finance().cashNet)"></td></tr>
                                    <tr><td class="small">Donem Sonu Bakiye</td><td class="small text-end fw-semibold" data-bind="text: formatMoney(finance().cashBalance)"></td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold">Stok Degeri</small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <tbody>
                                    <tr><td class="small">Stok Maliyeti</td><td class="small text-end" data-bind="text: formatMoney(finance().stockValue)"></td></tr>
                                    <tr><td class="small">Raf Satis Degeri</td><td class="small text-end" data-bind="text: formatMoney(finance().retailStockValue)"></td></tr>
                                    <tr><td class="small">Tahmini Stok KDV</td><td class="small text-end" data-bind="text: formatMoney(finance().estimatedStockVat)"></td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold">Odeme Yontemleri</small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light"><tr><th>Yontem</th><th>Adet</th><th>Tutar</th></tr></thead>
                                <tbody data-bind="foreach: finance().paymentMethodBreakdown">
                                    <tr>
                                        <td class="small" data-bind="text: paymentMethodName"></td>
                                        <td class="small" data-bind="text: count"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(amount)"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold">Satis KDV Kirilimi</small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light"><tr><th>KDV</th><th>Satir</th><th>Matrah</th><th>Tutar</th></tr></thead>
                                <tbody data-bind="foreach: finance().taxBreakdown">
                                    <tr>
                                        <td class="small" data-bind="text: $parent.formatPercent(taxRate)"></td>
                                        <td class="small" data-bind="text: lineCount"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(taxableAmount)"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(taxAmount)"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white"><small class="fw-semibold">Masraf Dagilimi</small></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead class="table-light"><tr><th>Kategori</th><th>Adet</th><th>Tutar</th></tr></thead>
                                <tbody data-bind="foreach: finance().expenseBreakdown">
                                    <tr>
                                        <td class="small" data-bind="text: categoryName"></td>
                                        <td class="small" data-bind="text: count"></td>
                                        <td class="small" data-bind="text: $parent.formatMoney(amount)"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- /ko -->
        </div>

        <!-- Musteri Tab -->
        <div class="tab-pane fade" id="clients-tab">
            <!-- ko if: clientReport() -->
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Toplam Musteri</small>
                        <h5 class="mb-0" data-bind="text: clientReport().totalClients"></h5>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Donemde Yeni</small>
                        <h5 class="text-primary mb-0" data-bind="text: clientReport().newClientsInPeriod"></h5>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm text-center p-3">
                        <small class="text-muted">Ort. Ziyaret Sikligi</small>
                        <h5 class="mb-0" data-bind="text: clientReport().averageVisitFrequency.toFixed(1)"></h5>
                    </div>
                </div>
            </div>
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white"><small class="fw-semibold">En Degerli Musteriler</small></div>
                <div class="card-body p-0">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Musteri</th><th>Ziyaret</th><th>Toplam Harcama</th><th>Son Ziyaret</th></tr>
                        </thead>
                        <tbody data-bind="foreach: clientReport().topClients">
                            <tr>
                                <td class="fw-semibold small" data-bind="text: clientName"></td>
                                <td class="small" data-bind="text: visitCount"></td>
                                <td class="small" data-bind="text: $parent.formatMoney(totalSpent)"></td>
                                <td class="small" data-bind="text: lastVisit ? new Date(lastVisit).toLocaleDateString('tr-TR') : '-'"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Loading -->
    <!-- ko if: isLoading() -->
    <div class="text-center py-4">
        <div class="spinner-border spinner-border-sm text-primary"></div>
        <span class="ms-2 text-muted small">Yukleniyor...</span>
    </div>
    <!-- /ko -->

    <div class="modal fade" id="reportEmailModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title"><i class="bi bi-envelope me-1"></i>Raporu E-posta ile Gonder</h6>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small">Alicilar</label>
                        <textarea class="form-control form-control-sm" rows="2" placeholder="ornek@firma.com; muhasebe@firma.com" data-bind="value: emailForm.toAddresses"></textarea>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-2">
                            <label class="form-label small">Format</label>
                            <select class="form-select form-select-sm" data-bind="value: emailForm.format">
                                <option value="pdf">PDF</option>
                                <option value="xlsx">Excel</option>
                                <option value="csv">CSV</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label small">Zamanla</label>
                            <input type="datetime-local" class="form-control form-control-sm" data-bind="value: emailForm.scheduledAt" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Konu</label>
                        <input class="form-control form-control-sm" data-bind="value: emailForm.subject" placeholder="Bos birakilirsa otomatik olusturulur" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Mesaj</label>
                        <textarea class="form-control form-control-sm" rows="2" data-bind="value: emailForm.message" placeholder="E-posta govdesine eklenecek not"></textarea>
                    </div>
                    <div class="text-muted small">
                        Zaman alani bos ise rapor hemen gonderilir. Gonderim, tanimli salon e-posta entegrasyonunu kullanir.
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: sendReportEmail, disable: isEmailSending">
                        <span class="spinner-border spinner-border-sm me-1" data-bind="visible: isEmailSending"></span>
                        <i class="bi bi-send me-1" data-bind="visible: !isEmailSending()"></i>Gonder / Zamanla
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Reports.js" asp-append-version="true"></script>
}
