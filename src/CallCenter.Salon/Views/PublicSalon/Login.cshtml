@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    Layout = null;
    var pageLang = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    string T(string key, string fallback) => Translation.T(key, fallback);
}
<!DOCTYPE html>
<html lang="@pageLang">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@T("salon.publicsalon.auto.giris_corplynk_salon", "Giriş - CorpLynk Salon")</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: linear-gradient(135deg, #2d1b3d 0%, #1a1028 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .auth-card { background: #fff; border-radius: 16px; padding: 2rem; max-width: 400px; width: 100%; box-shadow: 0 8px 32px rgba(0,0,0,.2); }
    </style>
</head>
<body>
    <div style="position:absolute;top:10px;right:10px;">
        @await Html.PartialAsync("_LanguageMenu", "auth")
    </div>
    <div class="auth-card">
        <div class="text-center mb-4">
            <i class="bi bi-scissors" style="font-size:2rem; color:#6f42c1;"></i>
            <h5 class="mt-2">CorpLynk <span style="color:#ce93d8;"><t key="salon.publicsalon.auto.salon">Salon</t></span></h5>
            <p class="text-muted small"><t key="salon.login.subtitle">Sign in to your account</t></p>
        </div>
        <div id="login-form">
            <div class="mb-3">
                <label class="form-label small"><t key="salon.login.phone">Phone</t></label>
                <div class="input-group">
                    <select id="phoneCountry" class="form-select" style="max-width:120px;">
                        <option value="+90" selected>🇹🇷 +90</option>
                        <option value="+49">🇩🇪 +49</option>
                        <option value="+44">🇬🇧 +44</option>
                        <option value="+1">🇺🇸 +1</option>
                        <option value="+33">🇫🇷 +33</option>
                        <option value="+31">🇳🇱 +31</option>
                        <option value="+43">🇦🇹 +43</option>
                        <option value="+41">🇨🇭 +41</option>
                        <option value="+46">🇸🇪 +46</option>
                        <option value="+32">🇧🇪 +32</option>
                        <option value="+7">🇷🇺 +7</option>
                        <option value="+971">🇦🇪 +971</option>
                    </select>
                    <input type="tel" class="form-control" id="phone" placeholder="5XX XXX XX XX" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label small"><t key="salon.login.password">Password</t></label>
                <input type="password" class="form-control" id="password" />
            </div>
            <div id="error-msg" class="alert alert-danger py-1 small d-none"></div>
            <button class="btn btn-primary w-100" id="loginBtn" onclick="doLogin()">
                <i class="bi bi-box-arrow-in-right me-1"></i><t key="salon.login.btn">Sign In</t>
            </button>
            <div class="d-flex justify-content-between mt-3 small">
                <a href="/user/forgot-password" class="text-decoration-none text-muted"><t key="salon.account.forgot_link">Şifremi unuttum</t></a>
                <a href="/user/resend-verification" class="text-decoration-none text-muted"><t key="salon.account.resend_link">Doğrulama maili gelmedi</t></a>
            </div>
            <div class="text-center mt-3">
                <a href="/user/register" id="registerLink" class="small"><t key="salon.account.no_account">Hesabınız yok mu?</t> <strong><t key="salon.publicsalon.auto.kayit_olun">Kayıt olun</t></strong></a>
            </div>
            <div class="text-center mt-2">
                <a href="/discover" class="small text-muted"><i class="bi bi-search me-1"></i><t key="salon.publicsalon.discover_salons">Salonları Keşfet</t></a>
            </div>
        </div>
    </div>
    <script>
        var _returnUrl = new URLSearchParams(window.location.search).get('returnUrl') || '/user/panel';
        function getStoredPlatformToken() {
            var token = localStorage.getItem('platformToken');
            if (!token || token === 'null' || token === 'undefined') {
                localStorage.removeItem('platformToken');
                localStorage.removeItem('platformUser');
                return '';
            }
            return token;
        }
        if (getStoredPlatformToken()) window.location.href = _returnUrl;

        function normalizePhoneValue() {
            var code = document.getElementById('phoneCountry').value;
            var raw = document.getElementById('phone').value.replace(/[\s\-\(\)]/g, '').replace(/\D/g, '');
            if (raw.startsWith('0')) raw = raw.substring(1);
            return code + raw;
        }

        async function doLogin() {
            var btn = document.getElementById('loginBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>@T("salon.publicsalon.auto.giris_yapiliyor", "Giriş yapılıyor...")';
            document.getElementById('error-msg').classList.add('d-none');

            try {
                var resp = await fetch('/public-proxy/platform/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        phone: normalizePhoneValue(),
                        password: document.getElementById('password').value
                    })
                });
                var data = await resp.json();
                if (resp.ok && !data.token) throw new Error(data.message || '@T("salon.publicsalon.login_failed", "Giriş başarısız.")');
                if (!resp.ok) throw new Error(data.message || '@T("salon.publicsalon.login_failed", "Giriş başarısız.")');
                localStorage.setItem('platformToken', data.token);
                localStorage.setItem('platformUser', JSON.stringify(data.user));
                window.location.href = _returnUrl;
            } catch (e) {
                document.getElementById('error-msg').textContent = e.message;
                document.getElementById('error-msg').classList.remove('d-none');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-box-arrow-in-right me-1"></i>@T("salon.publicsalon.auto.giris_yap", "Giriş Yap")';
            }
        }
    
        // Kayıt ol linkine returnUrl aktar
        var regLink = document.getElementById('registerLink');
        if (regLink && _returnUrl !== '/user/panel') regLink.href = '/user/register?returnUrl=' + encodeURIComponent(_returnUrl);
    </script>
</body>
</html>
