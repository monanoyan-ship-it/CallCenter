@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    Layout = null;
    var pageLang = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Query["returnUrl"].ToString();
    var isBookingReturn = returnUrl.Contains("/book", StringComparison.OrdinalIgnoreCase);
    string T(string key, string fallback) => Translation.T(key, fallback);
    string ActionT(string key, string fallback) => T(key, fallback).Trim().TrimEnd(';').Trim();
    var loginButtonText = isBookingReturn
        ? ActionT("salon.login.booking_btn", "Randevuya devam et")
        : ActionT("salon.login.btn", "Giriş Yap");
    var loginLoadingText = T("salon.publicsalon.auto.giris_yapiliyor", "Giriş yapılıyor...");
}
<!DOCTYPE html>
<html lang="@pageLang">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@T("salon.publicsalon.auto.giris_corplynk_salon", "Giriş - CorpLynk Salon")</title>
    <link href="/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: linear-gradient(135deg, #2d1b3d 0%, #1a1028 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .auth-card { background: #fff; border-radius: 16px; padding: 2rem; max-width: 400px; width: 100%; box-shadow: 0 8px 32px rgba(0,0,0,.2); }
    </style>
</head>
<body>
    <div style="position:absolute;top:10px;right:10px;">
        @await Html.PartialAsync("_LanguageMenu", "auth")
    </div>
    <div class="auth-card">
        <div class="text-center mb-4">
            <i class="bi bi-scissors" style="font-size:2rem; color:#6f42c1;"></i>
            <h5 class="mt-2">CorpLynk <span style="color:#ce93d8;"><t key="salon.publicsalon.auto.salon">Salon</t></span></h5>
            <p class="text-muted small"><t key="salon.login.subtitle">Sign in to your account</t></p>
        </div>
        @if (isBookingReturn)
        {
            <div class="alert alert-info py-2 small">
                <i class="bi bi-calendar-check me-1"></i><t key="salon.login.booking_required">Randevu oluşturmak için müşteri hesabınızla giriş yapın. Girişten sonra randevu adımına geri döneceksiniz.</t>
            </div>
        }
        <div id="login-form" data-login-failed="@T("salon.publicsalon.login_failed", "Giriş başarısız.")">
            <div class="mb-3">
                <label class="form-label small"><t key="salon.login.phone">Phone</t></label>
                <div class="input-group">
                    <select id="phoneCountry" class="form-select" style="max-width:120px;">
                        <option value="+90" selected>🇹🇷 +90</option>
                        <option value="+49">🇩🇪 +49</option>
                        <option value="+44">🇬🇧 +44</option>
                        <option value="+1">🇺🇸 +1</option>
                        <option value="+33">🇫🇷 +33</option>
                        <option value="+31">🇳🇱 +31</option>
                        <option value="+43">🇦🇹 +43</option>
                        <option value="+41">🇨🇭 +41</option>
                        <option value="+46">🇸🇪 +46</option>
                        <option value="+32">🇧🇪 +32</option>
                        <option value="+7">🇷🇺 +7</option>
                        <option value="+971">🇦🇪 +971</option>
                    </select>
                    <input type="tel" class="form-control" id="phone" placeholder="5XX XXX XX XX" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label small"><t key="salon.login.password">Password</t></label>
                <input type="password" class="form-control" id="password" />
            </div>
            <div id="error-msg" class="alert alert-danger py-1 small d-none"></div>
            <button class="btn btn-primary w-100" id="loginBtn" type="button"
                    data-idle-text="@loginButtonText"
                    data-loading-text="@loginLoadingText">
                <i class="bi bi-box-arrow-in-right me-1"></i><span class="btn-text">@loginButtonText</span>
            </button>
            <div class="d-flex justify-content-between mt-3 small">
                <a href="/user/forgot-password" class="text-decoration-none text-muted"><t key="salon.account.forgot_link">Şifremi unuttum</t></a>
                <a href="/user/resend-verification" class="text-decoration-none text-muted"><t key="salon.account.resend_link">Doğrulama maili gelmedi</t></a>
            </div>
            <div class="text-center mt-3">
                <a href="/user/register" id="registerLink" class="small"><t key="salon.account.no_account">Hesabınız yok mu?</t> <strong><t key="salon.publicsalon.auto.kayit_olun">Kayıt olun</t></strong></a>
            </div>
            <div class="text-center mt-2">
                <a href="/discover" class="small text-muted"><i class="bi bi-search me-1"></i><t key="salon.publicsalon.discover_salons">Salonları Keşfet</t></a>
            </div>
        </div>
    </div>
    <script src="~/js/PublicAuthCommon.js" asp-append-version="true"></script>
    <script src="~/js/PublicLogin.js" asp-append-version="true"></script>
</body>
</html>
