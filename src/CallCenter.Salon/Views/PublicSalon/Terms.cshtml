@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    Layout = null;
    var pageLang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    string T(string key, string fallback) => Translation.T(key, fallback);
}
<!DOCTYPE html>
<html lang="@pageLang">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@T("salon.legal.terms.title", "Kullanım Koşulları") - CorpLynk Salon</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: #f8f9fa; font-family: 'Segoe UI', system-ui, sans-serif; }
        .content-card { background: #fff; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,.06); }
        h2 { color: #7b1fa2; }
        h3 { color: #333; font-size: 1.1rem; }
    </style>
</head>
<body>
    <div class="container py-4" style="max-width: 800px;">
        <a href="/" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left me-1"></i>@T("salon.legal.home", "Ana Sayfa")</a>
        <div class="content-card p-4 mt-3">
            <h2 class="mb-4">@T("salon.legal.terms.title", "Kullanım Koşulları")</h2>
            <p class="text-muted small">@T("salon.legal.last_updated", "Son güncelleme: 12 Nisan 2026")</p>

            <h3 class="mt-4">@T("salon.legal.terms.s1.title", "1. Hizmet Tanımı")</h3>
            <p>@T("salon.legal.terms.s1.p1", "CorpLynk Salon, salon işletmecileri ile müşterilerini buluşturan bir online randevu ve salon yönetim platformudur. Platform üzerinden salon keşfedebilir, randevu alabilir ve üyelik programlarından faydalanabilirsiniz.")</p>

            <h3 class="mt-4">@T("salon.legal.terms.s2.title", "2. Hesap Oluşturma")</h3>
            <p>@T("salon.legal.terms.s2.p1", "Platform hizmetlerinden yararlanmak için bir hesap oluşturmanız gerekmektedir. Hesap oluşturma sırasında verdiğiniz bilgilerin doğru ve güncel olması sizin sorumluluğunuzdadır. Hesabınızın güvenliğinden siz sorumlusunuz.")</p>

            <h3 class="mt-4">@T("salon.legal.terms.s3.title", "3. Randevu ve İptal")</h3>
            <ul>
                <li>@T("salon.legal.terms.s3.i1", "Randevular salon tarafından onaylanmadan kesinleşmez.")</li>
                <li>@T("salon.legal.terms.s3.i2", "Randevu iptali ve gelmeme politikaları salon tarafından belirlenir.")</li>
                <li>@T("salon.legal.terms.s3.i3", "Geç iptal veya gelmeme durumunda salon tarafından belirlenen ücretler uygulanabilir.")</li>
            </ul>

            <h3 class="mt-4">@T("salon.legal.terms.s4.title", "4. Ödeme")</h3>
            <p>@T("salon.legal.terms.s4.p1", "Platform üzerinden yapılan ödemeler lisanslı ödeme kuruluşları aracılığıyla gerçekleştirilir. CorpLynk, ödeme bilgilerinizi, kredi kartı numarası ve CVV dahil olmak üzere hiçbir şekilde saklamaz.")</p>

            <h3 class="mt-4">@T("salon.legal.terms.s5.title", "5. Salon Üyeliğinden Ayrılma")</h3>
            <p>@T("salon.legal.terms.s5.p1", "Herhangi bir salonun üyeliğinden istediğiniz zaman ayrılabilirsiniz. Ayrılma sonrasında o salon kişisel bilgilerinize erişemez.")</p>

            <h3 class="mt-4">@T("salon.legal.terms.s6.title", "6. Hesap Silme")</h3>
            <p>@T("salon.legal.terms.s6.p1", "Hesabınızı istediğiniz zaman silebilirsiniz. Hesap silme işlemi geri alınamaz. Yasal saklama yükümlülüğü olan veriler kanuni süreler dolana kadar anonim olarak saklanır.")</p>

            <h3 class="mt-4">@T("salon.legal.terms.s7.title", "7. Sorumluluk")</h3>
            <p>@T("salon.legal.terms.s7.p1", "CorpLynk, salonlar tarafından sunulan hizmetlerin kalitesi, zamanlılığı veya uygunluğu konusunda sorumluluk kabul etmez. Platform yalnızca salon ile müşteri arasında iletişim ve randevu altyapısı sağlar.")</p>

            <h3 class="mt-4">@T("salon.legal.terms.s8.title", "8. Değişiklikler")</h3>
            <p>@T("salon.legal.terms.s8.p1", "Bu koşullar gerektiğinde güncellenebilir. Önemli değişikliklerde kullanıcılara bildirim yapılır.")</p>

            <h3 class="mt-4">@T("salon.legal.terms.s9.title", "9. İletişim")</h3>
            <p>@T("salon.legal.terms.s9.p1", "Sorularınız için:") <strong>info@corplynk.com</strong></p>
        </div>
        <div class="text-center mt-4">
            <button onclick="window.history.back()" class="btn btn-outline-primary btn-sm"><i class="bi bi-arrow-left me-1"></i>@T("salon.legal.back", "Geri Dön")</button>
        </div>
    </div>
</body>
</html>
