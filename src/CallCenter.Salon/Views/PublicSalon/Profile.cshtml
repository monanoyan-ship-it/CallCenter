@{
    Layout = null;
    var slug = (string)ViewData["Slug"]!;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Salon Profili</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: #f5f5f5; font-family: 'Segoe UI', system-ui, sans-serif; }
        .hero { background: linear-gradient(135deg, #2d1b3d 0%, #4a1a6b 100%); color: #fff; padding: 3rem 0; }
        .hero .logo { width: 80px; height: 80px; background: rgba(255,255,255,.15); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; }
        .service-card { transition: .15s; cursor: default; }
        .service-card:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,0,0,.1) !important; }
        .category-header { border-left: 3px solid #7b1fa2; padding-left: .75rem; }
        .working-hours td { padding: .25rem .5rem; font-size: .85rem; }
        .btn-book { background: #7b1fa2; border: none; color: #fff; }
        .btn-book:hover { background: #6a1b9a; color: #fff; }
        .social-link { width: 36px; height: 36px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: rgba(255,255,255,.15); color: #fff; text-decoration: none; transition: .15s; }
        .social-link:hover { background: rgba(255,255,255,.3); color: #fff; }
        .plan-card { transition: .2s; border: 2px solid transparent; }
        .plan-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,.12) !important; }
        .plan-card.selected { border-color: #7b1fa2; }
        .plan-badge { font-size: .65rem; padding: .2rem .5rem; }
    </style>
</head>
<body>
    <div id="public-salon-vm">
        <!-- ko if: loaded() && !notFound() -->

        <!-- Hero -->
        <div class="hero">
            <div class="container">
                <div class="d-flex align-items-center gap-4">
                    <div class="logo">
                        <i class="bi bi-scissors"></i>
                    </div>
                    <div>
                        <h1 class="mb-1 fw-bold" data-bind="text: salon().salonName"></h1>
                        <!-- ko if: salon().description -->
                        <p class="mb-2 opacity-75" data-bind="text: salon().description"></p>
                        <!-- /ko -->
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <!-- ko if: salon().phone -->
                            <span class="badge bg-light text-dark"><i class="bi bi-telephone me-1"></i><span data-bind="text: salon().phone"></span></span>
                            <!-- /ko -->
                            <!-- ko if: salon().city -->
                            <span class="badge bg-light text-dark"><i class="bi bi-geo-alt me-1"></i><span data-bind="text: (salon().district ? salon().district + ', ' : '') + salon().city"></span></span>
                            <!-- /ko -->
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <!-- ko if: salon().instagramHandle -->
                            <a class="social-link" data-bind="attr: { href: 'https://instagram.com/' + salon().instagramHandle.replace('@@','') }" target="_blank"><i class="bi bi-instagram"></i></a>
                            <!-- /ko -->
                            <!-- ko if: salon().facebookUrl -->
                            <a class="social-link" data-bind="attr: { href: salon().facebookUrl }" target="_blank"><i class="bi bi-facebook"></i></a>
                            <!-- /ko -->
                            <!-- ko if: salon().googleMapsUrl -->
                            <a class="social-link" data-bind="attr: { href: salon().googleMapsUrl }" target="_blank"><i class="bi bi-geo-alt-fill"></i></a>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="container py-4">
            <div class="row g-4">
                <!-- Sol: Dinamik bolumler -->
                <div class="col-lg-8">
                    <!-- ko foreach: orderedSections -->

                    <!-- Hizmetler -->
                    <!-- ko if: key === 'services' && $parent.salon().showServices !== false -->
                    <div class="mb-4" id="section-services">
                        <h4 class="mb-3"><i class="bi bi-list-check me-2"></i>Hizmetlerimiz</h4>
                        <!-- ko foreach: $parent.salon().serviceCategories -->
                        <div class="mb-4">
                            <h6 class="category-header mb-3" data-bind="style: { borderColor: color || '#7b1fa2' }">
                                <i data-bind="attr: { 'class': iconClass || 'bi bi-tag' }, style: { color: color || '#7b1fa2' }" class="me-2"></i>
                                <span data-bind="text: name"></span>
                            </h6>
                            <div class="row g-2">
                                <!-- ko foreach: services -->
                                <div class="col-sm-6">
                                    <div class="card border-0 shadow-sm service-card">
                                        <div class="card-body py-2 px-3 d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="fw-semibold small" data-bind="text: name"></div>
                                                <small class="text-muted" data-bind="text: durationMinutes + ' dk'"></small>
                                            </div>
                                            <span class="fw-bold text-primary" data-bind="text: price.toLocaleString('tr-TR') + ' TL'"></span>
                                        </div>
                                    </div>
                                </div>
                                <!-- /ko -->
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>
                    <!-- /ko -->

                    <!-- Uyelik Planlari -->
                    <!-- ko if: key === 'memberships' && $parent.salon().showMemberships !== false -->
                    <div class="mb-4" id="section-memberships">
                        <h4 class="mb-3"><i class="bi bi-award me-2"></i>Uyelik Planlari</h4>
                        <!-- ko if: $parent.membershipPlans().length === 0 -->
                        <p class="text-muted small">Henuz uyelik plani tanimlanmamis.</p>
                        <!-- /ko -->
                        <div class="row g-3">
                            <!-- ko foreach: $parent.membershipPlans -->
                            <div class="col-md-6 col-lg-4">
                                <div class="card border-0 shadow-sm plan-card h-100" data-bind="css: { selected: $parent.selectedPlanId() === id }, click: function() { $parent.selectedPlanId(id); }">
                                    <div class="card-body text-center py-4">
                                        <i class="fs-1 d-block mb-2" data-bind="attr: { 'class': iconClass || 'bi bi-star' }, style: { color: color || '#7b1fa2' }"></i>
                                        <h5 class="fw-bold" data-bind="text: name"></h5>
                                        <!-- ko if: description -->
                                        <p class="text-muted small mb-3" data-bind="text: description"></p>
                                        <!-- /ko -->
                                        <div class="mb-3">
                                            <span class="fs-3 fw-bold" data-bind="text: monthlyPrice.toLocaleString('tr-TR')"></span>
                                            <span class="text-muted">TL/ay</span>
                                        </div>
                                        <div class="d-flex flex-column gap-1">
                                            <!-- ko if: discountPercent > 0 -->
                                            <span class="plan-badge badge bg-success-subtle text-success">%<span data-bind="text: discountPercent"></span> indirim</span>
                                            <!-- /ko -->
                                            <!-- ko if: freeSessionsPerMonth > 0 -->
                                            <span class="plan-badge badge bg-info-subtle text-info"><span data-bind="text: freeSessionsPerMonth"></span> ucretsiz seans/ay</span>
                                            <!-- /ko -->
                                            <!-- ko if: priorityBooking -->
                                            <span class="plan-badge badge bg-warning-subtle text-warning">Oncelikli randevu</span>
                                            <!-- /ko -->
                                        </div>
                                        <button class="btn btn-book btn-sm mt-3 px-4" data-bind="click: function() { $parents[1].openSignup(id, name); }">
                                            <i class="bi bi-person-plus me-1"></i>Uye Ol
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <!-- /ko -->
                        </div>
                    </div>
                    <!-- /ko -->

                    <!-- /ko -->
                </div>

                <!-- Sag: Bilgiler + Randevu -->
                <div class="col-lg-4">
                    <!-- Randevu butonu -->
                    <!-- ko if: salon().showBooking !== false -->
                    <a class="btn btn-book w-100 py-3 mb-3 fs-5" data-bind="attr: { href: '/salon/' + salon().slug + '/book' }">
                        <i class="bi bi-calendar-check me-2"></i>Online Randevu Al
                    </a>
                    <!-- /ko -->

                    <!-- Calisma Saatleri -->
                    <!-- ko if: salon().showHours !== false && workingHours().length > 0 -->
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white fw-semibold small"><i class="bi bi-clock me-2"></i>Calisma Saatleri</div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <tbody data-bind="foreach: workingHours">
                                    <tr data-bind="css: { 'table-active fw-semibold': isToday }">
                                        <td data-bind="text: day"></td>
                                        <td class="text-end" data-bind="text: hours"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- /ko -->

                    <!-- Adres -->
                    <!-- ko if: salon().showContact !== false && salon().address -->
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white fw-semibold small"><i class="bi bi-geo-alt me-2"></i>Adres</div>
                        <div class="card-body small" data-bind="text: salon().address"></div>
                    </div>
                    <!-- /ko -->

                    <!-- Iletisim -->
                    <!-- ko if: salon().showContact !== false -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white fw-semibold small"><i class="bi bi-telephone me-2"></i>Iletisim</div>
                        <div class="card-body small">
                            <!-- ko if: salon().phone -->
                            <div><i class="bi bi-telephone me-2"></i><a data-bind="text: salon().phone, attr: { href: 'tel:' + salon().phone }" class="text-decoration-none"></a></div>
                            <!-- /ko -->
                            <!-- ko if: salon().email -->
                            <div class="mt-1"><i class="bi bi-envelope me-2"></i><a data-bind="text: salon().email, attr: { href: 'mailto:' + salon().email }" class="text-decoration-none"></a></div>
                            <!-- /ko -->
                            <!-- ko if: salon().website -->
                            <div class="mt-1"><i class="bi bi-globe me-2"></i><a data-bind="text: salon().website, attr: { href: salon().website }" class="text-decoration-none" target="_blank"></a></div>
                            <!-- /ko -->
                        </div>
                    </div>
                    <!-- /ko -->
                </div>
            </div>
        </div>

        <footer class="text-center py-3 text-muted small border-top mt-4">
            <a href="https://corplynk.com" class="text-decoration-none text-muted">CorpLynk</a> ile olusturuldu
        </footer>

        <!-- /ko -->

        <!-- ko if: notFound() -->
        <div class="d-flex align-items-center justify-content-center" style="min-height:100vh;">
            <div class="text-center">
                <i class="bi bi-shop" style="font-size:4rem;opacity:.3;"></i>
                <h4 class="mt-3">Salon bulunamadi</h4>
                <p class="text-muted">Bu adres aktif degil veya henuz yayinlanmamis.</p>
                <a href="https://corplynk.com" class="btn btn-outline-primary btn-sm">Ana Sayfaya Don</a>
            </div>
        </div>
        <!-- /ko -->
    </div>

    <!-- Uyelik Basvuru Modali -->
    <div class="modal fade" id="signupModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header py-2" style="background: linear-gradient(135deg, #2d1b3d 0%, #4a1a6b 100%); color: #fff;">
                    <h6 class="modal-title"><i class="bi bi-person-plus me-2"></i>Uye Ol</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="signup-vm">
                    <div class="text-center mb-3">
                        <span class="badge bg-purple text-white px-3 py-2" style="background:#7b1fa2;" data-bind="text: signupPlanName"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Ad Soyad *</label>
                        <input type="text" class="form-control form-control-sm" data-bind="value: signupForm.fullName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Telefon *</label>
                        <input type="tel" class="form-control form-control-sm" placeholder="05XX XXX XX XX" data-bind="value: signupForm.phone" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">E-posta</label>
                        <input type="email" class="form-control form-control-sm" data-bind="value: signupForm.email" />
                    </div>
                    <button class="btn btn-book w-100" data-bind="click: submitSignup, disable: isSubmitting">
                        <span data-bind="visible: isSubmitting" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSubmitting()"></i>Basvuruyu Gonder
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/knockout@3.5.1/build/output/knockout-latest.min.js"></script>
    <script>
        var salonSlug = '@slug';

        function PublicSalonViewModel() {
            var self = this;
            self.salon = ko.observable({});
            self.loaded = ko.observable(false);
            self.notFound = ko.observable(false);
            self.workingHours = ko.observableArray([]);
            self.membershipPlans = ko.observableArray([]);
            self.selectedPlanId = ko.observable(null);

            // Signup
            self.signupPlanId = ko.observable(null);
            self.signupPlanName = ko.observable('');
            self.isSubmitting = ko.observable(false);
            self.signupForm = {
                fullName: ko.observable(''),
                phone: ko.observable(''),
                email: ko.observable('')
            };

            var signupModal;

            // Bolum siralama
            var defaultOrder = ['services', 'memberships'];
            self.orderedSections = ko.computed(function () {
                var s = self.salon();
                if (!s || !s.slug) return [];
                var order = defaultOrder;
                if (s.sectionOrderJson) {
                    try { order = JSON.parse(s.sectionOrderJson); } catch (e) {}
                }
                return order.map(function (key) { return { key: key }; });
            });

            var dayNames = { mon: 'Pazartesi', tue: 'Sali', wed: 'Carsamba', thu: 'Persembe', fri: 'Cuma', sat: 'Cumartesi', sun: 'Pazar' };
            var dayOrder = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];
            var todayIdx = (new Date().getDay() + 6) % 7;

            fetch('/proxy/salon/' + salonSlug)
                .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
                .then(function (data) {
                    self.salon(data);
                    document.title = data.salonName + ' | CorpLynk Salon';

                    if (data.workingHoursJson) {
                        try {
                            var h = JSON.parse(data.workingHoursJson);
                            var list = [];
                            dayOrder.forEach(function (key, idx) {
                                list.push({ day: dayNames[key], hours: h[key] || 'Kapali', isToday: idx === todayIdx });
                            });
                            self.workingHours(list);
                        } catch (e) {}
                    }

                    // Uyelik planlarini yukle
                    if (data.showMemberships !== false) {
                        fetch('/proxy/salon/' + salonSlug + '/memberships')
                            .then(function (r) { return r.ok ? r.json() : []; })
                            .then(function (plans) { self.membershipPlans(plans); });
                    }

                    self.loaded(true);
                })
                .catch(function () { self.notFound(true); });

            self.openSignup = function (planId, planName) {
                self.signupPlanId(planId);
                self.signupPlanName(planName);
                self.signupForm.fullName('');
                self.signupForm.phone('');
                self.signupForm.email('');
                if (!signupModal) signupModal = new bootstrap.Modal(document.getElementById('signupModal'));
                signupModal.show();
            };

            self.submitSignup = function () {
                var name = self.signupForm.fullName();
                var phone = self.signupForm.phone();
                if (!name || !phone) { alert('Ad ve telefon zorunludur.'); return; }

                self.isSubmitting(true);
                fetch('/proxy/salon/' + salonSlug + '/membership-signup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        planId: self.signupPlanId(),
                        fullName: name,
                        phone: phone,
                        email: self.signupForm.email() || null
                    })
                })
                .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
                .then(function (res) {
                    self.isSubmitting(false);
                    if (res.ok && res.data.success) {
                        signupModal.hide();
                        alert(res.data.message || 'Uyelik basvurunuz alindi!');
                    } else {
                        alert(res.data || 'Bir hata olustu.');
                    }
                })
                .catch(function () { self.isSubmitting(false); alert('Baglanti hatasi.'); });
            };
        }

        ko.applyBindings(new PublicSalonViewModel(), document.getElementById('public-salon-vm'));
    </script>
</body>
</html>
