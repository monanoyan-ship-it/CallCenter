@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    Layout = null;
    var slug = (string)ViewData["Slug"]!;
    var profileLang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var profileTranslations = await Translation.GetAllAsync(profileLang);
    var profileTranslationsJson = System.Text.Json.JsonSerializer.Serialize(profileTranslations);
}
<!DOCTYPE html>
<html lang="@profileLang">
<head>
    <meta charset="utf-8" />
    @{ var salonFavicon = ViewData["SalonFavicon"] as string; }
    @if (salonFavicon != null) {
    <link rel="icon" href="@salonFavicon" />
    } else {
    <link rel="icon" type="image/png" href="/favicon.png" />
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @{
        var salonName = ViewData["SalonName"] as string ?? "Salon";
        var salonDesc = ViewData["SalonDescription"] as string ?? Translation.T("salon.profile.meta.default_desc", "Online randevu al");
        var salonCity = (ViewData["SalonCity"] as string)?.Trim();
        var salonDistrict = (ViewData["SalonDistrict"] as string)?.Trim();
        var salonLogo = ViewData["SalonLogo"] as string;
        var location = "";
        if (!string.IsNullOrWhiteSpace(salonDistrict) && !string.IsNullOrWhiteSpace(salonCity))
            location = $"{salonDistrict}, {salonCity}";
        else if (!string.IsNullOrWhiteSpace(salonCity))
            location = salonCity;
        else if (!string.IsNullOrWhiteSpace(salonDistrict))
            location = salonDistrict;
        var hasLocation = !string.IsNullOrWhiteSpace(location);
        var titleSuffix = Translation.T("salon.profile.meta.title_suffix", "Online Randevu");
        var metaAction = Translation.T("salon.profile.meta.action", "CorpLynk Salon ile online randevu al.");
        var pageTitle = hasLocation ? $"{salonName} - {location} | {titleSuffix}" : $"{salonName} | {titleSuffix}";
        var metaDesc = hasLocation ? $"{salonName} - {location}. {salonDesc}. {metaAction}" : $"{salonName}. {salonDesc}. {metaAction}";
    }
    <title>@pageTitle</title>
    <meta name="description" content="@metaDesc" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@metaDesc" />
    <meta property="og:type" content="business.business" />
    <meta property="og:url" content="https://sln.corplynk.com/salon/@slug" />
    @if (salonLogo != null) {
    <meta property="og:image" content="@salonLogo" />
    }
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href="https://sln.corplynk.com/salon/@slug" />
    <link href="/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="/lib/toastr/toastr.min.css" rel="stylesheet" />
    <link href="~/lib/leaflet/leaflet.css" rel="stylesheet" asp-append-version="true" />
    <style>
        body { background: #f5f5f5; font-family: 'Segoe UI', system-ui, sans-serif; }
        .hero { background: linear-gradient(135deg, #2d1b3d 0%, #4a1a6b 100%); color: #fff; padding: 3rem 0; position:relative; overflow:hidden; }
        .hero.has-cover { padding: 5rem 0 3rem; }
        .hero-cover { position:absolute; inset:0; background-size: cover; background-position: center; opacity: .25; z-index:0; }
        .hero > .container { position:relative; z-index:1; }
        .hero .logo { width: 80px; height: 80px; background: rgba(255,255,255,.15); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; overflow:hidden; border: 3px solid rgba(255,255,255,.3); }
        .hero .logo img { width:100%; height:100%; object-fit: cover; }
        .service-card { transition: .15s; cursor: default; }
        .service-card:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,0,0,.1) !important; }
        .category-header { border-left: 3px solid #7b1fa2; padding-left: .75rem; }
        .working-hours td { padding: .25rem .5rem; font-size: .85rem; }
        .btn-book { background: #7b1fa2; border: none; color: #fff; }
        .btn-book:hover { background: #6a1b9a; color: #fff; }
        .social-link { width: 36px; height: 36px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: rgba(255,255,255,.15); color: #fff; text-decoration: none; transition: .15s; }
        .social-link:hover { background: rgba(255,255,255,.3); color: #fff; }
        .plan-card { transition: .2s; border: 2px solid transparent; }
        .plan-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,.12) !important; }
        .plan-card.selected { border-color: #7b1fa2; }
        .plan-badge { font-size: .65rem; padding: .2rem .5rem; }
        .accordion-button:not(.collapsed) { background: #f8f5fb; color: #4a1a6b; box-shadow: none; }
        .accordion-button:focus { box-shadow: none; }
        .accordion-button::after { width: .9rem; height: .9rem; background-size: .9rem; }
        .gallery-photo { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; }
        .branch-kicker { font-size: .8rem; letter-spacing: 0; opacity: .8; }
        .profile-trust-strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .75rem; margin-top: 1.75rem; }
        .profile-trust-item { background: rgba(255,255,255,.13); border: 1px solid rgba(255,255,255,.24); border-radius: 8px; padding: .75rem; min-height: 88px; backdrop-filter: blur(6px); }
        .profile-trust-item i { font-size: 1.05rem; opacity: .95; }
        .profile-trust-item strong { display: block; margin-top: .35rem; font-size: .88rem; line-height: 1.2; }
        .profile-trust-item small { display: block; margin-top: .2rem; color: rgba(255,255,255,.76); line-height: 1.25; }
        @@media (max-width: 991.98px) {
            .profile-trust-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        @@media (max-width: 575.98px) {
            .profile-trust-strip { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div id="profile-data" hidden
         data-lang="@profileLang"
         data-slug="@slug"
         data-translations="@profileTranslationsJson"></div>
    <div id="public-salon-vm">
        <!-- ko if: loaded() && !notFound() -->

        <!-- Hero -->
        <div class="hero" data-bind="css: { 'has-cover': !!salon().coverImageUrl }">
            <!-- ko if: salon().coverImageUrl -->
            <div class="hero-cover" data-bind="style: { backgroundImage: 'url(' + salon().coverImageUrl + ')' }"></div>
            <!-- /ko -->
            <div class="container">
                <div class="d-flex align-items-center gap-4">
                    <div class="logo">
                        <!-- ko if: salon().logoUrl -->
                        <img data-bind="attr: { src: salon().logoUrl, alt: salon().salonName }" />
                        <!-- /ko -->
                        <!-- ko ifnot: salon().logoUrl -->
                        <i class="bi bi-scissors"></i>
                        <!-- /ko -->
                    </div>
                    <div>
                        <!-- ko if: salon().branchName && salon().branchName !== salon().salonName && !salon().isHeadquarter -->
                        <div class="branch-kicker mb-1" data-bind="text: salon().salonName"></div>
                        <!-- /ko -->
                        <h1 class="mb-1 fw-bold" data-bind="text: (salon().branchName && salon().branchName !== salon().salonName && !salon().isHeadquarter) ? salon().branchName : salon().salonName"></h1>
                        <!-- ko if: salon().description -->
                        <p class="mb-2 opacity-75" data-bind="text: salon().description"></p>
                        <!-- /ko -->
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <!-- ko if: salon().phone -->
                            <span class="badge bg-light text-dark"><i class="bi bi-telephone me-1"></i><span data-bind="text: salon().phone"></span></span>
                            <!-- /ko -->
                            <!-- ko if: salon().city -->
                            <span class="badge bg-light text-dark"><i class="bi bi-geo-alt me-1"></i><span data-bind="text: (salon().district ? salon().district + ', ' : '') + salon().city"></span></span>
                            <!-- /ko -->
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <!-- ko if: salon().instagramHandle -->
                            <a class="social-link" data-bind="attr: { href: 'https://instagram.com/' + salon().instagramHandle.replace('@@','') }" target="_blank"><i class="bi bi-instagram"></i></a>
                            <!-- /ko -->
                            <!-- ko if: salon().facebookUrl -->
                            <a class="social-link" data-bind="attr: { href: salon().facebookUrl }" target="_blank"><i class="bi bi-facebook"></i></a>
                            <!-- /ko -->
                            <!-- ko if: salon().googleMapsUrl -->
                            <a class="social-link" data-bind="attr: { href: salon().googleMapsUrl }" target="_blank"><i class="bi bi-geo-alt-fill"></i></a>
                            <!-- /ko -->
                        </div>
                        <!-- Platform User: Müşteri ol butonu -->
                        <div class="mt-3" id="joinSalonArea">
                            <button class="btn btn-light btn-sm" id="btnJoinSalon" style="display:none;" >
                                <i class="bi bi-person-plus me-1"></i><t key="salon.profile.join.customer_button">Bu Salonun Müşterisiyim</t>
                            </button>
                            <span class="badge bg-success" id="alreadyMember" style="display:none;">
                                <i class="bi bi-check-circle me-1"></i><t key="salon.profile.join.member_badge">Üye</t>
                            </span>
                            <a href="/user/login" class="btn btn-outline-light btn-sm" id="btnLoginToJoin" style="display:none;">
                                <i class="bi bi-box-arrow-in-right me-1"></i><t key="salon.profile.join.login_button">Giriş Yap / Üye Ol</t>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="profile-trust-strip" data-bind="foreach: profileTrustItems, visible: profileTrustItems().length > 0" style="display:none;">
                    <div class="profile-trust-item">
                        <i class="bi" data-bind="css: icon"></i>
                        <strong data-bind="text: title"></strong>
                        <small data-bind="text: description"></small>
                    </div>
                </div>
            </div>
        </div>

        <div class="container py-4">
            <div class="row g-4">
                <!-- Sol: Dinamik bolumler -->
                <div class="col-lg-8">
                    <!-- ko foreach: orderedSections -->

                    <!-- Bannerlar -->
                    <!-- ko if: key === 'banners' && $parent.salon().showBanners !== false && $parent.banners().length > 0 -->
                    <div class="mb-4" id="section-banners">
                        <!-- ko if: $parent.banners().length === 1 -->
                        <div data-bind="with: $parent.banners()[0]">
                            <!-- ko if: link -->
                            <a data-bind="attr: { href: link }" target="_blank">
                                <img data-bind="attr: { src: url, alt: title || 'Banner' }" class="w-100 rounded shadow-sm" style="max-height:300px;object-fit:cover;" />
                            </a>
                            <!-- /ko -->
                            <!-- ko if: !link -->
                            <img data-bind="attr: { src: url, alt: title || 'Banner' }" class="w-100 rounded shadow-sm" style="max-height:300px;object-fit:cover;" />
                            <!-- /ko -->
                        </div>
                        <!-- /ko -->
                        <!-- ko if: $parent.banners().length > 1 -->
                        <div id="bannerCarousel" class="carousel slide shadow-sm rounded overflow-hidden" data-bs-ride="carousel">
                            <div class="carousel-indicators" data-bind="foreach: $parent.banners">
                                <button type="button" data-bs-target="#bannerCarousel" data-bind="attr: { 'data-bs-slide-to': $index() }, css: { active: $index() === 0 }"></button>
                            </div>
                            <div class="carousel-inner" data-bind="foreach: $parent.banners">
                                <div class="carousel-item" data-bind="css: { active: $index() === 0 }">
                                    <!-- ko if: link -->
                                    <a data-bind="attr: { href: link }" target="_blank">
                                        <img data-bind="attr: { src: url, alt: title || 'Banner' }" class="d-block w-100" style="max-height:300px;object-fit:cover;" />
                                    </a>
                                    <!-- /ko -->
                                    <!-- ko if: !link -->
                                    <img data-bind="attr: { src: url, alt: title || 'Banner' }" class="d-block w-100" style="max-height:300px;object-fit:cover;" />
                                    <!-- /ko -->
                                    <!-- ko if: title -->
                                    <div class="carousel-caption d-none d-md-block">
                                        <h6 class="mb-0" data-bind="text: title"></h6>
                                    </div>
                                    <!-- /ko -->
                                </div>
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon"></span>
                            </button>
                        </div>
                        <!-- /ko -->
                    </div>
                    <!-- /ko -->

                    <!-- Galeri -->
                    <!-- ko if: key === 'gallery' && $parent.galleryImages().length > 0 -->
                    <div class="mb-4" id="section-gallery">
                        <h4 class="mb-3"><i class="bi bi-images me-2"></i><t key="salon.profile.gallery.title">Salon Atmosferi</t></h4>
                        <div class="row g-2" data-bind="foreach: $parent.galleryImages">
                            <div class="col-6 col-md-4">
                                <img class="gallery-photo shadow-sm" data-bind="attr: { src: $data, alt: $root.t('salon.profile.gallery.image_alt', 'Salon görseli') }" loading="lazy" />
                            </div>
                        </div>
                    </div>
                    <!-- /ko -->

                    <!-- Hizmetler -->
                    <!-- ko if: key === 'services' && $parent.salon().showServices !== false -->
                    <div class="mb-4" id="section-services">
                        <h4 class="mb-3"><i class="bi bi-list-check me-2"></i><t key="salon.profile.services.title">Hizmetlerimiz</t></h4>
<!-- One Cikan 3 Hizmet (accordion acmadan) -->
                        <!-- ko if: $parent.featuredServices().length > 0 -->
                        <div class="row g-2 mb-3">
                            <!-- ko foreach: $parent.featuredServices -->
                            <div class="col-sm-6 col-md-4">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body py-2 px-3">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <div class="fw-semibold small" data-bind="text: name"></div>
                                                <small class="text-muted" data-bind="text: durationMinutes + ' ' + $root.t('salon.common.minute_abbr', 'dk')"></small>
                                            </div>
                                            <span class="fw-bold text-primary small" data-bind="text: price.toLocaleString($root.profileLang || undefined) + ' ' + $root.t('salon.common.currency_abbr', 'TL')"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- /ko -->
                        </div>
                        <h6 class="text-muted small mt-3 mb-2"><t key="salon.profile.services.all">Tüm Hizmetler</t></h6>
                        <!-- /ko -->
                        <div class="accordion" id="servicesAccordion" data-bind="foreach: $parent.salon().serviceCategories">
                            <div class="accordion-item border-0 shadow-sm mb-2" style="border-radius:8px;overflow:hidden;">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed py-2 px-3" type="button"
                                        data-bs-toggle="collapse" data-bind="attr: { 'data-bs-target': '#cat-' + id }">
                                        <i data-bind="attr: { 'class': iconClass || 'bi bi-tag' }, style: { color: color || '#7b1fa2' }" class="me-2"></i>
                                        <span class="fw-semibold small" data-bind="text: name"></span>
                                        <span class="badge bg-light text-muted ms-2" style="font-size:.7rem;" data-bind="text: services.length + ' ' + $root.t('salon.profile.services.count_suffix', 'hizmet')"></span>
                                    </button>
                                </h2>
                                <div class="accordion-collapse collapse" data-bind="attr: { id: 'cat-' + id }">
                                    <div class="accordion-body py-2 px-3">
                                        <div class="row g-2">
                                            <!-- ko foreach: services -->
                                            <div class="col-sm-6">
                                                <div class="d-flex justify-content-between align-items-center py-1 border-bottom" style="border-color:#f0f0f0 !important;">
                                                    <div>
                                                        <div class="fw-medium small" data-bind="text: name"></div>
                                                        <small class="text-muted" data-bind="text: durationMinutes + ' ' + $root.t('salon.common.minute_abbr', 'dk')"></small>
                                                    </div>
                                                    <span class="fw-bold text-primary small" data-bind="text: price.toLocaleString($root.profileLang || undefined) + ' ' + $root.t('salon.common.currency_abbr', 'TL')"></span>
                                                </div>
                                            </div>
                                            <!-- /ko -->
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- /ko -->

                    <!-- Üyelik Planları (salonun kendi müşteri üyelikleri) -->
                    <!-- ko if: key === 'memberships' && $parent.salon().showMemberships !== false && $parent.membershipPlans().length > 0 -->
                    <div class="mb-4" id="section-memberships">
                        <h4 class="mb-1"><i class="bi bi-award me-2"></i><t key="salon.profile.membership.title">Müşteri Üyelikleri</t></h4>
                        <p class="text-muted small mb-3"><t key="salon.profile.membership.desc">Bu planlar salonun kendi müşterilerine sunduğu üyeliklerdir; CorpLynk platform aboneliği değildir.</t></p>
                        <div class="row g-3">
                            <!-- ko foreach: $parent.membershipPlans -->
                            <div class="col-md-6 col-lg-4">
                                <div class="card border-0 shadow-sm plan-card h-100" data-bind="css: { selected: $root.selectedPlanId() === id }, click: function() { $root.selectedPlanId(id); }">
                                    <div class="card-body text-center py-4">
                                        <i class="fs-1 d-block mb-2" data-bind="attr: { 'class': iconClass || 'bi bi-star' }, style: { color: color || '#7b1fa2' }"></i>
                                        <h5 class="fw-bold" data-bind="text: name"></h5>
                                        <!-- ko if: description -->
                                        <p class="text-muted small mb-3" data-bind="text: description"></p>
                                        <!-- /ko -->
                                        <div class="mb-3">
                                            <span class="fs-3 fw-bold" data-bind="text: Number(monthlyPrice || price || 0).toLocaleString($root.profileLang || undefined)"></span>
                                            <span class="text-muted"><t key="salon.common.currency_abbr">TL</t></span>
                                            <div class="small text-muted" data-bind="text: durationType === 1 ? durationDays + ' ' + $root.t('salon.profile.membership.valid_days', 'gün geçerlidir') : $root.t('salon.profile.membership.usage_package', 'Kullanımlık paket')"></div>
                                        </div>
                                        <div class="d-flex flex-column gap-1">
                                            <!-- ko if: discountPercent > 0 -->
                                            <span class="plan-badge badge bg-success-subtle text-success">%<span data-bind="text: discountPercent"></span> <t key="salon.profile.membership.discount_suffix">indirim</t></span>
                                            <!-- /ko -->
                                            <!-- ko if: serviceDetails && serviceDetails.length > 0 -->
                                            <span class="plan-badge badge bg-info-subtle text-info"><t key="salon.profile.membership.service_benefits">Hizmet avantajları dahil</t></span>
                                            <!-- /ko -->
                                            <!-- ko if: priorityBooking -->
                                            <span class="plan-badge badge bg-warning-subtle text-warning"><t key="salon.profile.membership.priority_booking">Öncelikli randevu</t></span>
                                            <!-- /ko -->
                                        </div>
                                        <button class="btn btn-book btn-sm mt-3 px-4" data-bind="click: function() { $root.openSignup(id, name); }, clickBubble: false">
                                            <i class="bi bi-person-plus me-1"></i><t key="salon.profile.membership.join">Üye Ol</t>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <!-- /ko -->
                        </div>
                    </div>
                    <!-- /ko -->

                    <!-- Ekibimiz -->
                    <!-- ko if: key === 'team' && $parent.salon().showTeam !== false -->
                    <div class="mb-4" id="section-team">
                        <h4 class="mb-3"><i class="bi bi-people me-2"></i><t key="salon.public.profile.auto.ekibimiz">Ekibimiz</t></h4>
                        <!-- ko if: $parent.teamMembers().length === 0 -->
                        <p class="text-muted small"><t key="salon.public.profile.auto.ekip_bilgisi_henuz_eklenmemis">Ekip bilgisi henüz eklenmemiş.</t></p>
                        <!-- /ko -->
                        <div class="row g-3" data-bind="foreach: $parent.teamMembers">
                            <div class="col-6 col-md-4 col-lg-3">
                                <div class="card border-0 shadow-sm text-center h-100">
                                    <div class="card-body py-3">
                                        <!-- ko if: photoUrl -->
                                        <img data-bind="attr: { src: photoUrl }" class="rounded-circle mb-2" style="width:64px;height:64px;object-fit:cover;" />
                                        <!-- /ko -->
                                        <!-- ko if: !photoUrl -->
                                        <div class="rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width:64px;height:64px;background:#e8e0f0;">
                                            <i class="bi bi-person fs-3" style="color:#7b1fa2;"></i>
                                        </div>
                                        <!-- /ko -->
                                        <div class="fw-semibold small" data-bind="text: name"></div>
                                        <!-- ko if: specialty || title -->
                                        <small class="text-muted d-block" data-bind="text: specialty || title"></small>
                                        <!-- /ko -->
                                        <!-- Yetenekler — atanmis hizmetler -->
                                        <!-- ko if: services && services.length > 0 -->
                                        <div class="mt-2 d-flex flex-wrap gap-1 justify-content-center">
                                            <!-- ko foreach: services.slice(0, 3) -->
                                            <span class="badge bg-light text-muted" style="font-size:.65rem;font-weight:normal;" data-bind="text: $data"></span>
                                            <!-- /ko -->
                                            <!-- ko if: services.length > 3 -->
                                            <span class="badge bg-light text-muted" style="font-size:.65rem;font-weight:normal;" data-bind="text: '+' + (services.length - 3)"></span>
                                            <!-- /ko -->
                                        </div>
                                        <!-- /ko -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- /ko -->

                    <!-- Yorumlar -->
                    <!-- ko if: key === 'reviews' && $parent.salon().showReviews !== false -->
                    <div class="mb-4" id="section-reviews">
                        <h4 class="mb-3">
                            <i class="bi bi-chat-square-text me-2"></i><t key="salon.profile.reviews.title">Müşteri Yorumları</t>
                            <!-- ko if: $parent.reviewStats().averageRating > 0 -->
                            <span class="ms-2 fs-6">
                                <i class="bi bi-star-fill text-warning"></i>
                                <span data-bind="text: $parent.reviewStats().averageRating"></span>
                                <small class="text-muted" data-bind="text: '(' + $parent.reviewStats().totalCount + ' ' + $root.t('salon.profile.reviews.count_suffix', 'yorum') + ')'"></small>
                            </span>
                            <!-- /ko -->
                        </h4>
                        <!-- ko if: $parent.reviews().length === 0 -->
                        <p class="text-muted small"><t key="salon.profile.reviews.empty">Henüz yorum yapılmamış.</t></p>
                        <!-- /ko -->
                        <div data-bind="foreach: $parent.reviews">
                            <div class="card border-0 shadow-sm mb-2">
                                <div class="card-body py-2 px-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div class="fw-semibold small" data-bind="text: clientName"></div>
                                        <div>
                                            <!-- ko foreach: Array.from({length: rating}, (_, i) => i) -->
                                            <i class="bi bi-star-fill text-warning" style="font-size:.75rem;"></i>
                                            <!-- /ko -->
                                            <!-- ko foreach: Array.from({length: 5 - rating}, (_, i) => i) -->
                                            <i class="bi bi-star text-muted" style="font-size:.75rem;"></i>
                                            <!-- /ko -->
                                        </div>
                                    </div>
                                    <!-- ko if: comment -->
                                    <p class="text-muted small mb-1" data-bind="text: comment"></p>
                                    <!-- /ko -->
                                    <small class="text-muted" style="font-size:.7rem;" data-bind="text: new Date(createdAt).toLocaleDateString($root.profileLang || undefined)"></small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- /ko -->

                    <!-- Harita -->
                    <!-- ko if: key === 'map' && $parent.salon().showMap !== false && $parent.salon().latitude -->
                    <div class="mb-4" id="section-map">
                        <h4 class="mb-3"><i class="bi bi-geo-alt me-2"></i><t key="salon.profile.location.title">Konum</t></h4>
                        <div class="rounded shadow-sm overflow-hidden" id="salonMap" style="height:300px;"></div>
                    </div>
                    <!-- /ko -->

                    <!-- /ko -->
                </div>

                <!-- Sag: Bilgiler + Randevu -->
                <div class="col-lg-4">
                    <!-- Randevu butonu -->
                    <!-- ko if: salon().showBooking !== false -->
                    <a class="btn btn-book w-100 py-3 mb-3 fs-5" data-bind="attr: { href: '/salon/' + salon().slug + '/book' }">
                        <i class="bi bi-calendar-check me-2"></i><t key="salon.profile.book.button">Online Randevu Al</t>
                    </a>
                    <button class="btn btn-outline-purple w-100 py-2 mb-3"
                            style="border:1px solid #7b1fa2;color:#7b1fa2;"
                            data-bind="click: openWaitlist">
                        <i class="bi bi-bell me-1"></i><t key="salon.book.join_waitlist">Bekleme Listesine Ekle</t>
                    </button>
                    <!-- /ko -->

                    <!-- Çalışma Saatleri -->
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white fw-semibold small"><i class="bi bi-share me-2"></i><t key="salon.profile.distribution.title">Paylasim ve QR</t></div>
                        <div class="card-body small">
                            <div class="d-grid gap-2">
                                <button type="button" class="btn btn-outline-primary btn-sm" data-bind="click: shareProfile">
                                    <i class="bi bi-share me-1"></i><t key="salon.profile.distribution.share">Profili Paylas</t>
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-bind="click: copyBookingLink">
                                    <i class="bi bi-link-45deg me-1"></i><t key="salon.profile.distribution.copy_booking">Randevu Linkini Kopyala</t>
                                </button>
                            </div>
                            <div class="text-center mt-3">
                                <img class="img-fluid border rounded p-2 bg-white" style="max-width:160px;"
                                     data-bind="attr: { src: qrCodeUrl, alt: t('salon.profile.distribution.qr_alt', 'Randevu QR') }" />
                                <div class="small text-muted mt-1"><t key="salon.profile.distribution.qr_hint">Instagram, Google ve masaustu afisleri icin</t></div>
                            </div>
                            <label class="form-label small mt-3"><t key="salon.profile.distribution.widget">Web site widget kodu</t></label>
                            <textarea class="form-control form-control-sm" rows="3" readonly data-bind="value: widgetCode, click: copyWidgetCode"></textarea>
                        </div>
                    </div>

                    <!-- ko if: salon().showHours !== false && workingHours().length > 0 -->
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white fw-semibold small"><i class="bi bi-clock me-2"></i><t key="salon.profile.hours.title">Çalışma Saatleri</t></div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <tbody data-bind="foreach: workingHours">
                                    <tr data-bind="css: { 'table-active fw-semibold': isToday }">
                                        <td data-bind="text: day"></td>
                                        <td class="text-end" data-bind="text: hours"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- /ko -->

                    <!-- Adres (address yoksa city/district fallback) -->
                    <!-- ko if: salon().showContact !== false && (salon().address || salon().city) -->
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white fw-semibold small"><i class="bi bi-geo-alt me-2"></i><t key="salon.profile.address.title">Adres</t></div>
                        <div class="card-body small">
                            <div data-bind="text: salon().address || ((salon().district ? salon().district + ', ' : '') + (salon().city || ''))"></div>
                            <!-- ko if: salon().address && salon().city -->
                            <small class="text-muted d-block mt-1" data-bind="text: (salon().district ? salon().district + ' / ' : '') + salon().city"></small>
                            <!-- /ko -->
                        </div>
                    </div>
                    <!-- /ko -->

                    <!-- İletişim -->
                    <!-- ko if: salon().showContact !== false -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white fw-semibold small"><i class="bi bi-telephone me-2"></i><t key="salon.profile.contact.title">İletişim</t></div>
                        <div class="card-body small">
                            <!-- ko if: salon().phone -->
                            <div><i class="bi bi-telephone me-2"></i><a data-bind="text: salon().phone, attr: { href: 'tel:' + salon().phone }" class="text-decoration-none"></a></div>
                            <!-- /ko -->
                            <!-- ko if: salon().email -->
                            <div class="mt-1"><i class="bi bi-envelope me-2"></i><a data-bind="text: salon().email, attr: { href: 'mailto:' + salon().email }" class="text-decoration-none"></a></div>
                            <!-- /ko -->
                            <!-- ko if: salon().website -->
                            <div class="mt-1"><i class="bi bi-globe me-2"></i><a data-bind="text: salon().website, attr: { href: salon().website }" class="text-decoration-none" target="_blank"></a></div>
                            <!-- /ko -->
                        </div>
                    </div>
                    <!-- /ko -->
                </div>
            </div>
        </div>

        <footer class="text-center py-3 text-muted small border-top mt-4">
            <a href="https://corplynk.com" class="text-decoration-none text-muted">CorpLynk</a> <t key="salon.profile.footer.created_with">ile oluşturuldu</t>
        </footer>

        <!-- /ko -->

        <!-- ko if: notFound() -->
        <div class="d-flex align-items-center justify-content-center" style="min-height:100vh;">
            <div class="text-center">
                <i class="bi bi-shop" style="font-size:4rem;opacity:.3;"></i>
                <h4 class="mt-3"><t key="salon.profile.not_found.title">Salon bulunamadı</t></h4>
                <p class="text-muted"><t key="salon.profile.not_found.desc">Bu adres aktif değil veya henüz yayınlanmamış.</t></p>
                <a href="https://corplynk.com" class="btn btn-outline-primary btn-sm"><t key="salon.profile.not_found.home">Ana Sayfaya Dön</t></a>
            </div>
        </div>
        <!-- /ko -->

    <!-- Bekleme Listesi Modali (anonim) -->
    <div class="modal fade" id="waitlistModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2" style="background: linear-gradient(135deg, #2d1b3d 0%, #4a1a6b 100%); color: #fff;">
                    <h6 class="modal-title"><i class="bi bi-bell me-2"></i><t key="salon.book.join_waitlist">Bekleme Listesine Ekle</t></h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        <t key="salon.profile.waitlist.desc">Henüz müşteri kaydınız olmasa da adınızı bırakabilirsiniz. Yer açılırsa salon sizi arar.</t>
                    </p>
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.book.fullname">Ad Soyad *</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: waitlist.fullName" />
                        </div>
                        <div class="col-7">
                            <label class="form-label small"><t key="salon.book.phone">Telefon *</t></label>
                            <input type="tel" class="form-control form-control-sm" placeholder="5XX XXX XX XX" data-bind="value: waitlist.phone" />
                        </div>
                        <div class="col-5">
                            <label class="form-label small"><t key="salon.book.waitlist.time_preference">Saat Tercihi</t></label>
                            <select class="form-select form-select-sm" data-bind="value: waitlist.timeSlot">
                                <option value="Farketmez"><t key="salon.book.waitlist.any_time">Farketmez</t></option>
                                <option value="Sabah"><t key="salon.book.waitlist.morning">Sabah</t></option>
                                <option value="Ogle"><t key="salon.book.waitlist.noon">Öğle</t></option>
                                <option value="Aksam"><t key="salon.book.waitlist.evening">Akşam</t></option>
                            </select>
                        </div>
                        <div class="col-7">
                            <label class="form-label small"><t key="salon.book.summary.service">Hizmet</t> *</label>
                            <select class="form-select form-select-sm" data-bind="value: waitlist.serviceId, options: allFlatServices, optionsText: 'name', optionsValue: 'id', optionsCaption: $root.t('salon.profile.select_placeholder', 'Seçiniz...')"></select>
                        </div>
                        <div class="col-5">
                            <label class="form-label small"><t key="salon.book.summary.date">Tarih</t> *</label>
                            <input type="date" class="form-control form-control-sm" data-bind="value: waitlist.date" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.book.notes">Notlar (isteğe bağlı)</t></label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: waitlist.notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.book.waitlist.cancel">Vazgeç</t></button>
                    <button type="button" class="btn btn-book btn-sm" data-bind="click: submitWaitlist, disable: waitlistSaving">
                        <span data-bind="visible: waitlistSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !waitlistSaving()"></i><t key="salon.common.btn.save">Kaydet</t>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Uyelik Basvuru Modali -->
    <div class="modal fade" id="signupModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header py-2" style="background: linear-gradient(135deg, #2d1b3d 0%, #4a1a6b 100%); color: #fff;">
                    <h6 class="modal-title"><i class="bi bi-person-plus me-2"></i><t key="salon.profile.membership.join">Üye Ol</t></h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="signup-vm">
                    <div class="text-center mb-3">
                        <span class="badge bg-purple text-white px-3 py-2" style="background:#7b1fa2;" data-bind="text: signupPlanName"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small"><t key="salon.book.fullname">Ad Soyad *</t></label>
                        <input type="text" class="form-control form-control-sm" data-bind="value: signupForm.fullName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small"><t key="salon.book.phone">Telefon *</t></label>
                        <input type="tel" class="form-control form-control-sm" placeholder="5XX XXX XX XX" data-bind="value: signupForm.phone" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small"><t key="salon.book.email">E-posta</t></label>
                        <input type="email" class="form-control form-control-sm" data-bind="value: signupForm.email" />
                    </div>
                    <!-- Ucretli plan ise checkout bilgisi -->
                    <!-- ko if: signupPlanPrice() > 0 && !membershipCheckoutActive() -->
                    <div class="border rounded p-2 mb-3 bg-light">
                        <div class="small fw-bold mb-2"><i class="bi bi-credit-card me-1"></i><t key="salon.profile.membership.payment_title">Ödeme Bilgileri</t></div>
                        <div class="alert alert-info py-1 small mb-2">
                            <i class="bi bi-info-circle me-1"></i><strong data-bind="text: signupPlanPrice().toLocaleString($root.profileLang || undefined) + ' ' + $root.t('salon.common.currency_abbr', 'TL')"></strong> <t key="salon.profile.membership.payment_desc">tutarında salon müşteri üyeliği ödemesi alınacaktır. Kart bilgileri güvenli ödeme formunda girilir.</t>
                        </div>
                    </div>
                    <!-- /ko -->
                    <div id="membership-checkout-container" class="mt-3" style="display:none;" data-bind="visible: membershipCheckoutActive"></div>
                    <button class="btn btn-book w-100" data-bind="visible: !membershipCheckoutActive(), click: submitSignup, disable: isSubmitting">
                        <span data-bind="visible: isSubmitting" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSubmitting()"></i>
                        <!-- ko if: signupPlanPrice() > 0 -->
                        <span><t key="salon.profile.membership.open_payment_form">Ödeme Formunu Aç</t></span>
                        <!-- /ko -->
                        <!-- ko if: signupPlanPrice() <= 0 -->
                        <span><t key="salon.profile.membership.send_application">Başvuruyu Gönder</t></span>
                        <!-- /ko -->
                    </button>
                </div>
            </div>
        </div>
    </div>

    </div>

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/lib/toastr/toastr.min.js"></script>
    <script src="/js/confirm-modal.js"></script>
    <script src="/js/iyzico-checkout.js"></script>
    <script src="/lib/knockout/knockout-latest.min.js"></script>
    <script src="/js/phone-input.js"></script>
    <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
    <script src="~/js/PublicProfile.js" asp-append-version="true"></script>
</body>
</html>
