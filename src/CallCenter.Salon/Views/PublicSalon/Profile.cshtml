@{
    Layout = null;
    var slug = (string)ViewData["Slug"]!;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Salon Profili</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: #f5f5f5; font-family: 'Segoe UI', system-ui, sans-serif; }
        .hero { background: linear-gradient(135deg, #2d1b3d 0%, #4a1a6b 100%); color: #fff; padding: 3rem 0; }
        .hero .logo { width: 80px; height: 80px; background: rgba(255,255,255,.15); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; }
        .service-card { transition: .15s; cursor: default; }
        .service-card:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,0,0,.1) !important; }
        .category-header { border-left: 3px solid #7b1fa2; padding-left: .75rem; }
        .working-hours td { padding: .25rem .5rem; font-size: .85rem; }
        .btn-book { background: #7b1fa2; border: none; color: #fff; }
        .btn-book:hover { background: #6a1b9a; color: #fff; }
        .social-link { width: 36px; height: 36px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: rgba(255,255,255,.15); color: #fff; text-decoration: none; transition: .15s; }
        .social-link:hover { background: rgba(255,255,255,.3); color: #fff; }
    </style>
</head>
<body>
    <div id="public-salon-vm">
        <!-- ko if: loaded() && !notFound() -->

        <!-- Hero -->
        <div class="hero">
            <div class="container">
                <div class="d-flex align-items-center gap-4">
                    <div class="logo">
                        <i class="bi bi-scissors"></i>
                    </div>
                    <div>
                        <h1 class="mb-1 fw-bold" data-bind="text: salon().salonName"></h1>
                        <!-- ko if: salon().description -->
                        <p class="mb-2 opacity-75" data-bind="text: salon().description"></p>
                        <!-- /ko -->
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <!-- ko if: salon().phone -->
                            <span class="badge bg-light text-dark"><i class="bi bi-telephone me-1"></i><span data-bind="text: salon().phone"></span></span>
                            <!-- /ko -->
                            <!-- ko if: salon().city -->
                            <span class="badge bg-light text-dark"><i class="bi bi-geo-alt me-1"></i><span data-bind="text: (salon().district ? salon().district + ', ' : '') + salon().city"></span></span>
                            <!-- /ko -->
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <!-- ko if: salon().instagramHandle -->
                            <a class="social-link" data-bind="attr: { href: 'https://instagram.com/' + salon().instagramHandle.replace('@@','') }" target="_blank"><i class="bi bi-instagram"></i></a>
                            <!-- /ko -->
                            <!-- ko if: salon().facebookUrl -->
                            <a class="social-link" data-bind="attr: { href: salon().facebookUrl }" target="_blank"><i class="bi bi-facebook"></i></a>
                            <!-- /ko -->
                            <!-- ko if: salon().googleMapsUrl -->
                            <a class="social-link" data-bind="attr: { href: salon().googleMapsUrl }" target="_blank"><i class="bi bi-geo-alt-fill"></i></a>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="container py-4">
            <div class="row g-4">
                <!-- Sol: Hizmetler -->
                <div class="col-lg-8">
                    <h4 class="mb-3"><i class="bi bi-list-check me-2"></i>Hizmetlerimiz</h4>
                    <!-- ko foreach: salon().serviceCategories -->
                    <div class="mb-4">
                        <h6 class="category-header mb-3" data-bind="style: { borderColor: color || '#7b1fa2' }">
                            <i data-bind="attr: { 'class': iconClass || 'bi bi-tag' }, style: { color: color || '#7b1fa2' }" class="me-2"></i>
                            <span data-bind="text: name"></span>
                        </h6>
                        <div class="row g-2">
                            <!-- ko foreach: services -->
                            <div class="col-sm-6">
                                <div class="card border-0 shadow-sm service-card">
                                    <div class="card-body py-2 px-3 d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-semibold small" data-bind="text: name"></div>
                                            <small class="text-muted" data-bind="text: durationMinutes + ' dk'"></small>
                                        </div>
                                        <span class="fw-bold text-primary" data-bind="text: price.toLocaleString('tr-TR') + ' TL'"></span>
                                    </div>
                                </div>
                            </div>
                            <!-- /ko -->
                        </div>
                    </div>
                    <!-- /ko -->
                </div>

                <!-- Sag: Bilgiler + Randevu -->
                <div class="col-lg-4">
                    <a class="btn btn-book w-100 py-3 mb-3 fs-5" data-bind="attr: { href: '/salon/' + salon().slug + '/book' }">
                        <i class="bi bi-calendar-check me-2"></i>Online Randevu Al
                    </a>

                    <!-- Calisma Saatleri -->
                    <!-- ko if: workingHours().length > 0 -->
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white fw-semibold small"><i class="bi bi-clock me-2"></i>Calisma Saatleri</div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <tbody data-bind="foreach: workingHours">
                                    <tr data-bind="css: { 'table-active fw-semibold': isToday }">
                                        <td data-bind="text: day"></td>
                                        <td class="text-end" data-bind="text: hours"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- /ko -->

                    <!-- Adres -->
                    <!-- ko if: salon().address -->
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white fw-semibold small"><i class="bi bi-geo-alt me-2"></i>Adres</div>
                        <div class="card-body small" data-bind="text: salon().address"></div>
                    </div>
                    <!-- /ko -->

                    <!-- Iletisim -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white fw-semibold small"><i class="bi bi-telephone me-2"></i>Iletisim</div>
                        <div class="card-body small">
                            <!-- ko if: salon().phone -->
                            <div><i class="bi bi-telephone me-2"></i><a data-bind="text: salon().phone, attr: { href: 'tel:' + salon().phone }" class="text-decoration-none"></a></div>
                            <!-- /ko -->
                            <!-- ko if: salon().email -->
                            <div class="mt-1"><i class="bi bi-envelope me-2"></i><a data-bind="text: salon().email, attr: { href: 'mailto:' + salon().email }" class="text-decoration-none"></a></div>
                            <!-- /ko -->
                            <!-- ko if: salon().website -->
                            <div class="mt-1"><i class="bi bi-globe me-2"></i><a data-bind="text: salon().website, attr: { href: salon().website }" class="text-decoration-none" target="_blank"></a></div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <footer class="text-center py-3 text-muted small border-top mt-4">
            <a href="https://corplynk.com" class="text-decoration-none text-muted">CorpLynk</a> ile olusturuldu
        </footer>

        <!-- /ko -->

        <!-- ko if: notFound() -->
        <div class="d-flex align-items-center justify-content-center" style="min-height:100vh;">
            <div class="text-center">
                <i class="bi bi-shop" style="font-size:4rem;opacity:.3;"></i>
                <h4 class="mt-3">Salon bulunamadi</h4>
                <p class="text-muted">Bu adres aktif degil veya henuz yayinlanmamis.</p>
                <a href="https://corplynk.com" class="btn btn-outline-primary btn-sm">Ana Sayfaya Don</a>
            </div>
        </div>
        <!-- /ko -->
    </div>

    <script src="https://cdn.jsdelivr.net/npm/knockout@3.5.1/build/output/knockout-latest.min.js"></script>
    <script>
        var salonSlug = '@slug';

        function PublicSalonViewModel() {
            var self = this;
            self.salon = ko.observable({});
            self.loaded = ko.observable(false);
            self.notFound = ko.observable(false);
            self.workingHours = ko.observableArray([]);

            var dayNames = { mon: 'Pazartesi', tue: 'Sali', wed: 'Carsamba', thu: 'Persembe', fri: 'Cuma', sat: 'Cumartesi', sun: 'Pazar' };
            var dayOrder = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];
            var todayIdx = (new Date().getDay() + 6) % 7; // 0=Mon

            fetch('/proxy/salon/' + salonSlug)
                .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
                .then(function (data) {
                    self.salon(data);
                    document.title = data.salonName + ' | CorpLynk Salon';

                    if (data.workingHoursJson) {
                        try {
                            var h = JSON.parse(data.workingHoursJson);
                            var list = [];
                            dayOrder.forEach(function (key, idx) {
                                list.push({ day: dayNames[key], hours: h[key] || 'Kapali', isToday: idx === todayIdx });
                            });
                            self.workingHours(list);
                        } catch (e) {}
                    }
                    self.loaded(true);
                })
                .catch(function () { self.notFound(true); });
        }

        ko.applyBindings(new PublicSalonViewModel(), document.getElementById('public-salon-vm'));
    </script>
</body>
</html>
