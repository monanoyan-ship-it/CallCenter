@{
    Layout = null;
    var slug = (string)ViewData["Slug"]!;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @{
        var salonName = ViewData["SalonName"] as string ?? "Salon";
        var salonDesc = ViewData["SalonDescription"] as string ?? "Online randevu al";
        var salonCity = ViewData["SalonCity"] as string;
        var salonDistrict = ViewData["SalonDistrict"] as string;
        var salonLogo = ViewData["SalonLogo"] as string;
        var location = salonDistrict != null && salonCity != null ? $"{salonDistrict}, {salonCity}" : salonCity;
        var pageTitle = location != null ? $"{salonName} - {location} | Online Randevu" : $"{salonName} | Online Randevu";
        var metaDesc = location != null ? $"{salonName} - {location}. {salonDesc}. CorpLynk Salon ile online randevu al." : $"{salonName}. {salonDesc}. CorpLynk Salon ile online randevu al.";
    }
    <title>@pageTitle</title>
    <meta name="description" content="@metaDesc" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@metaDesc" />
    <meta property="og:type" content="business.business" />
    <meta property="og:url" content="https://sln.corplynk.com/salon/@slug" />
    @if (salonLogo != null) {
    <meta property="og:image" content="@salonLogo" />
    }
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href="https://sln.corplynk.com/salon/@slug" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" rel="stylesheet" />
    <style>
        body { background: #f5f5f5; font-family: 'Segoe UI', system-ui, sans-serif; }
        .hero { background: linear-gradient(135deg, #2d1b3d 0%, #4a1a6b 100%); color: #fff; padding: 3rem 0; }
        .hero .logo { width: 80px; height: 80px; background: rgba(255,255,255,.15); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; }
        .service-card { transition: .15s; cursor: default; }
        .service-card:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,0,0,.1) !important; }
        .category-header { border-left: 3px solid #7b1fa2; padding-left: .75rem; }
        .working-hours td { padding: .25rem .5rem; font-size: .85rem; }
        .btn-book { background: #7b1fa2; border: none; color: #fff; }
        .btn-book:hover { background: #6a1b9a; color: #fff; }
        .social-link { width: 36px; height: 36px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: rgba(255,255,255,.15); color: #fff; text-decoration: none; transition: .15s; }
        .social-link:hover { background: rgba(255,255,255,.3); color: #fff; }
        .plan-card { transition: .2s; border: 2px solid transparent; }
        .plan-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,.12) !important; }
        .plan-card.selected { border-color: #7b1fa2; }
        .plan-badge { font-size: .65rem; padding: .2rem .5rem; }
        .accordion-button:not(.collapsed) { background: #f8f5fb; color: #4a1a6b; box-shadow: none; }
        .accordion-button:focus { box-shadow: none; }
        .accordion-button::after { width: .9rem; height: .9rem; background-size: .9rem; }
    </style>
</head>
<body>
    <div id="public-salon-vm">
        <!-- ko if: loaded() && !notFound() -->

        <!-- Hero -->
        <div class="hero">
            <div class="container">
                <div class="d-flex align-items-center gap-4">
                    <div class="logo">
                        <i class="bi bi-scissors"></i>
                    </div>
                    <div>
                        <h1 class="mb-1 fw-bold" data-bind="text: salon().salonName"></h1>
                        <!-- ko if: salon().description -->
                        <p class="mb-2 opacity-75" data-bind="text: salon().description"></p>
                        <!-- /ko -->
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <!-- ko if: salon().phone -->
                            <span class="badge bg-light text-dark"><i class="bi bi-telephone me-1"></i><span data-bind="text: salon().phone"></span></span>
                            <!-- /ko -->
                            <!-- ko if: salon().city -->
                            <span class="badge bg-light text-dark"><i class="bi bi-geo-alt me-1"></i><span data-bind="text: (salon().district ? salon().district + ', ' : '') + salon().city"></span></span>
                            <!-- /ko -->
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <!-- ko if: salon().instagramHandle -->
                            <a class="social-link" data-bind="attr: { href: 'https://instagram.com/' + salon().instagramHandle.replace('@@','') }" target="_blank"><i class="bi bi-instagram"></i></a>
                            <!-- /ko -->
                            <!-- ko if: salon().facebookUrl -->
                            <a class="social-link" data-bind="attr: { href: salon().facebookUrl }" target="_blank"><i class="bi bi-facebook"></i></a>
                            <!-- /ko -->
                            <!-- ko if: salon().googleMapsUrl -->
                            <a class="social-link" data-bind="attr: { href: salon().googleMapsUrl }" target="_blank"><i class="bi bi-geo-alt-fill"></i></a>
                            <!-- /ko -->
                        </div>
                        <!-- Platform User: Musteri ol butonu -->
                        <div class="mt-3" id="joinSalonArea">
                            <button class="btn btn-light btn-sm" id="btnJoinSalon" style="display:none;" onclick="joinThisSalon()">
                                <i class="bi bi-person-plus me-1"></i>Bu Salonun Müşterisiyim
                            </button>
                            <span class="badge bg-success" id="alreadyMember" style="display:none;">
                                <i class="bi bi-check-circle me-1"></i>Üye
                            </span>
                            <a href="/user/login" class="btn btn-outline-light btn-sm" id="btnLoginToJoin" style="display:none;">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Giriş Yap / Üye Ol
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="container py-4">
            <div class="row g-4">
                <!-- Sol: Dinamik bolumler -->
                <div class="col-lg-8">
                    <!-- ko foreach: orderedSections -->

                    <!-- Bannerlar -->
                    <!-- ko if: key === 'banners' && $parent.salon().showBanners !== false && $parent.banners().length > 0 -->
                    <div class="mb-4" id="section-banners">
                        <!-- ko if: $parent.banners().length === 1 -->
                        <div data-bind="with: $parent.banners()[0]">
                            <!-- ko if: link -->
                            <a data-bind="attr: { href: link }" target="_blank">
                                <img data-bind="attr: { src: url, alt: title || 'Banner' }" class="w-100 rounded shadow-sm" style="max-height:300px;object-fit:cover;" />
                            </a>
                            <!-- /ko -->
                            <!-- ko if: !link -->
                            <img data-bind="attr: { src: url, alt: title || 'Banner' }" class="w-100 rounded shadow-sm" style="max-height:300px;object-fit:cover;" />
                            <!-- /ko -->
                        </div>
                        <!-- /ko -->
                        <!-- ko if: $parent.banners().length > 1 -->
                        <div id="bannerCarousel" class="carousel slide shadow-sm rounded overflow-hidden" data-bs-ride="carousel">
                            <div class="carousel-indicators" data-bind="foreach: $parent.banners">
                                <button type="button" data-bs-target="#bannerCarousel" data-bind="attr: { 'data-bs-slide-to': $index() }, css: { active: $index() === 0 }"></button>
                            </div>
                            <div class="carousel-inner" data-bind="foreach: $parent.banners">
                                <div class="carousel-item" data-bind="css: { active: $index() === 0 }">
                                    <!-- ko if: link -->
                                    <a data-bind="attr: { href: link }" target="_blank">
                                        <img data-bind="attr: { src: url, alt: title || 'Banner' }" class="d-block w-100" style="max-height:300px;object-fit:cover;" />
                                    </a>
                                    <!-- /ko -->
                                    <!-- ko if: !link -->
                                    <img data-bind="attr: { src: url, alt: title || 'Banner' }" class="d-block w-100" style="max-height:300px;object-fit:cover;" />
                                    <!-- /ko -->
                                    <!-- ko if: title -->
                                    <div class="carousel-caption d-none d-md-block">
                                        <h6 class="mb-0" data-bind="text: title"></h6>
                                    </div>
                                    <!-- /ko -->
                                </div>
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon"></span>
                            </button>
                        </div>
                        <!-- /ko -->
                    </div>
                    <!-- /ko -->

                    <!-- Hizmetler -->
                    <!-- ko if: key === 'services' && $parent.salon().showServices !== false -->
                    <div class="mb-4" id="section-services">
                        <h4 class="mb-3"><i class="bi bi-list-check me-2"></i>Hizmetlerimiz</h4>
                        <div class="accordion" id="servicesAccordion" data-bind="foreach: $parent.salon().serviceCategories">
                            <div class="accordion-item border-0 shadow-sm mb-2" style="border-radius:8px;overflow:hidden;">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed py-2 px-3" type="button"
                                        data-bs-toggle="collapse" data-bind="attr: { 'data-bs-target': '#cat-' + id }">
                                        <i data-bind="attr: { 'class': iconClass || 'bi bi-tag' }, style: { color: color || '#7b1fa2' }" class="me-2"></i>
                                        <span class="fw-semibold small" data-bind="text: name"></span>
                                        <span class="badge bg-light text-muted ms-2" style="font-size:.7rem;" data-bind="text: services.length + ' hizmet'"></span>
                                    </button>
                                </h2>
                                <div class="accordion-collapse collapse" data-bind="attr: { id: 'cat-' + id }">
                                    <div class="accordion-body py-2 px-3">
                                        <div class="row g-2">
                                            <!-- ko foreach: services -->
                                            <div class="col-sm-6">
                                                <div class="d-flex justify-content-between align-items-center py-1 border-bottom" style="border-color:#f0f0f0 !important;">
                                                    <div>
                                                        <div class="fw-medium small" data-bind="text: name"></div>
                                                        <small class="text-muted" data-bind="text: durationMinutes + ' dk'"></small>
                                                    </div>
                                                    <span class="fw-bold text-primary small" data-bind="text: price.toLocaleString('tr-TR') + ' TL'"></span>
                                                </div>
                                            </div>
                                            <!-- /ko -->
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- /ko -->

                    <!-- Uyelik Planlari -->
                    <!-- ko if: key === 'memberships' && $parent.salon().showMemberships !== false -->
                    <div class="mb-4" id="section-memberships">
                        <h4 class="mb-3"><i class="bi bi-award me-2"></i>Uyelik Planlari</h4>
                        <!-- ko if: $parent.membershipPlans().length === 0 -->
                        <p class="text-muted small">Henuz uyelik plani tanimlanmamis.</p>
                        <!-- /ko -->
                        <div class="row g-3">
                            <!-- ko foreach: $parent.membershipPlans -->
                            <div class="col-md-6 col-lg-4">
                                <div class="card border-0 shadow-sm plan-card h-100" data-bind="css: { selected: $parent.selectedPlanId() === id }, click: function() { $parent.selectedPlanId(id); }">
                                    <div class="card-body text-center py-4">
                                        <i class="fs-1 d-block mb-2" data-bind="attr: { 'class': iconClass || 'bi bi-star' }, style: { color: color || '#7b1fa2' }"></i>
                                        <h5 class="fw-bold" data-bind="text: name"></h5>
                                        <!-- ko if: description -->
                                        <p class="text-muted small mb-3" data-bind="text: description"></p>
                                        <!-- /ko -->
                                        <div class="mb-3">
                                            <span class="fs-3 fw-bold" data-bind="text: monthlyPrice.toLocaleString('tr-TR')"></span>
                                            <span class="text-muted">TL/ay</span>
                                        </div>
                                        <div class="d-flex flex-column gap-1">
                                            <!-- ko if: discountPercent > 0 -->
                                            <span class="plan-badge badge bg-success-subtle text-success">%<span data-bind="text: discountPercent"></span> indirim</span>
                                            <!-- /ko -->
                                            <!-- ko if: freeSessionsPerMonth > 0 -->
                                            <span class="plan-badge badge bg-info-subtle text-info"><span data-bind="text: freeSessionsPerMonth"></span> ucretsiz seans/ay</span>
                                            <!-- /ko -->
                                            <!-- ko if: priorityBooking -->
                                            <span class="plan-badge badge bg-warning-subtle text-warning">Oncelikli randevu</span>
                                            <!-- /ko -->
                                        </div>
                                        <button class="btn btn-book btn-sm mt-3 px-4" data-bind="click: function() { $parents[1].openSignup(id, name); }">
                                            <i class="bi bi-person-plus me-1"></i>Uye Ol
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <!-- /ko -->
                        </div>
                    </div>
                    <!-- /ko -->

                    <!-- Ekibimiz -->
                    <!-- ko if: key === 'team' && $parent.salon().showTeam !== false -->
                    <div class="mb-4" id="section-team">
                        <h4 class="mb-3"><i class="bi bi-people me-2"></i>Ekibimiz</h4>
                        <!-- ko if: $parent.teamMembers().length === 0 -->
                        <p class="text-muted small">Ekip bilgisi henuz eklenmemis.</p>
                        <!-- /ko -->
                        <div class="row g-3" data-bind="foreach: $parent.teamMembers">
                            <div class="col-6 col-md-4 col-lg-3">
                                <div class="card border-0 shadow-sm text-center h-100">
                                    <div class="card-body py-3">
                                        <!-- ko if: photoUrl -->
                                        <img data-bind="attr: { src: photoUrl }" class="rounded-circle mb-2" style="width:64px;height:64px;object-fit:cover;" />
                                        <!-- /ko -->
                                        <!-- ko if: !photoUrl -->
                                        <div class="rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width:64px;height:64px;background:#e8e0f0;">
                                            <i class="bi bi-person fs-3" style="color:#7b1fa2;"></i>
                                        </div>
                                        <!-- /ko -->
                                        <div class="fw-semibold small" data-bind="text: name"></div>
                                        <!-- ko if: specialty || title -->
                                        <small class="text-muted" data-bind="text: specialty || title"></small>
                                        <!-- /ko -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- /ko -->

                    <!-- Yorumlar -->
                    <!-- ko if: key === 'reviews' && $parent.salon().showReviews !== false -->
                    <div class="mb-4" id="section-reviews">
                        <h4 class="mb-3">
                            <i class="bi bi-chat-square-text me-2"></i>Musteri Yorumlari
                            <!-- ko if: $parent.reviewStats().averageRating > 0 -->
                            <span class="ms-2 fs-6">
                                <i class="bi bi-star-fill text-warning"></i>
                                <span data-bind="text: $parent.reviewStats().averageRating"></span>
                                <small class="text-muted" data-bind="text: '(' + $parent.reviewStats().totalCount + ' yorum)'"></small>
                            </span>
                            <!-- /ko -->
                        </h4>
                        <!-- ko if: $parent.reviews().length === 0 -->
                        <p class="text-muted small">Henuz yorum yapilmamis.</p>
                        <!-- /ko -->
                        <div data-bind="foreach: $parent.reviews">
                            <div class="card border-0 shadow-sm mb-2">
                                <div class="card-body py-2 px-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div class="fw-semibold small" data-bind="text: clientName"></div>
                                        <div>
                                            <!-- ko foreach: Array.from({length: rating}, (_, i) => i) -->
                                            <i class="bi bi-star-fill text-warning" style="font-size:.75rem;"></i>
                                            <!-- /ko -->
                                            <!-- ko foreach: Array.from({length: 5 - rating}, (_, i) => i) -->
                                            <i class="bi bi-star text-muted" style="font-size:.75rem;"></i>
                                            <!-- /ko -->
                                        </div>
                                    </div>
                                    <!-- ko if: comment -->
                                    <p class="text-muted small mb-1" data-bind="text: comment"></p>
                                    <!-- /ko -->
                                    <small class="text-muted" style="font-size:.7rem;" data-bind="text: new Date(createdAt).toLocaleDateString('tr-TR')"></small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- /ko -->

                    <!-- Harita -->
                    <!-- ko if: key === 'map' && $parent.salon().showMap !== false && $parent.salon().latitude -->
                    <div class="mb-4" id="section-map">
                        <h4 class="mb-3"><i class="bi bi-geo-alt me-2"></i>Konum</h4>
                        <div class="rounded shadow-sm overflow-hidden" id="salonMap" style="height:300px;"></div>
                    </div>
                    <!-- /ko -->

                    <!-- /ko -->
                </div>

                <!-- Sag: Bilgiler + Randevu -->
                <div class="col-lg-4">
                    <!-- Randevu butonu -->
                    <!-- ko if: salon().showBooking !== false -->
                    <a class="btn btn-book w-100 py-3 mb-3 fs-5" data-bind="attr: { href: '/salon/' + salon().slug + '/book' }">
                        <i class="bi bi-calendar-check me-2"></i>Online Randevu Al
                    </a>
                    <!-- /ko -->

                    <!-- Calisma Saatleri -->
                    <!-- ko if: salon().showHours !== false && workingHours().length > 0 -->
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white fw-semibold small"><i class="bi bi-clock me-2"></i>Calisma Saatleri</div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <tbody data-bind="foreach: workingHours">
                                    <tr data-bind="css: { 'table-active fw-semibold': isToday }">
                                        <td data-bind="text: day"></td>
                                        <td class="text-end" data-bind="text: hours"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- /ko -->

                    <!-- Adres -->
                    <!-- ko if: salon().showContact !== false && salon().address -->
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white fw-semibold small"><i class="bi bi-geo-alt me-2"></i>Adres</div>
                        <div class="card-body small" data-bind="text: salon().address"></div>
                    </div>
                    <!-- /ko -->

                    <!-- Iletisim -->
                    <!-- ko if: salon().showContact !== false -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white fw-semibold small"><i class="bi bi-telephone me-2"></i>Iletisim</div>
                        <div class="card-body small">
                            <!-- ko if: salon().phone -->
                            <div><i class="bi bi-telephone me-2"></i><a data-bind="text: salon().phone, attr: { href: 'tel:' + salon().phone }" class="text-decoration-none"></a></div>
                            <!-- /ko -->
                            <!-- ko if: salon().email -->
                            <div class="mt-1"><i class="bi bi-envelope me-2"></i><a data-bind="text: salon().email, attr: { href: 'mailto:' + salon().email }" class="text-decoration-none"></a></div>
                            <!-- /ko -->
                            <!-- ko if: salon().website -->
                            <div class="mt-1"><i class="bi bi-globe me-2"></i><a data-bind="text: salon().website, attr: { href: salon().website }" class="text-decoration-none" target="_blank"></a></div>
                            <!-- /ko -->
                        </div>
                    </div>
                    <!-- /ko -->
                </div>
            </div>
        </div>

        <footer class="text-center py-3 text-muted small border-top mt-4">
            <a href="https://corplynk.com" class="text-decoration-none text-muted">CorpLynk</a> ile olusturuldu
        </footer>

        <!-- /ko -->

        <!-- ko if: notFound() -->
        <div class="d-flex align-items-center justify-content-center" style="min-height:100vh;">
            <div class="text-center">
                <i class="bi bi-shop" style="font-size:4rem;opacity:.3;"></i>
                <h4 class="mt-3">Salon bulunamadi</h4>
                <p class="text-muted">Bu adres aktif degil veya henuz yayinlanmamis.</p>
                <a href="https://corplynk.com" class="btn btn-outline-primary btn-sm">Ana Sayfaya Don</a>
            </div>
        </div>
        <!-- /ko -->
    </div>

    <!-- Uyelik Basvuru Modali -->
    <div class="modal fade" id="signupModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header py-2" style="background: linear-gradient(135deg, #2d1b3d 0%, #4a1a6b 100%); color: #fff;">
                    <h6 class="modal-title"><i class="bi bi-person-plus me-2"></i>Uye Ol</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="signup-vm">
                    <div class="text-center mb-3">
                        <span class="badge bg-purple text-white px-3 py-2" style="background:#7b1fa2;" data-bind="text: signupPlanName"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Ad Soyad *</label>
                        <input type="text" class="form-control form-control-sm" data-bind="value: signupForm.fullName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Telefon *</label>
                        <div data-bind="phoneInput: signupForm.phone"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">E-posta</label>
                        <input type="email" class="form-control form-control-sm" data-bind="value: signupForm.email" />
                    </div>
                    <!-- Ucretli plan ise odeme formu -->
                    <!-- ko if: signupPlanPrice() > 0 -->
                    <div class="border rounded p-2 mb-3 bg-light">
                        <div class="small fw-bold mb-2"><i class="bi bi-credit-card me-1"></i>Ödeme Bilgileri</div>
                        <div class="alert alert-info py-1 small mb-2">
                            <i class="bi bi-info-circle me-1"></i>Aylık <strong data-bind="text: signupPlanPrice().toLocaleString('tr-TR') + ' TL'"></strong> ödeme alınacaktır.
                        </div>
                        <div class="mb-2">
                            <input type="text" class="form-control form-control-sm" placeholder="Kart Üzerindeki İsim" data-bind="value: signupForm.cardName" />
                        </div>
                        <div class="mb-2">
                            <input type="text" class="form-control form-control-sm" placeholder="Kart Numarası" maxlength="19" data-bind="value: signupForm.cardNumber, event: { input: formatCardNumber }" />
                        </div>
                        <div class="row g-2">
                            <div class="col-4">
                                <input type="text" class="form-control form-control-sm" placeholder="AA" maxlength="2" data-bind="value: signupForm.expMonth" />
                            </div>
                            <div class="col-4">
                                <input type="text" class="form-control form-control-sm" placeholder="YY" maxlength="2" data-bind="value: signupForm.expYear" />
                            </div>
                            <div class="col-4">
                                <input type="text" class="form-control form-control-sm" placeholder="CVC" maxlength="4" data-bind="value: signupForm.cvc" />
                            </div>
                        </div>
                    </div>
                    <!-- /ko -->
                    <button class="btn btn-book w-100" data-bind="click: submitSignup, disable: isSubmitting">
                        <span data-bind="visible: isSubmitting" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSubmitting()"></i>
                        <!-- ko if: signupPlanPrice() > 0 -->
                        <span>Öde ve Üye Ol</span>
                        <!-- /ko -->
                        <!-- ko if: signupPlanPrice() <= 0 -->
                        <span>Başvuruyu Gönder</span>
                        <!-- /ko -->
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/knockout@3.5.1/build/output/knockout-latest.min.js"></script>
    <script src="/js/phone-input.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var salonSlug = '@slug';

        function PublicSalonViewModel() {
            var self = this;
            self.salon = ko.observable({});
            self.loaded = ko.observable(false);
            self.notFound = ko.observable(false);
            self.workingHours = ko.observableArray([]);
            self.membershipPlans = ko.observableArray([]);
            self.banners = ko.observableArray([]);
            self.teamMembers = ko.observableArray([]);
            self.reviews = ko.observableArray([]);
            self.reviewStats = ko.observable({});
            self.selectedPlanId = ko.observable(null);

            // Signup
            self.signupPlanId = ko.observable(null);
            self.signupPlanName = ko.observable('');
            self.signupPlanPrice = ko.observable(0);
            self.isSubmitting = ko.observable(false);
            self.signupForm = {
                fullName: ko.observable(''),
                phone: ko.observable(''),
                email: ko.observable(''),
                cardName: ko.observable(''),
                cardNumber: ko.observable(''),
                expMonth: ko.observable(''),
                expYear: ko.observable(''),
                cvc: ko.observable('')
            };

            self.formatCardNumber = function (data, event) {
                var val = self.signupForm.cardNumber().replace(/\D/g, '');
                if (val.length > 16) val = val.substring(0, 16);
                var formatted = val.replace(/(\d{4})(?=\d)/g, '$1 ');
                self.signupForm.cardNumber(formatted);
                return true;
            };

            var signupModal;

            // Bolum siralama
            var defaultOrder = ['banners', 'services', 'memberships', 'team', 'reviews', 'map'];
            self.orderedSections = ko.computed(function () {
                var s = self.salon();
                if (!s || !s.slug) return [];
                var order = defaultOrder;
                if (s.sectionOrderJson) {
                    try { order = JSON.parse(s.sectionOrderJson); } catch (e) {}
                }
                return order.map(function (key) { return { key: key }; });
            });

            var dayNames = { mon: 'Pazartesi', tue: 'Sali', wed: 'Carsamba', thu: 'Persembe', fri: 'Cuma', sat: 'Cumartesi', sun: 'Pazar' };
            var dayOrder = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];
            var todayIdx = (new Date().getDay() + 6) % 7;

            fetch('/proxy/salon/' + salonSlug)
                .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
                .then(function (data) {
                    self.salon(data);
                    document.title = data.salonName + ' | CorpLynk Salon';

                    if (data.workingHoursJson) {
                        try {
                            var h = JSON.parse(data.workingHoursJson);
                            var list = [];
                            dayOrder.forEach(function (key, idx) {
                                list.push({ day: dayNames[key], hours: h[key] || 'Kapali', isToday: idx === todayIdx });
                            });
                            self.workingHours(list);
                        } catch (e) {}
                    }

                    // Bannerlari parse et
                    if (data.bannersJson) {
                        try {
                            var banners = JSON.parse(data.bannersJson);
                            self.banners(banners.filter(function (b) { return b.url; }));
                        } catch (e) {}
                    }

                    // Uyelik planlarini yukle
                    if (data.showMemberships !== false) {
                        fetch('/proxy/salon/' + salonSlug + '/memberships')
                            .then(function (r) { return r.ok ? r.json() : []; })
                            .then(function (plans) { self.membershipPlans(plans); });
                    }

                    // Ekibi yukle
                    if (data.showTeam !== false) {
                        fetch('/proxy/salon/' + salonSlug + '/team')
                            .then(function (r) { return r.ok ? r.json() : []; })
                            .then(function (team) { self.teamMembers(team); });
                    }

                    // Yorumlari yukle
                    if (data.showReviews !== false) {
                        fetch('/proxy/salon/' + salonSlug + '/reviews')
                            .then(function (r) { return r.ok ? r.json() : { reviews: [], stats: {} }; })
                            .then(function (d) {
                                self.reviews(d.reviews || []);
                                self.reviewStats(d.stats || {});
                            });
                    }

                    // Harita
                    if (data.showMap !== false && data.latitude && data.longitude) {
                        setTimeout(function () {
                            var mapEl = document.getElementById('salonMap');
                            if (mapEl && typeof L !== 'undefined') {
                                var map = L.map('salonMap').setView([data.latitude, data.longitude], 15);
                                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                                    attribution: '&copy; OpenStreetMap'
                                }).addTo(map);
                                L.marker([data.latitude, data.longitude])
                                    .addTo(map)
                                    .bindPopup('<b>' + data.salonName + '</b><br>' + (data.address || ''))
                                    .openPopup();
                            }
                        }, 500);
                    }

                    self.loaded(true);
                })
                .catch(function () { self.notFound(true); });

            self.openSignup = function (planId, planName) {
                self.signupPlanId(planId);
                self.signupPlanName(planName);
                // Plan fiyatini bul
                var plan = self.membershipPlans().find(function (p) { return p.id === planId; });
                self.signupPlanPrice(plan ? plan.monthlyPrice : 0);
                self.signupForm.fullName('');
                self.signupForm.phone('');
                self.signupForm.email('');
                self.signupForm.cardName('');
                self.signupForm.cardNumber('');
                self.signupForm.expMonth('');
                self.signupForm.expYear('');
                self.signupForm.cvc('');
                if (!signupModal) signupModal = new bootstrap.Modal(document.getElementById('signupModal'));
                signupModal.show();
            };

            self.submitSignup = function () {
                var name = self.signupForm.fullName();
                var phone = self.signupForm.phone();
                if (!name || !phone) { alert('Ad ve telefon zorunludur.'); return; }

                var price = self.signupPlanPrice();
                if (price > 0) {
                    var cn = self.signupForm.cardNumber().replace(/\s/g, '');
                    if (!cn || cn.length < 15 || !self.signupForm.expMonth() || !self.signupForm.expYear() || !self.signupForm.cvc()) {
                        alert('Kart bilgilerini eksiksiz doldurunuz.'); return;
                    }
                }

                self.isSubmitting(true);

                // Adim 1: Uyelik basvurusu
                fetch('/proxy/salon/' + salonSlug + '/membership-signup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        planId: self.signupPlanId(),
                        fullName: name,
                        phone: phone,
                        email: self.signupForm.email() || null
                    })
                })
                .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
                .then(function (res) {
                    if (!res.ok || !res.data.success) {
                        self.isSubmitting(false);
                        alert(res.data.message || res.data || 'Bir hata oluştu.');
                        return;
                    }

                    // Ucretli plan ise odeme yap
                    if (price > 0 && res.data.slnClientId) {
                        var token = localStorage.getItem('platformToken');
                        fetch('/public-proxy/payments/membership', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'Authorization': token ? 'Bearer ' + token : '' },
                            body: JSON.stringify({
                                planId: self.signupPlanId(),
                                slnClientId: res.data.slnClientId,
                                card: {
                                    cardHolderName: self.signupForm.cardName(),
                                    cardNumber: self.signupForm.cardNumber().replace(/\s/g, ''),
                                    expireMonth: self.signupForm.expMonth(),
                                    expireYear: '20' + self.signupForm.expYear(),
                                    cvc: self.signupForm.cvc(),
                                    installment: 0
                                }
                            })
                        })
                        .then(function (r2) { return r2.json().then(function (d2) { return { ok: r2.ok, data: d2 }; }); })
                        .then(function (payRes) {
                            self.isSubmitting(false);
                            signupModal.hide();
                            if (payRes.ok) {
                                alert('Ödeme başarılı! Üyeliğiniz aktif edildi.');
                            } else {
                                alert('Üyelik oluşturuldu ama ödeme başarısız: ' + (payRes.data.message || 'Bilinmeyen hata'));
                            }
                        })
                        .catch(function () { self.isSubmitting(false); alert('Ödeme bağlantı hatası.'); });
                    } else {
                        self.isSubmitting(false);
                        signupModal.hide();
                        alert(res.data.message || 'Üyelik başvurunuz alındı!');
                    }
                })
                .catch(function () { self.isSubmitting(false); alert('Bağlantı hatası.'); });
            };
        }

        ko.applyBindings(new PublicSalonViewModel(), document.getElementById('public-salon-vm'));

        // ═══ Platform User: Salon Müşterisi Ol ═══
        (function () {
            var token = localStorage.getItem('platformToken');
            var salonSlug = '@slug';

            if (!token) {
                document.getElementById('btnLoginToJoin').style.display = '';
                return;
            }

            // Login olmuş — bu salona üye mi kontrol et
            fetch('/public-proxy/platform/salons', { headers: { 'Authorization': 'Bearer ' + token } })
                .then(function (r) { return r.ok ? r.json() : []; })
                .then(function (salons) {
                    // customerId'yi salon profil verisinden al
                    var profileData = document.getElementById('public-salon-vm').__ko_bindingContext?.$data?.salon();
                    var customerId = profileData?.customerId;

                    if (!customerId) {
                        // customerId'yi DOM'dan alamadıysak slug ile proxy'den alalım
                        document.getElementById('btnJoinSalon').style.display = '';
                        return;
                    }

                    var isMember = salons.some(function (s) { return s.customerId === customerId; });
                    if (isMember) {
                        document.getElementById('alreadyMember').style.display = '';
                    } else {
                        document.getElementById('btnJoinSalon').style.display = '';
                    }
                })
                .catch(function () {
                    document.getElementById('btnJoinSalon').style.display = '';
                });
        })();

        function joinThisSalon() {
            var token = localStorage.getItem('platformToken');
            if (!token) { window.location.href = '/user/login'; return; }

            if (!confirm('Bu salonun müşterisi olarak kaydolmak ve bilgilerinizi paylaşmak istiyor musunuz?')) return;

            // customerId'yi salon verisinden al
            var vm = ko.dataFor(document.getElementById('public-salon-vm'));
            var customerId = vm?.salon()?.customerId;

            if (!customerId) { alert('Salon bilgisi alınamadı.'); return; }

            fetch('/public-proxy/platform/salons/join', {
                method: 'POST',
                headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                body: JSON.stringify({ customerId: customerId })
            })
            .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
            .then(function (res) {
                if (res.ok) {
                    alert('Salona üye oldunuz!');
                    document.getElementById('btnJoinSalon').style.display = 'none';
                    document.getElementById('alreadyMember').style.display = '';
                } else {
                    alert(res.data.message || 'İşlem başarısız.');
                }
            })
            .catch(function () { alert('Bağlantı hatası.'); });
        }
    </script>
</body>
</html>
