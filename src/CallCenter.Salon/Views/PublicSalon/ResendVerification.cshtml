@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.public.resendverification.auto.title", "Doğrulama Mailini Tekrar Gönder");
    Layout = null;
    var submitted = ViewBag.Message != null;
    var success = ViewBag.Success != null && (bool)ViewBag.Success;
    var message = ViewBag.Message as string ?? "";
    var email = ViewBag.Email as string ?? "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><t key="salon.public.resendverification.auto.corplynk_dogrulama_maili">CorpLynk - Doğrulama Maili</t></title>
    <link href="/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: linear-gradient(135deg, #2d1b3d 0%, #1a1028 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .card-wrap { background: #fff; border-radius: 12px; padding: 2.5rem; max-width: 400px; width: 100%; box-shadow: 0 8px 32px rgba(0,0,0,.2); }
        .brand { color: #2d1b3d; font-weight: 700; font-size: 1.5rem; }
        .brand span { color: #ce93d8; }
        .btn-purple { background: #7b1fa2; border: none; color: #fff; }
        .btn-purple:hover { background: #6a1b9a; color: #fff; }
    </style>
</head>
<body>
    <div class="card-wrap">
        <a href="/user/login" class="text-decoration-none small text-muted d-inline-flex align-items-center mb-3">
            <i class="bi bi-arrow-left me-1"></i><t key="salon.account.back_to_login">Geri</t>
        </a>
        <div class="text-center mb-4">
            <div class="brand"><i class="bi bi-envelope-arrow-up me-2"></i><t key="salon.public.resendverification.auto.dogrulama_maili">Doğrulama Maili</t></div>
            <small class="text-muted"><t key="salon.public.resendverification.auto.hesabini_aktif_etmek_icin_tiklayabilecegin_baglantiyi_tekrar_gondereli">Hesabını aktif etmek için tıklayabileceğin bağlantıyı tekrar gönderelim.</t></small>
        </div>

        @if (submitted)
        {
            <div class="alert @(success ? "alert-success" : "alert-warning") py-2 small">@message</div>
        }

        <form method="post">
            <div class="mb-3">
                <label class="form-label small"><t key="salon.account.email">E-posta</t></label>
                <input type="email" name="email" value="@email" class="form-control" required autofocus />
            </div>
            <button type="submit" class="btn btn-purple w-100"><t key="salon.public.resendverification.auto.maili_tekrar_gonder">Maili Tekrar Gönder</t></button>
        </form>
    </div>
</body>
</html>
