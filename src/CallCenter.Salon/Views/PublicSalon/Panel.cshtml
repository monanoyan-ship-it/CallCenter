@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    Layout = null;
    var panelLang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var panelTranslations = await Translation.GetAllAsync(panelLang);
    var panelTranslationsJson = System.Text.Json.JsonSerializer.Serialize(panelTranslations);
}
<!DOCTYPE html>
<html lang="@panelLang">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(Translation.T("salon.panel.title", "Panelim")) - CorpLynk Salon</title>
    <link href="/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: #f0f2f5; font-family: 'Segoe UI', system-ui, sans-serif; }
        .topbar { background: linear-gradient(135deg, #2d1b3d 0%, #1a1028 100%); color: #fff; padding: 1rem 1.5rem; }
        .topbar a { color: rgba(255,255,255,.7); text-decoration: none; }
        .topbar a:hover { color: #fff; }
        .section-card { border: none; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,.06); }
    </style>
</head>
<body>
    <div id="panel-data"
         hidden
         data-lang="@panelLang"
         data-translations="@panelTranslationsJson"></div>
    <div class="topbar d-flex justify-content-between align-items-center">
        <div>
            <i class="bi bi-scissors me-1"></i><strong>CorpLynk</strong> <span style="color:#ce93d8;"><t key="salon.public.panel.auto.salon">Salon</t></span>
        </div>
        <div>
            <span class="me-3 small" id="userName"></span>
            <a href="/discover"><i class="bi bi-search me-1"></i><t key="salon.panel.nav.discover">Keşfet</t></a>
            <a href="#" class="ms-3" data-panel-action="logout"><i class="bi bi-box-arrow-right me-1"></i><t key="salon.common.logout_tooltip">Çıkış</t></a>
        </div>
    </div>

    <div class="container py-4" id="panel">
        <!-- Tabs -->
        <ul class="nav nav-pills mb-3">
            <li class="nav-item"><a class="nav-link active" data-bs-toggle="pill" href="#tabSalons"><i class="bi bi-shop me-1"></i><t key="salon.panel.tabs.salons">Salonlarım</t></a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="pill" href="#tabAppointments"><i class="bi bi-calendar-check me-1"></i><t key="salon.panel.tabs.appointments">Randevularım</t></a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="pill" href="#tabLoyalty"><i class="bi bi-star me-1"></i><t key="salon.panel.tabs.loyalty">Sadakat</t></a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="pill" href="#tabProfile"><i class="bi bi-person me-1"></i><t key="salon.panel.tabs.profile">Profilim</t></a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="pill" href="#tabBilling"><i class="bi bi-receipt me-1"></i><t key="salon.panel.tabs.billing">Fatura Bilgileri</t></a></li>
        </ul>

        <div class="tab-content">
            <!-- Salonlarım -->
            <div class="tab-pane fade show active" id="tabSalons">
                <div class="row g-3" id="salonList"></div>
                <div class="text-center text-muted py-4" id="noSalons" style="display:none;">
                    <i class="bi bi-shop fs-1 d-block mb-2 opacity-25"></i>
                    <t key="salon.panel.empty.salons">Henüz bir salona üye değilsiniz.</t> <a href="/discover"><t key="salon.panel.empty.salons_link">Salonları keşfedin!</t></a>
                </div>
            </div>

            <!-- Randevularım -->
            <div class="tab-pane fade" id="tabAppointments">
                <div class="d-flex gap-2 mb-3">
                    <button class="btn btn-sm btn-primary" data-panel-action="load-appointments" data-past="false"><t key="salon.panel.appointments.upcoming">Yaklaşan</t></button>
                    <button class="btn btn-sm btn-outline-secondary" data-panel-action="load-appointments" data-past="true"><t key="salon.panel.appointments.past">Geçmiş</t></button>
                </div>
                <div id="appointmentList"></div>
                <div class="text-center text-muted py-4" id="noAppts" style="display:none;"><t key="salon.panel.empty.appointments">Randevu bulunamadı.</t></div>
            </div>

            <!-- İptal Onay Modalı -->
            <div class="modal fade" id="cancelModal" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header py-2" style="background:linear-gradient(135deg,#2d1b3d 0%,#4a1a6b 100%);color:#fff;">
                            <h6 class="modal-title"><i class="bi bi-x-circle me-2"></i><t key="salon.panel.cancel.title">Randevu İptali</t></h6>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p id="cancelModalMsg" class="mb-0"></p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.panel.cancel.keep">Vazgeç</t></button>
                            <button type="button" class="btn btn-danger btn-sm" id="cancelModalConfirmBtn"><i class="bi bi-x-lg me-1"></i><t key="salon.panel.cancel.confirm">İptal Et</t></button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Yorum Modalı -->
            <div class="modal fade" id="reviewModal" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header py-2" style="background:linear-gradient(135deg,#2d1b3d 0%,#4a1a6b 100%);color:#fff;">
                            <h6 class="modal-title"><i class="bi bi-star me-2"></i><t key="salon.panel.review.title">Yorum Yaz</t></h6>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="small text-muted mb-3" id="reviewSalonName"></div>
                            <label class="form-label small"><t key="salon.panel.review.rating">Puan</t></label>
                            <select class="form-select form-select-sm mb-3" id="reviewRating">
                                <option value="5">5</option>
                                <option value="4">4</option>
                                <option value="3">3</option>
                                <option value="2">2</option>
                                <option value="1">1</option>
                            </select>
                            <label class="form-label small"><t key="salon.panel.review.comment">Yorumunuz</t></label>
                            <textarea class="form-control form-control-sm" rows="4" id="reviewComment" maxlength="1000"></textarea>
                            <div class="form-text"><t key="salon.panel.review.note">Yorumunuz salon onayından sonra yayınlanır.</t></div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                            <button type="button" class="btn btn-primary btn-sm" data-panel-action="submit-review"><i class="bi bi-send me-1"></i><t key="salon.panel.review.submit">Gönder</t></button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sadakat -->
            <div class="tab-pane fade" id="tabLoyalty">
                <div id="loyaltyList"></div>
                <div class="text-center text-muted py-4" id="noLoyalty" style="display:none;"><t key="salon.panel.empty.loyalty">Sadakat bilgisi bulunamadı.</t></div>
            </div>

            <!-- Profilim -->
            <div class="tab-pane fade" id="tabProfile">
                <div class="card section-card">
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label small"><t key="salon.panel.profile.fullname">Ad Soyad</t></label>
                            <input type="text" class="form-control" id="profName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small"><t key="salon.panel.profile.email">E-posta</t></label>
                            <input type="email" class="form-control" id="profEmail" />
                        </div>
                        <button class="btn btn-primary btn-sm" data-panel-action="save-profile"><i class="bi bi-check-lg me-1"></i><t key="salon.common.btn.save">Kaydet</t></button>
                    </div>
                </div>
                <div class="card section-card mt-3">
                    <div class="card-body">
                        <h6 class="text-muted small mb-3"><i class="bi bi-key me-1"></i><t key="salon.panel.password.title">Şifre değiştir</t></h6>
                        <div class="mb-2">
                            <label class="form-label small"><t key="salon.panel.password.current">Mevcut şifre</t></label>
                            <input type="password" class="form-control form-control-sm" id="pwdCurrent" autocomplete="current-password" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small"><t key="salon.panel.password.new">Yeni şifre</t></label>
                            <input type="password" class="form-control form-control-sm" id="pwdNew" autocomplete="new-password" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small"><t key="salon.panel.password.repeat">Yeni şifre (tekrar)</t></label>
                            <input type="password" class="form-control form-control-sm" id="pwdNew2" autocomplete="new-password" />
                        </div>
                        <button type="button" class="btn btn-outline-primary btn-sm" data-panel-action="change-password"><i class="bi bi-shield-lock me-1"></i><t key="salon.panel.password.update">Şifreyi güncelle</t></button>
                    </div>
                </div>
            </div>
            <!-- Fatura Bilgileri -->
            <div class="tab-pane fade" id="tabBilling">
                <div class="card section-card">
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label small"><t key="salon.panel.billing.type">Fatura Tipi</t></label>
                            <select class="form-select form-select-sm" id="billingType" data-panel-action="toggle-billing-type">
                                <option value="1"><t key="salon.panel.billing.type.individual">Bireysel</t></option>
                                <option value="2"><t key="salon.panel.billing.type.corporate">Kurumsal</t></option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small"><t key="salon.panel.profile.fullname">Ad Soyad</t></label>
                            <input type="text" class="form-control form-control-sm" id="billingFullName" />
                        </div>
                        <div id="corporateFields" style="display:none;">
                            <div class="mb-2">
                                    <label class="form-label small"><t key="salon.panel.billing.company_name">Firma Adı</t></label>
                                <input type="text" class="form-control form-control-sm" id="billingCompanyName" />
                            </div>
                            <div class="row g-2">
                                <div class="col-6 mb-2">
                                    <label class="form-label small"><t key="salon.panel.billing.tax_office">Vergi Dairesi</t></label>
                                    <input type="text" class="form-control form-control-sm" id="billingTaxOffice" />
                                </div>
                                <div class="col-6 mb-2">
                                    <label class="form-label small"><t key="salon.panel.billing.tax_number">Vergi No</t></label>
                                    <input type="text" class="form-control form-control-sm" id="billingTaxNumber" />
                                </div>
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small"><t key="salon.panel.billing.address">Adres</t></label>
                            <input type="text" class="form-control form-control-sm" id="billingAddress" />
                        </div>
                        <div class="row g-2">
                            <div class="col-4 mb-2">
                                <label class="form-label small"><t key="salon.panel.billing.city">İl</t></label>
                                <input type="text" class="form-control form-control-sm" id="billingCity" />
                            </div>
                            <div class="col-4 mb-2">
                                <label class="form-label small"><t key="salon.panel.billing.district">İlçe</t></label>
                                <input type="text" class="form-control form-control-sm" id="billingDistrict" />
                            </div>
                            <div class="col-4 mb-2">
                                <label class="form-label small"><t key="salon.panel.billing.postal_code">Posta Kodu</t></label>
                                <input type="text" class="form-control form-control-sm" id="billingPostalCode" />
                            </div>
                        </div>
                        <button class="btn btn-primary btn-sm" data-panel-action="save-billing"><i class="bi bi-check-lg me-1"></i><t key="salon.common.btn.save">Kaydet</t></button>
                    </div>
                </div>
                <div class="card section-card mt-3">
                    <div class="card-body">
                        <h6 class="text-muted small mb-2"><i class="bi bi-receipt-cutoff me-1"></i><t key="salon.panel.payments.title">Ödeme geçmişi ve dekontlar</t></h6>
                        <p class="small text-muted mb-3"><t key="salon.panel.payments.desc">Tamamlanan veya iade edilen ödemeler için dekontu indirebilirsiniz. HTML dosyasını açıp tarayıcıdan Yazdır ile PDF olarak kaydedebilirsiniz.</t></p>
                        <div id="paymentHistoryList"></div>
                        <div class="text-center text-muted py-3" id="noPayments" style="display:none;"><t key="salon.panel.payments.empty">Henüz ödeme kaydı yok.</t></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Health Modal -->
    <div class="modal fade" id="healthModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header py-2" style="background:linear-gradient(135deg,#2d1b3d 0%,#4a1a6b 100%);color:#fff;">
                    <h6 class="modal-title"><i class="bi bi-heart-pulse me-2"></i><t key="salon.panel.health.title">Sağlık Bilgilerim</t></h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="small text-muted mb-3" id="healthSalonName"></div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small"><t key="salon.clients.health.skin_type">Cilt Tipi</t></label>
                            <input type="text" class="form-control form-control-sm" id="healthSkinType" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small"><t key="salon.clients.health.skin_sensitivity">Cilt Hassasiyeti</t></label>
                            <input type="text" class="form-control form-control-sm" id="healthSkinSensitivity" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small"><t key="salon.clients.health.allergies">Alerjiler</t></label>
                            <textarea class="form-control form-control-sm" rows="3" id="healthAllergies"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small"><t key="salon.clients.health.contraindications">Kontraendikasyonlar</t></label>
                            <textarea class="form-control form-control-sm" rows="3" id="healthContraindications"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.clients.health.medical_notes">Sağlık Notları</t></label>
                            <textarea class="form-control form-control-sm" rows="3" id="healthMedicalNotes"></textarea>
                        </div>
                    </div>
                    <div class="alert alert-info py-2 small mt-3 mb-0">
                        <i class="bi bi-info-circle me-1"></i><t key="salon.panel.health.review_note">Kaydettiğinizde bilgiler salona inceleme uyarısı olarak iletilir.</t>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-panel-action="save-health"><i class="bi bi-check-lg me-1"></i><t key="salon.common.btn.save">Kaydet</t></button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index:9999">
        <div id="appToast" class="toast align-items-center border-0" role="alert">
            <div class="d-flex">
                <div class="toast-body fw-semibold" id="appToastMsg"></div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/PublicPanel.js" asp-append-version="true"></script>
</body>
</html>
