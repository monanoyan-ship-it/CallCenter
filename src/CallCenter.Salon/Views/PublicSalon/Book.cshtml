@{
    Layout = null;
    var slug = (string)ViewData["Slug"]!;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Online Randevu - CorpLynk Salon</title>
    <meta name="robots" content="noindex" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: #f5f5f5; font-family: 'Segoe UI', system-ui, sans-serif; }
        .step-indicator { display: flex; gap: .5rem; margin-bottom: 2rem; }
        .step { flex: 1; text-align: center; padding: .4rem .2rem; border-radius: 8px; background: #e9ecef; font-size: .78rem; }
        .step.active { background: #7b1fa2; color: #fff; font-weight: 600; }
        .step.done { background: #4caf50; color: #fff; }
        .service-option { cursor: pointer; border: 2px solid transparent; transition: .15s; }
        .service-option:hover { border-color: #ce93d8; }
        .service-option.selected { border-color: #7b1fa2; background: #f3e5f5; }
        .staff-card { cursor: pointer; border: 2px solid transparent; transition: .15s; text-align: center; }
        .staff-card:hover { border-color: #ce93d8; }
        .staff-card.selected { border-color: #7b1fa2; background: #f3e5f5; }
        .staff-avatar { width: 56px; height: 56px; border-radius: 50%; background: #e9ecef; display: flex; align-items: center; justify-content: center; margin: 0 auto .5rem; overflow: hidden; }
        .staff-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .category-header { cursor: pointer; user-select: none; display: flex; align-items: center; justify-content: space-between; padding: .5rem .75rem; border-radius: 8px; background: #f8f9fa; }
        .category-header:hover { background: #ede7f6; }
        .slot-btn { min-width: 80px; }
        .slot-btn.selected { background: #7b1fa2 !important; color: #fff !important; border-color: #7b1fa2 !important; }
        .btn-purple { background: #7b1fa2; border: none; color: #fff; }
        .btn-purple:hover { background: #6a1b9a; color: #fff; }
        .policy-info { background: #fff3e0; border-left: 4px solid #ff9800; border-radius: 4px; }
    </style>
</head>
<body>
    <div style="position:absolute;top:10px;right:10px;">
        <div style="display:inline-block;position:relative;">
            <span style="cursor:pointer;color:#7b1fa2;font-size:.85rem;" onclick="this.nextElementSibling.style.display=this.nextElementSibling.style.display==='block'?'none':'block'">
                <i class="bi bi-translate"></i>
            </span>
            <div style="display:none;position:absolute;right:0;top:100%;background:#fff;border:1px solid #ddd;border-radius:8px;padding:4px 0;min-width:140px;z-index:1000;box-shadow:0 4px 12px rgba(0,0,0,.15);">
                <a href="javascript:void(0)" onclick="document.cookie='.AspNetCore.Culture=c=tr|uic=tr;path=/;max-age=31536000';location.reload();" style="display:block;padding:4px 12px;color:#333;text-decoration:none;font-size:.85rem;">TR — Türkçe</a>
                <a href="javascript:void(0)" onclick="document.cookie='.AspNetCore.Culture=c=en|uic=en;path=/;max-age=31536000';location.reload();" style="display:block;padding:4px 12px;color:#333;text-decoration:none;font-size:.85rem;">EN — English</a>
                <a href="javascript:void(0)" onclick="document.cookie='.AspNetCore.Culture=c=de|uic=de;path=/;max-age=31536000';location.reload();" style="display:block;padding:4px 12px;color:#333;text-decoration:none;font-size:.85rem;">DE — Deutsch</a>
                <a href="javascript:void(0)" onclick="document.cookie='.AspNetCore.Culture=c=ar|uic=ar;path=/;max-age=31536000';location.reload();" style="display:block;padding:4px 12px;color:#333;text-decoration:none;font-size:.85rem;">AR — العربية</a>
                <a href="javascript:void(0)" onclick="document.cookie='.AspNetCore.Culture=c=ru|uic=ru;path=/;max-age=31536000';location.reload();" style="display:block;padding:4px 12px;color:#333;text-decoration:none;font-size:.85rem;">RU — Русский</a>
            </div>
        </div>
    </div>
    <div class="container py-4" style="max-width: 640px;" id="book-vm">
        <a href="/salon/@slug" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left me-1"></i><t key="salon.book.back">Salon Profiline Dön</t></a>
        <h4 class="mt-2 mb-3"><i class="bi bi-calendar-check me-2" style="color:#7b1fa2;"></i><t key="salon.book.title">Online Randevu</t></h4>
        <div class="text-muted small mb-3" data-bind="text: salonName"></div>

        <!-- Adimlar -->
        <div class="step-indicator">
            <div class="step" data-bind="css: { active: currentStep() === 1, done: currentStep() > 1 }">1. <t key="salon.book.step1">Hizmet</t></div>
            <div class="step" data-bind="css: { active: currentStep() === 2, done: currentStep() > 2 }">2. <t key="salon.book.step.staff">Personel</t></div>
            <div class="step" data-bind="css: { active: currentStep() === 3, done: currentStep() > 3 }">3. <t key="salon.book.step2">Tarih &amp; Saat</t></div>
            <div class="step" data-bind="css: { active: currentStep() === 4, done: currentStep() > 4 }">4. <t key="salon.book.step3">Bilgiler</t></div>
            <div class="step" data-bind="css: { active: currentStep() === 5 }">5. <t key="salon.book.step4">Onay</t></div>
        </div>

        <!-- Adim 1: Hizmet Sec (Accordion) -->
        <div data-bind="visible: currentStep() === 1">
            <!-- ko foreach: categories -->
            <div class="mb-2">
                <div class="category-header" data-bind="click: $root.toggleCategory">
                    <h6 class="mb-0" style="color:#7b1fa2;">
                        <i class="bi me-1" data-bind="css: iconClass || 'bi-tag'"></i>
                        <span data-bind="text: name"></span>
                        <span class="badge bg-secondary ms-2" data-bind="text: services.length" style="font-size:.7rem;"></span>
                    </h6>
                    <i class="bi" data-bind="css: $root.expandedCategoryId() === id ? 'bi-chevron-up' : 'bi-chevron-down'"></i>
                </div>
                <!-- ko if: $root.expandedCategoryId() === id -->
                <div class="mt-1">
                    <!-- ko foreach: services -->
                    <div class="card border-0 shadow-sm mb-2 service-option" data-bind="click: $root.selectService, css: { selected: $root.selectedServiceId() === id }">
                        <div class="card-body py-2 px-3 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-semibold small" data-bind="text: name"></span>
                                <small class="text-muted ms-2" data-bind="text: durationMinutes + ' dk'"></small>
                            </div>
                            <span class="fw-bold text-primary" data-bind="text: price.toLocaleString('tr-TR') + ' TL'"></span>
                        </div>
                    </div>
                    <!-- /ko -->
                </div>
                <!-- /ko -->
            </div>
            <!-- /ko -->
        </div>

        <!-- Adim 2: Personel Sec -->
        <div data-bind="visible: currentStep() === 2">
            <div data-bind="visible: staffLoading()" class="text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
            <div data-bind="visible: !staffLoading()">
                <!-- Fark etmez secenegi -->
                <div class="card border-0 shadow-sm mb-3 staff-card" data-bind="click: function() { selectedStaffId(null); }, css: { selected: selectedStaffId() === null }">
                    <div class="card-body py-3">
                        <div class="staff-avatar">
                            <i class="bi bi-shuffle" style="font-size:1.5rem;color:#7b1fa2;"></i>
                        </div>
                        <div class="fw-semibold small"><t key="salon.book.any_staff">Fark Etmez</t></div>
                        <div class="text-muted" style="font-size:.75rem;"><t key="salon.book.any_staff_desc">Uygun personel atanacak</t></div>
                    </div>
                </div>
                <div class="row g-2">
                    <!-- ko foreach: availableStaff -->
                    <div class="col-6">
                        <div class="card border-0 shadow-sm staff-card" data-bind="click: $root.selectStaff, css: { selected: $root.selectedStaffId() === id }">
                            <div class="card-body py-3">
                                <div class="staff-avatar">
                                    <!-- ko if: photoUrl -->
                                    <img data-bind="attr: { src: photoUrl }" />
                                    <!-- /ko -->
                                    <!-- ko ifnot: photoUrl -->
                                    <i class="bi bi-person" style="font-size:1.5rem;color:#999;"></i>
                                    <!-- /ko -->
                                </div>
                                <div class="fw-semibold small" data-bind="text: name"></div>
                                <div class="text-muted" style="font-size:.75rem;" data-bind="text: title || specialty || ''"></div>
                            </div>
                        </div>
                    </div>
                    <!-- /ko -->
                </div>
                <div data-bind="visible: availableStaff().length === 0 && !staffLoading()" class="text-center text-muted py-3">
                    <i class="bi bi-person-x" style="font-size:2rem;opacity:.3;"></i>
                    <p class="mt-2 small"><t key="salon.book.no_staff">Bu hizmet için uygun personel bulunamadı</t></p>
                </div>
            </div>
        </div>

        <!-- Adim 3: Tarih & Saat -->
        <div data-bind="visible: currentStep() === 3">
            <div class="mb-3">
                <label class="form-label small fw-semibold"><t key="salon.book.select_date">Tarih Seçin</t></label>
                <input type="date" class="form-control" data-bind="value: selectedDate" />
            </div>
            <div data-bind="visible: slots().length > 0">
                <label class="form-label small fw-semibold"><t key="salon.book.available_times">Müsait Saatler</t></label>
                <div class="d-flex flex-wrap gap-2">
                    <!-- ko foreach: slots -->
                    <button class="btn btn-outline-secondary btn-sm slot-btn"
                            data-bind="text: label, click: $root.selectSlot, css: { selected: $root.selectedSlot() === startTime }"></button>
                    <!-- /ko -->
                </div>
            </div>
            <div data-bind="visible: slotsLoaded() && slots().length === 0" class="text-center text-muted py-4">
                <i class="bi bi-calendar-x" style="font-size:2rem;opacity:.3;"></i>
                <p class="mt-2 small"><t key="salon.book.no_slots">Bu tarih için müsait saat bulunamadı</t></p>
            </div>
        </div>

        <!-- Adim 4: Bilgiler -->
        <div data-bind="visible: currentStep() === 4">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label small"><t key="salon.book.fullname">Ad Soyad *</t></label>
                    <input type="text" class="form-control" data-bind="value: form.fullName" />
                </div>
                <div class="col-6">
                    <label class="form-label small"><t key="salon.book.phone">Telefon *</t></label>
                    <div data-bind="phoneInput: form.phone"></div>
                </div>
                <div class="col-6">
                    <label class="form-label small"><t key="salon.book.email">E-posta</t></label>
                    <input type="email" class="form-control" data-bind="value: form.email" />
                </div>
                <div class="col-12">
                    <label class="form-label small"><t key="salon.book.notes">Notlar (isteğe bağlı)</t></label>
                    <textarea class="form-control" rows="2" data-bind="value: form.notes"></textarea>
                </div>
            </div>
        </div>

        <!-- Adim 5: Onay -->
        <div data-bind="visible: currentStep() === 5">
            <!-- ko if: !bookingDone() -->
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="mb-3"><t key="salon.book.summary">Randevu Özeti</t></h6>
                    <table class="table table-sm table-borderless mb-0">
                        <tr><td class="text-muted"><t key="salon.book.summary.service">Hizmet</t></td><td class="fw-semibold" data-bind="text: selectedServiceName()"></td></tr>
                        <tr><td class="text-muted"><t key="salon.book.summary.staff">Personel</t></td><td data-bind="text: selectedStaffName()"></td></tr>
                        <tr><td class="text-muted"><t key="salon.book.summary.date">Tarih</t></td><td data-bind="text: formattedDate()"></td></tr>
                        <tr><td class="text-muted"><t key="salon.book.summary.time">Saat</t></td><td data-bind="text: selectedSlotLabel()"></td></tr>
                        <tr><td class="text-muted"><t key="salon.book.summary.price">Fiyat</t></td><td class="fw-bold text-primary" data-bind="text: selectedServicePrice()"></td></tr>
                        <tr><td class="text-muted"><t key="salon.book.summary.name">Ad Soyad</t></td><td data-bind="text: form.fullName()"></td></tr>
                        <tr><td class="text-muted"><t key="salon.book.summary.phone">Telefon</t></td><td data-bind="text: form.phone()"></td></tr>
                    </table>
                </div>
            </div>

            <!-- Depozito / Politika bilgisi -->
            <!-- ko if: bookingPolicy() && bookingPolicy().hasPolicy -->
            <div class="policy-info p-3 mt-3">
                <h6 class="mb-2"><i class="bi bi-info-circle me-1"></i><t key="salon.book.policy.title">Randevu Politikası</t></h6>
                <!-- ko if: bookingPolicy().requireDeposit && bookingPolicy().depositAmount > 0 -->
                <p class="small mb-1">
                    <i class="bi bi-cash me-1"></i>
                    <t key="salon.book.policy.deposit">Depozito gerekli</t>:
                    <strong data-bind="text: bookingPolicy().depositAmount.toLocaleString('tr-TR') + ' TL'"></strong>
                </p>
                <!-- /ko -->
                <!-- ko if: bookingPolicy().freeCancellationHours > 0 -->
                <p class="small mb-1">
                    <i class="bi bi-clock me-1"></i>
                    <t key="salon.book.policy.cancel">Ücretsiz iptal süresi:</t>
                    <strong data-bind="text: bookingPolicy().freeCancellationHours"></strong>
                    <t key="salon.book.policy.hours_before">saat öncesine kadar</t>
                </p>
                <!-- /ko -->
                <!-- ko if: bookingPolicy().noShowFee > 0 -->
                <p class="small mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    <t key="salon.book.policy.noshow">Gelmeme cezası</t>:
                    <strong data-bind="text: bookingPolicy().noShowFee.toLocaleString('tr-TR') + ' TL'"></strong>
                </p>
                <!-- /ko -->
            </div>
            <!-- /ko -->
            <!-- /ko -->

            <!-- ko if: bookingDone() -->
            <div class="text-center py-4">
                <i class="bi bi-check-circle-fill text-success" style="font-size:4rem;"></i>
                <h4 class="mt-3"><t key="salon.book.success.title">Randevunuz Oluşturuldu!</t></h4>
                <p class="text-muted"><t key="salon.book.success.desc">Salon tarafından onaylanacaktır. Telefonunuzu kontrol edin.</t></p>
                <a href="/salon/@slug" class="btn btn-outline-primary btn-sm mt-2"><t key="salon.book.back">Salon Profiline Dön</t></a>
                <a href="/user/panel" class="btn btn-primary btn-sm mt-2 ms-2"><t key="salon.book.my_appointments">Randevularım</t></a>
            </div>
            <!-- /ko -->
        </div>

        <!-- Navigation -->
        <div class="d-flex justify-content-between mt-4" data-bind="visible: !bookingDone()">
            <button class="btn btn-outline-secondary" data-bind="visible: currentStep() > 1, click: prevStep">
                <i class="bi bi-arrow-left me-1"></i><t key="salon.book.btn.back">Geri</t>
            </button>
            <span data-bind="visible: currentStep() <= 1"></span>
            <button class="btn btn-purple" data-bind="visible: currentStep() < 5, click: nextStep, disable: !canProceed()">
                <t key="salon.book.btn.next">İleri</t><i class="bi bi-arrow-right ms-1"></i>
            </button>
            <button class="btn btn-purple" data-bind="visible: currentStep() === 5 && !bookingDone(), click: confirmBooking, disable: isSaving">
                <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                <t key="salon.book.btn.confirm">Randevu Al</t>
            </button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/knockout@3.5.1/build/output/knockout-latest.min.js"></script>
    <script src="/js/phone-input.js"></script>
    <script>
        var bookSlug = '@slug';

        // Auth kontrolu
        if (!localStorage.getItem('platformToken')) {
            window.location.href = '/user/login?returnUrl=' + encodeURIComponent(window.location.pathname);
        }

        function BookViewModel() {
            var self = this;
            self.salonName = ko.observable('');
            self.categories = ko.observableArray([]);
            self.expandedCategoryId = ko.observable(null);
            self.selectedServiceId = ko.observable(null);

            // Staff
            self.availableStaff = ko.observableArray([]);
            self.staffLoading = ko.observable(false);
            self.selectedStaffId = ko.observable(null); // null = fark etmez

            // Date & Time
            self.selectedDate = ko.observable(new Date().toISOString().substring(0, 10));
            self.slots = ko.observableArray([]);
            self.slotsLoaded = ko.observable(false);
            self.selectedSlot = ko.observable(null);

            // Step
            self.currentStep = ko.observable(1);
            self.isSaving = ko.observable(false);
            self.bookingDone = ko.observable(false);

            // Policy
            self.bookingPolicy = ko.observable(null);

            self.form = {
                fullName: ko.observable(''),
                phone: ko.observable(''),
                email: ko.observable(''),
                notes: ko.observable('')
            };

            // Computed
            self.selectedServiceName = ko.computed(function () {
                var id = self.selectedServiceId();
                if (!id) return '';
                var found = '';
                self.categories().forEach(function (c) {
                    c.services.forEach(function (s) { if (s.id === id) found = s.name; });
                });
                return found;
            });

            self.selectedServicePrice = ko.computed(function () {
                var id = self.selectedServiceId();
                if (!id) return '';
                var price = 0;
                self.categories().forEach(function (c) {
                    c.services.forEach(function (s) { if (s.id === id) price = s.price; });
                });
                return price > 0 ? price.toLocaleString('tr-TR') + ' TL' : '';
            });

            self.selectedStaffName = ko.computed(function () {
                var id = self.selectedStaffId();
                if (id === null) return 'Fark etmez';
                var staff = self.availableStaff().find(function (s) { return s.id === id; });
                return staff ? staff.name : '';
            });

            self.formattedDate = ko.computed(function () {
                var d = self.selectedDate();
                if (!d) return '';
                var dt = new Date(d + 'T00:00:00');
                return dt.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric', weekday: 'long' });
            });

            self.selectedSlotLabel = ko.computed(function () {
                var st = self.selectedSlot();
                if (!st) return '';
                var s = self.slots().find(function (x) { return x.startTime === st; });
                return s ? s.label : '';
            });

            self.canProceed = ko.computed(function () {
                var step = self.currentStep();
                if (step === 1) return !!self.selectedServiceId();
                if (step === 2) return true; // null = fark etmez, her zaman gecerli
                if (step === 3) return !!self.selectedSlot();
                if (step === 4) return !!self.form.fullName() && !!self.form.phone();
                return true;
            });

            // Giris yapan kullanicinin bilgilerini doldur
            var platformUser = null;
            try { platformUser = JSON.parse(localStorage.getItem('platformUser') || 'null'); } catch (e) {}
            if (platformUser) {
                self.form.fullName(platformUser.fullName || '');
                self.form.phone(platformUser.phone || '');
                self.form.email(platformUser.email || '');
            }

            // Load salon
            fetch('/proxy/salon/' + bookSlug)
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    self.salonName(data.salonName);
                    self.categories(data.serviceCategories || []);
                    document.title = 'Randevu - ' + data.salonName;
                    // Ilk kategoriyi ac
                    if (data.serviceCategories && data.serviceCategories.length > 0) {
                        self.expandedCategoryId(data.serviceCategories[0].id);
                    }
                });

            // Load booking policy
            fetch('/proxy/salon/' + bookSlug + '/booking-policy')
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (data) { if (data) self.bookingPolicy(data); });

            // Category accordion
            self.toggleCategory = function (category) {
                self.expandedCategoryId(self.expandedCategoryId() === category.id ? null : category.id);
            };

            self.selectService = function (svc) {
                self.selectedServiceId(svc.id);
                // Kategoriyi sec ve bir sonraki adima hazirla
            };

            self.selectStaff = function (staff) { self.selectedStaffId(staff.id); };

            // Load staff for selected service
            self.loadStaff = function () {
                var sid = self.selectedServiceId();
                if (!sid) return;
                self.staffLoading(true);
                self.availableStaff([]);
                self.selectedStaffId(null);
                fetch('/proxy/salon/' + bookSlug + '/available-staff?serviceId=' + sid)
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        self.availableStaff(data || []);
                        self.staffLoading(false);
                    })
                    .catch(function () { self.staffLoading(false); });
            };

            self.selectedDate.subscribe(function () { self.loadSlots(); });

            self.loadSlots = function () {
                var sid = self.selectedServiceId();
                var date = self.selectedDate();
                if (!sid || !date) return;
                self.slotsLoaded(false);
                self.selectedSlot(null);

                fetch('/proxy/salon/' + bookSlug + '/available-slots?serviceId=' + sid + '&date=' + date)
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        var items = data.map(function (s) {
                            var d = new Date(s.startTime);
                            return { startTime: s.startTime, label: d.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }) };
                        });
                        self.slots(items);
                        self.slotsLoaded(true);
                    });
            };

            self.selectSlot = function (slot) { self.selectedSlot(slot.startTime); };

            self.nextStep = function () {
                if (!self.canProceed()) return;
                var step = self.currentStep();
                if (step === 1) { self.loadStaff(); }
                if (step === 2) { self.loadSlots(); }
                self.currentStep(step + 1);
            };

            self.prevStep = function () { self.currentStep(self.currentStep() - 1); };

            self.confirmBooking = function () {
                self.isSaving(true);
                var payload = {
                    fullName: self.form.fullName(),
                    phone: self.form.phone(),
                    email: self.form.email(),
                    serviceId: self.selectedServiceId(),
                    startTime: self.selectedSlot(),
                    notes: self.form.notes()
                };
                if (self.selectedStaffId() !== null) {
                    payload.personnelId = self.selectedStaffId();
                }
                fetch('/proxy/salon/' + bookSlug + '/book', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                })
                .then(function (r) { return r.json(); })
                .then(function () {
                    self.bookingDone(true);
                    self.isSaving(false);
                })
                .catch(function () {
                    alert('Bir hata olustu. Lutfen tekrar deneyin.');
                    self.isSaving(false);
                });
            };
        }

        ko.applyBindings(new BookViewModel(), document.getElementById('book-vm'));
    </script>
</body>
</html>
