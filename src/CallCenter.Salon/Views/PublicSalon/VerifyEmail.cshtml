@{
    ViewData["Title"] = "Email Doğrulama";
    Layout = null;
    var success = ViewBag.Success != null && (bool)ViewBag.Success;
    var message = ViewBag.Message as string ?? "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CorpLynk - Email Doğrulama</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: linear-gradient(135deg, #2d1b3d 0%, #1a1028 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .card-wrap { background: #fff; border-radius: 12px; padding: 2.5rem; max-width: 440px; width: 100%; box-shadow: 0 8px 32px rgba(0,0,0,.2); text-align: center; }
        .brand { color: #2d1b3d; font-weight: 700; font-size: 1.5rem; }
        .brand span { color: #ce93d8; }
        .btn-purple { background: #7b1fa2; border: none; color: #fff; }
        .btn-purple:hover { background: #6a1b9a; color: #fff; }
        .icon-status { font-size: 3rem; }
    </style>
</head>
<body>
    <div class="card-wrap">
        <div class="brand mb-4"><i class="bi bi-scissors me-2"></i>CorpLynk <span>Salon</span></div>
        @if (success)
        {
            <i class="bi bi-check-circle-fill icon-status text-success mb-3 d-block"></i>
            <h5 class="mb-3">Email doğrulandı</h5>
            <p class="text-muted small mb-4">@message</p>
            <a href="/user/login" class="btn btn-purple w-100">Giriş Yap</a>
        }
        else
        {
            <i class="bi bi-exclamation-triangle-fill icon-status text-warning mb-3 d-block"></i>
            <h5 class="mb-3">Doğrulama başarısız</h5>
            <p class="text-muted small mb-4">@message</p>
            <a href="/user/resend-verification" class="btn btn-purple w-100">Doğrulama Mailini Tekrar Gönder</a>
            <a href="/user/login" class="btn btn-link mt-2 small text-muted">Giriş sayfasına dön</a>
        }
    </div>
</body>
</html>
