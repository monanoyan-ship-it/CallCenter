@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    Layout = null;
    var pageLang = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    string T(string key, string fallback) => Translation.T(key, fallback);
}
<!DOCTYPE html>
<html lang="@pageLang">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@T("salon.publicsalon.auto.kayit_corplynk_salon", "Kayıt - CorpLynk Salon")</title>
    <link href="/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { background: linear-gradient(135deg, #2d1b3d 0%, #1a1028 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .auth-card { background: #fff; border-radius: 16px; padding: 2rem; max-width: 400px; width: 100%; box-shadow: 0 8px 32px rgba(0,0,0,.2); }
    </style>
</head>
<body>
    <div style="position:absolute;top:10px;right:10px;">
        @await Html.PartialAsync("_LanguageMenu", "auth")
    </div>
    <div class="auth-card">
        <div class="text-center mb-4">
            <i class="bi bi-scissors" style="font-size:2rem; color:#6f42c1;"></i>
            <h5 class="mt-2">CorpLynk <span style="color:#ce93d8;"><t key="salon.publicsalon.auto.salon">Salon</t></span></h5>
            <p class="text-muted small"><t key="salon.register.subtitle">Create a new account</t></p>
        </div>
        <div id="register-form"
             data-consent-required="@T("salon.publicsalon.register.consent_required", "Gizlilik Politikası ve Kullanım Koşullarını kabul etmelisiniz.")"
             data-register-failed="@T("salon.publicsalon.register_failed", "Kayıt başarısız.")"
             data-verify-required="@T("salon.register.verify_required", "Kaydınız alındı. Paneli açmadan önce e-posta adresinize gönderilen doğrulama bağlantısını onaylayın.")">
            <div class="mb-3">
                <label class="form-label small"><t key="salon.register.fullname">Full Name</t></label>
                <input type="text" class="form-control" id="fullName" />
            </div>
            <div class="mb-3">
                <label class="form-label small"><t key="salon.register.phone">Phone</t></label>
                <div class="input-group">
                    <select id="phoneCountry" class="form-select" style="max-width:120px;">
                        <option value="+90" selected>🇹🇷 +90</option>
                        <option value="+49">🇩🇪 +49</option>
                        <option value="+44">🇬🇧 +44</option>
                        <option value="+1">🇺🇸 +1</option>
                        <option value="+33">🇫🇷 +33</option>
                        <option value="+31">🇳🇱 +31</option>
                        <option value="+43">🇦🇹 +43</option>
                        <option value="+41">🇨🇭 +41</option>
                        <option value="+46">🇸🇪 +46</option>
                        <option value="+32">🇧🇪 +32</option>
                        <option value="+7">🇷🇺 +7</option>
                        <option value="+971">🇦🇪 +971</option>
                    </select>
                    <input type="tel" class="form-control" id="phone" placeholder="5XX XXX XX XX" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label small"><t key="salon.register.email">Email (optional)</t></label>
                <input type="email" class="form-control" id="email" />
            </div>
            <div class="mb-3">
                <label class="form-label small"><t key="salon.register.password">Password</t></label>
                <input type="password" class="form-control" id="password" />
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="kvkkConsent" />
                <label class="form-check-label small" for="kvkkConsent">
                    <a href="/privacy" target="_blank"><t key="salon.register.privacy_link">Privacy Policy and KVKK Notice</t></a> <t key="salon.register.and">and</t>
                    <a href="/terms" target="_blank"><t key="salon.register.terms_link">Terms of Use</t></a> — <t key="salon.register.accept">I have read and accept.</t>
                </label>
            </div>
            <div id="error-msg" class="alert alert-danger py-1 small d-none"></div>
            <div id="success-msg" class="alert alert-success py-1 small d-none"></div>
            <button class="btn btn-primary w-100" id="regBtn" type="button">
                <i class="bi bi-person-plus me-1"></i><t key="salon.register.btn">Sign Up</t>
            </button>
            <div class="text-center mt-3">
                <a href="/user/login" id="loginLink" class="small"><t key="salon.publicsalon.already_account">Zaten hesabınız var mı?</t> <strong><t key="salon.publicsalon.auto.giris_yapin">Giriş yapın</t></strong></a>
            </div>
            <div class="text-center mt-2">
                <a href="/discover" class="small text-muted"><i class="bi bi-search me-1"></i><t key="salon.publicsalon.discover_salons">Salonları Keşfet</t></a>
            </div>
        </div>
    </div>
    <script src="~/js/PublicAuthCommon.js" asp-append-version="true"></script>
    <script src="~/js/PublicRegister.js" asp-append-version="true"></script>
</body>
</html>
