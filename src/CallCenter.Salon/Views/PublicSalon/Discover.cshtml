@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    Layout = null;
    var pageLang = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    string T(string key, string fallback) => Translation.T(key, fallback);
}
<!DOCTYPE html>
<html lang="@pageLang">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@T("salon.discover.meta.title", "Online Salon Randevusu | Kuaför, Güzellik Merkezi Bul - CorpLynk")</title>
    <meta name="description" content="@T("salon.discover.meta.description", "Yakınındaki kuaför, güzellik merkezi ve spa salonlarını keşfet. Online randevu al, fiyatları karşılaştır. CorpLynk ile salon bulmak çok kolay.")" />
    <meta property="og:title" content="@T("salon.discover.meta.og_title", "Online Salon Randevusu | Kuaför ve Güzellik Merkezi Bul")" />
    <meta property="og:description" content="@T("salon.discover.meta.og_description", "Yakınındaki salonları keşfet, online randevu al. Kuaför, güzellik merkezi, spa - hepsi bir tıkla.")" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sln.corplynk.com/discover" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href="https://sln.corplynk.com/discover" />
    <meta name="keywords" content="@T("salon.discover.meta.keywords", "kuaför randevu, güzellik merkezi, online randevu, salon bul, yakınımdaki kuaför, saç kesim randevu, cilt bakımı, manikür pedikür")" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" rel="stylesheet" />
    <style>
        body { font-family: 'Segoe UI', system-ui, sans-serif; margin: 0; }
        .top-bar { background: linear-gradient(135deg, #2d1b3d 0%, #4a1a6b 100%); color: #fff; padding: .8rem 0; }
        .top-bar a { color: #ce93d8; text-decoration: none; }
        .top-bar a:hover { color: #fff; }
        #discoverMap { height: 400px; width: 100%; border-bottom: 3px solid #7b1fa2; }
        .salon-card { transition: .15s; cursor: pointer; border: 2px solid transparent; }
        .salon-card:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(0,0,0,.1) !important; border-color: #ce93d8; }
        .salon-logo { width: 48px; height: 48px; background: #e8e0f0; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
        .search-box { max-width: 400px; }
    </style>
</head>
<body>
    <div id="discover-vm">
        <!-- Top Bar -->
        <div class="top-bar">
            <div class="container d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-scissors me-2"></i>CorpLynk <span style="color:#ce93d8;">Salon</span></h5>
                <div class="d-flex align-items-center gap-2">
                    <span class="small"><t key="salon.discover.tagline">Yakındaki salonları keşfet</t></span>
                    <a href="/user/login" class="btn btn-sm btn-outline-light"><i class="bi bi-box-arrow-in-right me-1"></i><t key="salon.discover.login">Giriş Yap</t></a>
                </div>
                <div style="margin-left:8px;">
                    @await Html.PartialAsync("_LanguageMenu", "dark")
                </div>
            </div>
        </div>

        <!-- Harita -->
        <div id="discoverMap"></div>

        <!-- Arama + Liste -->
        <div class="container py-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0"><i class="bi bi-shop me-2"></i><t key="salon.discover.salons">Salonlar</t> <small class="text-muted" data-bind="text: '(' + filteredSalons().length + ')'"></small></h5>
                <div class="input-group search-box">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="@T("salon.discover.search_placeholder", "Salon veya şehir ara...")" data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
                </div>
            </div>

            <div class="text-center py-3" data-bind="visible: isLoading() || locationPending()">
                <div class="spinner-border text-primary"></div>
                <p class="small text-muted mt-2" data-bind="visible: locationPending() && !isLoading()">@T("salon.discover.location_pending", "Konumunuz belirleniyor...")</p>
            </div>

            <!-- ko if: !isLoading() && filteredSalons().length === 0 -->
            <div class="text-center text-muted py-5">
                <i class="bi bi-search" style="font-size:3rem;opacity:.3;"></i>
                <p class="mt-2"><t key="salon.discover.no_results">Salon bulunamadı.</t></p>
            </div>
            <!-- /ko -->

            <div class="row g-3" data-bind="foreach: filteredSalons">
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm salon-card h-100" data-bind="click: function() { window.location.href = '/salon/' + slug; }">
                        <div class="card-body d-flex gap-3">
                            <div class="salon-logo flex-shrink-0">
                                <!-- ko if: logoUrl -->
                                <img data-bind="attr: { src: logoUrl }" style="width:48px;height:48px;border-radius:50%;object-fit:cover;" />
                                <!-- /ko -->
                                <!-- ko if: !logoUrl -->
                                <i class="bi bi-scissors fs-5" style="color:#7b1fa2;"></i>
                                <!-- /ko -->
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="fw-bold mb-0" data-bind="text: branchName || salonName"></h6>
                                        <!-- ko if: branchName && salonName && branchName !== salonName -->
                                        <small class="text-muted" data-bind="text: salonName"></small>
                                        <!-- /ko -->
                                    </div>
                                    <!-- ko if: distanceText -->
                                    <span class="badge bg-primary-subtle text-primary ms-2" style="font-size:.7rem;white-space:nowrap;"
                                          data-bind="text: distanceText"></span>
                                    <!-- /ko -->
                                </div>
                                <!-- Yildiz/puan + yorum sayisi -->
                                <!-- ko if: reviewCount && reviewCount > 0 -->
                                <div class="small mb-1" style="color:#f59e0b;">
                                    <i class="bi bi-star-fill"></i>
                                    <span class="fw-semibold" data-bind="text: (averageRating || 0).toFixed(1)"></span>
                                    <span class="text-muted" data-bind="text: '(' + reviewCount + ' @T("salon.discover.review_suffix", "yorum")' + ')'"></span>
                                </div>
                                <!-- /ko -->
                                <p class="text-muted small mb-1" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;"
                                   data-bind="text: description || '@T("salon.discover.no_description", "Açıklama henüz eklenmemiş.")'"></p>
                                <small class="text-muted d-block">
                                    <i class="bi bi-geo-alt me-1"></i>
                                    <span data-bind="text: city ? ((district ? district + ', ' : '') + city) : '@T("salon.discover.no_location", "Konum belirtilmemiş")'"></span>
                                </small>
                                <!-- Fiyat araligi -->
                                <!-- ko if: priceRange -->
                                <small class="text-success d-block mt-1">
                                    <i class="bi bi-tag me-1"></i>
                                    <span data-bind="text: priceRange"></span>
                                </small>
                                <!-- /ko -->
                                <div class="d-flex gap-2 mt-2">
                                    <a class="btn btn-sm btn-outline-primary"
                                       data-bind="attr: { href: '/salon/' + slug, 'aria-label': (branchName || salonName || 'Salon') + ' @T("salon.discover.profile_aria_suffix", "profilini gör")' },
                                                  click: function(_, e) { e.stopPropagation(); return true; }">
                                        <i class="bi bi-shop me-1"></i><t key="salon.publicsalon.auto.profil">Profil</t>
                                    </a>
                                    <a class="btn btn-sm btn-primary"
                                       data-bind="attr: { href: '/salon/' + slug + '/book', 'aria-label': (branchName || salonName || 'Salon') + ' @T("salon.discover.book_aria_suffix", "için randevu al")' },
                                                  click: function(_, e) { e.stopPropagation(); return true; }">
                                        <i class="bi bi-calendar-check me-1"></i><t key="salon.publicsalon.auto.randevu">Randevu</t>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <footer class="text-center py-3 text-muted small border-top">
            <a href="https://corplynk.com" class="text-decoration-none text-muted">CorpLynk</a> @T("salon.discover.powered_by_suffix", "ile oluşturuldu")
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/knockout@3.5.1/build/output/knockout-latest.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        function DiscoverViewModel() {
            var self = this;
            self.salons = ko.observableArray([]);
            self.searchQuery = ko.observable('');
            self.isLoading = ko.observable(true);
            var map, markers = [];

            self.userLat = ko.observable(null);
            self.userLng = ko.observable(null);
            self.locationPending = ko.observable(true); // geolocation cekilene kadar true

            // Haversine: iki coord arasi km mesafe
            function haversineKm(lat1, lon1, lat2, lon2) {
                var R = 6371;
                var toRad = function (x) { return x * Math.PI / 180; };
                var dLat = toRad(lat2 - lat1), dLon = toRad(lon2 - lon1);
                var a = Math.sin(dLat / 2) * Math.sin(dLat / 2)
                      + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2))
                      * Math.sin(dLon / 2) * Math.sin(dLon / 2);
                return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
            }

            // Ahmet talebi: kullanici konumuna gore yakin salonlari oncelikli goster (20 km icinde).
            // Arama yapinca filtre devre disi (kullanici manuel arama yapiyor).
            var MAX_RADIUS_KM = 5;

            self.filteredSalons = ko.computed(function () {
                var q = (self.searchQuery() || '').toLowerCase();
                var uLat = self.userLat(), uLng = self.userLng();
                // Konum hala bekleniyor — filtre uygulama (ani sayı değişimini önle)
                if (self.locationPending()) return [];

                var list = self.salons().map(function (s) {
                    var d = null;
                    if (uLat !== null && s.latitude && s.longitude) {
                        d = haversineKm(uLat, uLng, s.latitude, s.longitude);
                    }
                    return Object.assign({}, s, {
                        distanceKm: d,
                        distanceText: d === null ? ''
                            : d < 1 ? Math.round(d * 1000) + ' m'
                            : d.toFixed(1) + ' km'
                    });
                });

                if (q) {
                    list = list.filter(function (s) {
                        var name = (s.branchName || s.salonName || '').toLowerCase();
                        var salon = (s.salonName || '').toLowerCase();
                        var city = (s.city || '').toLowerCase();
                        var dist = (s.district || '').toLowerCase();
                        return name.indexOf(q) >= 0 || salon.indexOf(q) >= 0
                            || city.indexOf(q) >= 0 || dist.indexOf(q) >= 0;
                    });
                } else if (uLat !== null) {
                    // Koordinati olan ve yakin olanlari one al; koordinatsizlari gizleme (lista sonuna at)
                    list = list.filter(function (s) {
                        return s.distanceKm === null || s.distanceKm <= MAX_RADIUS_KM;
                    });
                }

                // Konum varsa: mesafeye gore, koordinatsizlar sona. Yoksa alfabetik.
                if (uLat !== null) {
                    list.sort(function (a, b) {
                        if (a.distanceKm === null && b.distanceKm === null) return 0;
                        if (a.distanceKm === null) return 1;
                        if (b.distanceKm === null) return -1;
                        return a.distanceKm - b.distanceKm;
                    });
                }
                return list;
            });

            // Harita init - Turkiye merkezi (konum alinamazsa fallback)
            map = L.map('discoverMap').setView([39.9, 32.8], 6);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            var userMarker = null;
            var userIcon = L.divIcon({
                className: '',
                html: '<div style="background:#4285f4;width:14px;height:14px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 6px rgba(0,0,0,.3);"></div>',
                iconSize: [14, 14], iconAnchor: [7, 7]
            });
            // Her branch icin { marker, lat, lng } sakla — konum degisince filtreleriz
            var branchMarkers = [];

            function updateMarkerVisibility(uLat, uLng) {
                branchMarkers.forEach(function (bm) {
                    var d = haversineKm(uLat, uLng, bm.lat, bm.lng);
                    if (d <= MAX_RADIUS_KM) {
                        if (!map.hasLayer(bm.marker)) bm.marker.addTo(map);
                    } else {
                        if (map.hasLayer(bm.marker)) map.removeLayer(bm.marker);
                    }
                });
            }

            function setUserLocation(lat, lng, zoom) {
                self.userLat(lat);
                self.userLng(lng);
                if (userMarker) {
                    userMarker.setLatLng([lat, lng]);
                } else {
                    userMarker = L.marker([lat, lng], { icon: userIcon }).addTo(map).bindPopup('@T("salon.discover.your_location", "Konumunuz")');
                }
                if (zoom) map.setView([lat, lng], zoom);
                // Harita markerlarini da filtrele
                if (branchMarkers.length > 0) updateMarkerVisibility(lat, lng);
            }

            // Kullanici konumu al
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function (pos) {
                    setUserLocation(pos.coords.latitude, pos.coords.longitude, 13);
                    self.locationPending(false);
                }, function () {
                    // Konum izni reddedildi veya hata — tum salonlari goster
                    self.locationPending(false);
                }, { timeout: 5000 });
            } else {
                self.locationPending(false);
            }

            // Kullanici haritaya tiklayarak konumunu degistirebilsin (popup onayi ile).
            window._discoverConfirmLoc = null;
            map.on('click', function (e) {
                var lat = e.latlng.lat, lng = e.latlng.lng;
                window._discoverConfirmLoc = function () {
                    setUserLocation(lat, lng, 13);
                    map.closePopup();
                };
                var html = '<div style="min-width:180px;">' +
                    '<div class="small mb-2">@T("salon.discover.move_location_prompt", "Konumunuzu buraya taşımak ister misiniz?")</div>' +
                    '<button type="button" class="btn btn-sm btn-primary w-100" ' +
                    'onclick="window._discoverConfirmLoc()">@T("salon.discover.move_location_confirm", "Evet, buraya taşı")</button>' +
                    '</div>';
                L.popup({ closeButton: true })
                    .setLatLng([lat, lng])
                    .setContent(html)
                    .openOn(map);
            });

            fetch('/proxy/salon/')
                .then(function (r) { return r.ok ? r.json() : []; })
                .then(function (data) {
                    self.salons(data);
                    self.isLoading(false);
                })
                .catch(function () { self.isLoading(false); });

            // Tum subeleri haritada ayrı marker olarak göster (merkez + ek subeler)
            fetch('/proxy/salon/branches-map')
                .then(function (r) { return r.ok ? r.json() : []; })
                .then(function (branches) {
                    branches.forEach(function (b) {
                        if (!b.latitude || !b.longitude) return;
                        var marker = L.marker([b.latitude, b.longitude]).addTo(map);
                        var displayName = b.branchName || b.salonName;
                        marker.bindPopup(
                            '<b>' + displayName + '</b>' +
                            (!b.isHeadquarter && b.branchName && b.salonName !== b.branchName ? '<br><small class="text-muted">' + b.salonName + '</small>' : '') +
                            (b.city ? '<br><small>' + (b.district ? b.district + ', ' : '') + b.city + '</small>' : '') +
                            '<br><a href="/salon/' + b.slug + '">@T("salon.discover.view_profile", "Profili Gör")</a>'
                        );
                        markers.push(marker);
                        branchMarkers.push({ marker: marker, lat: b.latitude, lng: b.longitude });
                    });
                    // Konum zaten alindiysa markerları hemen filtrele
                    if (self.userLat() !== null) updateMarkerVisibility(self.userLat(), self.userLng());
                    // fitBounds KULLANMIYORUZ — kullanici konumuna zoom 14 oncelikli (Ahmet talebi).
                    // Kullanici konumu yoksa ve marker varsa: Turkiye merkezi yerine ilk marker'a setView.
                    if ((self.userLat() === null || self.userLng() === null) && markers.length > 0) {
                        map.setView(markers[0].getLatLng(), 12);
                    }
                })
                .catch(function () { /* harita yine de calisir */ });
        }

        ko.applyBindings(new DiscoverViewModel(), document.getElementById('discover-vm'));
    </script>
</body>
</html>
