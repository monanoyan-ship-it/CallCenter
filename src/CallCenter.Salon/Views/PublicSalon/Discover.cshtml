@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kesfet | CorpLynk Salon</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" rel="stylesheet" />
    <style>
        body { font-family: 'Segoe UI', system-ui, sans-serif; margin: 0; }
        .top-bar { background: linear-gradient(135deg, #2d1b3d 0%, #4a1a6b 100%); color: #fff; padding: .8rem 0; }
        .top-bar a { color: #ce93d8; text-decoration: none; }
        .top-bar a:hover { color: #fff; }
        #discoverMap { height: 400px; width: 100%; border-bottom: 3px solid #7b1fa2; }
        .salon-card { transition: .15s; cursor: pointer; border: 2px solid transparent; }
        .salon-card:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(0,0,0,.1) !important; border-color: #ce93d8; }
        .salon-logo { width: 48px; height: 48px; background: #e8e0f0; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
        .search-box { max-width: 400px; }
    </style>
</head>
<body>
    <div id="discover-vm">
        <!-- Top Bar -->
        <div class="top-bar">
            <div class="container d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-scissors me-2"></i>CorpLynk <span style="color:#ce93d8;">Salon</span></h5>
                <span class="small">Yakinindaki salonlari kesfet</span>
            </div>
        </div>

        <!-- Harita -->
        <div id="discoverMap"></div>

        <!-- Arama + Liste -->
        <div class="container py-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0"><i class="bi bi-shop me-2"></i>Salonlar <small class="text-muted" data-bind="text: '(' + filteredSalons().length + ')'"></small></h5>
                <div class="input-group search-box">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Salon veya sehir ara..." data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
                </div>
            </div>

            <div class="text-center py-3" data-bind="visible: isLoading">
                <div class="spinner-border text-primary"></div>
            </div>

            <!-- ko if: !isLoading() && filteredSalons().length === 0 -->
            <div class="text-center text-muted py-5">
                <i class="bi bi-search" style="font-size:3rem;opacity:.3;"></i>
                <p class="mt-2">Salon bulunamadi.</p>
            </div>
            <!-- /ko -->

            <div class="row g-3" data-bind="foreach: filteredSalons">
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm salon-card h-100" data-bind="click: function() { window.location.href = '/salon/' + slug; }">
                        <div class="card-body d-flex gap-3">
                            <div class="salon-logo flex-shrink-0">
                                <!-- ko if: logoUrl -->
                                <img data-bind="attr: { src: logoUrl }" style="width:48px;height:48px;border-radius:50%;object-fit:cover;" />
                                <!-- /ko -->
                                <!-- ko if: !logoUrl -->
                                <i class="bi bi-scissors fs-5" style="color:#7b1fa2;"></i>
                                <!-- /ko -->
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1" data-bind="text: salonName"></h6>
                                <!-- ko if: description -->
                                <p class="text-muted small mb-1" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;" data-bind="text: description"></p>
                                <!-- /ko -->
                                <!-- ko if: city -->
                                <small class="text-muted"><i class="bi bi-geo-alt me-1"></i><span data-bind="text: (district ? district + ', ' : '') + city"></span></small>
                                <!-- /ko -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <footer class="text-center py-3 text-muted small border-top">
            <a href="https://corplynk.com" class="text-decoration-none text-muted">CorpLynk</a> ile olusturuldu
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/knockout@3.5.1/build/output/knockout-latest.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        function DiscoverViewModel() {
            var self = this;
            self.salons = ko.observableArray([]);
            self.searchQuery = ko.observable('');
            self.isLoading = ko.observable(true);
            var map, markers = [];

            self.filteredSalons = ko.computed(function () {
                var q = (self.searchQuery() || '').toLowerCase();
                if (!q) return self.salons();
                return self.salons().filter(function (s) {
                    return (s.salonName || '').toLowerCase().indexOf(q) >= 0
                        || (s.city || '').toLowerCase().indexOf(q) >= 0
                        || (s.district || '').toLowerCase().indexOf(q) >= 0;
                });
            });

            // Harita init - Turkiye merkezi (konum alinamazsa fallback)
            map = L.map('discoverMap').setView([39.9, 32.8], 6);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            var userMarker = null;

            // Kullanici konumu al
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function (pos) {
                    var lat = pos.coords.latitude, lng = pos.coords.longitude;
                    map.setView([lat, lng], 12);
                    userMarker = L.marker([lat, lng], {
                        icon: L.divIcon({
                            className: '',
                            html: '<div style="background:#4285f4;width:14px;height:14px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 6px rgba(0,0,0,.3);"></div>',
                            iconSize: [14, 14], iconAnchor: [7, 7]
                        })
                    }).addTo(map).bindPopup('Konumunuz').openPopup();
                }, function () {
                    // Konum izni reddedildi - Turkiye gorunumunde kal
                }, { timeout: 5000 });
            }

            fetch('/proxy/salon/')
                .then(function (r) { return r.ok ? r.json() : []; })
                .then(function (data) {
                    self.salons(data);
                    self.isLoading(false);

                    data.forEach(function (s) {
                        if (s.latitude && s.longitude) {
                            var marker = L.marker([s.latitude, s.longitude]).addTo(map);
                            marker.bindPopup(
                                '<b>' + s.salonName + '</b>' +
                                (s.city ? '<br><small>' + (s.district ? s.district + ', ' : '') + s.city + '</small>' : '') +
                                '<br><a href="/salon/' + s.slug + '">Profili Gor</a>'
                            );
                            markers.push(marker);
                        }
                    });
                })
                .catch(function () { self.isLoading(false); });
        }

        ko.applyBindings(new DiscoverViewModel(), document.getElementById('discover-vm'));
    </script>
</body>
</html>
