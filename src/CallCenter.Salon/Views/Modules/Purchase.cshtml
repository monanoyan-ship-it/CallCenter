@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    var moduleId = ViewData["ModuleId"];
}

<div id="purchase-vm">
    <!-- Yukleniyor -->
    <div class="text-center py-5" data-bind="visible: isLoading"><div class="spinner-border text-primary"></div></div>

    <!-- Modul bulunamadi -->
    <div class="text-center py-5" data-bind="visible: !isLoading() && !moduleInfo()">
        <i class="bi bi-exclamation-triangle fs-1 text-warning d-block mb-2"></i>
        <p><t key="salon.modules.auto.modul_bilgisi_bulunamadi">Modül bilgisi bulunamadi.</t></p>
        <a href="/Modules" class="btn btn-outline-primary btn-sm"><t key="salon.modules.back_to_modules">Modüllere Dön</t></a>
    </div>

    <!-- Modul Bilgisi + Odeme Formu -->
    <div data-bind="visible: !isLoading() && moduleInfo()">
        <div class="row g-3">
            <!-- Sol: Modul Bilgisi -->
            <div class="col-md-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h5 data-bind="text: moduleInfo() ? moduleInfo().name : ''"></h5>
                        <p class="text-muted small" data-bind="text: moduleInfo() ? moduleInfo().description : ''"></p>
                        <hr />
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted"><t key="salon.modules.monthly_fee">Aylık Ücret</t>:</span>
                            <span class="fs-4 fw-bold text-primary" data-bind="text: moduleInfo() ? moduleInfo().monthlyPrice.toLocaleString(document.documentElement.lang || undefined, {style:'currency', currency:'TRY'}) : ''"></span>
                        </div>
                        <div class="text-muted small mt-2"><i class="bi bi-info-circle me-1"></i><t key="salon.modules.auto.odeme_sonrasi_modul_hemen_aktif_olacaktir">Ödeme sonrası modül hemen aktif olacaktır.</t></div>
                    </div>
                </div>

                <!-- Odeme Sonucu -->
                <div class="card border-0 shadow-sm mt-3" data-bind="visible: paymentResult()">
                    <div class="card-body text-center py-4">
                        <div data-bind="visible: paymentResult() && paymentResult().success">
                            <i class="bi bi-check-circle-fill text-success fs-1 d-block mb-2"></i>
                            <h5 class="text-success" data-bind="text: paymentResult() && paymentResult().message ? salonT('salon.modules.request_received', 'Talep Alındı') : salonT('salon.modules.auto.odeme_basarili', 'Ödeme Başarılı!')"></h5>
                            <p class="text-muted small mb-2" data-bind="text: paymentResult() && paymentResult().message ? paymentResult().message : salonT('salon.modules.activated', 'Modülünüz aktif edildi.')"></p>
                            <div class="alert alert-warning py-2 small text-start" data-bind="visible: paymentResult() && !paymentResult().message">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                <strong><t key="salon.modules.auto.yeni_modulu_menude_gormek_icin_oturumu_yenileyin">Yeni modülu menude gormek icin oturumu yenileyin.</t></strong>
                            </div>
                            <a href="/Account/RefreshSession?returnUrl=/Modules" class="btn btn-primary btn-sm mt-1" data-bind="visible: paymentResult() && !paymentResult().message">
                                <i class="bi bi-arrow-clockwise me-1"></i><t key="salon.modules.refresh_session">Oturumu Yenile</t>
                            </a>
                        </div>
                        <div data-bind="visible: paymentResult() && !paymentResult().success">
                            <i class="bi bi-x-circle-fill text-danger fs-1 d-block mb-2"></i>
                            <h5 class="text-danger"><t key="salon.modules.auto.odeme_basarisiz">Ödeme Başarısız</t></h5>
                            <p class="text-muted small" data-bind="text: paymentResult() ? paymentResult().error : ''"></p>
                            <button class="btn btn-outline-primary btn-sm mt-2" data-bind="click: function(){ paymentResult(null); }"><t key="salon.modules.retry">Tekrar Dene</t></button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sag: Odeme Formu -->
            <div class="col-md-7" data-bind="visible: !paymentResult()">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <!-- Odeme Yontemi Secimi -->
                        <div class="btn-group w-100 mb-3" role="group">
                            <input type="radio" class="btn-check" name="payMethod" id="pmKK" value="kk" data-bind="checked: paymentMethod" />
                            <label class="btn btn-outline-primary" for="pmKK"><i class="bi bi-credit-card me-1"></i><t key="salon.payment.credit_card">Kredi Kartı</t></label>
                            <input type="radio" class="btn-check" name="payMethod" id="pmHavale" value="havale" data-bind="checked: paymentMethod" />
                            <label class="btn btn-outline-primary" for="pmHavale"><i class="bi bi-bank me-1"></i><t key="salon.modules.auto.havale_eft">Havale/EFT</t></label>
                        </div>

                        <!-- KK Formu -->
                        <div data-bind="visible: paymentMethod() === 'kk'">
                            <div class="mb-2">
                                <label class="form-label small"><t key="salon.payment.card_holder">Kart Üzerindeki İsim *</t></label>
                                <input class="form-control form-control-sm" data-bind="value: card.holderName" placeholder="AD SOYAD" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small"><t key="salon.payment.card_number">Kart Numarası *</t></label>
                                <input class="form-control form-control-sm" data-bind="value: card.number, event: { input: formatCardNumber }" maxlength="19" placeholder="0000 0000 0000 0000" />
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-4">
                                    <label class="form-label small"><t key="salon.modules.auto.ay_required">Ay *</t></label>
                                    <select class="form-select form-select-sm" data-bind="value: card.expMonth">
                                        <option value=""><t key="salon.modules.auto.ay">Ay</t></option>
                                        <option value="01">01</option><option value="02">02</option><option value="03">03</option>
                                        <option value="04">04</option><option value="05">05</option><option value="06">06</option>
                                        <option value="07">07</option><option value="08">08</option><option value="09">09</option>
                                        <option value="10">10</option><option value="11">11</option><option value="12">12</option>
                                    </select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label small"><t key="salon.common.year">Yıl</t> *</label>
                                    <select class="form-select form-select-sm" data-bind="value: card.expYear, options: yearOptions"></select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label small"><t key="salon.modules.auto.cvv_required">CVV *</t></label>
                                    <input class="form-control form-control-sm" data-bind="value: card.cvc" maxlength="4" placeholder="***" type="password" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small"><t key="salon.modules.auto.taksit">Taksit</t></label>
                                <select class="form-select form-select-sm" data-bind="value: card.installment">
                                    <option value="1"><t key="salon.payment.single_payment">Tek Çekim</t></option>
                                    <option value="2"><t key="salon.modules.auto.2_taksit">2 Taksit</t></option>
                                    <option value="3"><t key="salon.modules.auto.3_taksit">3 Taksit</t></option>
                                    <option value="6"><t key="salon.modules.auto.6_taksit">6 Taksit</t></option>
                                    <option value="9"><t key="salon.modules.auto.9_taksit">9 Taksit</t></option>
                                    <option value="12"><t key="salon.modules.auto.12_taksit">12 Taksit</t></option>
                                </select>
                            </div>
                            <button class="btn btn-primary w-100" data-bind="click: payWithCard, disable: isProcessing">
                                <span data-bind="visible: isProcessing" class="spinner-border spinner-border-sm me-1"></span>
                                <i class="bi bi-lock-fill me-1" data-bind="visible: !isProcessing()"></i>
                                <span data-bind="text: moduleInfo() ? salonT('salon.payment.pay_prefix', 'Öde') + ' ' + moduleInfo().monthlyPrice.toLocaleString(document.documentElement.lang || undefined, {style:'currency', currency:'TRY'}) : salonT('salon.payment.pay_prefix', 'Öde')"></span>
                            </button>
                            <div class="text-center mt-2">
                                <i class="bi bi-shield-check text-success me-1"></i>
                                <span class="text-muted small"><t key="salon.modules.auto.256_bit_ssl_ile_guvenli_odeme">256-bit SSL ile güvenli ödeme</t></span>
                            </div>
                        </div>

                        <!-- Havale Bilgileri -->
                        <div data-bind="visible: paymentMethod() === 'havale'">
                            <div data-bind="visible: bankInfo()">
                                <div class="alert alert-info small mb-3">
                                    <i class="bi bi-info-circle me-1"></i><t key="salon.modules.bank_transfer_hint">Aşağıdaki hesaba havale yaptıktan sonra "Havale Yaptım" butonuna tıklayınız.</t>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered mb-3">
                                        <tr><th class="bg-light" style="width:35%"><t key="salon.modules.auto.banka">Banka</t></th><td data-bind="text: bankInfo() ? bankInfo().bankName : ''"></td></tr>
                                        <tr><th class="bg-light"><t key="salon.modules.auto.hesap_sahibi">Hesap Sahibi</t></th><td data-bind="text: bankInfo() ? bankInfo().accountHolder : ''"></td></tr>
                                        <tr>
                                            <th class="bg-light">IBAN</th>
                                            <td>
                                                <code data-bind="text: bankInfo() ? bankInfo().iban || bankInfo().IBAN : ''"></code>
                                                <button class="btn btn-outline-secondary btn-sm ms-2" data-bind="click: copyIban" title="@(Translation.T("salon.common.copy", "Kopyala"))"><i class="bi bi-clipboard"></i></button>
                                            </td>
                                        </tr>
                                        <tr><th class="bg-light"><t key="salon.panel.payments.amount">Tutar</t></th><td class="fw-bold" data-bind="text: moduleInfo() ? moduleInfo().monthlyPrice.toLocaleString(document.documentElement.lang || undefined, {style:'currency', currency:'TRY'}) : ''"></td></tr>
                        <tr data-bind="visible: bankInfo() && bankInfo().description"><th class="bg-light"><t key="salon.common.description">Açıklama</t></th><td data-bind="text: bankInfo() ? bankInfo().description : ''"></td></tr>
                                    </table>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small"><t key="salon.modules.auto.havale_aciklamasi_referans_no">Havale açıklaması / referans no</t></label>
                                    <input class="form-control form-control-sm" maxlength="120" placeholder="@(Translation.T("salon.modules.auto.placeholder_dekont_no_banka_referansi_veya_aciklama", "Dekont no, banka referansı veya açıklama"))" data-bind="value: havale.referenceNote" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small"><t key="salon.modules.auto.dekont_yukle">Dekont yükle</t></label>
                                    <input type="file" class="form-control form-control-sm" accept=".pdf,image/png,image/jpeg,image/webp" data-bind="event: { change: onReceiptSelected }" />
                                    <div class="form-text small">
                                        <t key="salon.modules.auto.pdf_jpg_png_webp_en_fazla_5_mb">PDF/JPG/PNG/WEBP, en fazla 5 MB.</t>
                                        <span data-bind="visible: havale.receiptFileName"><t key="salon.modules.auto.secilen">Seçilen:</t> <span data-bind="text: havale.receiptFileName"></span></span>
                                    </div>
                                </div>
                                <button class="btn btn-primary w-100" data-bind="click: submitHavale, disable: isProcessing">
                                    <span data-bind="visible: isProcessing" class="spinner-border spinner-border-sm me-1"></span>
                                    <span data-bind="visible: havale.isReadingReceipt" class="spinner-border spinner-border-sm me-1"></span>
                                    <i class="bi bi-check-lg me-1" data-bind="visible: !isProcessing() && !havale.isReadingReceipt()"></i><t key="salon.modules.auto.havale_yaptim">Havale Yaptım</t>
                                </button>
                            </div>
                            <div class="text-center text-muted py-4" data-bind="visible: !bankInfo()">
                                <i class="bi bi-bank fs-1 d-block mb-2 opacity-25"></i>
                                <t key="salon.modules.auto.havale_banka_bilgisi_tanimlanmamis_lutfen_yoneticinizle_iletisime_geci">Havale banka bilgisi tanımlanmamış. Lütfen yöneticinizle iletişime geçin.</t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/ModulePurchase.js" asp-append-version="true"></script>
<script>
    ko.applyBindings(new PurchaseViewModel(@(moduleId ?? 0)), document.getElementById('purchase-vm'));
</script>
}
