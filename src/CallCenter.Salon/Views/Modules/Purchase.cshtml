@{
    var moduleId = ViewData["ModuleId"];
}

<div id="purchase-vm">
    <!-- Yukleniyor -->
    <div class="text-center py-5" data-bind="visible: isLoading"><div class="spinner-border text-primary"></div></div>

    <!-- Modul bulunamadi -->
    <div class="text-center py-5" data-bind="visible: !isLoading() && !moduleInfo()">
        <i class="bi bi-exclamation-triangle fs-1 text-warning d-block mb-2"></i>
        <p>Modul bilgisi bulunamadi.</p>
        <a href="/Modules" class="btn btn-outline-primary btn-sm">Modullere Don</a>
    </div>

    <!-- Modul Bilgisi + Odeme Formu -->
    <div data-bind="visible: !isLoading() && moduleInfo()">
        <div class="row g-3">
            <!-- Sol: Modul Bilgisi -->
            <div class="col-md-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h5 data-bind="text: moduleInfo() ? moduleInfo().name : ''"></h5>
                        <p class="text-muted small" data-bind="text: moduleInfo() ? moduleInfo().description : ''"></p>
                        <hr />
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Aylik Ucret:</span>
                            <span class="fs-4 fw-bold text-primary" data-bind="text: moduleInfo() ? moduleInfo().monthlyPrice.toLocaleString('tr-TR', {style:'currency', currency:'TRY'}) : ''"></span>
                        </div>
                        <div class="text-muted small mt-2"><i class="bi bi-info-circle me-1"></i>Odeme sonrasi modul hemen aktif olacaktir.</div>
                    </div>
                </div>

                <!-- Odeme Sonucu -->
                <div class="card border-0 shadow-sm mt-3" data-bind="visible: paymentResult()">
                    <div class="card-body text-center py-4">
                        <div data-bind="visible: paymentResult() && paymentResult().success">
                            <i class="bi bi-check-circle-fill text-success fs-1 d-block mb-2"></i>
                            <h5 class="text-success" data-bind="text: paymentResult() && paymentResult().message ? 'Talep Alindi' : 'Odeme Basarili!'"></h5>
                            <p class="text-muted small mb-2" data-bind="text: paymentResult() && paymentResult().message ? paymentResult().message : 'Modulunuz aktif edildi.'"></p>
                            <div class="alert alert-warning py-2 small text-start" data-bind="visible: paymentResult() && !paymentResult().message">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                <strong>Yeni modulu menude gormek icin oturumu yenileyin.</strong>
                            </div>
                            <a href="/Account/RefreshSession?returnUrl=/Modules" class="btn btn-primary btn-sm mt-1" data-bind="visible: paymentResult() && !paymentResult().message">
                                <i class="bi bi-arrow-clockwise me-1"></i>Oturumu Yenile
                            </a>
                        </div>
                        <div data-bind="visible: paymentResult() && !paymentResult().success">
                            <i class="bi bi-x-circle-fill text-danger fs-1 d-block mb-2"></i>
                            <h5 class="text-danger">Odeme Basarisiz</h5>
                            <p class="text-muted small" data-bind="text: paymentResult() ? paymentResult().error : ''"></p>
                            <button class="btn btn-outline-primary btn-sm mt-2" data-bind="click: function(){ paymentResult(null); }">Tekrar Dene</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sag: Odeme Formu -->
            <div class="col-md-7" data-bind="visible: !paymentResult()">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <!-- Odeme Yontemi Secimi -->
                        <div class="btn-group w-100 mb-3" role="group">
                            <input type="radio" class="btn-check" name="payMethod" id="pmKK" value="kk" data-bind="checked: paymentMethod" />
                            <label class="btn btn-outline-primary" for="pmKK"><i class="bi bi-credit-card me-1"></i>Kredi Karti</label>
                            <input type="radio" class="btn-check" name="payMethod" id="pmHavale" value="havale" data-bind="checked: paymentMethod" />
                            <label class="btn btn-outline-primary" for="pmHavale"><i class="bi bi-bank me-1"></i>Havale/EFT</label>
                        </div>

                        <!-- KK Formu -->
                        <div data-bind="visible: paymentMethod() === 'kk'">
                            <div class="mb-2">
                                <label class="form-label small">Kart Uzerindeki Isim *</label>
                                <input class="form-control form-control-sm" data-bind="value: card.holderName" placeholder="AD SOYAD" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">Kart Numarasi *</label>
                                <input class="form-control form-control-sm" data-bind="value: card.number, event: { input: formatCardNumber }" maxlength="19" placeholder="0000 0000 0000 0000" />
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-4">
                                    <label class="form-label small">Ay *</label>
                                    <select class="form-select form-select-sm" data-bind="value: card.expMonth">
                                        <option value="">Ay</option>
                                        <option value="01">01</option><option value="02">02</option><option value="03">03</option>
                                        <option value="04">04</option><option value="05">05</option><option value="06">06</option>
                                        <option value="07">07</option><option value="08">08</option><option value="09">09</option>
                                        <option value="10">10</option><option value="11">11</option><option value="12">12</option>
                                    </select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label small">Yil *</label>
                                    <select class="form-select form-select-sm" data-bind="value: card.expYear, options: yearOptions"></select>
                                </div>
                                <div class="col-4">
                                    <label class="form-label small">CVV *</label>
                                    <input class="form-control form-control-sm" data-bind="value: card.cvc" maxlength="4" placeholder="***" type="password" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small">Taksit</label>
                                <select class="form-select form-select-sm" data-bind="value: card.installment">
                                    <option value="1">Tek Cekim</option>
                                    <option value="2">2 Taksit</option>
                                    <option value="3">3 Taksit</option>
                                    <option value="6">6 Taksit</option>
                                    <option value="9">9 Taksit</option>
                                    <option value="12">12 Taksit</option>
                                </select>
                            </div>
                            <button class="btn btn-primary w-100" data-bind="click: payWithCard, disable: isProcessing">
                                <span data-bind="visible: isProcessing" class="spinner-border spinner-border-sm me-1"></span>
                                <i class="bi bi-lock-fill me-1" data-bind="visible: !isProcessing()"></i>
                                <span data-bind="text: moduleInfo() ? 'Ode ' + moduleInfo().monthlyPrice.toLocaleString('tr-TR', {style:'currency', currency:'TRY'}) : 'Ode'"></span>
                            </button>
                            <div class="text-center mt-2">
                                <i class="bi bi-shield-check text-success me-1"></i>
                                <span class="text-muted small">256-bit SSL ile guvenli odeme</span>
                            </div>
                        </div>

                        <!-- Havale Bilgileri -->
                        <div data-bind="visible: paymentMethod() === 'havale'">
                            <div data-bind="visible: bankInfo()">
                                <div class="alert alert-info small mb-3">
                                    <i class="bi bi-info-circle me-1"></i>Asagidaki hesaba havale yaptiktan sonra "Havale Yaptim" butonuna tiklayiniz.
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered mb-3">
                                        <tr><th class="bg-light" style="width:35%">Banka</th><td data-bind="text: bankInfo() ? bankInfo().bankName : ''"></td></tr>
                                        <tr><th class="bg-light">Hesap Sahibi</th><td data-bind="text: bankInfo() ? bankInfo().accountHolder : ''"></td></tr>
                                        <tr>
                                            <th class="bg-light">IBAN</th>
                                            <td>
                                                <code data-bind="text: bankInfo() ? bankInfo().iban || bankInfo().IBAN : ''"></code>
                                                <button class="btn btn-outline-secondary btn-sm ms-2" data-bind="click: copyIban" title="Kopyala"><i class="bi bi-clipboard"></i></button>
                                            </td>
                                        </tr>
                                        <tr><th class="bg-light">Tutar</th><td class="fw-bold" data-bind="text: moduleInfo() ? moduleInfo().monthlyPrice.toLocaleString('tr-TR', {style:'currency', currency:'TRY'}) : ''"></td></tr>
                                        <tr data-bind="visible: bankInfo() && bankInfo().description"><th class="bg-light">Aciklama</th><td data-bind="text: bankInfo() ? bankInfo().description : ''"></td></tr>
                                    </table>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small">Havale aciklamasi / referans no</label>
                                    <input class="form-control form-control-sm" maxlength="120" placeholder="Dekont no, banka referansi veya aciklama" data-bind="value: havale.referenceNote" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small">Dekont yukle</label>
                                    <input type="file" class="form-control form-control-sm" accept=".pdf,image/png,image/jpeg,image/webp" data-bind="event: { change: onReceiptSelected }" />
                                    <div class="form-text small">
                                        PDF/JPG/PNG/WEBP, en fazla 5 MB.
                                        <span data-bind="visible: havale.receiptFileName">Secilen: <span data-bind="text: havale.receiptFileName"></span></span>
                                    </div>
                                </div>
                                <button class="btn btn-primary w-100" data-bind="click: submitHavale, disable: isProcessing">
                                    <span data-bind="visible: isProcessing" class="spinner-border spinner-border-sm me-1"></span>
                                    <span data-bind="visible: havale.isReadingReceipt" class="spinner-border spinner-border-sm me-1"></span>
                                    <i class="bi bi-check-lg me-1" data-bind="visible: !isProcessing() && !havale.isReadingReceipt()"></i>Havale Yaptim
                                </button>
                            </div>
                            <div class="text-center text-muted py-4" data-bind="visible: !bankInfo()">
                                <i class="bi bi-bank fs-1 d-block mb-2 opacity-25"></i>
                                Havale banka bilgisi tanimlanmamis. Lutfen yoneticinizle iletisime gecin.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/ModulePurchase.js" asp-append-version="true"></script>
<script>
    ko.applyBindings(new PurchaseViewModel(@(moduleId ?? 0)), document.getElementById('purchase-vm'));
</script>
}
