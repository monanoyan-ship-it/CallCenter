@{
    ViewData["Title"] = "Modul Yonetimi";
}

<div id="modules-vm">
    <!-- ko if: platformUnpaid().length > 0 -->
    <div class="alert alert-warning border-warning mb-3 py-2 small">
        <div class="fw-semibold mb-1"><i class="bi bi-receipt-cutoff me-1"></i><span data-bind="text: platformBillingTitle"></span></div>
        <ul class="mb-2 ps-3" data-bind="foreach: platformUnpaid">
            <li><span data-bind="text: (month || '-') + '/' + (year || '-')"></span> —
                <strong data-bind="text: (total || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' ₺'"></strong></li>
        </ul>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <button type="button" class="btn btn-sm btn-success" data-bind="click: startPlatformAccrualPayment, disable: platformPayLoading">
                <span data-bind="visible: platformPayLoading" class="spinner-border spinner-border-sm me-1"></span>
                <i class="bi bi-credit-card me-1"></i>Kredi kartı ile tahakkuk ödemesi
            </button>
            <span class="text-muted" data-bind="text: platformBillingHint"></span>
        </div>
    </div>
    <!-- /ko -->

    <!-- Temel Paket -->
    <h6 class="text-muted mb-3"><i class="bi bi-box-seam me-1"></i>Temel Paket</h6>
    <div class="row g-3 mb-4" data-bind="foreach: defaultModules">
        <div class="col-md-4 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi me-2" data-bind="attr: { 'class': 'bi ' + (icon || 'bi-puzzle') }" style="font-size:1.3rem;color:#6f42c1;"></i>
                        <div>
                            <div class="fw-bold small" data-bind="text: description || systemName"></div>
                            <span class="badge bg-success" style="font-size:0.6rem;">Dahil</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Aktif Modulleriniz -->
    <!-- ko if: activeGroups().length > 0 -->
    <h6 class="text-muted mb-3"><i class="bi bi-check-circle me-1"></i>Aktif Modulleriniz</h6>
    <!-- ko foreach: activeGroups -->
    <div class="card border-0 shadow-sm mb-3 border-start border-3 border-success">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-success" data-bind="text: groupName"></span>
                <span class="badge bg-success-subtle text-success ms-1" data-bind="text: packagePrice.toLocaleString('tr-TR') + ' ₺/ay'"></span>
            </div>
            <button class="btn btn-sm btn-outline-danger py-0" data-bind="click: $root.cancelPackage">
                <i class="bi bi-x-circle me-1"></i>Iptal Et
            </button>
        </div>
        <div class="card-body py-2">
            <div class="row g-1">
                <!-- ko foreach: modules -->
                <div class="col-md-6 col-lg-4">
                    <div class="d-flex align-items-center gap-2 py-1">
                        <i data-bind="attr: { 'class': 'bi ' + (icon || 'bi-puzzle') }, style: { color: (typeof isImplemented !== 'undefined' && isImplemented === false) ? '#ccc' : '#198754', fontSize: '.9rem' }"></i>
                        <span class="small" data-bind="text: description || systemName || moduleName, css: { 'text-muted': typeof isImplemented !== 'undefined' && isImplemented === false }"></span>
                        <!-- ko if: typeof isImplemented !== 'undefined' && isImplemented === false -->
                        <i class="bi bi-lock text-warning" style="font-size:.7rem;cursor:help;" title="Bu hizmet yakin zamanda aktif edilecektir."></i>
                        <!-- /ko -->
                    </div>
                </div>
                <!-- /ko -->
            </div>
        </div>
    </div>
    <!-- /ko -->
    <!-- /ko -->

    <!-- Satin Alinabilir Moduller -->
    <h6 class="text-muted mb-3 mt-4"><i class="bi bi-cart-plus me-1"></i>Satin Alinabilir Moduller</h6>
    <!-- ko if: availableModules().length === 0 -->
    <div class="alert alert-info py-2 small">Tum moduller zaten aktif.</div>
    <!-- /ko -->
    <!-- ko foreach: availableGroups -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <div>
                <strong data-bind="text: groupName"></strong>
                <span class="text-muted small ms-1" data-bind="text: '(' + modules.length + ' hizmet)'"></span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-purple" data-bind="text: packagePrice.toLocaleString('tr-TR') + ' ₺/ay'" style="font-size:.85rem;background:#6f42c1;"></span>
                <button class="btn btn-sm btn-success" data-bind="click: $root.purchasePackage">
                    <i class="bi bi-cart-plus me-1"></i>Satin Al
                </button>
            </div>
        </div>
        <div class="card-body py-2">
            <div class="row g-1">
                <!-- ko foreach: modules -->
                <div class="col-md-6 col-lg-4">
                    <div class="d-flex align-items-center gap-2 py-1">
                        <i class="bi" data-bind="attr: { 'class': 'bi ' + (icon || 'bi-puzzle') }" style="color:#6c757d;font-size:.9rem;"></i>
                        <span class="small" data-bind="text: description || moduleName"></span>
                    </div>
                </div>
                <!-- /ko -->
            </div>
        </div>
    </div>
    <!-- /ko -->

    <!-- Aylik Toplam -->
    <div class="card border-0 shadow-sm mt-4 bg-light">
        <div class="card-body py-3">
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold">Aylik Modul Tutari</span>
                <span class="fs-5 fw-bold text-primary" data-bind="text: displayMonthlyTotal().toLocaleString('tr-TR') + ' ₺/ay'"></span>
            </div>
            <!-- ko if: branchSummaryText().length > 0 -->
            <div class="small text-muted text-end mt-1" data-bind="text: branchSummaryText"></div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Odeme gecmisi -->
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="bi bi-clock-history me-1"></i>Odeme Gecmisi</h6>
            <button type="button" class="btn btn-outline-primary btn-sm" data-bind="click: loadPaymentHistory, disable: paymentHistoryLoading">
                <span class="spinner-border spinner-border-sm me-1" data-bind="visible: paymentHistoryLoading"></span>
                <i class="bi bi-arrow-clockwise" data-bind="visible: !paymentHistoryLoading()"></i>
            </button>
        </div>
        <div class="card-body p-0">
            <div class="text-center py-4" data-bind="visible: paymentHistoryLoading">
                <div class="spinner-border text-primary"></div>
            </div>
            <div class="text-center text-muted py-4" data-bind="visible: !paymentHistoryLoading() && paymentHistory().length === 0">
                Henuz odeme kaydi yok.
            </div>
            <div class="table-responsive" data-bind="visible: !paymentHistoryLoading() && paymentHistory().length > 0">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih</th>
                            <th>Tur</th>
                            <th>Yontem</th>
                            <th class="text-end">Tutar</th>
                            <th>Durum</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: paymentHistory">
                        <tr>
                            <td class="small text-nowrap" data-bind="text: $root.paymentDateText($data)"></td>
                            <td class="small" data-bind="text: paymentType || '-'"></td>
                            <td class="small" data-bind="text: paymentMethod || provider || '-'"></td>
                            <td class="small text-end fw-semibold" data-bind="text: $root.paymentAmountText($data)"></td>
                            <td>
                                <span class="small fw-semibold" data-bind="css: $root.paymentStatusClass($data), text: status || '-'"></span>
                                <div class="small text-danger" data-bind="visible: errorMessage, text: errorMessage"></div>
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 me-1"
                                        data-bind="visible: canDownloadReceipt, click: $root.downloadReceipt">
                                    <i class="bi bi-download me-1"></i>Dekont
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 me-1"
                                        data-bind="visible: canDownloadHavaleReceipt, click: $root.downloadHavaleReceipt">
                                    <i class="bi bi-paperclip me-1"></i>Havale
                                </button>
                                <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2"
                                        data-bind="visible: canRetry, click: $root.retryPayment">
                                    <i class="bi bi-arrow-repeat me-1"></i>Tekrar Dene
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Satin Alma Modal -->
    <div class="modal fade" id="purchaseModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><i class="bi bi-cart-check me-1"></i><span data-bind="text: purchaseModalTitle"></span></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Step 1: Pro-rata Preview -->
                    <div data-bind="visible: purchaseStep() === 'preview'">
                        <div class="text-center py-3" data-bind="visible: purchaseLoading()">
                            <div class="spinner-border text-primary"></div>
                            <div class="small text-muted mt-2">Fiyat hesaplaniyor...</div>
                        </div>
                        <div data-bind="visible: !purchaseLoading() && purchasePreview()">
                            <div class="alert alert-info py-2 small mb-3">
                                <i class="bi bi-info-circle me-1"></i>Bugun yalniz sonraki tahakkuk tarihine kadar olan kist donem tahsil edilir; fiyatlar KDV dahildir.
                            </div>
                            <table class="table table-sm mb-3">
                                <tr>
                                    <td class="text-muted">Modul</td>
                                    <td class="fw-bold text-end" data-bind="text: purchasePreview() ? purchasePreview().packageName : ''"></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Aylik Paket Fiyati</td>
                                    <td class="text-end" data-bind="text: purchasePreview() ? purchasePreview().monthlyPrice.toLocaleString('tr-TR') + ' ₺' : ''"></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Sonraki Tahakkuk</td>
                                    <td class="text-end" data-bind="text: purchasePreview() ? new Date(purchasePreview().nextBillingDate).toLocaleDateString('tr-TR') : ''"></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Kist-i Hesap</td>
                                    <td class="text-end">
                                        <span data-bind="text: purchasePreview() && purchasePreview().proRata ? purchasePreview().proRata.days + ' gun x ' + purchasePreview().proRata.dailyRate.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺' : ''"></span>
                                    </td>
                                </tr>
                                <tr class="table-success">
                                    <td class="fw-bold">Simdi Odenecek</td>
                                    <td class="fw-bold text-end fs-5 text-success" data-bind="text: purchasePreview() ? purchasePreview().totalNow.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺' : ''"></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Sonraki Donemlerden Itibaren</td>
                                    <td class="text-end" data-bind="text: purchasePreview() ? (purchasePreview().recurringMonthlyAmount || purchasePreview().monthlyPrice).toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺/ay (KDV dahil)' : ''"></td>
                                </tr>
                            </table>
                            <div class="small text-muted mb-3">
                                <i class="bi bi-calendar-check me-1"></i>
                                <span data-bind="text: purchasePreview() && purchasePreview().billingNote ? purchasePreview().billingNote : 'Sonraki tahakkuktan itibaren paket aylik olarak faturalandirilacaktir.'"></span>
                            </div>
                            <button class="btn btn-success w-100" data-bind="click: startCheckout, disable: purchaseLoading()">
                                <i class="bi bi-credit-card me-1"></i>Odemeye Gec
                            </button>
                        </div>
                    </div>

                    <!-- Step 2: Iyzico Checkout Form -->
                    <div data-bind="visible: purchaseStep() === 'checkout'">
                        <div class="text-center py-3" data-bind="visible: purchaseLoading()">
                            <div class="spinner-border text-primary"></div>
                            <div class="small text-muted mt-2">Odeme formu hazirlaniyor...</div>
                        </div>
                        <div id="iyzico-checkout-container" data-bind="iyzicoCheckoutHtml: checkoutFormHtml"></div>
                    </div>

                    <!-- Step 3: Sonuc -->
                    <div data-bind="visible: purchaseStep() === 'result'">
                        <div class="text-center py-4" data-bind="visible: purchaseLoading() && !purchaseResult()">
                            <div class="spinner-border text-primary"></div>
                            <div class="small text-muted mt-2">Odeme sonucu dogrulaniyor...</div>
                        </div>
                        <div class="text-center py-4" data-bind="visible: purchaseResult() && purchaseResult().success">
                            <i class="bi bi-check-circle-fill text-success" style="font-size:3rem;"></i>
                            <h5 class="mt-2 text-success" data-bind="text: purchaseResultTitle"></h5>
                            <p class="text-muted small mb-1" data-bind="text: purchaseResultMessage"></p>
                            <div class="alert alert-warning py-2 small mt-3 text-start" data-bind="visible: purchaseResultRequiresSessionRefresh">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                <strong>Yeni modulu menude gormek icin oturumu yenileyin.</strong>
                            </div>
                            <a href="/Account/RefreshSession?returnUrl=/Modules" class="btn btn-primary btn-sm mt-1" data-bind="visible: purchaseResultRequiresSessionRefresh">
                                <i class="bi bi-arrow-clockwise me-1"></i>Oturumu Yenile
                            </a>
                        </div>
                        <div class="text-center py-4" data-bind="visible: purchaseResult() && !purchaseResult().success">
                            <i class="bi bi-x-circle-fill text-danger" style="font-size:3rem;"></i>
                            <h5 class="mt-2 text-danger">Odeme Basarisiz</h5>
                            <p class="text-muted small" data-bind="text: purchaseResult() ? purchaseResult().error : ''"></p>
                            <button class="btn btn-outline-primary btn-sm" data-bind="click: function(){ purchaseStep('preview'); }">Tekrar Dene</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/Modules.js" asp-append-version="true"></script>
}
