@{
    ViewData["Title"] = "Modul Yonetimi";
}

<div id="modules-vm">
    <!-- ko if: unpaidBillings().length === 0 -->
    <div class="alert alert-info border-0 shadow-sm mb-4 py-3 small">
        <i class="bi bi-info-circle me-1"></i>
        <strong>Platform tahakkuku:</strong> Şu an ödenmesi gereken dönem kaydı yoksa aşağıda kartla platform ödemesi başlamaz — bu, yeni hesaplarda deneme süresi devam ederken normaldir.
        Ek modül satın alımı yine bu sayfadan yapılabilir.
    </div>
    <!-- /ko -->

    <!-- Odenmemis platform tahakkuku -->
    <!-- ko if: unpaidBillings().length > 0 -->
    <div class="alert alert-warning border-0 shadow-sm mb-4 py-3">
        <h6 class="alert-heading mb-2"><i class="bi bi-receipt-cutoff me-1"></i>Ödenmemiş platform tahakkuku</h6>
        <p class="small mb-2 text-muted">Abonelik döneminize ait borç ödenene kadar hesabınız askıda kalabilir.</p>
        <!-- ko foreach: unpaidBillings -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top border-warning-subtle pt-2 mt-2">
            <div class="small">
                <strong data-bind="text: month + '/' + year + ' donemi'"></strong>
                <span class="text-muted ms-2" data-bind="text: (total != null ? total : (amount + serviceAmount)).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' ₺'"></span>
                <!-- ko if: $index() > 0 -->
                <span class="d-block text-muted mt-1" style="font-size:0.75rem;">Once yukaridaki donemin tamamlanmasi gerekir</span>
                <!-- /ko -->
            </div>
            <!-- ko if: $index() === 0 -->
            <button type="button" class="btn btn-sm btn-warning" data-bind="click: $root.payUnpaidBilling">
                <i class="bi bi-credit-card me-1"></i>Öde
            </button>
            <!-- /ko -->
        </div>
        <!-- /ko -->
    </div>
    <!-- /ko -->

    <!-- Temel Paket -->
    <h6 class="text-muted mb-3"><i class="bi bi-box-seam me-1"></i>Temel Paket</h6>
    <div class="row g-3 mb-4" data-bind="foreach: defaultModules">
        <div class="col-md-4 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi me-2" data-bind="attr: { 'class': 'bi ' + (icon || 'bi-puzzle') }" style="font-size:1.3rem;color:#6f42c1;"></i>
                        <div>
                            <div class="fw-bold small" data-bind="text: description || systemName"></div>
                            <span class="badge bg-success" style="font-size:0.6rem;">Dahil</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Aktif Modulleriniz -->
    <!-- ko if: activeGroups().length > 0 -->
    <h6 class="text-muted mb-3"><i class="bi bi-check-circle me-1"></i>Aktif Modulleriniz</h6>
    <!-- ko foreach: activeGroups -->
    <div class="card border-0 shadow-sm mb-3 border-start border-3 border-success">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-success" data-bind="text: groupName"></span>
                <span class="badge bg-success-subtle text-success ms-1" data-bind="text: packagePrice.toLocaleString('tr-TR') + ' ₺/ay'"></span>
            </div>
            <button class="btn btn-sm btn-outline-danger py-0" data-bind="click: $root.cancelPackage">
                <i class="bi bi-x-circle me-1"></i>Iptal Et
            </button>
        </div>
        <div class="card-body py-2">
            <div class="row g-1">
                <!-- ko foreach: modules -->
                <div class="col-md-6 col-lg-4">
                    <div class="d-flex align-items-center gap-2 py-1">
                        <i data-bind="attr: { 'class': 'bi ' + (icon || 'bi-puzzle') }, style: { color: (typeof isImplemented !== 'undefined' && isImplemented === false) ? '#ccc' : '#198754', fontSize: '.9rem' }"></i>
                        <span class="small" data-bind="text: description || systemName || moduleName, css: { 'text-muted': typeof isImplemented !== 'undefined' && isImplemented === false }"></span>
                        <!-- ko if: typeof isImplemented !== 'undefined' && isImplemented === false -->
                        <i class="bi bi-lock text-warning" style="font-size:.7rem;cursor:help;" title="Bu hizmet yakin zamanda aktif edilecektir."></i>
                        <!-- /ko -->
                    </div>
                </div>
                <!-- /ko -->
            </div>
        </div>
    </div>
    <!-- /ko -->
    <!-- /ko -->

    <!-- Satin Alinabilir Moduller -->
    <h6 class="text-muted mb-3 mt-4"><i class="bi bi-cart-plus me-1"></i>Satin Alinabilir Moduller</h6>
    <!-- ko if: availableModules().length === 0 -->
    <div class="alert alert-info py-2 small">Tum moduller zaten aktif.</div>
    <!-- /ko -->
    <!-- ko foreach: availableGroups -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <div>
                <strong data-bind="text: groupName"></strong>
                <span class="text-muted small ms-1" data-bind="text: '(' + modules.length + ' hizmet)'"></span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-purple" data-bind="text: packagePrice.toLocaleString('tr-TR') + ' ₺/ay'" style="font-size:.85rem;background:#6f42c1;"></span>
                <button class="btn btn-sm btn-success" data-bind="click: $root.purchasePackage">
                    <i class="bi bi-cart-plus me-1"></i>Satin Al
                </button>
            </div>
        </div>
        <div class="card-body py-2">
            <div class="row g-1">
                <!-- ko foreach: modules -->
                <div class="col-md-6 col-lg-4">
                    <div class="d-flex align-items-center gap-2 py-1">
                        <i class="bi" data-bind="attr: { 'class': 'bi ' + (icon || 'bi-puzzle') }" style="color:#6c757d;font-size:.9rem;"></i>
                        <span class="small" data-bind="text: description || moduleName"></span>
                    </div>
                </div>
                <!-- /ko -->
            </div>
        </div>
    </div>
    <!-- /ko -->

    <!-- Aylik Toplam -->
    <div class="card border-0 shadow-sm mt-4 bg-light">
        <div class="card-body py-3">
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold">Aylik Modul Tutari</span>
                <span class="fs-5 fw-bold text-primary" data-bind="text: monthlyTotal().toLocaleString('tr-TR') + ' ₺/ay'"></span>
            </div>
            <!-- ko if: branchCount() > 1 -->
            <div class="small text-muted text-end mt-1">
                <span data-bind="text: branchCount() + ' sube x ' + baseMonthly().toLocaleString('tr-TR') + ' ₺ · ek subelerde %10 indirim (carpan: ' + branchMultiplier().toFixed(1) + ')'"></span>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Satin Alma Modal -->
    <div class="modal fade" id="purchaseModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <!-- ko if: checkoutMode() === 'package' -->
                    <h6 class="modal-title"><i class="bi bi-cart-check me-1"></i>Modul satin al</h6>
                    <!-- /ko -->
                    <!-- ko if: checkoutMode() === 'subscription' -->
                    <h6 class="modal-title"><i class="bi bi-receipt me-1"></i>Platform tahakkuku odemesi</h6>
                    <!-- /ko -->
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Tahakkuk on izleme -->
                    <div data-bind="visible: purchaseStep() === 'invoice-preview'">
                        <div data-bind="with: invoicePayContext">
                            <div class="alert alert-warning py-2 small mb-3">
                                <i class="bi bi-info-circle me-1"></i>Odeme <strong>Iyzico</strong> guvenli odeme sayfasinda tamamlanir.
                            </div>
                            <table class="table table-sm mb-3">
                                <tr>
                                    <td class="text-muted">Donem</td>
                                    <td class="fw-bold text-end" data-bind="text: month + '/' + year"></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Platform + modul tutari</td>
                                    <td class="text-end" data-bind="text: (total != null ? total : (amount + serviceAmount)).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' ₺'"></td>
                                </tr>
                            </table>
                            <button class="btn btn-success w-100" data-bind="click: $root.startSubscriptionCheckout, attr: { disabled: $root.purchaseLoading() }">
                                <i class="bi bi-credit-card me-1"></i>Odemeye gec
                            </button>
                        </div>
                    </div>

                    <!-- Step 1: Pro-rata Preview -->
                    <div data-bind="visible: purchaseStep() === 'preview'">
                        <div class="text-center py-3" data-bind="visible: purchaseLoading()">
                            <div class="spinner-border text-primary"></div>
                            <div class="small text-muted mt-2">Fiyat hesaplaniyor...</div>
                        </div>
                        <div data-bind="visible: !purchaseLoading() && purchasePreview()">
                            <div class="alert alert-info py-2 small mb-3">
                                <i class="bi bi-info-circle me-1"></i>Tahakkuk tarihinize kalan gun icin kist-i hesap ucreti alinacaktir.
                            </div>
                            <table class="table table-sm mb-3">
                                <tr>
                                    <td class="text-muted">Modul</td>
                                    <td class="fw-bold text-end" data-bind="text: purchasePreview() ? purchasePreview().packageName : ''"></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Aylik Fiyat</td>
                                    <td class="text-end" data-bind="text: purchasePreview() ? purchasePreview().monthlyPrice.toLocaleString('tr-TR') + ' ₺' : ''"></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Sonraki Tahakkuk</td>
                                    <td class="text-end" data-bind="text: purchasePreview() ? new Date(purchasePreview().nextBillingDate).toLocaleDateString('tr-TR') : ''"></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Kist-i Hesap</td>
                                    <td class="text-end">
                                        <span data-bind="text: purchasePreview() && purchasePreview().proRata ? purchasePreview().proRata.days + ' gun x ' + purchasePreview().proRata.dailyRate.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺' : ''"></span>
                                    </td>
                                </tr>
                                <tr class="table-success">
                                    <td class="fw-bold">Simdi Odenecek</td>
                                    <td class="fw-bold text-end fs-5 text-success" data-bind="text: purchasePreview() ? purchasePreview().totalNow.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ₺' : ''"></td>
                                </tr>
                            </table>
                            <div class="small text-muted mb-3">
                                <i class="bi bi-calendar-check me-1"></i>Sonraki tahakkuktan itibaren aylik
                                <strong data-bind="text: purchasePreview() ? purchasePreview().monthlyPrice.toLocaleString('tr-TR') + ' ₺' : ''"></strong> faturalandirilacaktir.
                            </div>
                            <button class="btn btn-success w-100" data-bind="click: startCheckout, disable: purchaseLoading()">
                                <i class="bi bi-credit-card me-1"></i>Odemeye Gec
                            </button>
                        </div>
                    </div>

                    <!-- Step 2: Iyzico Checkout Form -->
                    <div data-bind="visible: purchaseStep() === 'checkout'">
                        <div class="text-center py-3" data-bind="visible: purchaseLoading()">
                            <div class="spinner-border text-primary"></div>
                            <div class="small text-muted mt-2">Odeme formu hazirlaniyor...</div>
                        </div>
                        <div id="iyzico-checkout-container" data-bind="iyzicoCheckoutHtml: checkoutFormHtml"></div>
                    </div>

                    <!-- Step 3: Sonuc -->
                    <div data-bind="visible: purchaseStep() === 'result'">
                        <div class="text-center py-4" data-bind="visible: purchaseLoading() && !purchaseResult()">
                            <div class="spinner-border text-primary"></div>
                            <div class="small text-muted mt-2">Odeme sonucu dogrulaniyor...</div>
                        </div>
                        <div class="text-center py-4" data-bind="visible: purchaseResult() && purchaseResult().success && checkoutMode() === 'package'">
                            <i class="bi bi-check-circle-fill text-success" style="font-size:3rem;"></i>
                            <h5 class="mt-2 text-success">Odeme basarili!</h5>
                            <p class="text-muted small mb-1">Modulunuz aktif edildi.</p>
                            <div class="alert alert-warning py-2 small mt-3 text-start">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                <strong>Yeni modulu kullanabilmek icin sistemden cikis yapip tekrar giris yapmaniz gerekmektedir.</strong>
                            </div>
                            <a href="/Account/Logout" class="btn btn-primary btn-sm mt-1">
                                <i class="bi bi-box-arrow-right me-1"></i>Cikis yap ve tekrar giris yap
                            </a>
                        </div>
                        <div class="text-center py-4" data-bind="visible: purchaseResult() && purchaseResult().success && checkoutMode() === 'subscription'">
                            <i class="bi bi-check-circle-fill text-success" style="font-size:3rem;"></i>
                            <h5 class="mt-2 text-success">Odeme basarili!</h5>
                            <p class="text-muted small mb-1">Tahakkugunuz odendi; abonelik askidan kalktiysa kisa sure icinde tam erisim acilir.</p>
                            <div class="alert alert-warning py-2 small mt-3 text-start">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                <strong>Yetkiler guncellenmediyse cikis yapip tekrar giris yapin.</strong>
                            </div>
                            <a href="/Account/Logout" class="btn btn-primary btn-sm mt-1">
                                <i class="bi bi-box-arrow-right me-1"></i>Cikis yap ve tekrar giris yap
                            </a>
                        </div>
                        <div class="text-center py-4" data-bind="visible: purchaseResult() && !purchaseResult().success">
                            <i class="bi bi-x-circle-fill text-danger" style="font-size:3rem;"></i>
                            <h5 class="mt-2 text-danger">Odeme Basarisiz</h5>
                            <p class="text-muted small" data-bind="text: purchaseResult() ? purchaseResult().error : ''"></p>
                            <button class="btn btn-outline-primary btn-sm" data-bind="click: retryPaymentStep">Tekrar dene</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/Modules.js" asp-append-version="true"></script>
}
