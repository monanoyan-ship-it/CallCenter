@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.modules.title", "Modül Yönetimi");
}

<div id="modules-vm">
    <!-- ko if: platformUnpaid().length > 0 -->
    <div class="alert alert-warning border-warning mb-3 py-2 small">
        <div class="fw-semibold mb-1"><i class="bi bi-receipt-cutoff me-1"></i><span data-bind="text: platformBillingTitle"></span></div>
        <ul class="mb-2 ps-3" data-bind="foreach: platformUnpaid">
            <li><span data-bind="text: (month || '-') + '/' + (year || '-')"></span> —
                <strong data-bind="text: (total || 0).toLocaleString(document.documentElement.lang || undefined, { minimumFractionDigits: 2 }) + ' ₺'"></strong></li>
        </ul>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <button type="button" class="btn btn-sm btn-success" data-bind="click: startPlatformAccrualPayment, disable: platformPayLoading">
                <span data-bind="visible: platformPayLoading" class="spinner-border spinner-border-sm me-1"></span>
                <i class="bi bi-credit-card me-1"></i><t key="salon.modules.pay_accrual_card">Kredi kartı ile tahakkuk ödemesi</t>
            </button>
            <span class="text-muted" data-bind="text: platformBillingHint"></span>
        </div>
    </div>
    <!-- /ko -->

    <!-- Temel Paket -->
    <h6 class="text-muted mb-3"><i class="bi bi-box-seam me-1"></i><t key="salon.modules.base_package">Temel Paket</t></h6>
    <div class="border rounded-2 bg-light p-3 mb-3">
        <div class="d-flex flex-wrap justify-content-between gap-2 align-items-start">
            <div>
                <div class="fw-semibold"><t key="salon.modules.base_package">Temel Paket</t></div>
                <div class="small text-muted" data-bind="text: basePackageSummary"></div>
                <div class="small mt-1" data-bind="text: basePackageOutcome"></div>
            </div>
            <span class="badge bg-success-subtle text-success" data-bind="text: priceForGroup(0).toLocaleString(document.documentElement.lang || undefined) + ' ' + salonT('salon.modules.per_month_suffix', '₺/ay')"></span>
        </div>
    </div>
    <div class="row g-3 mb-4" data-bind="foreach: defaultModules">
        <div class="col-md-4 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi me-2" data-bind="attr: { 'class': 'bi ' + (icon || 'bi-puzzle') }" style="font-size:1.3rem;color:#6f42c1;"></i>
                        <div>
                            <div class="fw-bold small" data-bind="text: description || systemName"></div>
                            <span class="badge bg-success" style="font-size:0.6rem;"><t key="salon.modules.included">Dahil</t></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Aktif Modulleriniz -->
    <!-- ko if: activeGroups().length > 0 -->
    <h6 class="text-muted mb-3"><i class="bi bi-check-circle me-1"></i><t key="salon.modules.active_title">Aktif Modülleriniz</t></h6>
    <!-- ko foreach: activeGroups -->
    <div class="card border-0 shadow-sm mb-3 border-start border-3 border-success">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-start gap-3">
            <div>
                <span class="badge bg-success" data-bind="text: groupName"></span>
                <span class="badge bg-success-subtle text-success ms-1" data-bind="text: packagePrice.toLocaleString(document.documentElement.lang || undefined) + ' ' + salonT('salon.modules.per_month_suffix', '₺/ay')"></span>
                <div class="small text-muted mt-1" data-bind="visible: summary, text: summary"></div>
                <div class="small mt-1" data-bind="visible: outcome, text: outcome"></div>
            </div>
            <button class="btn btn-sm btn-outline-danger py-0 flex-shrink-0" data-bind="click: $root.cancelPackage">
                <i class="bi bi-x-circle me-1"></i><t key="salon.panel.cancel.confirm">İptal Et</t>
            </button>
        </div>
        <div class="card-body py-2">
            <div class="row g-1">
                <!-- ko foreach: modules -->
                <div class="col-md-6 col-lg-4">
                    <div class="d-flex align-items-center gap-2 py-1">
                        <i data-bind="attr: { 'class': 'bi ' + (icon || 'bi-puzzle') }, style: { color: (typeof isImplemented !== 'undefined' && isImplemented === false) ? '#ccc' : '#198754', fontSize: '.9rem' }"></i>
                        <span class="small" data-bind="text: description || systemName || moduleName, css: { 'text-muted': typeof isImplemented !== 'undefined' && isImplemented === false }"></span>
                        <!-- ko if: typeof isImplemented !== 'undefined' && isImplemented === false -->
                        <i class="bi bi-lock text-warning" style="font-size:.7rem;cursor:help;" title="@(Translation.T("salon.modules.coming_soon", "Bu hizmet yakın zamanda aktif edilecektir."))"></i>
                        <!-- /ko -->
                    </div>
                </div>
                <!-- /ko -->
            </div>
        </div>
    </div>
    <!-- /ko -->
    <!-- /ko -->

    <!-- Satin Alinabilir Moduller -->
    <h6 class="text-muted mb-3 mt-4"><i class="bi bi-cart-plus me-1"></i><t key="salon.modules.available_title">Satın Alınabilir Modüller</t></h6>
    <!-- ko if: availableModules().length === 0 -->
    <div class="alert alert-info py-2 small"><t key="salon.modules.all_active">Tüm modüller zaten aktif.</t></div>
    <!-- /ko -->
    <!-- ko foreach: availableGroups -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-start gap-3">
            <div>
                <strong data-bind="text: groupName"></strong>
                <span class="text-muted small ms-1" data-bind="text: '(' + modules.length + ' ' + salonT('salon.profile.services.count_suffix', 'hizmet') + ')'"></span>
                <div class="small text-muted mt-1" data-bind="visible: summary, text: summary"></div>
                <div class="small mt-1" data-bind="visible: outcome, text: outcome"></div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                <span class="badge bg-purple" data-bind="text: packagePrice.toLocaleString(document.documentElement.lang || undefined) + ' ' + salonT('salon.modules.per_month_suffix', '₺/ay')" style="font-size:.85rem;background:#6f42c1;"></span>
                <!-- ko if: hasImplemented -->
                <button class="btn btn-sm btn-success" data-bind="click: $root.purchasePackage">
                    <i class="bi bi-cart-plus me-1"></i><t key="salon.modules.purchase">Satın Al</t>
                </button>
                <!-- /ko -->
                <!-- ko ifnot: hasImplemented -->
                <button class="btn btn-sm btn-outline-secondary" disabled title="@(Translation.T("salon.modules.package_coming_soon", "Bu paket yakında aktif edilecek; şu an satın alınamaz."))">
                    <i class="bi bi-lock me-1"></i><t key="salon.modules.coming_soon_short">Yakında</t>
                </button>
                <!-- /ko -->
            </div>
        </div>
        <div class="card-body py-2">
            <div class="row g-1">
                <!-- ko foreach: modules -->
                <div class="col-md-6 col-lg-4">
                    <div class="d-flex align-items-center gap-2 py-1">
                        <i class="bi" data-bind="attr: { 'class': 'bi ' + (icon || 'bi-puzzle') }" style="color:#6c757d;font-size:.9rem;"></i>
                        <span class="small" data-bind="text: description || moduleName"></span>
                    </div>
                </div>
                <!-- /ko -->
            </div>
        </div>
    </div>
    <!-- /ko -->

    <!-- Aylik Toplam -->
    <div class="card border-0 shadow-sm mt-4 bg-light">
        <div class="card-body py-3">
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold"><t key="salon.modules.monthly_total">Aylık Modül Tutarı</t></span>
                <span class="fs-5 fw-bold text-primary" data-bind="text: displayMonthlyTotal().toLocaleString(document.documentElement.lang || undefined) + ' ' + salonT('salon.modules.per_month_suffix', '₺/ay')"></span>
            </div>
            <!-- ko if: branchSummaryText().length > 0 -->
            <div class="small text-muted text-end mt-1" data-bind="text: branchSummaryText"></div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Odeme gecmisi -->
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="bi bi-clock-history me-1"></i><t key="salon.modules.payment_history">Ödeme Geçmişi</t></h6>
            <button type="button" class="btn btn-outline-primary btn-sm" data-bind="click: loadPaymentHistory, disable: paymentHistoryLoading">
                <span class="spinner-border spinner-border-sm me-1" data-bind="visible: paymentHistoryLoading"></span>
                <i class="bi bi-arrow-clockwise" data-bind="visible: !paymentHistoryLoading()"></i>
            </button>
        </div>
        <div class="card-body p-0">
            <div class="text-center py-4" data-bind="visible: paymentHistoryLoading">
                <div class="spinner-border text-primary"></div>
            </div>
            <div class="text-center text-muted py-4" data-bind="visible: !paymentHistoryLoading() && paymentHistory().length === 0">
                <t key="salon.panel.payments.empty">Henüz ödeme kaydı yok.</t>
            </div>
            <div class="table-responsive" data-bind="visible: !paymentHistoryLoading() && paymentHistory().length > 0">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th><t key="salon.panel.payments.date">Tarih</t></th>
                            <th><t key="salon.panel.payments.type">Tür</t></th>
                            <th><t key="salon.modules.payment_method">Yöntem</t></th>
                            <th class="text-end"><t key="salon.panel.payments.amount">Tutar</t></th>
                            <th><t key="salon.panel.payments.status">Durum</t></th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: paymentHistory">
                        <tr>
                            <td class="small text-nowrap" data-bind="text: $root.paymentDateText($data)"></td>
                            <td class="small" data-bind="text: paymentType || '-'"></td>
                            <td class="small" data-bind="text: paymentMethod || provider || '-'"></td>
                            <td class="small text-end fw-semibold" data-bind="text: $root.paymentAmountText($data)"></td>
                            <td>
                                <span class="small fw-semibold" data-bind="css: $root.paymentStatusClass($data), text: status || '-'"></span>
                                <div class="small text-danger" data-bind="visible: errorMessage, text: errorMessage"></div>
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 me-1"
                                        data-bind="visible: canDownloadReceipt, click: $root.downloadReceipt">
                                    <i class="bi bi-download me-1"></i><t key="salon.modules.receipt">Dekont</t>
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 me-1"
                                        data-bind="visible: canDownloadHavaleReceipt, click: $root.downloadHavaleReceipt">
                                    <i class="bi bi-paperclip me-1"></i><t key="salon.modules.bank_transfer">Havale</t>
                                </button>
                                <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2"
                                        data-bind="visible: canRetry, click: $root.retryPayment">
                                    <i class="bi bi-arrow-repeat me-1"></i><t key="salon.modules.retry">Tekrar Dene</t>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Satin Alma Modal -->
    <div class="modal fade" id="purchaseModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><i class="bi bi-cart-check me-1"></i><span data-bind="text: purchaseModalTitle"></span></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Step 1: Pro-rata Preview -->
                    <div data-bind="visible: purchaseStep() === 'preview'">
                        <div class="text-center py-3" data-bind="visible: purchaseLoading()">
                            <div class="spinner-border text-primary"></div>
                            <div class="small text-muted mt-2"><t key="salon.modules.price_calculating">Fiyat hesaplanıyor...</t></div>
                        </div>
                        <div data-bind="visible: !purchaseLoading() && purchasePreview()">
                            <div class="alert alert-info py-2 small mb-3">
                                <i class="bi bi-info-circle me-1"></i><t key="salon.modules.prorata_info">Bugün yalnız sonraki tahakkuk tarihine kadar olan kıst dönem tahsil edilir; fiyatlar KDV dahildir.</t>
                            </div>
                            <table class="table table-sm mb-3">
                                <tr>
                                    <td class="text-muted"><t key="salon.modules.module">Modül</t></td>
                                    <td class="fw-bold text-end" data-bind="text: purchasePreview() ? purchasePreview().packageName : ''"></td>
                                </tr>
                                <tr>
                                    <td class="text-muted"><t key="salon.modules.monthly_package_price">Aylık Paket Fiyatı</t></td>
                                    <td class="text-end" data-bind="text: purchasePreview() ? purchasePreview().monthlyPrice.toLocaleString(document.documentElement.lang || undefined) + ' ₺' : ''"></td>
                                </tr>
                                <tr>
                                    <td class="text-muted"><t key="salon.modules.next_billing">Sonraki Tahakkuk</t></td>
                                    <td class="text-end" data-bind="text: purchasePreview() ? new Date(purchasePreview().nextBillingDate).toLocaleDateString(document.documentElement.lang || undefined) : ''"></td>
                                </tr>
                                <tr>
                                    <td class="text-muted"><t key="salon.modules.prorata">Kıst-ı Hesap</t></td>
                                    <td class="text-end">
                                        <span data-bind="text: purchasePreview() && purchasePreview().proRata ? purchasePreview().proRata.days + ' ' + salonT('salon.modules.days', 'gün') + ' x ' + purchasePreview().proRata.dailyRate.toLocaleString(document.documentElement.lang || undefined, {minimumFractionDigits:2}) + ' ₺' : ''"></span>
                                    </td>
                                </tr>
                                <tr class="table-success">
                                    <td class="fw-bold"><t key="salon.modules.pay_now">Şimdi Ödenecek</t></td>
                                    <td class="fw-bold text-end fs-5 text-success" data-bind="text: purchasePreview() ? purchasePreview().totalNow.toLocaleString(document.documentElement.lang || undefined, {minimumFractionDigits:2}) + ' ₺' : ''"></td>
                                </tr>
                                <tr>
                                    <td class="text-muted"><t key="salon.modules.recurring_from_next">Sonraki Dönemlerden İtibaren</t></td>
                                    <td class="text-end" data-bind="text: purchasePreview() ? (purchasePreview().recurringMonthlyAmount || purchasePreview().monthlyPrice).toLocaleString(document.documentElement.lang || undefined, {minimumFractionDigits:2}) + ' ' + salonT('salon.modules.per_month_tax_included', '₺/ay (KDV dahil)') : ''"></td>
                                </tr>
                            </table>
                            <div class="small text-muted mb-3">
                                <i class="bi bi-calendar-check me-1"></i>
                                 <span data-bind="text: purchasePreview() && purchasePreview().billingNote ? purchasePreview().billingNote : salonT('salon.modules.default_billing_note', 'Sonraki tahakkuktan itibaren paket aylık olarak faturalandırılacaktır.')"></span>
                            </div>
                            <button class="btn btn-success w-100" data-bind="click: startCheckout, disable: purchaseLoading()">
                                <i class="bi bi-credit-card me-1"></i><t key="salon.modules.go_to_payment">Ödemeye Geç</t>
                            </button>
                        </div>
                    </div>

                    <!-- Step 2: Iyzico Checkout Form -->
                    <div data-bind="visible: purchaseStep() === 'checkout'">
                        <div class="text-center py-3" data-bind="visible: purchaseLoading()">
                            <div class="spinner-border text-primary"></div>
                            <div class="small text-muted mt-2"><t key="salon.modules.payment_form_preparing">Ödeme formu hazırlanıyor...</t></div>
                        </div>
                        <div id="iyzico-checkout-container" data-bind="iyzicoCheckoutHtml: checkoutFormHtml"></div>
                    </div>

                    <!-- Step 3: Sonuc -->
                    <div data-bind="visible: purchaseStep() === 'result'">
                        <div class="text-center py-4" data-bind="visible: purchaseLoading() && !purchaseResult()">
                            <div class="spinner-border text-primary"></div>
                            <div class="small text-muted mt-2"><t key="salon.modules.payment_result_checking">Ödeme sonucu doğrulanıyor...</t></div>
                        </div>
                        <div class="text-center py-4" data-bind="visible: purchaseResult() && purchaseResult().success">
                            <i class="bi bi-check-circle-fill text-success" style="font-size:3rem;"></i>
                            <h5 class="mt-2 text-success" data-bind="text: purchaseResultTitle"></h5>
                            <p class="text-muted small mb-1" data-bind="text: purchaseResultMessage"></p>
                            <div class="alert alert-warning py-2 small mt-3 text-start" data-bind="visible: purchaseResultRequiresSessionRefresh">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                <strong><t key="salon.modules.session_refresh_required">Yeni modülü menüde görmek için oturumu yenileyin.</t></strong>
                            </div>
                            <a href="/Account/RefreshSession?returnUrl=/Modules" class="btn btn-primary btn-sm mt-1" data-bind="visible: purchaseResultRequiresSessionRefresh">
                                <i class="bi bi-arrow-clockwise me-1"></i><t key="salon.modules.refresh_session">Oturumu Yenile</t>
                            </a>
                        </div>
                        <div class="text-center py-4" data-bind="visible: purchaseResult() && !purchaseResult().success">
                            <i class="bi bi-x-circle-fill text-danger" style="font-size:3rem;"></i>
                            <h5 class="mt-2 text-danger"><t key="salon.modules.payment_failed_title">Ödeme Başarısız</t></h5>
                            <p class="text-muted small" data-bind="text: purchaseResult() ? purchaseResult().error : ''"></p>
                            <button class="btn btn-outline-primary btn-sm" data-bind="click: function(){ purchaseStep('preview'); }"><t key="salon.modules.retry">Tekrar Dene</t></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/Modules.js" asp-append-version="true"></script>
}
