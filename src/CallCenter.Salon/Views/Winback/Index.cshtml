@{
    ViewData["Title"] = "Musteri Geri Kazanim";
}

<div id="winback-vm">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0">Kayip Musteri Geri Kazanim Kurallari</h6>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i>Yeni Kural
        </button>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Kural Adi</th>
                            <th>Pasif Gun</th>
                            <th>Kanal</th>
                            <th>Indirim</th>
                            <th>Durum</th>
                            <th style="width:120px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: rules">
                        <tr>
                            <td class="fw-semibold small" data-bind="text: name"></td>
                            <td class="small" data-bind="text: inactiveDays + ' gun'"></td>
                            <td class="small" data-bind="text: $parent.channelText(channelId)"></td>
                            <td class="small" data-bind="text: discountPercent ? '%' + discountPercent : '-'"></td>
                            <td class="small">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" data-bind="checked: isActiveObs, click: $parent.toggleRule" />
                                </div>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary" title="Duzenle" data-bind="click: $parent.openEdit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" title="Sil" data-bind="click: $parent.remove">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: rules().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-arrow-repeat" style="font-size:2rem;"></i>
                <p class="mt-2 small">Henuz geri kazanim kurali tanimlanmamis</p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Kural Modal -->
    <div class="modal fade" id="winbackModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditing() ? 'Kural Duzenle' : 'Yeni Kural'"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small">Kural Adi *</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.name" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Pasif Gun Esigi *</label>
                            <input type="number" class="form-control form-control-sm" min="1" data-bind="value: form.inactiveDays" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Kanal</label>
                            <select class="form-select form-select-sm" data-bind="value: form.channelId">
                                <option value="1">SMS</option>
                                <option value="2">WhatsApp</option>
                                <option value="3">E-posta</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Mesaj Sablonu *</label>
                            <textarea class="form-control form-control-sm" rows="3" data-bind="value: form.messageTemplate"></textarea>
                            <small class="text-muted">Degiskenler: {ad}, {gun}, {indirim}</small>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Indirim (%)</label>
                            <input type="number" class="form-control form-control-sm" min="0" max="100" data-bind="value: form.discountPercent" />
                        </div>
                        <div class="col-6">
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" id="ruleActive" data-bind="checked: form.isActive" />
                                <label class="form-check-label small" for="ruleActive">Aktif</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Winback.js" asp-append-version="true"></script>
}
