@{
    ViewData["Title"] = "Musteriler";
}

<div id="clients-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="input-group" style="max-width: 320px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="Musteri ara..." data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
        </div>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i>Yeni Musteri
        </button>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Ad Soyad</th>
                            <th>Telefon</th>
                            <th>E-posta</th>
                            <th>Cinsiyet</th>
                            <th>Randevu</th>
                            <th>Harcama</th>
                            <th style="width: 80px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredClients">
                        <tr>
                            <td class="fw-semibold small">
                                <a data-bind="text: fullName, attr: { href: '/Clients/Detail/' + id }" class="text-decoration-none"></a>
                            </td>
                            <td class="small" data-bind="text: phone"></td>
                            <td class="small" data-bind="text: email"></td>
                            <td class="small" data-bind="text: genderText"></td>
                            <td class="small">
                                <!-- ko if: appointmentCount > 0 -->
                                <span class="badge bg-info" data-bind="text: appointmentCount"></span>
                                <!-- /ko -->
                            </td>
                            <td class="small" data-bind="text: totalSpent ? totalSpent.toLocaleString('tr-TR') + ' TL' : '-'"></td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" title="Duzenle" data-bind="click: $parent.openEdit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" title="Sil" data-bind="click: $parent.remove">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: filteredClients().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-people" style="font-size: 2rem;"></i>
                <p class="mt-2 small">Henuz musteri eklenmemis</p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Sayfalama -->
    <div class="d-flex justify-content-between align-items-center mt-3" data-bind="visible: totalPages() > 1">
        <small class="text-muted" data-bind="text: 'Toplam ' + totalCount() + ' musteri'"></small>
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item" data-bind="css: { disabled: currentPage() <= 1 }">
                    <a class="page-link" href="#" data-bind="click: prevPage">Onceki</a>
                </li>
                <!-- ko foreach: pageNumbers -->
                <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                    <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                </li>
                <!-- /ko -->
                <li class="page-item" data-bind="css: { disabled: currentPage() >= totalPages() }">
                    <a class="page-link" href="#" data-bind="click: nextPage">Sonraki</a>
                </li>
            </ul>
        </nav>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="clientModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditing() ? 'Musteri Duzenle' : 'Yeni Musteri'"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small">Ad Soyad *</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.fullName" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Telefon *</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.phone" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Telefon 2</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.phone2" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">E-posta</label>
                            <input type="email" class="form-control form-control-sm" data-bind="value: form.email" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Cinsiyet</label>
                            <select class="form-select form-select-sm" data-bind="value: form.genderId">
                                <option value="">Seciniz</option>
                                <option value="1">Erkek</option>
                                <option value="2">Kadin</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Dogum Tarihi</label>
                            <input type="date" class="form-control form-control-sm" data-bind="value: form.birthDate" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Sehir</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.city" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Adres</label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: form.address"></textarea>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Sac Rengi</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.hairColor" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Cilt Tipi</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.skinType" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Not</label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: form.notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Clients.js" asp-append-version="true"></script>
}
