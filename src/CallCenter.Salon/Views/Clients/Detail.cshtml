@{
    ViewData["Title"] = "Musteri Detay";
    var clientId = (int)ViewData["ClientId"]!;
}

<div id="client-detail-vm">
    <!-- Ust Kart: Musteri Bilgisi -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-purple bg-opacity-10 d-flex align-items-center justify-content-center me-3" style="width:56px;height:56px;">
                        <i class="bi bi-person-fill text-purple fs-4"></i>
                    </div>
                    <div>
                        <h5 class="mb-1" data-bind="text: client().fullName">...</h5>
                        <div class="text-muted small">
                            <span data-bind="text: client().genderText || ''"></span>
                            <!-- ko if: client().birthDate -->
                            <span> | <span data-bind="text: client().age + ' yas'"></span></span>
                            <!-- /ko -->
                        </div>
                        <div class="mt-1">
                            <span class="me-3"><i class="bi bi-telephone me-1"></i><span data-bind="text: client().phone"></span></span>
                            <!-- ko if: client().email -->
                            <span><i class="bi bi-envelope me-1"></i><span data-bind="text: client().email"></span></span>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
                <div class="text-end">
                    <a href="/Clients" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i>Listeye Don
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI Kartlari -->
    <div class="row g-2 mb-3">
        <div class="col-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .7rem;">Toplam Randevu</div>
                    <div class="fw-bold text-primary" data-bind="text: appointments().length">0</div>
                </div>
            </div>
        </div>
        <div class="col-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .7rem;">Toplam Harcama</div>
                    <div class="fw-bold text-success" data-bind="text: totalSpent().toLocaleString('tr-TR') + ' TL'">0 TL</div>
                </div>
            </div>
        </div>
        <div class="col-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .7rem;">Son Ziyaret</div>
                    <div class="fw-bold text-info" data-bind="text: lastVisit() || '-'">-</div>
                </div>
            </div>
        </div>
        <div class="col-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .7rem;">Fotograf</div>
                    <div class="fw-bold text-warning" data-bind="text: photos().length">0</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab Yapisi -->
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-info">
                <i class="bi bi-person me-1"></i>Bilgiler
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-formulas">
                <i class="bi bi-card-text me-1"></i>Formuller
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-photos">
                <i class="bi bi-image me-1"></i>Fotograflar
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-appointments">
                <i class="bi bi-calendar-check me-1"></i>Randevular
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-invoices">
                <i class="bi bi-receipt me-1"></i>Harcamalar
            </button>
        </li>
    </ul>

    <div class="tab-content mt-0">
        <!-- Bilgiler -->
        <div class="tab-pane fade show active" id="tab-info">
            <div class="card border-0 shadow-sm border-top-0 rounded-top-0">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-sm table-borderless">
                                <tr><td class="text-muted small" style="width:120px;">Ad Soyad</td><td class="small" data-bind="text: client().fullName"></td></tr>
                                <tr><td class="text-muted small">Telefon</td><td class="small" data-bind="text: client().phone"></td></tr>
                                <tr><td class="text-muted small">E-posta</td><td class="small" data-bind="text: client().email || '-'"></td></tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-sm table-borderless">
                                <tr><td class="text-muted small" style="width:120px;">Cinsiyet</td><td class="small" data-bind="text: client().genderText || '-'"></td></tr>
                                <tr><td class="text-muted small">Dogum Tarihi</td><td class="small" data-bind="text: client().birthDate ? new Date(client().birthDate).toLocaleDateString('tr-TR') : '-'"></td></tr>
                                <tr><td class="text-muted small">Adres</td><td class="small" data-bind="text: client().address || '-'"></td></tr>
                                <tr><td class="text-muted small">Kayit Tarihi</td><td class="small" data-bind="text: client().createdAt ? new Date(client().createdAt).toLocaleDateString('tr-TR') : '-'"></td></tr>
                            </table>
                        </div>
                    </div>
                    <!-- ko if: client().notes -->
                    <div class="mt-2">
                        <small class="text-muted">Not:</small>
                        <p class="small mb-0" data-bind="text: client().notes"></p>
                    </div>
                    <!-- /ko -->
                </div>
            </div>
        </div>

        <!-- Formuller -->
        <div class="tab-pane fade" id="tab-formulas">
            <div class="card border-0 shadow-sm border-top-0 rounded-top-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="mb-0">Uygulanan Formuller</h6>
                        <button class="btn btn-primary btn-sm" data-bind="click: openNewFormula">
                            <i class="bi bi-plus-lg me-1"></i>Yeni Formul
                        </button>
                    </div>
                    <div data-bind="foreach: formulas">
                        <div class="border rounded p-3 mb-2">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <span class="fw-semibold small" data-bind="text: formulaText"></span>
                                    <span class="text-muted small ms-2" data-bind="text: new Date(appliedAt).toLocaleDateString('tr-TR')"></span>
                                </div>
                                <button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.removeFormula" title="Sil">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                            <!-- ko if: colorCode -->
                            <span class="badge bg-secondary me-1" data-bind="text: 'Renk: ' + colorCode"></span>
                            <!-- /ko -->
                            <!-- ko if: oxidantRatio -->
                            <span class="badge bg-secondary me-1" data-bind="text: 'Oksidan: ' + oxidantRatio"></span>
                            <!-- /ko -->
                            <!-- ko if: applicationNotes -->
                            <p class="small mb-0 mt-1 text-muted" data-bind="text: applicationNotes"></p>
                            <!-- /ko -->
                        </div>
                    </div>
                    <!-- ko if: formulas().length === 0 -->
                    <div class="text-center text-muted py-3 small">Henuz formul girilmemis</div>
                    <!-- /ko -->
                </div>
            </div>
        </div>

        <!-- Fotograflar -->
        <div class="tab-pane fade" id="tab-photos">
            <div class="card border-0 shadow-sm border-top-0 rounded-top-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="mb-0">Fotograflar</h6>
                        <button class="btn btn-primary btn-sm" data-bind="click: openPhotoUpload">
                            <i class="bi bi-upload me-1"></i>Fotograf Yukle
                        </button>
                    </div>
                    <div class="row g-2" data-bind="foreach: photos">
                        <div class="col-md-3 col-sm-4">
                            <div class="card border">
                                <img data-bind="attr: { src: thumbnailUrl || url }" class="card-img-top" style="height:150px;object-fit:cover;" />
                                <div class="card-body p-2">
                                    <small class="text-muted" data-bind="text: new Date(createdAt).toLocaleDateString('tr-TR')"></small>
                                    <button class="btn btn-outline-danger btn-sm float-end" data-bind="click: $parent.removePhoto" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- ko if: photos().length === 0 -->
                    <div class="text-center text-muted py-3 small">Henuz fotograf yuklenmemis</div>
                    <!-- /ko -->
                </div>
            </div>
        </div>

        <!-- Randevular -->
        <div class="tab-pane fade" id="tab-appointments">
            <div class="card border-0 shadow-sm border-top-0 rounded-top-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr><th>Tarih</th><th>Saat</th><th>Hizmet</th><th>Personel</th><th>Durum</th></tr>
                            </thead>
                            <tbody data-bind="foreach: appointments">
                                <tr>
                                    <td class="small" data-bind="text: new Date(appointmentDate).toLocaleDateString('tr-TR')"></td>
                                    <td class="small" data-bind="text: startTime"></td>
                                    <td class="small fw-semibold" data-bind="text: serviceName"></td>
                                    <td class="small" data-bind="text: staffName"></td>
                                    <td><span class="badge" data-bind="text: statusText, css: statusCss"></span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- ko if: appointments().length === 0 -->
                    <div class="text-center text-muted py-3 small">Randevu bulunamadi</div>
                    <!-- /ko -->
                </div>
            </div>
        </div>

        <!-- Harcamalar -->
        <div class="tab-pane fade" id="tab-invoices">
            <div class="card border-0 shadow-sm border-top-0 rounded-top-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr><th>Tarih</th><th>Adisyon No</th><th>Hizmetler</th><th>Tutar</th><th>Durum</th></tr>
                            </thead>
                            <tbody data-bind="foreach: invoices">
                                <tr>
                                    <td class="small" data-bind="text: new Date(invoiceDate).toLocaleDateString('tr-TR')"></td>
                                    <td class="small fw-semibold" data-bind="text: invoiceNo"></td>
                                    <td class="small" data-bind="text: servicesSummary"></td>
                                    <td class="small" data-bind="text: totalAmount.toLocaleString('tr-TR') + ' TL'"></td>
                                    <td><span class="badge" data-bind="text: statusText, css: statusCss"></span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- ko if: invoices().length === 0 -->
                    <div class="text-center text-muted py-3 small">Adisyon bulunamadi</div>
                    <!-- /ko -->
                </div>
            </div>
        </div>
    </div>

    <!-- Formul Modal -->
    <div class="modal fade" id="formulaModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">Yeni Formul</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small">Formul Metni *</label>
                        <input type="text" class="form-control form-control-sm" data-bind="value: formulaForm.formulaText" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label small">Renk Kodu</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: formulaForm.colorCode" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Oksidan Orani</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: formulaForm.oxidantRatio" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label small">Uygulama Notlari</label>
                        <textarea class="form-control form-control-sm" rows="3" data-bind="value: formulaForm.applicationNotes"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: saveFormula, disable: isSaving">
                        <i class="bi bi-check-lg me-1"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Photo Upload Modal -->
    <div class="modal fade" id="photoModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">Fotograf Yukle</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="file" class="form-control form-control-sm" id="photoFile" accept="image/*" />
                    <small class="text-muted">Maksimum 5MB, JPG/PNG desteklenir.</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: uploadPhoto, disable: isSaving">
                        <i class="bi bi-upload me-1"></i>Yukle
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-purple { color: #7b1fa2 !important; }
    .bg-purple { background-color: #7b1fa2 !important; }
</style>

@section Scripts {
    <script>
        var clientDetailId = @clientId;
    </script>
    <script src="~/js/ClientDetail.js" asp-append-version="true"></script>
}
