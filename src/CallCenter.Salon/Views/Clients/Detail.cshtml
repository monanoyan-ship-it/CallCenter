@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.clients.auto.musteri_detay", "Müşteri Detay");
    var clientId = (int)ViewData["ClientId"]!;
}

<div id="client-detail-vm">
    <!-- Ust Kart: Musteri Bilgisi -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-purple bg-opacity-10 d-flex align-items-center justify-content-center me-3" style="width:56px;height:56px;">
                        <i class="bi bi-person-fill text-purple fs-4"></i>
                    </div>
                    <div>
                        <h5 class="mb-1" data-bind="text: client().fullName">...</h5>
                        <div class="text-muted small">
                            <span data-bind="text: client().genderText || ''"></span>
                            <!-- ko if: client().birthDate -->
                            <span> | <span data-bind="text: client().age + ' yas'"></span></span>
                            <!-- /ko -->
                        </div>
                        <div class="mt-1">
                            <span class="me-3"><i class="bi bi-telephone me-1"></i><span data-bind="text: client().phone"></span></span>
                            <!-- ko if: client().email -->
                            <span><i class="bi bi-envelope me-1"></i><span data-bind="text: client().email"></span></span>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
                <div class="text-end">
                    <a href="/Clients" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i><t key="salon.clients.auto.listeye_don">Listeye Dön</t>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI Kartlari -->
    <div class="row g-2 mb-3">
        <div class="col-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .7rem;"><t key="salon.clients.auto.toplam_randevu">Toplam Randevu</t></div>
                    <div class="fw-bold text-primary" data-bind="text: appointments().length">0</div>
                </div>
            </div>
        </div>
        <div class="col-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .7rem;"><t key="salon.clients.auto.toplam_harcama">Toplam Harcama</t></div>
                    <div class="fw-bold text-success" data-bind="text: totalSpent().toLocaleString(document.documentElement.lang || undefined) + ' TL'">0 TL</div>
                </div>
            </div>
        </div>
        <div class="col-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .7rem;"><t key="salon.clients.auto.son_ziyaret">Son Ziyaret</t></div>
                    <div class="fw-bold text-info" data-bind="text: lastVisit() || '-'">-</div>
                </div>
            </div>
        </div>
        <div class="col-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .7rem;"><t key="salon.clients.auto.fotograf">Fotoğraf</t></div>
                    <div class="fw-bold text-warning" data-bind="text: photos().length">0</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Musteri Cebi -->
    <div class="card border-0 shadow-sm mb-3 client-wallet-summary">
        <div class="card-header bg-white border-0 d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-2">
            <div>
                <h6 class="mb-1"><i class="bi bi-wallet2 me-2 text-primary"></i><t key="salon.clients.wallet.title">Müşteri Cebi</t></h6>
                <small class="text-muted"><t key="salon.clients.wallet.desc">Üyelik, seans hakkı, sadakat puanı ve hediye kartını tek bakışta gösterir.</t></small>
            </div>
            <a class="btn btn-outline-primary btn-sm" href="/Marketing?tab=loyalty">
                <i class="bi bi-arrow-up-right me-1"></i><t key="salon.clients.wallet.open_marketing">Sadakat ve Üyelikleri Aç</t>
            </a>
        </div>
        <div class="card-body pt-0">
            <div class="row g-3">
                <div class="col-md-3 col-6">
                    <div class="client-wallet-item">
                        <span class="client-wallet-icon text-warning bg-warning-subtle"><i class="bi bi-star-fill"></i></span>
                        <div>
                            <div class="text-muted small"><t key="salon.clients.wallet.loyalty">Sadakat Puanı</t></div>
                            <div class="fw-semibold" data-bind="text: loyaltyPointsText">-</div>
                            <small class="text-muted" data-bind="text: loyaltyValueText"></small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="client-wallet-item">
                        <span class="client-wallet-icon text-success bg-success-subtle"><i class="bi bi-award-fill"></i></span>
                        <div>
                            <div class="text-muted small"><t key="salon.clients.wallet.membership">Üyelik</t></div>
                            <div class="fw-semibold" data-bind="text: membershipText">-</div>
                            <small class="text-muted" data-bind="text: membershipSubtext"></small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="client-wallet-item">
                        <span class="client-wallet-icon text-info bg-info-subtle"><i class="bi bi-card-checklist"></i></span>
                        <div>
                            <div class="text-muted small"><t key="salon.clients.wallet.packages">Seans Hakları</t></div>
                            <div class="fw-semibold" data-bind="text: packageSessionsText">-</div>
                            <small class="text-muted" data-bind="text: packageSubtext"></small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="client-wallet-item">
                        <span class="client-wallet-icon text-danger bg-danger-subtle"><i class="bi bi-gift-fill"></i></span>
                        <div>
                            <div class="text-muted small"><t key="salon.clients.wallet.gift_cards">Hediye Kartı</t></div>
                            <div class="fw-semibold" data-bind="text: giftCardBalanceText">-</div>
                            <small class="text-muted" data-bind="text: giftCardSubtext"></small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab Yapisi -->
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-info">
                <i class="bi bi-person me-1"></i><t key="salon.clients.auto.bilgiler">Bilgiler</t>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-formulas">
                <i class="bi bi-card-text me-1"></i><t key="salon.clients.auto.formuller">Formüller</t>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-treatment">
                <i class="bi bi-heart-pulse me-1"></i><t key="salon.clients.treatment.tab">Tedavi Dosyasi</t>
                <!-- ko if: client().healthInfoRequiresReview -->
                <span class="badge bg-warning text-dark ms-1"><t key="salon.clients.health.review_required_short">Inceleme</t></span>
                <!-- /ko -->
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-photos">
                <i class="bi bi-image me-1"></i><t key="salon.clients.auto.fotograflar">Fotoğraflar</t>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-appointments">
                <i class="bi bi-calendar-check me-1"></i><t key="salon.clients.auto.randevular">Randevular</t>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-invoices">
                <i class="bi bi-receipt me-1"></i><t key="salon.clients.auto.harcamalar">Harcamalar</t>
            </button>
        </li>
    </ul>

    <div class="tab-content mt-0">
        <!-- Bilgiler -->
        <div class="tab-pane fade show active" id="tab-info">
            <div class="card border-0 shadow-sm border-top-0 rounded-top-0">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-sm table-borderless">
                                <tr><td class="text-muted small" style="width:120px;"><t key="salon.clients.auto.ad_soyad">Ad Soyad</t></td><td class="small" data-bind="text: client().fullName"></td></tr>
                                <tr><td class="text-muted small"><t key="salon.account.phone">Telefon</t></td><td class="small" data-bind="text: client().phone"></td></tr>
                                <tr><td class="text-muted small"><t key="salon.account.email">E-posta</t></td><td class="small" data-bind="text: client().email || '-'"></td></tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-sm table-borderless">
                                <tr><td class="text-muted small" style="width:120px;"><t key="salon.clients.auto.cinsiyet">Cinsiyet</t></td><td class="small" data-bind="text: client().genderText || '-'"></td></tr>
                                <tr><td class="text-muted small"><t key="salon.clients.auto.dogum_tarihi">Doğum Tarihi</t></td><td class="small" data-bind="text: client().birthDate ? new Date(client().birthDate).toLocaleDateString(document.documentElement.lang || undefined) : '-'"></td></tr>
                                <tr><td class="text-muted small"><t key="salon.clients.auto.adres">Adres</t></td><td class="small" data-bind="text: client().address || '-'"></td></tr>
                                <tr><td class="text-muted small"><t key="salon.clients.auto.kayit_tarihi">Kayıt Tarihi</t></td><td class="small" data-bind="text: client().createdAt ? new Date(client().createdAt).toLocaleDateString(document.documentElement.lang || undefined) : '-'"></td></tr>
                            </table>
                        </div>
                    </div>
                    <!-- ko if: client().notes -->
                    <div class="mt-2">
                        <small class="text-muted"><t key="salon.clients.auto.not">Not:</t></small>
                        <p class="small mb-0" data-bind="text: client().notes"></p>
                    </div>
                    <!-- /ko -->
                </div>
            </div>
        </div>

        <!-- Formuller -->
        <div class="tab-pane fade" id="tab-formulas">
            <div class="card border-0 shadow-sm border-top-0 rounded-top-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="mb-0"><t key="salon.clients.auto.uygulanan_formuller">Uygulanan Formüller</t></h6>
                        <button class="btn btn-primary btn-sm" data-bind="click: openNewFormula">
                            <i class="bi bi-plus-lg me-1"></i><t key="salon.clients.auto.yeni_formul"><t key="salon.clients.auto.yeni_formul">Yeni Formül</t></t>
                        </button>
                    </div>
                    <div data-bind="foreach: formulas">
                        <div class="border rounded p-3 mb-2">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <span class="fw-semibold small" data-bind="text: formulaText"></span>
                                    <span class="text-muted small ms-2" data-bind="text: new Date(appliedAt).toLocaleDateString(document.documentElement.lang || undefined)"></span>
                                </div>
                                <button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.removeFormula" title="@(Translation.T("salon.common.btn.delete_tooltip", "Sil"))">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                            <!-- ko if: colorCode -->
                            <span class="badge bg-secondary me-1" data-bind="text: 'Renk: ' + colorCode"></span>
                            <!-- /ko -->
                            <!-- ko if: oxidantRatio -->
                            <span class="badge bg-secondary me-1" data-bind="text: 'Oksidan: ' + oxidantRatio"></span>
                            <!-- /ko -->
                            <!-- ko if: applicationNotes -->
                            <p class="small mb-0 mt-1 text-muted" data-bind="text: applicationNotes"></p>
                            <!-- /ko -->
                        </div>
                    </div>
                    <!-- ko if: formulas().length === 0 -->
                    <div class="text-center text-muted py-3 small"><t key="salon.clients.auto.henuz_formul_girilmemis">Henüz formül girilmemiş</t></div>
                    <!-- /ko -->
                </div>
            </div>
        </div>

        <!-- Tedavi Dosyasi -->
        <div class="tab-pane fade" id="tab-treatment">
            <div class="card border-0 shadow-sm border-top-0 rounded-top-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h6 class="mb-0"><i class="bi bi-shield-check me-1"></i><t key="salon.clients.health.title">Saglik ve Uyari Bilgileri</t></h6>
                            <!-- ko if: client().healthInfoUpdatedAt -->
                            <small class="text-muted" data-bind="text: salonT('salon.clients.health.updated_at', 'Son guncelleme') + ': ' + new Date(client().healthInfoUpdatedAt).toLocaleString(document.documentElement.lang || undefined)"></small>
                            <!-- /ko -->
                        </div>
                        <!-- ko if: client().healthInfoRequiresReview -->
                        <button class="btn btn-outline-success btn-sm" data-bind="click: reviewHealthInfo, disable: isSaving">
                            <i class="bi bi-check2-circle me-1"></i><t key="salon.clients.health.mark_reviewed">Inceledim</t>
                        </button>
                        <!-- /ko -->
                    </div>
                    <!-- ko if: client().healthInfoRequiresReview -->
                    <div class="alert alert-warning py-2 small">
                        <i class="bi bi-exclamation-triangle me-1"></i><t key="salon.clients.health.review_required">Musteri bu bilgileri guncelledi. Randevu oncesi salon tarafindan incelenmeli.</t>
                    </div>
                    <!-- /ko -->
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small"><t key="salon.clients.health.skin_type">Cilt Tipi</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: healthForm.skinType" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small"><t key="salon.clients.health.skin_sensitivity">Cilt Hassasiyeti</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: healthForm.skinSensitivity" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small"><t key="salon.clients.health.allergies">Alerjiler</t></label>
                            <textarea class="form-control form-control-sm" rows="3" data-bind="value: healthForm.allergies"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small"><t key="salon.clients.health.contraindications">Kontraendikasyonlar</t></label>
                            <textarea class="form-control form-control-sm" rows="3" data-bind="value: healthForm.contraindications"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.clients.health.medical_notes">Saglik Notlari</t></label>
                            <textarea class="form-control form-control-sm" rows="3" data-bind="value: healthForm.medicalNotes"></textarea>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-primary btn-sm" data-bind="click: saveHealthInfo, disable: isSaving">
                            <i class="bi bi-check-lg me-1"></i><t key="salon.common.btn.save">Kaydet</t>
                        </button>
                    </div>

                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="mb-0"><i class="bi bi-journal-medical me-1"></i><t key="salon.clients.treatment.records">Seans Kayitlari</t></h6>
                        <button class="btn btn-outline-primary btn-sm" data-bind="click: openTreatmentRecord">
                            <i class="bi bi-plus-lg me-1"></i><t key="salon.clients.treatment.new">Yeni Seans Kaydi</t>
                        </button>
                    </div>
                    <div data-bind="foreach: treatmentRecords">
                        <div class="border rounded p-3 mb-2">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <span class="fw-semibold small" data-bind="text: treatmentDate ? new Date(treatmentDate).toLocaleString(document.documentElement.lang || undefined) : '-'"></span>
                                    <!-- ko if: serviceName -->
                                    <span class="badge bg-light text-dark ms-2" data-bind="text: serviceName"></span>
                                    <!-- /ko -->
                                </div>
                                <button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.removeTreatmentRecord" title="@(Translation.T("salon.common.btn.delete_tooltip", "Sil"))">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                            <!-- ko if: sessionNotes -->
                            <p class="small mb-1 mt-2" data-bind="text: sessionNotes"></p>
                            <!-- /ko -->
                            <!-- ko if: deviceParameters -->
                            <div class="small text-muted"><strong><t key="salon.clients.treatment.device_parameters">Cihaz Parametreleri</t>:</strong> <span data-bind="text: deviceParameters"></span></div>
                            <!-- /ko -->
                            <!-- ko if: aftercareNotes -->
                            <div class="small text-muted"><strong><t key="salon.clients.treatment.aftercare">Bakim Onerisi</t>:</strong> <span data-bind="text: aftercareNotes"></span></div>
                            <!-- /ko -->
                        </div>
                    </div>
                    <!-- ko if: treatmentRecords().length === 0 -->
                    <div class="text-center text-muted py-3 small"><t key="salon.clients.treatment.empty">Henuz seans kaydi yok.</t></div>
                    <!-- /ko -->
                </div>
            </div>
        </div>

        <!-- Fotograflar -->
        <div class="tab-pane fade" id="tab-photos">
            <div class="card border-0 shadow-sm border-top-0 rounded-top-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="mb-0"><t key="salon.clients.auto.fotograflar">Fotoğraflar</t></h6>
                        <button class="btn btn-primary btn-sm" data-bind="click: openPhotoUpload">
                            <i class="bi bi-upload me-1"></i><t key="salon.clients.auto.fotograf_yukle">Fotoğraf Yükle</t>
                        </button>
                    </div>
                    <div class="row g-2" data-bind="foreach: photos">
                        <div class="col-md-3 col-sm-4">
                            <div class="card border">
                                <img data-bind="attr: { src: thumbnailUrl || url }" class="card-img-top" style="height:150px;object-fit:cover;" />
                                <div class="card-body p-2">
                                    <small class="text-muted" data-bind="text: new Date(createdAt).toLocaleDateString(document.documentElement.lang || undefined)"></small>
                                    <button class="btn btn-outline-danger btn-sm float-end" data-bind="click: $parent.removePhoto" title="@(Translation.T("salon.common.btn.delete_tooltip", "Sil"))">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- ko if: photos().length === 0 -->
                    <div class="text-center text-muted py-3 small"><t key="salon.clients.auto.henuz_fotograf_yuklenmemis">Henüz fotoğraf yüklenmemiş</t></div>
                    <!-- /ko -->
                </div>
            </div>
        </div>

        <!-- Randevular -->
        <div class="tab-pane fade" id="tab-appointments">
            <div class="card border-0 shadow-sm border-top-0 rounded-top-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr><th><t key="salon.panel.payments.date">Tarih</t></th><th><t key="salon.reports.hour">Saat</t></th><th><t key="salon.book.summary.service">Hizmet</t></th><th><t key="salon.sidebar.staff">Personel</t></th><th><t key="salon.appointments.status">Durum</t></th><th class="text-end"><t key="salon.common.actions">Islemler</t></th></tr>
                            </thead>
                            <tbody data-bind="foreach: appointments">
                                <tr>
                                    <td class="small" data-bind="text: startTime ? (function(s){var p=s.substring(0,10).split('-');var m=['Oca','Sub','Mar','Nis','May','Haz','Tem','Agu','Eyl','Eki','Kas',salonT('salon.clients.auto.ara', 'Ara')];return parseInt(p[2])+' '+m[parseInt(p[1])-1]+' '+p[0];})(startTime) : '-'"></td>
                                    <td class="small" data-bind="text: startTime ? startTime.substring(11,16) : '-'"></td>
                                    <td class="small fw-semibold" data-bind="text: (serviceNames && serviceNames.length) ? serviceNames.join(', ') : (serviceName || '-')"></td>
                                    <td class="small" data-bind="text: personnelName"></td>
                                    <td><span class="badge" data-bind="text: statusText, css: statusCss"></span></td>
                                    <td class="text-end">
                                        <!-- ko if: $parent.hasTreatmentRecordForAppointment($data) -->
                                        <span class="badge bg-light text-dark me-1"><t key="salon.clients.treatment.record_exists">Seans kaydi var</t></span>
                                        <!-- /ko -->
                                        <button class="btn btn-outline-primary btn-sm" data-bind="click: $parent.openTreatmentRecord">
                                            <i class="bi bi-journal-plus me-1"></i><t key="salon.clients.treatment.create_from_appointment">Seans Kaydi</t>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- ko if: appointments().length === 0 -->
                    <div class="text-center text-muted py-3 small"><t key="salon.clients.auto.randevu_bulunamadi">Randevu bulunamadi</t></div>
                    <!-- /ko -->
                </div>
            </div>
        </div>

        <!-- Harcamalar -->
        <div class="tab-pane fade" id="tab-invoices">
            <div class="card border-0 shadow-sm border-top-0 rounded-top-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr><th><t key="salon.panel.payments.date">Tarih</t></th><th><t key="salon.clients.auto.adisyon_no">Adisyon No</t></th><th><t key="salon.sidebar.services">Hizmetler</t></th><th><t key="salon.panel.payments.amount">Tutar</t></th><th><t key="salon.appointments.status">Durum</t></th></tr>
                            </thead>
                            <tbody data-bind="foreach: invoices">
                                <tr>
                                    <td class="small" data-bind="text: new Date(invoiceDate).toLocaleDateString(document.documentElement.lang || undefined)"></td>
                                    <td class="small fw-semibold" data-bind="text: invoiceNo"></td>
                                    <td class="small" data-bind="text: servicesSummary"></td>
                                    <td class="small" data-bind="text: (totalAmount || 0).toLocaleString(document.documentElement.lang || undefined) + ' TL'"></td>
                                    <td><span class="badge" data-bind="text: statusText, css: statusCss"></span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- ko if: invoices().length === 0 -->
                    <div class="text-center text-muted py-3 small"><t key="salon.clients.auto.adisyon_bulunamadi">Adisyon bulunamadı</t></div>
                    <!-- /ko -->
                </div>
            </div>
        </div>
    </div>

    <!-- Treatment Record Modal -->
    <div class="modal fade" id="treatmentModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><t key="salon.clients.treatment.new">Yeni Seans Kaydi</t></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small"><t key="salon.clients.treatment.source_appointment">Randevudan getir</t></label>
                        <select class="form-select form-select-sm" data-bind="options: treatmentAppointmentOptions, optionsText: 'label', optionsValue: 'id', optionsCaption: salonT('salon.clients.treatment.manual_entry', 'Manuel seans kaydi'), value: treatmentForm.slnAppointmentId"></select>
                    </div>
                    <!-- ko if: treatmentForm.appointmentSummary -->
                    <div class="alert alert-info py-2 small">
                        <i class="bi bi-calendar-check me-1"></i><span data-bind="text: treatmentForm.appointmentSummary"></span>
                    </div>
                    <!-- /ko -->
                    <!-- ko if: treatmentServiceOptions().length > 1 -->
                    <div class="mb-2">
                        <label class="form-label small"><t key="salon.book.summary.service">Hizmet</t></label>
                        <select class="form-select form-select-sm" data-bind="options: treatmentServiceOptions, optionsText: 'name', optionsValue: 'id', value: treatmentForm.serviceId"></select>
                    </div>
                    <!-- /ko -->
                    <div class="mb-2">
                        <label class="form-label small"><t key="salon.panel.payments.date">Tarih</t></label>
                        <input type="datetime-local" class="form-control form-control-sm" data-bind="value: treatmentForm.treatmentDate" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small"><t key="salon.clients.treatment.session_notes">Seans Notu</t></label>
                        <textarea class="form-control form-control-sm" rows="3" data-bind="value: treatmentForm.sessionNotes"></textarea>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small"><t key="salon.clients.treatment.device_parameters">Cihaz Parametreleri</t></label>
                        <textarea class="form-control form-control-sm" rows="2" data-bind="value: treatmentForm.deviceParameters"></textarea>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small"><t key="salon.clients.treatment.product_notes">Urun/Icerik Notu</t></label>
                        <textarea class="form-control form-control-sm" rows="2" data-bind="value: treatmentForm.productNotes"></textarea>
                    </div>
                    <div>
                        <label class="form-label small"><t key="salon.clients.treatment.aftercare">Bakim Onerisi</t></label>
                        <textarea class="form-control form-control-sm" rows="2" data-bind="value: treatmentForm.aftercareNotes"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">Iptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: saveTreatmentRecord, disable: isSaving">
                        <i class="bi bi-check-lg me-1"></i><t key="salon.common.btn.save">Kaydet</t>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Formul Modal -->
    <div class="modal fade" id="formulaModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><t key="salon.clients.auto.yeni_formul">Yeni Formül</t></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small"><t key="salon.clients.auto.formul_metni_required">Formül Metni *</t></label>
                        <input type="text" class="form-control form-control-sm" data-bind="value: formulaForm.formulaText" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.clients.auto.renk_kodu">Renk Kodu</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: formulaForm.colorCode" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.clients.auto.oksidan_orani">Oksidan Oranı</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: formulaForm.oxidantRatio" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label small"><t key="salon.clients.auto.uygulama_notlari">Uygulama Notları</t></label>
                        <textarea class="form-control form-control-sm" rows="3" data-bind="value: formulaForm.applicationNotes"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: saveFormula, disable: isSaving">
                        <i class="bi bi-check-lg me-1"></i><t key="salon.common.btn.save"><t key="salon.common.btn.save">Kaydet</t></t>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Photo Upload Modal -->
    <div class="modal fade" id="photoModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><t key="salon.clients.auto.fotograf_yukle">Fotoğraf Yükle</t></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="file" class="form-control form-control-sm" id="photoFile" accept="image/*" />
                    <small class="text-muted"><t key="salon.clients.auto.maksimum_5mb_jpg_png_desteklenir">Maksimum 5MB, JPG/PNG desteklenir.</t></small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: uploadPhoto, disable: isSaving">
                        <i class="bi bi-upload me-1"></i><t key="salon.clients.auto.yukle">Yükle</t>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-purple { color: #7b1fa2 !important; }
    .bg-purple { background-color: #7b1fa2 !important; }
    .client-wallet-item {
        display: flex;
        gap: .75rem;
        align-items: flex-start;
        min-height: 4.25rem;
    }
    .client-wallet-icon {
        width: 2.35rem;
        height: 2.35rem;
        border-radius: .5rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
    }
</style>

@section Scripts {
    <script>
        var clientDetailId = @clientId;
    </script>
    <script src="~/js/ClientDetail.js" asp-append-version="true"></script>
}
