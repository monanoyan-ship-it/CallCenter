@{
    ViewData["Title"] = "Personel";
}

<div id="staff-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="input-group" style="max-width: 320px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="Personel ara..." data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
        </div>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i>Yeni Personel
        </button>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Ad Soyad</th>
                            <th>Kullanici Adi</th>
                            <th>E-posta</th>
                            <th>Unvan</th>
                            <th>Sube</th>
                            <th>Rol</th>
                            <th>Durum</th>
                            <th style="width: 110px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredStaff">
                        <tr>
                            <td class="small fw-semibold" data-bind="text: fullName"></td>
                            <td class="small text-muted" data-bind="text: userName || '-'"></td>
                            <td class="small" data-bind="text: email || '-'"></td>
                            <td class="small" data-bind="text: title || '-'"></td>
                            <td class="small" data-bind="text: branchName || '-'"></td>
                            <td class="small" data-bind="text: customerRoleName || '-'"></td>
                            <td>
                                <span class="badge" data-bind="text: isActive ? 'Aktif' : 'Pasif', css: isActive ? 'bg-success' : 'bg-secondary'"></span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" title="Duzenle" data-bind="click: $parent.openEdit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-warning" title="Sifre Sifirla" data-bind="click: $parent.resetPassword">
                                        <i class="bi bi-key"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" title="Sil" data-bind="click: $parent.remove">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: filteredStaff().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-person-badge" style="font-size: 2rem;"></i>
                <p class="mt-2 small">Henuz personel eklenmemis</p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Personel Ozeti -->
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-header bg-white fw-semibold">
            <i class="bi bi-people me-2"></i>Personel Ozeti
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6 text-center">
                    <div class="text-muted small">Aktif Personel</div>
                    <div class="fw-bold text-primary" data-bind="text: activeCount()"></div>
                </div>
                <div class="col-md-6 text-center">
                    <div class="text-muted small">Toplam Personel</div>
                    <div class="fw-bold" data-bind="text: staffList().length"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="staffModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditing() ? 'Personel Duzenle' : 'Yeni Personel'"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small">Ad Soyad *</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.fullName" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">E-posta *</label>
                            <input type="email" class="form-control form-control-sm" data-bind="value: form.email" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Unvan</label>
                            <input type="text" class="form-control form-control-sm" placeholder="Orn: Kuafor, Guzellik Uzmani..." data-bind="value: form.title" />
                        </div>
                        <!-- ko if: !isEditing() -->
                        <div class="col-6">
                            <label class="form-label small">Kullanici Adi *</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.userName" />
                        </div>
                        <!-- /ko -->
                        <div class="col-6">
                            <label class="form-label small" data-bind="text: isEditing() ? 'Sifre (bos birakilabilir)' : 'Sifre *'"></label>
                            <input type="password" class="form-control form-control-sm" data-bind="value: form.password" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Rol</label>
                            <select class="form-select form-select-sm" data-bind="value: form.customerRoleId,
                                options: roleList, optionsText: 'displayName', optionsValue: 'id', optionsCaption: 'Rol seciniz'"></select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Sube <span data-bind="visible: branchList().length > 1">*</span></label>
                            <select class="form-select form-select-sm" data-bind="value: form.branchId,
                                options: branchList, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Sube seciniz'"></select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Durum</label>
                            <select class="form-select form-select-sm" data-bind="value: form.isActive">
                                <option value="true">Aktif</option>
                                <option value="false">Pasif</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Staff.js" asp-append-version="true"></script>
}
