@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("salon.sidebar.staff", "Personel");
    var staffJwt = CallCenter.Shared.Auth.JwtIdentityExtensions.GetJwtIdentity(Context);
    var canManageStaff = staffJwt.CustomerRoleId <= 0
        || staffJwt.CustomerRoleId == CallCenter.Shared.Enums.SalonRoles.Ids.SalonOwner;
    var canManagePersonnelOps = canManageStaff
        || staffJwt.CustomerRoleId == CallCenter.Shared.Enums.SalonRoles.Ids.Manager
        || staffJwt.CustomerRoleId == CallCenter.Shared.Enums.SalonRoles.Ids.BranchManager;
}

<div id="staff-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="input-group" style="max-width: 320px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="@(Translation.T("salon.staff.auto.personel_ara", "Personel ara..."))" data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
        </div>
        @if (canManageStaff)
        {
            <button class="btn btn-primary btn-sm" data-bind="click: openNew">
                <i class="bi bi-plus-lg me-1"></i><t key="salon.staff.auto.yeni_personel">Yeni Personel</t>
            </button>
        }
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th><t key="salon.staff.auto.ad_soyad">Ad Soyad</t></th>
                            <th><t key="salon.account.username">Kullanıcı Adı</t></th>
                            <th><t key="salon.account.email">E-posta</t></th>
                            <th><t key="salon.staff.auto.unvan">Unvan</t></th>
                            <th><t key="salon.common.branch">Şube</t></th>
                            <th><t key="salon.staff.role">Rol</t></th>
                            <th><t key="salon.appointments.status">Durum</t></th>
                            @if (canManageStaff)
                            {
                                <th style="width: 110px;"></th>
                            }
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredStaff">
                        <tr>
                            <td class="small fw-semibold" data-bind="text: fullName"></td>
                            <td class="small text-muted" data-bind="text: userName || '-'"></td>
                            <td class="small" data-bind="text: email || '-'"></td>
                            <td class="small" data-bind="text: title || '-'"></td>
                            <td class="small" data-bind="text: branchName || '-'"></td>
                            <td class="small" data-bind="text: customerRoleName || '-'"></td>
                            <td>
                                <span class="badge" data-bind="text: isActive ? 'Aktif' : 'Pasif', css: isActive ? 'bg-success' : 'bg-secondary'"></span>
                            </td>
                            @if (canManageStaff)
                            {
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary" title="@(Translation.T("salon.staff.auto.duzenle", "Düzenle"))" data-bind="click: $parent.openEdit">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-warning" title="@(Translation.T("salon.staff.auto.title_sifre_sifirla", "Şifre Sıfırla"))" data-bind="click: $parent.resetPassword">
                                            <i class="bi bi-key"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" title="@(Translation.T("salon.common.btn.delete_tooltip", "Sil"))" data-bind="click: $parent.remove">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: filteredStaff().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-person-badge" style="font-size: 2rem;"></i>
                <p class="mt-2 small"><t key="salon.staff.auto.henuz_personel_eklenmemis">Henüz personel eklenmemis</t></p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Personel Ozeti -->
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-header bg-white fw-semibold">
            <i class="bi bi-people me-2"></i><t key="salon.staff.auto.personel_ozeti">Personel Ozeti</t>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6 text-center">
                    <div class="text-muted small"><t key="salon.staff.auto.aktif_personel">Aktif Personel</t></div>
                    <div class="fw-bold text-primary" data-bind="text: activeCount()"></div>
                </div>
                <div class="col-md-6 text-center">
                    <div class="text-muted small"><t key="salon.staff.auto.toplam_personel">Toplam Personel</t></div>
                    <div class="fw-bold" data-bind="text: staffList().length"></div>
                </div>
            </div>
        </div>
    </div>

    @if (canManagePersonnelOps)
    {
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="fw-semibold"><i class="bi bi-calendar2-week me-2"></i><t key="salon.staff.ops.title">Personel Operasyonu</t></div>
                <div class="d-flex gap-2">
                    <input type="date" class="form-control form-control-sm" data-bind="value: opsFrom" />
                    <input type="date" class="form-control form-control-sm" data-bind="value: opsTo" />
                    <button class="btn btn-outline-primary btn-sm" data-bind="click: loadOps"><i class="bi bi-arrow-clockwise"></i></button>
                </div>
            </div>
            <div class="card-body">
                <ul class="nav nav-tabs nav-sm mb-3">
                    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#staff-shifts" type="button"><t key="salon.staff.ops.shifts">Vardiya</t></button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#staff-leaves" type="button"><t key="salon.staff.ops.leaves">Izin</t></button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#staff-timesheets" type="button"><t key="salon.staff.ops.timesheets">Timesheet</t></button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#staff-payroll" type="button"><t key="salon.staff.ops.payroll">Bordro</t></button></li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="staff-shifts">
                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-md-3"><label class="form-label small"><t key="salon.staff.auto.personel">Personel</t></label><select class="form-select form-select-sm" data-bind="options: staffList, optionsText: 'fullName', optionsValue: 'id', value: shiftForm.personnelId"></select></div>
                            <div class="col-md-2"><label class="form-label small"><t key="salon.common.date">Tarih</t></label><input type="date" class="form-control form-control-sm" data-bind="value: shiftForm.shiftDate" /></div>
                            <div class="col-md-2"><label class="form-label small"><t key="salon.staff.ops.start">Baslangic</t></label><input type="time" class="form-control form-control-sm" data-bind="value: shiftForm.startTime" /></div>
                            <div class="col-md-2"><label class="form-label small"><t key="salon.staff.ops.end">Bitis</t></label><input type="time" class="form-control form-control-sm" data-bind="value: shiftForm.endTime" /></div>
                            <div class="col-md-1"><label class="form-label small"><t key="salon.staff.ops.break">Mola</t></label><input type="number" min="0" class="form-control form-control-sm" data-bind="value: shiftForm.breakMinutes" /></div>
                            <div class="col-md-2"><button class="btn btn-primary btn-sm w-100" data-bind="click: saveShift"><i class="bi bi-check-lg me-1"></i><t key="salon.common.btn.save">Kaydet</t></button></div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead><tr><th><t key="salon.staff.auto.personel">Personel</t></th><th><t key="salon.common.date">Tarih</t></th><th><t key="salon.staff.ops.hours">Saat</t></th><th><t key="salon.staff.ops.break">Mola</t></th><th></th></tr></thead>
                                <tbody data-bind="foreach: ops.shifts"><tr><td data-bind="text: personnelName"></td><td data-bind="text: $root.formatDate(shiftDate)"></td><td data-bind="text: startTime + ' - ' + endTime"></td><td data-bind="text: breakMinutes"></td><td class="text-end"><button class="btn btn-outline-danger btn-sm" data-bind="click: $root.deleteShift"><i class="bi bi-trash"></i></button></td></tr></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="staff-leaves">
                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-md-3"><label class="form-label small"><t key="salon.staff.auto.personel">Personel</t></label><select class="form-select form-select-sm" data-bind="options: staffList, optionsText: 'fullName', optionsValue: 'id', value: leaveForm.personnelId"></select></div>
                            <div class="col-md-2"><label class="form-label small"><t key="salon.staff.ops.leave_type">Izin Tipi</t></label><select class="form-select form-select-sm" data-bind="options: ops.leaveTypes, optionsText: 'description', optionsValue: 'id', value: leaveForm.leaveTypeId"></select></div>
                            <div class="col-md-2"><label class="form-label small"><t key="salon.staff.ops.start_date">Baslangic</t></label><input type="date" class="form-control form-control-sm" data-bind="value: leaveForm.startDate" /></div>
                            <div class="col-md-2"><label class="form-label small"><t key="salon.staff.ops.end_date">Bitis</t></label><input type="date" class="form-control form-control-sm" data-bind="value: leaveForm.endDate" /></div>
                            <div class="col-md-3"><button class="btn btn-primary btn-sm w-100" data-bind="click: saveLeave"><i class="bi bi-plus-lg me-1"></i><t key="salon.staff.ops.add_leave">Izin Ekle</t></button></div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead><tr><th><t key="salon.staff.auto.personel">Personel</t></th><th><t key="salon.staff.ops.leave_type">Izin Tipi</t></th><th><t key="salon.common.date">Tarih</t></th><th><t key="salon.appointments.status">Durum</t></th><th></th></tr></thead>
                                <tbody data-bind="foreach: ops.leaves"><tr><td data-bind="text: personnelName"></td><td data-bind="text: leaveTypeName"></td><td data-bind="text: $root.formatDate(startDate) + ' - ' + $root.formatDate(endDate)"></td><td data-bind="text: statusName"></td><td class="text-end"><button class="btn btn-outline-success btn-sm me-1" data-bind="click: function(){ $root.setLeaveStatus($data, 2); }"><i class="bi bi-check"></i></button><button class="btn btn-outline-danger btn-sm" data-bind="click: function(){ $root.setLeaveStatus($data, 3); }"><i class="bi bi-x"></i></button></td></tr></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="staff-timesheets">
                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-md-3"><label class="form-label small"><t key="salon.staff.auto.personel">Personel</t></label><select class="form-select form-select-sm" data-bind="options: staffList, optionsText: 'fullName', optionsValue: 'id', value: timesheetForm.personnelId"></select></div>
                            <div class="col-md-2"><label class="form-label small"><t key="salon.common.date">Tarih</t></label><input type="date" class="form-control form-control-sm" data-bind="value: timesheetForm.workDate" /></div>
                            <div class="col-md-2"><label class="form-label small"><t key="salon.staff.ops.clock_in">Giris</t></label><input type="datetime-local" class="form-control form-control-sm" data-bind="value: timesheetForm.clockInAt" /></div>
                            <div class="col-md-2"><label class="form-label small"><t key="salon.staff.ops.clock_out">Cikis</t></label><input type="datetime-local" class="form-control form-control-sm" data-bind="value: timesheetForm.clockOutAt" /></div>
                            <div class="col-md-1"><label class="form-label small"><t key="salon.staff.ops.break">Mola</t></label><input type="number" min="0" class="form-control form-control-sm" data-bind="value: timesheetForm.breakMinutes" /></div>
                            <div class="col-md-2"><button class="btn btn-primary btn-sm w-100" data-bind="click: saveTimesheet"><i class="bi bi-check-lg me-1"></i><t key="salon.common.btn.save">Kaydet</t></button></div>
                        </div>
                        <div class="table-responsive"><table class="table table-sm"><thead><tr><th><t key="salon.staff.auto.personel">Personel</t></th><th><t key="salon.common.date">Tarih</t></th><th><t key="salon.staff.ops.hours">Saat</t></th><th><t key="salon.staff.ops.worked_hours">Calisma</t></th></tr></thead><tbody data-bind="foreach: ops.timesheets"><tr><td data-bind="text: personnelName"></td><td data-bind="text: $root.formatDate(workDate)"></td><td data-bind="text: $root.formatDateTime(clockInAt) + ' - ' + $root.formatDateTime(clockOutAt)"></td><td data-bind="text: workedHours"></td></tr></tbody></table></div>
                    </div>
                    <div class="tab-pane fade" id="staff-payroll">
                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-md-3"><label class="form-label small"><t key="salon.staff.auto.personel">Personel</t></label><select class="form-select form-select-sm" data-bind="options: staffList, optionsText: 'fullName', optionsValue: 'id', value: payrollForm.personnelId"></select></div>
                            <div class="col-md-1"><label class="form-label small"><t key="salon.staff.ops.year">Yil</t></label><input type="number" class="form-control form-control-sm" data-bind="value: payrollForm.year" /></div>
                            <div class="col-md-1"><label class="form-label small"><t key="salon.staff.ops.month">Ay</t></label><input type="number" min="1" max="12" class="form-control form-control-sm" data-bind="value: payrollForm.month" /></div>
                            <div class="col-md-2"><label class="form-label small"><t key="salon.staff.ops.base_salary">Maas</t></label><input type="number" min="0" class="form-control form-control-sm" data-bind="value: payrollForm.baseSalary" /></div>
                            <div class="col-md-2"><label class="form-label small"><t key="salon.staff.ops.deductions">Kesinti</t></label><input type="number" min="0" class="form-control form-control-sm" data-bind="value: payrollForm.deductions" /></div>
                            <div class="col-md-3"><button class="btn btn-primary btn-sm w-100" data-bind="click: generatePayroll"><i class="bi bi-calculator me-1"></i><t key="salon.staff.ops.generate_payroll">Bordro Hesapla</t></button></div>
                        </div>
                        <div class="table-responsive"><table class="table table-sm"><thead><tr><th><t key="salon.staff.auto.personel">Personel</t></th><th><t key="salon.staff.ops.period">Donem</t></th><th><t key="salon.staff.ops.commission">Prim</t></th><th><t key="salon.staff.ops.advance">Avans</t></th><th><t key="salon.staff.ops.net_pay">Net</t></th></tr></thead><tbody data-bind="foreach: ops.payrolls"><tr><td data-bind="text: personnelName"></td><td data-bind="text: year + '/' + month"></td><td data-bind="text: (serviceCommission + productCommission).toFixed(2)"></td><td data-bind="text: totalAdvance.toFixed(2)"></td><td class="fw-semibold" data-bind="text: netPay.toFixed(2)"></td></tr></tbody></table></div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Modal -->
    <div class="modal fade" id="staffModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditing() ? salonT('salon.staff.auto.personel_duzenle', 'Personel Düzenle') : salonT('salon.staff.auto.yeni_personel', 'Yeni Personel')"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <!-- Salon sahibi icin bilgi notu -->
                        <!-- ko if: isOwnerEdit() -->
                        <div class="col-12">
                            <div class="alert alert-info py-2 small mb-0">
                                <i class="bi bi-shop me-1"></i><strong><t key="salon.staff.auto.salon_sahibi">Salon Sahibi</t></strong><t key="salon.staff.auto.ad_soyad_e_posta_ve_sifre_guncellenebilir">— Ad soyad, e-posta ve sifre guncellenebilir.</t>
                            </div>
                        </div>
                        <!-- /ko -->

                        <!-- Fotograf (sadece edit modunda) -->
                        <!-- ko if: isEditing() -->
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.staff.auto.profil_fotografi">Profil Fotoğrafı</t></label>
                            <div class="d-flex align-items-center gap-3">
                                <!-- ko if: form.photoUrl() -->
                                <img data-bind="attr: { src: form.photoUrl }" class="rounded-circle" style="width:60px;height:60px;object-fit:cover;border:2px solid #dee2e6;" />
                                <!-- /ko -->
                                <!-- ko ifnot: form.photoUrl() -->
                                <div class="rounded-circle d-flex align-items-center justify-content-center bg-light" style="width:60px;height:60px;border:2px solid #dee2e6;">
                                    <i class="bi bi-person fs-3 text-muted"></i>
                                </div>
                                <!-- /ko -->
                                <label class="btn btn-outline-secondary btn-sm mb-0" data-bind="css: { disabled: isUploadingPhoto() }">
                                    <span data-bind="visible: isUploadingPhoto()" class="spinner-border spinner-border-sm me-1"></span>
                                    <i class="bi bi-upload me-1" data-bind="visible: !isUploadingPhoto()"></i>
                                    <span data-bind="text: isUploadingPhoto() ? salonT('salon.common.loading', 'Yükleniyor...') : salonT('salon.staff.auto.fotograf_sec', 'Fotoğraf Seç')"></span>
                                    <input type="file" accept="image/jpeg,image/png,image/webp" style="display:none;" data-bind="event: { change: uploadPhoto }, disable: isUploadingPhoto" />
                                </label>
                                <small class="text-muted"><t key="salon.staff.auto.max_3_mb_jpeg_png_webp">Max 3 MB, JPEG/PNG/WebP</t></small>
                            </div>
                        </div>
                        <!-- /ko -->

                        <div class="col-12">
                            <label class="form-label small"><t key="salon.staff.auto.ad_soyad_required">Ad Soyad *</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="textInput: form.fullName" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.account.email">E-posta *</t></label>
                            <input type="email" class="form-control form-control-sm" data-bind="textInput: form.email" />
                        </div>
                        <div class="col-6" data-bind="visible: !isOwnerEdit()">
                            <label class="form-label small"><t key="salon.staff.auto.unvan_2">Unvan</t></label>
                            <input type="text" class="form-control form-control-sm" placeholder="@(Translation.T("salon.staff.auto.placeholder_orn_kuafor_guzellik_uzmani", "Örn: Kuaför, Güzellik Uzmanı..."))" data-bind="textInput: form.title" />
                        </div>
                        <!-- ko if: !isEditing() -->
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.account.username">Kullanıcı Adı *</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="textInput: form.userName,
                                css: { 'is-valid': usernameAvailable() === true, 'is-invalid': usernameAvailable() === false }" />
                            <!-- ko if: usernameChecking() -->
                            <small class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span><t key="salon.staff.auto.kontrol_ediliyor">Kontrol ediliyor...</t></small>
                            <!-- /ko -->
                            <!-- ko if: usernameAvailable() === false -->
                            <small class="text-danger"><t key="salon.staff.auto.bu_kullanici_adi_zaten_kullaniliyor">Bu kullanici adi zaten kullaniliyor</t></small>
                            <!-- /ko -->
                            <!-- ko if: usernameAvailable() === true -->
                            <small class="text-success"><t key="salon.staff.auto.kullanilabilir">Kullanılabilir</t></small>
                            <!-- /ko -->
                        </div>
                        <!-- /ko -->
                        <div class="col-6">
                            <label class="form-label small" data-bind="text: isEditing() ? 'Sifre (bos birakilabilir)' : 'Sifre *'"></label>
                            <input type="password" class="form-control form-control-sm" data-bind="textInput: form.password" />
                        </div>

                        <!-- Salon sahibi icin gizlenen alanlar -->
                        <!-- ko if: !isOwnerEdit() -->
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.staff.role">Rol</t></label>
                            <select class="form-select form-select-sm" data-bind="value: form.customerRoleId,
                                options: roleList, optionsText: 'displayName', optionsValue: 'id', optionsCaption: salonT('salon.staff.role_select', 'Rol seçiniz')"></select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.common.branch">Şube</t> <span data-bind="visible: branchList().length > 1">*</span></label>
                            <select class="form-select form-select-sm" data-bind="value: form.branchId,
                                options: branchList, optionsText: 'name', optionsValue: 'id', optionsCaption: salonT('salon.staff.auto.sube_seciniz', 'Şube seçiniz')"></select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="salon.appointments.status">Durum</t></label>
                            <select class="form-select form-select-sm" data-bind="value: form.isActive">
                                <option value="true"><t key="salon.common.status_active">Aktif</t></option>
                                <option value="false"><t key="salon.common.status_inactive">Pasif</t></option>
                            </select>
                        </div>
                        <!-- Hizmet Yetenekleri -->
                        <!-- ko if: serviceCategories().length > 0 -->
                        <div class="col-12">
                            <label class="form-label small"><t key="salon.staff.auto.hizmet_yetenekleri">Hizmet Yetenekleri</t> <small class="text-muted fw-normal"><t key="salon.staff.auto.bu_personel_hangi_hizmetleri_yapabilir">(bu personel hangi hizmetleri yapabilir?)</t></small></label>
                            <!-- ko foreach: serviceCategories -->
                            <div class="mb-2">
                                <small class="text-muted fw-bold" data-bind="text: name"></small>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    <!-- ko foreach: services -->
                                    <button type="button" class="btn py-0 px-2" style="font-size:.8rem;"
                                        data-bind="text: name,
                                                   click: function() { $root.toggleSkill($data.id); },
                                                   css: $root.form.skillServiceIds().indexOf($data.id) >= 0 ? 'btn-primary' : 'btn-outline-secondary'">
                                    </button>
                                    <!-- /ko -->
                                </div>
                            </div>
                            <!-- /ko -->
                        </div>
                        <!-- /ko -->

                        <!-- Public Gorunurluk Ayarlari -->
                        <div class="col-12 mt-3">
                            <label class="form-label small fw-semibold">
                                <i class="bi bi-eye me-1"></i><t key="salon.staff.auto.site_gorunurluk_ayarlari">Site Görünürlük Ayarları</t>
                        <small class="text-muted fw-normal d-block"><t key="salon.staff.public_display_hint">Bu personelin online randevu ve ekibimiz sayfasında nasıl görüneceğini belirleyin</t></small>
                            </label>
                            <div class="bg-light rounded p-2">
                                <div class="form-check form-switch mb-1">
                                    <input class="form-check-input" type="checkbox" data-bind="checked: form.publicVisible" id="chkPublicVisible" />
                                    <label class="form-check-label small" for="chkPublicVisible"><t key="salon.staff.auto.sitede_gorunsun">Sitede görünsün</t></label>
                                </div>
                                <!-- ko if: form.publicVisible() -->
                                <div class="form-check form-switch mb-1 ms-3">
                                    <input class="form-check-input" type="checkbox" data-bind="checked: form.publicShowFullName" id="chkFullName" />
                                    <label class="form-check-label small" for="chkFullName"><t key="salon.staff.auto.tam_ad_soyad_gosterilsin">Tam ad soyad gösterilsin</t> <small class="text-muted"><t key="salon.staff.auto.kapaliysa_sadece_on_ad">(kapaliysa sadece on ad)</t></small></label>
                                </div>
                                <div class="form-check form-switch mb-1 ms-3">
                                    <input class="form-check-input" type="checkbox" data-bind="checked: form.publicShowPhoto" id="chkPhoto" />
                                    <label class="form-check-label small" for="chkPhoto"><t key="salon.staff.auto.fotograf_gosterilsin">Fotoğraf gösterilsin</t></label>
                                </div>
                                <div class="form-check form-switch mb-1 ms-3">
                                    <input class="form-check-input" type="checkbox" data-bind="checked: form.publicShowTitle" id="chkTitle" />
                                    <label class="form-check-label small" for="chkTitle"><t key="salon.staff.auto.unvan_gosterilsin">Unvan gösterilsin</t></label>
                                </div>
                                <div class="form-check form-switch ms-3">
                                    <input class="form-check-input" type="checkbox" data-bind="checked: form.publicShowSpecialty" id="chkSpecialty" />
                                    <label class="form-check-label small" for="chkSpecialty"><t key="salon.staff.auto.uzmanlik_alani_gosterilsin">Uzmanlık alanı gösterilsin</t></label>
                                </div>
                                <!-- /ko -->
                            </div>
                        </div>
                        <!-- /ko -->

                        <!-- Personel Calisma Saatleri -->
                        <div class="mt-3 border-top pt-3">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" data-bind="checked: workingHoursOverride" id="chkPersonnelHours" />
                                <label class="form-check-label small fw-bold" for="chkPersonnelHours">
                                    <t key="salon.staff.working_hours_override">Bu personele özel çalışma saatleri tanımla</t>
                                </label>
                                <div class="text-muted small"><t key="salon.staff.working_hours_hint">Tanımlanmazsa şube saatleri kullanılır.</t></div>
                            </div>
                            <!-- ko if: workingHoursOverride -->
                            <div class="mb-2">
                                <!-- ko foreach: workingDays -->
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <div class="form-check form-switch" style="min-width:130px;">
                                        <input type="checkbox" class="form-check-input" data-bind="checked: isOpen" />
                                        <label class="form-check-label small" data-bind="text: label"></label>
                                    </div>
                                    <!-- ko if: isOpen -->
                                    <input type="time" class="form-control form-control-sm" style="max-width:110px;" data-bind="value: open" />
                                    <span class="text-muted">-</span>
                                    <input type="time" class="form-control form-control-sm" style="max-width:110px;" data-bind="value: close" />
                                    <!-- /ko -->
                                    <!-- ko ifnot: isOpen -->
                                    <span class="text-muted small"><t key="salon.staff.day_closed">Kapalı</t></span>
                                    <!-- /ko -->
                                </div>
                                <!-- /ko -->
                            </div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="salon.common.btn.cancel">İptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i><t key="salon.common.btn.save">Kaydet</t>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Staff.js" asp-append-version="true"></script>
}
