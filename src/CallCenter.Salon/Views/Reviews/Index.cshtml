@{
    ViewData["Title"] = "Yorumlar";
}

<div id="reviews-vm">
    <!-- Ozet Kartlari -->
    <div class="row g-3 mb-3">
        <div class="col-md-2">
            <div class="card border-0 shadow-sm text-center py-2">
                <div class="small text-muted">Toplam</div>
                <div class="fw-bold" data-bind="text: stats().totalReviews"></div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-0 shadow-sm text-center py-2">
                <div class="small text-muted">Bekleyen</div>
                <div class="fw-bold text-warning" data-bind="text: stats().pendingCount"></div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-0 shadow-sm text-center py-2">
                <div class="small text-muted">Onaylanan</div>
                <div class="fw-bold text-success" data-bind="text: stats().approvedCount"></div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-0 shadow-sm text-center py-2">
                <div class="small text-muted">Reddedilen</div>
                <div class="fw-bold text-danger" data-bind="text: stats().rejectedCount"></div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-0 shadow-sm text-center py-2">
                <div class="small text-muted">Ort. Puan</div>
                <div class="fw-bold text-primary">
                    <i class="bi bi-star-fill text-warning me-1"></i><span data-bind="text: stats().averageRating.toFixed(1)"></span>
                </div>
            </div>
        </div>
        <div class="col-md-2 d-flex align-items-center">
            <small class="text-muted">Yorumlar müşteri tarafından eklenir. Salon panelinden yorum eklenemez (objektiflik için).</small>
        </div>
    </div>

    <!-- Filtre -->
    <div class="mb-3">
        <div class="btn-group btn-group-sm">
            <button class="btn btn-outline-secondary" data-bind="click: function() { filterStatus(0); }, css: { active: filterStatus() === 0 }">Tumu</button>
            <button class="btn btn-outline-warning" data-bind="click: function() { filterStatus(1); }, css: { active: filterStatus() === 1 }">Bekleyen</button>
            <button class="btn btn-outline-success" data-bind="click: function() { filterStatus(2); }, css: { active: filterStatus() === 2 }">Onaylanan</button>
            <button class="btn btn-outline-danger" data-bind="click: function() { filterStatus(3); }, css: { active: filterStatus() === 3 }">Reddedilen</button>
        </div>
    </div>

    <!-- Yorum Listesi -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Musteri</th>
                            <th>Puan</th>
                            <th>Yorum</th>
                            <th>Kaynak</th>
                            <th>Durum</th>
                            <th>Tarih</th>
                            <th style="width:150px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredReviews">
                        <tr>
                            <td class="fw-semibold small" data-bind="text: clientName"></td>
                            <td class="small">
                                <!-- ko foreach: new Array(rating) -->
                                <i class="bi bi-star-fill text-warning"></i>
                                <!-- /ko -->
                            </td>
                            <td class="small text-truncate" style="max-width:300px;" data-bind="text: comment || '-'"></td>
                            <td class="small" data-bind="text: $parent.sourceText(sourceId)"></td>
                            <td class="small">
                                <span class="badge" data-bind="text: $parent.reviewStatusText(statusId), css: $parent.reviewStatusBadge(statusId)"></span>
                            </td>
                            <td class="small" data-bind="text: new Date(createdAt).toLocaleDateString('tr-TR')"></td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <!-- ko if: statusId === 1 -->
                                    <button class="btn btn-outline-success" title="Onayla" data-bind="click: function() { $parent.updateStatus($data, 2); }">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" title="Reddet" data-bind="click: function() { $parent.updateStatus($data, 3); }">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                    <!-- /ko -->
                                    <button class="btn btn-outline-secondary" title="Sil" data-bind="click: $parent.remove">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: filteredReviews().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-chat-square-text" style="font-size:2rem;"></i>
                <p class="mt-2 small">Henuz yorum yok</p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Yeni Yorum Modal -->
    <div class="modal fade" id="reviewModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><i class="bi bi-chat-square-text me-2"></i>Yeni Yorum</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small">Musteri Adi *</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.clientName" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Puan *</label>
                            <select class="form-select form-select-sm" data-bind="value: form.rating">
                                <option value="5">5 - Mukemmel</option>
                                <option value="4">4 - Iyi</option>
                                <option value="3">3 - Orta</option>
                                <option value="2">2 - Kotu</option>
                                <option value="1">1 - Cok Kotu</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Kaynak</label>
                            <select class="form-select form-select-sm" data-bind="value: form.sourceId">
                                <option value="1">Dahili</option>
                                <option value="2">Google</option>
                                <option value="3">Instagram</option>
                                <option value="4">Facebook</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Yorum</label>
                            <textarea class="form-control form-control-sm" rows="3" data-bind="value: form.comment"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Harici URL</label>
                            <input type="text" class="form-control form-control-sm" placeholder="https://..." data-bind="value: form.externalUrl" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Reviews.js" asp-append-version="true"></script>
}
