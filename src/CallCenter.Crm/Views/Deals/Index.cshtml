@{
    ViewData["Title"] = "Firsatlar";
}

<div id="deals-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex gap-2">
            <div class="input-group" style="max-width: 280px;">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="Firsat ara..." data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
            </div>
            <select class="form-select form-select-sm" style="width: 140px;" data-bind="value: stageFilter">
                <option value="">Tum Asamalar</option>
                <option value="1">Lead</option>
                <option value="2">Nitelikli</option>
                <option value="3">Teklif</option>
                <option value="4">Muzakere</option>
                <option value="5">Kazanildi</option>
                <option value="6">Kaybedildi</option>
            </select>
        </div>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i>Yeni Firsat
        </button>
    </div>

    <!-- Pipeline Summary -->
    <div class="row g-2 mb-3">
        <div class="col-2">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .65rem;">Lead</div>
                    <div class="fw-bold small text-secondary" data-bind="text: stageCounts().lead">0</div>
                </div>
            </div>
        </div>
        <div class="col-2">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .65rem;">Nitelikli</div>
                    <div class="fw-bold small text-info" data-bind="text: stageCounts().qualified">0</div>
                </div>
            </div>
        </div>
        <div class="col-2">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .65rem;">Teklif</div>
                    <div class="fw-bold small text-primary" data-bind="text: stageCounts().proposal">0</div>
                </div>
            </div>
        </div>
        <div class="col-2">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .65rem;">Muzakere</div>
                    <div class="fw-bold small text-warning" data-bind="text: stageCounts().negotiation">0</div>
                </div>
            </div>
        </div>
        <div class="col-2">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .65rem;">Kazanildi</div>
                    <div class="fw-bold small text-success" data-bind="text: stageCounts().won">0</div>
                </div>
            </div>
        </div>
        <div class="col-2">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .65rem;">Kaybedildi</div>
                    <div class="fw-bold small text-danger" data-bind="text: stageCounts().lost">0</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Firsat Adi</th>
                            <th>Kisi / Firma</th>
                            <th>Deger</th>
                            <th>Asama</th>
                            <th>Olasilik</th>
                            <th>Kapanma</th>
                            <th style="width: 80px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredDeals">
                        <tr>
                            <td class="small fw-semibold" data-bind="text: title"></td>
                            <td class="small" data-bind="text: contactName"></td>
                            <td class="small fw-semibold" data-bind="text: value.toLocaleString('tr-TR') + ' TL'"></td>
                            <td>
                                <span class="badge" data-bind="text: stageName, css: stageCss"></span>
                            </td>
                            <td class="small" data-bind="text: probability + '%'"></td>
                            <td class="small text-muted" data-bind="text: expectedCloseDate ? new Date(expectedCloseDate).toLocaleDateString('tr-TR') : '-'"></td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" title="Duzenle" data-bind="click: $parent.openEdit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" title="Sil" data-bind="click: $parent.remove">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: filteredDeals().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-kanban" style="font-size: 2rem;"></i>
                <p class="mt-2 small">Henuz firsat yok</p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Total Pipeline -->
    <div class="text-end mt-2">
        <span class="text-muted small">Toplam Pipeline: </span>
        <span class="fw-bold text-success" data-bind="text: totalPipeline"></span>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="dealModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditing() ? 'Firsat Duzenle' : 'Yeni Firsat'"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small">Firsat Adi *</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.title" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Kisi</label>
                            <select class="form-select form-select-sm" data-bind="options: contactsList, optionsText: 'fullName', optionsValue: 'id', value: form.contactId, optionsCaption: 'Secin'"></select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Deger (TL)</label>
                            <input type="number" class="form-control form-control-sm" data-bind="value: form.value" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Asama</label>
                            <select class="form-select form-select-sm" data-bind="value: form.stageId">
                                <option value="1">Lead</option>
                                <option value="2">Nitelikli</option>
                                <option value="3">Teklif</option>
                                <option value="4">Muzakere</option>
                                <option value="5">Kazanildi</option>
                                <option value="6">Kaybedildi</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Olasilik (%)</label>
                            <input type="number" min="0" max="100" class="form-control form-control-sm" data-bind="value: form.probability" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Beklenen Kapanma</label>
                            <input type="date" class="form-control form-control-sm" data-bind="value: form.expectedCloseDate" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Not</label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: form.notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Deals.js"></script>
}
