@{
    ViewData["Title"] = "Firsatlar";
}

<div id="deals-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex gap-2">
            <div class="input-group" style="max-width: 280px;">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="Firsat ara..." data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
            </div>
            <select class="form-select form-select-sm" style="width: 140px;" data-bind="value: stageFilter">
                <option value="">Tum Asamalar</option>
                <option value="lead">Lead</option>
                <option value="qualified">Nitelikli</option>
                <option value="proposal">Teklif</option>
                <option value="negotiation">Muzakere</option>
                <option value="won">Kazanildi</option>
                <option value="lost">Kaybedildi</option>
            </select>
        </div>
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#dealModal" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i>Yeni Firsat
        </button>
    </div>

    <!-- Pipeline Summary -->
    <div class="row g-2 mb-3">
        <div class="col-2">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .65rem;">Lead</div>
                    <div class="fw-bold small text-secondary" data-bind="text: stageCounts().lead">0</div>
                </div>
            </div>
        </div>
        <div class="col-2">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .65rem;">Nitelikli</div>
                    <div class="fw-bold small text-info" data-bind="text: stageCounts().qualified">0</div>
                </div>
            </div>
        </div>
        <div class="col-2">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .65rem;">Teklif</div>
                    <div class="fw-bold small text-primary" data-bind="text: stageCounts().proposal">0</div>
                </div>
            </div>
        </div>
        <div class="col-2">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .65rem;">Muzakere</div>
                    <div class="fw-bold small text-warning" data-bind="text: stageCounts().negotiation">0</div>
                </div>
            </div>
        </div>
        <div class="col-2">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .65rem;">Kazanildi</div>
                    <div class="fw-bold small text-success" data-bind="text: stageCounts().won">0</div>
                </div>
            </div>
        </div>
        <div class="col-2">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <div class="text-muted" style="font-size: .65rem;">Kaybedildi</div>
                    <div class="fw-bold small text-danger" data-bind="text: stageCounts().lost">0</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Firsat Adi</th>
                            <th>Kisi / Firma</th>
                            <th>Deger</th>
                            <th>Asama</th>
                            <th>Olasilik</th>
                            <th>Kapanma Tarihi</th>
                            <th style="width: 80px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredDeals">
                        <tr>
                            <td>
                                <a href="#" class="text-decoration-none fw-semibold small" data-bind="text: title, click: $parent.openDetail"></a>
                            </td>
                            <td class="small" data-bind="text: contactName"></td>
                            <td class="small fw-semibold" data-bind="text: valueFormatted"></td>
                            <td>
                                <span class="badge" data-bind="text: stageName, css: stageCss"></span>
                            </td>
                            <td class="small" data-bind="text: probability + '%'"></td>
                            <td class="small text-muted" data-bind="text: expectedCloseDate"></td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" title="Duzenle" data-bind="click: $parent.openEdit" data-bs-toggle="modal" data-bs-target="#dealModal">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" title="Sil" data-bind="click: $parent.remove">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: filteredDeals().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-kanban" style="font-size: 2rem;"></i>
                <p class="mt-2 small">Henuz firsat yok</p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Total Pipeline -->
    <div class="text-end mt-2">
        <span class="text-muted small">Toplam Pipeline: </span>
        <span class="fw-bold text-success" data-bind="text: totalPipeline"></span>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="dealModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditing() ? 'Firsat Duzenle' : 'Yeni Firsat'"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small">Firsat Adi</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.title" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Kisi</label>
                            <select class="form-select form-select-sm" data-bind="options: contactsList, optionsText: 'fullName', optionsValue: 'id', value: form.contactId, optionsCaption: 'Secin'"></select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Deger (TL)</label>
                            <input type="number" class="form-control form-control-sm" data-bind="value: form.value" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Asama</label>
                            <select class="form-select form-select-sm" data-bind="value: form.stage">
                                <option value="lead">Lead</option>
                                <option value="qualified">Nitelikli</option>
                                <option value="proposal">Teklif</option>
                                <option value="negotiation">Muzakere</option>
                                <option value="won">Kazanildi</option>
                                <option value="lost">Kaybedildi</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Olasilik (%)</label>
                            <input type="number" min="0" max="100" class="form-control form-control-sm" data-bind="value: form.probability" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Beklenen Kapanma</label>
                            <input type="date" class="form-control form-control-sm" data-bind="value: form.expectedCloseDate" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Not</label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: form.notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save">
                        <i class="bi bi-check-lg me-1"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function DealsViewModel() {
        var self = this;
        self.deals = ko.observableArray([]);
        self.contactsList = ko.observableArray([]);
        self.searchQuery = ko.observable('');
        self.stageFilter = ko.observable('');
        self.isEditing = ko.observable(false);
        self.editingId = ko.observable(null);

        self.form = {
            title: ko.observable(''),
            contactId: ko.observable(null),
            value: ko.observable(0),
            stage: ko.observable('lead'),
            probability: ko.observable(0),
            expectedCloseDate: ko.observable(''),
            notes: ko.observable('')
        };

        self.stageCounts = ko.computed(function() {
            var all = self.deals();
            return {
                lead: all.filter(function(d) { return d.stage === 'lead'; }).length,
                qualified: all.filter(function(d) { return d.stage === 'qualified'; }).length,
                proposal: all.filter(function(d) { return d.stage === 'proposal'; }).length,
                negotiation: all.filter(function(d) { return d.stage === 'negotiation'; }).length,
                won: all.filter(function(d) { return d.stage === 'won'; }).length,
                lost: all.filter(function(d) { return d.stage === 'lost'; }).length
            };
        });

        self.filteredDeals = ko.computed(function() {
            var q = (self.searchQuery() || '').toLowerCase();
            var s = self.stageFilter();
            return self.deals().filter(function(d) {
                var matchSearch = !q || (d.title || '').toLowerCase().indexOf(q) >= 0
                    || (d.contactName || '').toLowerCase().indexOf(q) >= 0;
                var matchStage = !s || d.stage === s;
                return matchSearch && matchStage;
            });
        });

        self.totalPipeline = ko.computed(function() {
            var active = self.deals().filter(function(d) { return d.stage !== 'lost'; });
            var total = active.reduce(function(sum, d) { return sum + (d.value || 0); }, 0);
            return total.toLocaleString('tr-TR') + ' TL';
        });

        self.resetForm = function() {
            self.form.title('');
            self.form.contactId(null);
            self.form.value(0);
            self.form.stage('lead');
            self.form.probability(0);
            self.form.expectedCloseDate('');
            self.form.notes('');
            self.isEditing(false);
            self.editingId(null);
        };

        self.openNew = function() { self.resetForm(); };

        self.openEdit = function(deal) {
            self.isEditing(true);
            self.editingId(deal.id);
            self.form.title(deal.title || '');
            self.form.contactId(deal.contactId);
            self.form.value(deal.value || 0);
            self.form.stage(deal.stage || 'lead');
            self.form.probability(deal.probability || 0);
            self.form.expectedCloseDate(deal.expectedCloseDate || '');
            self.form.notes(deal.notes || '');
        };

        self.openDetail = function(deal) {
            // TODO: navigate to deal detail
        };

        self.save = function() {
            // TODO: CRM.apiPost / CRM.apiPut
        };

        self.remove = function(deal) {
            if (!confirm('Bu firsati silmek istediginize emin misiniz?')) return;
            // TODO: CRM.apiDelete
        };

        // TODO: CRM.apiGet('/api/crm/deals').then(...)
    }

    ko.applyBindings(new DealsViewModel(), document.getElementById('deals-vm'));
</script>
}
