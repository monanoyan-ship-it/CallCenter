@{
    ViewData["Title"] = "Ödemeler";
}

<div id="crmPaymentsPage" class="row g-3">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="mb-0">Bekleyen Ödemeler</h6>
                    <div class="small text-muted">Salon, CRM ve CallCenter hizmet ödemelerinizi tek seferde kapatabilirsiniz.</div>
                </div>
                <button type="button" class="btn btn-success btn-sm" data-bind="click: openConfirm, disable: loading() || !hasPayableLines()">
                    <i class="bi bi-credit-card me-1"></i>Ödemeye Geç
                </button>
            </div>
            <div class="card-body">
                <div class="text-center py-4" data-bind="visible: loading">
                    <div class="spinner-border text-primary"></div>
                    <div class="small text-muted mt-2">Ödemeler hazırlanıyor...</div>
                </div>

                <div class="alert alert-info mb-0" data-bind="visible: !loading() && !hasPayableLines()">
                    Bekleyen ödeme bulunmuyor.
                </div>

                <div class="table-responsive" data-bind="visible: !loading() && hasPayableLines()">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Hizmet</th>
                                <th>Dönem</th>
                                <th class="text-end">Tutar</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: preview() ? preview().lines : []">
                            <tr>
                                <td>
                                    <div class="fw-semibold" data-bind="text: description"></div>
                                    <div class="small text-muted" data-bind="text: billingKindName"></div>
                                </td>
                                <td data-bind="text: month + '/' + year"></td>
                                <td class="text-end fw-semibold" data-bind="text: $root.amountText(amount)"></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="table-success">
                                <td colspan="2" class="fw-bold">Toplam</td>
                                <td class="text-end fw-bold" data-bind="text: totalText"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="paymentConfirmModal" tabindex="-1" data-bs-focus="false">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><i class="bi bi-credit-card me-1"></i>Ödeme Onayı</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div data-bind="visible: step() === 'confirm'">
                        <div class="alert alert-info py-2 small">
                            Ödemeye geçmeden önce kapatılacak hizmetleri kontrol edin.
                        </div>
                        <div class="table-responsive mb-3">
                            <table class="table table-sm align-middle mb-0">
                                <tbody data-bind="foreach: preview() ? preview().lines : []">
                                    <tr>
                                        <td>
                                            <div class="fw-semibold" data-bind="text: description"></div>
                                            <div class="small text-muted" data-bind="text: billingKindName + ' · ' + month + '/' + year"></div>
                                        </td>
                                        <td class="text-end fw-semibold" data-bind="text: $root.amountText(amount)"></td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr class="table-success">
                                        <td class="fw-bold">Toplam</td>
                                        <td class="text-end fw-bold" data-bind="text: totalText"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        <button type="button" class="btn btn-success w-100 mb-2" data-bind="click: startCheckout, disable: loading">
                            <i class="bi bi-credit-card me-1"></i>Onaylıyorum, ödemeye geç
                        </button>
                        <a class="btn btn-outline-secondary w-100" data-bind="attr: { href: supportHref }">
                            <i class="bi bi-envelope me-1"></i>Detayları kontrol etmek istiyorum
                        </a>
                        <div class="small text-muted text-center mt-2">info@corplynk.com adresine yazabilirsiniz; 24 saat içinde dönüş yapılır.</div>
                    </div>

                    <div data-bind="visible: step() === 'checkout'">
                        <div class="text-center py-3" data-bind="visible: loading">
                            <div class="spinner-border text-primary"></div>
                            <div class="small text-muted mt-2">Ödeme formu hazırlanıyor...</div>
                        </div>
                        <div id="crm-iyzico-checkout"></div>
                    </div>

                    <div class="text-center py-4" data-bind="visible: step() === 'result'">
                        <i class="bi" data-bind="css: result() && result().success ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger'" style="font-size:3rem;"></i>
                        <h5 class="mt-2" data-bind="css: result() && result().success ? 'text-success' : 'text-danger', text: resultTitle"></h5>
                        <p class="text-muted small mb-0" data-bind="text: resultMessage"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/iyzico-checkout.js" asp-append-version="true"></script>
    <script src="~/js/Payments.js" asp-append-version="true"></script>
}
