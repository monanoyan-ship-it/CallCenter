@{
    ViewData["Title"] = "Arama Geçmişi";
    var isCustomerAdmin = Context.Session.GetString("IsCustomerAdmin") == "true";
}

<div id="calls-vm">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex gap-2">
            <div class="input-group" style="max-width: 280px;">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="Numara ara..." data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
            </div>
            <select class="form-select form-select-sm" style="width: 140px;" data-bind="value: statusFilter">
                <option value="">Tüm Durumlar</option>
                <option value="6">Cevapsızlar</option>
                <option value="5">Tamamlananlar</option>
            </select>
        </div>
        <button class="btn btn-outline-secondary btn-sm" data-bind="click: load">
            <i class="bi bi-arrow-clockwise me-1"></i>Yenile
        </button>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Tarih</th>
                            <th>Arayan</th>
                            <th>Aranan</th>
                            <th>Durum</th>
                            <th>Süre</th>
                            <th>Personel</th>
                            @if (isCustomerAdmin) {
                                <th class="text-end pe-3">İşlem</th>
                            }
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredCalls">
                        <tr>
                            <td class="ps-3 small" data-bind="text: new Date(startedAt).toLocaleString('tr-TR')"></td>
                            <td class="fw-medium">
                                <a href="#" class="text-decoration-none" data-bind="text: callerNumber || '-', click: function() { $parent.showNumberHistory(callerNumber); }"></a>
                            </td>
                            <td>
                                <a href="#" class="text-decoration-none text-dark" data-bind="text: calleeNumber || '-', click: function() { $parent.showNumberHistory(calleeNumber); }"></a>
                            </td>
                            <td>
                                <span class="badge" data-bind="text: statusName, css: statusCss"></span>
                                <!-- ko if: callbackStatusId -->
                                <i class="bi bi-arrow-right-short mx-1 text-muted"></i>
                                <span class="badge" data-bind="text: callbackStatusName, css: callbackStatusCss"></span>
                                <!-- /ko -->
                            </td>
                            <td class="small" data-bind="text: durationText"></td>
                            <td class="small" data-bind="text: agentName"></td>
                            @if (isCustomerAdmin) {
                                <td class="text-end pe-3">
                                    <!-- ko if: !callbackStatusId -->
                                    <button class="btn btn-xs btn-primary py-0" data-bind="click: $parent.openAssignModal">
                                        <i class="bi bi-person-plus-fill me-1"></i>Ata
                                    </button>
                                    <!-- /ko -->
                                </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: filteredCalls().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-telephone-x" style="font-size: 2rem;"></i>
                <p class="mt-2 small">Arama kaydı bulunamadı</p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    @if (isCustomerAdmin) {
        <!-- Atama Modalı -->
        <div class="modal fade" id="assignModal" tabindex="-1">
            <div class="modal-dialog modal-sm">
                <div class="modal-content">
                    <div class="modal-header py-2">
                        <h6 class="modal-title">Geri Arama Ata</h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small">Temsilci Seçin</label>
                            <select class="form-select form-select-sm" data-bind="value: assignForm.assignedToId">
                                <option value="0">Havuz (Tum Operatorler)</option>
                                <!-- ko foreach: filteredPersonnel -->
                                <option data-bind="value: id, text: fullName"></option>
                                <!-- /ko -->
                            </select>
                        </div>
                        <div class="mb-0">
                            <label class="form-label small">Not (Opsiyonel)</label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: assignForm.note"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer py-1">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                        <button type="button" class="btn btn-primary btn-sm" data-bind="click: saveAssignment, disable: isSaving()">
                            <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                            Kaydet
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

    <!-- Numara Gecmisi Modali -->
    <div class="modal fade" id="numberHistoryModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">
                        <i class="bi bi-clock-history me-1"></i>
                        <span data-bind="text: historyNumber"></span> - Arama Gecmisi
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0">
                    <!-- ko if: isHistoryLoading -->
                    <div class="text-center py-4"><div class="spinner-border spinner-border-sm"></div></div>
                    <!-- /ko -->
                    <!-- ko ifnot: isHistoryLoading -->
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Tarih</th>
                                    <th>Arayan</th>
                                    <th>Aranan</th>
                                    <th>Durum</th>
                                    <th>Sure</th>
                                    <th>Personel</th>
                                    <th>Geri Arama</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: numberHistory">
                                <tr>
                                    <td class="ps-3 small" data-bind="text: new Date(startedAt).toLocaleString('tr-TR')"></td>
                                    <td class="small" data-bind="text: callerNumber || '-'"></td>
                                    <td class="small" data-bind="text: calleeNumber || '-'"></td>
                                    <td>
                                        <span class="badge" data-bind="text: statusName, css: statusCss"></span>
                                    </td>
                                    <td class="small" data-bind="text: durationText"></td>
                                    <td class="small" data-bind="text: agentName || '-'"></td>
                                    <td>
                                        <!-- ko if: callbackStatusId -->
                                        <span class="badge" data-bind="text: callbackStatusName, css: callbackStatusCss"></span>
                                        <!-- /ko -->
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- ko if: numberHistory().length === 0 -->
                    <div class="text-center text-muted py-4">
                        <p class="small mb-0">Bu numara icin gecmis kayit bulunamadi.</p>
                    </div>
                    <!-- /ko -->
                    <!-- /ko -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Calls.js"></script>
}
