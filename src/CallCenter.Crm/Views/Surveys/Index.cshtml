@{
    ViewData["Title"] = "Anketler";
}

<div id="surveys-vm">
    <div class="d-flex justify-content-center align-items-center" style="min-height: 400px;">
        <div class="text-center">
            <i class="bi bi-clipboard2-data text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-muted">Anketler</h4>
            <p class="text-muted">
                Müşteri memnuniyet anketleri ve geri bildirim modulu yaklasimda.<br />
                Bu ozellik ile çağrı sonrası otomatik anket gönderebilir ve sonuclari takip edebilirsiniz.
            </p>
            <span class="badge bg-info fs-6">
                <i class="bi bi-clock me-1"></i>Yakinda
            </span>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Surveys.js"></script>
}
