@{
    ViewData["Title"] = "Arama Kampanyalari";
}

<div id="campaigns-vm">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="input-group" style="max-width:300px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control form-control-sm" placeholder="Kampanya ara..."
                   data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
        </div>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i>Yeni Kampanya
        </button>
    </div>

    <!-- ko if: isLoading() -->
    <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
    <!-- /ko -->

    <!-- ko if: !isLoading() && campaigns().length === 0 -->
    <div class="text-center text-muted py-5">
        <i class="bi bi-list-check" style="font-size:3rem;"></i>
        <p class="mt-2">Henüz kampanya oluşturulmamış.</p>
    </div>
    <!-- /ko -->

    <!-- ko if: !isLoading() && campaigns().length > 0 -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Kampanya</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th class="text-center">Toplam</th>
                        <th class="text-center">Ulaşıldı</th>
                        <th class="text-center">Ulaşılamadı</th>
                        <th class="text-center">Bekliyor</th>
                        <th>Oluşturan</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: filteredCampaigns">
                    <tr>
                        <td>
                            <a class="text-decoration-none fw-medium" data-bind="attr: { href: '/Campaigns/Detail/' + uid }, text: name"></a>
                            <!-- ko if: description -->
                            <div class="text-muted small" data-bind="text: description"></div>
                            <!-- /ko -->
                        </td>
                        <td class="small text-muted" data-bind="text: scheduledDateFormatted"></td>
                        <td>
                            <span class="badge" data-bind="text: statusName, css: statusCss"></span>
                        </td>
                        <td class="text-center" data-bind="text: totalContacts"></td>
                        <td class="text-center text-success fw-medium" data-bind="text: reachedCount"></td>
                        <td class="text-center text-danger fw-medium" data-bind="text: notReachedCount"></td>
                        <td class="text-center text-muted" data-bind="text: pendingCount"></td>
                        <td class="small text-muted" data-bind="text: createdByName"></td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-outline-primary" title="Detay" data-bind="attr: { href: '/Campaigns/Detail/' + uid }">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <button class="btn btn-outline-danger" title="Sil" data-bind="click: $parent.remove">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <!-- /ko -->

    <!-- Yeni Kampanya Modal -->
    <div class="modal fade" id="campaignModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Yeni Kampanya</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small">Kampanya Adi *</label>
                        <input type="text" class="form-control form-control-sm" data-bind="value: form.name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Açıklama</label>
                        <textarea class="form-control form-control-sm" rows="2" data-bind="value: form.description"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Planlanan Tarih</label>
                        <input type="date" class="form-control form-control-sm" data-bind="value: form.scheduledDate" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                    <button class="btn btn-primary btn-sm" data-bind="click: create, disable: isSaving() || !form.name()">
                        <span data-bind="visible: isSaving()" class="spinner-border spinner-border-sm me-1"></span>
                        Oluştur
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Campaigns.js"></script>
}
