@using System.Text.Json
@using CallCenter.Shared.DTOs
@inject CallCenter.Shared.Services.ITranslationService Translation
@inject IConfiguration Configuration
@{
    var __crmLang = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var __crmTranslations = await Translation.GetAllAsync(__crmLang);
    var __crmTranslationsJson = JsonSerializer.Serialize(__crmTranslations);
}
<!DOCTYPE html>
<html lang="@__crmLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CorpLynk CRM</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        :root { --sidebar-width: 240px; }
        body { font-family: 'Segoe UI', system-ui, sans-serif; background: #f0f2f5; }
        .sidebar {
            width: var(--sidebar-width); height: 100vh; position: fixed; top: 0; left: 0;
            background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
            color: #fff; overflow-y: auto; z-index: 1000;
        }
        .sidebar .brand { padding: .75rem .85rem; border-bottom: 1px solid rgba(255,255,255,.1); }
        .app-switcher { display: flex; gap: .45rem; align-items: center; }
        .app-switcher .app-link {
            width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center;
            color: rgba(255,255,255,.72); background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.1);
            border-radius: 8px; text-decoration: none; font-size: 1.05rem;
        }
        .app-switcher .app-link:hover { color: #fff; background: rgba(255,255,255,.14); }
        .app-switcher .app-link.active { color: #fff; background: rgba(79,195,247,.24); border-color: rgba(79,195,247,.55); }
        .sidebar .nav-link { color: rgba(255,255,255,.7); padding: .6rem 1rem; font-size: .875rem; border-radius: 6px; margin: 2px 8px; }
        .sidebar .nav-link:hover { color: #fff; background: rgba(255,255,255,.1); }
        .sidebar .nav-link.active { color: #fff; background: rgba(79,195,247,.2); }
        .sidebar .nav-group-toggle {
            display: flex; align-items: center; width: 100%; padding: .6rem 1rem;
            color: rgba(255,255,255,.5); background: none; border: none;
            font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; cursor: pointer;
        }
        .sidebar .nav-group-toggle:hover { color: rgba(255,255,255,.7); }
        .sidebar .nav-group-toggle span { flex: 1; text-align: left; }
        .sidebar .nav-group-toggle .chevron { font-size: .6rem; transition: transform .2s ease; opacity: .5; }
        .sidebar .nav-group-toggle .chevron.open { transform: rotate(180deg); }
        .sidebar .nav-group-items { max-height: 0; overflow: hidden; transition: max-height .25s ease; }
        .sidebar .nav-group-items.show { max-height: 560px; }
        .content-area { margin-left: var(--sidebar-width); padding: 1.5rem; min-height: 100vh; }
        .topbar { background: #fff; border-bottom: 1px solid #e0e0e0; padding: .6rem 1.5rem; margin: -1.5rem -1.5rem 1.5rem; display: flex; align-items: center; justify-content: space-between; }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <div id="crm-layout-data" hidden data-translations="@__crmTranslationsJson"></div>
    @if (Context.Session.GetString("Token") != null)
    {
        CrmEntitlementsDto? entitlements = null;
        var entitlementJson = Context.Session.GetString("CrmEntitlements");
        if (!string.IsNullOrWhiteSpace(entitlementJson))
        {
            try
            {
                entitlements = JsonSerializer.Deserialize<CrmEntitlementsDto>(entitlementJson, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            }
            catch { }
        }

        var hasEntitlements = entitlements != null;
        var showCore = !hasEntitlements || entitlements!.HasStandaloneCrm;
        var showSalon = !hasEntitlements || entitlements!.HasSalonCrm;
        var showCallCenter = !hasEntitlements || entitlements!.HasCallCenterCrm;
        if (!showCore && !showSalon && !showCallCenter)
        {
            showCore = true;
        }
        var callCenterBaseUrl = (Configuration["CallCenterBaseUrl"] ?? "https://cc.corplynk.com").TrimEnd('/');
        var salonBaseUrl = (Configuration["SalonBaseUrl"] ?? "https://sln.corplynk.com").TrimEnd('/');

        <nav class="sidebar d-print-none">
            <div class="brand">
                <div class="app-switcher" aria-label="Uygulama gecisi">
                    @if (showCallCenter)
                    {
                        <a class="app-link" href="@callCenterBaseUrl" title="CallCenter" aria-label="CallCenter">
                            <i class="bi bi-headset"></i>
                        </a>
                    }
                    <a class="app-link active" href="/Home" title="CRM" aria-label="CRM" aria-current="page">
                        <i class="bi bi-person-lines-fill"></i>
                    </a>
                    @if (showSalon)
                    {
                        <a class="app-link" href="@salonBaseUrl" title="Salon" aria-label="Salon">
                            <i class="bi bi-scissors"></i>
                        </a>
                    }
                </div>
            </div>
            @{
                var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                var scopeOpen = ctrl == "Home" && action == "Overview";
                var crmOpen = (ctrl == "Home" && (action == "Core" || action == "Index"))
                    || ctrl is "Contacts" or "Tickets" or "Deals" or "CrmTasks" or "Surveys" or "Modules";
                var salonOpen = (ctrl == "Home" && action == "Salon") || ctrl is "SalonCrm";
                var callCenterOpen = (ctrl == "Home" && action == "CallCenter") || ctrl is "Calls" or "Activities" or "Tasks" or "Campaigns";
                var integrationOpen = ctrl is "Integrations";
                var reportOpen = ctrl is "Reports";
                var multipleScopes = entitlements?.Scopes?.Count > 1;
            }

            @if (multipleScopes)
            {
                <button class="nav-group-toggle mt-2" type="button" data-nav-group-toggle="1">
                    <span><t key="crm.sidebar.scopes">Kapsamlar</t></span>
                    <i class="bi bi-chevron-down chevron @(scopeOpen ? "open" : "")"></i>
                </button>
                <div class="nav-group-items @(scopeOpen ? "show" : "")">
                    <a class="nav-link @(scopeOpen ? "active" : "")" href="/Home/Overview">
                        <i class="bi bi-grid-1x2-fill me-2"></i><t key="crm.sidebar.overview">Genel Bakis</t>
                    </a>
                    @foreach (var scope in entitlements!.Scopes)
                    {
                        <a class="nav-link" href="@scope.DashboardUrl">
                            <i class="bi @scope.Icon me-2"></i>@scope.Label
                        </a>
                    }
                </div>
            }

            @if (showCore)
            {
                <button class="nav-group-toggle mt-2" type="button" data-nav-group-toggle="1">
                    <span><t key="crm.sidebar.section.crm">CRM</t></span>
                    <i class="bi bi-chevron-down chevron @(crmOpen ? "open" : "")"></i>
                </button>
                <div class="nav-group-items @(crmOpen ? "show" : "")">
                    <a class="nav-link @(ctrl == "Home" && action == "Core" ? "active" : "")" href="/Home/Core">
                        <i class="bi bi-speedometer2 me-2"></i><t key="crm.sidebar.dashboard">Dashboard</t>
                    </a>
                    <a class="nav-link @(ctrl == "Contacts" ? "active" : "")" href="/Contacts">
                        <i class="bi bi-people-fill me-2"></i><t key="crm.sidebar.contacts">Kisiler</t>
                    </a>
                    <a class="nav-link @(ctrl == "Tickets" ? "active" : "")" href="/Tickets">
                        <i class="bi bi-ticket-detailed-fill me-2"></i><t key="crm.sidebar.tickets">Talepler</t>
                    </a>
                    <a class="nav-link @(ctrl == "Deals" ? "active" : "")" href="/Deals">
                        <i class="bi bi-kanban-fill me-2"></i><t key="crm.sidebar.deals">Firsatlar</t>
                    </a>
                    <a class="nav-link @(ctrl == "CrmTasks" ? "active" : "")" href="/CrmTasks">
                        <i class="bi bi-check2-square me-2"></i><t key="crm.sidebar.tasks">Gorevler</t>
                    </a>
                    <a class="nav-link @(ctrl == "Surveys" ? "active" : "")" href="/Surveys">
                        <i class="bi bi-clipboard2-data me-2"></i><t key="crm.sidebar.surveys">Anketler</t>
                    </a>
                    <a class="nav-link @(ctrl == "Modules" ? "active" : "")" href="/Modules">
                        <i class="bi bi-grid-3x3-gap-fill me-2"></i><t key="crm.sidebar.service_scope">Hizmet Kapsami</t>
                    </a>
                </div>
            }

            @if (showSalon)
            {
                <button class="nav-group-toggle mt-1" type="button" data-nav-group-toggle="1">
                    <span><t key="crm.sidebar.scope.salon">Salon</t></span>
                    <i class="bi bi-chevron-down chevron @(salonOpen ? "open" : "")"></i>
                </button>
                <div class="nav-group-items @(salonOpen ? "show" : "")">
                    <a class="nav-link @(ctrl == "Home" && action == "Salon" ? "active" : "")" href="/Home/Salon">
                        <i class="bi bi-speedometer2 me-2"></i><t key="crm.sidebar.dashboard">Dashboard</t>
                    </a>
                    <a class="nav-link @(ctrl == "SalonCrm" && action == "Loyalty" ? "active" : "")" href="/SalonCrm/Loyalty">
                        <i class="bi bi-star-fill me-2"></i><t key="crm.sidebar.salon.loyalty">Sadakat</t>
                    </a>
                    <a class="nav-link @(ctrl == "SalonCrm" && action == "Memberships" ? "active" : "")" href="/SalonCrm/Memberships">
                        <i class="bi bi-award-fill me-2"></i><t key="crm.sidebar.salon.memberships">Uyelikler</t>
                    </a>
                    <a class="nav-link @(ctrl == "SalonCrm" && action == "GiftCards" ? "active" : "")" href="/SalonCrm/GiftCards">
                        <i class="bi bi-gift-fill me-2"></i><t key="crm.sidebar.salon.giftcards">Hediye Kartlari</t>
                    </a>
                    <a class="nav-link @(ctrl == "SalonCrm" && action == "Campaigns" ? "active" : "")" href="/SalonCrm/Campaigns">
                        <i class="bi bi-megaphone-fill me-2"></i><t key="crm.sidebar.salon.campaigns">Pazarlama ve SMS</t>
                    </a>
                    <a class="nav-link @(ctrl == "SalonCrm" && action == "EmailCampaigns" ? "active" : "")" href="/SalonCrm/EmailCampaigns">
                        <i class="bi bi-envelope-fill me-2"></i><t key="crm.sidebar.salon.emailcampaigns">E-posta Kampanyalari</t>
                    </a>
                    <a class="nav-link @(ctrl == "SalonCrm" && action == "Reviews" ? "active" : "")" href="/SalonCrm/Reviews">
                        <i class="bi bi-chat-square-text-fill me-2"></i><t key="crm.sidebar.salon.reviews">Yorum Yonetimi</t>
                    </a>
                    <a class="nav-link @(ctrl == "SalonCrm" && action == "Winback" ? "active" : "")" href="/SalonCrm/Winback">
                        <i class="bi bi-arrow-repeat me-2"></i><t key="crm.sidebar.salon.winback">Kayip Musteri</t>
                    </a>
                </div>
            }

            @if (showCallCenter)
            {
                <button class="nav-group-toggle mt-1" type="button" data-nav-group-toggle="1">
                    <span><t key="crm.sidebar.scope.callcenter">Call Center</t></span>
                    <i class="bi bi-chevron-down chevron @(callCenterOpen ? "open" : "")"></i>
                </button>
                <div class="nav-group-items @(callCenterOpen ? "show" : "")">
                    <a class="nav-link @(ctrl == "Home" && action == "CallCenter" ? "active" : "")" href="/Home/CallCenter">
                        <i class="bi bi-speedometer2 me-2"></i><t key="crm.sidebar.dashboard">Dashboard</t>
                    </a>
                    <a class="nav-link @(ctrl == "Calls" ? "active" : "")" href="/Calls">
                        <i class="bi bi-telephone-fill me-2"></i><t key="crm.sidebar.callhistory">Arama Gecmisi</t>
                    </a>
                    <a class="nav-link @(ctrl == "Activities" ? "active" : "")" href="/Activities">
                        <i class="bi bi-clock-history me-2"></i><t key="crm.sidebar.activities">Etkilesimler</t>
                    </a>
                    <a class="nav-link @(ctrl == "Tasks" ? "active" : "")" href="/Tasks">
                        <i class="bi bi-list-task me-2"></i><t key="crm.sidebar.trackingtasks">Gorevler</t>
                    </a>
                    <a class="nav-link @(ctrl == "Campaigns" ? "active" : "")" href="/Campaigns">
                        <i class="bi bi-megaphone-fill me-2"></i><t key="crm.sidebar.campaigns">Kampanyalar</t>
                    </a>
                </div>
            }

            @if (showCore || showCallCenter)
            {
                <button class="nav-group-toggle mt-1" type="button" data-nav-group-toggle="1">
                    <span><t key="crm.sidebar.section.integrations">Entegrasyonlar</t></span>
                    <i class="bi bi-chevron-down chevron @(integrationOpen ? "open" : "")"></i>
                </button>
                <div class="nav-group-items @(integrationOpen ? "show" : "")">
                    <a class="nav-link @(ctrl == "Integrations" && action == "Index" ? "active" : "")" href="/Integrations">
                        <i class="bi bi-plug-fill me-2"></i><t key="crm.sidebar.integrations">Baglantilar</t>
                    </a>
                    <a class="nav-link @(ctrl == "Integrations" && action == "Webhooks" ? "active" : "")" href="/Integrations/Webhooks">
                        <i class="bi bi-broadcast me-2"></i><t key="crm.sidebar.webhooks">Webhooklar</t>
                    </a>
                </div>

                <button class="nav-group-toggle mt-1" type="button" data-nav-group-toggle="1">
                    <span><t key="crm.sidebar.section.reports">Raporlar</t></span>
                    <i class="bi bi-chevron-down chevron @(reportOpen ? "open" : "")"></i>
                </button>
                <div class="nav-group-items @(reportOpen ? "show" : "")">
                    <a class="nav-link @(ctrl == "Reports" ? "active" : "")" href="/Reports">
                        <i class="bi bi-bar-chart-fill me-2"></i><t key="crm.sidebar.reports">Raporlar</t>
                    </a>
                </div>
            }

            <div class="position-absolute bottom-0 w-100 p-3 border-top" style="border-color: rgba(255,255,255,.1) !important;">
                <div class="d-flex align-items-center justify-content-between">
                    <small class="text-white-50">@Context.Session.GetString("UserName")</small>
                    <a href="/Account/Logout" class="text-white-50" title="@Translation.T("crm.logout", "Cikis")"><i class="bi bi-box-arrow-right"></i></a>
                </div>
                <div class="text-center mt-2" style="opacity:.4; font-size:.65rem;">
                    <t key="crm.footer.rights">Tum haklari saklidir.</t>
                </div>
            </div>
        </nav>

        <div class="content-area">
            <div class="topbar">
                <div>
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary-subtle text-primary">@Context.Session.GetString("CustomerName")</span>
                </div>
            </div>
            @RenderBody()
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/knockout/knockout-latest.min.js"></script>
    <link href="~/lib/toastr/toastr.min.css" rel="stylesheet" />
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script src="~/js/confirm-modal.js" asp-append-version="true"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
