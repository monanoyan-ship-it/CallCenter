<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CorpLynk CRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        :root { --sidebar-width: 240px; }
        body { font-family: 'Segoe UI', system-ui, sans-serif; background: #f0f2f5; }
        .sidebar {
            width: var(--sidebar-width); height: 100vh; position: fixed; top: 0; left: 0;
            background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
            color: #fff; overflow-y: auto; z-index: 1000;
        }
        .sidebar .brand { padding: 1rem; font-size: 1.1rem; font-weight: 700; border-bottom: 1px solid rgba(255,255,255,.1); }
        .sidebar .brand span { color: #4fc3f7; }
        .sidebar .nav-link { color: rgba(255,255,255,.7); padding: .6rem 1rem; font-size: .875rem; border-radius: 6px; margin: 2px 8px; }
        .sidebar .nav-link:hover { color: #fff; background: rgba(255,255,255,.1); }
        .sidebar .nav-link.active { color: #fff; background: rgba(79,195,247,.2); }
        .sidebar .nav-section { color: rgba(255,255,255,.4); font-size: .7rem; text-transform: uppercase; letter-spacing: .05em; padding: .8rem 1rem .3rem; }
        .content-area { margin-left: var(--sidebar-width); padding: 1.5rem; min-height: 100vh; }
        .topbar { background: #fff; border-bottom: 1px solid #e0e0e0; padding: .6rem 1.5rem; margin: -1.5rem -1.5rem 1.5rem; display: flex; align-items: center; justify-content: space-between; }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    @if (Context.Session.GetString("Token") != null)
    {
        <nav class="sidebar d-print-none">
            <div class="brand">
                <i class="bi bi-person-lines-fill me-2"></i>CorpLynk <span>CRM</span>
            </div>
            <div class="nav-section mt-2">Ana Menu</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" href="/">
                <i class="bi bi-speedometer2 me-2"></i>Dashboard
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contacts" ? "active" : "")" href="/Contacts">
                <i class="bi bi-people-fill me-2"></i>Kisiler
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tickets" ? "active" : "")" href="/Tickets">
                <i class="bi bi-ticket-detailed-fill me-2"></i>Talepler
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Deals" ? "active" : "")" href="/Deals">
                <i class="bi bi-kanban-fill me-2"></i>Firsatlar
            </a>

            <div class="nav-section mt-3">Takip</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Activities" ? "active" : "")" href="/Activities">
                <i class="bi bi-clock-history me-2"></i>Etkilesimler
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tasks" ? "active" : "")" href="/Tasks">
                <i class="bi bi-check2-square me-2"></i>Gorevler
            </a>

            <div class="nav-section mt-3">Raporlar</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" href="/Reports">
                <i class="bi bi-bar-chart-fill me-2"></i>Raporlar
            </a>

            <div class="position-absolute bottom-0 w-100 p-3 border-top" style="border-color: rgba(255,255,255,.1) !important;">
                <div class="d-flex align-items-center justify-content-between">
                    <small class="text-white-50">@Context.Session.GetString("UserName")</small>
                    <a href="/Account/Logout" class="text-white-50" title="Cikis"><i class="bi bi-box-arrow-right"></i></a>
                </div>
            </div>
        </nav>

        <div class="content-area">
            <div class="topbar">
                <div>
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary-subtle text-primary">@Context.Session.GetString("CustomerName")</span>
                </div>
            </div>
            @RenderBody()
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/knockout/3.5.1/knockout-latest.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        var apiBaseUrl = '@Html.Raw(Context.RequestServices.GetRequiredService<IConfiguration>()["ApiBaseUrl"])';

        // jQuery AJAX - otomatik Bearer token
        $.ajaxSetup({
            beforeSend: function(xhr) {
                var token = '@Html.Raw(Context.Session.GetString("Token") ?? "")';
                if (token) xhr.setRequestHeader('Authorization', 'Bearer ' + token);
            },
            error: function(xhr) {
                if (xhr.status === 401) window.location.href = '/Account/Login';
            }
        });

        // Toastr ayarlari
        toastr.options = { closeButton: true, progressBar: true, positionClass: 'toast-top-right', timeOut: 3000 };
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
