@{
    ViewData["Title"] = "Kişiler";
}

<div id="contacts-vm">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="input-group" style="max-width: 320px;">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="Kişi ara..." data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
        </div>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i>Yeni Kişi
        </button>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Ad Soyad</th>
                            <th>Firma</th>
                            <th>Telefon</th>
                            <th>E-posta</th>
                            <th>Talep</th>
                            <th>Fırsat</th>
                            <th style="width: 80px;"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredContacts">
                        <tr>
                            <td class="fw-semibold small"><a data-bind="text: fullName, attr: { href: '/Contacts/Detail/' + id }" class="text-decoration-none"></a></td>
                            <td class="small" data-bind="text: company"></td>
                            <td class="small" data-bind="text: phoneNumber"></td>
                            <td class="small" data-bind="text: email"></td>
                            <td class="small">
                                <!-- ko if: ticketCount > 0 -->
                                <span class="badge bg-warning text-dark" data-bind="text: ticketCount"></span>
                                <!-- /ko -->
                            </td>
                            <td class="small">
                                <!-- ko if: dealCount > 0 -->
                                <span class="badge bg-success" data-bind="text: dealCount"></span>
                                <!-- /ko -->
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" title="Düzenle" data-bind="click: $parent.openEdit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" title="Sil" data-bind="click: $parent.remove">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: filteredContacts().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="bi bi-people" style="font-size: 2rem;"></i>
                <p class="mt-2 small">Henüz kişi eklenmemiş</p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="contactModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" data-bind="text: isEditing() ? 'Kişi Düzenle' : 'Yeni Kişi'"></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small">Ad Soyad *</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.fullName" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Telefon *</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.phoneNumber" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Telefon 2</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.phoneNumber2" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">E-posta</label>
                            <input type="email" class="form-control form-control-sm" data-bind="value: form.email" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Firma</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.company" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Departman</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.department" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Unvan</label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.title" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Not</label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: form.notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Contacts.js"></script>
}
