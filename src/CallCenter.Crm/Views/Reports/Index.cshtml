@{
    ViewData["Title"] = "Raporlar";
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 fw-semibold">
                <i class="bi bi-bar-chart-fill me-1"></i>Yaklasim
            </div>
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-graph-up-arrow" style="font-size: 3rem;"></i>
                <p class="mt-3 small">CRM raporlari yakinda burada olacak.</p>
                <p class="small text-muted">Talep istatistikleri, pipeline analizi, etkilesim raporlari</p>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 fw-semibold">
                <i class="bi bi-pie-chart-fill me-1"></i>Planlanan Raporlar
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Talep Durum Dagilimi</span>
                        <span class="badge bg-secondary">Yakinda</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Pipeline Degeri (Aylik)</span>
                        <span class="badge bg-secondary">Yakinda</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Etkilesim Aktivitesi</span>
                        <span class="badge bg-secondary">Yakinda</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Personel Performansi</span>
                        <span class="badge bg-secondary">Yakinda</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Musteri Memnuniyeti</span>
                        <span class="badge bg-secondary">Yakinda</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
