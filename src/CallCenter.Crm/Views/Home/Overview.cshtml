@model CallCenter.Shared.DTOs.CrmEntitlementsDto
@{
    ViewData["Title"] = "CRM Kapsamlari";
    var scopes = Model?.Scopes ?? new List<CallCenter.Shared.DTOs.CrmScopeDto>();
}

<div class="row g-3">
    @foreach (var scope in scopes)
    {
        <div class="col-md-4">
            <a class="card border-0 shadow-sm h-100 text-decoration-none text-body" href="@scope.DashboardUrl">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="rounded bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center" style="width:42px;height:42px;">
                        <i class="bi @scope.Icon"></i>
                    </span>
                    <div>
                        <div class="fw-semibold">@scope.Label</div>
                        <div class="small text-muted">Dashboard</div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>
