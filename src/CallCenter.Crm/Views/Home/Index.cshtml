@{
    ViewData["Title"] ??= "CRM Ana Sayfa";
}

<div id="dashboard-vm">
    <!-- KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="text-muted small">Toplam Kişi</div>
                    <div class="fs-3 fw-bold text-primary" data-bind="text: totalContacts">-</div>
                    <i class="bi bi-people-fill text-primary"></i>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="text-muted small">Açık Talepler</div>
                    <div class="fs-3 fw-bold text-warning" data-bind="text: openTickets">-</div>
                    <i class="bi bi-ticket-detailed-fill text-warning"></i>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="text-muted small">Aktif Fırsatlar</div>
                    <div class="fs-3 fw-bold text-success" data-bind="text: activeDeals">-</div>
                    <i class="bi bi-kanban-fill text-success"></i>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="text-muted small">Bugün Etkileşim</div>
                    <div class="fs-3 fw-bold text-info" data-bind="text: todayActivities">-</div>
                    <i class="bi bi-clock-history text-info"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Fırsat toplamı banner -->
    <div class="card border-0 shadow-sm mb-4 bg-gradient" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="card-body py-3 text-white d-flex justify-content-between align-items-center">
            <div>
                <div class="small opacity-75">Satış Fırsatları Toplamı</div>
                <div class="fs-4 fw-bold" data-bind="text: pipelineValue">0 TL</div>
            </div>
            <i class="bi bi-graph-up-arrow" style="font-size: 2.5rem; opacity: .3;"></i>
        </div>
    </div>

    <div class="row g-3">
        <!-- Son Etkileşimler -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 fw-semibold">
                    <i class="bi bi-clock-history me-1"></i>Son Etkileşimler
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Kişi</th>
                                    <th>Tür</th>
                                    <th>Özet</th>
                                    <th>Zaman</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: recentActivities">
                                <tr>
                                    <td class="ps-3 small" data-bind="text: contactName"></td>
                                    <td><span class="badge bg-secondary" data-bind="text: typeName"></span></td>
                                    <td class="small" data-bind="text: summary"></td>
                                    <td class="small text-muted" data-bind="text: timeAgo"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- ko if: recentActivities().length === 0 -->
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                        <p class="mt-2 small">Henüz etkileşim yok</p>
                    </div>
                    <!-- /ko -->
                </div>
            </div>
        </div>

        <!-- Yaklaşan Görevler -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 fw-semibold">
                    <i class="bi bi-check2-square me-1"></i>Yaklaşan Görevler
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush" data-bind="foreach: upcomingTasks">
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between">
                                <small class="fw-semibold" data-bind="text: title"></small>
                                <small class="text-muted" data-bind="text: dueDateFormatted"></small>
                            </div>
                            <small class="text-muted" data-bind="text: contactName"></small>
                        </div>
                    </div>
                    <!-- ko if: upcomingTasks().length === 0 -->
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-calendar-check" style="font-size: 2rem;"></i>
                        <p class="mt-2 small">Yaklaşan görev yok</p>
                    </div>
                    <!-- /ko -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Dashboard.js" asp-append-version="true"></script>
}
