@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("crm.salon.dashboard.title", "Salon");
}

@section Styles {
    <style>
        .crm-tile-icon { width: 42px; height: 42px; }
    </style>
}

<div class="row g-3">
    <div class="col-md-4">
        <a class="card border-0 shadow-sm h-100 text-decoration-none text-body" href="/SalonCrm/Loyalty">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="crm-tile-icon rounded bg-warning-subtle text-warning d-inline-flex align-items-center justify-content-center">
                    <i class="bi bi-star-fill"></i>
                </span>
                <div>
                    <div class="fw-semibold"><t key="crm.salon.loyalty.title">Sadakat</t></div>
                    <div class="small text-muted"><t key="crm.salon.loyalty.desc">Puan ve musteri bakiyesi</t></div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a class="card border-0 shadow-sm h-100 text-decoration-none text-body" href="/SalonCrm/Memberships">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="crm-tile-icon rounded bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center">
                    <i class="bi bi-award-fill"></i>
                </span>
                <div>
                    <div class="fw-semibold"><t key="crm.salon.memberships.title">Uyelikler</t></div>
                    <div class="small text-muted"><t key="crm.salon.memberships.desc">Plan ve kullanim takibi</t></div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a class="card border-0 shadow-sm h-100 text-decoration-none text-body" href="/SalonCrm/GiftCards">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="crm-tile-icon rounded bg-success-subtle text-success d-inline-flex align-items-center justify-content-center">
                    <i class="bi bi-gift-fill"></i>
                </span>
                <div>
                    <div class="fw-semibold"><t key="crm.salon.giftcards.title">Hediye Kartlari</t></div>
                    <div class="small text-muted"><t key="crm.salon.giftcards.desc">Kart ve bakiye islemleri</t></div>
                </div>
            </div>
        </a>
    </div>
</div>
