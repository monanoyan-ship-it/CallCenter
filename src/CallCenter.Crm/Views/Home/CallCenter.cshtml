@{
    ViewData["Title"] = "Call Center";
}

<div class="row g-3">
    <div class="col-md-3">
        <a class="card border-0 shadow-sm h-100 text-decoration-none text-body" href="/Calls">
            <div class="card-body text-center">
                <i class="bi bi-telephone-fill text-primary fs-3"></i>
                <div class="fw-semibold mt-2">Arama Geçmişi</div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a class="card border-0 shadow-sm h-100 text-decoration-none text-body" href="/Contacts">
            <div class="card-body text-center">
                <i class="bi bi-people-fill text-success fs-3"></i>
                <div class="fw-semibold mt-2">Kişiler</div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a class="card border-0 shadow-sm h-100 text-decoration-none text-body" href="/Tickets">
            <div class="card-body text-center">
                <i class="bi bi-ticket-detailed-fill text-warning fs-3"></i>
                <div class="fw-semibold mt-2">Talepler</div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a class="card border-0 shadow-sm h-100 text-decoration-none text-body" href="/Activities">
            <div class="card-body text-center">
                <i class="bi bi-clock-history text-info fs-3"></i>
                <div class="fw-semibold mt-2">Etkileşimler</div>
            </div>
        </a>
    </div>
</div>
