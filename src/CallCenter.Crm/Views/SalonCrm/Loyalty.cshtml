@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("crm.salon.loyalty.page_title", "Salon - Sadakat");
}

@section Styles {
    <style>
        .crm-empty-icon { font-size: 2rem; }
    </style>
}

<div id="salon-loyalty-vm">
    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold small"><t key="crm.salon.loyalty.settings">Sadakat Ayarlari</t></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label small"><t key="crm.salon.loyalty.points_per_tl">1 TL karsiligi puan</t></label>
                        <input type="number" min="0" step="0.01" class="form-control form-control-sm" data-bind="value: config.pointsPerTL" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small"><t key="crm.salon.loyalty.point_value">1 puan degeri</t></label>
                        <input type="number" min="0" step="0.01" class="form-control form-control-sm" data-bind="value: config.pointValue" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small"><t key="crm.salon.loyalty.min_redeem_points">Minimum kullanim puani</t></label>
                        <input type="number" min="0" step="1" class="form-control form-control-sm" data-bind="value: config.minRedeemPoints" />
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="loyaltyActive" data-bind="checked: config.isActive" />
                        <label class="form-check-label small" for="loyaltyActive"><t key="crm.salon.loyalty.program_active">Program aktif</t></label>
                    </div>
                    <button class="btn btn-primary btn-sm w-100" data-bind="click: saveConfig, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i><t key="crm.common.btn.save">Kaydet</t>
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <span class="fw-semibold small"><t key="crm.salon.loyalty.client_points">Musteri Puanlari</t></span>
                    <button class="btn btn-outline-secondary btn-sm" data-bind="click: loadClients">
                        <i class="bi bi-arrow-clockwise me-1"></i><t key="crm.common.btn.refresh">Yenile</t>
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th><t key="crm.salon.loyalty.client">Musteri</t></th>
                                    <th><t key="crm.salon.loyalty.earned">Kazanilan</t></th>
                                    <th><t key="crm.salon.loyalty.spent">Harcanan</t></th>
                                    <th><t key="crm.salon.loyalty.balance">Bakiye</t></th>
                                    <th><t key="crm.salon.loyalty.balance_value">TL Karsiligi</t></th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: clientLoyalties">
                                <tr>
                                    <td class="fw-semibold small" data-bind="text: clientName"></td>
                                    <td class="small" data-bind="text: totalEarned"></td>
                                    <td class="small" data-bind="text: totalSpent"></td>
                                    <td class="small fw-semibold" data-bind="text: currentBalance"></td>
                                    <td class="small" data-bind="text: $parent.money(balanceValue)"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- ko if: clientLoyalties().length === 0 -->
                    <div class="text-center text-muted py-4">
                        <i class="crm-empty-icon bi bi-star"></i>
                        <p class="mt-2 small"><t key="crm.salon.loyalty.empty">Sadakat puani olan musteri yok</t></p>
                    </div>
                    <!-- /ko -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/SalonLoyalty.js" asp-append-version="true"></script>
}
