@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("crm.salon.loyalty.page_title", "Salon - Sadakat");
}

@section Styles {
    <style>
        .crm-empty-icon { font-size: 2rem; }
    </style>
}

<div class="mb-3">
    <h5 class="mb-1"><t key="crm.salon.loyalty.page_title">Salon - Sadakat</t></h5>
    <div class="text-muted small">
        <t key="crm.salon.loyalty.tabs_hint">Müşteriler harcama yaptıkça puan kazanır; belirlediğiniz hizmetlere geldikçe ödül hakkı oluşur.</t>
    </div>
</div>

<ul class="nav nav-tabs" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#crm-tab-points" type="button">
            <i class="bi bi-coin me-1"></i><t key="crm.salon.loyalty.tab.points">Sadakat Puanı</t>
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#crm-tab-program" type="button">
            <i class="bi bi-stars me-1"></i><t key="crm.salon.loyalty.tab.program">Sadakat Programı</t>
        </button>
    </li>
</ul>

<div class="tab-content border border-top-0 rounded-bottom p-3">
    <div class="tab-pane fade show active" id="crm-tab-points" role="tabpanel">
        <div id="salon-loyalty-vm">
            <div class="row g-3">
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white fw-semibold small"><t key="crm.salon.loyalty.settings">Sadakat Ayarları</t></div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label small"><t key="crm.salon.loyalty.points_per_tl">1 TL karşılığı puan</t></label>
                                <input type="number" min="0" step="0.01" class="form-control form-control-sm" data-bind="value: config.pointsPerTL" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small"><t key="crm.salon.loyalty.point_value">1 puan değeri</t></label>
                                <input type="number" min="0" step="0.01" class="form-control form-control-sm" data-bind="value: config.pointValue" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small"><t key="crm.salon.loyalty.min_redeem_points">Minimum kullanım puanı</t></label>
                                <input type="number" min="0" step="1" class="form-control form-control-sm" data-bind="value: config.minRedeemPoints" />
                            </div>
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="loyaltyActive" data-bind="checked: config.isActive" />
                                <label class="form-check-label small" for="loyaltyActive"><t key="crm.salon.loyalty.program_active">Program aktif</t></label>
                            </div>
                            <button class="btn btn-primary btn-sm w-100" data-bind="click: saveConfig, disable: isSaving">
                                <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                                <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i><t key="crm.common.btn.save">Kaydet</t>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <span class="fw-semibold small"><t key="crm.salon.loyalty.client_points">Müşteri Puanları</t></span>
                            <button class="btn btn-outline-secondary btn-sm" data-bind="click: loadClients">
                                <i class="bi bi-arrow-clockwise me-1"></i><t key="crm.common.btn.refresh">Yenile</t>
                            </button>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover table-sm mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th><t key="crm.salon.loyalty.client">Müşteri</t></th>
                                            <th><t key="crm.salon.loyalty.earned">Kazanılan</t></th>
                                            <th><t key="crm.salon.loyalty.spent">Harcanan</t></th>
                                            <th><t key="crm.salon.loyalty.balance">Bakiye</t></th>
                                            <th><t key="crm.salon.loyalty.balance_value">TL Karşılığı</t></th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: clientLoyalties">
                                        <tr>
                                            <td class="fw-semibold small" data-bind="text: clientName"></td>
                                            <td class="small" data-bind="text: totalEarned"></td>
                                            <td class="small" data-bind="text: totalSpent"></td>
                                            <td class="small fw-semibold" data-bind="text: currentBalance"></td>
                                            <td class="small" data-bind="text: $parent.money(balanceValue)"></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <!-- ko if: clientLoyalties().length === 0 -->
                            <div class="text-center text-muted py-4">
                                <i class="crm-empty-icon bi bi-star"></i>
                                <p class="mt-2 small"><t key="crm.salon.loyalty.empty">Sadakat puanı olan müşteri yok</t></p>
                            </div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="crm-tab-program" role="tabpanel">
        <div id="salon-loyalty-program-vm">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="text-muted small">
                    <t key="crm.salon.loyalty.program.hint">Belirli hizmetlere düzenli gelen müşterilere otomatik ödül tanımlayın.</t>
                </div>
                <button class="btn btn-outline-secondary btn-sm" data-bind="click: loadAll">
                    <i class="bi bi-arrow-clockwise me-1"></i><t key="crm.common.btn.refresh">Yenile</t>
                </button>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted"><t key="crm.salon.loyalty.program.stat.programs">Program</t></div><div class="fs-5 fw-semibold" data-bind="text: programs().length"></div></div></div>
                <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted"><t key="crm.salon.loyalty.program.stat.active">Takipteki Müşteri</t></div><div class="fs-5 fw-semibold" data-bind="text: progresses().length"></div></div></div>
                <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted"><t key="crm.salon.loyalty.program.stat.earned">Kazanılan Ödül</t></div><div class="fs-5 fw-semibold" data-bind="text: totalEarned()"></div></div></div>
                <div class="col-md-3"><div class="border rounded p-2"><div class="small text-muted"><t key="crm.salon.loyalty.program.stat.available">Kullanılabilir Ödül</t></div><div class="fs-5 fw-semibold" data-bind="text: totalAvailable()"></div></div></div>
            </div>

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <strong><t key="crm.salon.loyalty.program.programs">Programlar</t></strong>
                    <button class="btn btn-primary btn-sm" data-bind="click: openCreate">
                        <i class="bi bi-plus-circle me-1"></i><t key="crm.salon.loyalty.program.btn.new">Yeni Program</t>
                    </button>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover table-sm mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th><t key="crm.salon.loyalty.program.col.name">Ad</t></th>
                                <th><t key="crm.salon.loyalty.program.col.service">Takip Edilen Hizmet</t></th>
                                <th><t key="crm.salon.loyalty.program.col.required">Gerekli Ziyaret</t></th>
                                <th><t key="crm.salon.loyalty.program.col.reward">Ödül Hizmeti</t></th>
                                <th><t key="crm.salon.loyalty.program.col.status">Durum</t></th>
                                <th class="text-end"><t key="crm.salon.loyalty.program.col.actions">İşlemler</t></th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: programs">
                            <tr>
                                <td class="fw-semibold small" data-bind="text: $data.name"></td>
                                <td class="small" data-bind="text: $data.serviceName"></td>
                                <td class="small" data-bind="text: $data.requiredVisits"></td>
                                <td class="small" data-bind="text: $data.rewardServiceName"></td>
                                <td><span class="badge" data-bind="css: $data.isActive ? 'bg-success' : 'bg-secondary', text: $data.isActive ? 'Aktif' : 'Pasif'"></span></td>
                                <td class="text-end">
                                    <button class="btn btn-outline-secondary btn-sm me-1" data-bind="click: $parent.openEdit"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.removeProgram"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Program Form Modal -->
            <div class="modal fade" id="loyaltyProgramModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" data-bind="text: editingId() ? '@(Translation.T("crm.salon.loyalty.program.modal.edit_title", "Program Düzenle"))' : '@(Translation.T("crm.salon.loyalty.program.modal.new_title", "Yeni Program"))'"></h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-2">
                                <label class="form-label small"><t key="crm.salon.loyalty.program.form.name">Ad</t> *</label>
                                <input type="text" class="form-control form-control-sm" data-bind="textInput: form.name" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small"><t key="crm.salon.loyalty.program.form.service">Takip Edilen Hizmet</t> *</label>
                                <select class="form-select form-select-sm" data-bind="options: services, optionsText: 'name', optionsValue: 'id', value: form.serviceId, optionsCaption: '—'"></select>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small"><t key="crm.salon.loyalty.program.form.required">Kaç Ziyaret Sonra</t> *</label>
                                <input type="number" min="1" class="form-control form-control-sm" data-bind="textInput: form.requiredVisits" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small"><t key="crm.salon.loyalty.program.form.reward">Ödül Hizmeti</t> *</label>
                                <select class="form-select form-select-sm" data-bind="options: services, optionsText: 'name', optionsValue: 'id', value: form.rewardServiceId, optionsCaption: '—'"></select>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="loyaltyProgramActive" data-bind="checked: form.isActive" />
                                <label class="form-check-label small" for="loyaltyProgramActive"><t key="crm.salon.loyalty.program.form.active">Aktif</t></label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="crm.common.btn.cancel">Vazgeç</t></button>
                            <button type="button" class="btn btn-primary btn-sm" data-bind="click: saveProgram"><t key="crm.common.btn.save">Kaydet</t></button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white"><strong><t key="crm.salon.loyalty.program.client_progress">Müşteri Takibi</t></strong></div>
                <div class="card-body p-0">
                    <table class="table table-hover table-sm mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th><t key="crm.salon.loyalty.program.col.client">Müşteri</t></th>
                                <th><t key="crm.salon.loyalty.program.col.program">Program</t></th>
                                <th><t key="crm.salon.loyalty.program.col.progress">Ziyaret</t></th>
                                <th><t key="crm.salon.loyalty.program.col.earned">Kazanılan Ödül</t></th>
                                <th><t key="crm.salon.loyalty.program.col.available">Kullanılabilir</t></th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: progresses">
                            <tr>
                                <td class="fw-semibold small" data-bind="text: $data.clientName || '—'"></td>
                                <td class="small" data-bind="text: $data.programName"></td>
                                <td class="small" data-bind="text: $data.visitCount + ' / ' + $data.requiredVisits"></td>
                                <td class="small" data-bind="text: $data.rewardsEarned"></td>
                                <td><span class="badge bg-info" data-bind="text: $data.availableRewards"></span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/SalonLoyalty.js" asp-append-version="true"></script>
    <script src="~/js/SalonLoyaltyProgram.js" asp-append-version="true"></script>
}
