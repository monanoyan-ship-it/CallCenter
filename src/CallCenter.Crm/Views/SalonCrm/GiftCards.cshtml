@inject CallCenter.Shared.Services.ITranslationService Translation
@{
    ViewData["Title"] = Translation.T("crm.salon.giftcards.page_title", "Salon - Hediye Kartlari");
}

@section Styles {
    <style>
        .crm-search-wide { max-width: 340px; }
        .crm-actions-narrow { width: 80px; }
        .crm-empty-icon { font-size: 2rem; }
    </style>
}

<div id="salon-giftcards-vm">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="input-group crm-search-wide">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="@Translation.T("crm.salon.giftcards.search_placeholder", "Kart, alici veya gonderen ara...")" data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
        </div>
        <button class="btn btn-primary btn-sm" data-bind="click: openNew">
            <i class="bi bi-plus-lg me-1"></i><t key="crm.salon.giftcards.new">Yeni Hediye Karti</t>
        </button>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th><t key="crm.salon.giftcards.code">Kod</t></th>
                            <th><t key="crm.salon.giftcards.recipient">Alici</t></th>
                            <th><t key="crm.salon.giftcards.sender">Gonderen</t></th>
                            <th><t key="crm.salon.giftcards.amount">Tutar</t></th>
                            <th><t key="crm.salon.giftcards.remaining">Kalan</t></th>
                            <th><t key="crm.salon.giftcards.branch">Sube</t></th>
                            <th><t key="crm.common.status">Durum</t></th>
                            <th class="crm-actions-narrow"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredCards">
                        <tr>
                            <td class="fw-semibold small" data-bind="text: code"></td>
                            <td class="small">
                                <div data-bind="text: recipientName || '-'"></div>
                                <div class="text-muted" data-bind="text: recipientPhone"></div>
                            </td>
                            <td class="small" data-bind="text: senderName || '-'"></td>
                            <td class="small" data-bind="text: $parent.money(originalAmount)"></td>
                            <td class="small fw-semibold" data-bind="text: $parent.money(remainingBalance)"></td>
                            <td class="small" data-bind="text: branchName || window.crmT('crm.common.all_branches', 'Tum subeler')"></td>
                            <td class="small">
                                <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? window.crmT('crm.common.active', 'Aktif') : window.crmT('crm.common.closed', 'Kapali')"></span>
                            </td>
                            <td>
                                <!-- ko if: isActive -->
                                <button class="btn btn-outline-danger btn-sm" title="@Translation.T("crm.common.close", "Kapat")" data-bind="click: $parent.deactivate">
                                    <i class="bi bi-slash-circle"></i>
                                </button>
                                <!-- /ko -->
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- ko if: filteredCards().length === 0 -->
            <div class="text-center text-muted py-4">
                <i class="crm-empty-icon bi bi-gift"></i>
                <p class="mt-2 small"><t key="crm.salon.giftcards.empty">Hediye karti bulunamadi</t></p>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <div class="modal fade" id="salonGiftCardModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title"><t key="crm.salon.giftcards.new">Yeni Hediye Karti</t></h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small"><t key="crm.salon.giftcards.amount_required">Tutar *</t></label>
                            <input type="number" min="1" step="1" class="form-control form-control-sm" data-bind="value: form.amount" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="crm.salon.giftcards.payment">Odeme</t></label>
                            <select class="form-select form-select-sm" data-bind="value: form.paymentMethodId">
                                <option value="1"><t key="crm.payment.cash">Nakit</t></option>
                                <option value="2"><t key="crm.payment.card">Kart</t></option>
                                <option value="3"><t key="crm.payment.transfer">Havale</t></option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="crm.salon.giftcards.recipient">Alici</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.recipientName" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="crm.salon.giftcards.recipient_phone">Alici Telefon</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.recipientPhone" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="crm.salon.giftcards.sender">Gonderen</t></label>
                            <input type="text" class="form-control form-control-sm" data-bind="value: form.senderName" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small"><t key="crm.salon.giftcards.expires_at">Son Kullanim</t></label>
                            <input type="date" class="form-control form-control-sm" data-bind="value: form.expiresAt" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small"><t key="crm.salon.giftcards.message">Mesaj</t></label>
                            <textarea class="form-control form-control-sm" rows="2" data-bind="value: form.message"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><t key="crm.common.btn.cancel">Iptal</t></button>
                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: save, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg me-1" data-bind="visible: !isSaving()"></i><t key="crm.common.btn.save">Kaydet</t>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/SalonGiftCards.js" asp-append-version="true"></script>
}
