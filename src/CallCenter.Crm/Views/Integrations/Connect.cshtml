@{
    ViewData["Title"] = "Entegrasyon Baglantisi";
    var platform = ViewData["Platform"]?.ToString() ?? "";
}

<div id="connect-vm" data-platform="@Html.Raw(platform)">
    <!-- Back Button -->
    <a href="/Integrations" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="bi bi-arrow-left me-1"></i>Geri
    </a>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <div class="d-flex align-items-center gap-3">
                        <span class="badge rounded-pill fs-6 px-3 py-2" data-bind="class: platformInfo().cssClass">
                            <i data-bind="class: platformInfo().icon"></i>
                        </span>
                        <div>
                            <h6 class="mb-0" data-bind="text: platformInfo().systemName">Platform</h6>
                            <small class="text-muted" data-bind="text: platformInfo().description"></small>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Baglanti Adi -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Baglanti Adi *</label>
                        <input type="text" class="form-control form-control-sm" placeholder="Ornegin: Firmam Salesforce" data-bind="value: form.name" />
                    </div>

                    <!-- OAuth2 Platformlar (Salesforce / HubSpot) -->
                    <!-- ko if: isOAuthPlatform() -->
                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-1"></i>
                        <span data-bind="text: platformInfo().systemName"></span> baglanmak icin OAuth2 yetkilendirme gereklidir.
                        Asagidaki butona tikladiginizda <span data-bind="text: platformInfo().systemName"></span> giris sayfasina yonlendirileceksiniz.
                    </div>
                    <!-- /ko -->

                    <!-- Zendesk: Credential Form -->
                    <!-- ko if: platformName() === 'Zendesk' -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Zendesk Subdomain *</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control" placeholder="firmam" data-bind="value: form.subdomain" />
                            <span class="input-group-text">.zendesk.com</span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">E-posta Adresi *</label>
                        <input type="email" class="form-control form-control-sm" placeholder="admin@firma.com" data-bind="value: form.email" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">API Token *</label>
                        <input type="password" class="form-control form-control-sm" placeholder="Zendesk API token" data-bind="value: form.apiToken" />
                        <div class="form-text">Zendesk Admin > Apps and integrations > APIs > Zendesk API</div>
                    </div>
                    <!-- /ko -->

                    <!-- GenericWebhook: Minimal Form -->
                    <!-- ko if: platformName() === 'GenericWebhook' -->
                    <div class="alert alert-secondary small">
                        <i class="bi bi-info-circle me-1"></i>
                        Genel Webhook baglantisi olusturulacak. Webhook ve API Key ayarlarini baglanti sonrasi yapabilirsiniz.
                    </div>
                    <!-- /ko -->

                    <hr class="my-3" />

                    <!-- Ortak Ayarlar -->
                    <h6 class="small text-muted mb-3">Senkronizasyon Ayarlari</h6>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="autoLogCalls" data-bind="checked: form.autoLogCalls" />
                            <label class="form-check-label small" for="autoLogCalls">Cagrilari otomatik logla</label>
                        </div>
                        <div class="form-text">Her cagri sonrasi dis sisteme aktivite kaydi olusturur</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Rehber Senkronizasyon Yonu</label>
                        <select class="form-select form-select-sm" data-bind="value: form.contactSyncDirectionId">
                            <option value="0">Senkronizasyon yok</option>
                            <option value="1">Dis sisteme gonder</option>
                            <option value="2">Dis sistemden al</option>
                            <option value="3">Cift yonlu senkronizasyon</option>
                        </select>
                    </div>
                </div>
                <div class="card-footer bg-white d-flex justify-content-end gap-2">
                    <a href="/Integrations" class="btn btn-secondary btn-sm">Iptal</a>
                    <!-- ko if: isOAuthPlatform() -->
                    <button class="btn btn-primary btn-sm" data-bind="click: connectWithOAuth, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-shield-lock me-1" data-bind="visible: !isSaving()"></i>OAuth2 ile Baglan
                    </button>
                    <!-- /ko -->
                    <!-- ko ifnot: isOAuthPlatform() -->
                    <button class="btn btn-primary btn-sm" data-bind="click: connectDirect, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-plug-fill me-1" data-bind="visible: !isSaving()"></i>Baglan
                    </button>
                    <!-- /ko -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/IntegrationConnect.js"></script>
}
