@page "/admin/services"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs

<PageTitle>Hizmet Yonetimi - CorpLynk</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="mb-0"><i class="bi bi-box-seam me-2 text-primary"></i>Hizmet Yonetimi</h4>
</div>

@* ─── OZET KARTLAR ─── *@
@if (summary != null)
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <div class="fs-3 fw-bold text-primary">@summary.TotalActiveSubscriptions</div>
                    <div class="text-muted small">Aktif Abonelik</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <div class="fs-3 fw-bold text-success">@summary.TotalMonthlyRevenue.ToString("N2") TL</div>
                    <div class="text-muted small">Aylik Hizmet Geliri</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <div class="fs-3 fw-bold text-info">@summary.ServiceBreakdown.Count</div>
                    <div class="text-muted small">Satilan Hizmet Turu</div>
                </div>
            </div>
        </div>
    </div>

    @if (summary.ServiceBreakdown.Count > 0)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent border-0 fw-semibold">
                <i class="bi bi-pie-chart me-1"></i>Hizmet Bazli Dagilim
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Hizmet</th>
                                <th class="text-center">Aktif Abone</th>
                                <th class="text-end">Aylik Toplam</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in summary.ServiceBreakdown)
                            {
                                <tr>
                                    <td>@item.ServiceName</td>
                                    <td class="text-center">
                                        <span class="badge bg-primary-subtle text-primary rounded-pill">@item.ActiveCount</span>
                                    </td>
                                    <td class="text-end fw-semibold">@item.TotalMonthly.ToString("N2") TL</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}
else if (isLoadingSummary)
{
    <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
}

@* ─── HİZMET TANIMLARI ─── *@
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-transparent border-0 fw-semibold">
        <i class="bi bi-list-check me-1"></i>Hizmet Tanimlari
    </div>
    <div class="card-body p-0">
        @if (isLoadingServices)
        {
            <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
        }
        else if (services != null && services.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Kod</th>
                            <th>Hizmet Adi</th>
                            <th>Kategori</th>
                            <th class="text-end">Varsayilan Fiyat</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var svc in services)
                        {
                            <tr>
                                <td><code>@svc.Code</code></td>
                                <td>@svc.Name</td>
                                <td>
                                    @if (svc.CategoryId == 1)
                                    {
                                        <span class="badge bg-success-subtle text-success">Standart</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning">Premium</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (svc.IsDefault)
                                    {
                                        <span class="text-muted">Dahil</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning">Ucretli</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ─── TOPLU FİYAT ARTIRMA ─── *@
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-transparent border-0 fw-semibold">
        <i class="bi bi-arrow-up-circle me-1"></i>Toplu Fiyat Ayarlamasi
    </div>
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">Hizmet</label>
                <select class="form-select form-select-sm" @bind="adjustServiceId">
                    <option value="">Tum Hizmetler</option>
                    @if (services != null)
                    {
                        @foreach (var svc in services.Where(s => s.CategoryId == 2))
                        {
                            <option value="@svc.Id">@svc.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Artis Tipi</label>
                <div class="d-flex gap-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="adjustType" id="typeAmount"
                               checked="@(adjustType == "amount")" @onchange='() => adjustType = "amount"' />
                        <label class="form-check-label small" for="typeAmount">Tutar (TL)</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="adjustType" id="typePercent"
                               checked="@(adjustType == "percent")" @onchange='() => adjustType = "percent"' />
                        <label class="form-check-label small" for="typePercent">Oran (%)</label>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Deger</label>
                <input type="number" class="form-control form-control-sm" step="0.01" @bind="adjustValue" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-warning btn-sm w-100" @onclick="ShowAdjustConfirm" disabled="@isAdjusting">
                    @if (isAdjusting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-arrow-up-circle me-1"></i>Uygula
                </button>
            </div>
        </div>

        @if (adjustResult != null)
        {
            <div class="alert alert-info mt-3 py-2 small mb-0">
                <strong>@adjustResult.AffectedCount</strong> abonelik etkilendi.
                Eski toplam: <strong>@adjustResult.OldTotalMonthly.ToString("N2") TL</strong> →
                Yeni toplam: <strong>@adjustResult.NewTotalMonthly.ToString("N2") TL</strong>
            </div>
        }
    </div>
</div>

@* ─── HİZMET FATURALARI OLUŞTUR ─── *@
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-transparent border-0 fw-semibold">
        <i class="bi bi-receipt me-1"></i>Hizmet Faturalari Olustur
    </div>
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">Yil</label>
                <input type="number" class="form-control form-control-sm" @bind="billingYear" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">Ay</label>
                <input type="number" class="form-control form-control-sm" min="1" max="12" @bind="billingMonth" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary btn-sm w-100" @onclick="GenerateBilling" disabled="@isGenerating">
                    @if (isGenerating)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-plus-circle me-1"></i>Olustur
                </button>
            </div>
        </div>
    </div>
</div>

@* ─── ONAY MODALI ─── *@
@if (showAdjustConfirm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">Fiyat Artisi Onayi</h6>
                    <button class="btn-close btn-close-sm" @onclick="() => showAdjustConfirm = false"></button>
                </div>
                <div class="modal-body small">
                    <p>
                        @if (adjustType == "amount")
                        {
                            <span>Tum aktif aboneliklere <strong>@adjustValue.ToString("N2") TL</strong> eklenecek.</span>
                        }
                        else
                        {
                            <span>Tum aktif aboneliklere <strong>%@adjustValue.ToString("N2")</strong> artis uygulanacak.</span>
                        }
                    </p>
                    <p class="text-danger mb-0">Bu islem geri alinamaz!</p>
                </div>
                <div class="modal-footer py-1">
                    <button class="btn btn-sm btn-secondary" @onclick="() => showAdjustConfirm = false">Vazgec</button>
                    <button class="btn btn-sm btn-warning" @onclick="ExecuteAdjust">Onayla</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // Ozet
    private ServiceSubscriptionSummaryDto? summary;
    private bool isLoadingSummary;

    // Hizmet listesi
    private List<ServiceTypeDto>? services;
    private bool isLoadingServices;

    // Toplu fiyat artirma
    private string adjustServiceId = "";
    private string adjustType = "amount";
    private decimal adjustValue;
    private bool isAdjusting;
    private bool showAdjustConfirm;
    private BulkPriceAdjustResultDto? adjustResult;

    // Fatura olusturma
    private int billingYear = DateTime.Now.Year;
    private int billingMonth = DateTime.Now.Month;
    private bool isGenerating;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadSummary(), LoadServices());
    }

    private async Task LoadSummary()
    {
        isLoadingSummary = true;
        try
        {
            summary = await Http.GetFromJsonAsync<ServiceSubscriptionSummaryDto>("api/service-subscriptions/summary");
        }
        catch (Exception ex) { Toast.ShowError($"Ozet yuklenemedi: {ex.Message}"); }
        finally { isLoadingSummary = false; }
    }

    private async Task LoadServices()
    {
        isLoadingServices = true;
        try
        {
            services = await Http.GetFromJsonAsync<List<ServiceTypeDto>>("api/services");
        }
        catch (Exception ex) { Toast.ShowError($"Hizmetler yuklenemedi: {ex.Message}"); }
        finally { isLoadingServices = false; }
    }

    private void ShowAdjustConfirm()
    {
        if (adjustValue == 0)
        {
            Toast.ShowError("Deger 0 olamaz.");
            return;
        }
        showAdjustConfirm = true;
    }

    private async Task ExecuteAdjust()
    {
        showAdjustConfirm = false;
        isAdjusting = true;
        adjustResult = null;
        StateHasChanged();
        try
        {
            var dto = new BulkPriceAdjustDto
            {
                AdjustmentType = adjustType,
                Value = adjustValue,
                ServiceTypeId = string.IsNullOrEmpty(adjustServiceId) ? null : int.Parse(adjustServiceId)
            };
            var response = await Http.PostAsJsonAsync("api/service-subscriptions/adjust-prices", dto);
            if (response.IsSuccessStatusCode)
            {
                adjustResult = await response.Content.ReadFromJsonAsync<BulkPriceAdjustResultDto>();
                Toast.ShowSuccess($"{adjustResult?.AffectedCount} abonelik guncellendi.");
                await LoadSummary();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(error?.Message ?? "Islem basarisiz.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
        finally { isAdjusting = false; }
    }

    private async Task GenerateBilling()
    {
        isGenerating = true;
        StateHasChanged();
        try
        {
            var response = await Http.PostAsync($"api/service-billing/generate?year={billingYear}&month={billingMonth}", null);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<GenerateResult>();
                Toast.ShowSuccess(result?.Message ?? "Faturalar olusturuldu.");
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(error?.Message ?? "Islem basarisiz.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
        finally { isGenerating = false; }
    }

    private record ErrorMsg(string? Message);
    private record GenerateResult(int Created, string? Message);
}
