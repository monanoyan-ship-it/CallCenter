@page "/admin/kvkk/consents"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums

<PageTitle>Riza Yonetimi - Call Center</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-file-earmark-check me-2 text-primary"></i>Riza Yonetimi
    </h4>
    <button class="btn btn-primary btn-sm" @onclick="() => showForm = true">
        <i class="bi bi-plus-lg me-1"></i>Yeni Riza
    </button>
</div>

@* ─── FİLTRELER ─── *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <select class="form-select form-select-sm" @bind="filterTypeId" @bind:after="LoadData">
                    <option value="0">Tum Tipler</option>
                    @foreach (var t in ConsentTypes.All)
                    {
                        <option value="@t.Id">@t.Description</option>
                    }
                </select>
            </div>
        </div>
    </div>
</div>

@* ─── TABLO ─── *@
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
        }
        else if (items.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-1 d-block mb-2 opacity-25"></i>
                <span>Riza kaydi bulunamadi</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Kisi</th>
                            <th>Tanimlayici</th>
                            <th>Tip</th>
                            <th>Yontem</th>
                            <th>Durum</th>
                            <th>Tarih</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in items)
                        {
                            <tr>
                                <td>@c.SubjectName</td>
                                <td><small class="text-muted">@c.SubjectIdentifier</small></td>
                                <td>@c.ConsentTypeName</td>
                                <td><small>@c.ConsentMethod</small></td>
                                <td>
                                    <span class="badge @GetStatusBadge(c.StatusId)">@c.StatusName</span>
                                </td>
                                <td><small>@c.ConsentDate.ToString("dd.MM.yyyy")</small></td>
                                <td>
                                    @if (c.StatusId == ConsentStatuses.Ids.Granted)
                                    {
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => RevokeConsent(c)">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white border-top d-flex justify-content-between">
                <small class="text-muted">Toplam: @totalCount kayit</small>
                <div>
                    <button class="btn btn-sm btn-outline-secondary me-1" disabled="@(currentPage <= 1)" @onclick="() => ChangePage(-1)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span class="small">@currentPage / @totalPages</span>
                    <button class="btn btn-sm btn-outline-secondary ms-1" disabled="@(currentPage >= totalPages)" @onclick="() => ChangePage(1)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@* ─── YENİ RIZA FORMU MODAL ─── *@
@if (showForm)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Yeni Riza Kaydi</h5>
                    <button type="button" class="btn-close" @onclick="() => showForm = false"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="createDto" OnValidSubmit="SubmitConsent">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Kisi Adi</label>
                            <InputText class="form-control form-control-sm" @bind-Value="createDto.SubjectName" />
                            <ValidationMessage For="() => createDto.SubjectName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Tanimlayici (TC/Tel)</label>
                            <InputText class="form-control form-control-sm" @bind-Value="createDto.SubjectIdentifier" />
                            <ValidationMessage For="() => createDto.SubjectIdentifier" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Riza Tipi</label>
                            <InputSelect class="form-select form-select-sm" @bind-Value="createDto.ConsentTypeId">
                                <option value="0">Secin...</option>
                                @foreach (var t in ConsentTypes.All)
                                {
                                    <option value="@t.Id">@t.Description</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Yontem</label>
                            <InputSelect class="form-select form-select-sm" @bind-Value="createDto.ConsentMethod">
                                <option value="">Secin...</option>
                                <option value="IVR">IVR</option>
                                <option value="Written">Yazili</option>
                                <option value="Digital">Dijital</option>
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Yasal Dayanak</label>
                            <InputText class="form-control form-control-sm" @bind-Value="createDto.LegalBasis" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Not</label>
                            <InputTextArea class="form-control form-control-sm" @bind-Value="createDto.Notes" rows="2" />
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => showForm = false">Iptal</button>
                            <button type="submit" class="btn btn-primary btn-sm" disabled="@isSaving">
                                @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Kaydet
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ConsentRecordDto> items = new();
    private bool isLoading = true;
    private bool showForm;
    private bool isSaving;
    private int currentPage = 1;
    private int totalCount;
    private int totalPages;
    private int filterTypeId;
    private ConsentCreateDto createDto = new() { CustomerId = 1, StatusId = 2 };

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            var url = $"api/kvkk/consents?page={currentPage}&pageSize=20";
            var result = await Http.GetFromJsonAsync<PagedResponse<ConsentRecordDto>>(url);
            if (result != null)
            {
                items = result.Items;
                totalCount = result.TotalCount;
                totalPages = result.TotalPages;
            }
        }
        catch (Exception ex) { Toast.ShowError($"Veri yuklenemedi: {ex.Message}"); }
        finally { isLoading = false; }
    }

    private async Task SubmitConsent()
    {
        isSaving = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/kvkk/consents", createDto);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Riza kaydi olusturuldu.");
                showForm = false;
                createDto = new() { CustomerId = 1, StatusId = 2 };
                await LoadData();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Toast.ShowError($"Hata: {err}");
            }
        }
        catch (Exception ex) { Toast.ShowError(ex.Message); }
        finally { isSaving = false; }
    }

    private async Task RevokeConsent(ConsentRecordDto consent)
    {
        var dto = new ConsentRevokeDto { RevokedBy = "Admin" };
        var response = await Http.PostAsJsonAsync($"api/kvkk/consents/{consent.Uid}/revoke", dto);
        if (response.IsSuccessStatusCode)
        {
            Toast.ShowSuccess("Riza iptal edildi.");
            await LoadData();
        }
        else Toast.ShowError("Iptal basarisiz.");
    }

    private async Task ChangePage(int delta)
    {
        currentPage += delta;
        await LoadData();
    }

    private static string GetStatusBadge(int statusId) => statusId switch
    {
        1 => "bg-warning text-dark",
        2 => "bg-success",
        3 => "bg-danger",
        4 => "bg-secondary",
        _ => "bg-secondary"
    };

    private record PagedResponse<T>(List<T> Items, int TotalCount, int TotalPages);
}
