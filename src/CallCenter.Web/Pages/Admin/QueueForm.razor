@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs

@if (isVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi @(isEditMode ? "bi-pencil" : "bi-diagram-3") me-2"></i>
                        @(isEditMode ? "Kuyruk Duzenle" : "Yeni Kuyruk")
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <EditForm Model="@createModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger py-2 small">@errorMessage</div>
                        }

                        <div class="mb-3">
                            <label class="form-label small">Kuyruk Adi</label>
                            <InputText class="form-control form-control-sm" @bind-Value="createModel.Name" />
                            <ValidationMessage For="@(() => createModel.Name)" />
                        </div>

                        @if (!isEditMode)
                        {
                            <div class="mb-3">
                                <label class="form-label small">Firma</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="createModel.CustomerId">
                                    <option value="0">-- Firma Sec --</option>
                                    @foreach (var c in Customers)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => createModel.CustomerId)" />
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label small">Aciklama</label>
                            <InputTextArea class="form-control form-control-sm" @bind-Value="createModel.Description" rows="2" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small">Maks Bekleme Suresi (saniye)</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="createModel.MaxWaitTimeSeconds" />
                        </div>

                        @if (isEditMode)
                        {
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="isActive" />
                                <label class="form-check-label small">Aktif</label>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="Close">Iptal</button>
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-check-lg me-1"></i>Kaydet
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public List<CustomerSimpleDto> Customers { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool isVisible;
    private bool isEditMode;
    private bool isSaving;
    private string? errorMessage;
    private int editQueueId;
    private bool isActive = true;

    private QueueCreateDto createModel = new();

    public void OpenForCreate()
    {
        isEditMode = false;
        createModel = new() { MaxWaitTimeSeconds = 300 };
        isActive = true;
        errorMessage = null;
        isVisible = true;
        StateHasChanged();
    }

    public void OpenForEdit(QueueListDto queue)
    {
        isEditMode = true;
        editQueueId = queue.Id;
        createModel = new()
        {
            Name = queue.Name,
            Description = queue.Description,
            MaxWaitTimeSeconds = queue.MaxWaitTimeSeconds,
            CustomerId = queue.CustomerId
        };
        isActive = queue.IsActive;
        errorMessage = null;
        isVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        isVisible = false;
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            HttpResponseMessage response;

            if (isEditMode)
            {
                var updateDto = new QueueUpdateDto
                {
                    Name = createModel.Name,
                    Description = createModel.Description,
                    MaxWaitTimeSeconds = createModel.MaxWaitTimeSeconds,
                    IsActive = isActive
                };
                response = await Http.PutAsJsonAsync($"api/queues/{editQueueId}", updateDto);
            }
            else
            {
                if (createModel.CustomerId <= 0)
                {
                    errorMessage = "Firma secimi zorunludur.";
                    return;
                }
                response = await Http.PostAsJsonAsync("api/queues", createModel);
            }

            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess(isEditMode ? "Kuyruk guncellendi." : "Kuyruk olusturuldu.");
                isVisible = false;
                await OnSaved.InvokeAsync();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                errorMessage = error?.Message ?? "Islem basarisiz.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Hata: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private record ErrorMsg(string? Message);
}
