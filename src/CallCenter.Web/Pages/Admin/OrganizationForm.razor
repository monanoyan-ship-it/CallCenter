@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums

@if (isVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-diagram-3-fill me-2"></i>
                        @(isEdit ? "Birim Duzenle" : "Yeni Birim")
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <EditForm Model="model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label">Birim Adi <span class="text-danger">*</span></label>
                                <InputText class="form-control form-control-sm" @bind-Value="model.Name" />
                                <ValidationMessage For="() => model.Name" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Kod</label>
                                <InputText class="form-control form-control-sm" @bind-Value="model.Code" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Birim Tipi <span class="text-danger">*</span></label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="model.TypeId">
                                    @foreach (var t in OrganizationUnitTypes.All)
                                    {
                                        <option value="@t.Id">@t.Description</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Ust Birim</label>
                                <SearchableSelect Items="parentItems" Value="@parentIdStr"
                                                  ValueChanged="OnParentSelected" Placeholder="-- Kok birim (ust yok) --" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Yonetici</label>
                                <SearchableSelect Items="managerItems" Value="@managerIdStr"
                                                  ValueChanged="OnManagerSelected" Placeholder="-- Yonetici yok --" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Sira</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="model.DisplayOrder" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Telefon</label>
                                <InputText class="form-control form-control-sm" @bind-Value="model.Phone" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">E-posta</label>
                                <InputText class="form-control form-control-sm" @bind-Value="model.Email" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Adres</label>
                                <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="model.Address" />
                            </div>
                            @if (isEdit)
                            {
                                <div class="col-12">
                                    <div class="form-check">
                                        <InputCheckbox class="form-check-input" @bind-Value="model.IsActive" />
                                        <label class="form-check-label">Aktif</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="Close">Iptal</button>
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @(isEdit ? "Guncelle" : "Olustur")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int CustomerId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private FormModel model = new();
    private bool isVisible;
    private bool isEdit;
    private bool isSaving;
    private int? editId;
    private List<OrgUnitListDto>? potentialParents;
    private List<PortalPersonnelListDto>? personnel;

    private string parentIdStr => model.ParentId?.ToString() ?? "";
    private string managerIdStr => model.ManagerPersonnelId?.ToString() ?? "";

    private List<SearchableSelect.SearchSelectItem> parentItems =>
        potentialParents?.Select(p => new SearchableSelect.SearchSelectItem(p.Id.ToString(), p.Name, p.ParentName)).ToList() ?? new();

    private List<SearchableSelect.SearchSelectItem> managerItems =>
        personnel?.Select(p => new SearchableSelect.SearchSelectItem(p.Id.ToString(), p.FullName)).ToList() ?? new();

    public async void OpenForCreate(int? defaultParentId = null)
    {
        isEdit = false;
        editId = null;
        model = new FormModel { TypeId = OrganizationUnitTypes.Ids.Branch, ParentId = defaultParentId };
        await LoadDropdowns(null);
        isVisible = true;
        StateHasChanged();
    }

    public async void OpenForEdit(OrgUnitDetailDto detail)
    {
        isEdit = true;
        editId = detail.Id;
        model = new FormModel
        {
            Name = detail.Name,
            Code = detail.Code,
            TypeId = detail.TypeId,
            ParentId = detail.ParentId,
            Address = detail.Address,
            Phone = detail.Phone,
            Email = detail.Email,
            ManagerPersonnelId = detail.ManagerPersonnelId,
            DisplayOrder = detail.DisplayOrder,
            IsActive = detail.IsActive
        };
        await LoadDropdowns(detail.Id);
        isVisible = true;
        StateHasChanged();
    }

    private async Task LoadDropdowns(int? excludeId)
    {
        try
        {
            var parentUrl = $"api/organizations/parents?customerId={CustomerId}";
            if (excludeId.HasValue) parentUrl += $"&excludeId={excludeId}";
            potentialParents = await Http.GetFromJsonAsync<List<OrgUnitListDto>>(parentUrl);

            personnel = await Http.GetFromJsonAsync<List<PortalPersonnelListDto>>($"api/portal/personnel?customerId={CustomerId}");
        }
        catch { }
    }

    private void OnParentSelected(string? val)
    {
        model.ParentId = int.TryParse(val, out var id) ? id : null;
    }

    private void OnManagerSelected(string? val)
    {
        model.ManagerPersonnelId = int.TryParse(val, out var id) ? id : null;
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        StateHasChanged();

        try
        {
            HttpResponseMessage response;
            if (isEdit)
            {
                var dto = new OrgUnitUpdateDto
                {
                    Name = model.Name,
                    Code = model.Code,
                    TypeId = model.TypeId,
                    ParentId = model.ParentId,
                    Address = model.Address,
                    Phone = model.Phone,
                    Email = model.Email,
                    ManagerPersonnelId = model.ManagerPersonnelId,
                    DisplayOrder = model.DisplayOrder,
                    IsActive = model.IsActive
                };
                response = await Http.PutAsJsonAsync($"api/organizations/{editId}?customerId={CustomerId}", dto);
            }
            else
            {
                var dto = new OrgUnitCreateDto
                {
                    Name = model.Name,
                    Code = model.Code,
                    TypeId = model.TypeId,
                    ParentId = model.ParentId,
                    Address = model.Address,
                    Phone = model.Phone,
                    Email = model.Email,
                    ManagerPersonnelId = model.ManagerPersonnelId,
                    DisplayOrder = model.DisplayOrder
                };
                response = await Http.PostAsJsonAsync($"api/organizations?customerId={CustomerId}", dto);
            }

            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess(isEdit ? "Birim guncellendi." : "Birim olusturuldu.");
                Close();
                await OnSaved.InvokeAsync();
            }
            else
            {
                var err = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                Toast.ShowError(err?.Error ?? "Islem basarisiz.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Hata: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Close()
    {
        isVisible = false;
    }

    private class FormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Code { get; set; }
        public int TypeId { get; set; }
        public int? ParentId { get; set; }
        public string? Address { get; set; }
        public string? Phone { get; set; }
        public string? Email { get; set; }
        public int? ManagerPersonnelId { get; set; }
        public int DisplayOrder { get; set; }
        public bool IsActive { get; set; } = true;
    }

    private record ErrorResponse(string? Error);
}
