@page "/admin/billing-report"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject NavigationManager Nav
@inject ToastService Toast
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums

<PageTitle>Faturalama Raporu - CorpLynk</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-receipt me-2 text-primary"></i>Faturalama Raporu
    </h4>
</div>

@* ─── FİLTRELER ─── *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small mb-0">Yil</label>
                <input type="number" class="form-control form-control-sm" @bind="filterYear" min="2020" max="2100" />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-0">Ay</label>
                <select class="form-select form-select-sm" @bind="filterMonth">
                    <option value="">Tumu</option>
                    <option value="1">Ocak</option>
                    <option value="2">Subat</option>
                    <option value="3">Mart</option>
                    <option value="4">Nisan</option>
                    <option value="5">Mayis</option>
                    <option value="6">Haziran</option>
                    <option value="7">Temmuz</option>
                    <option value="8">Agustos</option>
                    <option value="9">Eylul</option>
                    <option value="10">Ekim</option>
                    <option value="11">Kasim</option>
                    <option value="12">Aralik</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-0">Durum</label>
                <select class="form-select form-select-sm" @bind="filterStatusId">
                    <option value="">Tumu</option>
                    <option value="1">Tahakkuk</option>
                    <option value="2">Faturalanmis</option>
                    <option value="3">Odenmis</option>
                    <option value="4">Gecikme</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary btn-sm w-100" @onclick="LoadReport" disabled="@isLoading">
                    <i class="bi bi-search me-1"></i>Filtrele
                </button>
            </div>
            @if (selectedIds.Count > 0)
            {
                <div class="col-md-4 d-flex gap-2 justify-content-end">
                    <button class="btn btn-info btn-sm" @onclick="BulkInvoice" disabled="@isBulkUpdating">
                        <i class="bi bi-receipt me-1"></i>Faturala (@selectedIds.Count)
                    </button>
                    <button class="btn btn-success btn-sm" @onclick="BulkPaid" disabled="@isBulkUpdating">
                        <i class="bi bi-check-lg me-1"></i>Odendi (@selectedIds.Count)
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@* ─── TABLO ─── *@
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else if (report == null || report.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-receipt fs-1 d-block mb-2 opacity-25"></i>
                <span>Kayit bulunamadi</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:30px;">
                                <input type="checkbox" class="form-check-input" @onchange="ToggleAll" />
                            </th>
                            <th>Firma</th>
                            <th>Donem</th>
                            <th>Donem Tarihi</th>
                            <th class="text-end">Operator Tutari</th>
                            <th class="text-end">Hizmet Tutari</th>
                            <th class="text-end">Toplam</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in report)
                        {
                            <tr class="@GetRowClass(r.StatusId)">
                                <td>
                                    <input type="checkbox" class="form-check-input"
                                           checked="@selectedIds.Contains(r.PeriodId)"
                                           @onchange="() => ToggleSelect(r.PeriodId)" />
                                </td>
                                <td class="fw-medium">@r.CustomerName</td>
                                <td>@r.Month.ToString("00")/@r.Year</td>
                                <td class="small text-muted">@r.PeriodStartDate.ToString("dd.MM.yyyy") — @r.PeriodEndDate.ToString("dd.MM.yyyy")</td>
                                <td class="text-end">@r.Amount.ToString("N2") TL</td>
                                <td class="text-end">
                                    @if (r.ServiceAmount > 0)
                                    {
                                        @r.ServiceAmount.ToString("N2") <span>TL</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end fw-semibold">@r.TotalAmount.ToString("N2") TL</td>
                                <td>
                                    @{var badge = GetBadge(r.StatusId);}
                                    <span class="badge @badge.Css">@badge.Text</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr class="fw-bold">
                            <td colspan="4">Toplam</td>
                            <td class="text-end">@report.Sum(r => r.Amount).ToString("N2") TL</td>
                            <td class="text-end">@report.Sum(r => r.ServiceAmount).ToString("N2") TL</td>
                            <td class="text-end">@report.Sum(r => r.TotalAmount).ToString("N2") TL</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<BillingReportDto>? report;
    private bool isLoading;
    private bool isBulkUpdating;
    private int filterYear = DateTime.Now.Year;
    private string filterMonth = DateTime.Now.Month.ToString();
    private string filterStatusId = "";
    private HashSet<int> selectedIds = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadReport();
    }

    private async Task LoadReport()
    {
        isLoading = true;
        selectedIds.Clear();
        StateHasChanged();
        try
        {
            var url = $"api/billing/report?year={filterYear}";
            if (!string.IsNullOrEmpty(filterMonth))
                url += $"&month={filterMonth}";
            if (!string.IsNullOrEmpty(filterStatusId))
                url += $"&statusId={filterStatusId}";

            report = await Http.GetFromJsonAsync<List<BillingReportDto>>(url);
        }
        catch (Exception ex) { Toast.ShowError($"Rapor yuklenemedi: {ex.Message}"); }
        finally { isLoading = false; }
    }

    private void ToggleSelect(int periodId)
    {
        if (!selectedIds.Remove(periodId))
            selectedIds.Add(periodId);
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        if (report == null) return;
        if ((bool)(e.Value ?? false))
            selectedIds = new HashSet<int>(report.Select(r => r.PeriodId));
        else
            selectedIds.Clear();
    }

    private async Task BulkInvoice() => await BulkUpdateStatus(BillingPeriodStatuses.Ids.Invoiced);
    private async Task BulkPaid() => await BulkUpdateStatus(BillingPeriodStatuses.Ids.Paid);

    private async Task BulkUpdateStatus(int statusId)
    {
        isBulkUpdating = true;
        StateHasChanged();
        var count = 0;
        try
        {
            foreach (var id in selectedIds.ToList())
            {
                var dto = new BillingPeriodUpdateDto { StatusId = statusId };
                var response = await Http.PutAsJsonAsync($"api/customers/billing/{id}", dto);
                if (response.IsSuccessStatusCode) count++;
            }
            Toast.ShowSuccess($"{count} donem guncellendi.");
            await LoadReport();
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
        finally { isBulkUpdating = false; }
    }

    private static string GetRowClass(int statusId) => statusId switch
    {
        BillingPeriodStatuses.Ids.Draft => "table-warning",
        BillingPeriodStatuses.Ids.Invoiced => "table-info",
        BillingPeriodStatuses.Ids.Overdue => "table-danger",
        _ => ""
    };

    private static (string Css, string Text) GetBadge(int statusId) => statusId switch
    {
        BillingPeriodStatuses.Ids.Draft => ("bg-warning-subtle text-warning", "Tahakkuk"),
        BillingPeriodStatuses.Ids.Invoiced => ("bg-info-subtle text-info", "Faturalanmis"),
        BillingPeriodStatuses.Ids.Paid => ("bg-success-subtle text-success", "Odenmis"),
        BillingPeriodStatuses.Ids.Overdue => ("bg-danger-subtle text-danger", "Gecikme"),
        _ => ("bg-secondary", "?")
    };
}
