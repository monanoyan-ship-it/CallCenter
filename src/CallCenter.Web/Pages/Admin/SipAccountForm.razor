@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs

@if (isVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi @(isEditMode ? "bi-pencil" : "bi-router") me-2"></i>
                        @(isEditMode ? "SIP Hesabi Duzenle" : "Yeni SIP Hesabi")
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger py-2 small">@errorMessage</div>
                        }

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small">Hesap Adi</label>
                                <InputText class="form-control form-control-sm" @bind-Value="model.Name" />
                                <ValidationMessage For="@(() => model.Name)" />
                            </div>
                            @if (!isEditMode)
                            {
                                <div class="col-md-6">
                                    <label class="form-label small">Firma</label>
                                    <SearchableSelect Items="customerItems" Value="@customerIdStr"
                                                      ValueChanged="OnCustomerSelected" Placeholder="-- Firma Sec --" />
                                    <ValidationMessage For="@(() => model.CustomerId)" />
                                </div>
                            }
                            else
                            {
                                <div class="col-md-6"></div>
                            }
                        </div>

                        <hr class="my-3" />
                        <h6 class="small text-muted mb-3"><i class="bi bi-hdd-network me-1"></i>Sunucu Bilgileri</h6>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small">Sunucu Adresi</label>
                                <InputText class="form-control form-control-sm" @bind-Value="model.Server" placeholder="sip.example.com" />
                                <ValidationMessage For="@(() => model.Server)" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Port</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="model.Port" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Transport</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="model.Transport">
                                    <option value="UDP">UDP</option>
                                    <option value="TCP">TCP</option>
                                    <option value="TLS">TLS</option>
                                    <option value="WSS">WSS</option>
                                </InputSelect>
                            </div>
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                <label class="form-label small">Domain</label>
                                <InputText class="form-control form-control-sm" @bind-Value="model.Domain" placeholder="(opsiyonel)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">WebSocket URI</label>
                                <InputText class="form-control form-control-sm" @bind-Value="model.WsUri" placeholder="wss://sip.example.com:8089/ws" />
                                <div class="form-text small">Bos birakilirsa otomatik olusturulur: wss://sunucu:8089/ws</div>
                            </div>
                        </div>

                        <hr class="my-3" />

                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="model.UseSrtp" />
                                    <label class="form-check-label small">SRTP Kullan</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="model.IsDefault" />
                                    <label class="form-check-label small">Varsayilan Hesap</label>
                                </div>
                            </div>
                            @if (isEditMode)
                            {
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <InputCheckbox class="form-check-input" @bind-Value="isActive" />
                                        <label class="form-check-label small">Aktif</label>
                                    </div>
                                </div>
                            }
                        </div>

                        @* ─── HATLAR (Lines) ─── *@
                        <hr class="my-3" />
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="small text-muted mb-0"><i class="bi bi-telephone me-1"></i>Hatlar</h6>
                            @if (!isEditMode)
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddNewLine">
                                    <i class="bi bi-plus-lg me-1"></i>Hat Ekle
                                </button>
                            }
                        </div>

                        @if (!isEditMode)
                        {
                            @* CREATE MODE: Lines inline with gateway *@
                            @if (newLines.Count == 0)
                            {
                                <div class="text-center text-muted py-3 border rounded">
                                    <i class="bi bi-telephone-x d-block mb-1 opacity-25"></i>
                                    <small>Henuz hat eklenmedi. "Hat Ekle" ile hat ekleyebilirsiniz.</small>
                                </div>
                            }
                            else
                            {
                                @for (int i = 0; i < newLines.Count; i++)
                                {
                                    var idx = i;
                                    <div class="border rounded p-2 mb-2">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <small class="fw-medium text-muted">Hat @(idx + 1)</small>
                                            <button type="button" class="btn btn-outline-danger btn-sm py-0 px-1"
                                                    @onclick="() => RemoveNewLine(idx)" title="Kaldir">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                        <div class="row g-2">
                                            <div class="col-md-2">
                                                <label class="form-label small">Kanal No</label>
                                                <input type="number" class="form-control form-control-sm"
                                                       @bind="newLines[idx].ChannelNumber" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small">Kullanici Adi</label>
                                                <input type="text" class="form-control form-control-sm"
                                                       @bind="newLines[idx].Username" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small">Sifre</label>
                                                <input type="password" class="form-control form-control-sm"
                                                       @bind="newLines[idx].Password" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small">Aciklama</label>
                                                <input type="text" class="form-control form-control-sm"
                                                       @bind="newLines[idx].Description" placeholder="(opsiyonel)" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            @* EDIT MODE: Lines managed via separate API *@
                            <div class="d-flex justify-content-end mb-2">
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="OpenAddLineModal">
                                    <i class="bi bi-plus-lg me-1"></i>Hat Ekle
                                </button>
                            </div>

                            @if (isLoadingLines)
                            {
                                <div class="text-center py-3">
                                    <div class="spinner-border spinner-border-sm text-primary"></div>
                                </div>
                            }
                            else if (existingLines.Count == 0)
                            {
                                <div class="text-center text-muted py-3 border rounded">
                                    <i class="bi bi-telephone-x d-block mb-1 opacity-25"></i>
                                    <small>Bu gateway'e ait hat bulunamadi.</small>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="small">Kanal</th>
                                                <th class="small">Kullanici Adi</th>
                                                <th class="small">Aciklama</th>
                                                <th class="small text-center">Durum</th>
                                                <th style="width: 80px;"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var line in existingLines)
                                            {
                                                <tr class="@(!line.IsActive ? "table-secondary" : "")">
                                                    <td class="small">@line.ChannelNumber</td>
                                                    <td class="small">@line.Username</td>
                                                    <td class="small text-muted">@(line.Description ?? "-")</td>
                                                    <td class="text-center">
                                                        @if (line.IsActive)
                                                        {
                                                            <span class="badge bg-success-subtle text-success">Aktif</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary-subtle text-secondary">Pasif</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <button type="button" class="btn btn-outline-primary btn-sm py-0 px-1 me-1"
                                                                title="Duzenle" @onclick="() => OpenEditLineModal(line)">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-danger btn-sm py-0 px-1"
                                                                title="Sil" @onclick="() => DeleteLine(line)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="Close">Iptal</button>
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-check-lg me-1"></i>Kaydet
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@* ─── ADD/EDIT LINE MODAL (Edit mode only) ─── *@
@if (showLineModal)
{
    <div class="modal-backdrop fade show" style="z-index: 1060;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1065;">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title small">
                        <i class="bi @(editingLineId.HasValue ? "bi-pencil" : "bi-plus-circle") me-1"></i>
                        @(editingLineId.HasValue ? "Hat Duzenle" : "Yeni Hat")
                    </h6>
                    <button type="button" class="btn-close btn-close-sm" @onclick="CloseLineModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(lineError))
                    {
                        <div class="alert alert-danger py-1 small">@lineError</div>
                    }
                    <div class="mb-2">
                        <label class="form-label small">Kanal No</label>
                        <input type="number" class="form-control form-control-sm" @bind="lineFormChannel" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Kullanici Adi</label>
                        <input type="text" class="form-control form-control-sm" @bind="lineFormUsername" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">
                            Sifre
                            @if (editingLineId.HasValue)
                            {
                                <span class="text-muted">(bos birakirsaniz degismez)</span>
                            }
                        </label>
                        <input type="password" class="form-control form-control-sm" @bind="lineFormPassword" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Aciklama</label>
                        <input type="text" class="form-control form-control-sm" @bind="lineFormDescription" placeholder="(opsiyonel)" />
                    </div>
                    @if (editingLineId.HasValue)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="lineFormIsActive" />
                            <label class="form-check-label small">Aktif</label>
                        </div>
                    }
                </div>
                <div class="modal-footer py-1">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseLineModal">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveLine" disabled="@isSavingLine">
                        @if (isSavingLine)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-check-lg me-1"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public List<CustomerSimpleDto> Customers { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool isVisible;
    private bool isEditMode;
    private bool isSaving;
    private string? errorMessage;
    private int editSipId;
    private bool isActive = true;

    private SipAccountCreateDto model = new();

    // Create mode: inline lines
    private List<SipLineCreateDto> newLines = new();

    // Edit mode: existing lines from API
    private List<SipLineListDto> existingLines = new();
    private bool isLoadingLines;

    // Line modal (edit mode)
    private bool showLineModal;
    private bool isSavingLine;
    private string? lineError;
    private int? editingLineId;
    private int lineFormChannel = 1;
    private string lineFormUsername = "";
    private string lineFormPassword = "";
    private string? lineFormDescription;
    private bool lineFormIsActive = true;

    private List<SearchableSelect.SearchSelectItem> customerItems =>
        Customers.Select(c => new SearchableSelect.SearchSelectItem(c.Id.ToString(), c.Name)).ToList();

    private string customerIdStr => model.CustomerId > 0 ? model.CustomerId.ToString() : "";

    private void OnCustomerSelected(string? val)
    {
        model.CustomerId = int.TryParse(val, out var id) ? id : 0;
    }

    public void OpenForCreate()
    {
        isEditMode = false;
        model = new() { Port = 5060, Transport = "UDP" };
        newLines = new();
        isActive = true;
        errorMessage = null;
        isVisible = true;
        StateHasChanged();
    }

    public async void OpenForEdit(SipAccountListDto sip)
    {
        isEditMode = true;
        editSipId = sip.Id;
        model = new()
        {
            Name = sip.Name,
            Server = sip.Server,
            Port = sip.Port,
            Transport = sip.Transport ?? "UDP",
            WsUri = sip.WsUri,
            IsDefault = sip.IsDefault,
            CustomerId = sip.CustomerId
        };
        isActive = sip.IsActive;
        errorMessage = null;
        existingLines = new();
        isVisible = true;
        StateHasChanged();

        await LoadLines();
    }

    private async Task LoadLines()
    {
        isLoadingLines = true;
        StateHasChanged();
        try
        {
            var lines = await Http.GetFromJsonAsync<List<SipLineListDto>>($"api/sipaccounts/{editSipId}/lines");
            existingLines = lines ?? new();
        }
        catch { }
        finally
        {
            isLoadingLines = false;
            StateHasChanged();
        }
    }

    private void Close()
    {
        isVisible = false;
    }

    // ─── Create mode: inline line management ───
    private void AddNewLine()
    {
        var nextChannel = newLines.Count > 0 ? newLines.Max(l => l.ChannelNumber) + 1 : 1;
        newLines.Add(new SipLineCreateDto { ChannelNumber = nextChannel });
    }

    private void RemoveNewLine(int index)
    {
        if (index >= 0 && index < newLines.Count)
            newLines.RemoveAt(index);
    }

    // ─── Edit mode: line modal ───
    private void OpenAddLineModal()
    {
        editingLineId = null;
        var nextChannel = existingLines.Count > 0 ? existingLines.Max(l => l.ChannelNumber) + 1 : 1;
        lineFormChannel = nextChannel;
        lineFormUsername = "";
        lineFormPassword = "";
        lineFormDescription = null;
        lineFormIsActive = true;
        lineError = null;
        showLineModal = true;
    }

    private void OpenEditLineModal(SipLineListDto line)
    {
        editingLineId = line.Id;
        lineFormChannel = line.ChannelNumber;
        lineFormUsername = line.Username;
        lineFormPassword = "";
        lineFormDescription = line.Description;
        lineFormIsActive = line.IsActive;
        lineError = null;
        showLineModal = true;
    }

    private void CloseLineModal()
    {
        showLineModal = false;
    }

    private async Task SaveLine()
    {
        if (string.IsNullOrWhiteSpace(lineFormUsername))
        {
            lineError = "Kullanici adi zorunludur.";
            return;
        }

        isSavingLine = true;
        lineError = null;

        try
        {
            HttpResponseMessage response;

            if (editingLineId.HasValue)
            {
                var dto = new SipLineUpdateDto
                {
                    ChannelNumber = lineFormChannel,
                    Username = lineFormUsername,
                    Password = string.IsNullOrWhiteSpace(lineFormPassword) ? null : lineFormPassword,
                    Description = lineFormDescription,
                    IsActive = lineFormIsActive
                };
                response = await Http.PutAsJsonAsync($"api/sipaccounts/lines/{editingLineId.Value}", dto);
            }
            else
            {
                if (string.IsNullOrWhiteSpace(lineFormPassword))
                {
                    lineError = "Sifre zorunludur.";
                    isSavingLine = false;
                    return;
                }
                var dto = new SipLineCreateDto
                {
                    ChannelNumber = lineFormChannel,
                    Username = lineFormUsername,
                    Password = lineFormPassword,
                    Description = lineFormDescription
                };
                response = await Http.PostAsJsonAsync($"api/sipaccounts/{editSipId}/lines", dto);
            }

            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess(editingLineId.HasValue ? "Hat guncellendi." : "Hat eklendi.");
                showLineModal = false;
                await LoadLines();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                lineError = error?.Message ?? "Islem basarisiz.";
            }
        }
        catch (Exception ex)
        {
            lineError = $"Hata: {ex.Message}";
        }
        finally
        {
            isSavingLine = false;
        }
    }

    private async Task DeleteLine(SipLineListDto line)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/sipaccounts/lines/{line.Id}");
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Hat silindi.");
                await LoadLines();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(error?.Message ?? "Silme basarisiz.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Hata: {ex.Message}");
        }
    }

    // ─── Gateway save ───
    private async Task HandleSubmit()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            HttpResponseMessage response;

            if (isEditMode)
            {
                var updateDto = new SipAccountUpdateDto
                {
                    Name = model.Name,
                    Server = model.Server,
                    Port = model.Port,
                    Domain = model.Domain,
                    Transport = model.Transport,
                    WsUri = string.IsNullOrWhiteSpace(model.WsUri) ? null : model.WsUri,
                    UseSrtp = model.UseSrtp,
                    IsDefault = model.IsDefault,
                    IsActive = isActive
                };
                response = await Http.PutAsJsonAsync($"api/sipaccounts/{editSipId}", updateDto);
            }
            else
            {
                if (model.CustomerId <= 0)
                {
                    errorMessage = "Firma secimi zorunludur.";
                    return;
                }
                model.Lines = newLines.Count > 0 ? newLines : null;
                response = await Http.PostAsJsonAsync("api/sipaccounts", model);
            }

            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess(isEditMode ? "SIP hesabi guncellendi." : "SIP hesabi olusturuldu.");
                isVisible = false;
                await OnSaved.InvokeAsync();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                errorMessage = error?.Message ?? "Islem basarisiz.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Hata: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private record ErrorMsg(string? Message);
}
