@page "/admin/kvkk/requests"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums

<PageTitle>Basvuru Yonetimi - Call Center</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-envelope-paper me-2 text-primary"></i>Ilgili Kisi Basvurulari
    </h4>
    <button class="btn btn-primary btn-sm" @onclick="() => showForm = true">
        <i class="bi bi-plus-lg me-1"></i>Yeni Basvuru
    </button>
</div>

@* ─── FİLTRELER ─── *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <select class="form-select form-select-sm" @bind="filterStatusId" @bind:after="LoadData">
                    <option value="0">Tum Durumlar</option>
                    @foreach (var s in DataSubjectRequestStatuses.All)
                    {
                        <option value="@s.Id">@s.Description</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button class="btn btn-outline-danger btn-sm" @onclick="LoadOverdue">
                    <i class="bi bi-exclamation-triangle me-1"></i>Geciken Basvurular
                </button>
            </div>
        </div>
    </div>
</div>

@* ─── TABLO ─── *@
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
        }
        else if (items.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-1 d-block mb-2 opacity-25"></i>
                <span>Basvuru bulunamadi</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Basvuran</th>
                            <th>Tip</th>
                            <th>Durum</th>
                            <th>Basvuru Tarihi</th>
                            <th>Son Tarih</th>
                            <th>Atanan</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in items)
                        {
                            <tr class="@(r.IsOverdue ? "table-danger" : "")">
                                <td>
                                    <div>@r.RequesterName</div>
                                    <small class="text-muted">@r.RequesterIdentifier</small>
                                </td>
                                <td>@r.RequestTypeName</td>
                                <td>
                                    <span class="badge @GetStatusBadge(r.StatusId)">
                                        @r.StatusName
                                    </span>
                                    @if (r.IsOverdue) { <span class="badge bg-danger ms-1">Gecikti</span> }
                                </td>
                                <td><small>@r.RequestDate.ToString("dd.MM.yyyy")</small></td>
                                <td><small>@r.Deadline.ToString("dd.MM.yyyy")</small></td>
                                <td><small>@(r.AssignedToUserName ?? "-")</small></td>
                                <td>
                                    @if (r.StatusId != DataSubjectRequestStatuses.Ids.Completed && r.StatusId != DataSubjectRequestStatuses.Ids.Rejected)
                                    {
                                        <div class="btn-group btn-group-sm">
                                            @if (r.StatusId == DataSubjectRequestStatuses.Ids.Received)
                                            {
                                                <button class="btn btn-outline-primary" @onclick="() => UpdateStatus(r, DataSubjectRequestStatuses.Ids.InProgress)">
                                                    <i class="bi bi-play"></i>
                                                </button>
                                            }
                                            <button class="btn btn-outline-success" @onclick="() => UpdateStatus(r, DataSubjectRequestStatuses.Ids.Completed)">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                            <button class="btn btn-outline-danger" @onclick="() => UpdateStatus(r, DataSubjectRequestStatuses.Ids.Rejected)">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white border-top d-flex justify-content-between">
                <small class="text-muted">Toplam: @totalCount kayit</small>
                <div>
                    <button class="btn btn-sm btn-outline-secondary me-1" disabled="@(currentPage <= 1)" @onclick="() => ChangePage(-1)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span class="small">@currentPage / @totalPages</span>
                    <button class="btn btn-sm btn-outline-secondary ms-1" disabled="@(currentPage >= totalPages)" @onclick="() => ChangePage(1)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@* ─── YENİ BAŞVURU FORMU MODAL ─── *@
@if (showForm)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Yeni Ilgili Kisi Basvurusu</h5>
                    <button type="button" class="btn-close" @onclick="() => showForm = false"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="createDto" OnValidSubmit="SubmitRequest">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Basvuran Adi</label>
                                <InputText class="form-control form-control-sm" @bind-Value="createDto.RequesterName" />
                                <ValidationMessage For="() => createDto.RequesterName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Tanimlayici (TC/Tel/Email)</label>
                                <InputText class="form-control form-control-sm" @bind-Value="createDto.RequesterIdentifier" />
                                <ValidationMessage For="() => createDto.RequesterIdentifier" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Iletisim</label>
                                <InputText class="form-control form-control-sm" @bind-Value="createDto.RequesterContact" />
                                <ValidationMessage For="() => createDto.RequesterContact" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Basvuru Tipi</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="createDto.RequestTypeId">
                                    <option value="0">Secin...</option>
                                    @foreach (var t in DataSubjectRequestTypes.All)
                                    {
                                        <option value="@t.Id">@t.Description</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Basvuru Aciklamasi</label>
                                <InputTextArea class="form-control form-control-sm" @bind-Value="createDto.RequestDescription" rows="3" />
                                <ValidationMessage For="() => createDto.RequestDescription" />
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => showForm = false">Iptal</button>
                            <button type="submit" class="btn btn-primary btn-sm" disabled="@isSaving">
                                @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Kaydet
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<DataSubjectRequestDto> items = new();
    private bool isLoading = true;
    private bool showForm;
    private bool isSaving;
    private int currentPage = 1;
    private int totalCount;
    private int totalPages;
    private int filterStatusId;
    private DataSubjectRequestCreateDto createDto = new() { CustomerId = 1 };

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            var url = $"api/kvkk/requests?page={currentPage}&pageSize=20";
            if (filterStatusId > 0) url += $"&status={filterStatusId}";
            var result = await Http.GetFromJsonAsync<PagedResponse<DataSubjectRequestDto>>(url);
            if (result != null)
            {
                items = result.Items;
                totalCount = result.TotalCount;
                totalPages = result.TotalPages;
            }
        }
        catch (Exception ex) { Toast.ShowError($"Veri yuklenemedi: {ex.Message}"); }
        finally { isLoading = false; }
    }

    private async Task LoadOverdue()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            var result = await Http.GetFromJsonAsync<List<DataSubjectRequestDto>>("api/kvkk/requests/overdue");
            if (result != null)
            {
                items = result;
                totalCount = result.Count;
                totalPages = 1;
                currentPage = 1;
            }
        }
        catch (Exception ex) { Toast.ShowError(ex.Message); }
        finally { isLoading = false; }
    }

    private async Task SubmitRequest()
    {
        isSaving = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/kvkk/requests", createDto);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Basvuru olusturuldu.");
                showForm = false;
                createDto = new() { CustomerId = 1 };
                await LoadData();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Toast.ShowError($"Hata: {err}");
            }
        }
        catch (Exception ex) { Toast.ShowError(ex.Message); }
        finally { isSaving = false; }
    }

    private async Task UpdateStatus(DataSubjectRequestDto request, int newStatusId)
    {
        var dto = new DataSubjectRequestUpdateDto { StatusId = newStatusId };
        var response = await Http.PutAsJsonAsync($"api/kvkk/requests/{request.Uid}", dto);
        if (response.IsSuccessStatusCode)
        {
            Toast.ShowSuccess("Basvuru durumu guncellendi.");
            await LoadData();
        }
        else Toast.ShowError("Guncelleme basarisiz.");
    }

    private async Task ChangePage(int delta)
    {
        currentPage += delta;
        await LoadData();
    }

    private static string GetStatusBadge(int statusId) => statusId switch
    {
        1 => "bg-info",
        2 => "bg-warning text-dark",
        3 => "bg-success",
        4 => "bg-danger",
        5 => "bg-danger",
        _ => "bg-secondary"
    };

    private record PagedResponse<T>(List<T> Items, int TotalCount, int TotalPages);
}
