@page "/admin/kvkk/requests"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums

<PageTitle>Basvuru Yonetimi - CorpLynk</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-envelope-paper me-2 text-primary"></i>Ilgili Kisi Basvurulari (KVKK Madde 11)
    </h4>
    <button class="btn btn-primary btn-sm" @onclick="ShowCreateForm">
        <i class="bi bi-plus-lg me-1"></i>Yeni Basvuru
    </button>
</div>

@* ─── FİLTRELER ─── *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-center">
            <div class="col-md-3">
                <select class="form-select form-select-sm" @bind="filterCustomerId" @bind:after="LoadData">
                    <option value="0">Tum Musteriler</option>
                    @foreach (var c in customers)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select form-select-sm" @bind="filterStatusId" @bind:after="LoadData">
                    <option value="0">Tum Durumlar</option>
                    @foreach (var s in DataSubjectRequestStatuses.All)
                    {
                        <option value="@s.Id">@s.Description</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-outline-danger btn-sm" @onclick="LoadOverdue">
                    <i class="bi bi-exclamation-triangle me-1"></i>Geciken Basvurular
                </button>
            </div>
        </div>
    </div>
</div>

@* ─── TABLO ─── *@
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
        }
        else if (items.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-1 d-block mb-2 opacity-25"></i>
                <span>Basvuru bulunamadi</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Basvuran</th>
                            <th>Tip</th>
                            <th>Durum</th>
                            <th>Basvuru Tarihi</th>
                            <th>Son Tarih</th>
                            <th>Kalan</th>
                            <th>Atanan</th>
                            <th style="width:160px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in items)
                        {
                            <tr class="@(r.IsOverdue ? "table-danger" : "")">
                                <td>
                                    <div>@r.RequesterName</div>
                                    <small class="text-muted">@r.RequesterIdentifier</small>
                                </td>
                                <td><small>@r.RequestTypeName</small></td>
                                <td>
                                    <span class="badge @GetStatusBadge(r.StatusId)">@r.StatusName</span>
                                    @if (r.IsOverdue) { <span class="badge bg-danger ms-1">Gecikti!</span> }
                                </td>
                                <td><small>@r.RequestDate.ToString("dd.MM.yyyy")</small></td>
                                <td><small>@r.Deadline.ToString("dd.MM.yyyy")</small></td>
                                <td>
                                    @{
                                        var remaining = (r.Deadline - DateTime.UtcNow).TotalDays;
                                    }
                                    @if (r.StatusId == DataSubjectRequestStatuses.Ids.Completed || r.StatusId == DataSubjectRequestStatuses.Ids.Rejected)
                                    {
                                        <small class="text-muted">-</small>
                                    }
                                    else if (remaining < 0)
                                    {
                                        <small class="text-danger fw-bold">@((int)Math.Abs(remaining)) gun gecikme</small>
                                    }
                                    else
                                    {
                                        <small class="@(remaining < 7 ? "text-warning fw-bold" : "text-muted")">@((int)remaining) gun</small>
                                    }
                                </td>
                                <td><small>@(r.AssignedToUserName ?? "-")</small></td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm me-1" title="Detay" @onclick="() => ShowDetail(r)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    @if (r.StatusId != DataSubjectRequestStatuses.Ids.Completed && r.StatusId != DataSubjectRequestStatuses.Ids.Rejected)
                                    {
                                        <button class="btn btn-outline-success btn-sm me-1" title="Yanitla/Tamamla"
                                                @onclick="() => ShowResponseForm(r)">
                                            <i class="bi bi-reply"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white border-top d-flex justify-content-between">
                <small class="text-muted">Toplam: @totalCount kayit</small>
                <div>
                    <button class="btn btn-sm btn-outline-secondary me-1" disabled="@(currentPage <= 1)" @onclick="() => ChangePage(-1)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span class="small">@currentPage / @totalPages</span>
                    <button class="btn btn-sm btn-outline-secondary ms-1" disabled="@(currentPage >= totalPages)" @onclick="() => ChangePage(1)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@* ─── YENİ BAŞVURU FORMU MODAL ─── *@
@if (showForm)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Yeni Ilgili Kisi Basvurusu</h5>
                    <button type="button" class="btn-close" @onclick="() => showForm = false"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="createDto" OnValidSubmit="SubmitRequest">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Musteri <span class="text-danger">*</span></label>
                                <select class="form-select form-select-sm" @bind="createDto.CustomerId">
                                    <option value="0">Secin...</option>
                                    @foreach (var c in customers)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Basvuru Tipi <span class="text-danger">*</span></label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="createDto.RequestTypeId">
                                    <option value="0">Secin...</option>
                                    @foreach (var t in DataSubjectRequestTypes.All)
                                    {
                                        <option value="@t.Id">@t.Description</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Basvuran Adi <span class="text-danger">*</span></label>
                                <InputText class="form-control form-control-sm" @bind-Value="createDto.RequesterName" />
                                <ValidationMessage For="() => createDto.RequesterName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Tanimlayici (TC/Tel/Email) <span class="text-danger">*</span></label>
                                <InputText class="form-control form-control-sm" @bind-Value="createDto.RequesterIdentifier" />
                                <ValidationMessage For="() => createDto.RequesterIdentifier" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Iletisim Bilgisi <span class="text-danger">*</span></label>
                                <InputText class="form-control form-control-sm" @bind-Value="createDto.RequesterContact" />
                                <ValidationMessage For="() => createDto.RequesterContact" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Basvuru Aciklamasi <span class="text-danger">*</span></label>
                                <InputTextArea class="form-control form-control-sm" @bind-Value="createDto.RequestDescription" rows="3" />
                                <ValidationMessage For="() => createDto.RequestDescription" />
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => showForm = false">Iptal</button>
                            <button type="submit" class="btn btn-primary btn-sm" disabled="@isSaving">
                                @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Kaydet
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@* ─── YANITLAMA / İŞLEM MODAL ─── *@
@if (showResponseForm && selectedRequest != null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-reply me-2"></i>Basvuru Yanitla: @selectedRequest.RequesterName
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => showResponseForm = false"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-light mb-3">
                        <div class="row">
                            <div class="col-md-4"><strong>Tip:</strong> @selectedRequest.RequestTypeName</div>
                            <div class="col-md-4"><strong>Tanimlayici:</strong> @selectedRequest.RequesterIdentifier</div>
                            <div class="col-md-4"><strong>Son Tarih:</strong> @selectedRequest.Deadline.ToString("dd.MM.yyyy")</div>
                        </div>
                        <div class="mt-2"><strong>Aciklama:</strong> @selectedRequest.RequestDescription</div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Islem <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm" @bind="updateDto.StatusId">
                                <option value="@DataSubjectRequestStatuses.Ids.InProgress">Isleme Al</option>
                                <option value="@DataSubjectRequestStatuses.Ids.Completed">Tamamla</option>
                                <option value="@DataSubjectRequestStatuses.Ids.Rejected">Reddet</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Atanan Kisi</label>
                            <input type="text" class="form-control form-control-sm" @bind="updateDto.AssignedToUserName" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Yanit / Cevap Aciklamasi</label>
                            <textarea class="form-control form-control-sm" rows="3" @bind="updateDto.ResponseDescription"></textarea>
                        </div>
                        @if (updateDto.StatusId == DataSubjectRequestStatuses.Ids.Rejected)
                        {
                            <div class="col-12">
                                <label class="form-label">Red Nedeni <span class="text-danger">*</span></label>
                                <textarea class="form-control form-control-sm" rows="2" @bind="updateDto.RejectionReason"></textarea>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => showResponseForm = false">Iptal</button>
                    <button class="btn btn-primary btn-sm" @onclick="SubmitResponse" disabled="@isSaving">
                        @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        <i class="bi bi-check-lg me-1"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ─── DETAY MODAL ─── *@
@if (showDetailModal && selectedRequest != null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-envelope-paper me-2"></i>Basvuru Detayi
                        <span class="badge @GetStatusBadge(selectedRequest.StatusId) ms-2">@selectedRequest.StatusName</span>
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => showDetailModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Basvuran:</strong><br />@selectedRequest.RequesterName
                        </div>
                        <div class="col-md-4">
                            <strong>Tanimlayici:</strong><br />@selectedRequest.RequesterIdentifier
                        </div>
                        <div class="col-md-4">
                            <strong>Iletisim:</strong><br />@selectedRequest.RequesterContact
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Basvuru Tipi:</strong><br />@selectedRequest.RequestTypeName
                        </div>
                        <div class="col-md-4">
                            <strong>Basvuru Tarihi:</strong><br />@selectedRequest.RequestDate.ToString("dd.MM.yyyy HH:mm")
                        </div>
                        <div class="col-md-4">
                            <strong>Son Tarih (30 gun):</strong><br />
                            <span class="@(selectedRequest.IsOverdue ? "text-danger fw-bold" : "")">
                                @selectedRequest.Deadline.ToString("dd.MM.yyyy HH:mm")
                            </span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <strong>Basvuru Aciklamasi:</strong>
                        <div class="border rounded p-2 mt-1 bg-light" style="white-space:pre-wrap;">@selectedRequest.RequestDescription</div>
                    </div>
                    @if (!string.IsNullOrEmpty(selectedRequest.AssignedToUserName))
                    {
                        <div class="mb-3">
                            <strong>Atanan Kisi:</strong> @selectedRequest.AssignedToUserName
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(selectedRequest.ResponseDescription))
                    {
                        <div class="mb-3">
                            <strong>Yanit:</strong>
                            <div class="border rounded p-2 mt-1 bg-light" style="white-space:pre-wrap;">@selectedRequest.ResponseDescription</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(selectedRequest.RejectionReason))
                    {
                        <div class="mb-3">
                            <strong>Red Nedeni:</strong>
                            <div class="border rounded p-2 mt-1 bg-light text-danger" style="white-space:pre-wrap;">@selectedRequest.RejectionReason</div>
                        </div>
                    }
                    @if (selectedRequest.CompletedAt.HasValue)
                    {
                        <div class="mb-3">
                            <strong>Tamamlanma Tarihi:</strong> @selectedRequest.CompletedAt.Value.ToString("dd.MM.yyyy HH:mm")
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => showDetailModal = false">Kapat</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<DataSubjectRequestDto> items = new();
    private List<CustomerSimpleDto> customers = new();
    private DataSubjectRequestDto? selectedRequest;
    private bool isLoading = true;
    private bool showForm, showResponseForm, showDetailModal, isSaving;
    private int currentPage = 1, totalCount, totalPages;
    private int filterStatusId, filterCustomerId;

    private DataSubjectRequestCreateDto createDto = new();
    private DataSubjectRequestUpdateDto updateDto = new();

    protected override async Task OnInitializedAsync()
    {
        try { customers = await Http.GetFromJsonAsync<List<CustomerSimpleDto>>("api/supervisor/customers") ?? new(); } catch { }
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            var url = $"api/kvkk/requests?page={currentPage}&pageSize=20";
            if (filterCustomerId > 0) url += $"&customerId={filterCustomerId}";
            if (filterStatusId > 0) url += $"&status={filterStatusId}";
            var result = await Http.GetFromJsonAsync<PagedResponse<DataSubjectRequestDto>>(url);
            if (result != null)
            {
                items = result.Items;
                totalCount = result.TotalCount;
                totalPages = result.TotalPages;
            }
        }
        catch (Exception ex) { Toast.ShowError($"Veri yuklenemedi: {ex.Message}"); }
        finally { isLoading = false; }
    }

    private async Task LoadOverdue()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            var result = await Http.GetFromJsonAsync<List<DataSubjectRequestDto>>("api/kvkk/requests/overdue");
            if (result != null)
            {
                items = result;
                totalCount = result.Count;
                totalPages = 1;
                currentPage = 1;
            }
        }
        catch (Exception ex) { Toast.ShowError(ex.Message); }
        finally { isLoading = false; }
    }

    private void ShowCreateForm()
    {
        createDto = new() { CustomerId = customers.FirstOrDefault()?.Id ?? 0 };
        showForm = true;
    }

    private void ShowDetail(DataSubjectRequestDto request)
    {
        selectedRequest = request;
        showDetailModal = true;
    }

    private void ShowResponseForm(DataSubjectRequestDto request)
    {
        selectedRequest = request;
        updateDto = new()
        {
            StatusId = request.StatusId == DataSubjectRequestStatuses.Ids.Received
                ? DataSubjectRequestStatuses.Ids.InProgress
                : DataSubjectRequestStatuses.Ids.Completed,
            AssignedToUserName = request.AssignedToUserName
        };
        showResponseForm = true;
    }

    private async Task SubmitRequest()
    {
        if (createDto.CustomerId <= 0) { Toast.ShowError("Musteri secimi zorunludur."); return; }
        isSaving = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/kvkk/requests", createDto);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Basvuru olusturuldu. 30 gunluk yasal sure basladi.");
                showForm = false;
                await LoadData();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Toast.ShowError($"Hata: {err}");
            }
        }
        catch (Exception ex) { Toast.ShowError(ex.Message); }
        finally { isSaving = false; }
    }

    private async Task SubmitResponse()
    {
        if (selectedRequest == null) return;
        if (updateDto.StatusId == DataSubjectRequestStatuses.Ids.Rejected && string.IsNullOrWhiteSpace(updateDto.RejectionReason))
        {
            Toast.ShowError("Red nedeni zorunludur.");
            return;
        }

        isSaving = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/kvkk/requests/{selectedRequest.Uid}", updateDto);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Basvuru guncellendi.");
                showResponseForm = false;
                selectedRequest = null;
                await LoadData();
            }
            else Toast.ShowError("Guncelleme basarisiz.");
        }
        catch { Toast.ShowError("Bir hata olustu."); }
        finally { isSaving = false; }
    }

    private async Task ChangePage(int delta) { currentPage += delta; await LoadData(); }

    private static string GetStatusBadge(int statusId) => statusId switch
    {
        1 => "bg-info",
        2 => "bg-warning text-dark",
        3 => "bg-success",
        4 => "bg-danger",
        5 => "bg-danger",
        _ => "bg-secondary"
    };

    private record PagedResponse<T>(List<T> Items, int TotalCount, int TotalPages);
}
