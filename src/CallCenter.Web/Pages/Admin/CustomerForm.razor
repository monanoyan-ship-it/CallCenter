@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs
@using System.Security.Cryptography

@if (isVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi @(isEditMode ? "bi-pencil" : "bi-building-add") me-2"></i>
                        @(isEditMode ? "Musteri Duzenle" : "Yeni Musteri")
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger py-2 small">@errorMessage</div>
                        }

                        <div class="mb-3">
                            <label class="form-label small">Firma Adi</label>
                            <InputText class="form-control form-control-sm" @bind-Value="model.Name" />
                            <ValidationMessage For="@(() => model.Name)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small">Vergi No</label>
                            <InputText class="form-control form-control-sm" @bind-Value="model.TaxNumber" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small">Adres</label>
                            <InputTextArea class="form-control form-control-sm" @bind-Value="model.Address" rows="2" />
                        </div>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label small">Telefon</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="model.Phone" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label small">E-posta</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="model.Email" />
                                    <ValidationMessage For="@(() => model.Email)" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small">Maks. Kullanici Sayisi</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="model.MaxUsers" />
                            <small class="text-muted">0 = limitsiz. Sadece aranabilir kullanicilar (Operator + Ekip Lideri) sayilir.</small>
                        </div>

                        @if (!isEditMode)
                        {
                            <hr class="my-2" />
                            <h6 class="small fw-bold text-muted mb-2">
                                <i class="bi bi-person-fill-lock me-1"></i>Admin Hesabi
                            </h6>

                            <div class="mb-3">
                                <label class="form-label small">Kullanici Adi</label>
                                <InputText class="form-control form-control-sm" @bind-Value="model.AdminUserName"
                                           placeholder="ornek_admin" />
                                <ValidationMessage For="@(() => model.AdminUserName)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small">Sifre</label>
                                <div class="input-group input-group-sm">
                                    <InputText class="form-control form-control-sm" @bind-Value="model.AdminPassword"
                                               type="@(showPassword ? "text" : "password")" />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="TogglePassword"
                                            title="@(showPassword ? "Gizle" : "Goster")">
                                        <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-primary" @onclick="GeneratePassword"
                                            title="Guclu sifre uret">
                                        <i class="bi bi-key-fill"></i>
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => model.AdminPassword)" />
                            </div>
                        }

                        @if (isEditMode)
                        {
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="isActive" />
                                <label class="form-check-label small">Aktif</label>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="Close">Iptal</button>
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-check-lg me-1"></i>Kaydet
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool isVisible;
    private bool isEditMode;
    private bool isSaving;
    private bool showPassword;
    private string? errorMessage;
    private int editCustomerId;
    private bool isActive = true;

    private CustomerCreateDto model = new();

    public void OpenForCreate()
    {
        isEditMode = false;
        model = new();
        isActive = true;
        errorMessage = null;
        showPassword = false;
        isVisible = true;
        StateHasChanged();
    }

    public void OpenForEdit(CustomerListDto customer)
    {
        isEditMode = true;
        editCustomerId = customer.Id;
        model = new()
        {
            Name = customer.Name,
            Phone = customer.Phone,
            Email = customer.Email,
            AdminUserName = "placeholder",
            AdminPassword = "placeholder"
        };
        isActive = customer.IsActive;
        errorMessage = null;
        isVisible = true;

        _ = LoadDetail(customer.Id);
    }

    private async Task LoadDetail(int id)
    {
        try
        {
            var detail = await Http.GetFromJsonAsync<CustomerDetailDto>($"api/customers/{id}");
            if (detail != null)
            {
                model.TaxNumber = detail.TaxNumber;
                model.Address = detail.Address;
                model.MaxUsers = detail.MaxUsers;
                StateHasChanged();
            }
        }
        catch { }
    }

    private void Close()
    {
        isVisible = false;
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private void GeneratePassword()
    {
        const string upper = "ABCDEFGHJKLMNPQRSTUVWXYZ";
        const string lower = "abcdefghjkmnpqrstuvwxyz";
        const string digits = "23456789";
        const string special = "!@#$%&*?";
        const string all = upper + lower + digits + special;

        var bytes = new byte[16];
        RandomNumberGenerator.Fill(bytes);

        var chars = new char[16];
        // Garantili: en az 1 buyuk, 1 kucuk, 1 rakam, 1 ozel
        chars[0] = upper[bytes[0] % upper.Length];
        chars[1] = lower[bytes[1] % lower.Length];
        chars[2] = digits[bytes[2] % digits.Length];
        chars[3] = special[bytes[3] % special.Length];

        for (int i = 4; i < 16; i++)
            chars[i] = all[bytes[i] % all.Length];

        // Fisher-Yates shuffle
        for (int i = chars.Length - 1; i > 0; i--)
        {
            var j = bytes[i] % (i + 1);
            (chars[i], chars[j]) = (chars[j], chars[i]);
        }

        model.AdminPassword = new string(chars);
        showPassword = true;
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            HttpResponseMessage response;

            if (isEditMode)
            {
                var updateDto = new CustomerUpdateDto
                {
                    Name = model.Name,
                    TaxNumber = model.TaxNumber,
                    Address = model.Address,
                    Phone = model.Phone,
                    Email = model.Email,
                    MaxUsers = model.MaxUsers,
                    IsActive = isActive
                };
                response = await Http.PutAsJsonAsync($"api/customers/{editCustomerId}", updateDto);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/customers", model);
            }

            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess(isEditMode ? "Musteri guncellendi." : "Musteri olusturuldu.");
                isVisible = false;
                await OnSaved.InvokeAsync();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                errorMessage = error?.Message ?? "Islem basarisiz.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Hata: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private record ErrorMsg(string? Message);
}
