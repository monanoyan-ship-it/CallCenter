@page "/admin/kvkk/transfers"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums

<PageTitle>Yurt Disi Veri Aktarim - CorpLynk</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-globe me-2 text-primary"></i>Yurt Disi Veri Aktarimlari
    </h4>
    <div class="d-flex gap-2">
        <select class="form-select form-select-sm" style="width:200px" @bind="filterCustomerId" @bind:after="LoadData">
            <option value="0">Tum Musteriler</option>
            @foreach (var c in customers)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
        <button class="btn btn-primary btn-sm" @onclick="ShowCreateForm">
            <i class="bi bi-plus-lg me-1"></i>Yeni Aktarim Kaydi
        </button>
    </div>
</div>

@* ─── KVKK UYARI ─── *@
<div class="alert alert-info py-2 mb-3 d-flex align-items-start">
    <i class="bi bi-info-circle-fill me-2 mt-1"></i>
    <div>
        <strong>KVKK Madde 9:</strong> Kisisel veriler, ilgili kisinin acik rizasi olmaksizin yurt disina aktarilamaz.
        Kurul tarafindan yeterli korumaya sahip ilan edilen ulkeler veya yeterli koruma taahhut eden veri sorumlulari arasinda aktarim mumkundur.
    </div>
</div>

@* ─── TABLO ─── *@
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
        }
        else if (transfers.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-globe fs-1 d-block mb-2 opacity-25"></i>
                <span>Yurt disi aktarim kaydi bulunamadi</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Durum</th>
                            <th>Alici</th>
                            <th>Ulke</th>
                            <th>Veri Kategorileri</th>
                            <th>Guvence Tipi</th>
                            <th>Aktarim Tarihi</th>
                            <th>Musteri</th>
                            <th style="width:100px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in transfers)
                        {
                            <tr class="@(t.IsActive ? "" : "text-muted")">
                                <td>
                                    <span class="badge @(t.IsActive ? "bg-success" : "bg-secondary")">
                                        @(t.IsActive ? "Aktif" : "Sonlandirildi")
                                    </span>
                                </td>
                                <td>
                                    <strong>@t.RecipientName</strong>
                                    @if (!string.IsNullOrEmpty(t.CreatedByUserName))
                                    {
                                        <br /><small class="text-muted">Olusturan: @t.CreatedByUserName</small>
                                    }
                                </td>
                                <td>
                                    <i class="bi bi-geo-alt me-1"></i>@t.RecipientCountry
                                </td>
                                <td><small>@t.DataCategories</small></td>
                                <td><span class="badge bg-info text-dark">@t.SafeguardName</span></td>
                                <td>
                                    <small>@t.TransferDate.ToString("dd.MM.yyyy")</small>
                                    @if (t.EndDate.HasValue)
                                    {
                                        <small class="text-muted"> - @t.EndDate.Value.ToString("dd.MM.yyyy")</small>
                                    }
                                </td>
                                <td><small>@(t.CustomerName ?? "-")</small></td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm me-1" title="Detay" @onclick="() => ShowDetail(t)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    @if (t.IsActive)
                                    {
                                        <button class="btn btn-outline-danger btn-sm" title="Sonlandir" @onclick="() => EndTransfer(t.Uid)">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ─── OLUŞTURMA MODAL ─── *@
@if (showCreateForm)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-globe me-2"></i>Yeni Yurt Disi Aktarim Kaydi</h5>
                    <button type="button" class="btn-close" @onclick="() => showCreateForm = false"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="createDto" OnValidSubmit="SubmitCreate">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Musteri <span class="text-danger">*</span></label>
                                <select class="form-select form-select-sm" @bind="createDto.CustomerId">
                                    <option value="0">Secin...</option>
                                    @foreach (var c in customers)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Guvence Tipi <span class="text-danger">*</span></label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="createDto.SafeguardId">
                                    @foreach (var s in TransferSafeguards.All)
                                    {
                                        <option value="@s.Id">@s.Description</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Alici Adi <span class="text-danger">*</span></label>
                                <InputText class="form-control form-control-sm" @bind-Value="createDto.RecipientName"
                                           placeholder="Sirket veya kurum adi" />
                                <ValidationMessage For="() => createDto.RecipientName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Alici Ulkesi <span class="text-danger">*</span></label>
                                <InputText class="form-control form-control-sm" @bind-Value="createDto.RecipientCountry"
                                           placeholder="Ornegin: Almanya, ABD..." />
                                <ValidationMessage For="() => createDto.RecipientCountry" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Aktarilan Veri Kategorileri <span class="text-danger">*</span></label>
                                <InputText class="form-control form-control-sm" @bind-Value="createDto.DataCategories"
                                           placeholder="Kimlik, iletisim, ses kaydi, musteri bilgileri..." />
                                <ValidationMessage For="() => createDto.DataCategories" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Aktarim Amaci <span class="text-danger">*</span></label>
                                <InputText class="form-control form-control-sm" @bind-Value="createDto.Purpose"
                                           placeholder="Cloud depolama, veri isleme..." />
                                <ValidationMessage For="() => createDto.Purpose" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Yasal Dayanak <span class="text-danger">*</span></label>
                                <InputText class="form-control form-control-sm" @bind-Value="createDto.LegalBasis"
                                           placeholder="KVKK Md.9/2-b, Acik Riza..." />
                                <ValidationMessage For="() => createDto.LegalBasis" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Notlar</label>
                                <InputTextArea class="form-control form-control-sm" @bind-Value="createDto.Notes" rows="2" />
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => showCreateForm = false">Iptal</button>
                            <button type="submit" class="btn btn-primary btn-sm" disabled="@isSaving">
                                @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                <i class="bi bi-globe me-1"></i>Aktarim Kaydi Olustur
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@* ─── DETAY MODAL ─── *@
@if (showDetail && selectedTransfer != null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-globe me-2"></i>@selectedTransfer.RecipientName
                        <span class="badge @(selectedTransfer.IsActive ? "bg-success" : "bg-secondary") ms-2">
                            @(selectedTransfer.IsActive ? "Aktif" : "Sonlandirildi")
                        </span>
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => showDetail = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4"><strong>Alici Ulkesi:</strong> <i class="bi bi-geo-alt me-1"></i>@selectedTransfer.RecipientCountry</div>
                        <div class="col-md-4"><strong>Musteri:</strong> @(selectedTransfer.CustomerName ?? "-")</div>
                        <div class="col-md-4"><strong>Olusturan:</strong> @(selectedTransfer.CreatedByUserName ?? "-")</div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6"><strong>Guvence Tipi:</strong> <span class="badge bg-info text-dark">@selectedTransfer.SafeguardName</span></div>
                        <div class="col-md-6"><strong>Yasal Dayanak:</strong> @selectedTransfer.LegalBasis</div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6"><strong>Aktarim Tarihi:</strong> @selectedTransfer.TransferDate.ToString("dd.MM.yyyy")</div>
                        <div class="col-md-6"><strong>Bitis Tarihi:</strong> @(selectedTransfer.EndDate?.ToString("dd.MM.yyyy") ?? "Devam ediyor")</div>
                    </div>
                    <hr />
                    <div class="mb-3">
                        <strong>Amac:</strong>
                        <p class="mb-0">@selectedTransfer.Purpose</p>
                    </div>
                    <div class="mb-3">
                        <strong>Veri Kategorileri:</strong>
                        <p class="mb-0">@selectedTransfer.DataCategories</p>
                    </div>
                    @if (!string.IsNullOrEmpty(selectedTransfer.Notes))
                    {
                        <div>
                            <strong>Notlar:</strong>
                            <div class="border rounded p-2 mt-1" style="white-space:pre-wrap;font-size:0.9rem;">@selectedTransfer.Notes</div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => showDetail = false">Kapat</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CrossBorderTransferDto> transfers = new();
    private List<CustomerSimpleDto> customers = new();
    private CrossBorderTransferDto? selectedTransfer;
    private bool isLoading = true, isSaving;
    private bool showCreateForm, showDetail;
    private int filterCustomerId;

    private CrossBorderTransferCreateDto createDto = new() { SafeguardId = TransferSafeguards.Ids.AdequateCountry };

    protected override async Task OnInitializedAsync()
    {
        try { customers = await Http.GetFromJsonAsync<List<CustomerSimpleDto>>("api/supervisor/customers") ?? new(); } catch { }
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var url = "api/kvkk/transfers";
            if (filterCustomerId > 0) url += $"?customerId={filterCustomerId}";
            transfers = await Http.GetFromJsonAsync<List<CrossBorderTransferDto>>(url) ?? new();
        }
        catch { Toast.ShowError("Veriler yuklenemedi."); }
        finally { isLoading = false; }
    }

    private void ShowCreateForm()
    {
        createDto = new() { SafeguardId = TransferSafeguards.Ids.AdequateCountry };
        if (filterCustomerId > 0) createDto.CustomerId = filterCustomerId;
        showCreateForm = true;
    }

    private void ShowDetail(CrossBorderTransferDto t)
    {
        selectedTransfer = t;
        showDetail = true;
    }

    private async Task SubmitCreate()
    {
        isSaving = true;
        try
        {
            var resp = await Http.PostAsJsonAsync("api/kvkk/transfers", createDto);
            if (resp.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Yurt disi aktarim kaydi olusturuldu.");
                showCreateForm = false;
                await LoadData();
            }
            else
            {
                var err = await resp.Content.ReadFromJsonAsync<ErrorResponse>();
                Toast.ShowError(err?.Error ?? "Olusturma basarisiz.");
            }
        }
        catch { Toast.ShowError("Bir hata olustu."); }
        finally { isSaving = false; }
    }

    private async Task EndTransfer(Guid uid)
    {
        var dto = new CrossBorderTransferUpdateDto { IsActive = false, EndDate = DateTime.UtcNow };
        var resp = await Http.PutAsJsonAsync($"api/kvkk/transfers/{uid}", dto);
        if (resp.IsSuccessStatusCode)
        {
            Toast.ShowSuccess("Aktarim sonlandirildi.");
            await LoadData();
        }
        else Toast.ShowError("Guncelleme basarisiz.");
    }

    private record ErrorResponse(string? Error);
}
