@page "/admin/gateway-health"
@attribute [Authorize(Roles = "Admin,Supervisor")]
@using CallCenter.Shared.DTOs
@inject HubService HubService
@implements IDisposable

<div class="content-header mb-4">
    <h4><i class="bi bi-router-fill me-2"></i>Gateway Durumu</h4>
    <p class="text-muted mb-0">SIP gateway kayit durumlarini gercek zamanli izleyin.</p>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Agent</th>
                        <th>Gateway</th>
                        <th>SIP Server</th>
                        <th>Transport</th>
                        <th>Durum</th>
                        <th>Son Guncelleme</th>
                        <th>Hata</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!gateways.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-info-circle me-1"></i>
                                Henuz gateway durumu bildirilmedi.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var gw in gateways.Values.OrderBy(g => g.AgentName))
                        {
                            <tr>
                                <td>
                                    <i class="bi bi-person-fill me-1"></i>
                                    @gw.AgentName
                                </td>
                                <td>@(gw.GatewayName ?? "-")</td>
                                <td>@(gw.SipServer ?? "-")</td>
                                <td>@(gw.Transport ?? "-")</td>
                                <td>
                                    @if (gw.IsRegistered)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle-fill me-1"></i>Kayitli
                                        </span>
                                    }
                                    else if (!string.IsNullOrEmpty(gw.ErrorMessage))
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle-fill me-1"></i>Hata
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-question-circle-fill me-1"></i>Bilinmiyor
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (gw.Timestamp != default)
                                    {
                                        <span title="@gw.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")">
                                            @FormatTimeAgo(gw.Timestamp)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(gw.ErrorMessage))
                                    {
                                        <span class="text-danger small">@gw.ErrorMessage</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private Dictionary<int, GatewayHealthUpdate> gateways = new();

    protected override async Task OnInitializedAsync()
    {
        HubService.OnGatewayHealthChanged += HandleGatewayHealthChanged;

        // Mevcut durumlari cek
        var existing = await HubService.GetAllGatewayStatusesAsync();
        foreach (var gw in existing)
        {
            gateways[gw.AgentId] = gw;
        }
    }

    private void HandleGatewayHealthChanged(GatewayHealthUpdate update)
    {
        gateways[update.AgentId] = update;
        InvokeAsync(StateHasChanged);
    }

    private static string FormatTimeAgo(DateTime utcTime)
    {
        var diff = DateTime.UtcNow - utcTime;
        if (diff.TotalSeconds < 60) return "Az once";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} dk once";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} saat once";
        return utcTime.ToLocalTime().ToString("dd.MM HH:mm");
    }

    public void Dispose()
    {
        HubService.OnGatewayHealthChanged -= HandleGatewayHealthChanged;
    }
}
