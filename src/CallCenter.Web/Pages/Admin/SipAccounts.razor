@page "/admin/sip"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs

<PageTitle>SIP Ayarlari - Call Center</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-router-fill me-2 text-primary"></i>SIP Hesap Ayarlari
    </h4>
    <button class="btn btn-primary btn-sm" @onclick="OpenCreateForm">
        <i class="bi bi-plus-lg me-1"></i>Yeni SIP Hesabi
    </button>
</div>

@* ─── FİLTRELER ─── *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <select class="form-select form-select-sm" @onchange="OnCustomerFilterChanged">
                    <option value="0">Tum Firmalar</option>
                    @foreach (var c in customers)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary btn-sm w-100" @onclick="LoadData">
                    <i class="bi bi-arrow-clockwise me-1"></i>Yenile
                </button>
            </div>
        </div>
    </div>
</div>

@* ─── TABLO ─── *@
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else if (result == null || result.Items.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-router fs-1 d-block mb-2 opacity-25"></i>
                <span>SIP hesabi bulunamadi</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Hesap Adi</th>
                            <th>Firma</th>
                            <th>Sunucu</th>
                            <th>Port</th>
                            <th>Kullanici</th>
                            <th>Transport</th>
                            <th>Varsayilan</th>
                            <th>Durum</th>
                            <th style="width: 100px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sip in result.Items)
                        {
                            <tr class="@(!sip.IsActive ? "table-secondary" : "")">
                                <td class="fw-medium">@sip.Name</td>
                                <td class="text-muted small">@sip.CustomerName</td>
                                <td>@sip.Server</td>
                                <td class="text-muted">@sip.Port</td>
                                <td>@sip.Username</td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary">@(sip.Transport ?? "UDP")</span>
                                </td>
                                <td class="text-center">
                                    @if (sip.IsDefault)
                                    {
                                        <i class="bi bi-star-fill text-warning"></i>
                                    }
                                </td>
                                <td>
                                    @if (sip.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Pasif</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-outline-primary btn-sm me-1" title="Duzenle"
                                            @onclick="() => OpenEditForm(sip)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm" title="Sil"
                                            @onclick="() => ConfirmDelete(sip)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
                <small class="text-muted">Toplam: @result.TotalCount kayit</small>
                <Pagination CurrentPage="currentPage" TotalPages="result.TotalPages" OnPageChanged="OnPageChanged" />
            </div>
        }
    </div>
</div>

<SipAccountForm @ref="sipForm" Customers="customers" OnSaved="LoadData" />

<ConfirmDialog @ref="confirmDialog" OnConfirm="ExecuteDelete"
               Message="@($"'{deleteTarget?.Name}' SIP hesabini silmek istediginize emin misiniz?")" />

@code {
    private PagedResult<SipAccountListDto>? result;
    private List<CustomerSimpleDto> customers = new();
    private bool isLoading;
    private int selectedCustomerId;
    private int currentPage = 1;
    private SipAccountForm sipForm = null!;
    private ConfirmDialog confirmDialog = null!;
    private SipAccountListDto? deleteTarget;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var list = await Http.GetFromJsonAsync<List<CustomerSimpleDto>>("api/supervisor/customers");
            customers = list ?? new();
        }
        catch { }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var url = $"api/sipaccounts?page={currentPage}&pageSize=20";
            if (selectedCustomerId > 0)
                url += $"&customerId={selectedCustomerId}";

            result = await Http.GetFromJsonAsync<PagedResult<SipAccountListDto>>(url);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Veri yuklenemedi: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnCustomerFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            selectedCustomerId = id;
            currentPage = 1;
            await LoadData();
        }
    }

    private async Task OnPageChanged(int page)
    {
        currentPage = page;
        await LoadData();
    }

    private void OpenCreateForm()
    {
        sipForm.OpenForCreate();
    }

    private void OpenEditForm(SipAccountListDto sip)
    {
        sipForm.OpenForEdit(sip);
    }

    private void ConfirmDelete(SipAccountListDto sip)
    {
        deleteTarget = sip;
        confirmDialog.Show();
    }

    private async Task ExecuteDelete()
    {
        if (deleteTarget == null) return;

        try
        {
            var response = await Http.DeleteAsync($"api/sipaccounts/{deleteTarget.Id}");
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("SIP hesabi basariyla silindi.");
                await LoadData();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(error?.Message ?? "Silme islemi basarisiz.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Hata: {ex.Message}");
        }
    }

    private record ErrorMsg(string? Message);
}
