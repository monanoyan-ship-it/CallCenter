@page "/admin/auditlogs"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@using System.Net.Http.Json
@using CallCenter.Shared.DTOs
@using Microsoft.AspNetCore.Authorization

<PageTitle>Denetim Kayitlari - Call Center</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-journal-text me-2"></i>Denetim Kayitlari</h5>
    @if (result != null)
    {
        <span class="badge bg-secondary">@result.TotalCount kayit</span>
    }
</div>

@* ─── FİLTRE KARTI ─── *@
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small mb-1">Arama</label>
                <input type="text" class="form-control form-control-sm" placeholder="Kullanici adi veya aciklama..."
                       @bind="searchText" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Kategori</label>
                <select class="form-select form-select-sm" @onchange="OnCategoryChanged">
                    <option value="">Tumü</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat" selected="@(cat == selectedCategory)">@cat</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Aksiyon</label>
                <select class="form-select form-select-sm" @onchange="OnActionChanged">
                    <option value="">Tumü</option>
                    @foreach (var act in actions)
                    {
                        <option value="@act" selected="@(act == selectedAction)">@act</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Baslangic</label>
                <input type="date" class="form-control form-control-sm" @bind="dateFrom" @bind:event="onchange" />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Bitis</label>
                <input type="date" class="form-control form-control-sm" @bind="dateTo" @bind:event="onchange" />
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button class="btn btn-sm btn-outline-primary" @onclick="LoadData" title="Yenile">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters" title="Temizle">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@* ─── TABLO ─── *@
@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="text-muted mt-2 small">Yukluyor...</p>
    </div>
}
else if (result == null || result.Items.Count == 0)
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-journal-x" style="font-size: 2rem;"></i>
        <p class="mt-2">Kayit bulunamadi.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width: 140px;">Tarih</th>
                    <th style="width: 100px;">Kategori</th>
                    <th style="width: 110px;">Aksiyon</th>
                    <th style="width: 120px;">Kullanici</th>
                    <th>Aciklama</th>
                    <th style="width: 100px;">Entity</th>
                    <th style="width: 110px;">IP</th>
                    <th style="width: 50px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in result.Items)
                {
                    <tr class="@GetRowClass(log)">
                        <td class="small text-nowrap">@log.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td><span class="badge @GetCategoryBadgeClass(log.Category)">@log.Category</span></td>
                        <td><span class="badge @GetActionBadgeClass(log.Action)">@log.Action</span></td>
                        <td class="small">@(log.UserName ?? "—")</td>
                        <td class="small text-truncate" style="max-width: 300px;" title="@log.Description">@log.Description</td>
                        <td class="small">
                            @if (!string.IsNullOrEmpty(log.EntityType))
                            {
                                <span>@log.EntityType<span class="text-muted">/@(log.EntityId ?? "—")</span></span>
                            }
                        </td>
                        <td class="small text-muted">@(log.IpAddress ?? "—")</td>
                        <td>
                            <button class="btn btn-sm btn-link p-0" @onclick="() => ShowDetail(log.Id)" title="Detay">
                                <i class="bi bi-eye"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ─── SAYFALAMA ─── *@
    <div class="d-flex justify-content-between align-items-center mt-2">
        <small class="text-muted">
            @((result.Page - 1) * result.PageSize + 1)-@(Math.Min(result.Page * result.PageSize, result.TotalCount))
            / @result.TotalCount kayit
        </small>
        <Pagination CurrentPage="@result.Page" TotalPages="@result.TotalPages" OnPageChanged="OnPageChanged" />
    </div>
}

@* ─── DETAY MODAL ─── *@
@if (detailLog != null)
{
    <div class="modal-backdrop-custom" @onclick="CloseDetail"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">
                        <i class="bi bi-journal-text me-2"></i>Denetim Kaydi Detayi
                    </h6>
                    <button type="button" class="btn-close" @onclick="CloseDetail"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-0">Tarih</label>
                            <div>@detailLog.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-muted mb-0">Kategori</label>
                            <div><span class="badge @GetCategoryBadgeClass(detailLog.Category)">@detailLog.Category</span></div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-muted mb-0">Aksiyon</label>
                            <div><span class="badge @GetActionBadgeClass(detailLog.Action)">@detailLog.Action</span></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-0">Kullanici</label>
                            <div>@(detailLog.UserName ?? "—") <span class="text-muted small">(ID: @(detailLog.UserId?.ToString() ?? "—"))</span></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-0">Entity</label>
                            <div>@(detailLog.EntityType ?? "—") / @(detailLog.EntityId ?? "—")</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small text-muted mb-0">Aciklama</label>
                            <div>@detailLog.Description</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-0">IP Adresi</label>
                            <div>@(detailLog.IpAddress ?? "—")</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-0">User Agent</label>
                            <div class="small text-break">@(detailLog.UserAgent ?? "—")</div>
                        </div>
                        @if (!string.IsNullOrEmpty(detailLog.OldValues))
                        {
                            <div class="col-12">
                                <label class="form-label small text-muted mb-0">Eski Degerler</label>
                                <pre class="json-block">@detailLog.OldValues</pre>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(detailLog.NewValues))
                        {
                            <div class="col-12">
                                <label class="form-label small text-muted mb-0">Yeni Degerler</label>
                                <pre class="json-block">@detailLog.NewValues</pre>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseDetail">Kapat</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<AuditLogListDto>? result;
    private AuditLogDetailDto? detailLog;
    private bool isLoading;
    private int currentPage = 1;

    // Filtreler
    private string searchText = "";
    private string selectedCategory = "";
    private string selectedAction = "";
    private DateTime? dateFrom;
    private DateTime? dateTo;

    // Dropdown verileri
    private List<string> categories = new();
    private List<string> actions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var url = $"api/auditlogs?page={currentPage}&pageSize=50";

            if (!string.IsNullOrWhiteSpace(selectedCategory))
                url += $"&category={Uri.EscapeDataString(selectedCategory)}";

            if (!string.IsNullOrWhiteSpace(selectedAction))
                url += $"&action={Uri.EscapeDataString(selectedAction)}";

            if (!string.IsNullOrWhiteSpace(searchText))
                url += $"&search={Uri.EscapeDataString(searchText)}";

            if (dateFrom.HasValue)
                url += $"&dateFrom={dateFrom.Value:yyyy-MM-dd}";

            if (dateTo.HasValue)
                url += $"&dateTo={dateTo.Value:yyyy-MM-dd}";

            result = await Http.GetFromJsonAsync<PagedResult<AuditLogListDto>>(url);
        }
        catch
        {
            result = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadCategories()
    {
        try
        {
            categories = await Http.GetFromJsonAsync<List<string>>("api/auditlogs/categories") ?? new();
        }
        catch { categories = new(); }
    }

    private async Task LoadActions()
    {
        try
        {
            var url = "api/auditlogs/actions";
            if (!string.IsNullOrWhiteSpace(selectedCategory))
                url += $"?category={Uri.EscapeDataString(selectedCategory)}";

            actions = await Http.GetFromJsonAsync<List<string>>(url) ?? new();
        }
        catch { actions = new(); }
    }

    private async Task OnCategoryChanged(ChangeEventArgs e)
    {
        selectedCategory = e.Value?.ToString() ?? "";
        selectedAction = "";
        currentPage = 1;
        await LoadActions();
        await LoadData();
    }

    private async Task OnActionChanged(ChangeEventArgs e)
    {
        selectedAction = e.Value?.ToString() ?? "";
        currentPage = 1;
        await LoadData();
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            currentPage = 1;
            await LoadData();
        }
    }

    private async Task OnPageChanged(int page)
    {
        currentPage = page;
        await LoadData();
    }

    private async Task ClearFilters()
    {
        searchText = "";
        selectedCategory = "";
        selectedAction = "";
        dateFrom = null;
        dateTo = null;
        currentPage = 1;
        actions = new();
        await LoadData();
    }

    private async Task ShowDetail(long id)
    {
        try
        {
            detailLog = await Http.GetFromJsonAsync<AuditLogDetailDto>($"api/auditlogs/{id}");
        }
        catch { detailLog = null; }
    }

    private void CloseDetail() => detailLog = null;

    // ─── Satır renklendirme ───
    private string GetRowClass(AuditLogListDto log)
    {
        if (log.Action is "LoginFailed" or "RefreshFailed")
            return "row-danger";
        if (log.Action == "Delete" || log.Action == "Deactivate")
            return "row-warning";
        return "";
    }

    private string GetCategoryBadgeClass(string category) => category switch
    {
        "Auth" => "bg-info text-dark",
        "User" => "bg-primary",
        "Customer" => "bg-success",
        "Queue" => "bg-secondary",
        "SipAccount" => "bg-dark",
        "CallRecord" => "bg-warning text-dark",
        "SystemSetting" => "bg-danger",
        _ => "bg-light text-dark border"
    };

    private string GetActionBadgeClass(string action) => action switch
    {
        "Login" or "Refresh" => "bg-success",
        "LoginFailed" or "RefreshFailed" => "bg-danger",
        "Logout" or "Revoke" => "bg-secondary",
        "Create" => "bg-primary",
        "Update" or "StatusChange" => "bg-info text-dark",
        "Delete" or "Deactivate" => "bg-danger",
        "PasswordReset" or "PasswordChange" => "bg-warning text-dark",
        _ => "bg-light text-dark border"
    };
}
