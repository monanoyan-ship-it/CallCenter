@page "/admin/callforwarding"
@attribute [Authorize(Roles = "Admin,Supervisor")]
@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Entities

<PageTitle>Arama Yonlendirme - Call Center</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-telephone-forward me-2 text-primary"></i>Arama Yonlendirme Kurallari
    </h4>
    <button class="btn btn-primary btn-sm" @onclick="OpenCreateForm">
        <i class="bi bi-plus-lg me-1"></i>Yeni Kural
    </button>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (rules == null || !rules.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-telephone-forward display-4 d-block mb-2"></i>
        <p>Henuz yonlendirme kurali tanimlanmamis.</p>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Kullanici</th>
                            <th>Tip</th>
                            <th>Hedef</th>
                            <th>Oncelik</th>
                            <th>Timeout</th>
                            <th>Durum</th>
                            <th>Aciklama</th>
                            <th style="width: 120px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rule in rules)
                        {
                            <tr class="@(rule.IsActive ? "" : "text-muted")">
                                <td>@(rule.UserName ?? $"#{rule.UserId}")</td>
                                <td>
                                    <span class="badge @GetTypeBadgeClass(rule.ForwardType)">
                                        @GetTypeDisplayName(rule.ForwardType)
                                    </span>
                                </td>
                                <td class="fw-medium">@rule.Destination</td>
                                <td>@rule.Priority</td>
                                <td>
                                    @if (rule.ForwardType == ForwardTypes.NoAnswer)
                                    {
                                        <span>@rule.TimeoutSeconds sn</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (rule.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Pasif</span>
                                    }
                                </td>
                                <td class="small text-muted">@rule.Description</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1" title="Duzenle" @onclick="() => OpenEditForm(rule)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" title="Sil" @onclick="() => DeleteRule(rule.Id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* ─── Modal: Kural Olustur/Duzenle ─── *@
@if (showForm)
{
    <div class="modal-backdrop-custom" @onclick="CloseForm"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-telephone-forward me-2"></i>
                        @(editingRuleId.HasValue ? "Kurali Duzenle" : "Yeni Yonlendirme Kurali")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    @if (!editingRuleId.HasValue)
                    {
                        <div class="mb-3">
                            <label class="form-label">Kullanici ID</label>
                            <input type="number" class="form-control form-control-sm" @bind="formUserId" />
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Yonlendirme Tipi</label>
                        <select class="form-select form-select-sm" @bind="formForwardType">
                            <option value="1">Her Zaman (Always)</option>
                            <option value="2">Mesgulken (Busy)</option>
                            <option value="3">Cevaplanmadiginda (NoAnswer)</option>
                            <option value="4">Cevrimdisiyken (Offline)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Hedef Numara / SIP URI</label>
                        <input type="text" class="form-control form-control-sm" @bind="formDestination"
                               placeholder="ornek: 1001 veya sip:1001@pbx.local" />
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Oncelik</label>
                            <input type="number" class="form-control form-control-sm" @bind="formPriority" min="0" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Timeout (sn)</label>
                            <input type="number" class="form-control form-control-sm" @bind="formTimeout" min="5" max="120"
                                   disabled="@(formForwardType != 3)" />
                            <small class="text-muted">Sadece NoAnswer tipi icin</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Aciklama</label>
                        <input type="text" class="form-control form-control-sm" @bind="formDescription" />
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="formIsActive" id="chkActive" />
                        <label class="form-check-label" for="chkActive">Aktif</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseForm">Iptal</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveRule" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        @(editingRuleId.HasValue ? "Guncelle" : "Olustur")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CallForwardingRuleDto>? rules;
    private bool isLoading = true;
    private bool showForm;
    private bool isSaving;
    private int? editingRuleId;

    // Form alanlari
    private int formUserId;
    private int formForwardType = 1;
    private string formDestination = string.Empty;
    private bool formIsActive = true;
    private int formPriority;
    private int formTimeout = 20;
    private string? formDescription;

    protected override async Task OnInitializedAsync()
    {
        await LoadRulesAsync();
    }

    private async Task LoadRulesAsync()
    {
        isLoading = true;
        try
        {
            rules = await Http.GetFromJsonAsync<List<CallForwardingRuleDto>>("api/callforwarding");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Yukleme hatasi: {ex.Message}");
        }
        isLoading = false;
    }

    private void OpenCreateForm()
    {
        editingRuleId = null;
        formUserId = 0;
        formForwardType = 1;
        formDestination = string.Empty;
        formIsActive = true;
        formPriority = 0;
        formTimeout = 20;
        formDescription = null;
        showForm = true;
    }

    private void OpenEditForm(CallForwardingRuleDto rule)
    {
        editingRuleId = rule.Id;
        formUserId = rule.UserId;
        formForwardType = rule.ForwardType;
        formDestination = rule.Destination;
        formIsActive = rule.IsActive;
        formPriority = rule.Priority;
        formTimeout = rule.TimeoutSeconds;
        formDescription = rule.Description;
        showForm = true;
    }

    private void CloseForm() => showForm = false;

    private async Task SaveRule()
    {
        if (string.IsNullOrWhiteSpace(formDestination))
        {
            Toast.ShowWarning("Hedef numara zorunludur.");
            return;
        }

        isSaving = true;
        try
        {
            if (editingRuleId.HasValue)
            {
                var dto = new CallForwardingRuleUpdateDto
                {
                    ForwardType = formForwardType,
                    Destination = formDestination,
                    IsActive = formIsActive,
                    Priority = formPriority,
                    TimeoutSeconds = formTimeout,
                    Description = formDescription
                };
                var resp = await Http.PutAsJsonAsync($"api/callforwarding/{editingRuleId.Value}", dto);
                if (resp.IsSuccessStatusCode)
                {
                    Toast.ShowSuccess("Kural guncellendi.");
                    showForm = false;
                    await LoadRulesAsync();
                }
                else
                {
                    var err = await resp.Content.ReadFromJsonAsync<ErrorResponse>();
                    Toast.ShowError(err?.Message ?? "Guncelleme hatasi");
                }
            }
            else
            {
                if (formUserId <= 0)
                {
                    Toast.ShowWarning("Kullanici ID zorunludur.");
                    isSaving = false;
                    return;
                }

                var dto = new CallForwardingRuleCreateDto
                {
                    UserId = formUserId,
                    ForwardType = formForwardType,
                    Destination = formDestination,
                    IsActive = formIsActive,
                    Priority = formPriority,
                    TimeoutSeconds = formTimeout,
                    Description = formDescription
                };
                var resp = await Http.PostAsJsonAsync("api/callforwarding", dto);
                if (resp.IsSuccessStatusCode)
                {
                    Toast.ShowSuccess("Kural olusturuldu.");
                    showForm = false;
                    await LoadRulesAsync();
                }
                else
                {
                    var err = await resp.Content.ReadFromJsonAsync<ErrorResponse>();
                    Toast.ShowError(err?.Message ?? "Olusturma hatasi");
                }
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Islem hatasi: {ex.Message}");
        }
        isSaving = false;
    }

    private async Task DeleteRule(int id)
    {
        try
        {
            var resp = await Http.DeleteAsync($"api/callforwarding/{id}");
            if (resp.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Kural silindi.");
                await LoadRulesAsync();
            }
            else
            {
                Toast.ShowError("Silme hatasi.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Silme hatasi: {ex.Message}");
        }
    }

    private string GetTypeDisplayName(int type) => type switch
    {
        ForwardTypes.Always => "Her Zaman",
        ForwardTypes.Busy => "Mesgul",
        ForwardTypes.NoAnswer => "Cevapsiz",
        ForwardTypes.Offline => "Cevrimdisi",
        _ => "Bilinmiyor"
    };

    private string GetTypeBadgeClass(int type) => type switch
    {
        ForwardTypes.Always => "bg-primary-subtle text-primary",
        ForwardTypes.Busy => "bg-warning-subtle text-warning",
        ForwardTypes.NoAnswer => "bg-info-subtle text-info",
        ForwardTypes.Offline => "bg-secondary-subtle text-secondary",
        _ => "bg-light text-dark"
    };

    private record ErrorResponse(string? Message);
}
