@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs

@if (isVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-person-badge me-2"></i>
                        @(isEdit ? "Personel Duzenle" : "Yeni Personel")
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <EditForm Model="model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Ad Soyad <span class="text-danger">*</span></label>
                                <InputText class="form-control form-control-sm" @bind-Value="model.FullName"
                                           @oninput="OnFullNameInput" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">
                                    Kullanici Adi <span class="text-danger">*</span>
                                    @if (!isEdit && !userNameManuallyEdited)
                                    {
                                        <span class="badge bg-info-subtle text-info ms-1" style="font-size: 0.65rem;">otomatik</span>
                                    }
                                    @if (usernameCheckState == 1)
                                    {
                                        <span class="spinner-border spinner-border-sm text-muted ms-1" style="width:0.7rem;height:0.7rem;"></span>
                                    }
                                    else if (usernameCheckState == 2)
                                    {
                                        <span class="badge bg-success-subtle text-success ms-1" style="font-size: 0.65rem;">musait</span>
                                    }
                                    else if (usernameCheckState == 3)
                                    {
                                        <span class="badge bg-danger-subtle text-danger ms-1" style="font-size: 0.65rem;">kullaniliyor</span>
                                    }
                                </label>
                                <div class="input-group input-group-sm">
                                    <InputText class="@UserNameInputCss()" @bind-Value="model.UserName"
                                               @oninput="OnUserNameInput" />
                                    <button type="button" class="btn btn-outline-secondary" title="Ad Soyad'dan yeniden olustur"
                                            @onclick="RegenerateUserName">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">E-posta <span class="text-danger">*</span></label>
                                <InputText class="form-control form-control-sm" @bind-Value="model.Email" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@(isEdit ? "Sifre (bos = degismez)" : "Sifre *")</label>
                                <InputText type="password" class="form-control form-control-sm" @bind-Value="model.Password" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Unvan</label>
                                <InputText class="form-control form-control-sm" @bind-Value="model.Title" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Rol</label>
                                <select class="form-select form-select-sm" @bind="model.CustomerRoleId">
                                    <option value="0">-- Secilmedi --</option>
                                    @foreach (var role in CallCenter.Shared.Enums.CustomerRoles.All)
                                    {
                                        <option value="@role.Id">@role.Description</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Organizasyon Birimi</label>
                                <SearchableSelect Items="orgUnitItems" Value="@orgUnitIdStr"
                                                  ValueChanged="OnOrgUnitSelected" Placeholder="-- Birim yok --" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Ust Yonetici</label>
                                <SearchableSelect Items="reportsToItems" Value="@reportsToIdStr"
                                                  ValueChanged="OnReportsToSelected" Placeholder="-- Ust yonetici yok --" />
                            </div>
                            @if (isEdit)
                            {
                                <div class="col-12">
                                    <div class="form-check">
                                        <InputCheckbox class="form-check-input" @bind-Value="model.IsActive" />
                                        <label class="form-check-label">Aktif</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="Close">Iptal</button>
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @(isEdit ? "Guncelle" : "Olustur")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int CustomerId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private FormModel model = new();
    private bool isVisible;
    private bool isEdit;
    private bool isSaving;
    private int? editId;
    private string editUserName = ""; // Duzenleme modunda readonly gosterim icin
    private bool userNameManuallyEdited; // Kullanici elle degistirdiyse otomatik uretme
    private int usernameCheckState; // 0=idle, 1=checking, 2=available, 3=taken
    private CancellationTokenSource? _usernameCts;
    private List<OrgUnitListDto>? orgUnits;
    private List<PortalPersonnelListDto>? allPersonnel;

    private string orgUnitIdStr => model.OrganizationUnitId?.ToString() ?? "";
    private string reportsToIdStr => model.ReportsToPersonnelId?.ToString() ?? "";

    private List<SearchableSelect.SearchSelectItem> orgUnitItems =>
        orgUnits?.Select(o => new SearchableSelect.SearchSelectItem(o.Id.ToString(), o.Name, o.ParentName)).ToList() ?? new();

    private List<SearchableSelect.SearchSelectItem> reportsToItems =>
        allPersonnel?.Where(x => x.Id != editId)
            .Select(p => new SearchableSelect.SearchSelectItem(p.Id.ToString(), p.FullName, p.CustomerRoleName)).ToList() ?? new();

    public async void OpenForCreate()
    {
        isEdit = false;
        editId = null;
        editUserName = "";
        userNameManuallyEdited = false;
        model = new FormModel();
        await LoadDropdowns();
        isVisible = true;
        StateHasChanged();
    }

    public async void OpenForEdit(PortalPersonnelListDto p)
    {
        isEdit = true;
        editId = p.Id;
        editUserName = p.UserName;
        userNameManuallyEdited = false;
        model = new FormModel
        {
            UserName = p.UserName,
            FullName = p.FullName,
            Email = p.Email,
            Title = p.Title,
            CustomerRoleId = p.CustomerRoleId,
            OrganizationUnitId = p.OrganizationUnitId,
            ReportsToPersonnelId = p.ReportsToPersonnelId,
            IsActive = p.IsActive
        };
        await LoadDropdowns();
        isVisible = true;
        StateHasChanged();
    }

    // ── UserName otomatik uretici ──

    /// <summary>
    /// Ad Soyad inputundan tetiklenir.
    /// Kullanici elle UserName degistirmediyse otomatik uretir.
    /// Ornek: "Ahmet Yilmaz" → "ahmet.yilmaz"
    /// </summary>
    private void OnFullNameInput(ChangeEventArgs e)
    {
        var fullName = e.Value?.ToString() ?? "";
        model.FullName = fullName;

        if (!isEdit && !userNameManuallyEdited)
        {
            model.UserName = GenerateUserName(fullName);
            _ = CheckUsernameAsync(model.UserName);
        }
    }

    private void OnUserNameInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        model.UserName = val;
        userNameManuallyEdited = !string.IsNullOrWhiteSpace(val);
        _ = CheckUsernameAsync(val);
    }

    private async Task CheckUsernameAsync(string username)
    {
        _usernameCts?.Cancel();
        if (string.IsNullOrWhiteSpace(username) || username.Length < 3)
        {
            usernameCheckState = 0;
            StateHasChanged();
            return;
        }

        usernameCheckState = 1;
        StateHasChanged();

        _usernameCts = new CancellationTokenSource();
        var token = _usernameCts.Token;

        try
        {
            await Task.Delay(400, token);
            if (token.IsCancellationRequested) return;

            // Edit modunda mevcut kullanici adi ayni kaldiysa kontrol etme
            if (isEdit && username == editUserName)
            {
                usernameCheckState = 2;
                StateHasChanged();
                return;
            }

            var excludeParam = isEdit && editId.HasValue ? $"&excludeUserId={editId}" : "";
            var result = await Http.GetFromJsonAsync<UsernameCheckResult>(
                $"api/portal/personnel/check-username?username={Uri.EscapeDataString(username)}{excludeParam}", token);

            usernameCheckState = result?.Available == true ? 2 : 3;
        }
        catch (OperationCanceledException) { return; }
        catch { usernameCheckState = 0; }
        StateHasChanged();
    }

    private record UsernameCheckResult(bool Available);

    private string UserNameInputCss() => usernameCheckState switch
    {
        3 => "form-control form-control-sm font-monospace is-invalid",
        2 => "form-control form-control-sm font-monospace is-valid",
        _ => "form-control form-control-sm font-monospace"
    };

    /// <summary>
    /// Yeniden olustur butonuna basinca otomatik moda don + yeniden uret.
    /// </summary>
    private void RegenerateUserName()
    {
        userNameManuallyEdited = false;
        model.UserName = GenerateUserName(model.FullName);
        _ = CheckUsernameAsync(model.UserName);
    }

    /// <summary>
    /// Ad Soyad'dan kullanici adi uretir.
    /// - Kucuk harfe cevirir
    /// - Turkce karakterleri ASCII'ye donusturur (ş→s, ü→u, ö→o, ç→c, ğ→g, ı→i, İ→i)
    /// - Bosluklari noktaya cevirir
    /// - Alfanumerik + nokta disindaki karakterleri temizler
    /// - Ornek: "Ahmet Yılmaz" → "ahmet.yilmaz"
    /// </summary>
    private static string GenerateUserName(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "";

        var result = fullName.Trim().ToLowerInvariant();

        // Turkce karakter donusumu
        result = result
            .Replace('ş', 's').Replace('ç', 'c').Replace('ğ', 'g')
            .Replace('ü', 'u').Replace('ö', 'o').Replace('ı', 'i')
            .Replace('Ş', 's').Replace('Ç', 'c').Replace('Ğ', 'g')
            .Replace('Ü', 'u').Replace('Ö', 'o').Replace('İ', 'i')
            .Replace('â', 'a').Replace('î', 'i').Replace('û', 'u');

        // Bosluklari noktaya cevir, birden fazla boslugu tek noktaya dusur
        var parts = result.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        result = string.Join(".", parts);

        // Sadece alfanumerik ve nokta birak
        result = new string(result.Where(c => char.IsLetterOrDigit(c) || c == '.').ToArray());

        // Bastaki/sondaki noktalari temizle
        result = result.Trim('.');

        return result;
    }

    private async Task LoadDropdowns()
    {
        try
        {
            orgUnits = await Http.GetFromJsonAsync<List<OrgUnitListDto>>($"api/organizations?customerId={CustomerId}");
            allPersonnel = await Http.GetFromJsonAsync<List<PortalPersonnelListDto>>($"api/portal/personnel?customerId={CustomerId}");
        }
        catch { }
    }

    private void OnOrgUnitSelected(string? val)
    {
        model.OrganizationUnitId = int.TryParse(val, out var id) ? id : null;
    }

    private void OnReportsToSelected(string? val)
    {
        model.ReportsToPersonnelId = int.TryParse(val, out var id) ? id : null;
    }

    private async Task HandleSubmit()
    {
        if (usernameCheckState == 3)
        {
            Toast.ShowError("Bu kullanici adi zaten kullaniliyor.");
            return;
        }

        isSaving = true;
        StateHasChanged();

        try
        {
            HttpResponseMessage response;
            if (isEdit)
            {
                var dto = new PortalPersonnelUpdateDto
                {
                    UserName = model.UserName,
                    FullName = model.FullName,
                    Email = model.Email,
                    Password = string.IsNullOrWhiteSpace(model.Password) ? null : model.Password,
                    Title = model.Title,
                    CustomerRoleId = model.CustomerRoleId,
                    OrganizationUnitId = model.OrganizationUnitId,
                    ReportsToPersonnelId = model.ReportsToPersonnelId,
                    IsActive = model.IsActive
                };
                response = await Http.PutAsJsonAsync($"api/portal/personnel/{editId}?customerId={CustomerId}", dto);
            }
            else
            {
                var dto = new PortalPersonnelCreateDto
                {
                    UserName = model.UserName,
                    FullName = model.FullName,
                    Email = model.Email,
                    Password = model.Password,
                    Title = model.Title ?? "",
                    CustomerRoleId = model.CustomerRoleId,
                    OrganizationUnitId = model.OrganizationUnitId,
                    ReportsToPersonnelId = model.ReportsToPersonnelId
                };
                response = await Http.PostAsJsonAsync($"api/portal/personnel?customerId={CustomerId}", dto);
            }

            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess(isEdit ? "Personel guncellendi." : "Personel olusturuldu.");
                Close();
                await OnSaved.InvokeAsync();
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                Toast.ShowError(string.IsNullOrWhiteSpace(errorText) ? "Islem basarisiz." : errorText);
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Hata: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Close()
    {
        isVisible = false;
    }

    private class FormModel
    {
        public string UserName { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string? Title { get; set; }
        public int CustomerRoleId { get; set; }
        public int? OrganizationUnitId { get; set; }
        public int? ReportsToPersonnelId { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
