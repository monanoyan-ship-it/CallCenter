@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs

@if (isVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-person-badge me-2"></i>
                        @(isEdit ? "Personel Duzenle" : "Yeni Personel")
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <EditForm Model="model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row g-3">
                            @if (!isEdit)
                            {
                                <div class="col-md-6">
                                    <label class="form-label">Kullanici Adi <span class="text-danger">*</span></label>
                                    <InputText class="form-control form-control-sm" @bind-Value="model.UserName" />
                                </div>
                            }
                            <div class="col-md-6">
                                <label class="form-label">Ad Soyad <span class="text-danger">*</span></label>
                                <InputText class="form-control form-control-sm" @bind-Value="model.FullName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">E-posta <span class="text-danger">*</span></label>
                                <InputText class="form-control form-control-sm" @bind-Value="model.Email" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@(isEdit ? "Sifre (bos = degismez)" : "Sifre *")</label>
                                <InputText type="password" class="form-control form-control-sm" @bind-Value="model.Password" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Unvan</label>
                                <InputText class="form-control form-control-sm" @bind-Value="model.Title" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Kullanici Tipi</label>
                                <SearchableSelect Items="userTypeItems" Value="@userTypeIdStr"
                                                  ValueChanged="OnUserTypeSelected" Placeholder="-- Tip yok --" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Organizasyon Birimi</label>
                                <SearchableSelect Items="orgUnitItems" Value="@orgUnitIdStr"
                                                  ValueChanged="OnOrgUnitSelected" Placeholder="-- Birim yok --" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Ust Yonetici</label>
                                <SearchableSelect Items="reportsToItems" Value="@reportsToIdStr"
                                                  ValueChanged="OnReportsToSelected" Placeholder="-- Ust yonetici yok --" />
                            </div>
                            @if (isEdit)
                            {
                                <div class="col-12">
                                    <div class="form-check">
                                        <InputCheckbox class="form-check-input" @bind-Value="model.IsActive" />
                                        <label class="form-check-label">Aktif</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="Close">Iptal</button>
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @(isEdit ? "Guncelle" : "Olustur")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int CustomerId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private FormModel model = new();
    private bool isVisible;
    private bool isEdit;
    private bool isSaving;
    private int? editId;
    private List<UserTypeListDto>? userTypes;
    private List<OrgUnitListDto>? orgUnits;
    private List<PortalPersonnelListDto>? allPersonnel;

    private string userTypeIdStr => model.UserTypeId?.ToString() ?? "";
    private string orgUnitIdStr => model.OrganizationUnitId?.ToString() ?? "";
    private string reportsToIdStr => model.ReportsToPersonnelId?.ToString() ?? "";

    private List<SearchableSelect.SearchSelectItem> userTypeItems =>
        userTypes?.Select(ut => new SearchableSelect.SearchSelectItem(ut.Id.ToString(), ut.Name, $"Seviye: {ut.Level}")).ToList() ?? new();

    private List<SearchableSelect.SearchSelectItem> orgUnitItems =>
        orgUnits?.Select(o => new SearchableSelect.SearchSelectItem(o.Id.ToString(), o.Name, o.ParentName)).ToList() ?? new();

    private List<SearchableSelect.SearchSelectItem> reportsToItems =>
        allPersonnel?.Where(x => x.Id != editId)
            .Select(p => new SearchableSelect.SearchSelectItem(p.Id.ToString(), p.FullName, p.UserTypeName)).ToList() ?? new();

    public async void OpenForCreate()
    {
        isEdit = false;
        editId = null;
        model = new FormModel();
        await LoadDropdowns();
        isVisible = true;
        StateHasChanged();
    }

    public async void OpenForEdit(PortalPersonnelListDto p)
    {
        isEdit = true;
        editId = p.Id;
        model = new FormModel
        {
            FullName = p.FullName,
            Email = p.Email,
            Title = p.Title,
            UserTypeId = p.UserTypeId,
            OrganizationUnitId = p.OrganizationUnitId,
            ReportsToPersonnelId = p.ReportsToPersonnelId,
            IsActive = p.IsActive
        };
        await LoadDropdowns();
        isVisible = true;
        StateHasChanged();
    }

    private async Task LoadDropdowns()
    {
        try
        {
            userTypes = await Http.GetFromJsonAsync<List<UserTypeListDto>>($"api/portal/usertypes?customerId={CustomerId}");
            orgUnits = await Http.GetFromJsonAsync<List<OrgUnitListDto>>($"api/organizations?customerId={CustomerId}");
            allPersonnel = await Http.GetFromJsonAsync<List<PortalPersonnelListDto>>($"api/portal/personnel?customerId={CustomerId}");
        }
        catch { }
    }

    private void OnUserTypeSelected(string? val)
    {
        model.UserTypeId = int.TryParse(val, out var id) ? id : null;
    }

    private void OnOrgUnitSelected(string? val)
    {
        model.OrganizationUnitId = int.TryParse(val, out var id) ? id : null;
    }

    private void OnReportsToSelected(string? val)
    {
        model.ReportsToPersonnelId = int.TryParse(val, out var id) ? id : null;
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        StateHasChanged();

        try
        {
            HttpResponseMessage response;
            if (isEdit)
            {
                var dto = new PortalPersonnelUpdateDto
                {
                    FullName = model.FullName,
                    Email = model.Email,
                    Password = model.Password,
                    Title = model.Title,
                    UserTypeId = model.UserTypeId,
                    OrganizationUnitId = model.OrganizationUnitId,
                    ReportsToPersonnelId = model.ReportsToPersonnelId,
                    IsActive = model.IsActive
                };
                response = await Http.PutAsJsonAsync($"api/portal/personnel/{editId}?customerId={CustomerId}", dto);
            }
            else
            {
                var dto = new PortalPersonnelCreateDto
                {
                    UserName = model.UserName,
                    FullName = model.FullName,
                    Email = model.Email,
                    Password = model.Password,
                    Title = model.Title ?? "",
                    UserTypeId = model.UserTypeId,
                    OrganizationUnitId = model.OrganizationUnitId,
                    ReportsToPersonnelId = model.ReportsToPersonnelId
                };
                response = await Http.PostAsJsonAsync($"api/portal/personnel?customerId={CustomerId}", dto);
            }

            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess(isEdit ? "Personel guncellendi." : "Personel olusturuldu.");
                Close();
                await OnSaved.InvokeAsync();
            }
            else
            {
                Toast.ShowError("Islem basarisiz.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Hata: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Close()
    {
        isVisible = false;
    }

    private class FormModel
    {
        public string UserName { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string? Title { get; set; }
        public int? UserTypeId { get; set; }
        public int? OrganizationUnitId { get; set; }
        public int? ReportsToPersonnelId { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
