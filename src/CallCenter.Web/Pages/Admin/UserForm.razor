@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums

@if (isVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi @(isEditMode ? "bi-pencil" : "bi-person-plus") me-2"></i>
                        @(isEditMode ? "Kullanici Duzenle" : "Yeni Kullanici")
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <EditForm Model="@formModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger py-2 small">@errorMessage</div>
                        }

                        @if (!isEditMode)
                        {
                            <div class="mb-3">
                                <label class="form-label small">Kullanici Adi</label>
                                <InputText class="form-control form-control-sm" @bind-Value="createModel.UserName" />
                                <ValidationMessage For="@(() => createModel.UserName)" />
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label small">Ad Soyad</label>
                            <InputText class="form-control form-control-sm" @bind-Value="formModel.FullName" />
                            <ValidationMessage For="@(() => formModel.FullName)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small">E-posta</label>
                            <InputText class="form-control form-control-sm" @bind-Value="formModel.Email" />
                            <ValidationMessage For="@(() => formModel.Email)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small">
                                Sifre
                                @if (isEditMode)
                                {
                                    <span class="text-muted">(bos birakirsaniz degismez)</span>
                                }
                            </label>
                            <InputText type="password" class="form-control form-control-sm" @bind-Value="formModel.Password" />
                            @if (!isEditMode)
                            {
                                <ValidationMessage For="@(() => createModel.Password)" />
                            }
                        </div>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label small">Rol</label>
                                    <InputSelect class="form-select form-select-sm" @bind-Value="formModel.RoleId">
                                        @foreach (var role in UserRoles.All)
                                        {
                                            <option value="@role.Id">@GetRoleDisplayName(role.SystemName)</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => formModel.RoleId)" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label small">Dahili</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="formModel.Extension" />
                                </div>
                            </div>
                        </div>

                        @if (isEditMode)
                        {
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="updateModel.IsActive" />
                                <label class="form-check-label small">Aktif</label>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="Close">Iptal</button>
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-check-lg me-1"></i>Kaydet
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool isVisible;
    private bool isEditMode;
    private bool isSaving;
    private string? errorMessage;
    private int editUserId;

    // Ortak alanlar icin wrapper
    private UserCreateDto createModel = new();
    private UserUpdateDto updateModel = new();

    // Hangi modeli kullaniyoruz
    private FormModel formModel = new();

    public void OpenForCreate()
    {
        isEditMode = false;
        createModel = new() { RoleId = UserRoles.Ids.Agent };
        updateModel = new();
        formModel = new() { RoleId = UserRoles.Ids.Agent };
        errorMessage = null;
        isVisible = true;
        StateHasChanged();
    }

    public void OpenForEdit(UserListDto user)
    {
        isEditMode = true;
        editUserId = user.Id;
        updateModel = new()
        {
            FullName = user.FullName,
            Email = user.Email,
            RoleId = user.RoleId,
            Extension = user.Extension,
            IsActive = user.IsActive
        };
        formModel = new()
        {
            FullName = user.FullName,
            Email = user.Email,
            RoleId = user.RoleId,
            Extension = user.Extension
        };
        errorMessage = null;
        isVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        isVisible = false;
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            HttpResponseMessage response;

            if (isEditMode)
            {
                updateModel.FullName = formModel.FullName;
                updateModel.Email = formModel.Email;
                updateModel.RoleId = formModel.RoleId;
                updateModel.Extension = formModel.Extension;
                updateModel.Password = formModel.Password;

                response = await Http.PutAsJsonAsync($"api/users/{editUserId}", updateModel);
            }
            else
            {
                createModel.FullName = formModel.FullName;
                createModel.Email = formModel.Email;
                createModel.RoleId = formModel.RoleId;
                createModel.Extension = formModel.Extension;
                createModel.Password = formModel.Password ?? "";

                // Create modunda sifre zorunlu
                if (string.IsNullOrWhiteSpace(createModel.Password))
                {
                    errorMessage = "Sifre zorunludur.";
                    return;
                }

                response = await Http.PostAsJsonAsync("api/users", createModel);
            }

            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess(isEditMode ? "Kullanici guncellendi." : "Kullanici olusturuldu.");
                isVisible = false;
                await OnSaved.InvokeAsync();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                errorMessage = error?.Message ?? "Islem basarisiz.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Hata: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static readonly Dictionary<string, string> RoleDisplayNames = new(StringComparer.OrdinalIgnoreCase)
    {
        { "Admin", "Yonetici" },
        { "Supervisor", "Supervisor" },
        { "Agent", "Temsilci" },
        { "CustomerUser", "Musteri" }
    };

    private static string GetRoleDisplayName(string systemName)
        => RoleDisplayNames.TryGetValue(systemName, out var name) ? name : systemName;

    private record ErrorMsg(string? Message);

    // Formda ortak olarak kullanilan model
    public class FormModel
    {
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? Password { get; set; }
        public int RoleId { get; set; }
        public string? Extension { get; set; }
    }
}
