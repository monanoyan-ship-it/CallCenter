@page "/admin/kvkk"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject NavigationManager Nav
@using CallCenter.Shared.DTOs

<PageTitle>KVKK Dashboard - CorpLynk</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-shield-check me-2 text-primary"></i>KVKK Uyumluluk Dashboard
    </h4>
    <select class="form-select form-select-sm" style="width:220px" @bind="selectedCustomerId" @bind:after="LoadDashboard">
        <option value="0">Tum Musteriler</option>
        @foreach (var c in customers)
        {
            <option value="@c.Id">@c.Name</option>
        }
    </select>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (dashboard != null)
{
    @* ─── UYARI BANNER'LARI ─── *@
    @if (dashboard.OverdueRequests > 0 || dashboard.ActiveBreaches > 0)
    {
        <div class="alert alert-danger d-flex align-items-start mb-3">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-4 mt-1"></i>
            <div>
                <strong>Dikkat Gerektiren Durumlar:</strong>
                <ul class="mb-0 mt-1">
                    @if (dashboard.OverdueRequests > 0)
                    {
                        <li><strong>@dashboard.OverdueRequests</strong> basvurunun 30 gunluk yasal suresi gecti — <a href="admin/kvkk/requests" class="alert-link">Basvurulari Gor</a></li>
                    }
                    @if (dashboard.ActiveBreaches > 0)
                    {
                        <li><strong>@dashboard.ActiveBreaches</strong> aktif veri ihlali mevcut — <a href="admin/kvkk/breaches" class="alert-link">Ihlalleri Gor</a></li>
                    }
                </ul>
            </div>
        </div>
    }

    @* ─── İSTATİSTİK KARTLARI (Satır 1 - Kritik) ─── *@
    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 cursor-pointer" @onclick='() => Nav.NavigateTo("admin/kvkk/requests")'>
                <div class="card-body text-center">
                    <i class="bi bi-envelope-paper fs-2 text-warning d-block mb-1"></i>
                    <h3 class="mb-0">@dashboard.PendingRequests</h3>
                    <small class="text-muted">Bekleyen Basvuru</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 cursor-pointer" @onclick='() => Nav.NavigateTo("admin/kvkk/requests")'>
                <div class="card-body text-center">
                    <i class="bi bi-exclamation-triangle fs-2 text-danger d-block mb-1"></i>
                    <h3 class="mb-0 @(dashboard.OverdueRequests > 0 ? "text-danger" : "")">@dashboard.OverdueRequests</h3>
                    <small class="text-muted">Geciken Basvuru</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 cursor-pointer" @onclick='() => Nav.NavigateTo("admin/kvkk/breaches")'>
                <div class="card-body text-center">
                    <i class="bi bi-shield-fill-x fs-2 text-danger d-block mb-1"></i>
                    <h3 class="mb-0 @(dashboard.ActiveBreaches > 0 ? "text-danger" : "")">@dashboard.ActiveBreaches</h3>
                    <small class="text-muted">Aktif Ihlal</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 cursor-pointer" @onclick='() => Nav.NavigateTo("admin/kvkk/consents")'>
                <div class="card-body text-center">
                    <i class="bi bi-file-earmark-check fs-2 text-success d-block mb-1"></i>
                    <h3 class="mb-0">@dashboard.TotalConsents</h3>
                    <small class="text-muted">Toplam Riza</small>
                    @if (dashboard.RevokedConsents > 0)
                    {
                        <div><small class="text-muted">@dashboard.RevokedConsents iptal</small></div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ─── İSTATİSTİK KARTLARI (Satır 2 - Yönetim) ─── *@
    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 cursor-pointer" @onclick='() => Nav.NavigateTo("admin/kvkk/privacy-notices")'>
                <div class="card-body text-center">
                    <i class="bi bi-file-earmark-text fs-2 text-primary d-block mb-1"></i>
                    <h3 class="mb-0">@dashboard.ActivePrivacyNotices</h3>
                    <small class="text-muted">Aydinlatma Metni</small>
                    @if (dashboard.TotalPrivacyNotices > 0)
                    {
                        <div><small class="text-muted">/ @dashboard.TotalPrivacyNotices toplam</small></div>
                    }
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 cursor-pointer" @onclick='() => Nav.NavigateTo("admin/kvkk/settings")'>
                <div class="card-body text-center">
                    <i class="bi bi-clock-history fs-2 text-info d-block mb-1"></i>
                    <h3 class="mb-0">@dashboard.RetentionPolicies</h3>
                    <small class="text-muted">Saklama Politikasi</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 cursor-pointer" @onclick='() => Nav.NavigateTo("admin/kvkk/inventory")'>
                <div class="card-body text-center">
                    <i class="bi bi-database fs-2 text-primary d-block mb-1"></i>
                    <h3 class="mb-0">@dashboard.InventoryItems</h3>
                    <small class="text-muted">Veri Envanteri</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 cursor-pointer" @onclick='() => Nav.NavigateTo("admin/kvkk/transfers")'>
                <div class="card-body text-center">
                    <i class="bi bi-globe fs-2 text-info d-block mb-1"></i>
                    <h3 class="mb-0">@dashboard.ActiveTransfers</h3>
                    <small class="text-muted">Yurt Disi Aktarim</small>
                </div>
            </div>
        </div>
    </div>

    @* ─── İMHA + UYUMLULUK KONTROL ─── *@
    <div class="row g-3 mb-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100 cursor-pointer" @onclick='() => Nav.NavigateTo("admin/kvkk/settings")'>
                <div class="card-body text-center">
                    <i class="bi bi-trash fs-2 text-warning d-block mb-1"></i>
                    <h3 class="mb-0">@dashboard.DestructionCount</h3>
                    <small class="text-muted">Imha Kaydi</small>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white">
                    <strong><i class="bi bi-clipboard-check me-1"></i>Uyumluluk Kontrol Listesi</strong>
                </div>
                <div class="card-body py-2">
                    @{ var checks = GetComplianceChecks(); }
                    @foreach (var check in checks)
                    {
                        <div class="d-flex align-items-center py-1 border-bottom">
                            <i class="bi @(check.IsOk ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger") me-2"></i>
                            <span class="@(check.IsOk ? "" : "text-danger")">@check.Label</span>
                        </div>
                    }
                    @{
                        var score = checks.Count(c => c.IsOk);
                        var total = checks.Count;
                        var pct = total > 0 ? (int)(score * 100.0 / total) : 0;
                    }
                    <div class="mt-2">
                        <div class="d-flex justify-content-between mb-1">
                            <small class="fw-bold">Uyumluluk: @score / @total</small>
                            <small class="fw-bold @(pct >= 80 ? "text-success" : pct >= 50 ? "text-warning" : "text-danger")">%@pct</small>
                        </div>
                        <div class="progress" style="height:8px">
                            <div class="progress-bar @(pct >= 80 ? "bg-success" : pct >= 50 ? "bg-warning" : "bg-danger")"
                                 style="width:@(pct)%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ─── SON BAŞVURULAR + SON İHLALLER ─── *@
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <strong><i class="bi bi-envelope-paper me-1"></i>Son Basvurular</strong>
                    <a href="admin/kvkk/requests" class="btn btn-sm btn-outline-primary">Tumu</a>
                </div>
                <div class="card-body p-0">
                    @if (dashboard.RecentRequests.Count == 0)
                    {
                        <div class="text-center text-muted py-4">Basvuru yok</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Basvuran</th>
                                        <th>Tip</th>
                                        <th>Durum</th>
                                        <th>Son Tarih</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in dashboard.RecentRequests)
                                    {
                                        <tr>
                                            <td>@r.RequesterName</td>
                                            <td><small>@r.RequestTypeName</small></td>
                                            <td>
                                                <span class="badge @(r.IsOverdue ? "bg-danger" : "bg-secondary")">
                                                    @r.StatusName @(r.IsOverdue ? "(Gecikti)" : "")
                                                </span>
                                            </td>
                                            <td><small>@r.Deadline.ToString("dd.MM.yyyy")</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <strong><i class="bi bi-shield-fill-x me-1"></i>Son Ihlaller</strong>
                    <a href="admin/kvkk/breaches" class="btn btn-sm btn-outline-danger">Tumu</a>
                </div>
                <div class="card-body p-0">
                    @if (dashboard.RecentBreaches.Count == 0)
                    {
                        <div class="text-center text-muted py-4">Ihlal yok</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Baslik</th>
                                        <th>Ciddiyet</th>
                                        <th>Durum</th>
                                        <th>Bildirim Suresi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in dashboard.RecentBreaches)
                                    {
                                        <tr>
                                            <td>@b.Title</td>
                                            <td>
                                                <span class="badge @GetSeverityBadge(b.SeverityId)">@b.SeverityName</span>
                                            </td>
                                            <td><small>@b.StatusName</small></td>
                                            <td>
                                                <small class="@(b.IsOverdue ? "text-danger fw-bold" : "")">
                                                    @b.NotificationDeadline.ToString("dd.MM.yyyy HH:mm")
                                                </small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private KvkkDashboardDto? dashboard;
    private List<CustomerSimpleDto> customers = new();
    private bool isLoading = true;
    private int selectedCustomerId;

    protected override async Task OnInitializedAsync()
    {
        try { customers = await Http.GetFromJsonAsync<List<CustomerSimpleDto>>("api/supervisor/customers") ?? new(); } catch { }
        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        isLoading = true;
        try
        {
            var url = "api/kvkk/dashboard";
            if (selectedCustomerId > 0) url += $"?customerId={selectedCustomerId}";
            dashboard = await Http.GetFromJsonAsync<KvkkDashboardDto>(url);
        }
        catch { }
        finally { isLoading = false; }
    }

    private List<ComplianceCheck> GetComplianceChecks()
    {
        if (dashboard == null) return new();
        return new List<ComplianceCheck>
        {
            new("Aydinlatma metni tanimli", dashboard.ActivePrivacyNotices > 0),
            new("Riza kayitlari mevcut", dashboard.TotalConsents > 0),
            new("Geciken basvuru yok", dashboard.OverdueRequests == 0),
            new("Aktif ihlal yok", dashboard.ActiveBreaches == 0),
            new("Saklama politikasi tanimli", dashboard.RetentionPolicies > 0),
            new("Imha kaydi mevcut", dashboard.DestructionCount > 0),
            new("Veri envanteri olusturulmus", dashboard.InventoryItems > 0)
        };
    }

    private static string GetSeverityBadge(int severityId) => severityId switch
    {
        1 => "bg-success",
        2 => "bg-warning text-dark",
        3 => "bg-danger",
        4 => "bg-dark",
        _ => "bg-secondary"
    };

    private record ComplianceCheck(string Label, bool IsOk);
}
