    // ═══════════════════════════════════════════════════
    // NAVİGASYON
    // ═══════════════════════════════════════════════════

    private async Task DownloadSetupPackage()
    {
        isDownloadingSetup = true;
        StateHasChanged();
        try
        {
            var response = await Http.PostAsync($"api/customers/{Id}/setup-package", null);
            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                await JS.InvokeVoidAsync("downloadFile", "setup.dat", "application/octet-stream", bytes);
                Toast.ShowSuccess("Kurulum paketi indirildi.");
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(error?.Message ?? "Paket olusturulamadi.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
        finally { isDownloadingSetup = false; }
    }

    private void GoBack() => Nav.NavigateTo("admin/customers");
    private void GoToPortal() => Nav.NavigateTo($"portal/dashboard?customerId={Id}");

    private record ErrorMsg(string? Message);
    private record PasswordResetResult(string? Password);
