    private async Task LoadModules()
    {
        isLoadingModules = true;
        StateHasChanged();
        try
        {
            portalModules = await Http.GetFromJsonAsync<List<PortalModuleDto>>($"api/customers/{Id}/modules");
        }
        catch (Exception ex) { Toast.ShowError($"Moduller yuklenemedi: {ex.Message}"); }
        finally { isLoadingModules = false; }
    }

    private async Task SyncMissingModules()
    {
        isSyncingModules = true;
        StateHasChanged();
        try
        {
            var response = await Http.PostAsync($"api/customers/{Id}/modules/sync", null);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SyncModulesResult>();
                if (result?.AddedCount > 0)
                {
                    Toast.ShowSuccess($"{result.AddedCount} eksik modul DB'ye eklendi. Toggle ile aktif edebilirsiniz.");
                    await LoadModules();
                }
                else
                {
                    Toast.ShowSuccess("Tum moduller zaten senkronize.");
                }
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(error?.Message ?? "Senkronizasyon basarisiz.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
        finally { isSyncingModules = false; }
    }

    private async Task ToggleModule(PortalModuleDto mod)
    {
        isTogglingModule = true;
        try
        {
            HttpResponseMessage response;
            if (mod.IsActive)
            {
                response = await Http.PostAsync($"api/customers/{Id}/modules/{mod.Id}/deactivate", null);
            }
            else
            {
                response = await Http.PostAsJsonAsync($"api/customers/{Id}/modules/assign",
                    new AssignModulesRequest { ModuleIds = new[] { mod.Id } });
            }

            if (response.IsSuccessStatusCode)
            {
                mod.IsActive = !mod.IsActive;
                Toast.ShowSuccess($"{mod.SystemName} {(mod.IsActive ? "aktif" : "pasif")} edildi.");
            }
            else
            {
                Toast.ShowError("Modul guncellenemedi.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
        finally { isTogglingModule = false; }
    }

