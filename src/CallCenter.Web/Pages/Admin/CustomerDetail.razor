    private async Task LoadSubscriptions()
    {
        isLoadingSubscriptions = true;
        StateHasChanged();
        try
        {
            subscriptions = await Http.GetFromJsonAsync<List<SubscriptionDto>>($"api/service-subscriptions?customerId={Id}");
        }
        catch (Exception ex) { Toast.ShowError($"Abonelikler yuklenemedi: {ex.Message}"); }
        finally { isLoadingSubscriptions = false; }
    }

    private async Task OpenAddSubscription()
    {
        addSubError = null;
        newSubServiceId = 0;
        newSubPrice = null;
        newSubNotes = null;
        if (premiumServices == null)
        {
            try
            {
                premiumServices = await Http.GetFromJsonAsync<List<ServiceTypeDto>>("api/services/premium");
            }
            catch (Exception ex) { Toast.ShowError($"Hizmet listesi yuklenemedi: {ex.Message}"); }
        }
        showAddSubscription = true;
    }

    private async Task SaveNewSubscription()
    {
        addSubError = null;
        if (newSubServiceId == 0) { addSubError = "Hizmet secin."; return; }

        isSavingSubscription = true;
        StateHasChanged();
        try
        {
            var dto = new SubscriptionCreateDto
            {
                CustomerId = Id,
                ServiceTypeId = newSubServiceId,
                MonthlyPrice = newSubPrice,
                Notes = newSubNotes
            };
            var response = await Http.PostAsJsonAsync("api/service-subscriptions", dto);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Hizmet aboneligi eklendi.");
                showAddSubscription = false;
                await LoadSubscriptions();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                addSubError = error?.Message ?? "Islem basarisiz.";
            }
        }
        catch (Exception ex) { addSubError = $"Hata: {ex.Message}"; }
        finally { isSavingSubscription = false; }
    }

    private async Task SuspendSubscription(SubscriptionDto sub)
    {
        isUpdatingSubscription = true;
        StateHasChanged();
        try
        {
            var dto = new SubscriptionUpdateDto { StatusId = 2 };
            var response = await Http.PutAsJsonAsync($"api/service-subscriptions/{sub.Uid}", dto);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess($"'{sub.ServiceName}' askiya alindi.");
                await LoadSubscriptions();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(error?.Message ?? "Islem basarisiz.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
        finally { isUpdatingSubscription = false; }
    }

    private async Task ReactivateSubscription(SubscriptionDto sub)
    {
        isUpdatingSubscription = true;
        StateHasChanged();
        try
        {
            var dto = new SubscriptionUpdateDto { StatusId = 1 };
            var response = await Http.PutAsJsonAsync($"api/service-subscriptions/{sub.Uid}", dto);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess($"'{sub.ServiceName}' yeniden aktif.");
                await LoadSubscriptions();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(error?.Message ?? "Islem basarisiz.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
        finally { isUpdatingSubscription = false; }
    }

    private async Task CancelSubscription(SubscriptionDto sub)
    {
        isUpdatingSubscription = true;
        StateHasChanged();
        try
        {
            var response = await Http.DeleteAsync($"api/service-subscriptions/{sub.Uid}");
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess($"'{sub.ServiceName}' iptal edildi.");
                await LoadSubscriptions();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(error?.Message ?? "Islem basarisiz.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
        finally { isUpdatingSubscription = false; }
    }

