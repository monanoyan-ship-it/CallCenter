@page "/admin/customers/{Id:int}"
@attribute [Authorize(Roles = "Admin,Supervisor")]
@inject HttpClient Http
@inject NavigationManager Nav
@inject ToastService Toast
@inject IJSRuntime JS
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums
@using CallCenter.Web.Pages.Portal

<PageTitle>Musteri Detay - CorpLynk</PageTitle>

@* ─── HEADER ─── *@
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-outline-secondary btn-sm" @onclick="GoBack" title="Geri">
            <i class="bi bi-arrow-left"></i>
        </button>
        <h4 class="mb-0">
            <i class="bi bi-building me-2 text-primary"></i>
            @if (customer != null)
            {
                @customer.Name
                @if (!customer.IsActive)
                {
                    <span class="badge bg-secondary-subtle text-secondary ms-2 fs-6">Pasif</span>
                }
            }
            else if (isLoadingGeneral)
            {
                <span class="placeholder-glow"><span class="placeholder col-4"></span></span>
            }
        </h4>
    </div>
    <div class="d-flex gap-2">
    </div>
</div>

@* ─── TABS ─── *@
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button class="nav-link @(activeTab == "genel" ? "active" : "")" @onclick='() => SetTab("genel")'>
            <i class="bi bi-info-circle me-1"></i>Genel
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "personel" ? "active" : "")" @onclick='() => SetTab("personel")'>
            <i class="bi bi-person-badge me-1"></i>Personel
            @if (personnel != null)
            {
                <span class="badge bg-primary-subtle text-primary rounded-pill ms-1">@personnel.Count</span>
            }
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "organizasyon" ? "active" : "")" @onclick='() => SetTab("organizasyon")'>
            <i class="bi bi-diagram-3 me-1"></i>Organizasyon
            @if (orgUnits != null)
            {
                <span class="badge bg-info-subtle text-info rounded-pill ms-1">@orgUnits.Count</span>
            }
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "kuyruklar" ? "active" : "")" @onclick='() => SetTab("kuyruklar")'>
            <i class="bi bi-people-fill me-1"></i>Kuyruklar
            @if (queues != null)
            {
                <span class="badge bg-info-subtle text-info rounded-pill ms-1">@queues.Count</span>
            }
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "odemeler" ? "active" : "")" @onclick='() => SetTab("odemeler")'>
            <i class="bi bi-credit-card me-1"></i>Odemeler
            @if (billingPeriods != null)
            {
                var unpaidCount = billingPeriods.Count(b => !b.IsPaid);
                <span class="badge @(unpaidCount > 0 ? "bg-danger" : "bg-success-subtle text-success") rounded-pill ms-1">
                    @(unpaidCount > 0 ? unpaidCount.ToString() : billingPeriods.Count.ToString())
                </span>
            }
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "hizmetler" ? "active" : "")" @onclick='() => SetTab("hizmetler")'>
            <i class="bi bi-box-seam me-1"></i>Hizmetler
            @if (subscriptions != null)
            {
                <span class="badge bg-info-subtle text-info rounded-pill ms-1">@subscriptions.Count(s => s.StatusId == 1)</span>
            }
        </button>
    </li>
</ul>

@* ═══════════════════════════════════════════════════════════ *@
@* GENEL SEKMESİ                                               *@
@* ═══════════════════════════════════════════════════════════ *@
@if (activeTab == "genel")
{
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            @if (isLoadingGeneral)
            {
                <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
            }
            else if (customer != null)
            {
                <EditForm Model="@editModel" OnValidSubmit="SaveGeneral">
                    <DataAnnotationsValidator />
                    @if (!string.IsNullOrEmpty(generalError))
                    {
                        <div class="alert alert-danger py-2 small">@generalError</div>
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small">Firma Adi</label>
                            <InputText class="form-control form-control-sm" @bind-Value="editModel.Name" />
                            <ValidationMessage For="@(() => editModel.Name)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">Vergi No</label>
                            <InputText class="form-control form-control-sm" @bind-Value="editModel.TaxNumber" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small">Adres</label>
                            <InputTextArea class="form-control form-control-sm" @bind-Value="editModel.Address" rows="2" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">Telefon</label>
                            <InputText class="form-control form-control-sm" @bind-Value="editModel.Phone" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">E-posta</label>
                            <InputText class="form-control form-control-sm" @bind-Value="editModel.Email" />
                            <ValidationMessage For="@(() => editModel.Email)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Maks. Kullanici</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="editModel.MaxUsers" />
                            <small class="text-muted">0 = limitsiz</small>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Aylik Birim Fiyat (TL/kullanici)</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="editModel.MonthlyUnitPrice" />
                        </div>
                        <div class="col-md-4">
                            <div class="form-check mt-4">
                                <InputCheckbox class="form-check-input" @bind-Value="editModel.IsActive" />
                                <label class="form-check-label small">Aktif</label>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@isSavingGeneral">
                            @if (isSavingGeneral)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-check-lg me-1"></i>Kaydet
                        </button>
                    </div>
                </EditForm>
                @if (customer.BillingAnchorDay.HasValue)
                {
                    <div class="mt-3 p-2 bg-light rounded d-inline-block">
                        <i class="bi bi-calendar-event me-1 text-primary"></i>
                        <span class="small">Tahakkuk Gunu: <strong>Ayin @(customer.BillingAnchorDay.Value)'i</strong></span>
                    </div>
                }
                else
                {
                    <div class="mt-3 p-2 bg-warning-subtle rounded d-inline-block">
                        <i class="bi bi-exclamation-triangle me-1 text-warning"></i>
                        <span class="small text-muted">Ilk tahakkuk henuz olusturulmadi. Odemeler sekmesinden olusturabilirsiniz.</span>
                    </div>
                }
            }
        </div>
    </div>

    @* ─── ADMİN BİLGİ KARTI ─── *@
    @if (customer?.AdminInfo != null)
    {
        var admin = customer.AdminInfo;
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-header bg-dark text-white py-2">
                <i class="bi bi-person-fill-lock me-2"></i>Musteri Admin Kullanicisi
            </div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-md-3">
                        <small class="text-muted d-block">Kullanici Adi</small>
                        <span class="font-monospace text-primary fw-medium">@admin.UserName</span>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted d-block">Ad Soyad</small>
                        <span class="fw-medium">@admin.FullName</span>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted d-block">E-posta</small>
                        <span class="small">@(admin.Email ?? "-")</span>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted d-block">Son Giris</small>
                        <span class="small @(admin.LastLoginAt == null ? "text-warning" : "")">
                            @(admin.LastLoginAt?.ToString("dd.MM.yyyy HH:mm") ?? "Henuz giris yapmadi")
                        </span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 mt-3 pt-2 border-top">
                    <span class="badge @(admin.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">
                        @(admin.IsActive ? "Aktif" : "Pasif")
                    </span>
                    <button class="btn btn-outline-warning btn-sm ms-auto" @onclick="ResetAdminPassword" disabled="@isResettingPassword">
                        @if (isResettingPassword)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-key me-1"></i>Sifre Sifirla
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(tempAdminPassword))
                {
                    <div class="alert alert-warning mt-2 py-2 small d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <div>
                            Yeni gecici sifre: <strong class="font-monospace user-select-all">@tempAdminPassword</strong>
                            <span class="text-muted ms-2">— Bu sifre bir kez gosterilir, not edin.</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

@* ═══════════════════════════════════════════════════════════ *@
@* PERSONEL SEKMESİ                                            *@
@* ═══════════════════════════════════════════════════════════ *@
@if (activeTab == "personel")
{
    <div class="d-flex justify-content-end mb-2">
        <button class="btn btn-primary btn-sm" @onclick="OpenCreatePersonnel">
            <i class="bi bi-plus-lg me-1"></i>Yeni Personel
        </button>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (isLoadingPersonnel)
            {
                <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
            }
            else if (personnel == null || personnel.Count == 0)
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-person-x fs-1 d-block mb-2 opacity-25"></i>
                    <span>Personel bulunamadi</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ad Soyad</th>
                                <th>E-posta</th>
                                <th>Unvan</th>
                                <th>Rol</th>
                                <th>Durum</th>
                                <th style="width: 140px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in personnel)
                            {
                                <tr class="@(!item.IsActive ? "table-secondary" : "")">
                                    <td class="fw-medium">@item.FullName</td>
                                    <td class="text-muted small">@item.Email</td>
                                    <td class="small">@item.Title</td>
                                    <td>
                                        @if (item.CustomerRoleName != null)
                                        {
                                            <span class="badge bg-info-subtle text-info">@item.CustomerRoleName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">Pasif</span>
                                        }
                                        @if (item.IsLocked)
                                        {
                                            <span class="badge bg-danger-subtle text-danger ms-1">Kilitli</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-outline-primary btn-sm me-1" title="Duzenle"
                                                @onclick="() => OpenEditPersonnel(item)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        @if (item.IsLocked)
                                        {
                                            <button class="btn btn-outline-warning btn-sm me-1" title="Kilidi Kaldir"
                                                    @onclick="() => UnlockPersonnel(item)">
                                                <i class="bi bi-unlock"></i>
                                            </button>
                                        }
                                        @if (item.IsActive)
                                        {
                                            <button class="btn btn-outline-danger btn-sm" title="Deaktive Et"
                                                    @onclick="() => ConfirmDeactivatePersonnel(item)">
                                                <i class="bi bi-person-x"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-success btn-sm" title="Aktiflestir"
                                                    @onclick="() => ReactivatePersonnel(item)">
                                                <i class="bi bi-person-check"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <PersonnelForm @ref="personnelForm" CustomerIdParam="@Id.ToString()" OnSaved="LoadPersonnel" AllowEditUserName="true" />
    <ConfirmDialog @ref="personnelConfirmDialog" OnConfirm="ExecuteDeactivatePersonnel"
                   Message="@($"'{deactivateTarget?.FullName}' personelini deaktive etmek istediginize emin misiniz?")" />
}

@* ═══════════════════════════════════════════════════════════ *@
@* ORGANİZASYON SEKMESİ                                        *@
@* ═══════════════════════════════════════════════════════════ *@
@if (activeTab == "organizasyon")
{
    <div class="d-flex justify-content-end mb-2">
        <a href="admin/organizations" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-box-arrow-up-right me-1"></i>Organizasyon Yonetimine Git
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (isLoadingOrg)
            {
                <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
            }
            else if (orgUnits == null || orgUnits.Count == 0)
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-diagram-3 fs-1 d-block mb-2 opacity-25"></i>
                    <span>Organizasyon birimi bulunamadi</span>
                    <div class="mt-2">
                        <a href="admin/organizations" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-plus-lg me-1"></i>Organizasyon Ekle
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Birim Adi</th>
                                <th>Kod</th>
                                <th>Tip</th>
                                <th>Ust Birim</th>
                                <th class="text-center">Personel</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in orgUnits)
                            {
                                <tr class="@(!o.IsActive ? "table-secondary" : "")">
                                    <td class="fw-medium">@o.Name</td>
                                    <td class="text-muted small">@(o.Code ?? "-")</td>
                                    <td>
                                        @if (o.TypeIcon != null)
                                        {
                                            <i class="bi @o.TypeIcon me-1"></i>
                                        }
                                        <span class="small">@(o.TypeName ?? "-")</span>
                                    </td>
                                    <td class="text-muted small">@(o.ParentName ?? "-")</td>
                                    <td class="text-center">
                                        <span class="badge bg-primary-subtle text-primary rounded-pill">@o.PersonnelCount</span>
                                    </td>
                                    <td>
                                        @if (o.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">Pasif</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@* ═══════════════════════════════════════════════════════════ *@
@* KUYRUKLAR SEKMESİ                                           *@
@* ═══════════════════════════════════════════════════════════ *@
@if (activeTab == "kuyruklar")
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (isLoadingQueues)
            {
                <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
            }
            else if (queues == null || queues.Count == 0)
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-people fs-1 d-block mb-2 opacity-25"></i>
                    <span>Kuyruk bulunamadi</span>
                    <div class="mt-2">
                        <a href="admin/queues" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-plus-lg me-1"></i>Kuyruk Yapilandirmasina Git
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Kuyruk Adi</th>
                                <th>Aciklama</th>
                                <th class="text-center">Temsilci</th>
                                <th class="text-center">Maks. Bekleme</th>
                                <th>Durum</th>
                                <th style="width: 60px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in queues)
                            {
                                <tr class="@(!q.IsActive ? "table-secondary" : "")">
                                    <td class="fw-medium">@q.Name</td>
                                    <td class="text-muted small">@(q.Description ?? "-")</td>
                                    <td class="text-center">
                                        <span class="badge bg-primary-subtle text-primary rounded-pill">@q.AgentCount</span>
                                    </td>
                                    <td class="text-center small text-muted">@q.MaxWaitTimeSeconds sn</td>
                                    <td>
                                        @if (q.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">Pasif</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="admin/queues" class="btn btn-outline-secondary btn-sm" title="Yapilandir">
                                            <i class="bi bi-gear"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@* ═══════════════════════════════════════════════════════════ *@
@* ODEMELER SEKMESİ                                            *@
@* ═══════════════════════════════════════════════════════════ *@
@if (activeTab == "odemeler")
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (isLoadingBilling)
            {
                <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
            }
            else if (customer?.BillingAnchorDay == null && (billingPeriods == null || billingPeriods.Count == 0))
            {
                @* Ilk tahakkuk henuz olusturulmadi *@
                <div class="text-center py-4">
                    <i class="bi bi-credit-card fs-1 d-block mb-2 opacity-25"></i>
                    <span>Ilk tahakkuk henuz olusturulmadi</span>
                    <div class="mt-3">
                        <button class="btn btn-primary btn-sm" @onclick="OpenCreateBillingModal">
                            <i class="bi bi-plus-lg me-1"></i>Ilk Tahakkuku Olustur
                        </button>
                    </div>
                </div>
            }
            else if (billingPeriods == null || billingPeriods.Count == 0)
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-credit-card fs-1 d-block mb-2 opacity-25"></i>
                    <span>Faturalama donemi bulunamadi</span>
                    <div class="mt-1 small text-muted">Musteriler sayfasindan toplu donem olusturabilirsiniz.</div>
                </div>
            }
            else
            {
                @if (billingPeriods.Any(b => !b.IsPaid))
                {
                    <div class="alert alert-danger m-3 py-2 small d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <span><strong>@billingPeriods.Count(b => !b.IsPaid)</strong> odenmemis donem bulunuyor. Toplam: <strong>@billingPeriods.Where(b => !b.IsPaid).Sum(b => b.TotalAmount).ToString("N2") TL</strong></span>
                    </div>
                }
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th></th>
                                <th>Donem</th>
                                <th>Donem Tarihi</th>
                                <th class="text-center">Operator</th>
                                <th class="text-end">Operator Tutari</th>
                                <th class="text-end">Hizmet Tutari</th>
                                <th class="text-end">Toplam</th>
                                <th>Durum</th>
                                <th>Not</th>
                                <th style="width: 160px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in billingPeriods)
                            {
                                <tr class="@GetBillingRowClass(b.StatusId)">
                                    <td>
                                        @if (b.ServiceLines.Count > 0)
                                        {
                                            <button class="btn btn-sm btn-link p-0" @onclick="() => ToggleBillingDetail(b.Id)">
                                                <i class="bi @(expandedBillingId == b.Id ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                            </button>
                                        }
                                    </td>
                                    <td class="fw-medium">@b.Month.ToString("00")/@b.Year</td>
                                    <td class="small text-muted">@b.PeriodStartDate.ToString("dd.MM.yyyy") — @b.PeriodEndDate.ToString("dd.MM.yyyy")</td>
                                    <td class="text-center">@b.UserCount</td>
                                    <td class="text-end small">
                                        <span class="text-muted">@b.UserCount x @b.UnitPrice.ToString("N2") =</span> @b.Amount.ToString("N2") TL
                                    </td>
                                    <td class="text-end small">
                                        @if (b.ServiceAmount > 0)
                                        {
                                            <span>@b.ServiceAmount.ToString("N2") TL</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-end fw-semibold">@b.TotalAmount.ToString("N2") TL</td>
                                    <td>
                                        @{var badge = GetStatusBadge(b.StatusId);}
                                        <span class="badge @badge.Css">@badge.Text</span>
                                    </td>
                                    <td class="small text-muted">@(b.Notes ?? "-")</td>
                                    <td>
                                        @if (b.StatusId == BillingPeriodStatuses.Ids.Draft)
                                        {
                                            @* Draft -> Invoiced *@
                                            <button class="btn btn-info btn-sm me-1" title="Faturala"
                                                    @onclick="() => ChangeStatus(b, BillingPeriodStatuses.Ids.Invoiced)" disabled="@isUpdatingBilling">
                                                <i class="bi bi-receipt"></i>
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm" title="Donemi sil"
                                                    @onclick="() => ConfirmDeleteBilling(b)" disabled="@isUpdatingBilling">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                        else if (b.StatusId == BillingPeriodStatuses.Ids.Invoiced)
                                        {
                                            @* Invoiced -> Paid *@
                                            <button class="btn btn-success btn-sm me-1" title="Odendi"
                                                    @onclick="() => ChangeStatus(b, BillingPeriodStatuses.Ids.Paid)" disabled="@isUpdatingBilling">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                            @* Invoiced -> Draft (geri al) *@
                                            <button class="btn btn-outline-warning btn-sm" title="Tahakkuka geri al"
                                                    @onclick="() => ChangeStatus(b, BillingPeriodStatuses.Ids.Draft)" disabled="@isUpdatingBilling">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        }
                                        else if (b.StatusId == BillingPeriodStatuses.Ids.Paid)
                                        {
                                            @* Paid -> Invoiced (geri al) *@
                                            <button class="btn btn-outline-secondary btn-sm" title="Odenmedi olarak isaretle"
                                                    @onclick="() => ChangeStatus(b, BillingPeriodStatuses.Ids.Invoiced)" disabled="@isUpdatingBilling">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        }
                                        else if (b.StatusId == BillingPeriodStatuses.Ids.Overdue)
                                        {
                                            @* Overdue -> Paid *@
                                            <button class="btn btn-success btn-sm me-1" title="Odendi"
                                                    @onclick="() => ChangeStatus(b, BillingPeriodStatuses.Ids.Paid)" disabled="@isUpdatingBilling">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                                @if (expandedBillingId == b.Id && b.ServiceLines.Count > 0)
                                {
                                    <tr class="table-light">
                                        <td colspan="10" class="ps-5 py-2">
                                            <div class="small">
                                                <strong class="text-muted d-block mb-1">
                                                    <i class="bi bi-receipt me-1"></i>Hizmet Detayi (@b.Month.ToString("00")/@b.Year)
                                                </strong>
                                                <table class="table table-sm table-borderless mb-0" style="max-width:500px;">
                                                    <tbody>
                                                        <tr class="text-muted border-bottom">
                                                            <td class="fw-medium">Operator Ucreti</td>
                                                            <td class="text-end">@b.UserCount kisi x @b.UnitPrice.ToString("N2") TL</td>
                                                            <td class="text-end fw-semibold">@b.Amount.ToString("N2") TL</td>
                                                        </tr>
                                                        @foreach (var line in b.ServiceLines)
                                                        {
                                                            <tr>
                                                                <td>@line.ServiceName <code class="ms-1">@line.ServiceCode</code></td>
                                                                <td></td>
                                                                <td class="text-end">@line.MonthlyPrice.ToString("N2") TL</td>
                                                            </tr>
                                                        }
                                                        <tr class="border-top fw-bold">
                                                            <td>TOPLAM</td>
                                                            <td></td>
                                                            <td class="text-end">@b.TotalAmount.ToString("N2") TL</td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <ConfirmDialog @ref="billingConfirmDialog" OnConfirm="ExecuteDeleteBilling"
                   Message="@($"{deleteBillingTarget?.Month:00}/{deleteBillingTarget?.Year} donemini silmek istediginize emin misiniz?")" />

    @* ─── İLK TAHAKKUK MODAL ─── *@
    @if (showCreateBillingModal)
    {
        <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
            <div class="modal-dialog modal-sm modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header py-2">
                        <h6 class="modal-title"><i class="bi bi-calendar-plus me-2"></i>Ilk Tahakkuku Olustur</h6>
                        <button type="button" class="btn-close btn-close-sm" @onclick="CloseCreateBillingModal"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(createBillingError))
                        {
                            <div class="alert alert-danger py-2 small">@createBillingError</div>
                        }
                        <div class="mb-3">
                            <label class="form-label small">Donem Baslangic Tarihi</label>
                            <input type="date" class="form-control form-control-sm"
                                   @bind="createBillingDate" />
                            <small class="text-muted">Secilen gunun ayin kaci oldugu tahakkuk gunu olarak kaydedilir.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small">Not (opsiyonel)</label>
                            <input type="text" class="form-control form-control-sm" @bind="createBillingNotes" />
                        </div>
                    </div>
                    <div class="modal-footer py-2">
                        <button class="btn btn-secondary btn-sm" @onclick="CloseCreateBillingModal" disabled="@isCreatingBilling">Kapat</button>
                        <button class="btn btn-primary btn-sm" @onclick="CreateManualBilling" disabled="@isCreatingBilling">
                            @if (isCreatingBilling)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-check-lg me-1"></i>Olustur
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@* ═══════════════════════════════════════════════════════════ *@
@* HİZMETLER SEKMESİ                                           *@
@* ═══════════════════════════════════════════════════════════ *@
@if (activeTab == "hizmetler")
{
    @* ─── MODUL YONETIMI ─── *@
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
            <span class="fw-semibold"><i class="bi bi-grid-3x3-gap-fill me-1"></i>Portal Modulleri</span>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-muted border">
                    @(portalModules?.Count(m => m.IsActive) ?? 0) aktif / @(portalModules?.Count ?? 0) toplam
                </span>
                <button class="btn btn-outline-primary btn-sm" @onclick="SyncMissingModules" disabled="@isSyncingModules">
                    @if (isSyncingModules)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-arrow-repeat me-1"></i>Eksikleri Tamamla
                </button>
            </div>
        </div>
        <div class="card-body">
            @if (isLoadingModules)
            {
                <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary" role="status"></div></div>
            }
            else if (portalModules == null || portalModules.Count == 0)
            {
                <div class="text-center text-muted py-3">
                    <i class="bi bi-grid-3x3-gap fs-3 d-block mb-2 opacity-25"></i>
                    Modul bulunamadi.
                </div>
            }
            else
            {
                <div class="row g-2">
                    @foreach (var mod in portalModules)
                    {
                        <div class="col-6 col-md-4 col-lg-3">
                            <div class="border rounded p-2 text-center @(mod.IsActive ? "border-success bg-success-subtle" : "")">
                                <div class="form-check form-switch d-flex justify-content-center mb-1">
                                    <input class="form-check-input" type="checkbox" checked="@mod.IsActive"
                                           @onchange="() => ToggleModule(mod)" disabled="@isTogglingModule" />
                                </div>
                                <i class="bi @(mod.Icon ?? "bi-box") @(mod.IsActive ? "text-success" : "text-muted")"></i>
                                <div class="small fw-medium">@mod.SystemName</div>
                                <div class="text-muted" style="font-size:0.7rem;">@mod.Description</div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @* ─── HIZMET ABONELIKLERI ─── *@
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
            <span class="fw-semibold"><i class="bi bi-box-seam me-1"></i>Hizmet Abonelikleri</span>
            <button class="btn btn-primary btn-sm" @onclick="OpenAddSubscription">
                <i class="bi bi-plus-circle me-1"></i>Hizmet Ekle
            </button>
        </div>
        <div class="card-body p-0">
            @if (isLoadingSubscriptions)
            {
                <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
            }
            else if (subscriptions == null || subscriptions.Count == 0)
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-box-seam fs-1 d-block mb-2 opacity-25"></i>
                    Henuz hizmet aboneligi yok.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Hizmet</th>
                                <th class="text-end">Aylik Fiyat</th>
                                <th>Baslangic</th>
                                <th>Durum</th>
                                <th class="text-end">Islemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sub in subscriptions)
                            {
                                <tr class="@(sub.StatusId != 1 ? "table-secondary" : "")">
                                    <td>
                                        <code class="me-1">@sub.ServiceCode</code>@sub.ServiceName
                                    </td>
                                    <td class="text-end fw-semibold">@sub.MonthlyPrice.ToString("N2") TL</td>
                                    <td>@sub.StartDate.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        @if (sub.StatusId == 1)
                                        {
                                            <span class="badge bg-success-subtle text-success">Aktif</span>
                                        }
                                        else if (sub.StatusId == 2)
                                        {
                                            <span class="badge bg-warning-subtle text-warning">Askida</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger">Iptal</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (sub.StatusId == 1)
                                        {
                                            <button class="btn btn-outline-warning btn-sm me-1" title="Askiya Al"
                                                    @onclick="() => SuspendSubscription(sub)" disabled="@isUpdatingSubscription">
                                                <i class="bi bi-pause-circle"></i>
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm" title="Iptal Et"
                                                    @onclick="() => CancelSubscription(sub)" disabled="@isUpdatingSubscription">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }
                                        else if (sub.StatusId == 2)
                                        {
                                            <button class="btn btn-outline-success btn-sm" title="Yeniden Aktifle"
                                                    @onclick="() => ReactivateSubscription(sub)" disabled="@isUpdatingSubscription">
                                                <i class="bi bi-play-circle"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>


    @* Hizmet Ekle Modalı *@
    @if (showAddSubscription)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header py-2">
                        <h6 class="modal-title"><i class="bi bi-plus-circle me-1"></i>Hizmet Ekle</h6>
                        <button class="btn-close btn-close-sm" @onclick="() => showAddSubscription = false"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(addSubError))
                        {
                            <div class="alert alert-danger py-2 small">@addSubError</div>
                        }
                        <div class="mb-3">
                            <label class="form-label small">Hizmet</label>
                            <select class="form-select form-select-sm" @bind="newSubServiceId">
                                <option value="0">-- Secin --</option>
                                @if (premiumServices != null)
                                {
                                    @foreach (var svc in premiumServices)
                                    {
                                        <option value="@svc.Id">@svc.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small">Aylik Fiyat (TL)</label>
                            <input type="number" class="form-control form-control-sm" step="0.01" @bind="newSubPrice" />
                            <small class="text-muted">Bos birakilirsa varsayilan fiyat kullanilir.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small">Notlar</label>
                            <textarea class="form-control form-control-sm" rows="2" @bind="newSubNotes"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer py-1">
                        <button class="btn btn-sm btn-secondary" @onclick="() => showAddSubscription = false">Vazgec</button>
                        <button class="btn btn-sm btn-primary" @onclick="SaveNewSubscription" disabled="@isSavingSubscription">
                            @if (isSavingSubscription)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Kaydet
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private string activeTab = "genel";

    // ─── GENEL ───
    private CustomerDetailDto? customer;
    private CustomerUpdateDto editModel = new();
    private bool isLoadingGeneral;
    private bool isSavingGeneral;
    private string? generalError;
    private bool isResettingPassword;
    private string? tempAdminPassword;

    // ─── PERSONEL ───
    private List<PortalPersonnelListDto>? personnel;
    private bool isLoadingPersonnel;
    private PersonnelForm personnelForm = null!;
    private ConfirmDialog personnelConfirmDialog = null!;
    private PortalPersonnelListDto? deactivateTarget;

    // ─── KUYRUKLAR ───
    private List<QueueListDto>? queues;
    private bool isLoadingQueues;

    // ─── ORGANİZASYON ───
    private List<OrgUnitListDto>? orgUnits;
    private bool isLoadingOrg;

    // ─── ODEMELER ───
    private List<BillingPeriodDto>? billingPeriods;
    private bool isLoadingBilling;
    private bool isUpdatingBilling;
    private ConfirmDialog billingConfirmDialog = null!;
    private BillingPeriodDto? deleteBillingTarget;
    private int? expandedBillingId;
    private bool showCreateBillingModal;
    private DateTime createBillingDate = DateTime.Today;
    private string? createBillingNotes;
    private bool isCreatingBilling;
    private string? createBillingError;

    // ─── MODULLER ───
    private List<PortalModuleDto>? portalModules;
    private bool isLoadingModules;
    private bool isTogglingModule;
    private bool isSyncingModules;

    // ─── HİZMETLER ───
    private List<SubscriptionDto>? subscriptions;
    private List<ServiceTypeDto>? premiumServices;
    private bool isLoadingSubscriptions;
    private bool isUpdatingSubscription;
    private bool showAddSubscription;
    private int newSubServiceId;
    private decimal? newSubPrice;
    private string? newSubNotes;
    private string? addSubError;
    private bool isSavingSubscription;

    protected override async Task OnInitializedAsync()
    {
        await LoadGeneral();
    }

    private async Task SetTab(string tab)
    {
        activeTab = tab;

        switch (tab)
        {
            case "genel" when customer == null:
                await LoadGeneral();
                break;
            case "personel" when personnel == null:
                await LoadPersonnel();
                break;
            case "organizasyon" when orgUnits == null:
                await LoadOrganizations();
                break;
            case "kuyruklar" when queues == null:
                await LoadQueues();
                break;
            case "odemeler" when billingPeriods == null:
                await LoadBilling();
                break;
            case "hizmetler":
                if (portalModules == null) await LoadModules();
                if (subscriptions == null) await LoadSubscriptions();
                break;
        }
    }

    // ═══════════════════════════════════════════════════
    // GENEL
    // ═══════════════════════════════════════════════════

    private async Task LoadGeneral()
    {
        isLoadingGeneral = true;
        StateHasChanged();
        try
        {
            customer = await Http.GetFromJsonAsync<CustomerDetailDto>($"api/customers/{Id}");
            if (customer != null)
            {
                editModel = new CustomerUpdateDto
                {
                    Name = customer.Name,
                    TaxNumber = customer.TaxNumber,
                    Address = customer.Address,
                    Phone = customer.Phone,
                    Email = customer.Email,
                    MaxUsers = customer.MaxUsers,
                    MonthlyUnitPrice = customer.MonthlyUnitPrice,
                    IsActive = customer.IsActive,
                    SaveRecordingToPlatform = customer.SaveRecordingToPlatform,
                    SaveRecordingToOwnStorage = customer.SaveRecordingToOwnStorage,
                    AutoRecordCalls = customer.AutoRecordCalls
                };
            }
        }
        catch (Exception ex) { Toast.ShowError($"Veri yuklenemedi: {ex.Message}"); }
        finally { isLoadingGeneral = false; }
    }

    private async Task SaveGeneral()
    {
        isSavingGeneral = true;
        generalError = null;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/customers/{Id}", editModel);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Musteri guncellendi.");
                customer = await Http.GetFromJsonAsync<CustomerDetailDto>($"api/customers/{Id}");
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                generalError = error?.Message ?? "Guncelleme basarisiz.";
            }
        }
        catch (Exception ex) { generalError = $"Hata: {ex.Message}"; }
        finally { isSavingGeneral = false; }
    }

    private async Task ResetAdminPassword()
    {
        isResettingPassword = true;
        tempAdminPassword = null;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsync($"api/customers/{Id}/reset-admin-password", null);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PasswordResetResult>();
                tempAdminPassword = result?.Password;
                Toast.ShowSuccess("Admin sifresi sifirlandi.");
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(error?.Message ?? "Sifre sifirlama basarisiz.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
        finally { isResettingPassword = false; }
    }

    // ═══════════════════════════════════════════════════
    // PERSONEL
    // ═══════════════════════════════════════════════════

    private async Task LoadPersonnel()
    {
        isLoadingPersonnel = true;
        StateHasChanged();
        try
        {
            personnel = await Http.GetFromJsonAsync<List<PortalPersonnelListDto>>($"api/portal/personnel?customerId={Id}");
        }
        catch (Exception ex) { Toast.ShowError($"Personel yuklenemedi: {ex.Message}"); }
        finally { isLoadingPersonnel = false; }
    }

    private void OpenCreatePersonnel() => personnelForm.OpenForCreate();
    private void OpenEditPersonnel(PortalPersonnelListDto item) => personnelForm.OpenForEdit(item);

    private void ConfirmDeactivatePersonnel(PortalPersonnelListDto item)
    {
        deactivateTarget = item;
        personnelConfirmDialog.Show();
    }

    private async Task ReactivatePersonnel(PortalPersonnelListDto item)
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"api/portal/personnel/{item.Id}/reactivate?customerId={Id}", new { });
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Personel aktiflestirildi.");
                await LoadPersonnel();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(error?.Message ?? "Islem basarisiz.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
    }

    private async Task UnlockPersonnel(PortalPersonnelListDto item)
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"api/portal/personnel/{item.Id}/unlock?customerId={Id}", new { });
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Hesap kilidi kaldirildi.");
                await LoadPersonnel();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(error?.Message ?? "Islem basarisiz.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
    }

    private async Task ExecuteDeactivatePersonnel()
    {
        if (deactivateTarget == null) return;
        try
        {
            var response = await Http.DeleteAsync($"api/portal/personnel/{deactivateTarget.Id}?customerId={Id}");
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Personel deaktive edildi.");
                await LoadPersonnel();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(error?.Message ?? "Islem basarisiz.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
    }

    // ═══════════════════════════════════════════════════
    // ORGANİZASYON
    // ═══════════════════════════════════════════════════

    private async Task LoadOrganizations()
    {
        isLoadingOrg = true;
        StateHasChanged();
        try
        {
            orgUnits = await Http.GetFromJsonAsync<List<OrgUnitListDto>>($"api/organizations?customerId={Id}");
        }
        catch (Exception ex) { Toast.ShowError($"Organizasyon yuklenemedi: {ex.Message}"); }
        finally { isLoadingOrg = false; }
    }

    // ═══════════════════════════════════════════════════
    // KUYRUKLAR
    // ═══════════════════════════════════════════════════

    private async Task LoadQueues()
    {
        isLoadingQueues = true;
        StateHasChanged();
        try
        {
            var result = await Http.GetFromJsonAsync<PagedResult<QueueListDto>>($"api/queues?customerId={Id}&pageSize=100");
            queues = result?.Items ?? new();
        }
        catch (Exception ex) { Toast.ShowError($"Kuyruklar yuklenemedi: {ex.Message}"); }
        finally { isLoadingQueues = false; }
    }

    // ═══════════════════════════════════════════════════
    // ODEMELER
    // ═══════════════════════════════════════════════════

    private async Task LoadBilling()
    {
        isLoadingBilling = true;
        StateHasChanged();
        try
        {
            billingPeriods = await Http.GetFromJsonAsync<List<BillingPeriodDto>>($"api/customers/{Id}/billing");
        }
        catch (Exception ex) { Toast.ShowError($"Faturalama donemi yuklenemedi: {ex.Message}"); }
        finally { isLoadingBilling = false; }
    }

    private void ToggleBillingDetail(int periodId)
    {
        expandedBillingId = expandedBillingId == periodId ? null : periodId;
    }

    private async Task ChangeStatus(BillingPeriodDto period, int newStatusId)
    {
        isUpdatingBilling = true;
        StateHasChanged();
        try
        {
            var dto = new BillingPeriodUpdateDto { StatusId = newStatusId, Notes = period.Notes };
            var response = await Http.PutAsJsonAsync($"api/customers/billing/{period.Id}", dto);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess($"{period.Month:00}/{period.Year} donemi guncellendi.");
                await LoadBilling();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(error?.Message ?? "Islem basarisiz.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
        finally { isUpdatingBilling = false; }
    }

    private static string GetBillingRowClass(int statusId) => statusId switch
    {
        BillingPeriodStatuses.Ids.Draft => "table-warning",
        BillingPeriodStatuses.Ids.Invoiced => "table-info",
        BillingPeriodStatuses.Ids.Overdue => "table-danger",
        _ => ""
    };

    private static (string Css, string Text) GetStatusBadge(int statusId) => statusId switch
    {
        BillingPeriodStatuses.Ids.Draft => ("bg-warning-subtle text-warning", "Tahakkuk"),
        BillingPeriodStatuses.Ids.Invoiced => ("bg-info-subtle text-info", "Faturalanmis"),
        BillingPeriodStatuses.Ids.Paid => ("bg-success-subtle text-success", "Odenmis"),
        BillingPeriodStatuses.Ids.Overdue => ("bg-danger-subtle text-danger", "Gecikme"),
        _ => ("bg-secondary", "?")
    };

    private void OpenCreateBillingModal()
    {
        createBillingDate = DateTime.Today;
        createBillingNotes = null;
        createBillingError = null;
        showCreateBillingModal = true;
    }

    private void CloseCreateBillingModal()
    {
        showCreateBillingModal = false;
    }

    private async Task CreateManualBilling()
    {
        isCreatingBilling = true;
        createBillingError = null;
        StateHasChanged();
        try
        {
            var dto = new BillingPeriodCreateDto
            {
                CustomerId = Id,
                PeriodStartDate = createBillingDate,
                Notes = createBillingNotes
            };
            var response = await Http.PostAsJsonAsync($"api/customers/{Id}/billing/create", dto);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Ilk tahakkuk olusturuldu.");
                showCreateBillingModal = false;
                await LoadGeneral(); // BillingAnchorDay guncellemesi icin
                await LoadBilling();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                createBillingError = error?.Message ?? "Tahakkuk olusturulamadi.";
            }
        }
        catch (Exception ex) { createBillingError = $"Hata: {ex.Message}"; }
        finally { isCreatingBilling = false; }
    }

    private void ConfirmDeleteBilling(BillingPeriodDto period)
    {
        deleteBillingTarget = period;
        billingConfirmDialog.Show();
    }

    private async Task ExecuteDeleteBilling()
    {
        if (deleteBillingTarget == null) return;
        isUpdatingBilling = true;
        StateHasChanged();
        try
        {
            var response = await Http.DeleteAsync($"api/customers/billing/{deleteBillingTarget.Id}");
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess($"{deleteBillingTarget.Month:00}/{deleteBillingTarget.Year} donemi silindi.");
                await LoadBilling();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(error?.Message ?? "Silme islemi basarisiz.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
        finally { isUpdatingBilling = false; }
    }

