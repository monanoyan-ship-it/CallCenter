        finally { isLoadingPersonnel = false; }
    }

    private void OpenCreatePersonnel() => personnelForm.OpenForCreate();
    private void OpenEditPersonnel(PortalPersonnelListDto item) => personnelForm.OpenForEdit(item);
    private void OpenPermissions(PortalPersonnelListDto item) => permForm.Open(item);

    private void ConfirmDeactivatePersonnel(PortalPersonnelListDto item)
    {
        deactivateTarget = item;
        personnelConfirmDialog.Show();
    }

    private async Task ExecuteDeactivatePersonnel()
    {
        if (deactivateTarget == null) return;
        try
        {
            var response = await Http.DeleteAsync($"api/portal/personnel/{deactivateTarget.Id}?customerId={Id}");
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Personel deaktive edildi.");
                await LoadPersonnel();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(error?.Message ?? "Islem basarisiz.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
    }

