@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums

<PageTitle>Kullanicilar - CorpLynk</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-person-fill-gear me-2 text-primary"></i>Kullanicilar
    </h4>
    <button class="btn btn-primary btn-sm" @onclick="OpenCreateForm">
        <i class="bi bi-plus-lg me-1"></i>Yeni Kullanici
    </button>
</div>

@* ─── FİLTRELER ─── *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Ad, kullanici adi veya e-posta ara..."
                           @bind="searchText" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" />
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select form-select-sm" @onchange="OnRoleFilterChanged">
                    <option value="0">Tum Roller</option>
                    @foreach (var role in UserRoles.All)
                    {
                        <option value="@role.Id">@GetRoleDisplayName(role.SystemName)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary btn-sm w-100" @onclick="LoadData">
                    <i class="bi bi-arrow-clockwise me-1"></i>Yenile
                </button>
            </div>
        </div>
    </div>
</div>

@* ─── TABLO ─── *@
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else if (result == null || result.Items.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-person-x fs-1 d-block mb-2 opacity-25"></i>
                <span>Kullanici bulunamadi</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Kullanici Adi</th>
                            <th>Ad Soyad</th>
                            <th>E-posta</th>
                            <th>Rol</th>
                            <th>Firma / Firma Rolu</th>
                            <th>Dahili</th>
                            <th>Durum</th>
                            <th>Son Giris</th>
                            <th style="width: 100px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in result.Items)
                        {
                            <tr class="@(!user.IsActive ? "table-secondary" : "")">
                                <td class="fw-medium">@user.UserName</td>
                                <td>@user.FullName</td>
                                <td class="text-muted small">@user.Email</td>
                                <td>
                                    @{ var role = UserRoles.GetById(user.RoleId); }
                                    <span class="badge @(role?.CssClass ?? "bg-secondary") rounded-pill">
                                        @GetRoleDisplayName(user.RoleName)
                                    </span>
                                </td>
                                <td>
                                    @if (user.CustomerRoleId.HasValue)
                                    {
                                        var cRole = CustomerRoles.GetById(user.CustomerRoleId.Value);
                                        <small class="text-muted d-block">@user.CustomerName</small>
                                        <span class="badge @(cRole?.CssClass ?? "bg-secondary") rounded-pill" style="font-size: 0.7em;">
                                            @(cRole?.Description ?? "-")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-muted">@(user.Extension ?? "-")</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Pasif</span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @(user.LastLoginAt.HasValue ? user.LastLoginAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "-")
                                </td>
                                <td>
                                    <button class="btn btn-outline-primary btn-sm me-1" title="Duzenle"
                                            @onclick="() => OpenEditForm(user)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm" title="Sil"
                                            @onclick="() => ConfirmDelete(user)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
                <small class="text-muted">Toplam: @result.TotalCount kayit</small>
                <Pagination CurrentPage="currentPage" TotalPages="result.TotalPages" OnPageChanged="OnPageChanged" />
            </div>
        }
    </div>
</div>

@* ─── FORM MODAL ─── *@
<UserForm @ref="userForm" OnSaved="LoadData" />

@* ─── SİLME ONAY ─── *@
<ConfirmDialog @ref="confirmDialog" OnConfirm="ExecuteDelete"
               Message="@($"'{deleteTarget?.FullName}' kullanicisini silmek istediginize emin misiniz?")" />

@code {
    private PagedResult<UserListDto>? result;
    private bool isLoading;
    private string searchText = "";
    private int selectedRoleId;
    private int currentPage = 1;
    private UserForm userForm = null!;
    private ConfirmDialog confirmDialog = null!;
    private UserListDto? deleteTarget;

    private static readonly Dictionary<string, string> RoleDisplayNames = new(StringComparer.OrdinalIgnoreCase)
    {
        { "Admin", "Yonetici" },
        { "Supervisor", "Supervisor" },
        { "Agent", "Temsilci" },
        { "CustomerUser", "Musteri" }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var url = $"api/users?page={currentPage}&pageSize=20";
            if (!string.IsNullOrWhiteSpace(searchText))
                url += $"&search={Uri.EscapeDataString(searchText)}";
            if (selectedRoleId > 0)
                url += $"&roleId={selectedRoleId}";

            result = await Http.GetFromJsonAsync<PagedResult<UserListDto>>(url);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Veri yuklenemedi: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            currentPage = 1;
            await LoadData();
        }
    }

    private async Task OnRoleFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            selectedRoleId = id;
            currentPage = 1;
            await LoadData();
        }
    }

    private async Task OnPageChanged(int page)
    {
        currentPage = page;
        await LoadData();
    }

    private void OpenCreateForm()
    {
        userForm.OpenForCreate();
    }

    private void OpenEditForm(UserListDto user)
    {
        userForm.OpenForEdit(user);
    }

    private void ConfirmDelete(UserListDto user)
    {
        deleteTarget = user;
        confirmDialog.Show();
    }

    private async Task ExecuteDelete()
    {
        if (deleteTarget == null) return;

        try
        {
            var response = await Http.DeleteAsync($"api/users/{deleteTarget.Id}");
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Kullanici basariyla silindi.");
                await LoadData();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(error?.Message ?? "Silme islemi basarisiz.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Hata: {ex.Message}");
        }
    }

    private static string GetRoleDisplayName(string systemName)
        => RoleDisplayNames.TryGetValue(systemName, out var name) ? name : systemName;

    private record ErrorMsg(string? Message);
}
