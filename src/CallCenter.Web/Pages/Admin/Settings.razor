@page "/admin/settings"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs

<PageTitle>Sistem Ayarlari - CorpLynk</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-sliders me-2 text-primary"></i>Sistem Ayarlari
    </h4>
    <button class="btn btn-primary btn-sm" @onclick="OpenCreateForm">
        <i class="bi bi-plus-lg me-1"></i>Yeni Ayar
    </button>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    @foreach (var group in groupedSettings)
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-bottom">
                <h6 class="mb-0">
                    <i class="bi @GetGroupIcon(group.Key) me-2"></i>@GetGroupDisplayName(group.Key)
                </h6>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 25%;">Key</th>
                            <th style="width: 25%;">Deger</th>
                            <th style="width: 10%;">Tip</th>
                            <th>Aciklama</th>
                            <th style="width: 120px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var setting in group.Value)
                        {
                            <tr>
                                <td class="fw-medium small">@setting.Key</td>
                                <td>
                                    @if (editingSettingId == setting.Id)
                                    {
                                        <div class="input-group input-group-sm">
                                            @if (setting.ValueType == "bool")
                                            {
                                                <select class="form-select form-select-sm" @bind="editValue">
                                                    <option value="true">true</option>
                                                    <option value="false">false</option>
                                                </select>
                                            }
                                            else
                                            {
                                                <input type="text" class="form-control form-control-sm" @bind="editValue" />
                                            }
                                            <button class="btn btn-success btn-sm" @onclick="SaveSetting">
                                                <i class="bi bi-check"></i>
                                            </button>
                                            <button class="btn btn-secondary btn-sm" @onclick="CancelEdit">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        @if (setting.ValueType == "bool")
                                        {
                                            <span class="badge @(setting.Value == "true" ? "bg-success" : "bg-secondary")">
                                                @setting.Value
                                            </span>
                                        }
                                        else
                                        {
                                            <code class="small">@setting.Value</code>
                                        }
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary">@setting.ValueType</span>
                                </td>
                                <td class="text-muted small">@(setting.Description ?? "-")</td>
                                <td>
                                    <button class="btn btn-outline-primary btn-sm me-1" title="Duzenle"
                                            @onclick="() => StartEdit(setting)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    @if (!setting.IsSystem)
                                    {
                                        <button class="btn btn-outline-danger btn-sm" title="Sil"
                                                @onclick="() => ConfirmDelete(setting)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning" title="Sistem ayari — silinemez">
                                            <i class="bi bi-lock-fill"></i>
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@* ─── YENİ AYAR FORMU ─── *@
@if (showCreateForm)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Yeni Ayar</h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateForm"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(createError))
                    {
                        <div class="alert alert-danger py-2 small">@createError</div>
                    }
                    <div class="mb-3">
                        <label class="form-label small">Key</label>
                        <input type="text" class="form-control form-control-sm" @bind="createDto.Key" placeholder="custom.setting_name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Deger</label>
                        <input type="text" class="form-control form-control-sm" @bind="createDto.Value" />
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small">Grup</label>
                            <select class="form-select form-select-sm" @bind="createDto.Group">
                                <option value="general">Genel</option>
                                <option value="security">Guvenlik</option>
                                <option value="sip">SIP</option>
                                <option value="notification">Bildirim</option>
                                <option value="custom">Ozel</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">Tip</label>
                            <select class="form-select form-select-sm" @bind="createDto.ValueType">
                                <option value="string">string</option>
                                <option value="int">int</option>
                                <option value="bool">bool</option>
                                <option value="json">json</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3 mt-3">
                        <label class="form-label small">Aciklama</label>
                        <input type="text" class="form-control form-control-sm" @bind="createDto.Description" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseCreateForm">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="CreateSetting" disabled="@isCreating">
                        @if (isCreating)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-check-lg me-1"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmDialog @ref="confirmDialog" OnConfirm="ExecuteDelete"
               Message="@($"'{deleteTarget?.Key}' ayarini silmek istediginize emin misiniz?")" />

@code {
    private Dictionary<string, List<SystemSettingDto>> groupedSettings = new();
    private bool isLoading = true;

    // Inline edit
    private int? editingSettingId;
    private string editValue = "";

    // Create form
    private bool showCreateForm;
    private bool isCreating;
    private string? createError;
    private SystemSettingCreateDto createDto = new() { Group = "general", ValueType = "string" };

    // Delete
    private ConfirmDialog confirmDialog = null!;
    private SystemSettingDto? deleteTarget;

    private static readonly Dictionary<string, string> GroupNames = new()
    {
        { "general", "Genel" },
        { "security", "Guvenlik" },
        { "sip", "SIP" },
        { "notification", "Bildirim" },
        { "custom", "Ozel" }
    };

    private static readonly Dictionary<string, string> GroupIcons = new()
    {
        { "general", "bi-gear" },
        { "security", "bi-shield-lock" },
        { "sip", "bi-router" },
        { "notification", "bi-bell" },
        { "custom", "bi-wrench" }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;

        try
        {
            var settings = await Http.GetFromJsonAsync<List<SystemSettingDto>>("api/settings");
            groupedSettings = (settings ?? new())
                .GroupBy(s => s.Group)
                .OrderBy(g => GetGroupOrder(g.Key))
                .ToDictionary(g => g.Key, g => g.ToList());
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Ayarlar yuklenemedi: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void StartEdit(SystemSettingDto setting)
    {
        editingSettingId = setting.Id;
        editValue = setting.Value;
    }

    private void CancelEdit()
    {
        editingSettingId = null;
    }

    private async Task SaveSetting()
    {
        if (editingSettingId == null) return;

        try
        {
            var response = await Http.PutAsJsonAsync($"api/settings/{editingSettingId}",
                new SystemSettingUpdateDto { Value = editValue });

            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Ayar guncellendi.");
                editingSettingId = null;
                await LoadData();
            }
            else
            {
                Toast.ShowError("Guncelleme basarisiz.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Hata: {ex.Message}");
        }
    }

    private void OpenCreateForm()
    {
        createDto = new() { Group = "general", ValueType = "string" };
        createError = null;
        showCreateForm = true;
    }

    private void CloseCreateForm()
    {
        showCreateForm = false;
    }

    private async Task CreateSetting()
    {
        if (string.IsNullOrWhiteSpace(createDto.Key))
        {
            createError = "Key zorunludur.";
            return;
        }

        isCreating = true;
        createError = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/settings", createDto);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Ayar olusturuldu.");
                showCreateForm = false;
                await LoadData();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                createError = error?.Message ?? "Islem basarisiz.";
            }
        }
        catch (Exception ex)
        {
            createError = $"Hata: {ex.Message}";
        }
        finally
        {
            isCreating = false;
        }
    }

    private void ConfirmDelete(SystemSettingDto setting)
    {
        deleteTarget = setting;
        confirmDialog.Show();
    }

    private async Task ExecuteDelete()
    {
        if (deleteTarget == null) return;

        try
        {
            var response = await Http.DeleteAsync($"api/settings/{deleteTarget.Id}");
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Ayar basariyla silindi.");
                await LoadData();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(error?.Message ?? "Silme islemi basarisiz.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Hata: {ex.Message}");
        }
    }

    private static string GetGroupDisplayName(string group)
        => GroupNames.TryGetValue(group, out var name) ? name : group;

    private static string GetGroupIcon(string group)
        => GroupIcons.TryGetValue(group, out var icon) ? icon : "bi-gear";

    private static int GetGroupOrder(string group) => group switch
    {
        "general" => 0,
        "security" => 1,
        "sip" => 2,
        "notification" => 3,
        _ => 9
    };

    private record ErrorMsg(string? Message);
}
