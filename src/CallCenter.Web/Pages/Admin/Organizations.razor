@page "/admin/organizations"
@attribute [Authorize(Roles = "Admin,Supervisor")]
@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums

<PageTitle>Organizasyonlar - Call Center</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-diagram-3-fill me-2 text-primary"></i>Organizasyonlar
    </h4>
    <button class="btn btn-primary btn-sm" @onclick="OpenCreateForm" disabled="@(selectedCustomerId == 0)">
        <i class="bi bi-plus-lg me-1"></i>Yeni Birim
    </button>
</div>

@* ─── FİRMA SEÇİCİ ─── *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <SearchableSelect Items="customerItems" Value="@selectedCustomerIdStr"
                                  ValueChanged="OnCustomerSelected" Placeholder="-- Firma Seciniz --" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary btn-sm w-100" @onclick="LoadTree" disabled="@(selectedCustomerId == 0)">
                    <i class="bi bi-arrow-clockwise me-1"></i>Yenile
                </button>
            </div>
        </div>
    </div>
</div>

@if (selectedCustomerId == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-building fs-1 d-block mb-2 opacity-25"></i>
            <span>Organizasyon agacini goruntulemek icin bir firma seciniz.</span>
        </div>
    </div>
}
else if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    <div class="row g-3">
        @* ─── SOL: AĞAÇ ─── *@
        <div class="col-md-5">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex align-items-center justify-content-between py-2">
                    <small class="fw-semibold text-muted">Organizasyon Agaci</small>
                    <span class="badge bg-secondary-subtle text-secondary">@GetTotalCount() birim</span>
                </div>
                <div class="card-body" style="max-height: 600px; overflow-y: auto;">
                    @if (tree == null || tree.Count == 0)
                    {
                        <div class="text-center text-muted py-3">
                            <i class="bi bi-diagram-3 fs-3 d-block mb-2 opacity-25"></i>
                            <small>Henuz organizasyon birimi yok.</small>
                        </div>
                    }
                    else
                    {
                        @foreach (var root in tree)
                        {
                            <OrgTreeNode Node="root" SelectedId="selectedNodeId" OnSelected="OnNodeSelected" />
                        }
                    }
                </div>
            </div>
        </div>

        @* ─── SAĞ: DETAY ─── *@
        <div class="col-md-7">
            @if (detail == null)
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center text-muted py-5">
                        <i class="bi bi-arrow-left fs-3 d-block mb-2 opacity-25"></i>
                        <small>Sol taraftan bir birim seciniz.</small>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white d-flex align-items-center justify-content-between py-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(OrganizationUnitTypes.GetById(detail.TypeId)?.CssClass ?? "bg-secondary")">
                                <i class="bi @(detail.TypeIcon ?? "bi-folder")"></i>
                                @detail.TypeName
                            </span>
                            <span class="fw-semibold">@detail.Name</span>
                            @if (!detail.IsActive)
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Pasif</span>
                            }
                        </div>
                        <div class="d-flex gap-1">
                            <button class="btn btn-outline-primary btn-sm" @onclick="OpenEditForm" title="Duzenle">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="ConfirmDeleteNode" title="Sil">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row g-3 mb-3">
                            @if (!string.IsNullOrEmpty(detail.Code))
                            {
                                <div class="col-sm-6">
                                    <small class="text-muted d-block">Kod</small>
                                    <span>@detail.Code</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(detail.ParentName))
                            {
                                <div class="col-sm-6">
                                    <small class="text-muted d-block">Ust Birim</small>
                                    <span>@detail.ParentName</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(detail.Phone))
                            {
                                <div class="col-sm-6">
                                    <small class="text-muted d-block">Telefon</small>
                                    <span>@detail.Phone</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(detail.Email))
                            {
                                <div class="col-sm-6">
                                    <small class="text-muted d-block">E-posta</small>
                                    <span>@detail.Email</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(detail.Address))
                            {
                                <div class="col-12">
                                    <small class="text-muted d-block">Adres</small>
                                    <span>@detail.Address</span>
                                </div>
                            }
                        </div>

                        @* Personel listesi *@
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h6 class="text-muted mb-0"><i class="bi bi-people me-1"></i>Personel (@detail.Personnel.Count)</h6>
                            <button class="btn btn-outline-primary btn-sm" @onclick="OpenAssignPersonnel" title="Personel Ata">
                                <i class="bi bi-person-plus me-1"></i>Ata
                            </button>
                        </div>
                        @if (detail.Personnel.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-3">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Ad Soyad</th>
                                            <th>Unvan</th>
                                            <th>Rol</th>
                                            <th>Amiri</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in detail.Personnel)
                                        {
                                            <tr>
                                                <td>@p.FullName</td>
                                                <td class="text-muted small">@p.Title</td>
                                                <td class="text-muted small">@(p.CustomerRoleName ?? "-")</td>
                                                <td class="text-muted small">@(p.ReportsToName ?? "-")</td>
                                                <td class="text-end">
                                                    @if (!p.IsPrimaryAssignment)
                                                    {
                                                        <button class="btn btn-outline-danger btn-sm py-0 px-1" @onclick="() => RemovePersonnel(p.Id)" title="Cikar">
                                                            <i class="bi bi-x-lg" style="font-size:0.7rem;"></i>
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @* Alt birimler *@
                        @if (detail.Children.Count > 0)
                        {
                            <h6 class="text-muted mb-2"><i class="bi bi-diagram-3 me-1"></i>Alt Birimler (@detail.Children.Count)</h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Ad</th>
                                            <th>Tip</th>
                                            <th class="text-center">Personel</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in detail.Children)
                                        {
                                            <tr>
                                                <td>@c.Name</td>
                                                <td class="text-muted small">@c.TypeName</td>
                                                <td class="text-center">
                                                    <span class="badge bg-primary-subtle text-primary rounded-pill">@c.PersonnelCount</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

<OrganizationForm @ref="orgForm" CustomerId="selectedCustomerId" OnSaved="OnFormSaved" />

<ConfirmDialog @ref="confirmDialog" OnConfirm="ExecuteDelete"
               Message="@($"'{detail?.Name}' birimini silmek istediginize emin misiniz?")" />

@* ─── PERSONEL ATAMA MODAL ─── *@
@if (showAssignModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Personel Ata</h5>
                    <button type="button" class="btn-close" @onclick="() => showAssignModal = false"></button>
                </div>
                <div class="modal-body">
                    @if (availablePersonnel == null)
                    {
                        <div class="text-center py-3"><div class="spinner-border spinner-border-sm"></div></div>
                    }
                    else if (availablePersonnel.Count == 0)
                    {
                        <div class="text-muted text-center py-3">Atanabilecek personel yok.</div>
                    }
                    else
                    {
                        <SearchableSelect Items="availablePersonnelItems" Value="" ValueChanged="OnAssignPersonnelSelected"
                                          Placeholder="-- Personel seciniz --" />
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => showAssignModal = false">Kapat</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<OrgUnitTreeDto>? tree;
    private OrgUnitDetailDto? detail;
    private List<CustomerListDto>? customers;
    private int selectedCustomerId;
    private int? selectedNodeId;
    private bool isLoading;
    private OrganizationForm orgForm = null!;
    private ConfirmDialog confirmDialog = null!;

    // Personel atama
    private bool showAssignModal;
    private List<OrgUnitPersonnelDto>? availablePersonnel;
    private List<SearchableSelect.SearchSelectItem> availablePersonnelItems =>
        availablePersonnel?.Select(p => new SearchableSelect.SearchSelectItem(p.Id.ToString(), p.FullName, p.Title)).ToList() ?? new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<PagedResult<CustomerListDto>>("api/customers?page=1&pageSize=500");
            customers = result?.Items;
        }
        catch { }
    }

    private List<SearchableSelect.SearchSelectItem> customerItems =>
        customers?.Select(c => new SearchableSelect.SearchSelectItem(c.Id.ToString(), c.Name)).ToList() ?? new();

    private string selectedCustomerIdStr => selectedCustomerId > 0 ? selectedCustomerId.ToString() : "";

    private async Task OnCustomerSelected(string? val)
    {
        selectedCustomerId = int.TryParse(val, out var id) ? id : 0;
        detail = null;
        selectedNodeId = null;
        if (selectedCustomerId > 0) await LoadTree();
    }

    private async Task LoadTree()
    {
        if (selectedCustomerId == 0) return;
        isLoading = true;
        StateHasChanged();

        try
        {
            tree = await Http.GetFromJsonAsync<List<OrgUnitTreeDto>>($"api/organizations/tree?customerId={selectedCustomerId}");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Agac yuklenemedi: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnNodeSelected(OrgUnitTreeDto node)
    {
        selectedNodeId = node.Id;
        try
        {
            detail = await Http.GetFromJsonAsync<OrgUnitDetailDto>($"api/organizations/{node.Id}?customerId={selectedCustomerId}");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Detay yuklenemedi: {ex.Message}");
        }
    }

    private void OpenCreateForm()
    {
        orgForm.OpenForCreate(selectedNodeId);
    }

    private void OpenEditForm()
    {
        if (detail != null)
            orgForm.OpenForEdit(detail);
    }

    private void ConfirmDeleteNode()
    {
        if (detail != null)
            confirmDialog.Show();
    }

    private async Task ExecuteDelete()
    {
        if (detail == null) return;
        try
        {
            var response = await Http.DeleteAsync($"api/organizations/{detail.Id}?customerId={selectedCustomerId}");
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Birim silindi.");
                detail = null;
                selectedNodeId = null;
                await LoadTree();
            }
            else
            {
                var err = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(err?.Error ?? "Silme islemi basarisiz.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Hata: {ex.Message}");
        }
    }

    private async Task OnFormSaved()
    {
        await LoadTree();
        if (selectedNodeId.HasValue)
        {
            try
            {
                detail = await Http.GetFromJsonAsync<OrgUnitDetailDto>($"api/organizations/{selectedNodeId}?customerId={selectedCustomerId}");
            }
            catch { }
        }
    }

    private int GetTotalCount()
    {
        if (tree == null) return 0;
        return tree.Sum(CountNodes);
    }

    private int CountNodes(OrgUnitTreeDto node)
    {
        return 1 + node.Children.Sum(CountNodes);
    }

    // ─── PERSONEL ATAMA ───

    private async Task OpenAssignPersonnel()
    {
        if (detail == null) return;
        try
        {
            availablePersonnel = await Http.GetFromJsonAsync<List<OrgUnitPersonnelDto>>(
                $"api/organizations/{detail.Id}/available-personnel?customerId={selectedCustomerId}");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Hata: {ex.Message}");
            return;
        }
        showAssignModal = true;
    }

    private async Task OnAssignPersonnelSelected(string? val)
    {
        if (!int.TryParse(val, out var personnelId) || detail == null) return;
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/organizations/{detail.Id}/personnel?customerId={selectedCustomerId}",
                new { PersonnelId = personnelId });
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Personel atandi.");
                showAssignModal = false;
                // Detayi yenile
                detail = await Http.GetFromJsonAsync<OrgUnitDetailDto>(
                    $"api/organizations/{detail.Id}?customerId={selectedCustomerId}");
                await LoadTree();
            }
            else
            {
                var err = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(err?.Error ?? "Atama basarisiz.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
    }

    private async Task RemovePersonnel(int personnelId)
    {
        if (detail == null) return;
        try
        {
            var response = await Http.DeleteAsync(
                $"api/organizations/{detail.Id}/personnel/{personnelId}?customerId={selectedCustomerId}");
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Personel cikarildi.");
                detail = await Http.GetFromJsonAsync<OrgUnitDetailDto>(
                    $"api/organizations/{detail.Id}?customerId={selectedCustomerId}");
                await LoadTree();
            }
            else
            {
                var err = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(err?.Error ?? "Cikarma basarisiz.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
    }

    private record ErrorMsg(string? Error);
}
