@page "/admin/kvkk/inventory"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject ToastService Toast
@inject IJSRuntime JS
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums

<PageTitle>Veri Envanteri - Call Center</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-database me-2 text-primary"></i>Veri Envanteri ve VERBiS
    </h4>
    <div class="d-flex gap-2">
        <select class="form-select form-select-sm" style="width:200px" @bind="filterCustomerId" @bind:after="LoadData">
            <option value="0">Tum Musteriler</option>
            @foreach (var c in customers)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
        <button class="btn btn-outline-success btn-sm" @onclick="ExportVerbis" title="VERBiS Formatinda Indir">
            <i class="bi bi-download me-1"></i>VERBiS Export
        </button>
        <button class="btn btn-primary btn-sm" @onclick="ShowCreateForm">
            <i class="bi bi-plus-lg me-1"></i>Yeni Kayit
        </button>
    </div>
</div>

@* ─── İSTATİSTİK ─── *@
@if (!isLoading && items.Count > 0)
{
    <div class="row g-3 mb-3">
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <h4 class="mb-0">@items.Count(i => i.IsActive)</h4>
                    <small class="text-muted">Aktif Kayit</small>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <h4 class="mb-0">@items.Count(i => !string.IsNullOrEmpty(i.VerbisRegistrationNo))</h4>
                    <small class="text-muted">VERBiS Kayitli</small>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body py-2 text-center">
                    <h4 class="mb-0">@items.Count(i => !string.IsNullOrEmpty(i.TransferCountry))</h4>
                    <small class="text-muted">Yurt Disi Aktarim Iceren</small>
                </div>
            </div>
        </div>
    </div>
}

@* ─── TABLO ─── *@
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
        }
        else if (items.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-database fs-1 d-block mb-2 opacity-25"></i>
                <span>Veri envanteri bos</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Durum</th>
                            <th>Veri Kategorisi</th>
                            <th>Isleme Amaci</th>
                            <th>Yasal Dayanak</th>
                            <th>Ilgili Kisi</th>
                            <th>Saklama</th>
                            <th>Alici / Aktarim</th>
                            <th>VERBiS No</th>
                            <th>Musteri</th>
                            <th style="width:70px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr class="@(item.IsActive ? "" : "text-muted")">
                                <td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Aktif" : "Pasif")</span></td>
                                <td><strong>@item.DataCategory</strong></td>
                                <td><small>@item.Purpose</small></td>
                                <td><small>@item.LegalBasis</small></td>
                                <td><small>@item.DataSubjectGroup</small></td>
                                <td><small>@item.RetentionDays gun (@(item.RetentionDays / 365) yil)</small></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.RecipientGroup) || !string.IsNullOrEmpty(item.TransferCountry))
                                    {
                                        <small>
                                            @(item.RecipientGroup ?? "")
                                            @if (!string.IsNullOrEmpty(item.TransferCountry))
                                            {
                                                <span class="text-info ms-1"><i class="bi bi-globe"></i> @item.TransferCountry</span>
                                            }
                                        </small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">-</small>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.VerbisRegistrationNo))
                                    {
                                        <code>@item.VerbisRegistrationNo</code>
                                    }
                                    else
                                    {
                                        <small class="text-warning"><i class="bi bi-exclamation-triangle"></i> Yok</small>
                                    }
                                </td>
                                <td><small>@(item.CustomerName ?? "-")</small></td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm" title="Duzenle" @onclick="() => ShowEditForm(item)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ─── OLUŞTURMA / DÜZENLEME MODAL ─── *@
@if (showForm)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-database me-2"></i>@(isEditing ? "Veri Envanteri Duzenle" : "Yeni Veri Envanteri Kaydi")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="formDto" OnValidSubmit="SubmitForm">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Musteri <span class="text-danger">*</span></label>
                                <select class="form-select form-select-sm" @bind="formDto.CustomerId">
                                    <option value="0">Secin...</option>
                                    @foreach (var c in customers)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">VERBiS Kayit No</label>
                                <InputText class="form-control form-control-sm" @bind-Value="formDto.VerbisRegistrationNo"
                                           placeholder="VERBiS sistemi kayit numarasi" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Veri Kategorisi <span class="text-danger">*</span></label>
                                <InputText class="form-control form-control-sm" @bind-Value="formDto.DataCategory"
                                           placeholder="Kimlik, iletisim, ses kaydi..." />
                                <ValidationMessage For="() => formDto.DataCategory" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Ilgili Kisi Grubu <span class="text-danger">*</span></label>
                                <InputText class="form-control form-control-sm" @bind-Value="formDto.DataSubjectGroup"
                                           placeholder="Musteriler, calisanlar, arayicilar..." />
                                <ValidationMessage For="() => formDto.DataSubjectGroup" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Isleme Amaci <span class="text-danger">*</span></label>
                                <InputText class="form-control form-control-sm" @bind-Value="formDto.Purpose" />
                                <ValidationMessage For="() => formDto.Purpose" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Yasal Dayanak <span class="text-danger">*</span></label>
                                <InputText class="form-control form-control-sm" @bind-Value="formDto.LegalBasis" />
                                <ValidationMessage For="() => formDto.LegalBasis" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Saklama Suresi (gun)</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="formDto.RetentionDays" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Guvenlik Onlemleri <span class="text-danger">*</span></label>
                                <InputText class="form-control form-control-sm" @bind-Value="formDto.SecurityMeasures"
                                           placeholder="Sifreleme, erisim kontrolu, loglama..." />
                                <ValidationMessage For="() => formDto.SecurityMeasures" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Alici Grubu</label>
                                <InputText class="form-control form-control-sm" @bind-Value="formDto.RecipientGroup"
                                           placeholder="Hizmet saglayici, is ortagi..." />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Aktarim Ulkesi</label>
                                <InputText class="form-control form-control-sm" @bind-Value="formDto.TransferCountry"
                                           placeholder="Yurt disi aktarim varsa ulke adi" />
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseForm">Iptal</button>
                            <button type="submit" class="btn btn-primary btn-sm" disabled="@isSaving">
                                @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                <i class="bi bi-check-lg me-1"></i>Kaydet
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<DataInventoryItemDto> items = new();
    private List<CustomerSimpleDto> customers = new();
    private bool isLoading = true, isSaving;
    private bool showForm, isEditing;
    private int filterCustomerId;

    private DataInventoryCreateDto formDto = new() { RetentionDays = 365 };

    protected override async Task OnInitializedAsync()
    {
        try { customers = await Http.GetFromJsonAsync<List<CustomerSimpleDto>>("api/supervisor/customers") ?? new(); } catch { }
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var url = "api/kvkk/inventory";
            if (filterCustomerId > 0) url += $"?customerId={filterCustomerId}";
            items = await Http.GetFromJsonAsync<List<DataInventoryItemDto>>(url) ?? new();
        }
        catch { Toast.ShowError("Veriler yuklenemedi."); }
        finally { isLoading = false; }
    }

    private void ShowCreateForm()
    {
        isEditing = false;
        formDto = new() { RetentionDays = 365 };
        if (filterCustomerId > 0) formDto.CustomerId = filterCustomerId;
        showForm = true;
    }

    private void ShowEditForm(DataInventoryItemDto item)
    {
        isEditing = true;
        formDto = new()
        {
            CustomerId = item.CustomerId,
            DataCategory = item.DataCategory,
            Purpose = item.Purpose,
            LegalBasis = item.LegalBasis,
            DataSubjectGroup = item.DataSubjectGroup,
            RecipientGroup = item.RecipientGroup,
            TransferCountry = item.TransferCountry,
            RetentionDays = item.RetentionDays,
            SecurityMeasures = item.SecurityMeasures,
            VerbisRegistrationNo = item.VerbisRegistrationNo
        };
        showForm = true;
    }

    private void CloseForm() { showForm = false; isEditing = false; }

    private async Task SubmitForm()
    {
        isSaving = true;
        try
        {
            var resp = await Http.PostAsJsonAsync("api/kvkk/inventory", formDto);
            if (resp.IsSuccessStatusCode)
            {
                Toast.ShowSuccess(isEditing ? "Envanter kaydi guncellendi." : "Envanter kaydi olusturuldu.");
                CloseForm();
                await LoadData();
            }
            else
            {
                var err = await resp.Content.ReadFromJsonAsync<ErrorResponse>();
                Toast.ShowError(err?.Error ?? "Islem basarisiz.");
            }
        }
        catch { Toast.ShowError("Bir hata olustu."); }
        finally { isSaving = false; }
    }

    private async Task ExportVerbis()
    {
        if (items.Count == 0) { Toast.ShowError("Export icin kayit bulunamadi."); return; }

        var activeItems = items.Where(i => i.IsActive).ToList();
        if (activeItems.Count == 0) { Toast.ShowError("Aktif envanter kaydi yok."); return; }

        var csv = "Veri Kategorisi;Isleme Amaci;Yasal Dayanak;Ilgili Kisi Grubu;Alici Grubu;Aktarim Ulkesi;Saklama Suresi (Gun);Guvenlik Onlemleri;VERBiS No\n";
        foreach (var i in activeItems)
        {
            csv += $"\"{i.DataCategory}\";\"{i.Purpose}\";\"{i.LegalBasis}\";\"{i.DataSubjectGroup}\";\"{i.RecipientGroup ?? ""}\";\"{i.TransferCountry ?? ""}\";\"{i.RetentionDays}\";\"{i.SecurityMeasures}\";\"{i.VerbisRegistrationNo ?? ""}\"\n";
        }

        var bytes = System.Text.Encoding.UTF8.GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(csv)).ToArray();
        await JS.InvokeVoidAsync("downloadFile", $"verbis_envanter_{DateTime.Now:yyyyMMdd}.csv", "text/csv", bytes);
        Toast.ShowSuccess($"VERBiS export: {activeItems.Count} kayit indirildi.");
    }

    private record ErrorResponse(string? Error);
}
