@page "/admin/customers"
@attribute [Authorize(Roles = "Admin,Supervisor")]
@inject HttpClient Http
@inject NavigationManager Nav
@inject ToastService Toast
@using CallCenter.Shared.DTOs

<PageTitle>Musteriler - CorpLynk</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-building me-2 text-primary"></i>Musteriler
    </h4>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-warning btn-sm" @onclick="OpenBillingModal">
            <i class="bi bi-credit-card me-1"></i>Aylik Faturalama
        </button>
        <button class="btn btn-primary btn-sm" @onclick="OpenCreateForm">
            <i class="bi bi-plus-lg me-1"></i>Yeni Musteri
        </button>
    </div>
</div>

@* ─── FİLTRELER ─── *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Firma adi, e-posta veya telefon ara..."
                           @bind="searchText" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" />
                </div>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary btn-sm w-100" @onclick="LoadData">
                    <i class="bi bi-arrow-clockwise me-1"></i>Yenile
                </button>
            </div>
        </div>
    </div>
</div>

@* ─── TABLO ─── *@
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else if (result == null || result.Items.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-building-x fs-1 d-block mb-2 opacity-25"></i>
                <span>Musteri bulunamadi</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Firma Adi</th>
                            <th>Telefon</th>
                            <th>E-posta</th>
                            <th class="text-center">Personel</th>
                            <th class="text-center">Kuyruk</th>
                            <th class="text-center">SIP</th>
                            <th>Durum</th>
                            <th style="width: 170px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in result.Items)
                        {
                            <tr class="@(!customer.IsActive ? "table-secondary" : "")">
                                <td class="fw-medium">@customer.Name</td>
                                <td class="text-muted small">@(customer.Phone ?? "-")</td>
                                <td class="text-muted small">@(customer.Email ?? "-")</td>
                                <td class="text-center">
                                    <span class="badge bg-primary-subtle text-primary rounded-pill">@customer.PersonnelCount</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info-subtle text-info rounded-pill">@customer.QueueCount</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-warning-subtle text-warning rounded-pill">@customer.SipAccountCount</span>
                                </td>
                                <td>
                                    @if (customer.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Pasif</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-outline-primary btn-sm me-1" title="Yonet"
                                            @onclick="() => GoToDetail(customer)">
                                        <i class="bi bi-sliders2"></i>
                                    </button>
                                    <button class="btn btn-outline-success btn-sm me-1" title="Portal"
                                            @onclick="() => GoToPortal(customer)">
                                        <i class="bi bi-building"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm me-1" title="Duzenle"
                                            @onclick="() => OpenEditForm(customer)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm" title="Sil"
                                            @onclick="() => ConfirmDelete(customer)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
                <small class="text-muted">Toplam: @result.TotalCount kayit</small>
                <Pagination CurrentPage="currentPage" TotalPages="result.TotalPages" OnPageChanged="OnPageChanged" />
            </div>
        }
    </div>
</div>

<CustomerForm @ref="customerForm" OnSaved="LoadData" />

<ConfirmDialog @ref="confirmDialog" OnConfirm="ExecuteDelete"
               Message="@($"'{deleteTarget?.Name}' musterisini silmek istediginize emin misiniz?")" />

@* ─── FATURALAMA MODALI ─── *@
@if (showBillingModal)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title"><i class="bi bi-credit-card me-2"></i>Toplu Donem Olustur</h6>
                    <button type="button" class="btn-close btn-close-sm" @onclick="CloseBillingModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(billingError))
                    {
                        <div class="alert alert-danger py-2 small">@billingError</div>
                    }
                    @if (!string.IsNullOrEmpty(billingSuccess))
                    {
                        <div class="alert alert-success py-2 small">@billingSuccess</div>
                    }
                    <div class="mb-3">
                        <label class="form-label small">Yil</label>
                        <input type="number" class="form-control form-control-sm" @bind="billingYear" min="2020" max="2100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Ay</label>
                        <select class="form-select form-select-sm" @bind="billingMonth">
                            <option value="1">Ocak</option>
                            <option value="2">Subat</option>
                            <option value="3">Mart</option>
                            <option value="4">Nisan</option>
                            <option value="5">Mayis</option>
                            <option value="6">Haziran</option>
                            <option value="7">Temmuz</option>
                            <option value="8">Agustos</option>
                            <option value="9">Eylul</option>
                            <option value="10">Ekim</option>
                            <option value="11">Kasim</option>
                            <option value="12">Aralik</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseBillingModal" disabled="@isGeneratingBilling">Kapat</button>
                    <button class="btn btn-primary btn-sm" @onclick="GenerateBilling" disabled="@isGeneratingBilling">
                        @if (isGeneratingBilling)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-gear me-1"></i>Olustur
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<CustomerListDto>? result;
    private bool isLoading;
    private string searchText = "";
    private int currentPage = 1;
    private CustomerForm customerForm = null!;
    private ConfirmDialog confirmDialog = null!;
    private CustomerListDto? deleteTarget;

    // ─── FATURALAMA ───
    private bool showBillingModal;
    private int billingYear = DateTime.Now.Year;
    private int billingMonth = DateTime.Now.Month;
    private bool isGeneratingBilling;
    private string? billingError;
    private string? billingSuccess;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var url = $"api/customers?page={currentPage}&pageSize=20";
            if (!string.IsNullOrWhiteSpace(searchText))
                url += $"&search={Uri.EscapeDataString(searchText)}";

            result = await Http.GetFromJsonAsync<PagedResult<CustomerListDto>>(url);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Veri yuklenemedi: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            currentPage = 1;
            await LoadData();
        }
    }

    private async Task OnPageChanged(int page)
    {
        currentPage = page;
        await LoadData();
    }

    private void OpenCreateForm()
    {
        customerForm.OpenForCreate();
    }

    private void OpenEditForm(CustomerListDto customer)
    {
        customerForm.OpenForEdit(customer);
    }

    private void ConfirmDelete(CustomerListDto customer)
    {
        deleteTarget = customer;
        confirmDialog.Show();
    }

    private async Task ExecuteDelete()
    {
        if (deleteTarget == null) return;

        try
        {
            var response = await Http.DeleteAsync($"api/customers/{deleteTarget.Id}");
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Musteri basariyla silindi.");
                await LoadData();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(error?.Message ?? "Silme islemi basarisiz.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Hata: {ex.Message}");
        }
    }

    private void GoToDetail(CustomerListDto customer)
    {
        Nav.NavigateTo($"admin/customers/{customer.Id}");
    }

    private void GoToPortal(CustomerListDto customer)
    {
        Nav.NavigateTo($"customer/portal/dashboard?customerId={customer.Id}");
    }

    // ═══════════════════════════════════════════════════
    // FATURALAMA
    // ═══════════════════════════════════════════════════

    private void OpenBillingModal()
    {
        billingError = null;
        billingSuccess = null;
        showBillingModal = true;
    }

    private void CloseBillingModal()
    {
        showBillingModal = false;
    }

    private async Task GenerateBilling()
    {
        isGeneratingBilling = true;
        billingError = null;
        billingSuccess = null;
        StateHasChanged();

        try
        {
            var dto = new BulkBillingGenerateDto { Year = billingYear, Month = billingMonth };
            var response = await Http.PostAsJsonAsync("api/customers/billing/generate", dto);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<BillingGenerateResult>();
                billingSuccess = $"{result?.Created} donem olusturuldu, {result?.Skipped} atlandi.";
                Toast.ShowSuccess(billingSuccess);
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                billingError = error?.Message ?? "Donem olusturma basarisiz.";
            }
        }
        catch (Exception ex) { billingError = $"Hata: {ex.Message}"; }
        finally { isGeneratingBilling = false; }
    }

    private record ErrorMsg(string? Message);
    private record BillingGenerateResult(int Created, int Skipped);
}
