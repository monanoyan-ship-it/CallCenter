@page "/admin/kvkk/privacy-notices"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums

<PageTitle>Aydinlatma Metinleri - CorpLynk</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-file-earmark-text me-2 text-primary"></i>Aydinlatma Metinleri
    </h4>
    <button class="btn btn-primary btn-sm" @onclick="ShowCreateForm">
        <i class="bi bi-plus-lg me-1"></i>Yeni Metin
    </button>
</div>

@* ─── FİLTRELER ─── *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <select class="form-select form-select-sm" @bind="filterCustomerId" @bind:after="LoadData">
                    <option value="0">Tum Musteriler</option>
                    @foreach (var c in customers)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <select class="form-select form-select-sm" @bind="filterTypeId" @bind:after="LoadData">
                    <option value="0">Tum Tipler</option>
                    @foreach (var t in PrivacyNoticeTypes.All)
                    {
                        <option value="@t.Id">@t.Description</option>
                    }
                </select>
            </div>
        </div>
    </div>
</div>

@* ─── TABLO ─── *@
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
        }
        else if (items.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-1 d-block mb-2 opacity-25"></i>
                <span>Aydinlatma metni bulunamadi</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width:60px">Durum</th>
                            <th>Baslik</th>
                            <th>Tip</th>
                            <th>Versiyon</th>
                            <th>Musteri</th>
                            <th>Yururluk</th>
                            <th>Ses Dosyasi</th>
                            <th>Onaylayan</th>
                            <th style="width:140px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr class="@(item.IsActive ? "" : "text-muted")">
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Pasif</span>
                                    }
                                </td>
                                <td>@item.Title</td>
                                <td>
                                    <small>@item.TypeName</small>
                                </td>
                                <td><code>@item.Version</code></td>
                                <td><small>@item.CustomerName</small></td>
                                <td>
                                    <small>@item.EffectiveFrom.ToString("dd.MM.yyyy")</small>
                                    @if (item.EffectiveTo.HasValue)
                                    {
                                        <small class="text-muted"> - @item.EffectiveTo.Value.ToString("dd.MM.yyyy")</small>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.GreetingMessageName))
                                    {
                                        <small><i class="bi bi-soundwave me-1"></i>@item.GreetingMessageName</small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">-</small>
                                    }
                                </td>
                                <td><small>@(item.ApprovedBy ?? "-")</small></td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm me-1" title="Goruntule"
                                            @onclick="() => ShowDetail(item.Uid)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    @if (!item.IsActive)
                                    {
                                        <button class="btn btn-outline-success btn-sm me-1" title="Aktif Yap"
                                                @onclick="() => ActivateNotice(item.Uid)">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    }
                                    <button class="btn btn-outline-secondary btn-sm" title="Duzenle"
                                            @onclick="() => ShowEditForm(item.Uid)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ─── OLUŞTURMA / DÜZENLEME MODAL ─── *@
@if (showForm)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-file-earmark-text me-2"></i>
                        @(isEditing ? "Aydinlatma Metni Duzenle" : "Yeni Aydinlatma Metni")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        @if (!isEditing)
                        {
                            <div class="col-md-6">
                                <label class="form-label">Musteri <span class="text-danger">*</span></label>
                                <select class="form-select" @bind="formCreate.CustomerId">
                                    <option value="0">Secin...</option>
                                    @foreach (var c in customers)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Tip <span class="text-danger">*</span></label>
                                <select class="form-select" @bind="formCreate.TypeId">
                                    @foreach (var t in PrivacyNoticeTypes.All)
                                    {
                                        <option value="@t.Id">@t.Description</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Versiyon <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" @bind="formCreate.Version" placeholder="v1.0" />
                            </div>
                        }
                        <div class="col-12">
                            <label class="form-label">Baslik <span class="text-danger">*</span></label>
                            <input type="text" class="form-control"
                                   value="@(isEditing ? formUpdate.Title : formCreate.Title)"
                                   @onchange="e => SetTitle(e.Value?.ToString())" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Icerik <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="10"
                                      value="@(isEditing ? formUpdate.Content : formCreate.Content)"
                                      @onchange="e => SetContent(e.Value?.ToString())"></textarea>
                            <small class="text-muted">Arayan kisiye okunacak veya IVR ile dinletilecek aydinlatma metni</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Onaylayan</label>
                            <input type="text" class="form-control"
                                   value="@(isEditing ? formUpdate.ApprovedBy : formCreate.ApprovedBy)"
                                   @onchange="e => SetApprovedBy(e.Value?.ToString())" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseForm">Iptal</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveForm" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-check-lg me-1"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ─── DETAY MODAL ─── *@
@if (showDetail && detailItem != null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-file-earmark-text me-2"></i>@detailItem.Title
                        @if (detailItem.IsActive)
                        {
                            <span class="badge bg-success ms-2">Aktif</span>
                        }
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => showDetail = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Tip:</strong> @detailItem.TypeName
                        </div>
                        <div class="col-md-4">
                            <strong>Versiyon:</strong> <code>@detailItem.Version</code>
                        </div>
                        <div class="col-md-4">
                            <strong>Musteri:</strong> @detailItem.CustomerName
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Yururluk:</strong> @detailItem.EffectiveFrom.ToString("dd.MM.yyyy HH:mm")
                        </div>
                        <div class="col-md-4">
                            <strong>Onaylayan:</strong> @(detailItem.ApprovedBy ?? "-")
                        </div>
                        <div class="col-md-4">
                            <strong>Ses:</strong> @(detailItem.GreetingMessageName ?? "-")
                        </div>
                    </div>
                    <hr />
                    <div class="border rounded p-3" style="max-height:400px;overflow:auto;white-space:pre-wrap;font-size:0.9rem;">@detailItem.Content</div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => showDetail = false">Kapat</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PrivacyNoticeListDto> items = new();
    private List<CustomerSimpleDto> customers = new();
    private PrivacyNoticeDto? detailItem;
    private bool isLoading = true;
    private bool showForm, showDetail, isEditing, isSaving;
    private int filterTypeId, filterCustomerId;
    private Guid? editingUid;

    private PrivacyNoticeCreateDto formCreate = new() { TypeId = PrivacyNoticeTypes.Ids.CallRecording };
    private PrivacyNoticeUpdateDto formUpdate = new();

    protected override async Task OnInitializedAsync()
    {
        try { customers = await Http.GetFromJsonAsync<List<CustomerSimpleDto>>("api/supervisor/customers") ?? new(); } catch { }
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var url = "api/kvkk/privacy-notices?";
            if (filterCustomerId > 0) url += $"customerId={filterCustomerId}&";
            if (filterTypeId > 0) url += $"typeId={filterTypeId}&";
            items = await Http.GetFromJsonAsync<List<PrivacyNoticeListDto>>(url) ?? new();
        }
        catch { Toast.ShowError("Veriler yuklenemedi."); }
        finally { isLoading = false; }
    }

    private void ShowCreateForm()
    {
        isEditing = false;
        editingUid = null;
        formCreate = new() { TypeId = PrivacyNoticeTypes.Ids.CallRecording };
        showForm = true;
    }

    private async Task ShowEditForm(Guid uid)
    {
        try
        {
            var detail = await Http.GetFromJsonAsync<PrivacyNoticeDto>($"api/kvkk/privacy-notices/{uid}");
            if (detail == null) { Toast.ShowError("Metin bulunamadi."); return; }
            isEditing = true;
            editingUid = uid;
            formUpdate = new()
            {
                Title = detail.Title,
                Content = detail.Content,
                ApprovedBy = detail.ApprovedBy,
                GreetingMessageId = detail.GreetingMessageId
            };
            showForm = true;
        }
        catch { Toast.ShowError("Metin yuklenemedi."); }
    }

    private async Task ShowDetail(Guid uid)
    {
        try
        {
            detailItem = await Http.GetFromJsonAsync<PrivacyNoticeDto>($"api/kvkk/privacy-notices/{uid}");
            showDetail = detailItem != null;
        }
        catch { Toast.ShowError("Detay yuklenemedi."); }
    }

    private void CloseForm() { showForm = false; isEditing = false; editingUid = null; }

    private async Task SaveForm()
    {
        isSaving = true;
        try
        {
            if (isEditing && editingUid.HasValue)
            {
                var resp = await Http.PutAsJsonAsync($"api/kvkk/privacy-notices/{editingUid}", formUpdate);
                if (resp.IsSuccessStatusCode)
                {
                    Toast.ShowSuccess("Aydinlatma metni guncellendi.");
                    CloseForm();
                    await LoadData();
                }
                else
                {
                    var err = await resp.Content.ReadFromJsonAsync<ErrorResponse>();
                    Toast.ShowError(err?.Error ?? "Guncelleme basarisiz.");
                }
            }
            else
            {
                if (string.IsNullOrWhiteSpace(formCreate.Title) || string.IsNullOrWhiteSpace(formCreate.Content) || string.IsNullOrWhiteSpace(formCreate.Version))
                {
                    Toast.ShowError("Baslik, icerik ve versiyon zorunludur.");
                    return;
                }

                var resp = await Http.PostAsJsonAsync("api/kvkk/privacy-notices", formCreate);
                if (resp.IsSuccessStatusCode)
                {
                    Toast.ShowSuccess("Aydinlatma metni olusturuldu.");
                    CloseForm();
                    await LoadData();
                }
                else
                {
                    var err = await resp.Content.ReadFromJsonAsync<ErrorResponse>();
                    Toast.ShowError(err?.Error ?? "Olusturma basarisiz.");
                }
            }
        }
        catch { Toast.ShowError("Bir hata olustu."); }
        finally { isSaving = false; }
    }

    private async Task ActivateNotice(Guid uid)
    {
        try
        {
            var resp = await Http.PostAsync($"api/kvkk/privacy-notices/{uid}/activate", null);
            if (resp.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Aydinlatma metni aktif yapildi.");
                await LoadData();
            }
            else
            {
                var err = await resp.Content.ReadFromJsonAsync<ErrorResponse>();
                Toast.ShowError(err?.Error ?? "Aktivasyon basarisiz.");
            }
        }
        catch { Toast.ShowError("Bir hata olustu."); }
    }

    private void SetTitle(string? val)
    {
        if (isEditing) formUpdate.Title = val;
        else formCreate.Title = val ?? "";
    }

    private void SetContent(string? val)
    {
        if (isEditing) formUpdate.Content = val;
        else formCreate.Content = val ?? "";
    }

    private void SetApprovedBy(string? val)
    {
        if (isEditing) formUpdate.ApprovedBy = val;
        else formCreate.ApprovedBy = val;
    }

    private record ErrorResponse(string? Error);
}
