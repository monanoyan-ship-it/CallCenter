@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs

@if (isVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi @(isEditMode ? "bi-pencil" : "bi-translate") me-2"></i>
                        @(isEditMode ? "Ceviri Duzenle" : "Yeni Key")
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger py-2 small">@errorMessage</div>
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small">Key</label>
                            <input type="text" class="form-control form-control-sm" @bind="key"
                                   disabled="@isEditMode" placeholder="module.key_name" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Modul</label>
                            <input type="text" class="form-control form-control-sm" @bind="module"
                                   placeholder="common" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Aciklama</label>
                            <input type="text" class="form-control form-control-sm" @bind="description" />
                        </div>
                    </div>

                    <hr class="my-3" />
                    <h6 class="small text-muted mb-3"><i class="bi bi-globe me-1"></i>Ceviriler</h6>

                    @foreach (var lang in Languages)
                    {
                        var langCode = lang.Code;
                        <div class="mb-3">
                            <label class="form-label small">
                                @lang.Name (@lang.Code)
                                @if (lang.IsDefault)
                                {
                                    <span class="badge bg-primary-subtle text-primary ms-1">Varsayilan</span>
                                }
                            </label>
                            <input type="text" class="form-control form-control-sm"
                                   value="@GetValue(langCode)"
                                   @onchange="e => HandleValueChange(langCode, e)" />
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="Close">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="HandleSubmit" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-check-lg me-1"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public List<LanguageDto> Languages { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool isVisible;
    private bool isEditMode;
    private bool isSaving;
    private string? errorMessage;
    private int editKeyId;

    private string key = "";
    private string module = "common";
    private string? description;
    private Dictionary<string, string> values = new();

    public void OpenForCreate()
    {
        isEditMode = false;
        key = "";
        module = "common";
        description = null;
        values = new();
        errorMessage = null;
        isVisible = true;
        StateHasChanged();
    }

    public void OpenForEdit(TranslationKeyListDto item)
    {
        isEditMode = true;
        editKeyId = item.Id;
        key = item.Key;
        module = item.Module;
        description = item.Description;
        values = new Dictionary<string, string>(item.Values);
        errorMessage = null;
        isVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        isVisible = false;
    }

    private string GetValue(string langCode)
    {
        return values.TryGetValue(langCode, out var v) ? v : "";
    }

    private void SetValue(string langCode, string value)
    {
        values[langCode] = value;
    }

    private void HandleValueChange(string langCode, ChangeEventArgs e)
    {
        SetValue(langCode, e.Value?.ToString() ?? string.Empty);
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(key))
        {
            errorMessage = "Key zorunludur.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            HttpResponseMessage response;

            if (isEditMode)
            {
                var dto = new TranslationKeyUpdateDto
                {
                    Module = module,
                    Description = description,
                    Values = values
                };
                response = await Http.PutAsJsonAsync($"api/translations/keys/{editKeyId}", dto);
            }
            else
            {
                var dto = new TranslationKeyCreateDto
                {
                    Key = key,
                    Module = module,
                    Description = description,
                    Values = values
                };
                response = await Http.PostAsJsonAsync("api/translations/keys", dto);
            }

            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess(isEditMode ? "Ceviri guncellendi." : "Key olusturuldu.");
                isVisible = false;
                await OnSaved.InvokeAsync();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                errorMessage = error?.Message ?? "Islem basarisiz.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Hata: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private record ErrorMsg(string? Message);
}
