        </div>
    </div>
}

} @* accessDenied else kapanisi *@

@code {
    private bool accessDenied;
    private List<StorageConfigListDto> configs = new();
    private bool isLoading = true;
    private int? testingId;

    // Modal
    private bool showModal;
    private int? editingId;
    private StorageConfigCreateDto formDto = new();
    private StorageConfigDetailDto? editingDetail;
    private string? formError;
    private bool isSaving;

    // OneDrive OAuth
    private string oneDriveTab = "easy";
    private bool oneDriveConnected;
    private bool oneDriveAuthLoading;
    private List<OneDriveDriveDto> oneDriveDrives = new();

    // Google Drive OAuth
    private string googleDriveTab = "easy";
    private bool googleDriveConnected;
    private bool googleDriveAuthLoading;
    private string? googleDriveEmail;
    private List<GoogleDriveFolderDto> googleDriveFolders = new();

    // Yandex OAuth
    private string yandexTab = "easy";
    private bool yandexConnected;
    private bool yandexAuthLoading;
    private string? yandexLogin;

    // Toast
    private string? toast;
    private bool toastError;

    protected override async Task OnInitializedAsync()
    {
        await PermService.LoadAsync();
        if (PermService.CustomerRoleId != CustomerRoles.Ids.FirmaAdmin)
        {
            accessDenied = true;
            return;
        }
        await LoadConfigsAsync();
    }

    private async Task LoadConfigsAsync()
    {
        isLoading = true;
        try
        {
            var list = await Http.GetFromJsonAsync<List<StorageConfigListDto>>("api/cloudstorage/configs");
            configs = list ?? new();
        }
        catch (Exception ex)
        {
            ShowToast($"Yuklenemedi: {ex.Message}", true);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateModal()
    {
        editingId = null;
        editingDetail = null;
        ResetAllOAuthStates();
        formDto = new StorageConfigCreateDto { IsDefault = true };
        formError = null;
        showModal = true;
    }

    private async Task ShowEditModal(int configId)
    {
        try
        {
            var detail = await Http.GetFromJsonAsync<StorageConfigDetailDto>($"api/cloudstorage/configs/{configId}");
            if (detail == null) return;

            editingId = configId;
            editingDetail = detail;
            ResetAllOAuthStates();

            formDto = new StorageConfigCreateDto
            {
                CustomerId = detail.CustomerId,
                ProviderTypeId = detail.ProviderTypeId,
                BasePath = detail.BasePath,
                IsDefault = detail.IsDefault
            };

            // Provider'a gore mevcut bilgileri doldur (maskelenmemis alanlar)
            if (detail.MaskedCredentials.Count > 0)
            {
                var creds = detail.MaskedCredentials;

                switch (detail.ProviderTypeId)
                {
                    case StorageProviders.Ids.OneDrive:
                        if (creds.TryGetValue("AuthMode", out var authMode))
                        {
                            formDto.MsAuthMode = authMode;
                            oneDriveTab = authMode == "ClientCredential" ? "advanced" : "easy";
                        }
                        if (creds.TryGetValue("TenantId", out var tenantId) && !string.IsNullOrEmpty(tenantId))
                            formDto.MsTenantId = tenantId;
                        if (creds.TryGetValue("DriveId", out var driveId) && !string.IsNullOrEmpty(driveId))
                            formDto.MsDriveId = driveId;
                        if (creds.TryGetValue("ClientId", out var msClientId) && !string.IsNullOrEmpty(msClientId))
                            formDto.MsClientId = msClientId;
                        if (creds.TryGetValue("FolderId", out var msFolderId) && !string.IsNullOrEmpty(msFolderId))
                            formDto.MsFolderId = msFolderId;
                        // RefreshToken varsa bagli kabul et
                        if (creds.TryGetValue("RefreshToken", out var rt) && !string.IsNullOrEmpty(rt))
                            oneDriveConnected = true;
                        break;

                    case StorageProviders.Ids.GoogleDrive:
                        if (creds.TryGetValue("ClientId", out var gClientId2) && !string.IsNullOrEmpty(gClientId2))
                            formDto.GoogleClientId = gClientId2;
                        if (creds.TryGetValue("FolderId", out var gFolderId2) && !string.IsNullOrEmpty(gFolderId2))
                            formDto.GoogleFolderId = gFolderId2;
                        if (creds.TryGetValue("RefreshToken", out var gRt) && !string.IsNullOrEmpty(gRt))
                            googleDriveConnected = true;
                        googleDriveTab = googleDriveConnected ? "easy" : "advanced";
                        break;

                    case StorageProviders.Ids.YandexDisk:
                        if (creds.TryGetValue("OAuthToken", out var yToken) && !string.IsNullOrEmpty(yToken))
                            yandexConnected = true;
                        yandexTab = yandexConnected ? "easy" : "advanced";
                        break;

                    case StorageProviders.Ids.AmazonS3:
                    case StorageProviders.Ids.MinIO:
                        if (creds.TryGetValue("BucketName", out var bucket)) formDto.BucketName = bucket;
                        if (creds.TryGetValue("Region", out var region)) formDto.Region = region;
                        if (creds.TryGetValue("Endpoint", out var endpoint)) formDto.Endpoint = endpoint;
                        break;
                }
            }

            formError = null;
            showModal = true;
        }
        catch (Exception ex)
        {
            ShowToast($"Detay alinamadi: {ex.Message}", true);
        }
    }

    private void CloseModal()
    {
        showModal = false;
        editingDetail = null;
        ResetAllOAuthStates();
    }

    private void SelectProvider(int providerId)
    {
        formDto.ProviderTypeId = providerId;
    }

    private void SetOneDriveTab(string tab)
    {
        oneDriveTab = tab;
        formDto.MsAuthMode = tab == "advanced" ? "ClientCredential" : "Delegated";
    }

    private async Task StartOneDriveOAuth()
    {
        oneDriveAuthLoading = true;
        try
        {
            var tenantId = formDto.MsTenantId;
            var url = $"api/CloudStorage/onedrive/auth-url" + (!string.IsNullOrEmpty(tenantId) ? $"?tenantId={tenantId}" : "");
            var result = await Http.GetFromJsonAsync<OneDriveAuthUrlDto>(url);
            if (result != null)
            {
                // Popup pencere ac
                await JS.InvokeVoidAsync("openOneDriveAuth", result.AuthUrl, DotNetObjectReference.Create(this));
            }
        }
        catch (Exception ex)
        {
            formError = $"OAuth baslatma hatasi: {ex.Message}";
        }
        finally
        {
            oneDriveAuthLoading = false;
        }
    }

    [JSInvokable]
    public async Task OnOneDriveAuthCallback(string code)
    {
        try
        {
            var dto = new OneDriveExchangeCodeDto { Code = code, TenantId = formDto.MsTenantId };
            var result = await Http.PostAsJsonAsync("api/CloudStorage/onedrive/exchange-code", dto);
            var authResult = await result.Content.ReadFromJsonAsync<OneDriveAuthResultDto>();

            if (authResult?.Success == true)
            {
                formDto.MsAuthMode = "Delegated";
                formDto.MsRefreshToken = authResult.RefreshToken;
                if (!string.IsNullOrEmpty(authResult.TenantId))
                    formDto.MsTenantId = authResult.TenantId;
                oneDriveDrives = authResult.Drives;
                if (oneDriveDrives.Count > 0)
                    formDto.MsDriveId = oneDriveDrives[0].DriveId;
                oneDriveConnected = true;
            }
            else
            {
                formError = authResult?.Error ?? "Baglanti kurulamadi";
            }
        }
        catch (Exception ex)
        {
            formError = $"Token exchange hatasi: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task SaveConfigAsync()
    {
        if (formDto.ProviderTypeId == 0)
        {
            formError = "Depolama saglayicisi secin";
            return;
        }

        isSaving = true;
        formError = null;
        try
        {
            if (editingId.HasValue)
            {
                var updateDto = new StorageConfigUpdateDto
                {
                    ProviderTypeId = formDto.ProviderTypeId,
                    BasePath = formDto.BasePath,
                    IsDefault = formDto.IsDefault,
                    AccessKey = formDto.AccessKey,
                    SecretKey = formDto.SecretKey,
                    BucketName = formDto.BucketName,
                    Region = formDto.Region,
                    Endpoint = formDto.Endpoint,
                    GoogleClientId = formDto.GoogleClientId,
                    GoogleClientSecret = formDto.GoogleClientSecret,
                    GoogleRefreshToken = formDto.GoogleRefreshToken,
                    GoogleFolderId = formDto.GoogleFolderId,
                    MsClientId = formDto.MsClientId,
                    MsClientSecret = formDto.MsClientSecret,
                    MsRefreshToken = formDto.MsRefreshToken,
                    MsTenantId = formDto.MsTenantId,
                    MsDriveId = formDto.MsDriveId,
                    MsFolderId = formDto.MsFolderId,
                    YandexOAuthToken = formDto.YandexOAuthToken
                };
                var response = await Http.PutAsJsonAsync($"api/cloudstorage/configs/{editingId}", updateDto);
                if (!response.IsSuccessStatusCode)
                {
                    formError = await response.Content.ReadAsStringAsync();
                    return;
                }
                ShowToast("Config guncellendi", false);
            }
            else
            {
                var response = await Http.PostAsJsonAsync("api/cloudstorage/configs", formDto);
                if (!response.IsSuccessStatusCode)
                {
                    formError = await response.Content.ReadAsStringAsync();
                    return;
                }
                ShowToast("Config olusturuldu", false);
            }

            showModal = false;
            await LoadConfigsAsync();
        }
        catch (Exception ex)
        {
            formError = $"Hata: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task TestConnectionAsync(int configId)
    {
        testingId = configId;
        try
        {
            var result = await Http.PostAsync($"api/cloudstorage/configs/{configId}/test", null);
            var test = await result.Content.ReadFromJsonAsync<StorageTestResultDto>();

            if (test?.Success == true)
                ShowToast("Baglanti basarili!", false);
            else
                ShowToast($"Baglanti basarisiz: {test?.Error}", true);

            await LoadConfigsAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Test hatasi: {ex.Message}", true);
        }
        finally
        {
            testingId = null;
        }
    }

    private async Task DeleteConfigAsync(int configId)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/cloudstorage/configs/{configId}");
            if (response.IsSuccessStatusCode)
            {
                ShowToast("Config silindi", false);
                await LoadConfigsAsync();
            }
            else
            {
                ShowToast("Silinemedi", true);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Hata: {ex.Message}", true);
        }
    }

    private static bool IsNetworkPath(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return false;
        var trimmed = path.Trim();
        return trimmed.StartsWith(@"\\") || trimmed.StartsWith("//");
    }

    private void ResetAllOAuthStates()
    {
        oneDriveConnected = false;
        oneDriveDrives = new();
        oneDriveTab = "easy";
        googleDriveConnected = false;
        googleDriveFolders = new();
        googleDriveEmail = null;
        googleDriveTab = "easy";
        googleDriveAuthLoading = false;
        yandexConnected = false;
        yandexLogin = null;
        yandexTab = "easy";
        yandexAuthLoading = false;
    }

    private void ReconnectOneDrive()
    {
        oneDriveConnected = false;
        oneDriveDrives = new();
    }

    private void ReconnectGoogleDrive()
    {
        googleDriveConnected = false;
        googleDriveFolders = new();
        googleDriveEmail = null;
    }

    private void ReconnectYandex()
    {
        yandexConnected = false;
        yandexLogin = null;
    }

    // ─── Google Drive OAuth ───

    private async Task StartGoogleDriveOAuth()
    {
        googleDriveAuthLoading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<GoogleDriveAuthUrlDto>("api/CloudStorage/googledrive/auth-url");
            if (result != null)
            {
                await JS.InvokeVoidAsync("openOAuthPopup",
                    result.AuthUrl,
                    "googledrive-auth-success",
                    "googledrive-auth-error",
                    DotNetObjectReference.Create(this),
                    "OnGoogleDriveAuthCallback");
            }
        }
        catch (Exception ex)
        {
            formError = $"Google OAuth baslatma hatasi: {ex.Message}";
        }
        finally
        {
            googleDriveAuthLoading = false;
        }
    }

    [JSInvokable]
    public async Task OnGoogleDriveAuthCallback(string code)
    {
        try
        {
            var dto = new GoogleDriveExchangeCodeDto { Code = code };
            var result = await Http.PostAsJsonAsync("api/CloudStorage/googledrive/exchange-code", dto);
            var authResult = await result.Content.ReadFromJsonAsync<GoogleDriveAuthResultDto>();

            if (authResult?.Success == true)
            {
                formDto.GoogleRefreshToken = authResult.RefreshToken;
                googleDriveEmail = authResult.Email;
                googleDriveFolders = authResult.Folders;
                if (googleDriveFolders.Count > 0)
                    formDto.GoogleFolderId = googleDriveFolders[0].Id;
                googleDriveConnected = true;
            }
            else
            {
                formError = authResult?.Error ?? "Google baglantisi kurulamadi";
            }
        }
        catch (Exception ex)
        {
            formError = $"Google token exchange hatasi: {ex.Message}";
        }
        StateHasChanged();
    }

    // ─── Yandex OAuth ───

    private async Task StartYandexOAuth()
    {
        yandexAuthLoading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<YandexAuthUrlDto>("api/CloudStorage/yandex/auth-url");
            if (result != null)
            {
                await JS.InvokeVoidAsync("openOAuthPopup",
                    result.AuthUrl,
                    "yandex-auth-success",
                    "yandex-auth-error",
                    DotNetObjectReference.Create(this),
                    "OnYandexAuthCallback");
            }
        }
        catch (Exception ex)
        {
            formError = $"Yandex OAuth baslatma hatasi: {ex.Message}";
        }
        finally
        {
            yandexAuthLoading = false;
        }
    }

    [JSInvokable]
    public async Task OnYandexAuthCallback(string code)
    {
        try
        {
            var dto = new YandexExchangeCodeDto { Code = code };
            var result = await Http.PostAsJsonAsync("api/CloudStorage/yandex/exchange-code", dto);
            var authResult = await result.Content.ReadFromJsonAsync<YandexAuthResultDto>();

            if (authResult?.Success == true)
            {
                formDto.YandexOAuthToken = authResult.OAuthToken;
                yandexLogin = authResult.Login;
                yandexConnected = true;
            }
            else
            {
                formError = authResult?.Error ?? "Yandex baglantisi kurulamadi";
            }
        }
        catch (Exception ex)
        {
            formError = $"Yandex token exchange hatasi: {ex.Message}";
        }
        StateHasChanged();
    }

    private static string GetCredentialLabel(string key) => key switch
    {
        "AccessKey" => "Erisim Anahtari",
        "SecretKey" => "Gizli Anahtar",
        "BucketName" => "Bucket Adi",
        "Region" => "Bolge",
        "Endpoint" => "Endpoint",
        "ClientId" => "Client ID",
        "ClientSecret" => "Client Secret",
        "RefreshToken" => "Refresh Token",
        "FolderId" => "Klasor ID",
        "AuthMode" => "Kimlik Dogrulama",
        "TenantId" => "Tenant ID",
        "DriveId" => "Drive ID",
        "OAuthToken" => "OAuth Token",
        "Prefix" => "Key Prefix",
        "UseSSL" => "SSL",
        "BasePath" => "Klasor Yolu",
        _ => key
    };

    private void ShowToast(string message, bool error)
    {
        toast = message;
        toastError = error;
        StateHasChanged();
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            toast = null;
            InvokeAsync(StateHasChanged);
        });
    }
}
