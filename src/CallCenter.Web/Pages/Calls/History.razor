@page "/customer/calls/history"
@attribute [Authorize(Roles = "CustomerUser")]
@inject HttpClient Http
@using CallCenter.Shared.Enums

<div class="history-page">
    <div class="page-header mb-3">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <h5><i class="bi bi-clock-history me-2"></i>Arama Gecmisi</h5>
            <div class="d-flex gap-2">
                <div class="input-group input-group-sm search-box">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Numara ara..."
                           @bind="searchTerm" @bind:event="oninput" />
                </div>
                <select class="form-select form-select-sm filter-select" @bind="filterDirection">
                    <option value="0">Tum Yonler</option>
                    <option value="@CallDirections.Ids.Inbound">Gelen</option>
                    <option value="@CallDirections.Ids.Outbound">Giden</option>
                </select>
                <select class="form-select form-select-sm filter-select" @bind="filterStatus">
                    <option value="0">Tum Durumlar</option>
                    @foreach (var status in CallStatuses.FinishedStatuses)
                    {
                        <option value="@status.Id">@(StatusNames.TryGetValue(status.SystemName, out var n) ? n : status.SystemName)</option>
                    }
                </select>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Yukleniyor...</span>
            </div>
        </div>
    }
    else if (filteredRecords.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-clock"></i>
            <h6>Arama gecmisi bos</h6>
            <p>Henuz tamamlanmis bir arama bulunmuyor.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table history-table">
                <thead>
                    <tr>
                        <th>Yon</th>
                        <th>Temsilci</th>
                        <th>Arayan</th>
                        <th>Aranan</th>
                        <th>Durum</th>
                        <th>Tarih</th>
                        <th>Sure</th>
                        <th>Kuyruk</th>
                        <th>Kayit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in filteredRecords)
                    {
                        var dirItem = CallDirections.GetById(record.DirectionId);
                        var statusItem = CallStatuses.GetById(record.StatusId);
                        <tr>
                            <td>
                                <i class="bi @(dirItem?.Icon ?? "bi-telephone-fill") @(dirItem?.CssClass ?? "")"
                                   title="@(dirItem?.SystemName == "Inbound" ? "Gelen" : "Giden")"></i>
                            </td>
                            <td class="small">@(record.AgentName ?? "-")</td>
                            <td class="fw-medium">@record.CallerNumber</td>
                            <td>@record.CalleeNumber</td>
                            <td>
                                <span class="badge @(statusItem?.CssClass ?? "bg-secondary")">
                                    @(StatusNames.TryGetValue(statusItem?.SystemName ?? "", out var sn) ? sn : statusItem?.SystemName ?? "")
                                </span>
                            </td>
                            <td class="text-muted small">@record.StartedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="fw-medium">@FormatDuration(record.DurationSeconds)</td>
                            <td class="small text-muted">@(record.QueueName ?? "-")</td>
                            <td>
                                @if (record.HasRecording && !isOperator)
                                {
                                    var isCurrentlyPlaying = playingCallUid == record.Uid;
                                    <button class="btn btn-sm @(isCurrentlyPlaying ? "btn-warning" : "btn-outline-success")"
                                            @onclick="() => TogglePlay(record.Uid)"
                                            title="@(isCurrentlyPlaying ? "Durdur" : "Dinle")">
                                        <i class="bi @(isCurrentlyPlaying ? "bi-stop-fill" : "bi-play-circle")"></i>
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* ─── Sayfalama ─── *@
        @if (totalPages > 1)
        {
            <nav class="d-flex align-items-center justify-content-between mt-3">
                <small class="text-muted">Toplam @totalCount kayit</small>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                    </li>
                    @foreach (var p in GetPageNumbers())
                    {
                        @if (p == -1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                        else
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(p)">@p</button>
                            </li>
                        }
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@* Recording Player Modal *@
@if (playingCallUid != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title"><i class="bi bi-soundwave me-2"></i>Ses Kaydi</h6>
                    <button type="button" class="btn-close" @onclick="OnPlayerClose"></button>
                </div>
                <div class="modal-body">
                    <AudioPlayer CallUid="playingCallUid.Value"
                                 OnPlaybackEnded="OnPlaybackEnded"
                                 OnClose="OnPlayerClose" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private List<CallHistoryItem> callRecords = new();
    private string searchTerm = "";
    private int filterDirection;
    private int filterStatus;
    private Guid? playingCallUid;
    private bool isOperator;

    private int currentPage = 1;
    private int pageSize = 50;
    private int totalCount;
    private int totalPages => (int)Math.Ceiling((double)totalCount / pageSize);

    private static readonly Dictionary<string, string> StatusNames = new()
    {
        { "Completed", "Tamamlandi" },
        { "Missed", "Cevapsiz" },
        { "Failed", "Basarisiz" },
        { "Transferred", "Transfer" }
    };

    private List<CallHistoryItem> filteredRecords => callRecords
        .Where(r => string.IsNullOrEmpty(searchTerm) ||
                     r.CallerNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                     r.CalleeNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .Where(r => filterDirection == 0 || r.DirectionId == filterDirection)
        .Where(r => filterStatus == 0 || r.StatusId == filterStatus)
        .OrderByDescending(r => r.StartedAt)
        .ToList();

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState != null)
        {
            var state = await AuthState;
            var customerRoleStr = state.User.FindFirst("CustomerRoleId")?.Value;
            if (int.TryParse(customerRoleStr, out var customerRoleId))
                isOperator = customerRoleId == CustomerRoles.Ids.Operator;
        }

        await LoadHistory();
    }

    private async Task LoadHistory()
    {
        isLoading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<HistoryResponse>($"api/calls/history?page={currentPage}&pageSize={pageSize}");
            if (result != null)
            {
                callRecords = result.Items ?? new();
                totalCount = result.TotalCount;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[History] Veri yuklenemedi: {ex.Message}");
            callRecords = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > totalPages || page == currentPage) return;
        currentPage = page;
        await LoadHistory();
    }

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        if (totalPages <= 7)
        {
            for (int i = 1; i <= totalPages; i++) pages.Add(i);
        }
        else
        {
            pages.Add(1);
            if (currentPage > 3) pages.Add(-1); // ellipsis
            for (int i = Math.Max(2, currentPage - 1); i <= Math.Min(totalPages - 1, currentPage + 1); i++)
                pages.Add(i);
            if (currentPage < totalPages - 2) pages.Add(-1); // ellipsis
            pages.Add(totalPages);
        }
        return pages;
    }

    private void TogglePlay(Guid callUid)
    {
        if (playingCallUid == callUid)
        {
            playingCallUid = null;
        }
        else
        {
            playingCallUid = callUid;
        }
    }

    private void OnPlaybackEnded()
    {
        // Keep player visible, user can close manually
    }

    private void OnPlayerClose()
    {
        playingCallUid = null;
        StateHasChanged();
    }

    private string FormatDuration(int seconds)
    {
        if (seconds <= 0) return "-";
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.Hours > 0 ? ts.ToString(@"hh\:mm\:ss") : ts.ToString(@"mm\:ss");
    }

    private class HistoryResponse
    {
        public List<CallHistoryItem> Items { get; set; } = new();
        public int TotalCount { get; set; }
        public int Page { get; set; }
        public int PageSize { get; set; }
    }

    private class CallHistoryItem
    {
        public int Id { get; set; }
        public Guid Uid { get; set; }
        public string CallerNumber { get; set; } = "";
        public string CalleeNumber { get; set; } = "";
        public int DirectionId { get; set; }
        public int StatusId { get; set; }
        public DateTime StartedAt { get; set; }
        public int DurationSeconds { get; set; }
        public string? QueueName { get; set; }
        public string? AgentName { get; set; }
        public bool HasRecording { get; set; }
        public bool IsRecordingEncrypted { get; set; }
        public long? RecordingFileSize { get; set; }
    }
}
