@page "/customer/dialer"
@attribute [Authorize(Roles = "CustomerUser")]
@inject HubService HubService
@inject SipService SipService
@inject HttpClient Http
@inject ToastService Toast
@inject PermissionService PermService
@using CallCenter.Shared.Enums
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Helpers
@implements IAsyncDisposable

@if (!isOperatorRole)
{
    <div class="alert alert-warning d-flex align-items-center">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <span>Yalnizca Operator rolundeki kullanicilar arama yapabilir.</span>
    </div>
}

<div class="dialer-page" style="@(!isOperatorRole ? "opacity: 0.5; pointer-events: none;" : "")">
    <div class="row g-3">
        <div class="@(myCallList != null && myCallList.Count > 0 ? "col-lg-5 col-xl-4" : "col-12")">
            <div class="dialer-card">
                <div class="dialer-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5><i class="bi bi-telephone-fill me-2"></i>Cagri Takip</h5>
                        @* SIP Kayıt Durumu *@
                        <span class="badge @(SipService.IsRegistered ? "bg-success" : "bg-secondary") sip-badge">
                            <i class="bi @(SipService.IsRegistered ? "bi-wifi" : "bi-wifi-off") me-1"></i>
                            @(SipService.IsRegistered ? "SIP Kayitli" : sipStatusText)
                        </span>
                    </div>
                </div>

                @* ─── Numara Gosterge ─── *@
                <div class="number-display">
                    <input type="text" class="form-control number-input"
                           @bind="phoneNumber" @bind:event="oninput"
                           placeholder="Numara girin..."
                           @onkeydown="HandleKeyDown" />
                    @if (!string.IsNullOrEmpty(phoneNumber))
                    {
                        <button class="btn btn-link clear-btn" @onclick="ClearNumber">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                    <button class="btn btn-link contacts-btn" title="Rehberden Sec" @onclick="OpenContactPicker">
                        <i class="bi bi-person-vcard-fill"></i>
                    </button>
                </div>

                @* ─── Tus Takimi ─── *@
                <div class="keypad">
                    @foreach (var row in keypadRows)
                    {
                        <div class="keypad-row">
                            @foreach (var key in row)
                            {
                                <button class="keypad-btn" @onclick="() => PressKey(key.digit)">
                                    <span class="digit">@key.digit</span>
                                    @if (!string.IsNullOrEmpty(key.letters))
                                    {
                                        <span class="letters">@key.letters</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                </div>

                @* ─── Arama Butonlari ─── *@
                <div class="call-actions">
                    @if (!isInCall)
                    {
                        <button class="btn call-btn call-start"
                                disabled="@(string.IsNullOrWhiteSpace(phoneNumber) || !SipService.IsRegistered || isCallStarting)"
                                @onclick="StartCall">
                            <i class="bi bi-telephone-fill"></i>
                            <span>@(isCallStarting ? "Araniyor..." : "Ara")</span>
                        </button>
                    }
                    else
                    {
                        <div class="in-call-actions">
                            <button class="btn call-btn @(SipService.IsOnHold ? "call-resume" : "call-hold")"
                                    @onclick="ToggleHold">
                                <i class="bi @(SipService.IsOnHold ? "bi-play-circle-fill" : "bi-pause-circle-fill")"></i>
                                <span>@(SipService.IsOnHold ? "Devam" : "Beklet")</span>
                            </button>
                            <button class="btn call-btn @(isVideoEnabled ? "call-hold" : "call-start")" style="background: #6f42c1;"
                                    @onclick="ToggleVideo" title="@(isVideoEnabled ? "Video Kapat" : "Video Ac")">
                                <i class="bi @(isVideoEnabled ? "bi-camera-video-off-fill" : "bi-camera-video-fill")"></i>
                                <span>Video</span>
                            </button>
                            <button class="btn call-btn call-end" @onclick="EndCall">
                                <i class="bi bi-telephone-x-fill"></i>
                                <span>Kapat</span>
                            </button>
                        </div>
                        <div class="call-timer mt-2">
                            <i class="bi bi-clock"></i>
                            <span>@callDuration</span>
                        </div>
                    }
                </div>

                @* ─── Durum Mesaji ─── *@
                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <div class="status-message @statusClass">
                        @statusMessage
                    </div>
                }
            </div>
        </div>

        @* ─── Arama Listem (Kampanya) ─── *@
        @if (myCallList != null && myCallList.Count > 0)
        {
            <div class="col-lg-7 col-xl-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h6 class="mb-0"><i class="bi bi-list-check me-2"></i>Arama Listem (@myCallList.Count)</h6>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadMyCallList" title="Yenile">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                            <table class="table table-hover align-middle mb-0 small">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Kisi</th>
                                        <th>Telefon</th>
                                        <th>Kampanya</th>
                                        <th class="text-center">Deneme</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in myCallList)
                                    {
                                        <tr class="@(activeCallListItemId == item.CampaignContactId ? "table-active" : "")">
                                            <td class="fw-medium">@item.ContactName</td>
                                            <td>@item.PhoneNumber</td>
                                            <td class="text-muted">@item.CampaignName</td>
                                            <td class="text-center">@item.AttemptCount</td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-primary" title="Ara"
                                                            @onclick="() => CallFromList(item)"
                                                            disabled="@(isInCall || !SipService.IsRegistered)">
                                                        <i class="bi bi-telephone-fill"></i>
                                                    </button>
                                                    <button class="btn btn-outline-success" title="Ulasildi"
                                                            @onclick="() => MarkListItem(item, 3)">
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger" title="Ulasilamadi"
                                                            @onclick="() => MarkListItem(item, 4)">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* ─── Rehber Secici ─── *@
@if (showContactPicker)
{
    <div class="contact-picker-backdrop" @onclick="CloseContactPicker"></div>
    <div class="contact-picker">
        <div class="contact-picker-header">
            <h6 class="mb-0"><i class="bi bi-person-vcard-fill me-2"></i>Rehberden Sec</h6>
            <button class="btn btn-sm btn-link" @onclick="CloseContactPicker"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="contact-picker-search">
            <input type="text" class="form-control form-control-sm" placeholder="Ara..."
                   @bind="contactSearch" @bind:event="oninput" @onkeyup="SearchContacts" />
        </div>
        <div class="contact-picker-list">
            @if (contactResults == null)
            {
                <div class="text-center text-muted py-3">
                    <div class="spinner-border spinner-border-sm" role="status"></div>
                </div>
            }
            else if (contactResults.Count == 0)
            {
                <div class="text-center text-muted py-3 small">Sonuc bulunamadi</div>
            }
            else
            {
                @foreach (var c in contactResults)
                {
                    <button class="contact-pick-item" @onclick="() => PickContact(c)">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-person-circle text-muted"></i>
                            <div>
                                <div class="fw-medium small">@c.FullName</div>
                                <div class="text-muted" style="font-size:0.75rem;">@c.PhoneNumber</div>
                            </div>
                        </div>
                    </button>
                }
            }
        </div>
    </div>
}

@code {
    private string _phoneNumber = "";
    private string phoneNumber
    {
        get => _phoneNumber;
        set => _phoneNumber = PhoneHelper.Sanitize(value);
    }
    private bool isOperatorRole;
    private bool isInCall;
    private bool isCallStarting;
    private bool isVideoEnabled;
    private string statusMessage = "";
    private string statusClass = "";
    private string callDuration = "00:00";
    private string sipStatusText = "Baglaniyor...";
    private System.Timers.Timer? callTimer;
    private DateTime callStartTime;
    private int? currentCallId; // DB'deki arama kaydinin ID'si
    private bool showContactPicker;
    private string contactSearch = "";
    private List<ContactDto>? contactResults;
    private List<MyCallListItemDto>? myCallList;
    private int? activeCallListItemId;

    private readonly (string digit, string letters)[][] keypadRows = new[]
    {
        new[] { ("1", ""), ("2", "ABC"), ("3", "DEF") },
        new[] { ("4", "GHI"), ("5", "JKL"), ("6", "MNO") },
        new[] { ("7", "PQRS"), ("8", "TUV"), ("9", "WXYZ") },
        new[] { ("*", ""), ("0", "+"), ("#", "") }
    };

    protected override async Task OnInitializedAsync()
    {
        await PermService.LoadAsync();
        isOperatorRole = PermService.CustomerRoleId == CallCenter.Shared.Enums.CustomerRoles.Ids.Operator;

        // SIP event'lerini dinle
        SipService.OnRegistered += HandleSipRegistered;
        SipService.OnRegistrationFailed += HandleSipRegistrationFailed;
        SipService.OnCallAnswered += HandleCallAnswered;
        SipService.OnCallEnded += HandleCallEnded;
        SipService.OnCallFailed += HandleCallFailed;

        // Arama listesini yukle
        await LoadMyCallList();

        // SIP zaten kayıtlıysa (başka sayfadan gelmiş olabilir) tekrar initialize etme
        if (SipService.IsRegistered)
        {
            sipStatusText = "SIP Kayitli";
            return;
        }

        // SIP bağlantı bilgilerini API'den çek
        await InitializeSip();
    }

    private async Task InitializeSip()
    {
        try
        {
            var response = await Http.GetAsync("api/sipaccounts/my/connection");

            if (!response.IsSuccessStatusCode)
            {
                sipStatusText = "SIP Yok";
                statusMessage = "SIP hesabi bulunamadi. Yonetici ile iletisime gecin.";
                statusClass = "text-warning";
                return;
            }

            var sipInfo = await response.Content.ReadFromJsonAsync<SipConnectionInfoDto>();
            if (sipInfo == null)
            {
                sipStatusText = "SIP Hata";
                return;
            }

            sipStatusText = "Kayit olunuyor...";
            StateHasChanged();

            await SipService.InitializeAsync(
                sipInfo.WsUri,
                sipInfo.SipUri,
                sipInfo.AuthUsername,
                sipInfo.AuthPassword,
                sipInfo.DisplayName,
                sipInfo.StunServer,
                sipInfo.TurnServer,
                sipInfo.TurnUsername,
                sipInfo.TurnPassword,
                sipInfo.PreferredCodecs,
                sipInfo.JitterBufferMinMs,
                sipInfo.JitterBufferMaxMs);
        }
        catch (Exception ex)
        {
            sipStatusText = "SIP Hata";
            statusMessage = "SIP baglanti hatasi: " + ex.Message;
            statusClass = "text-danger";
            Console.WriteLine($"[Dialer] SIP init hatasi: {ex.Message}");
        }
    }

    // ═══════════════════════════════════════════════════════════════
    // SIP EVENT HANDLER'LAR
    // ═══════════════════════════════════════════════════════════════

    private Task HandleSipRegistered()
    {
        sipStatusText = "SIP Kayitli";
        statusMessage = "";
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleSipRegistrationFailed(string error)
    {
        sipStatusText = "SIP Hata";
        statusMessage = "SIP kayit hatasi: " + error;
        statusClass = "text-danger";
        return InvokeAsync(StateHasChanged);
    }

    private async Task HandleCallAnswered()
    {
        isCallStarting = false;
        statusMessage = $"{phoneNumber} ile gorusme baslatildi";
        statusClass = "text-success";

        // DB'deki arama kaydini "cevaplandi" olarak isaretle
        if (currentCallId.HasValue)
        {
            try
            {
                await Http.PutAsync($"api/calls/{currentCallId.Value}/answer", null);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Dialer] Arama cevaplandi kaydi yapilamadi: {ex.Message}");
            }
        }

        // Timer'i baslat
        callStartTime = DateTime.Now;
        callTimer = new System.Timers.Timer(1000);
        callTimer.Elapsed += (s, e) =>
        {
            var elapsed = DateTime.Now - callStartTime;
            callDuration = elapsed.ToString(@"mm\:ss");
            InvokeAsync(StateHasChanged);
        };
        callTimer.Start();

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleCallEnded()
    {
        StopTimer();
        isInCall = false;
        isCallStarting = false;

        // DB'deki arama kaydini sonlandir
        if (currentCallId.HasValue)
        {
            try
            {
                await Http.PutAsync($"api/calls/{currentCallId.Value}/end", null);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Dialer] Arama kaydi sonlandirilamadi: {ex.Message}");
            }
            currentCallId = null;
        }

        statusMessage = $"Arama sonlandirildi ({callDuration})";
        statusClass = "text-muted";
        callDuration = "00:00";

        // Agent durumunu AfterCallWork yap
        await HubService.UpdateStatusAsync(AgentStatuses.Ids.AfterCallWork);

        await InvokeAsync(StateHasChanged);

        // 5 saniye sonra Available'a don
        _ = Task.Run(async () =>
        {
            await Task.Delay(5000);
            await HubService.UpdateStatusAsync(AgentStatuses.Ids.Available);
        });
    }

    private Task HandleCallFailed(string error)
    {
        StopTimer();
        isInCall = false;
        isCallStarting = false;

        statusMessage = "Arama basarisiz: " + error;
        statusClass = "text-danger";
        callDuration = "00:00";

        return InvokeAsync(StateHasChanged);
    }

    // ═══════════════════════════════════════════════════════════════
    // KULLANICI AKSIYONLARI
    // ═══════════════════════════════════════════════════════════════

    private void PressKey(string key)
    {
        phoneNumber += key;

        // Arama sırasında tuşa basınca DTMF gönder
        if (isInCall && !isCallStarting)
        {
            _ = SipService.SendDtmfAsync(key);
        }
    }

    private void ClearNumber()
    {
        phoneNumber = "";
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(phoneNumber) && !isInCall)
        {
            _ = StartCall();
        }
    }

    private async Task StartCall()
    {
        if (string.IsNullOrWhiteSpace(phoneNumber) || !SipService.IsRegistered) return;

        isCallStarting = true;
        isInCall = true;
        statusMessage = $"{phoneNumber} araniyor...";
        statusClass = "text-info";

        try
        {
            // Agent durumunu InCall yap
            await HubService.UpdateStatusAsync(AgentStatuses.Ids.InCall);

            // 1. Once API'ye arama kaydini olustur
            var request = new StartCallRequest
            {
                CallerNumber = "me", // Agent kendisi
                CalleeNumber = phoneNumber
            };
            var response = await Http.PostAsJsonAsync("api/calls/start", request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<CallStartResult>();
                currentCallId = result?.Id;
            }
            else
            {
                Console.WriteLine("[Dialer] API arama kaydi olusturulamadi");
            }

            // 2. SIP aramasini baslat
            var success = await SipService.MakeCallAsync(phoneNumber);
            if (!success)
            {
                // SIP baslatilamazsa DB kaydini da sonlandir
                if (currentCallId.HasValue)
                {
                    await Http.PutAsync($"api/calls/{currentCallId.Value}/end", null);
                    currentCallId = null;
                }
                isInCall = false;
                isCallStarting = false;
                statusMessage = "Arama baslatilamadi";
                statusClass = "text-danger";
                await HubService.UpdateStatusAsync(AgentStatuses.Ids.Available);
            }
        }
        catch (Exception ex)
        {
            isInCall = false;
            isCallStarting = false;
            statusMessage = "Arama hatasi: " + ex.Message;
            statusClass = "text-danger";
            currentCallId = null;
        }
    }

    private async Task ToggleHold()
    {
        if (SipService.IsOnHold)
        {
            var success = await SipService.UnholdAsync();
            if (success)
            {
                statusMessage = $"{phoneNumber} ile gorusme devam ediyor";
                statusClass = "text-success";
            }
        }
        else
        {
            var success = await SipService.HoldAsync();
            if (success)
            {
                statusMessage = "Arama beklemede...";
                statusClass = "text-warning";
            }
        }
    }

    private async Task ToggleVideo()
    {
        try
        {
            isVideoEnabled = await SipService.ToggleVideoAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            statusMessage = "Video hatasi: " + ex.Message;
            statusClass = "text-danger";
        }
    }

    private async Task EndCall()
    {
        isVideoEnabled = false;
        // SIP kapatilinca HandleCallEnded event'i otomatik tetiklenecek
        // orada DB kaydi da sonlandirilir
        await SipService.HangupAsync();
    }

    // ─── Rehber Secici ───

    private async Task OpenContactPicker()
    {
        showContactPicker = true;
        contactSearch = "";
        try
        {
            contactResults = await Http.GetFromJsonAsync<List<ContactDto>>("api/contact?search=&page=1&pageSize=500");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Dialer] Rehber yuklenemedi: {ex.Message}");
            contactResults = new();
        }
    }

    private void CloseContactPicker() => showContactPicker = false;

    private async Task SearchContacts()
    {
        try
        {
            var query = string.IsNullOrWhiteSpace(contactSearch) ? "" : Uri.EscapeDataString(contactSearch);
            contactResults = await Http.GetFromJsonAsync<List<ContactDto>>($"api/contact?search={query}&page=1&pageSize=500");
        }
        catch
        {
            contactResults = new();
        }
    }

    private void PickContact(ContactDto contact)
    {
        phoneNumber = contact.PhoneNumber ?? "";
        showContactPicker = false;
    }

    // ═══════════════════════════════════════════════════════════════
    // ARAMA LİSTESİ (KAMPANYA)
    // ═══════════════════════════════════════════════════════════════

    private async Task LoadMyCallList()
    {
        try
        {
            myCallList = await Http.GetFromJsonAsync<List<MyCallListItemDto>>("api/campaigns/my-list");
        }
        catch
        {
            myCallList = new();
        }
    }

    private void CallFromList(MyCallListItemDto item)
    {
        phoneNumber = item.PhoneNumber;
        activeCallListItemId = item.CampaignContactId;
    }

    private async Task MarkListItem(MyCallListItemDto item, int statusId)
    {
        try
        {
            // campaignUid lazim — campaign detayindan uid al
            // Basit endpoint: uid yerine campaign id kullanarak direkt guncelle
            var req = new UpdateCampaignContactStatusRequest { StatusId = statusId };
            // Kampanya uid'sini bilmiyoruz, dogrudan my-list'ten guncelleme yapacak endpoint kullaniyoruz
            var resp = await Http.PutAsJsonAsync($"api/campaigns/my-list/{item.CampaignContactId}", req);
            if (resp.IsSuccessStatusCode)
            {
                await LoadMyCallList();
                activeCallListItemId = null;
            }
        }
        catch { }
    }

    private void StopTimer()
    {
        callTimer?.Stop();
        callTimer?.Dispose();
        callTimer = null;
    }

    public async ValueTask DisposeAsync()
    {
        SipService.OnRegistered -= HandleSipRegistered;
        SipService.OnRegistrationFailed -= HandleSipRegistrationFailed;
        SipService.OnCallAnswered -= HandleCallAnswered;
        SipService.OnCallEnded -= HandleCallEnded;
        SipService.OnCallFailed -= HandleCallFailed;

        StopTimer();
    }
}
