@page "/customer/campaigns"
@attribute [Authorize(Roles = "CustomerUser")]
@inject HttpClient Http
@inject NavigationManager Nav
@inject PermissionService PermService
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-list-check me-2"></i>Arama Kampanyalari</h4>
    @if (IsFirmaAdmin || IsEkipLideri)
    {
        <button class="btn btn-primary btn-sm" @onclick="OpenCreateModal">
            <i class="bi bi-plus-lg me-1"></i>Yeni Kampanya
        </button>
    }
</div>

@if (campaigns == null)
{
    <div class="text-center py-5"><div class="spinner-border" role="status"></div></div>
}
else if (campaigns.Count == 0)
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-list-check" style="font-size:3rem;"></i>
        <p class="mt-2">Henuz kampanya olusturulmamis.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Kampanya</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th class="text-center">Toplam</th>
                    <th class="text-center">Ulasildi</th>
                    <th class="text-center">Ulasilamadi</th>
                    <th class="text-center">Bekliyor</th>
                    <th>Olusturan</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in campaigns)
                {
                    var status = CampaignStatuses.GetById(c.StatusId);
                    <tr>
                        <td>
                            <a href="campaigns/@c.Uid" class="text-decoration-none fw-medium">@c.Name</a>
                            @if (!string.IsNullOrEmpty(c.Description))
                            {
                                <div class="text-muted small">@c.Description</div>
                            }
                        </td>
                        <td class="small text-muted">@(c.ScheduledDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                        <td>
                            <span class="badge @(status?.CssClass ?? "bg-secondary")">
                                <i class="bi @(status?.Icon) me-1"></i>@(status?.Description ?? "")
                            </span>
                        </td>
                        <td class="text-center">@c.TotalContacts</td>
                        <td class="text-center text-success fw-medium">@c.ReachedCount</td>
                        <td class="text-center text-danger fw-medium">@c.NotReachedCount</td>
                        <td class="text-center text-muted">@c.PendingCount</td>
                        <td class="small text-muted">@c.CreatedByName</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a href="campaigns/@c.Uid" class="btn btn-outline-primary" title="Detay">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (IsFirmaAdmin || IsEkipLideri)
                                {
                                    <button class="btn btn-outline-danger" title="Sil" @onclick="() => DeleteCampaign(c)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ─── Yeni Kampanya Modali ─── *@
@if (showCreateModal)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Yeni Kampanya</h5>
                    <button class="btn-close" @onclick="CloseCreateModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Kampanya Adi *</label>
                        <input type="text" class="form-control" @bind="createName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Aciklama</label>
                        <textarea class="form-control" rows="2" @bind="createDescription"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Planlanan Tarih</label>
                        <input type="date" class="form-control" @bind="createDate" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseCreateModal">Iptal</button>
                    <button class="btn btn-primary btn-sm" @onclick="CreateCampaign" disabled="@(string.IsNullOrWhiteSpace(createName) || creating)">
                        @if (creating) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Olustur
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CampaignDto>? campaigns;
    private bool showCreateModal;
    private string createName = "";
    private string? createDescription;
    private DateTime? createDate;
    private bool creating;

    private bool IsFirmaAdmin => PermService.CustomerRoleId == CustomerRoles.Ids.FirmaAdmin;
    private bool IsEkipLideri => PermService.CustomerRoleId == CustomerRoles.Ids.EkipLideri;

    protected override async Task OnInitializedAsync()
    {
        await PermService.LoadAsync();
        await LoadCampaigns();
    }

    private async Task LoadCampaigns()
    {
        try
        {
            campaigns = await Http.GetFromJsonAsync<List<CampaignDto>>("api/campaigns");
        }
        catch
        {
            campaigns = new();
        }
    }

    private void OpenCreateModal()
    {
        createName = "";
        createDescription = null;
        createDate = DateTime.Today;
        showCreateModal = true;
    }

    private void CloseCreateModal() => showCreateModal = false;

    private async Task CreateCampaign()
    {
        if (string.IsNullOrWhiteSpace(createName)) return;
        creating = true;
        try
        {
            var req = new CreateCampaignRequest
            {
                Name = createName,
                Description = createDescription,
                ScheduledDate = createDate
            };
            var resp = await Http.PostAsJsonAsync("api/campaigns", req);
            if (resp.IsSuccessStatusCode)
            {
                var created = await resp.Content.ReadFromJsonAsync<CampaignDto>();
                if (created != null)
                    Nav.NavigateTo($"customer/campaigns/{created.Uid}");
            }
        }
        finally
        {
            creating = false;
            showCreateModal = false;
        }
    }

    private async Task DeleteCampaign(CampaignDto c)
    {
        var resp = await Http.DeleteAsync($"api/campaigns/{c.Uid}");
        if (resp.IsSuccessStatusCode)
            await LoadCampaigns();
    }
}
