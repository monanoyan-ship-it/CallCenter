            {
                Toast.ShowSuccess("Webhook silindi.");
                await LoadDetail();
            }
            else
            {
                Toast.ShowError("Silinemedi: " + await resp.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex) { Toast.ShowError(ex.Message); }
    }

    // ─── API KEY ───
    private void OpenApiKeyModal()
    {
        akName = "";
        akSelectedScopes.Clear();
        apiKeyError = null;
        showApiKeyModal = true;
    }

    private void ToggleScope(string scope, bool isChecked)
    {
        if (isChecked) akSelectedScopes.Add(scope);
        else akSelectedScopes.Remove(scope);
    }

    private async Task CreateApiKey()
    {
        if (string.IsNullOrWhiteSpace(akName) || akSelectedScopes.Count == 0)
        {
            apiKeyError = "Ad ve en az bir yetki secimi zorunludur.";
            return;
        }
        if (detail == null) return;

        isCreatingApiKey = true;
        apiKeyError = null;
        try
        {
            var dto = new CreateApiKeyRequest
            {
                Name = akName,
                IntegrationConnectionId = detail.Id,
                Scopes = akSelectedScopes.ToList()
            };
            var resp = await Http.PostAsJsonAsync("api/integrations/api-keys", dto);
            if (resp.IsSuccessStatusCode)
            {
                newApiKeyResult = await resp.Content.ReadFromJsonAsync<CreateApiKeyResponse>();
                Toast.ShowSuccess("API anahtari olusturuldu. Simdi kopyalayin!");
                showApiKeyModal = false;
                await LoadDetail();
            }
            else
            {
                apiKeyError = await resp.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex) { apiKeyError = ex.Message; }
        finally { isCreatingApiKey = false; }
    }

    private async Task RevokeApiKey(Guid uid)
    {
        try
        {
            var resp = await Http.DeleteAsync($"api/integrations/api-keys/{uid}");
            if (resp.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("API anahtari iptal edildi.");
                await LoadDetail();
            }
            else
            {
                Toast.ShowError("Iptal edilemedi: " + await resp.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex) { Toast.ShowError(ex.Message); }
    }

