@page "/customer/quality/checklists"
@attribute [Authorize(Roles = "CustomerUser")]
@inject HttpClient Http
@inject ToastService Toast
@inject NavigationManager Nav
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums

<PageTitle>Kalite Formlari - CorpLynk</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-clipboard-check me-2 text-primary"></i>Kalite Formlari
    </h4>
    <button class="btn btn-primary btn-sm" @onclick="OpenCreateModal">
        <i class="bi bi-plus-lg me-1"></i>Yeni Form
    </button>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="text-muted mt-2">Formlar yukleniyor...</p>
    </div>
}
else if (checklists == null || checklists.Count == 0)
{
    <div class="text-center py-5">
        <i class="bi bi-clipboard-x fs-1 d-block mb-2 text-muted opacity-25"></i>
        <p class="text-muted">Henuz kalite formu olusturulmamis.</p>
        <button class="btn btn-primary btn-sm" @onclick="OpenCreateModal">
            <i class="bi bi-plus-lg me-1"></i>Ilk Formu Olustur
        </button>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var cl in checklists)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 @(!cl.IsActive ? "opacity-50" : "")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="mb-0 fw-semibold">@cl.Name</h6>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><button class="dropdown-item" @onclick="() => OpenEditModal(cl)"><i class="bi bi-pencil me-2"></i>Duzenle</button></li>
                                    <li><button class="dropdown-item" @onclick="() => OpenDetail(cl.Uid)"><i class="bi bi-list-check me-2"></i>Sorulari Yonet</button></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><button class="dropdown-item text-danger" @onclick="() => ConfirmDelete(cl)"><i class="bi bi-trash me-2"></i>Sil</button></li>
                                </ul>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(cl.Description))
                        {
                            <p class="text-muted small mb-2">@cl.Description</p>
                        }
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            <span class="badge bg-primary bg-opacity-10 text-primary">@cl.ScoringMethodName</span>
                            @if (!cl.IsActive)
                            {
                                <span class="badge bg-secondary">Pasif</span>
                            }
                            @if (!string.IsNullOrEmpty(cl.Code))
                            {
                                <span class="badge bg-info bg-opacity-10 text-info">@cl.Code</span>
                            }
                            <span class="badge bg-light text-dark">v@cl.Version</span>
                        </div>
                        <div class="d-flex justify-content-between text-muted small">
                            <span><i class="bi bi-question-circle me-1"></i>@cl.QuestionCount soru</span>
                            <span><i class="bi bi-star me-1"></i>@cl.MaxTotalPoints puan</span>
                            <span><i class="bi bi-file-earmark-check me-1"></i>@cl.EvaluationCount degerlendirme</span>
                        </div>
                        @if (cl.ValidFrom.HasValue || cl.ValidUntil.HasValue)
                        {
                            <div class="text-muted small mt-1">
                                <i class="bi bi-calendar-range me-1"></i>
                                @(cl.ValidFrom?.ToString("dd.MM.yyyy") ?? "...") - @(cl.ValidUntil?.ToString("dd.MM.yyyy") ?? "...")
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@* ─── CREATE/EDIT MODAL ─── *@
@if (showFormModal)
{
    <div class="modal-backdrop-custom" @onclick="CloseFormModal"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditing ? "Form Duzenle" : "Yeni Kalite Formu")</h5>
                    <button type="button" class="btn-close" @onclick="CloseFormModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(formError))
                    {
                        <div class="alert alert-danger py-2 small">@formError</div>
                    }
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label small">Form Adi *</label>
                            <input type="text" class="form-control form-control-sm" @bind="formName" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Kod</label>
                            <input type="text" class="form-control form-control-sm" @bind="formCode" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Aciklama</label>
                            <textarea class="form-control form-control-sm" rows="2" @bind="formDescription"></textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Puanlama Yontemi</label>
                            <select class="form-select form-select-sm" @bind="formScoringMethodId">
                                @foreach (var m in QualityScoringMethods.All)
                                {
                                    <option value="@m.Id">@m.Description</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Maks. Puan</label>
                            <input type="number" class="form-control form-control-sm" @bind="formMaxPoints" />
                        </div>
                        <div class="col-md-4">
                            <div class="form-check mt-4">
                                <input type="checkbox" class="form-check-input" id="chkScored" @bind="formIsScored" />
                                <label class="form-check-label small" for="chkScored">Puanli</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Gecerlilik Baslangic</label>
                            <input type="date" class="form-control form-control-sm" @bind="formValidFrom" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Gecerlilik Bitis</label>
                            <input type="date" class="form-control form-control-sm" @bind="formValidUntil" />
                        </div>
                        <div class="col-md-4">
                            <div class="form-check mt-4">
                                <input type="checkbox" class="form-check-input" id="chkHideGroups" @bind="formHideGroupNames" />
                                <label class="form-check-label small" for="chkHideGroups">Grup adlarini gizle</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseFormModal">Iptal</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveChecklist" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        @(isEditing ? "Guncelle" : "Olustur")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ─── QUESTION MANAGEMENT MODAL ─── *@
@if (showDetailModal && selectedDetail != null)
{
    <div class="modal-backdrop-custom" @onclick="CloseDetail"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-list-check me-2"></i>@selectedDetail.Name — Sorular
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseDetail"></button>
                </div>
                <div class="modal-body">
                    @* ─── ADD QUESTION FORM ─── *@
                    <div class="card mb-3">
                        <div class="card-header bg-light py-2">
                            <span class="small fw-semibold"><i class="bi bi-plus-circle me-1"></i>Yeni Soru Ekle</span>
                        </div>
                        <div class="card-body py-2">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label small mb-0">Soru Metni *</label>
                                    <input type="text" class="form-control form-control-sm" @bind="newQuestionText" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small mb-0">Grup</label>
                                    <input type="text" class="form-control form-control-sm" @bind="newQuestionGroup" />
                                </div>
                                <div class="col-md-1">
                                    <label class="form-label small mb-0">Agirlik</label>
                                    <input type="number" class="form-control form-control-sm" @bind="newQuestionWeight" />
                                </div>
                                <div class="col-md-1">
                                    <label class="form-label small mb-0">Maks.</label>
                                    <input type="number" class="form-control form-control-sm" @bind="newQuestionMaxPoints" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small mb-0">Tip</label>
                                    <select class="form-select form-select-sm" @bind="newQuestionScoringType">
                                        @foreach (var st in QualityScoringTypes.All)
                                        {
                                            <option value="@st.Id">@st.Description</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <button class="btn btn-success btn-sm w-100" @onclick="AddQuestion" disabled="@isAddingQuestion">
                                        @if (isAddingQuestion)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                        }
                                        <i class="bi bi-plus-lg me-1"></i>Ekle
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* ─── QUESTION LIST ─── *@
                    @if (selectedDetail.Questions.Count == 0)
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-question-circle fs-1 d-block mb-2 opacity-25"></i>
                            <span>Henuz soru eklenmemis.</span>
                        </div>
                    }
                    else
                    {
                        var groups = selectedDetail.Questions.OrderBy(q => q.Order).GroupBy(q => q.GroupName ?? "");
                        @foreach (var group in groups)
                        {
                            if (!string.IsNullOrEmpty(group.Key))
                            {
                                <h6 class="text-muted mt-3 mb-2"><i class="bi bi-folder me-1"></i>@group.Key</h6>
                            }
                            <div class="list-group mb-2">
                                @foreach (var q in group)
                                {
                                    <div class="list-group-item list-group-item-action py-2">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="flex-grow-1">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge bg-light text-dark border" style="min-width:28px;">@q.Order</span>
                                                    <span class="fw-medium small">@q.Text</span>
                                                    @if (!q.IsActive)
                                                    {
                                                        <span class="badge bg-secondary">Pasif</span>
                                                    }
                                                </div>
                                                <div class="d-flex gap-2 mt-1 text-muted" style="font-size:0.75rem;">
                                                    <span><i class="bi bi-star me-1"></i>@q.WeightPoints agirlik</span>
                                                    <span><i class="bi bi-bullseye me-1"></i>@q.MaxPoints maks.</span>
                                                    <span>@q.ScoringTypeName</span>
                                                    @if (q.PenaltyTypeId > 0)
                                                    {
                                                        var pt = QualityPenaltyTypes.GetById(q.PenaltyTypeId);
                                                        <span class="@(pt?.CssClass ?? "")">@(pt?.Description ?? "")</span>
                                                    }
                                                    @if (q.SubCriteria.Count > 0)
                                                    {
                                                        <span><i class="bi bi-list-nested me-1"></i>@q.SubCriteria.Count alt kriter</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-secondary" title="Duzenle" @onclick="() => OpenEditQuestion(q)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-outline-danger" title="Sil" @onclick="() => DeleteQuestion(q.Id)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseDetail">Kapat</button>
                </div>
            </div>
        </div>
    </div>
}

@* ─── EDIT QUESTION MODAL ─── *@
@if (showEditQuestionModal && editingQuestion != null)
{
    <div class="modal-backdrop-custom" style="z-index:1060;" @onclick="CloseEditQuestion"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index:1070;">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Soru Duzenle</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditQuestion"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label small">Soru Metni *</label>
                            <input type="text" class="form-control form-control-sm" @bind="editQText" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">Grup</label>
                            <input type="text" class="form-control form-control-sm" @bind="editQGroup" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Agirlik</label>
                            <input type="number" class="form-control form-control-sm" @bind="editQWeight" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Maks. Puan</label>
                            <input type="number" class="form-control form-control-sm" @bind="editQMaxPoints" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">Puanlama Tipi</label>
                            <select class="form-select form-select-sm" @bind="editQScoringType">
                                @foreach (var st in QualityScoringTypes.All)
                                {
                                    <option value="@st.Id">@st.Description</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">Ceza Tipi</label>
                            <select class="form-select form-select-sm" @bind="editQPenaltyType">
                                @foreach (var pt in QualityPenaltyTypes.All)
                                {
                                    <option value="@pt.Id">@pt.Description</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Yardim Metni</label>
                            <textarea class="form-control form-control-sm" rows="2" @bind="editQHelpText"></textarea>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="chkReq" @bind="editQRequired" />
                                <label class="form-check-label small" for="chkReq">Zorunlu</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="chkScore" @bind="editQShowScore" />
                                <label class="form-check-label small" for="chkScore">Puan girisi</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="chkComment" @bind="editQAllowComment" />
                                <label class="form-check-label small" for="chkComment">Yorum</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="chkActive" @bind="editQActive" />
                                <label class="form-check-label small" for="chkActive">Aktif</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseEditQuestion">Iptal</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveEditQuestion" disabled="@isSavingQuestion">
                        @if (isSavingQuestion)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ─── DELETE CONFIRM MODAL ─── *@
@if (showDeleteConfirm)
{
    <div class="modal-backdrop-custom" @onclick="() => showDeleteConfirm = false"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white py-2">
                    <h6 class="modal-title">Formu Sil</h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showDeleteConfirm = false"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0 small"><strong>@deleteTarget?.Name</strong> formu silinecek. Bu islem geri alinamaz.</p>
                </div>
                <div class="modal-footer py-1">
                    <button class="btn btn-secondary btn-sm" @onclick="() => showDeleteConfirm = false">Iptal</button>
                    <button class="btn btn-danger btn-sm" @onclick="ExecuteDelete">Sil</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .modal-backdrop-custom {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1040;
    }
</style>

@code {
    private List<QualityChecklistDto>? checklists;
    private bool isLoading = true;

    // Form Modal
    private bool showFormModal;
    private bool isEditing;
    private bool isSaving;
    private Guid? editingUid;
    private string formName = "";
    private string? formDescription;
    private string? formCode;
    private int formScoringMethodId = QualityScoringMethods.Ids.Maximum;
    private decimal formMaxPoints = 100;
    private bool formIsScored = true;
    private DateTime? formValidFrom;
    private DateTime? formValidUntil;
    private bool formHideGroupNames;
    private string? formError;

    // Detail/Questions Modal
    private bool showDetailModal;
    private QualityChecklistDetailDto? selectedDetail;
    private bool isAddingQuestion;
    private string newQuestionText = "";
    private string? newQuestionGroup;
    private decimal newQuestionWeight = 10;
    private int newQuestionMaxPoints = 5;
    private int newQuestionScoringType = QualityScoringTypes.Ids.Scored;

    // Edit Question Modal
    private bool showEditQuestionModal;
    private QualityQuestionDto? editingQuestion;
    private bool isSavingQuestion;
    private string editQText = "";
    private string? editQGroup;
    private decimal editQWeight;
    private int editQMaxPoints;
    private int editQScoringType;
    private int editQPenaltyType;
    private string? editQHelpText;
    private bool editQRequired;
    private bool editQShowScore;
    private bool editQAllowComment;
    private bool editQActive;

    // Delete Confirm
    private bool showDeleteConfirm;
    private QualityChecklistDto? deleteTarget;

    protected override async Task OnInitializedAsync()
    {
        await LoadChecklists();
    }

    private async Task LoadChecklists()
    {
        isLoading = true;
        try
        {
            checklists = await Http.GetFromJsonAsync<List<QualityChecklistDto>>("api/quality/checklists");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Formlar yuklenemedi: {ex.Message}");
        }
        finally { isLoading = false; }
    }

    // ─── CREATE/EDIT CHECKLIST ───
    private void OpenCreateModal()
    {
        isEditing = false;
        editingUid = null;
        formName = "";
        formDescription = null;
        formCode = null;
        formScoringMethodId = QualityScoringMethods.Ids.Maximum;
        formMaxPoints = 100;
        formIsScored = true;
        formValidFrom = null;
        formValidUntil = null;
        formHideGroupNames = false;
        formError = null;
        showFormModal = true;
    }

    private void OpenEditModal(QualityChecklistDto cl)
    {
        isEditing = true;
        editingUid = cl.Uid;
        formName = cl.Name;
        formDescription = cl.Description;
        formCode = cl.Code;
        formScoringMethodId = cl.ScoringMethodId;
        formMaxPoints = cl.MaxTotalPoints;
        formIsScored = cl.IsScored;
        formValidFrom = cl.ValidFrom;
        formValidUntil = cl.ValidUntil;
        formError = null;
        showFormModal = true;
    }

    private void CloseFormModal() => showFormModal = false;

    private async Task SaveChecklist()
    {
        if (string.IsNullOrWhiteSpace(formName))
        {
            formError = "Form adi zorunludur.";
            return;
        }

        isSaving = true;
        formError = null;

        try
        {
            if (isEditing && editingUid.HasValue)
            {
                var req = new UpdateChecklistRequest
                {
                    Name = formName,
                    Description = formDescription,
                    Code = formCode,
                    ScoringMethodId = formScoringMethodId,
                    MaxTotalPoints = formMaxPoints,
                    IsScored = formIsScored,
                    ValidFrom = formValidFrom,
                    ValidUntil = formValidUntil,
                    HideGroupNames = formHideGroupNames
                };
                var resp = await Http.PutAsJsonAsync($"api/quality/checklists/{editingUid}", req);
                if (resp.IsSuccessStatusCode)
                {
                    Toast.ShowSuccess("Form guncellendi.");
                    showFormModal = false;
                    await LoadChecklists();
                }
                else
                {
                    formError = await resp.Content.ReadAsStringAsync();
                }
            }
            else
            {
                var req = new CreateChecklistRequest
                {
                    Name = formName,
                    Description = formDescription,
                    Code = formCode,
                    ScoringMethodId = formScoringMethodId,
                    MaxTotalPoints = formMaxPoints,
                    IsScored = formIsScored,
                    ValidFrom = formValidFrom,
                    ValidUntil = formValidUntil,
                    HideGroupNames = formHideGroupNames
                };
                var resp = await Http.PostAsJsonAsync("api/quality/checklists", req);
                if (resp.IsSuccessStatusCode)
                {
                    Toast.ShowSuccess("Yeni form olusturuldu.");
                    showFormModal = false;
                    await LoadChecklists();
                }
                else
                {
                    formError = await resp.Content.ReadAsStringAsync();
                }
            }
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
        finally { isSaving = false; }
    }

    // ─── DELETE ───
    private void ConfirmDelete(QualityChecklistDto cl)
    {
        deleteTarget = cl;
        showDeleteConfirm = true;
    }

    private async Task ExecuteDelete()
    {
        if (deleteTarget == null) return;
        showDeleteConfirm = false;
        try
        {
            var resp = await Http.DeleteAsync($"api/quality/checklists/{deleteTarget.Uid}");
            if (resp.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Form silindi.");
                await LoadChecklists();
            }
            else
            {
                Toast.ShowError("Silinemedi: " + await resp.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }

    // ─── DETAIL / QUESTIONS ───
    private async Task OpenDetail(Guid uid)
    {
        try
        {
            selectedDetail = await Http.GetFromJsonAsync<QualityChecklistDetailDto>($"api/quality/checklists/{uid}");
            if (selectedDetail != null)
            {
                showDetailModal = true;
                ResetNewQuestionForm();
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Detay yuklenemedi: {ex.Message}");
        }
    }

    private void CloseDetail()
    {
        showDetailModal = false;
        selectedDetail = null;
    }

    private void ResetNewQuestionForm()
    {
        newQuestionText = "";
        newQuestionGroup = null;
        newQuestionWeight = 10;
        newQuestionMaxPoints = 5;
        newQuestionScoringType = QualityScoringTypes.Ids.Scored;
    }

    private async Task AddQuestion()
    {
        if (selectedDetail == null || string.IsNullOrWhiteSpace(newQuestionText)) return;
        isAddingQuestion = true;
        try
        {
            var req = new CreateQuestionRequest
            {
                Text = newQuestionText,
                GroupName = newQuestionGroup,
                WeightPoints = newQuestionWeight,
                MaxPoints = newQuestionMaxPoints,
                ScoringTypeId = newQuestionScoringType
            };
            var resp = await Http.PostAsJsonAsync($"api/quality/checklists/{selectedDetail.Uid}/questions", req);
            if (resp.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Soru eklendi.");
                await RefreshDetail();
                ResetNewQuestionForm();
            }
            else
            {
                Toast.ShowError("Soru eklenemedi: " + await resp.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex) { Toast.ShowError(ex.Message); }
        finally { isAddingQuestion = false; }
    }

    private async Task DeleteQuestion(int questionId)
    {
        try
        {
            var resp = await Http.DeleteAsync($"api/quality/questions/{questionId}");
            if (resp.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Soru silindi.");
                await RefreshDetail();
            }
            else
            {
                Toast.ShowError("Silinemedi: " + await resp.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex) { Toast.ShowError(ex.Message); }
    }

    private async Task RefreshDetail()
    {
        if (selectedDetail == null) return;
        try
        {
            selectedDetail = await Http.GetFromJsonAsync<QualityChecklistDetailDto>($"api/quality/checklists/{selectedDetail.Uid}");
        }
        catch { }
    }

    // ─── EDIT QUESTION ───
    private void OpenEditQuestion(QualityQuestionDto q)
    {
        editingQuestion = q;
        editQText = q.Text;
        editQGroup = q.GroupName;
        editQWeight = q.WeightPoints;
        editQMaxPoints = q.MaxPoints;
        editQScoringType = q.ScoringTypeId;
        editQPenaltyType = q.PenaltyTypeId;
        editQHelpText = q.HelpText;
        editQRequired = q.IsRequired;
        editQShowScore = q.ShowScoreInput;
        editQAllowComment = q.AllowComment;
        editQActive = q.IsActive;
        showEditQuestionModal = true;
    }

    private void CloseEditQuestion()
    {
        showEditQuestionModal = false;
        editingQuestion = null;
    }

    private async Task SaveEditQuestion()
    {
        if (editingQuestion == null || string.IsNullOrWhiteSpace(editQText)) return;
        isSavingQuestion = true;
        try
        {
            var req = new UpdateQuestionRequest
            {
                Text = editQText,
                GroupName = editQGroup,
                WeightPoints = editQWeight,
                MaxPoints = editQMaxPoints,
                ScoringTypeId = editQScoringType,
                PenaltyTypeId = editQPenaltyType,
                HelpText = editQHelpText,
                IsRequired = editQRequired,
                ShowScoreInput = editQShowScore,
                AllowComment = editQAllowComment,
                IsActive = editQActive
            };
            var resp = await Http.PutAsJsonAsync($"api/quality/questions/{editingQuestion.Id}", req);
            if (resp.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Soru guncellendi.");
                showEditQuestionModal = false;
                await RefreshDetail();
            }
            else
            {
                Toast.ShowError("Guncellenemedi: " + await resp.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex) { Toast.ShowError(ex.Message); }
        finally { isSavingQuestion = false; }
    }
}
