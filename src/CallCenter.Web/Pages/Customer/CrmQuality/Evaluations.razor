@page "/customer/quality/evaluations"
@attribute [Authorize(Roles = "CustomerUser")]
@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums

<PageTitle>Degerlendirmeler - CorpLynk</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-journal-check me-2 text-primary"></i>Degerlendirmeler
    </h4>
    <button class="btn btn-primary btn-sm" @onclick="OpenCreateModal">
        <i class="bi bi-plus-lg me-1"></i>Yeni Degerlendirme
    </button>
</div>

@* ─── FILTER ─── *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small mb-0">Durum</label>
                <select class="form-select form-select-sm" @bind="filterStatusId" @bind:after="LoadEvaluations">
                    <option value="0">Tumu</option>
                    @foreach (var s in CrmQualityEvaluationStatuses.All)
                    {
                        <option value="@s.Id">@s.Description</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-0">Arama</label>
                <input type="text" class="form-control form-control-sm" placeholder="Temsilci, form..." @bind="searchTerm" @bind:event="oninput" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="LoadEvaluations" title="Yenile">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="text-muted mt-2">Degerlendirmeler yukleniyor...</p>
    </div>
}
else if (filteredEvaluations.Count == 0)
{
    <div class="text-center py-5">
        <i class="bi bi-journal-x fs-1 d-block mb-2 text-muted opacity-25"></i>
        <p class="text-muted">Degerlendirme bulunamadi.</p>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:50px;"></th>
                        <th>Form</th>
                        <th>Degerlendiren</th>
                        <th>Degerlendirilen</th>
                        <th class="text-center">Puan</th>
                        <th class="text-center">Kartlar</th>
                        <th>Durum</th>
                        <th>Tarih</th>
                        <th style="width:80px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in filteredEvaluations)
                    {
                        var status = CrmQualityEvaluationStatuses.GetById(ev.StatusId);
                        <tr>
                            <td class="text-center">
                                <i class="bi @(status?.Icon ?? "bi-circle") @(status?.CssClass ?? "")"></i>
                            </td>
                            <td class="small fw-medium">@ev.ChecklistName</td>
                            <td class="small text-muted">@ev.EvaluatorName</td>
                            <td class="small text-muted">@(ev.EvaluatedName ?? "-")</td>
                            <td class="text-center">
                                @if (ev.ScorePercentage.HasValue)
                                {
                                    var pct = ev.ScorePercentage.Value;
                                    var color = pct >= 80 ? "text-success" : pct >= 60 ? "text-warning" : "text-danger";
                                    <span class="fw-bold @color">%@pct.ToString("F0")</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (ev.YellowCardCount > 0)
                                {
                                    <span class="badge bg-warning text-dark me-1" title="Sari Kart">@ev.YellowCardCount</span>
                                }
                                @if (ev.RedCardCount > 0)
                                {
                                    <span class="badge bg-danger" title="Kirmizi Kart">@ev.RedCardCount</span>
                                }
                                @if (ev.YellowCardCount == 0 && ev.RedCardCount == 0)
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(status?.CssClass ?? "bg-secondary") rounded-pill">
                                    @(status?.Description ?? ev.StatusName)
                                </span>
                            </td>
                            <td class="small text-muted">@ev.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    @if (ev.StatusId == CrmQualityEvaluationStatuses.Ids.Draft)
                                    {
                                        <button class="btn btn-outline-primary" title="Degerlendirmeyi Doldur" @onclick="() => OpenEvaluationForm(ev)">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-secondary" title="Detay" @onclick="() => OpenEvaluationDetail(ev)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    }
                                    @if (ev.StatusId != CrmQualityEvaluationStatuses.Ids.Completed && ev.StatusId != CrmQualityEvaluationStatuses.Ids.Cancelled)
                                    {
                                        <button class="btn btn-outline-danger" title="Iptal Et" @onclick="() => CancelEvaluation(ev)">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* ─── CREATE EVALUATION MODAL ─── *@
@if (showCreateModal)
{
    <div class="modal-backdrop-custom" @onclick="() => showCreateModal = false"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Yeni Degerlendirme</h5>
                    <button type="button" class="btn-close" @onclick="() => showCreateModal = false"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(createError))
                    {
                        <div class="alert alert-danger py-2 small">@createError</div>
                    }
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small">Kalite Formu *</label>
                            <select class="form-select form-select-sm" @bind="createChecklistId">
                                <option value="0">Secin...</option>
                                @if (availableChecklists != null)
                                {
                                    @foreach (var cl in availableChecklists.Where(c => c.IsActive))
                                    {
                                        <option value="@cl.Id">@cl.Name (@cl.ScoringMethodName)</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Arama Kaydi ID *</label>
                            <input type="number" class="form-control form-control-sm" @bind="createCallRecordId" placeholder="Arama kaydi ID" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Degerlendirilen Temsilci ID</label>
                            <input type="number" class="form-control form-control-sm" @bind="createEvaluatedPersonnelId" placeholder="Opsiyonel" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => showCreateModal = false">Iptal</button>
                    <button class="btn btn-primary btn-sm" @onclick="CreateEvaluation" disabled="@isCreating">
                        @if (isCreating)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Olustur (Taslak)
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ─── EVALUATION FORM MODAL (Draft Fill / Submit) ─── *@
@if (showEvalForm && evalDetail != null && evalChecklist != null)
{
    <div class="modal-backdrop-custom" @onclick="CloseEvalForm"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-pencil-fill me-2"></i>@evalChecklist.Name
                        <span class="badge bg-info ms-2">Taslak</span>
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseEvalForm"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3 small text-muted">
                        <span class="me-3"><i class="bi bi-person me-1"></i>Degerlendiren: @evalDetail.EvaluatorName</span>
                        @if (!string.IsNullOrEmpty(evalDetail.EvaluatedName))
                        {
                            <span class="me-3"><i class="bi bi-person-check me-1"></i>Degerlendirilen: @evalDetail.EvaluatedName</span>
                        }
                        <span><i class="bi bi-telephone me-1"></i>Arama: @(evalDetail.CallRecordNumber ?? evalDetail.CallRecordId.ToString())</span>
                    </div>

                    @{
                        var questionGroups = evalChecklist.Questions.Where(q => q.IsActive).OrderBy(q => q.Order).GroupBy(q => q.GroupName ?? "");
                    }
                    @foreach (var group in questionGroups)
                    {
                        if (!string.IsNullOrEmpty(group.Key))
                        {
                            <h6 class="text-primary mt-3 mb-2 border-bottom pb-1"><i class="bi bi-folder me-1"></i>@group.Key</h6>
                        }
                        @foreach (var question in group)
                        {
                            var answer = GetOrCreateAnswer(question.Id);
                            <div class="card mb-2 @(answer.IsNotApplicable ? "opacity-50" : "")">
                                <div class="card-body py-2">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <div>
                                            <span class="badge bg-light text-dark border me-1">@question.Order</span>
                                            <span class="fw-medium small">@question.Text</span>
                                            @if (question.IsRequired)
                                            {
                                                <span class="text-danger">*</span>
                                            }
                                        </div>
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" @bind="answer.IsNotApplicable" />
                                            <label class="form-check-label small text-muted">N/A</label>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(question.HelpText))
                                    {
                                        <div class="text-muted small mb-1"><i class="bi bi-info-circle me-1"></i>@question.HelpText</div>
                                    }
                                    @if (!answer.IsNotApplicable)
                                    {
                                        <div class="row g-2">
                                            @if (question.ShowScoreInput && question.ScoringTypeId == CrmQualityScoringTypes.Ids.Scored)
                                            {
                                                <div class="col-md-3">
                                                    <label class="form-label small mb-0">Puan (0-@question.MaxPoints)</label>
                                                    <input type="number" class="form-control form-control-sm"
                                                           min="0" max="@question.MaxPoints"
                                                           @bind="answer.GivenPoints" />
                                                </div>
                                            }
                                            @if (question.ScoringTypeId == CrmQualityScoringTypes.Ids.Penalty)
                                            {
                                                <div class="col-md-3">
                                                    <label class="form-label small mb-0">Ceza Tipi</label>
                                                    <select class="form-select form-select-sm" @bind="answer.AppliedPenaltyTypeId">
                                                        @foreach (var pt in CrmQualityPenaltyTypes.All)
                                                        {
                                                            <option value="@pt.Id">@pt.Description</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-2">
                                                    <div class="form-check mt-4">
                                                        <input type="checkbox" class="form-check-input" @bind="answer.IsPenaltyApplied" />
                                                        <label class="form-check-label small">Uygula</label>
                                                    </div>
                                                </div>
                                            }
                                            @if (question.SubCriteria.Count > 0)
                                            {
                                                <div class="col-12">
                                                    <label class="form-label small mb-0">Alt Kriterler</label>
                                                    <div class="d-flex flex-wrap gap-2">
                                                        @foreach (var sc in question.SubCriteria.Where(s => s.IsActive))
                                                        {
                                                            var isSelected = answer.SelectedSubCriteriaIds?.Contains(sc.Id) ?? false;
                                                            <div class="form-check">
                                                                <input type="checkbox" class="form-check-input"
                                                                       checked="@isSelected"
                                                                       @onchange="e => ToggleSubCriteria(answer, sc.Id, (bool)(e.Value ?? false))" />
                                                                <label class="form-check-label small">@sc.Description (@sc.WeightPoints puan)</label>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            @if (question.AllowComment)
                                            {
                                                <div class="col-md-6">
                                                    <label class="form-label small mb-0">Yorum</label>
                                                    <input type="text" class="form-control form-control-sm" @bind="answer.Notes" />
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }

                    <div class="mt-3">
                        <label class="form-label small">Genel Degerlendirme Yorumu</label>
                        <textarea class="form-control form-control-sm" rows="2" @bind="evalComment"></textarea>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-between">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseEvalForm">Kapat</button>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-primary btn-sm" @onclick="SaveDraft" disabled="@isSavingEval">
                            @if (isSavingEval)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-save me-1"></i>Taslak Kaydet
                        </button>
                        <button class="btn btn-success btn-sm" @onclick="SubmitEvaluation" disabled="@isSavingEval">
                            @if (isSavingEval)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-check-circle me-1"></i>Tamamla
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* ─── EVALUATION DETAIL MODAL (Read-only) ─── *@
@if (showDetailModal && evalDetail != null)
{
    <div class="modal-backdrop-custom" @onclick="CloseDetailModal"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-eye me-2"></i>Degerlendirme Detayi
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseDetailModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small text-muted mb-0">Form</label>
                            <div class="fw-medium">@evalDetail.ChecklistName</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted mb-0">Degerlendiren</label>
                            <div>@evalDetail.EvaluatorName</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted mb-0">Degerlendirilen</label>
                            <div>@(evalDetail.EvaluatedName ?? "-")</div>
                        </div>
                    </div>

                    @if (evalDetail.ScorePercentage.HasValue)
                    {
                        var pct = evalDetail.ScorePercentage.Value;
                        var color = pct >= 80 ? "success" : pct >= 60 ? "warning" : "danger";
                        <div class="card border-@color mb-3">
                            <div class="card-body py-2 text-center">
                                <div class="fs-2 fw-bold text-@color">%@pct.ToString("F1")</div>
                                <div class="text-muted small">@evalDetail.TotalScore / @evalDetail.MaxScore puan</div>
                                <div class="d-flex justify-content-center gap-3 mt-1">
                                    @if (evalDetail.YellowCardCount > 0)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-card-heading me-1"></i>@evalDetail.YellowCardCount Sari Kart</span>
                                    }
                                    @if (evalDetail.RedCardCount > 0)
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-card-heading me-1"></i>@evalDetail.RedCardCount Kirmizi Kart</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(evalDetail.EvaluationComment))
                    {
                        <div class="alert alert-info py-2 small"><i class="bi bi-chat-text me-1"></i>@evalDetail.EvaluationComment</div>
                    }

                    @* ─── ANSWERS ─── *@
                    @{
                        var answerGroups = evalDetail.Answers.GroupBy(a => a.GroupName ?? "");
                    }
                    @foreach (var group in answerGroups)
                    {
                        if (!string.IsNullOrEmpty(group.Key))
                        {
                            <h6 class="text-primary mt-3 mb-2 border-bottom pb-1">@group.Key</h6>
                        }
                        @foreach (var ans in group)
                        {
                            <div class="card mb-1">
                                <div class="card-body py-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="small">@ans.QuestionText</span>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (ans.IsNotApplicable)
                                            {
                                                <span class="badge bg-secondary">N/A</span>
                                            }
                                            else if (ans.EarnedPoints.HasValue)
                                            {
                                                <span class="fw-bold small">@ans.EarnedPoints.Value.ToString("F1") / @ans.WeightPoints</span>
                                            }
                                            @if (ans.IsPenaltyApplied && ans.AppliedPenaltyTypeId > 0)
                                            {
                                                var pt = CrmQualityPenaltyTypes.GetById(ans.AppliedPenaltyTypeId);
                                                <span class="badge @(pt?.CssClass ?? "bg-secondary")">@(pt?.Description ?? "")</span>
                                            }
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(ans.Notes))
                                    {
                                        <div class="text-muted small mt-1"><i class="bi bi-chat me-1"></i>@ans.Notes</div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseDetailModal">Kapat</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .modal-backdrop-custom {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1040;
    }
</style>

@code {
    private List<CrmQualityEvaluationDto>? evaluations;
    private bool isLoading = true;
    private int filterStatusId;
    private string searchTerm = "";

    // Create modal
    private bool showCreateModal;
    private bool isCreating;
    private int createChecklistId;
    private int createCallRecordId;
    private int? createEvaluatedPersonnelId;
    private string? createError;
    private List<CrmQualityChecklistDto>? availableChecklists;

    // Evaluation Form (Draft)
    private bool showEvalForm;
    private CrmQualityEvaluationDetailDto? evalDetail;
    private CrmQualityChecklistDetailDto? evalChecklist;
    private Dictionary<int, SubmitAnswerRequest> answerMap = new();
    private string? evalComment;
    private bool isSavingEval;

    // Detail modal
    private bool showDetailModal;

    private List<CrmQualityEvaluationDto> filteredEvaluations =>
        (evaluations ?? new())
            .Where(e => string.IsNullOrEmpty(searchTerm)
                || (e.ChecklistName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
                || (e.EvaluatorName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
                || (e.EvaluatedName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
            .OrderByDescending(e => e.CreatedAt)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadEvaluations(), EnsureChecklistsLoaded());
    }

    private async Task LoadEvaluations()
    {
        isLoading = true;
        try
        {
            var url = "api/quality/evaluations";
            if (filterStatusId > 0)
                url += $"?statusId={filterStatusId}";
            evaluations = await Http.GetFromJsonAsync<List<CrmQualityEvaluationDto>>(url);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Degerlendirmeler yuklenemedi: {ex.Message}");
        }
        finally { isLoading = false; }
    }

    // ─── CREATE ───
    private async Task OpenCreateModal()
    {
        createChecklistId = 0;
        createCallRecordId = 0;
        createEvaluatedPersonnelId = null;
        createError = null;
        showCreateModal = true;

        try
        {
            availableChecklists = await Http.GetFromJsonAsync<List<CrmQualityChecklistDto>>("api/quality/checklists");
        }
        catch { }
    }

    private async Task CreateEvaluation()
    {
        if (createChecklistId == 0) { createError = "Kalite formu secin."; return; }
        if (createCallRecordId == 0) { createError = "Arama kaydi ID girin."; return; }

        isCreating = true;
        createError = null;
        try
        {
            var req = new CreateEvaluationRequest
            {
                ChecklistId = createChecklistId,
                CallRecordId = createCallRecordId,
                EvaluatedPersonnelId = createEvaluatedPersonnelId
            };
            var resp = await Http.PostAsJsonAsync("api/quality/evaluations", req);
            if (resp.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Degerlendirme taslagi olusturuldu.");
                showCreateModal = false;
                await LoadEvaluations();
            }
            else
            {
                createError = await resp.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex) { createError = ex.Message; }
        finally { isCreating = false; }
    }

    // ─── EVALUATION FORM ───
    private async Task OpenEvaluationForm(CrmQualityEvaluationDto ev)
    {
        try
        {
            await EnsureChecklistsLoaded();

            evalDetail = await Http.GetFromJsonAsync<CrmQualityEvaluationDetailDto>($"api/quality/evaluations/{ev.Uid}");
            if (evalDetail == null) { Toast.ShowError("Degerlendirme bulunamadi."); return; }

            evalChecklist = await Http.GetFromJsonAsync<CrmQualityChecklistDetailDto>($"api/quality/checklists/{FindChecklistUid(evalDetail.ChecklistId)}");
            if (evalChecklist == null) { Toast.ShowError("Form bulunamadi."); return; }

            // Pre-fill answers from existing draft
            answerMap.Clear();
            foreach (var existingAnswer in evalDetail.Answers)
            {
                answerMap[existingAnswer.QuestionId] = new SubmitAnswerRequest
                {
                    QuestionId = existingAnswer.QuestionId,
                    GivenPoints = existingAnswer.GivenPoints,
                    AnswerText = existingAnswer.AnswerText,
                    Notes = existingAnswer.Notes,
                    RecommendationNotes = existingAnswer.RecommendationNotes,
                    IsNotApplicable = existingAnswer.IsNotApplicable,
                    IsPenaltyApplied = existingAnswer.IsPenaltyApplied,
                    AppliedPenaltyTypeId = existingAnswer.AppliedPenaltyTypeId,
                    SelectedSubCriteriaIds = existingAnswer.SelectedSubCriteriaIds.ToList()
                };
            }

            evalComment = evalDetail.EvaluationComment;
            showEvalForm = true;
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Form yuklenemedi: {ex.Message}");
        }
    }

    private Guid FindChecklistUid(int checklistId)
    {
        var cl = availableChecklists?.FirstOrDefault(c => c.Id == checklistId)
              ?? checklists_cache?.FirstOrDefault(c => c.Id == checklistId);
        return cl?.Uid ?? Guid.Empty;
    }

    private List<CrmQualityChecklistDto>? checklists_cache;

    private async Task EnsureChecklistsLoaded()
    {
        if (availableChecklists == null)
        {
            try
            {
                availableChecklists = await Http.GetFromJsonAsync<List<CrmQualityChecklistDto>>("api/quality/checklists");
                checklists_cache = availableChecklists;
            }
            catch { }
        }
    }

    private SubmitAnswerRequest GetOrCreateAnswer(int questionId)
    {
        if (!answerMap.TryGetValue(questionId, out var answer))
        {
            answer = new SubmitAnswerRequest { QuestionId = questionId, SelectedSubCriteriaIds = new() };
            answerMap[questionId] = answer;
        }
        return answer;
    }

    private void ToggleSubCriteria(SubmitAnswerRequest answer, int subCriteriaId, bool isChecked)
    {
        answer.SelectedSubCriteriaIds ??= new();
        if (isChecked && !answer.SelectedSubCriteriaIds.Contains(subCriteriaId))
            answer.SelectedSubCriteriaIds.Add(subCriteriaId);
        else if (!isChecked)
            answer.SelectedSubCriteriaIds.Remove(subCriteriaId);
    }

    private SubmitEvaluationRequest BuildSubmitRequest()
    {
        return new SubmitEvaluationRequest
        {
            EvaluationComment = evalComment,
            Answers = answerMap.Values.ToList()
        };
    }

    private async Task SaveDraft()
    {
        if (evalDetail == null) return;
        isSavingEval = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"api/quality/evaluations/{evalDetail.Uid}/save-draft", BuildSubmitRequest());
            if (resp.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Taslak kaydedildi.");
            }
            else
            {
                Toast.ShowError("Kaydedilemedi: " + await resp.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex) { Toast.ShowError(ex.Message); }
        finally { isSavingEval = false; }
    }

    private async Task SubmitEvaluation()
    {
        if (evalDetail == null) return;
        isSavingEval = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"api/quality/evaluations/{evalDetail.Uid}/submit", BuildSubmitRequest());
            if (resp.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Degerlendirme tamamlandi.");
                showEvalForm = false;
                await LoadEvaluations();
            }
            else
            {
                Toast.ShowError("Gonderilemedi: " + await resp.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex) { Toast.ShowError(ex.Message); }
        finally { isSavingEval = false; }
    }

    private void CloseEvalForm()
    {
        showEvalForm = false;
        evalDetail = null;
        evalChecklist = null;
        answerMap.Clear();
    }

    // ─── DETAIL (Read-only) ───
    private async Task OpenEvaluationDetail(CrmQualityEvaluationDto ev)
    {
        try
        {
            evalDetail = await Http.GetFromJsonAsync<CrmQualityEvaluationDetailDto>($"api/quality/evaluations/{ev.Uid}");
            if (evalDetail != null) showDetailModal = true;
        }
        catch (Exception ex) { Toast.ShowError(ex.Message); }
    }

    private void CloseDetailModal()
    {
        showDetailModal = false;
        evalDetail = null;
    }

    // ─── CANCEL ───
    private async Task CancelEvaluation(CrmQualityEvaluationDto ev)
    {
        try
        {
            var resp = await Http.PostAsync($"api/quality/evaluations/{ev.Uid}/cancel", null);
            if (resp.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Degerlendirme iptal edildi.");
                await LoadEvaluations();
            }
            else
            {
                Toast.ShowError("Iptal edilemedi: " + await resp.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex) { Toast.ShowError(ex.Message); }
    }
}
