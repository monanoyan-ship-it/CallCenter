@page "/reports/agents"
@attribute [Authorize(Roles = "Admin,Supervisor,CustomerUser")]
@inject HttpClient Http
@inject ChartJsInterop ChartJs
@inject IJSRuntime JS
@inject PermissionService PermService
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums
@using CallCenter.Web.Services
@implements IAsyncDisposable

<PageTitle>Temsilci Performansi - CorpLynk</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-person-lines-fill me-2 text-primary"></i>Temsilci Performansi
    </h4>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-success btn-sm" @onclick="ExportCsv" disabled="@isExporting">
            <i class="bi bi-filetype-csv me-1"></i>CSV
        </button>
        <button class="btn btn-outline-primary btn-sm" @onclick="ExportExcel" disabled="@isExporting">
            <i class="bi bi-file-earmark-excel me-1"></i>Excel
        </button>
    </div>
</div>

@* --- FILTRELER --- *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            @if (!isCustomerUser)
            {
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Firma</label>
                    <SearchableSelect Items="customerItems" Value="@selectedCustomerIdStr"
                                      ValueChanged="OnCustomerSelected" Placeholder="Tumu" />
                </div>
            }
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Baslangic</label>
                <input type="date" class="form-control form-control-sm" @bind="fromDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Bitis</label>
                <input type="date" class="form-control form-control-sm" @bind="toDate" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary btn-sm w-100" @onclick="ApplyFilters">
                    <i class="bi bi-funnel me-1"></i>Filtrele
                </button>
            </div>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (report != null)
{
    @* --- OZET KARTLARI --- *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small">Toplam Temsilci</div>
                            <div class="fs-3 fw-bold text-primary">@report.TotalAgents</div>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-3 p-2">
                            <i class="bi bi-people-fill text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small">En Iyi Performans</div>
                            <div class="fs-5 fw-bold text-success text-truncate" style="max-width: 140px;" title="@(report.BestPerformerName ?? "-")">
                                @(report.BestPerformerName ?? "-")
                            </div>
                        </div>
                        <div class="bg-success bg-opacity-10 rounded-3 p-2">
                            <i class="bi bi-trophy-fill text-success fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small">En Dusuk Ort. Sure</div>
                            <div class="fs-3 fw-bold text-warning">@FormatDuration(report.LowestAvgAnswerSeconds)</div>
                        </div>
                        <div class="bg-warning bg-opacity-10 rounded-3 p-2">
                            <i class="bi bi-lightning-fill text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small">Genel Ort. Sure</div>
                            <div class="fs-3 fw-bold text-info">@FormatDuration(report.OverallAvgDurationSeconds)</div>
                        </div>
                        <div class="bg-info bg-opacity-10 rounded-3 p-2">
                            <i class="bi bi-clock-fill text-info fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- CEVAPLAMA ORANI GRAFIGI --- *@
    @if (report.Items.Items.Count > 0)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0">
                <h6 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Temsilci Cevaplama Oranlari</h6>
            </div>
            <div class="card-body">
                <canvas id="agentChart" style="height: 300px;"></canvas>
            </div>
        </div>
    }

    @* --- TABLO --- *@
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (report.Items.Items.Count == 0)
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-person-x fs-1 d-block mb-2 opacity-25"></i>
                    <span>Temsilci bulunamadi</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Temsilci</th>
                                <th>Dahili</th>
                                <th class="text-center">Toplam</th>
                                <th class="text-center">Cevaplanan</th>
                                <th class="text-center">Cevapsiz</th>
                                <th class="text-center">Ort. Sure</th>
                                <th class="text-center">Cevaplama Orani</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var agent in report.Items.Items)
                            {
                                <tr>
                                    <td class="fw-medium">
                                        <i class="bi bi-person-circle me-1 text-muted"></i>@agent.FullName
                                    </td>
                                    <td class="text-muted">@(agent.Extension ?? "-")</td>
                                    <td class="text-center fw-medium">@agent.TotalCalls</td>
                                    <td class="text-center text-success">@agent.AnsweredCalls</td>
                                    <td class="text-center text-danger">@agent.MissedCalls</td>
                                    <td class="text-center text-muted">@FormatDuration(agent.AvgDurationSeconds)</td>
                                    <td class="text-center">
                                        @{
                                            var rateClass = agent.AnswerRate >= 80 ? "text-success" :
                                                            agent.AnswerRate >= 50 ? "text-warning" : "text-danger";
                                        }
                                        <span class="fw-bold @rateClass">%@agent.AnswerRate.ToString("0.#")</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted">Toplam: @report.Items.TotalCount temsilci</small>
                    <Pagination CurrentPage="currentPage" TotalPages="report.Items.TotalPages" OnPageChanged="OnPageChanged" />
                </div>
            }
        </div>
    </div>
}

@code {
    private AgentReportResponse? report;
    private List<CustomerSimpleDto> customers = new();
    private int selectedCustomerId;
    private DateTime? fromDate;
    private DateTime? toDate;
    private int currentPage = 1;
    private bool isLoading;
    private bool isExporting;
    private bool chartInitialized;
    private bool isCustomerUser;

    private List<SearchableSelect.SearchSelectItem> customerItems =>
        customers.Select(c => new SearchableSelect.SearchSelectItem(c.Id.ToString(), c.Name)).ToList();

    private string selectedCustomerIdStr => selectedCustomerId > 0 ? selectedCustomerId.ToString() : "";

    private void OnCustomerSelected(string? val)
    {
        selectedCustomerId = int.TryParse(val, out var id) ? id : 0;
    }

    protected override async Task OnInitializedAsync()
    {
        toDate = DateTime.Today;
        fromDate = DateTime.Today.AddDays(-30);

        await PermService.LoadAsync();
        if (PermService.CustomerId != null)
        {
            isCustomerUser = true;
            selectedCustomerId = PermService.CustomerId.Value;
        }
        else
        {
            try
            {
                var list = await Http.GetFromJsonAsync<List<CustomerSimpleDto>>("api/supervisor/customers");
                customers = list ?? new();
            }
            catch { }
        }

        await LoadReport();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (report != null && report.Items.Items.Count > 0 && !chartInitialized)
        {
            chartInitialized = true;
            await CreateAgentChart();
        }
    }

    private async Task CreateAgentChart()
    {
        try
        {
            var agents = report!.Items.Items;
            var config = new
            {
                type = "bar",
                data = new
                {
                    labels = agents.Select(a => a.FullName).ToArray(),
                    datasets = new object[]
                    {
                        new
                        {
                            label = "Cevaplama Orani (%)",
                            data = agents.Select(a => a.AnswerRate).ToArray(),
                            backgroundColor = agents.Select(a =>
                                a.AnswerRate >= 80 ? "rgba(25,135,84,0.7)" :
                                a.AnswerRate >= 50 ? "rgba(255,193,7,0.7)" : "rgba(220,53,69,0.7)").ToArray(),
                            borderWidth = 0
                        }
                    }
                },
                options = new
                {
                    responsive = true,
                    maintainAspectRatio = false,
                    plugins = new { legend = new { display = false } },
                    scales = new { y = new { beginAtZero = true, max = 100 } }
                }
            };
            await ChartJs.CreateChartAsync("agentChart", config);
        }
        catch { }
    }

    private async Task LoadReport()
    {
        isLoading = true;
        chartInitialized = false;
        StateHasChanged();

        try
        {
            var url = $"api/reports/agents?page={currentPage}&pageSize=20";
            if (selectedCustomerId > 0) url += $"&customerId={selectedCustomerId}";
            if (fromDate.HasValue) url += $"&from={fromDate.Value:yyyy-MM-dd}";
            if (toDate.HasValue) url += $"&to={toDate.Value:yyyy-MM-dd}";

            report = await Http.GetFromJsonAsync<AgentReportResponse>(url);
        }
        catch
        {
            report = new AgentReportResponse();
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task ExportCsv() => ExportReport("csv");
    private Task ExportExcel() => ExportReport("xlsx");

    private async Task ExportReport(string format)
    {
        isExporting = true;
        StateHasChanged();

        try
        {
            var url = $"api/reports/agents/export?format={format}";
            if (selectedCustomerId > 0) url += $"&customerId={selectedCustomerId}";
            if (fromDate.HasValue) url += $"&from={fromDate.Value:yyyy-MM-dd}";
            if (toDate.HasValue) url += $"&to={toDate.Value:yyyy-MM-dd}";

            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var fileName = $"temsilci-raporu-{DateTime.Now:yyyyMMdd}.{format}";
                var contentType = format == "xlsx"
                    ? "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                    : "text/csv";
                await JS.InvokeVoidAsync("downloadFile", fileName, contentType, bytes);
            }
        }
        catch { }
        finally
        {
            isExporting = false;
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadReport();
    }

    private async Task OnPageChanged(int pageNum)
    {
        currentPage = pageNum;
        await LoadReport();
    }

    private static string FormatDuration(int seconds)
    {
        if (seconds <= 0) return "-";
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.Hours > 0
            ? $"{ts.Hours}:{ts.Minutes:D2}:{ts.Seconds:D2}"
            : $"{ts.Minutes}:{ts.Seconds:D2}";
    }

    public async ValueTask DisposeAsync()
    {
        try { await ChartJs.DestroyChartAsync("agentChart"); } catch { }
    }
}
