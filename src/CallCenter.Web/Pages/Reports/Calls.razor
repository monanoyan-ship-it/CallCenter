@page "/reports/calls"
@attribute [Authorize(Roles = "Admin,Supervisor")]
@inject HttpClient Http
@inject ChartJsInterop ChartJs
@inject IJSRuntime JS
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums
@using CallCenter.Web.Services
@implements IAsyncDisposable

<PageTitle>Arama Raporlari - Call Center</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-file-earmark-bar-graph me-2 text-primary"></i>Arama Raporlari
    </h4>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-success btn-sm" @onclick="ExportCsv" disabled="@isExporting">
            <i class="bi bi-filetype-csv me-1"></i>CSV
        </button>
        <button class="btn btn-outline-primary btn-sm" @onclick="ExportExcel" disabled="@isExporting">
            <i class="bi bi-file-earmark-excel me-1"></i>Excel
        </button>
    </div>
</div>

@* --- FILTRELER --- *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Firma</label>
                <SearchableSelect Items="customerItems" Value="@selectedCustomerIdStr"
                                  ValueChanged="OnCustomerSelected" Placeholder="Tumu" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Baslangic</label>
                <input type="date" class="form-control form-control-sm" @bind="fromDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Bitis</label>
                <input type="date" class="form-control form-control-sm" @bind="toDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Yon</label>
                <select class="form-select form-select-sm" @bind="selectedDirectionId">
                    <option value="0">Tumu</option>
                    @foreach (var d in CallDirections.All)
                    {
                        <option value="@d.Id">@GetDirectionDisplayName(d.SystemName)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Durum</label>
                <select class="form-select form-select-sm" @bind="selectedStatusId">
                    <option value="0">Tumu</option>
                    @foreach (var s in CallStatuses.FinishedStatuses)
                    {
                        <option value="@s.Id">@GetStatusDisplayName(s.SystemName)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary btn-sm w-100" @onclick="ApplyFilters">
                    <i class="bi bi-funnel me-1"></i>Filtrele
                </button>
            </div>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (report != null)
{
    @* --- OZET KARTLARI (8 adet) --- *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small">Toplam Arama</div>
                            <div class="fs-3 fw-bold text-primary">@report.TotalCalls</div>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-3 p-2">
                            <i class="bi bi-telephone-fill text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small">Cevaplanan</div>
                            <div class="fs-3 fw-bold text-success">@report.AnsweredCalls</div>
                        </div>
                        <div class="bg-success bg-opacity-10 rounded-3 p-2">
                            <i class="bi bi-check-circle-fill text-success fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small">Cevapsiz</div>
                            <div class="fs-3 fw-bold text-warning">@report.MissedCalls</div>
                        </div>
                        <div class="bg-warning bg-opacity-10 rounded-3 p-2">
                            <i class="bi bi-telephone-x-fill text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small">Ort. Sure</div>
                            <div class="fs-3 fw-bold text-info">@FormatDuration(report.AvgDurationSeconds)</div>
                        </div>
                        <div class="bg-info bg-opacity-10 rounded-3 p-2">
                            <i class="bi bi-clock-fill text-info fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @* SLA KARTLARI *@
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small">Terk Orani</div>
                            <div class="fs-3 fw-bold @(report.AbandonmentRate > 20 ? "text-danger" : report.AbandonmentRate > 10 ? "text-warning" : "text-success")">
                                %@report.AbandonmentRate.ToString("0.#")
                            </div>
                        </div>
                        <div class="bg-danger bg-opacity-10 rounded-3 p-2">
                            <i class="bi bi-person-dash-fill text-danger fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small">ASA (Ort. Cevap Suresi)</div>
                            <div class="fs-3 fw-bold text-primary">@FormatDuration(report.AvgSpeedOfAnswerSeconds)</div>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-3 p-2">
                            <i class="bi bi-stopwatch-fill text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small">AHT (Ort. Gorusme)</div>
                            <div class="fs-3 fw-bold text-secondary">@FormatDuration(report.AvgHandleTimeSeconds)</div>
                        </div>
                        <div class="bg-secondary bg-opacity-10 rounded-3 p-2">
                            <i class="bi bi-headset text-secondary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small">SLA Uyum</div>
                            <div class="fs-3 fw-bold @(report.SlaComplianceRate >= 90 ? "text-success" : report.SlaComplianceRate >= 70 ? "text-warning" : "text-danger")">
                                %@report.SlaComplianceRate.ToString("0.#")
                            </div>
                        </div>
                        <div class="bg-success bg-opacity-10 rounded-3 p-2">
                            <i class="bi bi-shield-check text-success fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- GRAFIKLER --- *@
    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0">
                    <h6 class="mb-0"><i class="bi bi-graph-up me-2"></i>Gunluk Arama Trendi</h6>
                </div>
                <div class="card-body">
                    <canvas id="trendChart" style="height: 280px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0">
                    <h6 class="mb-0"><i class="bi bi-pie-chart me-2"></i>Durum Dagilimi</h6>
                </div>
                <div class="card-body">
                    <canvas id="distributionChart" style="height: 280px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    @* --- TABLO --- *@
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (report.Items.Items.Count == 0)
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-telephone-x fs-1 d-block mb-2 opacity-25"></i>
                    <span>Arama kaydi bulunamadi</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Arayan</th>
                                <th>Aranan</th>
                                <th>Yon</th>
                                <th>Durum</th>
                                <th>Sure</th>
                                <th>Temsilci</th>
                                <th>Kuyruk</th>
                                <th>Tarih</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var call in report.Items.Items)
                            {
                                var direction = CallDirections.GetById(call.DirectionId);
                                var status = CallStatuses.GetById(call.StatusId);
                                <tr>
                                    <td class="fw-medium">@call.CallerNumber</td>
                                    <td class="fw-medium">@call.CalleeNumber</td>
                                    <td>
                                        <i class="bi @(direction?.Icon ?? "bi-telephone") @(direction?.CssClass ?? "")"></i>
                                        <span class="small ms-1">@GetDirectionDisplayName(call.DirectionName)</span>
                                    </td>
                                    <td>
                                        <span class="badge @(status?.CssClass ?? "bg-secondary") rounded-pill">
                                            @GetStatusDisplayName(call.StatusName)
                                        </span>
                                    </td>
                                    <td class="text-muted">@FormatDuration(call.DurationSeconds)</td>
                                    <td class="text-muted">@(call.AgentName ?? "-")</td>
                                    <td class="text-muted small">@(call.QueueName ?? "-")</td>
                                    <td class="text-muted small">@call.StartedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted">Toplam: @report.Items.TotalCount kayit</small>
                    <Pagination CurrentPage="currentPage" TotalPages="report.Items.TotalPages" OnPageChanged="OnPageChanged" />
                </div>
            }
        </div>
    </div>
}

@code {
    private CallReportResponse? report;
    private List<CustomerSimpleDto> customers = new();
    private int selectedCustomerId;
    private DateTime? fromDate;
    private DateTime? toDate;
    private int selectedDirectionId;
    private int selectedStatusId;
    private int currentPage = 1;
    private bool isLoading;
    private bool isExporting;
    private bool chartsInitialized;

    private List<SearchableSelect.SearchSelectItem> customerItems =>
        customers.Select(c => new SearchableSelect.SearchSelectItem(c.Id.ToString(), c.Name)).ToList();

    private string selectedCustomerIdStr => selectedCustomerId > 0 ? selectedCustomerId.ToString() : "";

    private void OnCustomerSelected(string? val)
    {
        selectedCustomerId = int.TryParse(val, out var id) ? id : 0;
    }

    private static readonly Dictionary<string, string> StatusDisplayNames = new(StringComparer.OrdinalIgnoreCase)
    {
        { "Ringing", "Caliyor" }, { "InProgress", "Devam Ediyor" }, { "OnHold", "Beklemede" },
        { "Transferred", "Transfer" }, { "Completed", "Tamamlandi" }, { "Missed", "Cevapsiz" }, { "Failed", "Basarisiz" }
    };

    private static readonly Dictionary<string, string> DirectionDisplayNames = new(StringComparer.OrdinalIgnoreCase)
    {
        { "Inbound", "Gelen" }, { "Outbound", "Giden" }
    };

    private static readonly Dictionary<string, string> StatusColors = new(StringComparer.OrdinalIgnoreCase)
    {
        { "Completed", "#198754" }, { "Missed", "#ffc107" }, { "Failed", "#dc3545" },
        { "Ringing", "#0dcaf0" }, { "InProgress", "#0d6efd" }, { "OnHold", "#6c757d" }, { "Transferred", "#6f42c1" }
    };

    protected override async Task OnInitializedAsync()
    {
        toDate = DateTime.Today;
        fromDate = DateTime.Today.AddDays(-7);

        try
        {
            var list = await Http.GetFromJsonAsync<List<CustomerSimpleDto>>("api/supervisor/customers");
            customers = list ?? new();
        }
        catch { }

        await LoadReport();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (report != null && !chartsInitialized)
        {
            chartsInitialized = true;
            await LoadCharts();
        }
    }

    private async Task LoadReport()
    {
        isLoading = true;
        chartsInitialized = false;
        StateHasChanged();

        try
        {
            var url = $"api/reports/calls?page={currentPage}&pageSize=20";
            if (selectedCustomerId > 0) url += $"&customerId={selectedCustomerId}";
            if (fromDate.HasValue) url += $"&from={fromDate.Value:yyyy-MM-dd}";
            if (toDate.HasValue) url += $"&to={toDate.Value:yyyy-MM-dd}";
            if (selectedDirectionId > 0) url += $"&directionId={selectedDirectionId}";
            if (selectedStatusId > 0) url += $"&statusId={selectedStatusId}";

            report = await Http.GetFromJsonAsync<CallReportResponse>(url);
        }
        catch
        {
            report = new CallReportResponse();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadCharts()
    {
        try
        {
            var filterParams = BuildFilterParams();

            // Trend ve distribution verilerini paralel yukle
            var trendTask = Http.GetFromJsonAsync<List<DailyCallStatsDto>>($"api/reports/calls/trend{filterParams}");
            var distTask = Http.GetFromJsonAsync<List<StatusDistributionDto>>($"api/reports/calls/distribution{filterParams}");

            await Task.WhenAll(trendTask, distTask);

            var trend = trendTask.Result ?? new();
            var dist = distTask.Result ?? new();

            // Trend line chart
            if (trend.Count > 0)
            {
                var trendConfig = new
                {
                    type = "line",
                    data = new
                    {
                        labels = trend.Select(t => t.Date.ToString("dd.MM")).ToArray(),
                        datasets = new object[]
                        {
                            new { label = "Toplam", data = trend.Select(t => t.TotalCalls).ToArray(), borderColor = "#0d6efd", backgroundColor = "rgba(13,110,253,0.1)", fill = true, tension = 0.3 },
                            new { label = "Cevaplanan", data = trend.Select(t => t.AnsweredCalls).ToArray(), borderColor = "#198754", backgroundColor = "transparent", tension = 0.3 },
                            new { label = "Cevapsiz", data = trend.Select(t => t.MissedCalls).ToArray(), borderColor = "#ffc107", backgroundColor = "transparent", tension = 0.3 }
                        }
                    },
                    options = new { responsive = true, maintainAspectRatio = false, plugins = new { legend = new { position = "bottom" } } }
                };
                await ChartJs.CreateChartAsync("trendChart", trendConfig);
            }

            // Distribution pie chart
            if (dist.Count > 0)
            {
                var distConfig = new
                {
                    type = "doughnut",
                    data = new
                    {
                        labels = dist.Select(d => GetStatusDisplayName(d.StatusName)).ToArray(),
                        datasets = new object[]
                        {
                            new
                            {
                                data = dist.Select(d => d.Count).ToArray(),
                                backgroundColor = dist.Select(d => StatusColors.TryGetValue(d.StatusName, out var c) ? c : "#6c757d").ToArray()
                            }
                        }
                    },
                    options = new { responsive = true, maintainAspectRatio = false, plugins = new { legend = new { position = "bottom" } } }
                };
                await ChartJs.CreateChartAsync("distributionChart", distConfig);
            }
        }
        catch { }
    }

    private string BuildFilterParams()
    {
        var parts = new List<string>();
        if (selectedCustomerId > 0) parts.Add($"customerId={selectedCustomerId}");
        if (fromDate.HasValue) parts.Add($"from={fromDate.Value:yyyy-MM-dd}");
        if (toDate.HasValue) parts.Add($"to={toDate.Value:yyyy-MM-dd}");
        return parts.Count > 0 ? "?" + string.Join("&", parts) : "";
    }

    private Task ExportCsv() => ExportReport("csv");
    private Task ExportExcel() => ExportReport("xlsx");

    private async Task ExportReport(string format)
    {
        isExporting = true;
        StateHasChanged();

        try
        {
            var url = $"api/reports/calls/export?format={format}";
            if (selectedCustomerId > 0) url += $"&customerId={selectedCustomerId}";
            if (fromDate.HasValue) url += $"&from={fromDate.Value:yyyy-MM-dd}";
            if (toDate.HasValue) url += $"&to={toDate.Value:yyyy-MM-dd}";
            if (selectedDirectionId > 0) url += $"&directionId={selectedDirectionId}";
            if (selectedStatusId > 0) url += $"&statusId={selectedStatusId}";

            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var fileName = $"arama-raporu-{DateTime.Now:yyyyMMdd}.{format}";
                var contentType = format == "xlsx"
                    ? "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                    : "text/csv";
                await JS.InvokeVoidAsync("downloadFile", fileName, contentType, bytes);
            }
        }
        catch { }
        finally
        {
            isExporting = false;
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadReport();
    }

    private async Task OnPageChanged(int pageNum)
    {
        currentPage = pageNum;
        await LoadReport();
    }

    private string GetStatusDisplayName(string systemName) =>
        StatusDisplayNames.TryGetValue(systemName, out var name) ? name : systemName;

    private string GetDirectionDisplayName(string systemName) =>
        DirectionDisplayNames.TryGetValue(systemName, out var name) ? name : systemName;

    private static string FormatDuration(int seconds)
    {
        if (seconds <= 0) return "-";
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.Hours > 0
            ? $"{ts.Hours}:{ts.Minutes:D2}:{ts.Seconds:D2}"
            : $"{ts.Minutes}:{ts.Seconds:D2}";
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await ChartJs.DestroyChartAsync("trendChart");
            await ChartJs.DestroyChartAsync("distributionChart");
        }
        catch { }
    }
}
