@page "/reports/queues"
@page "/customer/reports/queues"
@attribute [Authorize(Roles = "Admin,Supervisor,CustomerUser")]
@inject HttpClient Http
@inject ChartJsInterop ChartJs
@inject PermissionService PermService
@using CallCenter.Shared.DTOs
@using CallCenter.Web.Services
@implements IAsyncDisposable

<PageTitle>Kuyruk Performansi - CorpLynk</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-diagram-3-fill me-2 text-primary"></i>Kuyruk Performansi
    </h4>
</div>

@* --- FILTRELER --- *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            @if (!isCustomerUser)
            {
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Firma</label>
                    <SearchableSelect Items="customerItems" Value="@selectedCustomerIdStr"
                                      ValueChanged="OnCustomerSelected" Placeholder="Tumu" />
                </div>
            }
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Baslangic</label>
                <input type="date" class="form-control form-control-sm" @bind="fromDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Bitis</label>
                <input type="date" class="form-control form-control-sm" @bind="toDate" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary btn-sm w-100" @onclick="ApplyFilters">
                    <i class="bi bi-funnel me-1"></i>Filtrele
                </button>
            </div>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (report != null)
{
    @* --- OZET KARTLARI --- *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small">Toplam Kuyruk</div>
                            <div class="fs-3 fw-bold text-primary">@report.TotalQueues</div>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-3 p-2">
                            <i class="bi bi-diagram-3-fill text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small">Genel SLA Uyum</div>
                            <div class="fs-3 fw-bold @GetSlaColorClass(report.OverallSlaRate)">
                                %@report.OverallSlaRate.ToString("0.#")
                            </div>
                        </div>
                        <div class="bg-success bg-opacity-10 rounded-3 p-2">
                            <i class="bi bi-shield-check text-success fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small">SLA Aciklamasi</div>
                            <div class="small text-muted mt-1">Kuyruk MaxWaitTime suresinde cevaplanan aramalarin orani</div>
                        </div>
                        <div class="bg-info bg-opacity-10 rounded-3 p-2">
                            <i class="bi bi-info-circle text-info fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- SLA BAR CHART --- *@
    @if (report.Items.Items.Count > 0)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0">
                <h6 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Kuyruk SLA Uyum Oranlari</h6>
            </div>
            <div class="card-body">
                <canvas id="queueSlaChart" style="height: 300px;"></canvas>
            </div>
        </div>
    }

    @* --- TABLO --- *@
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (report.Items.Items.Count == 0)
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-diagram-3 fs-1 d-block mb-2 opacity-25"></i>
                    <span>Kuyruk bulunamadi</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Kuyruk</th>
                                <th class="text-center">Toplam</th>
                                <th class="text-center">Cevaplanan</th>
                                <th class="text-center">Cevapsiz</th>
                                <th class="text-center">Ort. Bekleme</th>
                                <th class="text-center">Ort. Gorusme</th>
                                <th class="text-center">SLA Hedef</th>
                                <th class="text-center">SLA Uyum</th>
                                <th class="text-center">Terk Orani</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in report.Items.Items)
                            {
                                <tr>
                                    <td class="fw-medium">
                                        <i class="bi bi-diagram-3 me-1 text-muted"></i>@q.QueueName
                                    </td>
                                    <td class="text-center fw-medium">@q.TotalCalls</td>
                                    <td class="text-center text-success">@q.AnsweredCalls</td>
                                    <td class="text-center text-danger">@q.MissedCalls</td>
                                    <td class="text-center text-muted">@FormatDuration(q.AvgWaitSeconds)</td>
                                    <td class="text-center text-muted">@FormatDuration(q.AvgHandleSeconds)</td>
                                    <td class="text-center text-muted">@FormatDuration(q.SlaTargetSeconds)</td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill @GetSlaBadgeClass(q.SlaComplianceRate)">
                                            %@q.SlaComplianceRate.ToString("0.#")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="@(q.AbandonmentRate > 20 ? "text-danger fw-bold" : q.AbandonmentRate > 10 ? "text-warning" : "text-success")">
                                            %@q.AbandonmentRate.ToString("0.#")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted">Toplam: @report.Items.TotalCount kuyruk</small>
                    <Pagination CurrentPage="currentPage" TotalPages="report.Items.TotalPages" OnPageChanged="OnPageChanged" />
                </div>
            }
        </div>
    </div>
}

@code {
    private QueueReportResponse? report;
    private List<CustomerSimpleDto> customers = new();
    private int selectedCustomerId;
    private DateTime? fromDate;
    private DateTime? toDate;
    private int currentPage = 1;
    private bool isLoading;
    private bool chartInitialized;
    private bool isCustomerUser;

    private List<SearchableSelect.SearchSelectItem> customerItems =>
        customers.Select(c => new SearchableSelect.SearchSelectItem(c.Id.ToString(), c.Name)).ToList();

    private string selectedCustomerIdStr => selectedCustomerId > 0 ? selectedCustomerId.ToString() : "";

    private void OnCustomerSelected(string? val)
    {
        selectedCustomerId = int.TryParse(val, out var id) ? id : 0;
    }

    protected override async Task OnInitializedAsync()
    {
        toDate = DateTime.Today;
        fromDate = DateTime.Today.AddDays(-30);

        await PermService.LoadAsync();
        if (PermService.CustomerId != null)
        {
            isCustomerUser = true;
            selectedCustomerId = PermService.CustomerId.Value;
        }
        else
        {
            try
            {
                var list = await Http.GetFromJsonAsync<List<CustomerSimpleDto>>("api/supervisor/customers");
                customers = list ?? new();
            }
            catch { }
        }

        await LoadReport();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (report != null && report.Items.Items.Count > 0 && !chartInitialized)
        {
            chartInitialized = true;
            await CreateSlaChart();
        }
    }

    private async Task CreateSlaChart()
    {
        try
        {
            var queues = report!.Items.Items;
            var config = new
            {
                type = "bar",
                data = new
                {
                    labels = queues.Select(q => q.QueueName).ToArray(),
                    datasets = new object[]
                    {
                        new
                        {
                            label = "SLA Uyum (%)",
                            data = queues.Select(q => q.SlaComplianceRate).ToArray(),
                            backgroundColor = queues.Select(q =>
                                q.SlaComplianceRate >= 90 ? "rgba(25,135,84,0.7)" :
                                q.SlaComplianceRate >= 70 ? "rgba(255,193,7,0.7)" : "rgba(220,53,69,0.7)").ToArray(),
                            borderWidth = 0
                        }
                    }
                },
                options = new
                {
                    responsive = true,
                    maintainAspectRatio = false,
                    plugins = new { legend = new { display = false } },
                    scales = new { y = new { beginAtZero = true, max = 100 } }
                }
            };
            await ChartJs.CreateChartAsync("queueSlaChart", config);
        }
        catch { }
    }

    private async Task LoadReport()
    {
        isLoading = true;
        chartInitialized = false;
        StateHasChanged();

        try
        {
            var url = $"api/reports/queues?page={currentPage}&pageSize=20";
            if (selectedCustomerId > 0) url += $"&customerId={selectedCustomerId}";
            if (fromDate.HasValue) url += $"&from={fromDate.Value:yyyy-MM-dd}";
            if (toDate.HasValue) url += $"&to={toDate.Value:yyyy-MM-dd}";

            report = await Http.GetFromJsonAsync<QueueReportResponse>(url);
        }
        catch
        {
            report = new QueueReportResponse();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadReport();
    }

    private async Task OnPageChanged(int pageNum)
    {
        currentPage = pageNum;
        await LoadReport();
    }

    private static string GetSlaColorClass(double rate) =>
        rate >= 90 ? "text-success" : rate >= 70 ? "text-warning" : "text-danger";

    private static string GetSlaBadgeClass(double rate) =>
        rate >= 90 ? "bg-success" : rate >= 70 ? "bg-warning text-dark" : "bg-danger";

    private static string FormatDuration(int seconds)
    {
        if (seconds <= 0) return "-";
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.Hours > 0
            ? $"{ts.Hours}:{ts.Minutes:D2}:{ts.Seconds:D2}"
            : $"{ts.Minutes}:{ts.Seconds:D2}";
    }

    public async ValueTask DisposeAsync()
    {
        try { await ChartJs.DestroyChartAsync("queueSlaChart"); } catch { }
    }
}
