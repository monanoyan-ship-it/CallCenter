@page "/supervisor/monitoring"
@attribute [Authorize(Roles = "Admin,Supervisor")]
@inject HttpClient Http
@inject HubService HubService
@implements IDisposable
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums

<PageTitle>Arama Izleme - CorpLynk</PageTitle>

@* ─── BASLIK ─── *@
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-broadcast me-2 text-info"></i>Arama Izleme
    </h4>
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadMonitorableCallsAsync" title="Yenile">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
    </div>
</div>

@* ─── MEDYA SUNUCUSU UYARISI ─── *@
<div class="alert alert-warning d-flex align-items-start gap-2 mb-4">
    <i class="bi bi-exclamation-triangle-fill fs-5 mt-1"></i>
    <div>
        <strong>Medya sunucusu yapilandirilmamis.</strong>
        <p class="mb-0 small">
            Gercek arama izleme (Silent Monitoring, Whisper, Barge-In) bir medya sunucusu (Asterisk/FreeSWITCH/Janus) gerektirir.
            Su an bu sayfa sadece izleme kaydi olusturur, gercek ses akisi saglamaz.
            Medya sunucusu entegrasyonu sonraki sprintlerde planlanmistir.
        </p>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-info" role="status"></div>
        <p class="text-muted mt-2">Aktif aramalar yukleniyor...</p>
    </div>
}
else if (monitorableCalls == null || !monitorableCalls.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-telephone-x fs-1 text-muted"></i>
        <p class="text-muted mt-2">Su an izlenebilir aktif arama yok.</p>
    </div>
}
else
{
    @* ─── AKTIF IZLEME OTURUMLARI ─── *@
    @if (activeSessions.Any())
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent">
                <h6 class="mb-0"><i class="bi bi-record-circle text-danger me-2"></i>Aktif Izleme Oturumlari</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Arama</th>
                                <th>Supervisor</th>
                                <th>Mod</th>
                                <th>Baslangic</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var session in activeSessions)
                            {
                                <tr>
                                    <td>#@session.CallRecordId</td>
                                    <td>@session.SupervisorName</td>
                                    <td>
                                        <span class="badge bg-@GetModeBadge(session.ModeId)">
                                            <i class="bi @GetModeIcon(session.ModeId) me-1"></i>@session.ModeName
                                        </span>
                                    </td>
                                    <td class="small text-muted">@session.StartedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => StopMonitoringAsync(session.Id)">
                                            <i class="bi bi-stop-fill"></i> Durdur
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @* ─── IZLENEBILIR ARAMALAR ─── *@
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
            <h6 class="mb-0"><i class="bi bi-telephone-fill me-2"></i>Aktif Aramalar</h6>
            <span class="badge bg-secondary">@monitorableCalls.Count arama</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Agent</th>
                            <th>Arayan</th>
                            <th>Aranan</th>
                            <th>Kuyruk</th>
                            <th>Sure</th>
                            <th class="text-end">Islemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var call in monitorableCalls)
                        {
                            <tr>
                                <td>@call.CallRecordId</td>
                                <td>
                                    <i class="bi bi-person-fill me-1"></i>@call.AgentName
                                </td>
                                <td class="small">@call.CallerNumber</td>
                                <td class="small">@call.CalleeNumber</td>
                                <td class="small">@(call.QueueName ?? "-")</td>
                                <td class="small">@FormatDuration(call.DurationSeconds)</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" @onclick="() => StartMonitoringAsync(call.CallRecordId, 1)"
                                                title="Silent Monitoring">
                                            <i class="bi bi-ear-fill"></i> Dinle
                                        </button>
                                        <button class="btn btn-outline-warning" @onclick="() => StartMonitoringAsync(call.CallRecordId, 2)"
                                                title="Whisper - Agent'a fisilda">
                                            <i class="bi bi-chat-dots-fill"></i> Fisilda
                                        </button>
                                        <button class="btn btn-outline-danger" @onclick="() => StartMonitoringAsync(call.CallRecordId, 3)"
                                                title="Barge-In - Aramaya katil">
                                            <i class="bi bi-mic-fill"></i> Katil
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* ─── BILDIRIM ─── *@
@if (!string.IsNullOrEmpty(message))
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div class="toast show @(isError ? "bg-danger" : "bg-success") text-white">
            <div class="toast-body d-flex align-items-center justify-content-between">
                <span>@message</span>
                <button class="btn-close btn-close-white ms-2" @onclick="() => message = null"></button>
            </div>
        </div>
    </div>
}

@code {
    private List<MonitorableCallDto> monitorableCalls = new();
    private List<MonitoringSessionDto> activeSessions = new();
    private bool isLoading = true;
    private string? message;
    private bool isError;
    private System.Timers.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        HubService.OnMonitoringStarted += HandleMonitoringStarted;
        HubService.OnMonitoringStopped += HandleMonitoringStopped;

        await LoadMonitorableCallsAsync();
        await LoadActiveSessionsAsync();

        // 15 sn polling
        _refreshTimer = new System.Timers.Timer(15_000);
        _refreshTimer.Elapsed += async (_, _) =>
        {
            await LoadMonitorableCallsAsync();
            await LoadActiveSessionsAsync();
            await InvokeAsync(StateHasChanged);
        };
        _refreshTimer.Start();
    }

    private async Task LoadMonitorableCallsAsync()
    {
        isLoading = true;
        try
        {
            var list = await Http.GetFromJsonAsync<List<MonitorableCallDto>>("api/monitoring/monitorable");
            monitorableCalls = list ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Monitoring] Yuklenemedi: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadActiveSessionsAsync()
    {
        try
        {
            var list = await Http.GetFromJsonAsync<List<MonitoringSessionDto>>("api/monitoring/active");
            activeSessions = list ?? new();
        }
        catch { }
    }

    private async Task StartMonitoringAsync(int callRecordId, int modeId)
    {
        try
        {
            var request = new StartMonitoringRequest
            {
                CallRecordId = callRecordId,
                ModeId = modeId
            };
            var response = await Http.PostAsJsonAsync("api/monitoring/start", request);

            if (response.IsSuccessStatusCode)
            {
                var modeName = MonitoringModes.GetById(modeId)?.SystemName ?? "Unknown";
                ShowMessage($"Izleme baslatildi: {modeName}", false);
                await LoadActiveSessionsAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ShowMessage($"Hata: {error}", true);
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Istek hatasi: {ex.Message}", true);
        }
    }

    private async Task StopMonitoringAsync(int sessionId)
    {
        try
        {
            var response = await Http.PostAsync($"api/monitoring/{sessionId}/stop", null);
            if (response.IsSuccessStatusCode)
            {
                ShowMessage("Izleme durduruldu", false);
                await LoadActiveSessionsAsync();
            }
            else
            {
                ShowMessage("Izleme durdurulamadi", true);
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Hata: {ex.Message}", true);
        }
    }

    // ─── SignalR Handlers ───

    private void HandleMonitoringStarted(MonitoringEvent e)
    {
        InvokeAsync(async () =>
        {
            await LoadActiveSessionsAsync();
            StateHasChanged();
        });
    }

    private void HandleMonitoringStopped(MonitoringStoppedEvent e)
    {
        InvokeAsync(async () =>
        {
            await LoadActiveSessionsAsync();
            StateHasChanged();
        });
    }

    // ─── Helpers ───

    private void ShowMessage(string msg, bool error)
    {
        message = msg;
        isError = error;
        InvokeAsync(StateHasChanged);
        _ = Task.Delay(3000).ContinueWith(_ =>
        {
            message = null;
            InvokeAsync(StateHasChanged);
        });
    }

    private string GetModeBadge(int modeId) => modeId switch
    {
        1 => "primary",  // Silent
        2 => "warning",  // Whisper
        3 => "danger",   // Barge
        _ => "secondary"
    };

    private string GetModeIcon(int modeId) => modeId switch
    {
        1 => "bi-ear-fill",
        2 => "bi-chat-dots-fill",
        3 => "bi-mic-fill",
        _ => "bi-question-circle"
    };

    private string FormatDuration(int seconds)
    {
        if (seconds <= 0) return "-";
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.Hours > 0
            ? $"{ts.Hours:D2}:{ts.Minutes:D2}:{ts.Seconds:D2}"
            : $"{ts.Minutes:D2}:{ts.Seconds:D2}";
    }

    public void Dispose()
    {
        _refreshTimer?.Stop();
        _refreshTimer?.Dispose();
        HubService.OnMonitoringStarted -= HandleMonitoringStarted;
        HubService.OnMonitoringStopped -= HandleMonitoringStopped;
    }
}
