@page "/portal/organizations"
@attribute [Authorize(Roles = "Admin,CustomerUser")]
@inject HttpClient Http
@inject NavigationManager Nav
@inject ToastService Toast
@inject PermissionService PermService
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums

<PageTitle>Organizasyonlar - Call Center</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-diagram-3-fill me-2 text-primary"></i>Organizasyonlar
    </h4>
    @if (PermService.IsAdmin || PermService.IsFirmaAdmin)
    {
        <button class="btn btn-primary btn-sm" @onclick="OpenCreateForm">
            <i class="bi bi-plus-lg me-1"></i>Yeni Birim
        </button>
    }
</div>

@if (PermService.IsAdmin)
{
    <div class="d-flex align-items-center gap-2 mb-3">
        <label class="form-label mb-0 small text-muted">Musteri:</label>
        <span class="badge bg-primary-subtle text-primary">@(customerId.HasValue ? $"ID: {customerId}" : "Belirtilmedi")</span>
    </div>
}

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    <div class="row g-3">
        @* ─── SOL: AGAC ─── *@
        <div class="col-md-5">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex align-items-center justify-content-between py-2">
                    <small class="fw-semibold text-muted">Organizasyon Agaci</small>
                    <span class="badge bg-secondary-subtle text-secondary">@GetTotalCount() birim</span>
                </div>
                <div class="card-body" style="max-height: 600px; overflow-y: auto;">
                    @if (tree == null || tree.Count == 0)
                    {
                        <div class="text-center text-muted py-3">
                            <i class="bi bi-diagram-3 fs-3 d-block mb-2 opacity-25"></i>
                            <small>Henuz organizasyon birimi yok.</small>
                        </div>
                    }
                    else
                    {
                        @foreach (var root in tree)
                        {
                            <OrgTreeNode Node="root" SelectedId="selectedNodeId" OnSelected="OnNodeSelected" />
                        }
                    }
                </div>
            </div>
        </div>

        @* ─── SAG: DETAY ─── *@
        <div class="col-md-7">
            @if (detail == null)
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center text-muted py-5">
                        <i class="bi bi-arrow-left fs-3 d-block mb-2 opacity-25"></i>
                        <small>Sol taraftan bir birim seciniz.</small>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white d-flex align-items-center justify-content-between py-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(OrganizationUnitTypes.GetById(detail.TypeId)?.CssClass ?? "bg-secondary")">
                                <i class="bi @(detail.TypeIcon ?? "bi-folder")"></i>
                                @detail.TypeName
                            </span>
                            <span class="fw-semibold">@detail.Name</span>
                            @if (!detail.IsActive)
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Pasif</span>
                            }
                        </div>
                        @if (PermService.IsAdmin || PermService.IsFirmaAdmin)
                        {
                            <div class="d-flex gap-1">
                                <button class="btn btn-outline-primary btn-sm" @onclick="OpenEditForm" title="Duzenle">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="ConfirmDeleteNode" title="Sil">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        }
                    </div>
                    <div class="card-body">
                        <div class="row g-3 mb-3">
                            @if (!string.IsNullOrEmpty(detail.Code))
                            {
                                <div class="col-sm-6">
                                    <small class="text-muted d-block">Kod</small>
                                    <span>@detail.Code</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(detail.ParentName))
                            {
                                <div class="col-sm-6">
                                    <small class="text-muted d-block">Ust Birim</small>
                                    <span>@detail.ParentName</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(detail.Phone))
                            {
                                <div class="col-sm-6">
                                    <small class="text-muted d-block">Telefon</small>
                                    <span>@detail.Phone</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(detail.Email))
                            {
                                <div class="col-sm-6">
                                    <small class="text-muted d-block">E-posta</small>
                                    <span>@detail.Email</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(detail.Address))
                            {
                                <div class="col-12">
                                    <small class="text-muted d-block">Adres</small>
                                    <span>@detail.Address</span>
                                </div>
                            }
                        </div>

                        @* Personel listesi - Hiyerarsik Kart + Drag-Drop *@
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h6 class="text-muted mb-0"><i class="bi bi-people me-1"></i>Personel (@detail.Personnel.Count)</h6>
                            @if (PermService.IsAdmin || PermService.IsFirmaAdmin)
                            {
                                <button class="btn btn-outline-primary btn-sm" @onclick="OpenAssignPersonnel" title="Personel Ata">
                                    <i class="bi bi-person-plus me-1"></i>Ata
                                </button>
                            }
                        </div>
                        @if (detail.Personnel.Count > 0)
                        {
                            <div class="personnel-hierarchy">
                                @foreach (var p in GetSubordinates(null))
                                {
                                    @RenderPersonnelCard(p)
                                }
                            </div>

                            @if (PermService.IsAdmin || PermService.IsFirmaAdmin)
                            {
                                <div class="drop-zone-root @(isDragging ? "visible" : "")"
                                     ondragover="event.preventDefault();"
                                     @ondrop="() => OnDrop(null)">
                                    <i class="bi bi-arrow-up me-1"></i>Amirsiz bolgeye tasi
                                </div>
                            }
                        }

                        @if (detail.Children.Count > 0)
                        {
                            <h6 class="text-muted mb-2"><i class="bi bi-diagram-3 me-1"></i>Alt Birimler (@detail.Children.Count)</h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Ad</th>
                                            <th>Tip</th>
                                            <th class="text-center">Personel</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in detail.Children)
                                        {
                                            <tr>
                                                <td>@c.Name</td>
                                                <td class="text-muted small">@c.TypeName</td>
                                                <td class="text-center">
                                                    <span class="badge bg-primary-subtle text-primary rounded-pill">@c.PersonnelCount</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

<PortalOrganizationForm @ref="orgForm" OnSaved="OnFormSaved" />

<ConfirmDialog @ref="confirmDialog" OnConfirm="ExecuteDelete"
               Message="@($"'{detail?.Name}' birimini silmek istediginize emin misiniz?")" />

@* ─── PERSONEL ATAMA MODAL ─── *@
@if (showAssignModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Personel Ata</h5>
                    <button type="button" class="btn-close" @onclick="() => showAssignModal = false"></button>
                </div>
                <div class="modal-body">
                    @if (availablePersonnel == null)
                    {
                        <div class="text-center py-3"><div class="spinner-border spinner-border-sm"></div></div>
                    }
                    else if (availablePersonnel.Count == 0)
                    {
                        <div class="text-muted text-center py-3">Atanabilecek personel yok.</div>
                    }
                    else
                    {
                        <SearchableSelect Items="availablePersonnelItems" Value="" ValueChanged="OnAssignPersonnelSelected"
                                          Placeholder="-- Personel seciniz --" />
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => showAssignModal = false">Kapat</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<OrgUnitTreeDto>? tree;
    private OrgUnitDetailDto? detail;
    private int? selectedNodeId;
    private bool isLoading;
    private int? customerId;
    private PortalOrganizationForm orgForm = null!;
    private ConfirmDialog confirmDialog = null!;

    // Drag-drop
    private int? draggedPersonnelId;
    private bool isDragging;
    private int? dragOverPersonnelId;

    // Personel atama
    private bool showAssignModal;
    private List<OrgUnitPersonnelDto>? availablePersonnel;
    private List<SearchableSelect.SearchSelectItem> availablePersonnelItems =>
        availablePersonnel?.Select(p => new SearchableSelect.SearchSelectItem(p.Id.ToString(), p.FullName, p.Title)).ToList() ?? new();

    protected override async Task OnInitializedAsync()
    {
        await PermService.LoadAsync();

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var queryParams = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var cidStr = queryParams["customerId"];
        if (!string.IsNullOrEmpty(cidStr) && int.TryParse(cidStr, out var cid))
            customerId = cid;

        await LoadTree();
    }

    private string BuildUrl(string baseUrl)
    {
        return customerId.HasValue ? $"{baseUrl}?customerId={customerId}" : baseUrl;
    }

    private async Task LoadTree()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            tree = await Http.GetFromJsonAsync<List<OrgUnitTreeDto>>(BuildUrl("api/portal/organizations/tree"));
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Agac yuklenemedi: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnNodeSelected(OrgUnitTreeDto node)
    {
        selectedNodeId = node.Id;
        try
        {
            detail = await Http.GetFromJsonAsync<OrgUnitDetailDto>(BuildUrl($"api/portal/organizations/{node.Id}"));
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Detay yuklenemedi: {ex.Message}");
        }
    }

    private void OpenCreateForm() => orgForm.OpenForCreate(selectedNodeId, customerId);
    private void OpenEditForm()
    {
        if (detail != null) orgForm.OpenForEdit(detail, customerId);
    }
    private void ConfirmDeleteNode()
    {
        if (detail != null) confirmDialog.Show();
    }

    private async Task ExecuteDelete()
    {
        if (detail == null) return;
        try
        {
            var response = await Http.DeleteAsync(BuildUrl($"api/portal/organizations/{detail.Id}"));
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Birim silindi.");
                detail = null;
                selectedNodeId = null;
                await LoadTree();
            }
            else
            {
                var err = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(err?.Error ?? "Silme islemi basarisiz.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Hata: {ex.Message}");
        }
    }

    private async Task OnFormSaved()
    {
        await LoadTree();
        if (selectedNodeId.HasValue)
        {
            try
            {
                detail = await Http.GetFromJsonAsync<OrgUnitDetailDto>(BuildUrl($"api/portal/organizations/{selectedNodeId}"));
            }
            catch { }
        }
    }

    private int GetTotalCount()
    {
        if (tree == null) return 0;
        return tree.Sum(CountNodes);
    }

    private int CountNodes(OrgUnitTreeDto node) => 1 + node.Children.Sum(CountNodes);

    // ─── PERSONEL ATAMA ───

    private async Task OpenAssignPersonnel()
    {
        if (detail == null) return;
        try
        {
            availablePersonnel = await Http.GetFromJsonAsync<List<OrgUnitPersonnelDto>>(
                BuildUrl($"api/portal/organizations/{detail.Id}/available-personnel"));
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Hata: {ex.Message}");
            return;
        }
        showAssignModal = true;
    }

    private async Task OnAssignPersonnelSelected(string? val)
    {
        if (!int.TryParse(val, out var personnelId) || detail == null) return;
        try
        {
            var response = await Http.PostAsJsonAsync(
                BuildUrl($"api/portal/organizations/{detail.Id}/personnel"),
                new { PersonnelId = personnelId });
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Personel atandi.");
                showAssignModal = false;
                detail = await Http.GetFromJsonAsync<OrgUnitDetailDto>(
                    BuildUrl($"api/portal/organizations/{detail.Id}"));
                await LoadTree();
            }
            else
            {
                var err = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(err?.Error ?? "Atama basarisiz.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
    }

    private async Task RemovePersonnel(int personnelId)
    {
        if (detail == null) return;
        try
        {
            var response = await Http.DeleteAsync(
                BuildUrl($"api/portal/organizations/{detail.Id}/personnel/{personnelId}"));
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Personel cikarildi.");
                detail = await Http.GetFromJsonAsync<OrgUnitDetailDto>(
                    BuildUrl($"api/portal/organizations/{detail.Id}"));
                await LoadTree();
            }
            else
            {
                var err = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(err?.Error ?? "Cikarma basarisiz.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
    }

    // ─── DRAG-DROP (AMİR ATAMASI) ───

    private List<OrgUnitPersonnelDto> GetSubordinates(int? parentId) =>
        detail?.Personnel.Where(p => p.ReportsToPersonnelId == parentId).ToList() ?? new();

    private RenderFragment RenderPersonnelCard(OrgUnitPersonnelDto person) => __builder =>
    {
        var canDrag = PermService.IsAdmin || PermService.IsFirmaAdmin;
        var isOver = dragOverPersonnelId == person.Id;
        var cardClass = "personnel-card" + (isOver ? " drag-over" : "");
        var subs = GetSubordinates(person.Id);

        <div class="@cardClass"
             draggable="@(canDrag ? "true" : "false")"
             @ondragstart="() => OnDragStart(person.Id)"
             @ondragend="OnDragEnd"
             ondragover="event.preventDefault();"
             @ondragenter="() => OnDragEnter(person.Id)"
             @ondragleave="() => OnDragLeave(person.Id)"
             @ondrop="() => OnDrop(person.Id)"
             @ondrop:stopPropagation>
            @if (canDrag)
            {
                <i class="bi bi-grip-vertical drag-handle text-muted"></i>
            }
            <i class="bi bi-person-fill text-primary me-1"></i>
            <span class="fw-medium">@person.FullName</span>
            <small class="text-muted ms-2">@person.Title</small>
            @if (!string.IsNullOrEmpty(person.CustomerRoleName))
            {
                <span class="badge bg-primary-subtle text-primary ms-auto">@person.CustomerRoleName</span>
            }
            @if (canDrag && !person.IsPrimaryAssignment)
            {
                <button class="btn btn-outline-danger btn-sm py-0 px-1 ms-1" @onclick="() => RemovePersonnel(person.Id)" @onclick:stopPropagation title="Cikar">
                    <i class="bi bi-x-lg" style="font-size:0.7rem;"></i>
                </button>
            }
        </div>

        @if (subs.Count > 0)
        {
            <div class="personnel-subordinates">
                @foreach (var sub in subs)
                {
                    @RenderPersonnelCard(sub)
                }
            </div>
        }
    };

    private void OnDragStart(int personnelId)
    {
        draggedPersonnelId = personnelId;
        isDragging = true;
    }

    private void OnDragEnd()
    {
        isDragging = false;
        dragOverPersonnelId = null;
    }

    private void OnDragEnter(int personnelId) => dragOverPersonnelId = personnelId;

    private void OnDragLeave(int personnelId)
    {
        if (dragOverPersonnelId == personnelId) dragOverPersonnelId = null;
    }

    private async Task OnDrop(int? targetPersonnelId)
    {
        dragOverPersonnelId = null;
        isDragging = false;

        if (draggedPersonnelId == null || draggedPersonnelId == targetPersonnelId || detail == null)
        {
            draggedPersonnelId = null;
            return;
        }

        var dragId = draggedPersonnelId.Value;
        draggedPersonnelId = null;

        try
        {
            var response = await Http.PatchAsJsonAsync(
                BuildUrl($"api/portal/personnel/{dragId}/reports-to"),
                new SetReportsToDto { ReportsToPersonnelId = targetPersonnelId });

            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Amir atamasi guncellendi.");
                detail = await Http.GetFromJsonAsync<OrgUnitDetailDto>(
                    BuildUrl($"api/portal/organizations/{detail.Id}"));
            }
            else
            {
                var err = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(err?.Message ?? "Amir atamasi basarisiz.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Hata: {ex.Message}");
        }
    }

    private record ErrorMsg(string? Error, string? Message);
}

<style>
    .personnel-hierarchy { margin-bottom: 8px; }
    .personnel-card { padding: 8px 12px; border: 1px solid #dee2e6; border-radius: 6px; margin: 4px 0; cursor: grab; display: flex; align-items: center; gap: 6px; background: white; transition: all 0.2s; }
    .personnel-card:hover { background: #f8f9fa; }
    .personnel-card.drag-over { border-color: #0d6efd; background: #e7f1ff; }
    .personnel-subordinates { margin-left: 24px; border-left: 2px solid #dee2e6; padding-left: 8px; }
    .drag-handle { cursor: grab; opacity: 0.5; }
    .drag-handle:hover { opacity: 1; }
    .drop-zone-root { padding: 12px; border: 2px dashed #dee2e6; border-radius: 6px; text-align: center; color: #6c757d; margin-top: 8px; display: none; }
    .drop-zone-root.visible { display: block; }
    .drop-zone-root:hover { border-color: #0d6efd; background: #e7f1ff; }
</style>
