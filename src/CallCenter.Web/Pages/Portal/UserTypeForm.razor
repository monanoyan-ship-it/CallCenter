@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs

@if (isVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi @(isEditMode ? "bi-pencil" : "bi-plus-lg") me-2"></i>
                        @(isEditMode ? "Kullanici Tipini Duzenle" : "Yeni Kullanici Tipi")
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger py-2 small">@errorMessage</div>
                        }

                        <div class="mb-3">
                            <label class="form-label small">Tip Adi</label>
                            <InputText class="form-control form-control-sm" @bind-Value="model.Name" />
                            <ValidationMessage For="@(() => model.Name)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small">Aciklama</label>
                            <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="model.Description" />
                        </div>

                        @if (isEditMode)
                        {
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="isActive" />
                                <label class="form-check-label small">Aktif</label>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="Close">Iptal</button>
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-check-lg me-1"></i>Kaydet
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? CustomerIdParam { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool isVisible;
    private bool isEditMode;
    private bool isSaving;
    private bool isActive = true;
    private string? errorMessage;
    private int editId;
    private UserTypeCreateDto model = new();

    private string BuildUrl(string baseUrl)
    {
        return CustomerIdParam != null ? $"{baseUrl}?customerId={CustomerIdParam}" : baseUrl;
    }

    public void OpenForCreate()
    {
        isEditMode = false;
        model = new();
        isActive = true;
        errorMessage = null;
        isVisible = true;
        StateHasChanged();
    }

    public void OpenForEdit(UserTypeListDto item)
    {
        isEditMode = true;
        editId = item.Id;
        model = new() { Name = item.Name, Description = item.Description };
        isActive = item.IsActive;
        errorMessage = null;
        isVisible = true;
        StateHasChanged();
    }

    private void Close() => isVisible = false;

    private async Task HandleSubmit()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            HttpResponseMessage response;

            if (isEditMode)
            {
                var updateDto = new UserTypeUpdateDto
                {
                    Name = model.Name,
                    Description = model.Description,
                    IsActive = isActive
                };
                response = await Http.PutAsJsonAsync(BuildUrl($"api/portal/usertypes/{editId}"), updateDto);
            }
            else
            {
                response = await Http.PostAsJsonAsync(BuildUrl("api/portal/usertypes"), model);
            }

            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess(isEditMode ? "Tip guncellendi." : "Tip olusturuldu.");
                isVisible = false;
                await OnSaved.InvokeAsync();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                errorMessage = error?.Message ?? "Islem basarisiz.";
            }
        }
        catch (Exception ex) { errorMessage = $"Hata: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private record ErrorMsg(string? Message);
}
