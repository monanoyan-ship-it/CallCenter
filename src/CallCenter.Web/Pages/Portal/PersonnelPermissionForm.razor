@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs

@if (isVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-shield-check me-2"></i>@target?.FullName — Yetkiler
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    @if (isLoadingPerms)
                    {
                        <div class="text-center py-3"><div class="spinner-border spinner-border-sm"></div></div>
                    }
                    else if (modules != null)
                    {
                        @foreach (var mod in modules.Where(m => m.IsActive))
                        {
                            <div class="mb-3">
                                <h6 class="text-muted border-bottom pb-1">
                                    <i class="bi @(mod.Icon ?? "bi-box") me-1"></i>@mod.SystemName
                                </h6>
                                @foreach (var perm in mod.Permissions)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="pperm_@perm.Id"
                                               checked="@selectedPermIds.Contains(perm.Id)"
                                               @onchange="(e) => TogglePerm(perm.Id, (bool)(e.Value ?? false))" />
                                        <label class="form-check-label small" for="pperm_@perm.Id">
                                            <i class="bi @(perm.Icon ?? "bi-check") me-1 text-muted"></i>
                                            @perm.Description
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="Close">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="Save" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-check-lg me-1"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? CustomerIdParam { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool isVisible;
    private bool isLoadingPerms;
    private bool isSaving;
    private PortalPersonnelListDto? target;
    private List<PortalModuleDto>? modules;
    private HashSet<int> selectedPermIds = new();

    private string BuildUrl(string baseUrl)
    {
        return CustomerIdParam != null ? $"{baseUrl}?customerId={CustomerIdParam}" : baseUrl;
    }

    public async void Open(PortalPersonnelListDto item)
    {
        target = item;
        selectedPermIds.Clear();
        isVisible = true;
        isLoadingPerms = true;
        StateHasChanged();

        try
        {
            modules = await Http.GetFromJsonAsync<List<PortalModuleDto>>(BuildUrl("api/portal/modules"));
            var perms = await Http.GetFromJsonAsync<List<PersonnelPermissionDto>>(BuildUrl($"api/portal/personnel/{item.Id}/permissions"));
            if (perms != null)
                selectedPermIds = perms.Where(p => p.IsActive).Select(p => p.PermissionTypeId).ToHashSet();
        }
        catch (Exception ex) { Toast.ShowError($"Yetkiler yuklenemedi: {ex.Message}"); }
        finally { isLoadingPerms = false; StateHasChanged(); }
    }

    private void Close()
    {
        isVisible = false;
        target = null;
    }

    private void TogglePerm(int permId, bool isChecked)
    {
        if (isChecked) selectedPermIds.Add(permId);
        else selectedPermIds.Remove(permId);
    }

    private async Task Save()
    {
        if (target == null) return;
        isSaving = true;

        try
        {
            var request = new SetPersonnelPermissionsRequest
            {
                PermissionTypeIds = selectedPermIds.ToArray(),
                ScopeId = 3 // Customer scope
            };
            var response = await Http.PostAsJsonAsync(BuildUrl($"api/portal/personnel/{target.Id}/permissions"), request);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Yetkiler kaydedildi.");
                isVisible = false;
                await OnSaved.InvokeAsync();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                Toast.ShowError(error?.Message ?? "Yetki kaydi basarisiz.");
            }
        }
        catch (Exception ex) { Toast.ShowError($"Hata: {ex.Message}"); }
        finally { isSaving = false; }
    }

    private record ErrorMsg(string? Message);
}
