@inject HttpClient Http
@inject ToastService Toast
@using CallCenter.Shared.DTOs

@if (isVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi @(isEditMode ? "bi-pencil" : "bi-person-plus") me-2"></i>
                        @(isEditMode ? "Personel Duzenle" : "Yeni Personel")
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <EditForm Model="@formModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger py-2 small">@errorMessage</div>
                        }

                        @if (!isEditMode || AllowEditUserName)
                        {
                            <div class="mb-3">
                                <label class="form-label small">
                                    Kullanici Adi
                                    @if (usernameCheckState == 1)
                                    {
                                        <span class="spinner-border spinner-border-sm text-muted ms-1" style="width:0.7rem;height:0.7rem;"></span>
                                    }
                                    else if (usernameCheckState == 2)
                                    {
                                        <span class="badge bg-success-subtle text-success ms-1" style="font-size: 0.65rem;">musait</span>
                                    }
                                    else if (usernameCheckState == 3)
                                    {
                                        <span class="badge bg-danger-subtle text-danger ms-1" style="font-size: 0.65rem;">kullaniliyor</span>
                                    }
                                </label>
                                <InputText class="@UsernameInputCss()"
                                           @bind-Value="formModel.UserName" @oninput="OnUserNameInput" />
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label small">Ad Soyad</label>
                            <InputText class="form-control form-control-sm" @bind-Value="formModel.FullName" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small">E-posta</label>
                            <InputText class="form-control form-control-sm" @bind-Value="formModel.Email" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small">
                                Sifre
                                @if (isEditMode)
                                {
                                    <span class="text-muted">(bos birakirsaniz degismez)</span>
                                }
                            </label>
                            <InputText type="password" class="form-control form-control-sm" @bind-Value="formModel.Password" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small">Unvan</label>
                            <InputText class="form-control form-control-sm" @bind-Value="formModel.Title" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small">Rol</label>
                            <select class="form-select form-select-sm" @bind="selectedRoleId">
                                <option value="0">-- Secilmedi --</option>
                                @foreach (var role in CallCenter.Shared.Enums.CustomerRoles.All)
                                {
                                    <option value="@role.Id">@role.Description</option>
                                }
                            </select>
                        </div>

                        @if (isEditMode)
                        {
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="formModel.IsActive" />
                                <label class="form-check-label small">Aktif</label>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="Close">Iptal</button>
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-check-lg me-1"></i>Kaydet
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? CustomerIdParam { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public bool AllowEditUserName { get; set; }

    private bool isVisible;
    private bool isEditMode;
    private bool isSaving;
    private string? errorMessage;
    private int editId;
    private int selectedRoleId;
    private string originalUserName = "";

    private PersonnelFormModel formModel = new();
    private int usernameCheckState; // 0=idle, 1=checking, 2=available, 3=taken
    private CancellationTokenSource? _usernameCts;

    private string BuildUrl(string baseUrl)
    {
        return CustomerIdParam != null ? $"{baseUrl}?customerId={CustomerIdParam}" : baseUrl;
    }

    public async void OpenForCreate()
    {
        isEditMode = false;
        formModel = new();
        selectedRoleId = 0;
        errorMessage = null;
        originalUserName = "";
        usernameCheckState = 0;
        isVisible = true;
        StateHasChanged();
    }

    public async void OpenForEdit(PortalPersonnelListDto item)
    {
        isEditMode = true;
        editId = item.Id;
        selectedRoleId = item.CustomerRoleId;
        originalUserName = item.UserName;
        usernameCheckState = 0;
        formModel = new()
        {
            UserName = item.UserName,
            FullName = item.FullName,
            Email = item.Email,
            Title = item.Title,
            IsActive = item.IsActive
        };
        errorMessage = null;
        isVisible = true;
        StateHasChanged();
    }

    private void Close() => isVisible = false;

    private void OnUserNameInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        formModel.UserName = val;
        _ = CheckUsernameAsync(val);
    }

    private async Task CheckUsernameAsync(string username)
    {
        _usernameCts?.Cancel();
        if (string.IsNullOrWhiteSpace(username) || username.Length < 3)
        {
            usernameCheckState = 0;
            StateHasChanged();
            return;
        }

        usernameCheckState = 1;
        StateHasChanged();

        _usernameCts = new CancellationTokenSource();
        var token = _usernameCts.Token;

        try
        {
            await Task.Delay(400, token);
            if (token.IsCancellationRequested) return;

            if (isEditMode && username == originalUserName)
            {
                usernameCheckState = 2;
                StateHasChanged();
                return;
            }

            var excludeParam = "";
            var result = await Http.GetFromJsonAsync<UsernameCheckResult>(
                $"api/portal/personnel/check-username?username={Uri.EscapeDataString(username)}{excludeParam}", token);

            usernameCheckState = result?.Available == true ? 2 : 3;
        }
        catch (OperationCanceledException) { return; }
        catch { usernameCheckState = 0; }
        StateHasChanged();
    }

    private record UsernameCheckResult(bool Available);

    private string UsernameInputCss() => usernameCheckState switch
    {
        3 => "form-control form-control-sm is-invalid",
        2 => "form-control form-control-sm is-valid",
        _ => "form-control form-control-sm"
    };

    private async Task HandleSubmit()
    {
        if (usernameCheckState == 3)
        {
            errorMessage = "Bu kullanici adi zaten kullaniliyor.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            HttpResponseMessage response;

            if (isEditMode)
            {
                var updateDto = new PortalPersonnelUpdateDto
                {
                    UserName = AllowEditUserName ? formModel.UserName : null,
                    FullName = formModel.FullName,
                    Email = formModel.Email,
                    Password = string.IsNullOrWhiteSpace(formModel.Password) ? null : formModel.Password,
                    Title = formModel.Title,
                    CustomerRoleId = selectedRoleId,
                    IsActive = formModel.IsActive
                };
                response = await Http.PutAsJsonAsync(BuildUrl($"api/portal/personnel/{editId}"), updateDto);
            }
            else
            {
                if (string.IsNullOrWhiteSpace(formModel.Password))
                {
                    errorMessage = "Sifre zorunludur.";
                    isSaving = false;
                    return;
                }
                if (string.IsNullOrWhiteSpace(formModel.UserName))
                {
                    errorMessage = "Kullanici adi zorunludur.";
                    isSaving = false;
                    return;
                }

                var createDto = new PortalPersonnelCreateDto
                {
                    UserName = formModel.UserName,
                    FullName = formModel.FullName,
                    Email = formModel.Email,
                    Password = formModel.Password,
                    Title = formModel.Title,
                    CustomerRoleId = selectedRoleId
                };
                response = await Http.PostAsJsonAsync(BuildUrl("api/portal/personnel"), createDto);
            }

            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess(isEditMode ? "Personel guncellendi." : "Personel olusturuldu.");
                isVisible = false;
                await OnSaved.InvokeAsync();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                errorMessage = error?.Message ?? "Islem basarisiz.";
            }
        }
        catch (Exception ex) { errorMessage = $"Hata: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private record ErrorMsg(string? Message);

    public class PersonnelFormModel
    {
        public string UserName { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? Password { get; set; }
        public string Title { get; set; } = string.Empty;
        public bool IsActive { get; set; } = true;
    }
}
