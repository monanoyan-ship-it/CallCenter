@page "/customer/portal/sip"
@attribute [Authorize(Roles = "CustomerUser")]
@inject HttpClient Http
@inject NavigationManager Nav
@inject ToastService Toast
@inject PermissionService PermService
@using CallCenter.Shared.DTOs

<PageTitle>SIP Ayarlari - CorpLynk</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-router-fill me-2 text-primary"></i>SIP Ayarlari
    </h4>
    @if (PermService.HasPermission(81))
    {
        <button class="btn btn-primary btn-sm" @onclick="OpenCreate">
            <i class="bi bi-plus-lg me-1"></i>Yeni SIP Hesabi
        </button>
    }
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else if (items == null || items.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-router fs-1 d-block mb-2 opacity-25"></i>
                <span>SIP hesabi bulunamadi</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Hesap Adi</th>
                            <th>Sunucu</th>
                            <th>Port</th>
                            <th>Transport</th>
                            <th class="text-center">Hatlar</th>
                            <th class="text-center">Varsayilan</th>
                            <th>Durum</th>
                            <th style="width: 60px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr class="@(!item.IsActive ? "table-secondary" : "")">
                                <td class="fw-medium">@item.Name</td>
                                <td class="small text-muted">@item.Server</td>
                                <td class="small">@item.Port</td>
                                <td><span class="badge bg-light text-dark border">@(item.Transport ?? "UDP")</span></td>
                                <td class="text-center">
                                    <span class="badge bg-info-subtle text-info">
                                        @item.ActiveLineCount / @item.LineCount
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.IsDefault)
                                    {
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Pasif</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-outline-primary btn-sm" title="Duzenle"
                                            @onclick="() => OpenEdit(item)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                </td>
                            </tr>

                            @* ─── Inline Lines display ─── *@
                            @if (item.Lines != null && item.Lines.Count > 0)
                            {
                                <tr>
                                    <td colspan="8" class="p-0">
                                        <div class="bg-light border-top px-4 py-2">
                                            <small class="fw-medium text-muted d-block mb-1">
                                                <i class="bi bi-telephone me-1"></i>Hatlar
                                            </small>
                                            <div class="table-responsive">
                                                <table class="table table-sm table-borderless mb-0">
                                                    <thead>
                                                        <tr class="small text-muted">
                                                            <th style="width: 80px;">Kanal</th>
                                                            <th>Kullanici Adi</th>
                                                            <th>Aciklama</th>
                                                            <th class="text-center" style="width: 80px;">Durum</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var line in item.Lines)
                                                        {
                                                            <tr class="small">
                                                                <td>@line.ChannelNumber</td>
                                                                <td>@line.Username</td>
                                                                <td class="text-muted">@(line.Description ?? "-")</td>
                                                                <td class="text-center">
                                                                    @if (line.IsActive)
                                                                    {
                                                                        <span class="badge bg-success-subtle text-success">Aktif</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge bg-secondary-subtle text-secondary">Pasif</span>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ─── CREATE MODAL ─── *@
@if (showCreate)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-plus-circle me-2"></i>Yeni SIP Hesabi
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseCreate"></button>
                </div>
                <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                    @if (!string.IsNullOrEmpty(createError))
                    {
                        <div class="alert alert-danger py-2 small">@createError</div>
                    }

                    <h6 class="small text-muted mb-3"><i class="bi bi-hdd-network me-1"></i>Gateway Bilgileri</h6>

                    <div class="mb-3">
                        <label class="form-label small">Hesap Adi <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm" @bind="createModel.Name" />
                    </div>

                    <div class="row mb-3">
                        <div class="col-8">
                            <label class="form-label small">Sunucu <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" @bind="createModel.Server" placeholder="sip.example.com" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Port</label>
                            <input type="number" class="form-control form-control-sm" @bind="createModel.Port" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">Transport</label>
                        <select class="form-select form-select-sm" @bind="createModel.Transport">
                            <option value="UDP">UDP</option>
                            <option value="TCP">TCP</option>
                            <option value="TLS">TLS</option>
                            <option value="WSS">WSS</option>
                        </select>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" @bind="createModel.IsDefault" />
                        <label class="form-check-label small">Varsayilan hesap olarak ayarla</label>
                    </div>

                    @* ─── Lines section ─── *@
                    <hr class="my-3" />
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="small text-muted mb-0"><i class="bi bi-telephone me-1"></i>Hatlar</h6>
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddCreateLine">
                            <i class="bi bi-plus-lg me-1"></i>Hat Ekle
                        </button>
                    </div>

                    @if (createLines.Count == 0)
                    {
                        <div class="text-center text-muted py-3 border rounded">
                            <small>Henuz hat eklenmedi.</small>
                        </div>
                    }
                    else
                    {
                        @for (int i = 0; i < createLines.Count; i++)
                        {
                            var idx = i;
                            <div class="border rounded p-2 mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <small class="fw-medium text-muted">Hat @(idx + 1)</small>
                                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-1"
                                            @onclick="() => RemoveCreateLine(idx)" title="Kaldir">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                                <div class="row g-2">
                                    <div class="col-md-2">
                                        <label class="form-label small">Kanal No</label>
                                        <input type="number" class="form-control form-control-sm"
                                               @bind="createLines[idx].ChannelNumber" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small">Kullanici Adi</label>
                                        <input type="text" class="form-control form-control-sm"
                                               @bind="createLines[idx].Username" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small">Sifre</label>
                                        <input type="password" class="form-control form-control-sm"
                                               @bind="createLines[idx].Password" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small">Aciklama</label>
                                        <input type="text" class="form-control form-control-sm"
                                               @bind="createLines[idx].Description" placeholder="(opsiyonel)" />
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseCreate">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveCreate" disabled="@isCreating">
                        @if (isCreating)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-plus-lg me-1"></i>Olustur
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ─── EDIT MODAL (sinirli) ─── *@
@if (showEdit)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-pencil me-2"></i>SIP Hesabi Duzenle
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseEdit"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger py-2 small">@errorMessage</div>
                    }

                    <div class="mb-3">
                        <label class="form-label small">Hesap Adi</label>
                        <input type="text" class="form-control form-control-sm" @bind="editModel.Name" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">Sunucu <span class="text-muted">(salt okunur)</span></label>
                        <input type="text" class="form-control form-control-sm" value="@editTarget?.Server" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">Port <span class="text-muted">(salt okunur)</span></label>
                        <input type="text" class="form-control form-control-sm" value="@editTarget?.Port" readonly />
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="editIsDefault" />
                        <label class="form-check-label small">Varsayilan hesap olarak ayarla</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseEdit">Iptal</button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveEdit" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-check-lg me-1"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PortalSipAccountDto>? items;
    private bool isLoading;

    // Create
    private bool showCreate;
    private bool isCreating;
    private string? createError;
    private PortalSipCreateDto createModel = new();
    private List<PortalSipLineCreateDto> createLines = new();

    // Edit
    private bool showEdit;
    private bool isSaving;
    private bool editIsDefault;
    private string? errorMessage;
    private PortalSipAccountDto? editTarget;
    private PortalSipUpdateDto editModel = new();

    protected override async Task OnInitializedAsync()
    {
        await PermService.LoadAsync();
        if (!PermService.IsAdmin && !PermService.IsFirmaAdmin)
        {
            Nav.NavigateTo("/customer/dashboard", replace: true);
            return;
        }
        await LoadData();
    }

    private string BuildUrl(string baseUrl)
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var queryParams = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var cidStr = queryParams["customerId"];
        if (!string.IsNullOrEmpty(cidStr))
            return $"{baseUrl}?customerId={cidStr}";
        return baseUrl;
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            items = await Http.GetFromJsonAsync<List<PortalSipAccountDto>>(BuildUrl("api/portal/sip"));
        }
        catch (Exception ex) { Toast.ShowError($"SIP hesaplari yuklenemedi: {ex.Message}"); }
        finally { isLoading = false; }
    }

    // ─── Create ───
    private void OpenCreate()
    {
        createModel = new PortalSipCreateDto();
        createLines = new();
        createError = null;
        showCreate = true;
    }

    private void CloseCreate()
    {
        showCreate = false;
    }

    private void AddCreateLine()
    {
        var nextChannel = createLines.Count > 0 ? createLines.Max(l => l.ChannelNumber) + 1 : 1;
        createLines.Add(new PortalSipLineCreateDto { ChannelNumber = nextChannel });
    }

    private void RemoveCreateLine(int index)
    {
        if (index >= 0 && index < createLines.Count)
            createLines.RemoveAt(index);
    }

    private async Task SaveCreate()
    {
        isCreating = true;
        createError = null;

        try
        {
            createModel.Lines = createLines.Count > 0 ? createLines : null;
            var response = await Http.PostAsJsonAsync(BuildUrl("api/portal/sip"), createModel);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("SIP hesabi olusturuldu.");
                showCreate = false;
                await LoadData();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                createError = error?.Message ?? "Olusturma basarisiz.";
            }
        }
        catch (Exception ex) { createError = $"Hata: {ex.Message}"; }
        finally { isCreating = false; }
    }

    // ─── Edit ───
    private void OpenEdit(PortalSipAccountDto item)
    {
        editTarget = item;
        editModel = new() { Name = item.Name };
        editIsDefault = item.IsDefault;
        errorMessage = null;
        showEdit = true;
    }

    private void CloseEdit()
    {
        showEdit = false;
        editTarget = null;
    }

    private async Task SaveEdit()
    {
        if (editTarget == null) return;
        isSaving = true;
        errorMessage = null;

        try
        {
            editModel.IsDefault = editIsDefault;
            var response = await Http.PutAsJsonAsync(BuildUrl($"api/portal/sip/{editTarget.Id}"), editModel);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("SIP hesabi guncellendi.");
                showEdit = false;
                await LoadData();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorMsg>();
                errorMessage = error?.Message ?? "Guncelleme basarisiz.";
            }
        }
        catch (Exception ex) { errorMessage = $"Hata: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private record ErrorMsg(string? Message);
}
