@page "/change-password"
@layout LoginLayout
@attribute [Authorize]
@inject CallCenter.Web.Services.AuthService AuthService
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Authorization

<PageTitle>Sifre Degistir - Call Center</PageTitle>

<div class="login-card">
    <div class="login-header">
        <div class="login-logo change-pw-logo">
            <i class="bi bi-shield-lock"></i>
        </div>
        <h4 class="mb-1">Sifre Degistir</h4>
        <p class="text-muted small mb-0">Devam etmek icin yeni bir sifre belirleyin</p>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success d-flex align-items-center py-2 mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <span class="small">@successMessage</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center py-2 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <span class="small">@errorMessage</span>
        </div>
    }

    <EditForm Model="@model" OnValidSubmit="HandleSubmit" FormName="ChangePasswordForm">
        <DataAnnotationsValidator />

        <div class="form-floating mb-3">
            <InputText id="currentPassword" type="password" class="form-control" @bind-Value="model.CurrentPassword"
                       placeholder="Mevcut Sifre" disabled="@isLoading" />
            <label for="currentPassword">
                <i class="bi bi-key me-1"></i>Mevcut Sifre
            </label>
            <ValidationMessage For="@(() => model.CurrentPassword)" />
        </div>

        <div class="form-floating mb-3">
            <InputText id="newPassword" type="password" class="form-control" @bind-Value="model.NewPassword"
                       placeholder="Yeni Sifre" disabled="@isLoading" />
            <label for="newPassword">
                <i class="bi bi-lock me-1"></i>Yeni Sifre
            </label>
            <ValidationMessage For="@(() => model.NewPassword)" />
        </div>

        <div class="form-floating mb-3">
            <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="model.ConfirmPassword"
                       placeholder="Yeni Sifre Tekrar" disabled="@isLoading" />
            <label for="confirmPassword">
                <i class="bi bi-lock-fill me-1"></i>Yeni Sifre Tekrar
            </label>
            <ValidationMessage For="@(() => model.ConfirmPassword)" />
        </div>

        <div class="password-rules mb-3">
            <small class="text-muted">
                <i class="bi bi-info-circle me-1"></i>Sifre en az 8 karakter olmali ve buyuk harf, kucuk harf, rakam ve ozel karakter icermelidir.
            </small>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                <span>Degistiriliyor...</span>
            }
            else
            {
                <i class="bi bi-check-lg me-2"></i>
                <span>Sifreyi Degistir</span>
            }
        </button>
    </EditForm>

    <div class="login-footer">
        <small class="text-muted">&copy; @DateTime.Now.Year Call Center</small>
    </div>
</div>

@code {
    private ChangePasswordModel model = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading;

    private async Task HandleSubmit()
    {
        errorMessage = null;
        successMessage = null;

        if (model.NewPassword != model.ConfirmPassword)
        {
            errorMessage = "Yeni sifreler eslesmiyor.";
            return;
        }

        if (model.NewPassword == model.CurrentPassword)
        {
            errorMessage = "Yeni sifre mevcut sifreden farkli olmalidir.";
            return;
        }

        isLoading = true;

        try
        {
            var result = await AuthService.ChangePasswordAsync(new CallCenter.Shared.DTOs.ChangePasswordRequest
            {
                CurrentPassword = model.CurrentPassword,
                NewPassword = model.NewPassword
            });

            if (result.Success)
            {
                successMessage = "Sifreniz basariyla degistirildi. Yonlendiriliyorsunuz...";
                StateHasChanged();
                await Task.Delay(1500);
                NavigationManager.NavigateTo("/dashboard", forceLoad: false);
            }
            else
            {
                errorMessage = result.ErrorMessage;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private class ChangePasswordModel
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
