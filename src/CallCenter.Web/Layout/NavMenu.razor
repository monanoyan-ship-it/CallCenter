@* Sol Panel - Admin / Supervisor Menusu *@
@inject NavigationManager NavigationManager
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<div class="sidebar-header">
    <div class="d-flex align-items-center justify-content-between px-3 py-2">
        <a class="brand" href="dashboard">
            <i class="bi bi-headset me-2"></i>
            <span class="brand-text">CorpLynk</span>
        </a>
        <button class="btn btn-link sidebar-toggle d-lg-none" @onclick="ToggleNavMenu">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
</div>

<div class="sidebar-body">
    <nav>
        @* ─── DASHBOARD ─── *@
        <div class="nav-item">
            <NavLink class="nav-link" href="dashboard" Match="NavLinkMatch.All">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </NavLink>
        </div>

        @* ─── SUPERVISOR ─── *@
        <div class="nav-group">
            <button class="nav-group-toggle" @onclick="() => ToggleGroup(6)">
                <i class="bi bi-eye-fill"></i>
                <span>Supervisor</span>
                <i class="bi bi-chevron-down chevron @(IsGroupOpen(6) ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(IsGroupOpen(6) ? "show" : "")">
                <NavLink class="nav-link" href="supervisor/dashboard">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Canli Izleme</span>
                </NavLink>
            </div>
        </div>

        @* ─── RAPORLAR (istatistik) ─── *@
        <div class="nav-group">
            <button class="nav-group-toggle" @onclick="() => ToggleGroup(2)">
                <i class="bi bi-bar-chart-fill"></i>
                <span>Raporlar</span>
                <i class="bi bi-chevron-down chevron @(IsGroupOpen(2) ? "open" : "")"></i>
            </button>
            <div class="nav-group-items @(IsGroupOpen(2) ? "show" : "")">
                <NavLink class="nav-link" href="reports/calls">
                    <i class="bi bi-file-earmark-bar-graph"></i>
                    <span>Arama Istatistikleri</span>
                </NavLink>
                <NavLink class="nav-link" href="reports/agents">
                    <i class="bi bi-person-lines-fill"></i>
                    <span>Temsilci Performansi</span>
                </NavLink>
                <NavLink class="nav-link" href="reports/queues">
                    <i class="bi bi-diagram-3-fill"></i>
                    <span>Kuyruk Performansi</span>
                </NavLink>
            </div>
        </div>

        @* ─── YÖNETİM (Management paneline yonlendir) ─── *@
        @if (IsAdmin)
        {
            <div class="nav-item mt-2">
                <a class="nav-link" href="http://localhost:5280" target="_blank" style="color: rgba(100,181,246,.9);">
                    <i class="bi bi-gear-wide-connected"></i>
                    <span>Management Panel</span>
                    <i class="bi bi-box-arrow-up-right ms-1" style="font-size:.7rem;"></i>
                </a>
            </div>
        }
    </nav>
</div>

@* ─── SIDEBAR FOOTER ─── *@
<div class="sidebar-footer">
    <div class="agent-status">
        <div class="d-flex align-items-center">
            <div class="agent-avatar">
                <i class="bi bi-person-circle"></i>
            </div>
            <div class="agent-info">
                <span class="agent-name">@fullName</span>
                <span class="agent-role">@roleName</span>
            </div>
        </div>
    </div>
    <div class="text-center mt-2" style="opacity:.4; font-size:.65rem;">
        Tum haklari saklidir.
    </div>
</div>

@code {
    private bool collapseNavMenu = true;
    private HashSet<int> openGroups = new();
    private string fullName = "...";
    private string roleName = "";
    private string userRole = "";

    private bool IsAdmin => string.Equals(userRole, "Admin", StringComparison.OrdinalIgnoreCase);

    private static readonly Dictionary<string, string> RoleNames = new(StringComparer.OrdinalIgnoreCase)
    {
        { "Admin", "Yonetici" },
        { "Supervisor", "Supervisor" }
    };

    private static readonly Dictionary<int, string[]> GroupRoutes = new()
    {
        { 2, new[] { "reports/" } },
        { 6, new[] { "supervisor/" } }
    };

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
        OpenGroupByCurrentUrl();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await ReloadUserInfoAsync();
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        await ReloadUserInfoAsync();
    }

    private async Task ReloadUserInfoAsync()
    {
        var name = await AuthService.GetFullNameAsync();
        var role = await AuthService.GetRoleAsync();

        fullName = name ?? "Kullanici";
        userRole = role ?? "";
        roleName = role != null && RoleNames.TryGetValue(role, out var tr) ? tr : role ?? "";

        await InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        OpenGroupByCurrentUrl();
        InvokeAsync(StateHasChanged);
    }

    private void OpenGroupByCurrentUrl()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLowerInvariant();
        openGroups.Clear();
        foreach (var (groupIndex, prefixes) in GroupRoutes)
        {
            if (prefixes.Any(p => relativePath.StartsWith(p, StringComparison.OrdinalIgnoreCase)))
            {
                openGroups.Add(groupIndex);
                return;
            }
        }
    }

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private void ToggleGroup(int index)
    {
        if (openGroups.Contains(index))
            openGroups.Remove(index);
        else
        {
            openGroups.Clear();
            openGroups.Add(index);
        }
    }

    private bool IsGroupOpen(int index) => openGroups.Contains(index);

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }
}
