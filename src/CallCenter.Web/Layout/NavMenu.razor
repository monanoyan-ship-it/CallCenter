@* Sol Panel - Call Center Menü *@
@inject NavigationManager NavigationManager
@inject AuthService AuthService
@inject PermissionService PermService
@implements IDisposable

<div class="sidebar-header">
    <div class="d-flex align-items-center justify-content-between px-3 py-2">
        <a class="brand" href="">
            <i class="bi bi-headset me-2"></i>
            <span class="brand-text">Call Center</span>
        </a>
        <button class="btn btn-link sidebar-toggle d-lg-none" @onclick="ToggleNavMenu">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
</div>

<div class="sidebar-body">
    <nav>
        @* ─── ANA SAYFA ─── *@
        <div class="nav-item">
            <NavLink class="nav-link" href="dashboard" Match="NavLinkMatch.All">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </NavLink>
        </div>

        @if (IsCustomerUser)
        {
            @* ═══════════════════════════════════════════════════ *@
            @* CUSTOMERUSER PORTAL MENUSU                          *@
            @* ═══════════════════════════════════════════════════ *@

            @* ─── PORTAL YÖNETİMİ ─── *@
            <div class="nav-group">
                <button class="nav-group-toggle" @onclick="() => ToggleGroup(10)">
                    <i class="bi bi-building"></i>
                    <span>Portal</span>
                    <i class="bi bi-chevron-down chevron @(IsGroupOpen(10) ? "open" : "")"></i>
                </button>
                <div class="nav-group-items @(IsGroupOpen(10) ? "show" : "")">
                    @if (PermService.HasModule(7))
                    {
                        <NavLink class="nav-link" href="portal/personnel">
                            <i class="bi bi-person-badge"></i>
                            <span>Personel Yonetimi</span>
                        </NavLink>
                    }
                    @if (PermService.HasModule(8))
                    {
                        <NavLink class="nav-link" href="portal/usertypes">
                            <i class="bi bi-person-vcard"></i>
                            <span>Kullanici Tipleri</span>
                        </NavLink>
                    }
                    @if (PermService.HasModule(9))
                    {
                        <NavLink class="nav-link" href="portal/sip">
                            <i class="bi bi-router-fill"></i>
                            <span>SIP Ayarlari</span>
                        </NavLink>
                    }
                    <NavLink class="nav-link" href="portal/modules">
                        <i class="bi bi-grid-3x3-gap-fill"></i>
                        <span>Modullerim</span>
                    </NavLink>
                </div>
            </div>

            @* ─── ARAMALAR (CustomerUser — Calls modulu aciksa) ─── *@
            @if (PermService.HasModule(2))
            {
                <div class="nav-group">
                    <button class="nav-group-toggle" @onclick="() => ToggleGroup(0)">
                        <i class="bi bi-telephone-fill"></i>
                        <span>Arama</span>
                        <i class="bi bi-chevron-down chevron @(IsGroupOpen(0) ? "open" : "")"></i>
                    </button>
                    <div class="nav-group-items @(IsGroupOpen(0) ? "show" : "")">
                        <NavLink class="nav-link" href="dialer">
                            <i class="bi bi-dialpad-fill"></i>
                            <span>Numara Cevirici</span>
                        </NavLink>
                        <NavLink class="nav-link" href="calls/active">
                            <i class="bi bi-telephone-inbound-fill"></i>
                            <span>Aktif Aramalar</span>
                        </NavLink>
                        <NavLink class="nav-link" href="calls/history">
                            <i class="bi bi-clock-history"></i>
                            <span>Arama Gecmisi</span>
                        </NavLink>
                    </div>
                </div>
            }

            @* ─── RAPORLAR (CustomerUser — Reports modulu aciksa) ─── *@
            @if (PermService.HasModule(3))
            {
                <div class="nav-group">
                    <button class="nav-group-toggle" @onclick="() => ToggleGroup(2)">
                        <i class="bi bi-bar-chart-fill"></i>
                        <span>Raporlar</span>
                        <i class="bi bi-chevron-down chevron @(IsGroupOpen(2) ? "open" : "")"></i>
                    </button>
                    <div class="nav-group-items @(IsGroupOpen(2) ? "show" : "")">
                        <NavLink class="nav-link" href="reports/calls">
                            <i class="bi bi-file-earmark-bar-graph"></i>
                            <span>Arama Raporlari</span>
                        </NavLink>
                        <NavLink class="nav-link" href="reports/agents">
                            <i class="bi bi-person-lines-fill"></i>
                            <span>Temsilci Performansi</span>
                        </NavLink>
                    </div>
                </div>
            }
        }
        else
        {
            @* ═══════════════════════════════════════════════════ *@
            @* ADMIN / SUPERVISOR / AGENT MENUSU                   *@
            @* ═══════════════════════════════════════════════════ *@

            @* ─── ÇAĞRI YÖNETİMİ ─── *@
            <div class="nav-group">
                <button class="nav-group-toggle" @onclick="() => ToggleGroup(0)">
                    <i class="bi bi-telephone-fill"></i>
                    <span>Arama</span>
                    <i class="bi bi-chevron-down chevron @(IsGroupOpen(0) ? "open" : "")"></i>
                </button>
                <div class="nav-group-items @(IsGroupOpen(0) ? "show" : "")">
                    <NavLink class="nav-link" href="dialer">
                        <i class="bi bi-dialpad-fill"></i>
                        <span>Numara Cevirici</span>
                    </NavLink>
                    <NavLink class="nav-link" href="calls/active">
                        <i class="bi bi-telephone-inbound-fill"></i>
                        <span>Aktif Aramalar</span>
                    </NavLink>
                    <NavLink class="nav-link" href="calls/history">
                        <i class="bi bi-clock-history"></i>
                        <span>Arama Gecmisi</span>
                    </NavLink>
                </div>
            </div>

            @* ─── KUYRUKLAR ─── *@
            <div class="nav-group">
                <button class="nav-group-toggle" @onclick="() => ToggleGroup(1)">
                    <i class="bi bi-people-fill"></i>
                    <span>Kuyruklar</span>
                    <i class="bi bi-chevron-down chevron @(IsGroupOpen(1) ? "open" : "")"></i>
                </button>
                <div class="nav-group-items @(IsGroupOpen(1) ? "show" : "")">
                    <NavLink class="nav-link" href="queues">
                        <i class="bi bi-list-ol"></i>
                        <span>Kuyruk Listesi</span>
                    </NavLink>
                    <NavLink class="nav-link" href="queues/live">
                        <i class="bi bi-broadcast"></i>
                        <span>Canli Izleme</span>
                    </NavLink>
                </div>
            </div>

            @* ─── RAPORLAR ─── *@
            <div class="nav-group">
                <button class="nav-group-toggle" @onclick="() => ToggleGroup(2)">
                    <i class="bi bi-bar-chart-fill"></i>
                    <span>Raporlar</span>
                    <i class="bi bi-chevron-down chevron @(IsGroupOpen(2) ? "open" : "")"></i>
                </button>
                <div class="nav-group-items @(IsGroupOpen(2) ? "show" : "")">
                    <NavLink class="nav-link" href="reports/calls">
                        <i class="bi bi-file-earmark-bar-graph"></i>
                        <span>Arama Raporlari</span>
                    </NavLink>
                    <NavLink class="nav-link" href="reports/agents">
                        <i class="bi bi-person-lines-fill"></i>
                        <span>Temsilci Performansi</span>
                    </NavLink>
                </div>
            </div>

            @* ─── YÖNETİM (Admin + Supervisor) ─── *@
            @if (IsAdminOrSupervisor)
            {
                <div class="nav-group">
                    <button class="nav-group-toggle" @onclick="() => ToggleGroup(3)">
                        <i class="bi bi-gear-fill"></i>
                        <span>Yonetim</span>
                        <i class="bi bi-chevron-down chevron @(IsGroupOpen(3) ? "open" : "")"></i>
                    </button>
                    <div class="nav-group-items @(IsGroupOpen(3) ? "show" : "")">
                        @if (IsAdmin)
                        {
                            <NavLink class="nav-link" href="admin/users">
                                <i class="bi bi-person-fill-gear"></i>
                                <span>Kullanicilar</span>
                            </NavLink>
                        }
                        <NavLink class="nav-link" href="admin/customers">
                            <i class="bi bi-building"></i>
                            <span>Musteriler</span>
                        </NavLink>
                        <NavLink class="nav-link" href="admin/queues">
                            <i class="bi bi-diagram-3-fill"></i>
                            <span>Kuyruk Yapilandirmasi</span>
                        </NavLink>
                        @if (IsAdmin)
                        {
                            <NavLink class="nav-link" href="admin/sip">
                                <i class="bi bi-router-fill"></i>
                                <span>SIP Ayarlari</span>
                            </NavLink>
                            <NavLink class="nav-link" href="admin/translations">
                                <i class="bi bi-translate"></i>
                                <span>Dil Yonetimi</span>
                            </NavLink>
                            <NavLink class="nav-link" href="admin/settings">
                                <i class="bi bi-sliders"></i>
                                <span>Sistem Ayarlari</span>
                            </NavLink>
                        }
                    </div>
                </div>
            }
        }
    </nav>
</div>

@* ─── SIDEBAR FOOTER: Agent Durumu ─── *@
<div class="sidebar-footer">
    <div class="agent-status">
        <div class="d-flex align-items-center">
            <div class="agent-avatar">
                <i class="bi bi-person-circle"></i>
            </div>
            <div class="agent-info">
                <span class="agent-name">@fullName</span>
                <span class="agent-role">@roleName</span>
            </div>
        </div>
    </div>
</div>

@code {
    private bool collapseNavMenu = true;
    private HashSet<int> openGroups = new();
    private string fullName = "...";
    private string roleName = "";
    private string userRole = "";

    private bool IsAdmin => string.Equals(userRole, "Admin", StringComparison.OrdinalIgnoreCase);
    private bool IsAdminOrSupervisor => IsAdmin || string.Equals(userRole, "Supervisor", StringComparison.OrdinalIgnoreCase);
    private bool IsCustomerUser => string.Equals(userRole, "CustomerUser", StringComparison.OrdinalIgnoreCase);

    // Rol adlarini Turkce goster
    private static readonly Dictionary<string, string> RoleNames = new(StringComparer.OrdinalIgnoreCase)
    {
        { "Admin", "Yonetici" },
        { "Supervisor", "Supervisor" },
        { "Agent", "Temsilci" },
        { "CustomerUser", "Musteri" }
    };

    // Grup index → URL prefix eslestirmesi
    private static readonly Dictionary<int, string[]> GroupRoutes = new()
    {
        { 0, new[] { "dialer", "calls/" } },
        { 1, new[] { "queues" } },
        { 2, new[] { "reports/" } },
        { 3, new[] { "admin/" } },
        { 10, new[] { "portal/" } }
    };

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        OpenGroupByCurrentUrl();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var name = await AuthService.GetFullNameAsync();
            var role = await AuthService.GetRoleAsync();

            fullName = name ?? "Kullanici";
            userRole = role ?? "";
            roleName = role != null && RoleNames.TryGetValue(role, out var tr) ? tr : role ?? "";

            // Portal yetkileri yukle
            await PermService.LoadAsync();

            StateHasChanged();
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        OpenGroupByCurrentUrl();
        InvokeAsync(StateHasChanged);
    }

    private void OpenGroupByCurrentUrl()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLowerInvariant();

        foreach (var (groupIndex, prefixes) in GroupRoutes)
        {
            if (prefixes.Any(p => relativePath.StartsWith(p, StringComparison.OrdinalIgnoreCase)))
            {
                openGroups.Add(groupIndex);
                return;
            }
        }
    }

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void ToggleGroup(int index)
    {
        if (openGroups.Contains(index))
            openGroups.Remove(index);
        else
            openGroups.Add(index);
    }

    private bool IsGroupOpen(int index) => openGroups.Contains(index);

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
