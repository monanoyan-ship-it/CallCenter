@inherits LayoutComponentBase
@inject AuthService AuthService
@inject HubService HubService
@inject SipService SipService
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@implements IAsyncDisposable
@using CallCenter.Shared.Enums
@using CallCenter.Shared.DTOs

<div class="app-layout @(sidebarOpen ? "sidebar-open" : "")">
    @* ─── MOBİL OVERLAY ─── *@
    <div class="sidebar-overlay @(sidebarOpen ? "show" : "")" @onclick="CloseSidebar"></div>

    @* ─── SOL PANEL ─── *@
    <aside class="sidebar">
        <NavMenu />
    </aside>

    @* ─── ANA İÇERİK ─── *@
    <div class="main-wrapper">
        @* ─── ÜST BAR ─── *@
        <header class="top-bar">
            <button class="btn btn-link hamburger d-lg-none" @onclick="ToggleSidebar">
                <i class="bi bi-list"></i>
            </button>
            <div class="top-bar-content">
                <div class="d-flex align-items-center gap-2 ms-auto">
                    @* ─── DURUM DROPDOWN ─── *@
                    <div class="status-dropdown-wrapper">
                        <button class="status-badge @currentStatusCss" @onclick="ToggleStatusDropdown">
                            <i class="bi @currentStatusIcon"></i>
                            <span>@currentStatusText</span>
                            <i class="bi bi-chevron-down status-chevron"></i>
                        </button>
                        @if (statusDropdownOpen)
                        {
                            <div class="status-dropdown-backdrop" @onclick="CloseStatusDropdown"></div>
                            <div class="status-dropdown">
                                @foreach (var status in AgentStatuses.Selectable)
                                {
                                    <button class="status-option @(status.Id == currentStatusId ? "active" : "")"
                                            @onclick="() => ChangeStatus(status.Id)">
                                        <i class="bi @status.Icon status-dot @status.CssClass"></i>
                                        <span>@(StatusDisplayNames.TryGetValue(status.SystemName, out var name) ? name : status.SystemName)</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    @* ─── Ses Ayarları ─── *@
                    <AudioSettings />

                    @* ─── SignalR baglanti durumu ─── *@
                    @if (!HubService.IsConnected)
                    {
                        <span class="connection-indicator" title="Sunucuya baglaniyor...">
                            <i class="bi bi-wifi-off text-warning"></i>
                        </span>
                    }

                    <button class="btn btn-link text-muted btn-logout" title="Cikis Yap" @onclick="HandleLogout">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </div>
            </div>
        </header>

        @* ─── SAYFA İÇERİĞİ ─── *@
        <main class="main-content">
            @Body
        </main>
    </div>

    @* ─── GELEN ARAMA BİLDİRİMİ (Global) ─── *@
    <IncomingCallNotification />

    @* ─── TOAST BİLDİRİMLERİ (Global) ─── *@
    <ToastNotification />
</div>

@code {
    private bool sidebarOpen;
    private bool statusDropdownOpen;
    private int currentStatusId = AgentStatuses.Ids.Offline;

    // Durum adlarini Turkce goster
    private static readonly Dictionary<string, string> StatusDisplayNames = new()
    {
        { "Available", "Musait" },
        { "Busy", "Mesgul" },
        { "OnBreak", "Mola" },
        { "Offline", "Cevrimdisi" },
        { "InCall", "Aramada" },
        { "AfterCallWork", "Arama Sonrasi" }
    };

    private string currentStatusCss => AgentStatuses.GetById(currentStatusId)?.CssClass ?? "offline";
    private string currentStatusIcon => AgentStatuses.GetById(currentStatusId)?.Icon ?? "bi-circle-fill";
    private string currentStatusText
    {
        get
        {
            var item = AgentStatuses.GetById(currentStatusId);
            if (item == null) return "Cevrimdisi";
            return StatusDisplayNames.TryGetValue(item.SystemName, out var name) ? name : item.SystemName;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // MustChangePassword kontrolu — sifre degistirme zorunluysa baska sayfaya erisim yok
            var mustChange = await JS.InvokeAsync<string?>("localStorage.getItem", "must_change_pw");
            if (mustChange == "true")
            {
                NavigationManager.NavigateTo("/change-password", forceLoad: false);
                return;
            }

            // SignalR event'lerini dinle
            HubService.OnAgentStatusChanged += HandleAgentStatusChanged;
            HubService.OnConnectionStateChanged += HandleConnectionStateChanged;

            // Hub'a baglan
            await HubService.ConnectAsync();

            // Baglanti kurulduysa durum Available olur (Hub otomatik yapar)
            if (HubService.IsConnected)
            {
                currentStatusId = AgentStatuses.Ids.Available;
            }

            StateHasChanged();

            // SIP register baslat (arka planda, UI'i bloklamaz)
            _ = InitializeSipAsync();
        }
    }

    private async Task InitializeSipAsync()
    {
        if (SipService.IsRegistered) return;

        try
        {
            var response = await Http.GetAsync("api/sipaccounts/my/connection");
            if (!response.IsSuccessStatusCode) return;

            var sipInfo = await response.Content.ReadFromJsonAsync<SipConnectionInfoDto>();
            if (sipInfo == null) return;

            await SipService.InitializeAsync(
                sipInfo.WsUri,
                sipInfo.SipUri,
                sipInfo.AuthUsername,
                sipInfo.AuthPassword,
                sipInfo.DisplayName,
                sipInfo.StunServer,
                sipInfo.TurnServer,
                sipInfo.TurnUsername,
                sipInfo.TurnPassword);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] SIP init hatasi: {ex.Message}");
        }
    }

    private void HandleAgentStatusChanged(Shared.DTOs.AgentStatusUpdate update)
    {
        // Kendi durumumu guncelleyen mesajsa UI'i guncelle
        // (AgentId kontrolu icin me endpoint'e bakmamiz lazim, simdilik tum guncellemeyi al)
        InvokeAsync(StateHasChanged);
    }

    private void HandleConnectionStateChanged(Microsoft.AspNetCore.SignalR.Client.HubConnectionState state)
    {
        if (state == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected)
        {
            currentStatusId = AgentStatuses.Ids.Available;
        }
        else if (state == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Disconnected)
        {
            currentStatusId = AgentStatuses.Ids.Offline;
        }
        InvokeAsync(StateHasChanged);
    }

    private async Task ChangeStatus(int statusId)
    {
        statusDropdownOpen = false;
        currentStatusId = statusId;
        await HubService.UpdateStatusAsync(statusId);
    }

    private void ToggleStatusDropdown()
    {
        statusDropdownOpen = !statusDropdownOpen;
    }

    private void CloseStatusDropdown()
    {
        statusDropdownOpen = false;
    }

    private void ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
    }

    private void CloseSidebar()
    {
        sidebarOpen = false;
    }

    private async Task HandleLogout()
    {
        await SipService.DisposeAsync();
        await HubService.DisconnectAsync();
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/login", forceLoad: false);
    }

    public async ValueTask DisposeAsync()
    {
        HubService.OnAgentStatusChanged -= HandleAgentStatusChanged;
        HubService.OnConnectionStateChanged -= HandleConnectionStateChanged;
    }
}
