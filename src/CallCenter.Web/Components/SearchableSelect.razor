<div class="ss-wrapper">
    <button type="button" class="ss-trigger form-select form-select-sm @(Disabled ? "disabled" : "")"
            @onclick="Toggle" disabled="@Disabled">
        @if (!string.IsNullOrEmpty(Value) && selectedItem != null)
        {
            <span class="ss-selected-text">@selectedItem.Text</span>
            @if (AllowClear)
            {
                <span class="ss-clear" @onclick="Clear" @onclick:stopPropagation="true">&times;</span>
            }
        }
        else
        {
            <span class="ss-placeholder">@Placeholder</span>
        }
    </button>

    @if (isOpen)
    {
        <div class="ss-overlay" @onclick="Close"></div>
        <div class="ss-dropdown">
            <div class="ss-search">
                <input type="text" class="form-control form-control-sm" placeholder="@SearchPlaceholder"
                       @ref="searchInput" @bind="searchText" @bind:event="oninput" />
            </div>
            <div class="ss-options">
                @{
                    var filtered = GetFilteredItems();
                }
                @if (filtered.Count == 0)
                {
                    <div class="ss-empty">Sonuc bulunamadi</div>
                }
                else
                {
                    @foreach (var item in filtered)
                    {
                        <div class="ss-option @(item.Value == Value ? "selected" : "")"
                             @onclick="() => Select(item)">
                            <span class="ss-option-text">@item.Text</span>
                            @if (!string.IsNullOrEmpty(item.Subtitle))
                            {
                                <span class="ss-subtitle">@item.Subtitle</span>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public List<SearchSelectItem> Items { get; set; } = new();
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "-- Seciniz --";
    [Parameter] public string SearchPlaceholder { get; set; } = "Ara...";
    [Parameter] public bool AllowClear { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }

    private bool isOpen;
    private string searchText = "";
    private ElementReference searchInput;

    private SearchSelectItem? selectedItem =>
        !string.IsNullOrEmpty(Value) ? Items?.FirstOrDefault(i => i.Value == Value) : null;

    private void Toggle()
    {
        if (Disabled) return;
        isOpen = !isOpen;
        if (isOpen)
        {
            searchText = "";
        }
    }

    private void Close()
    {
        isOpen = false;
    }

    private async Task Select(SearchSelectItem item)
    {
        isOpen = false;
        await ValueChanged.InvokeAsync(item.Value);
    }

    private async Task Clear()
    {
        await ValueChanged.InvokeAsync(null);
    }

    private List<SearchSelectItem> GetFilteredItems()
    {
        if (Items == null) return new();
        if (string.IsNullOrWhiteSpace(searchText)) return Items;

        var term = searchText.Trim();
        return Items.Where(i =>
            i.Text.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            (i.Subtitle != null && i.Subtitle.Contains(term, StringComparison.OrdinalIgnoreCase))
        ).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isOpen)
        {
            try { await searchInput.FocusAsync(); } catch { }
        }
    }

    public record SearchSelectItem(string Value, string Text, string? Subtitle = null);
}
