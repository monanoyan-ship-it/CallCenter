@inject IJSRuntime JS
@inject HttpClient Http
@implements IAsyncDisposable

<div class="audio-player p-2 bg-light rounded">
    @if (isLoading)
    {
        <div class="d-flex align-items-center gap-2 w-100 justify-content-center py-2">
            <div class="spinner-border spinner-border-sm text-primary" role="status">
                <span class="visually-hidden">Yukleniyor...</span>
            </div>
            <span class="text-muted small">Ses kaydi yukleniyor...</span>
        </div>
    }
    else if (loadError)
    {
        <div class="text-danger small w-100 text-center py-2">
            <i class="bi bi-exclamation-triangle me-1"></i>Ses kaydi yuklenemedi
        </div>
    }
    else
    {
        <div id="@containerId" class="mb-2" style="min-height:64px;"></div>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm @(isPlaying ? "btn-warning" : "btn-success")" @onclick="TogglePlayPause" title="@(isPlaying ? "Duraklat" : "Oynat")">
                <i class="bi @(isPlaying ? "bi-pause-fill" : "bi-play-fill")"></i>
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="Stop" title="Durdur" disabled="@(!hasStarted)">
                <i class="bi bi-stop-fill"></i>
            </button>

            <span class="text-muted small text-nowrap">@FormatTime(currentTime) / @FormatTime(duration)</span>

            <div class="d-flex align-items-center gap-1 ms-auto" style="min-width:80px;">
                <i class="bi bi-volume-up small"></i>
                <input type="range" class="form-range" min="0" max="1" step="0.05"
                       value="@volume" @onchange="OnVolumeChange" style="width:60px;height:16px;" />
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid CallUid { get; set; }
    [Parameter] public EventCallback OnPlaybackEnded { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string containerId = "";
    private bool isLoading = true;
    private bool loadError;
    private bool isPlaying;
    private bool hasStarted;
    private bool disposed;
    private double currentTime;
    private double duration;
    private double volume = 0.8;
    private Timer? pollTimer;
    private DotNetObjectReference<AudioPlayer>? dotnetRef;

    protected override void OnInitialized()
    {
        containerId = $"waveform_{CallUid:N}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var token = await JS.InvokeAsync<string?>("localStorage.getItem", "auth_token");
            if (string.IsNullOrEmpty(token)) { loadError = true; isLoading = false; StateHasChanged(); return; }

            var apiBaseUrl = Http.BaseAddress?.ToString().TrimEnd('/');
            var streamUrl = $"{apiBaseUrl}/api/recordings/{CallUid}/stream";

            var success = await JS.InvokeAsync<bool>("audioPlayer.create", containerId, streamUrl, token);
            if (!success) { loadError = true; isLoading = false; StateHasChanged(); return; }

            await JS.InvokeVoidAsync("audioPlayer.setVolume", containerId, volume);

            dotnetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("audioPlayer.onFinish", containerId, dotnetRef);

            isLoading = false;
            hasStarted = true;
            StateHasChanged();

            pollTimer = new Timer(async _ =>
            {
                if (disposed) return;
                try
                {
                    var state = await JS.InvokeAsync<AudioState>("audioPlayer.getState", containerId);
                    currentTime = state.CurrentTime;
                    duration = state.Duration;
                    isPlaying = state.Playing;
                    if (!disposed) await InvokeAsync(StateHasChanged);
                }
                catch { /* component disposed */ }
            }, null, 300, 250);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AudioPlayer] Error: {ex.Message}");
            loadError = true;
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task TogglePlayPause()
    {
        await JS.InvokeVoidAsync("audioPlayer.playPause", containerId);
        isPlaying = !isPlaying;
        hasStarted = true;
    }

    private async Task Stop()
    {
        await JS.InvokeVoidAsync("audioPlayer.stop", containerId);
        isPlaying = false;
        currentTime = 0;
    }

    private async Task OnVolumeChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var vol))
        {
            await JS.InvokeVoidAsync("audioPlayer.setVolume", containerId, vol);
            volume = vol;
        }
    }

    [JSInvokable]
    public async Task OnWaveSurferFinished()
    {
        isPlaying = false;
        hasStarted = false;
        try
        {
            await Http.PostAsync($"api/recordings/{CallUid}/stream-ended", null);
        }
        catch { /* best effort */ }
        await OnPlaybackEnded.InvokeAsync();
        if (!disposed) await InvokeAsync(StateHasChanged);
    }

    private static string FormatTime(double seconds)
    {
        if (seconds <= 0 || double.IsNaN(seconds)) return "00:00";
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.Hours > 0 ? ts.ToString(@"hh\:mm\:ss") : ts.ToString(@"mm\:ss");
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        pollTimer?.Dispose();
        pollTimer = null;
        try
        {
            await JS.InvokeVoidAsync("audioPlayer.destroy", containerId);
        }
        catch { /* page unloading */ }
        dotnetRef?.Dispose();
    }

    private class AudioState
    {
        public bool Playing { get; set; }
        public double CurrentTime { get; set; }
        public double Duration { get; set; }
        public bool Ended { get; set; }
    }
}
