@* Silme onay modali — Bootstrap modal *@

@if (isVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>@Title
                    </h5>
                    <button type="button" class="btn-close" @onclick="Cancel"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">@Message</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Cancel">Iptal</button>
                    <button type="button" class="btn btn-danger" @onclick="Confirm">
                        <i class="bi bi-trash me-1"></i>@ConfirmText
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Title { get; set; } = "Silme Onayi";
    [Parameter] public string Message { get; set; } = "Bu kaydi silmek istediginize emin misiniz?";
    [Parameter] public string ConfirmText { get; set; } = "Sil";
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool isVisible;

    public void Show()
    {
        isVisible = true;
        StateHasChanged();
    }

    public void Hide()
    {
        isVisible = false;
        StateHasChanged();
    }

    private async Task Confirm()
    {
        isVisible = false;
        await OnConfirm.InvokeAsync();
    }

    private async Task Cancel()
    {
        isVisible = false;
        await OnCancel.InvokeAsync();
    }
}
