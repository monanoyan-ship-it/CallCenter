<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>CallCenter.Windows</RootNamespace>

    <!-- Markalama -->
    <AssemblyName>CorpLynk</AssemblyName>
    <Product>CorpLynk</Product>
    <AssemblyTitle>CorpLynk Call Center</AssemblyTitle>
    <Company>CorpLynk</Company>
    <Authors>CorpLynk</Authors>
    <Description>CorpLynk Call Center - Profesyonel cagri merkezi uygulamasi</Description>
    <Copyright>Copyright (c) CorpLynk 2025-2026</Copyright>

    <!-- Versiyon -->
    <Version>0.4.4.0</Version>
    <FileVersion>0.4.4.0</FileVersion>
    <InformationalVersion>0.4.4</InformationalVersion>

    <!-- Ikon -->
    <ApplicationIcon>Assets\corplynk.ico</ApplicationIcon>

    <!-- Release publish: PDB dahil etme -->
    <DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.41" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
    <PackageReference Include="SIPSorcery" Version="10.0.3" />
    <PackageReference Include="SIPSorceryMedia.Windows" Version="8.0.14" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.18.7" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.73.0.4068" />
    <PackageReference Include="Microsoft.Graph" Version="5.105.0" />
    <PackageReference Include="Microsoft.Kiota.Abstractions" Version="2.0.0" />
    <PackageReference Include="Azure.Identity" Version="1.18.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CallCenter.Shared\CallCenter.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\appsettings.Development.json" Condition="'$(Configuration)'=='Debug'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Post-publish: ico kopyala, scoped CSS birlestir, gereksiz dosyalari temizle -->
  <Target Name="PostPublishCleanup" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Assets\corplynk.ico"
          DestinationFolder="$(PublishDir)\Assets"
          SkipUnchangedFiles="true" />
    <!-- .NET 10 BlazorWebView bug: scoped CSS dosyasi serve edilmiyor (dotnet/maui#33718).
         Workaround: CorpLynk.styles.css icerigini app.css'e birlestir. -->
    <Exec Command="type &quot;$(PublishDir)wwwroot\CorpLynk.styles.css&quot; >> &quot;$(PublishDir)wwwroot\css\app.css&quot;"
          Condition="Exists('$(PublishDir)wwwroot\CorpLynk.styles.css')" />
    <Delete Files="$(PublishDir)\wwwroot\appsettings.Development.json" Condition="Exists('$(PublishDir)\wwwroot\appsettings.Development.json')" />
    <Delete Files="$(PublishDir)\CorpLynk.staticwebassets.endpoints.json" Condition="Exists('$(PublishDir)\CorpLynk.staticwebassets.endpoints.json')" />
  </Target>

</Project>
