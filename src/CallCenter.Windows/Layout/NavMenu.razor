@* Sol Panel - CorpLynk Menu *@
@inject NavigationManager NavigationManager
@inject WindowsAuthService AuthService
@inject WindowsPermissionService PermService
@inject AuthenticationStateProvider AuthStateProvider
@using CallCenter.Shared.Enums
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable

<div class="sidebar-header">
    <div class="d-flex align-items-center justify-content-between px-3 py-2">
        <a class="brand" href="">
            <i class="bi bi-headset me-2"></i>
            <span class="brand-text">CorpLynk</span>
        </a>
    </div>
</div>

<div class="sidebar-body">
    <nav>
        @* ─── ANA SAYFA ─── *@
        <div class="nav-item">
            <NavLink class="nav-link" href="dialer" Match="NavLinkMatch.All">
                <i class="bi bi-telephone-fill"></i>
                <span>Cagri Takip</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="calls/history">
                <i class="bi bi-clock-history"></i>
                <span>Arama Gecmisi</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="contacts">
                <i class="bi bi-person-vcard-fill"></i>
                <span>Rehber</span>
            </NavLink>
        </div>
    </nav>
</div>

@* ─── SIDEBAR FOOTER: Agent Durumu ─── *@
<div class="sidebar-footer">
    <div class="agent-status">
        <div class="d-flex align-items-center">
            <div class="agent-avatar">
                <i class="bi bi-person-circle"></i>
            </div>
            <div class="agent-info">
                <span class="agent-name">@fullName</span>
                <span class="agent-role">@roleName</span>
            </div>
        </div>
    </div>
</div>

@code {
    private string fullName = "...";
    private string roleName = "";

    protected override void OnInitialized()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await RefreshUserInfo();
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        await RefreshUserInfo();
    }

    private async Task RefreshUserInfo()
    {
        fullName = await AuthService.GetFullNameAsync() ?? "Kullanici";

        await PermService.LoadAsync();
        var role = CustomerRoles.GetById(PermService.CustomerRoleId);
        roleName = role?.Description ?? "Operator";

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }
}
