@inherits LayoutComponentBase
@inject WindowsAuthService AuthService
@inject WindowsHubService HubService
@inject WindowsPermissionService PermService
@inject CallCenter.Windows.Services.ISipService SipService
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject SecureStorage Storage
@inject UpdateService UpdateSvc
@inject AuthenticationStateProvider AuthStateProvider
@inject WindowsSessionEvents SessionEvents
@inject ToastService Toast
@inject BackgroundSyncService BackgroundSync
@inject RecordingUploadService RecordingUpload
@implements IAsyncDisposable
@using CallCenter.Shared.Enums
@using CallCenter.Shared.DTOs
@using Microsoft.AspNetCore.Components.Authorization

<div class="app-layout no-sidebar">
    @* ─── ANA ICERIK ─── *@
    <div class="main-wrapper">
        @* ─── UST BAR ─── *@
        <header class="top-bar">
            <div class="top-bar-content">
                <div class="d-flex align-items-center gap-2">
                    <span class="brand-mini">
                        <i class="bi bi-headset text-primary me-1"></i>
                        <strong>CorpLynk</strong>
                    </span>
                    <span class="agent-info-bar text-muted small">
                        <i class="bi bi-person-circle me-1"></i>@agentName
                        <span class="badge bg-light text-dark ms-1" style="font-size:0.65rem;">@agentRole</span>
                    </span>
                </div>
                <div class="d-flex align-items-center gap-2 ms-auto">
                    @* ─── DURUM DROPDOWN ─── *@
                    <div class="status-dropdown-wrapper">
                        <button class="status-badge @currentStatusCss" @onclick="ToggleStatusDropdown">
                            <i class="bi @currentStatusIcon"></i>
                            <span>@currentStatusText</span>
                            <i class="bi bi-chevron-down status-chevron"></i>
                        </button>
                        @if (statusDropdownOpen)
                        {
                            <div class="status-dropdown-backdrop" @onclick="CloseStatusDropdown"></div>
                            <div class="status-dropdown">
                                @foreach (var status in AgentStatuses.Selectable)
                                {
                                    <button class="status-option @(status.Id == currentStatusId ? "active" : "")"
                                            @onclick="() => ChangeStatus(status.Id)">
                                        <i class="bi @status.Icon status-dot @status.CssClass"></i>
                                        <span>@(StatusDisplayNames.TryGetValue(status.SystemName, out var name) ? name : status.SystemName)</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    @* ─── SignalR baglanti durumu ─── *@
                    @if (!HubService.IsConnected)
                    {
                        <span class="connection-indicator" title="Sunucuya baglaniyor...">
                            <i class="bi bi-wifi-off text-warning"></i>
                        </span>
                    }

                    @* ─── SES CIHAZI AYARLARI ─── *@
                    <AudioSettings />

                    <button class="btn btn-link text-muted btn-logout" title="Cikis Yap" @onclick="HandleLogout" disabled="@isEndingSession">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </div>
            </div>
        </header>

        @* ─── GUVENLIK UYARISI (eszamanli giris denemesi) ─── *@
        @if (!string.IsNullOrEmpty(_securityAlert))
        {
            <div class="alert alert-danger alert-dismissible mb-0 rounded-0 py-2 px-3 d-flex align-items-center"
                 style="border-left:4px solid #b02a37;">
                <i class="bi bi-shield-lock-fill me-2" style="font-size:1.2rem;"></i>
                <span class="flex-grow-1 fw-medium">@_securityAlert</span>
                <button type="button" class="btn-close" @onclick="() => _securityAlert = null"></button>
            </div>
        }

        @* ─── GUNCELLEME BILDIRIMI ─── *@
        @if (updateInfo != null)
        {
            <div class="update-banner alert alert-info alert-dismissible mb-0 rounded-0 py-2 px-3 d-flex align-items-center">
                <i class="bi bi-arrow-repeat me-2"></i>
                <span class="flex-grow-1">
                    Yeni versiyon mevcut: <strong>v@(updateInfo.LatestVersion)</strong>
                    @if (!string.IsNullOrEmpty(updateInfo.ReleaseNotes))
                    {
                        <small class="text-muted ms-2">— @updateInfo.ReleaseNotes</small>
                    }
                </span>
                @if (isDownloading)
                {
                    <div class="d-flex align-items-center gap-2 me-2">
                        <div class="progress" style="width:120px;height:6px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated"
                                 style="width:@(downloadProgress)%"></div>
                        </div>
                        <small>@(downloadProgress)%</small>
                    </div>
                }
                else if (downloadedPath != null)
                {
                    <button class="btn btn-success btn-sm me-2" @onclick="LaunchUpdate">
                        <i class="bi bi-play-fill me-1"></i>Kur
                    </button>
                }
                else
                {
                    <button class="btn btn-primary btn-sm me-2" @onclick="StartDownload">
                        <i class="bi bi-download me-1"></i>Guncelle
                    </button>
                }
                @if (!updateInfo.IsMandatory)
                {
                    <button type="button" class="btn-close btn-close-sm" @onclick="DismissUpdate"></button>
                }
            </div>
        }

        @* ─── SAYFA ICERIGI ─── *@
        <main class="main-content">
            @Body
        </main>
    </div>

    @* ─── GELEN ARAMA BILDIRIMI (Global) ─── *@
    <IncomingCallNotification />

    @* ─── TOAST BILDIRIMLERI (Global) ─── *@
    <ToastNotification />
</div>

@code {
    private bool statusDropdownOpen;
    private int currentStatusId = AgentStatuses.Ids.Offline;
    private string agentName = "...";
    private string agentRole = "";

    // ─── GUNCELLEME ───
    private AppVersionInfoDto? updateInfo;
    private bool isDownloading;
    private int downloadProgress;
    private string? downloadedPath;
    private bool isEndingSession;

    // Durum adlarini Turkce goster
    private static readonly Dictionary<string, string> StatusDisplayNames = new()
    {
        { "Available", "Musait" },
        { "Busy", "Mesgul" },
        { "OnBreak", "Mola" },
        { "Offline", "Cevrimdisi" },
        { "InCall", "Aramada" },
        { "AfterCallWork", "Arama Sonrasi" }
    };

    private string currentStatusCss => AgentStatuses.GetById(currentStatusId)?.CssClass ?? "offline";
    private string currentStatusIcon => AgentStatuses.GetById(currentStatusId)?.Icon ?? "bi-circle-fill";
    private string currentStatusText
    {
        get
        {
            var item = AgentStatuses.GetById(currentStatusId);
            if (item == null) return "Cevrimdisi";
            return StatusDisplayNames.TryGetValue(item.SystemName, out var name) ? name : item.SystemName;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // MustChangePassword kontrolu — sifre degistirme zorunluysa baska sayfaya erisim yok
            var mustChange = await Storage.GetAsync("must_change_pw");
            if (mustChange == "true")
            {
                NavigationManager.NavigateTo("/change-password", forceLoad: false);
                return;
            }

            // Agent bilgilerini yukle
            agentName = await AuthService.GetFullNameAsync() ?? "Kullanici";
            await PermService.LoadAsync();
            var role = CustomerRoles.GetById(PermService.CustomerRoleId);
            agentRole = role?.Description ?? "Operator";

            // SignalR event'lerini dinle
            HubService.OnAgentStatusChanged += HandleAgentStatusChanged;
            HubService.OnConnectionStateChanged += HandleConnectionStateChanged;
            HubService.OnConcurrentLoginBlocked += HandleConcurrentLoginBlocked;
            HubService.OnForceLogout += HandleForceLogout;
            SessionEvents.SessionInvalidated += HandleSessionInvalidated;

            // Guncelleme event'lerini dinle
            UpdateSvc.UpdateAvailable += OnUpdateAvailable;
            UpdateSvc.DownloadProgressChanged += OnDownloadProgress;
            UpdateSvc.DownloadCompleted += OnDownloadCompleted;

            // Hub'a baglan
            await HubService.ConnectAsync();

            // Baglanti kurulduysa durum Available olur (Hub otomatik yapar)
            if (HubService.IsConnected)
            {
                currentStatusId = AgentStatuses.Ids.Available;
            }

            // Guncelleme kontrolu (arka planda)
            _ = UpdateSvc.CheckForUpdateAsync();

            StateHasChanged();
        }
    }

    private void HandleAgentStatusChanged(AgentStatusUpdate update)
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleConnectionStateChanged(Microsoft.AspNetCore.SignalR.Client.HubConnectionState state)
    {
        if (state == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected)
        {
            currentStatusId = AgentStatuses.Ids.Available;
        }
        else if (state == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Disconnected)
        {
            currentStatusId = AgentStatuses.Ids.Offline;
        }
        InvokeAsync(StateHasChanged);
    }

    private async Task ChangeStatus(int statusId)
    {
        statusDropdownOpen = false;
        currentStatusId = statusId;
        await HubService.UpdateStatusAsync(statusId);
    }

    private void ToggleStatusDropdown()
    {
        statusDropdownOpen = !statusDropdownOpen;
    }

    private void CloseStatusDropdown()
    {
        statusDropdownOpen = false;
    }

    private async Task HandleForceLogout()
    {
        await EndAuthenticatedSessionAsync("Bu kullanici baska bir cihazda oturum acti.", revokeServerToken: false);
    }

    private string? _securityAlert;

    private void HandleConcurrentLoginBlocked(string message)
    {
        var text = string.IsNullOrWhiteSpace(message)
            ? "Guvenlik uyarisi: Birisi sifrenizle hesabiniza giris yapmaya calisti. Aktif gorusmeniz korundu."
            : message;

        // Hem belirgin sticky banner hem de toast — gorusmedeyken kacirilmasin.
        _securityAlert = text;
        Toast.ShowWarning(text);
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogout()
    {
        await EndAuthenticatedSessionAsync("Cikis yapildi.", revokeServerToken: true);
    }

    private Task HandleSessionInvalidated(string reason)
    {
        return EndAuthenticatedSessionAsync(reason, revokeServerToken: false);
    }

    private async Task EndAuthenticatedSessionAsync(string reason, bool revokeServerToken)
    {
        if (isEndingSession)
            return;

        isEndingSession = true;

        try
        {
            if (!await EnsureRecordingWorkSafeBeforeSessionEndAsync(revokeServerToken))
            {
                isEndingSession = false;
                return;
            }

            try { await Http.PostAsync("api/sipaccounts/my/release", null); }
            catch { /* best effort */ }

            try { await SipService.DisposeAsync(); }
            catch { /* best effort */ }

            try { await HubService.DisconnectAsync(); }
            catch { /* best effort */ }

            if (revokeServerToken)
                await AuthService.LogoutAsync();
            else
                await AuthService.ForceLogoutAsync();

            if (!revokeServerToken && !string.IsNullOrWhiteSpace(reason))
                Toast.ShowWarning(reason);

            await InvokeAsync(() => NavigationManager.NavigateTo("/login", forceLoad: true));
        }
        finally
        {
            isEndingSession = false;
        }
    }

    private async Task<bool> EnsureRecordingWorkSafeBeforeSessionEndAsync(bool userRequestedLogout)
    {
        if (SipService.IsInCall || SipService.IsRecording)
        {
            Toast.ShowWarning("Aktif gorusme veya ses kaydi tamamlanmadan cikis yapilamaz.");
            return false;
        }

        try
        {
            if (!await RecordingUpload.HasAnyPendingRequiredUploadsAsync())
                return true;

            Toast.ShowInfo("Bekleyen ses kaydi uploadlari tamamlanmadan cikis yapilmayacak. Lutfen bekleyin.");

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(60));
            await BackgroundSync.FlushOnceAsync(cts.Token);

            if (!await RecordingUpload.HasAnyPendingRequiredUploadsAsync())
                return true;

            Toast.ShowWarning(userRequestedLogout
                ? "Bekleyen ses kaydi uploadlari var. Kayitlar kaybolmasin diye cikis yapilmadi."
                : "Baska oturum girisi geldi ancak bekleyen ses kaydi uploadlari var. Kayitlar tamamlanana kadar bu oturum kapatilmadi.");
            return false;
        }
        catch (OperationCanceledException)
        {
            Toast.ShowWarning("Ses kaydi upload kontrolu zaman asimina ugradi. Kayitlar kaybolmasin diye cikis yapilmadi.");
            return false;
        }
        catch
        {
            Toast.ShowWarning("Ses kaydi upload kontrolu tamamlanamadi. Kayitlar kaybolmasin diye cikis yapilmadi.");
            return false;
        }
    }

    // ═══ GUNCELLEME ═══

    private void OnUpdateAvailable(AppVersionInfoDto info)
    {
        updateInfo = info;
        InvokeAsync(StateHasChanged);
    }

    private void OnDownloadProgress(int progress)
    {
        downloadProgress = progress;
        InvokeAsync(StateHasChanged);
    }

    private void OnDownloadCompleted()
    {
        isDownloading = false;
        InvokeAsync(StateHasChanged);
    }

    private async Task StartDownload()
    {
        isDownloading = true;
        downloadProgress = 0;
        downloadedPath = await UpdateSvc.DownloadUpdateAsync();
    }

    private async Task LaunchUpdate()
    {
        if (downloadedPath != null)
        {
            if (!await EnsureRecordingWorkSafeBeforeSessionEndAsync(userRequestedLogout: true))
                return;

            UpdateSvc.LaunchInstaller(downloadedPath);
            // Uygulama kapanacak, installer baslatildi
        }
    }

    private void DismissUpdate()
    {
        updateInfo = null;
    }

    public async ValueTask DisposeAsync()
    {
        HubService.OnAgentStatusChanged -= HandleAgentStatusChanged;
        HubService.OnConnectionStateChanged -= HandleConnectionStateChanged;
        HubService.OnConcurrentLoginBlocked -= HandleConcurrentLoginBlocked;
        HubService.OnForceLogout -= HandleForceLogout;
        SessionEvents.SessionInvalidated -= HandleSessionInvalidated;
        UpdateSvc.UpdateAvailable -= OnUpdateAvailable;
        UpdateSvc.DownloadProgressChanged -= OnDownloadProgress;
        UpdateSvc.DownloadCompleted -= OnDownloadCompleted;
    }
}
