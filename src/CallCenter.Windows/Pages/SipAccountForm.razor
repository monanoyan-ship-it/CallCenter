@inject ILocalRepository LocalRepo
@inject ToastService Toast
@inject HttpClient HttpClient
@inject CallCenter.Windows.Services.WindowsPermissionService PermService
@using CallCenter.Windows.LocalData.Entities
@using CallCenter.Windows.LocalData
@using CallCenter.Shared.DTOs

@if (isVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi @(isEditMode ? "bi-pencil" : "bi-router") me-2"></i>
                        @(isEditMode ? "Gateway Duzenle" : "Yeni Gateway")
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger py-2 small">@errorMessage</div>
                        }

                        @if (showDeleteConfirm)
                        {
                            <div class="alert alert-warning py-3 small">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                <strong>'@model.Name'</strong> gateway'i silmek istediginize emin misiniz?
                                <div class="mt-3">
                                    <button type="button" class="btn btn-sm btn-secondary me-2" @onclick="() => showDeleteConfirm = false">Vazgec</button>
                                    <button type="button" class="btn btn-sm btn-danger" @onclick="ConfirmDelete" disabled="@isSaving">Evet, Sil</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label class="form-label small">Gateway Adi</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="model.Name" placeholder="Ornek: Ofis Gateway" />
                                    <ValidationMessage For="@(() => model.Name)" />
                                </div>
                            </div>

                            <hr class="my-3" />
                            <h6 class="small text-muted mb-3"><i class="bi bi-hdd-network me-1"></i>Sunucu Bilgileri</h6>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small">Sunucu Adresi</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="model.Server" placeholder="sip.example.com" />
                                    <ValidationMessage For="@(() => model.Server)" />
                                </div>
                            <div class="col-md-3">
                                <label class="form-label small">Port</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="model.Port" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Transport</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="model.Transport">
                                    <option value="UDP">UDP</option>
                                    <option value="TCP">TCP</option>
                                    <option value="TLS">TLS</option>
                                    <option value="WSS">WSS</option>
                                </InputSelect>
                            </div>
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                <label class="form-label small">Domain (Opsiyonel)</label>
                                <InputText class="form-control form-control-sm" @bind-Value="model.Domain" placeholder="" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">WebSocket URI</label>
                                <InputText class="form-control form-control-sm" @bind-Value="model.WsUri" placeholder="wss://sip.example.com:8089/ws" />
                                <div class="form-text small">Bos birakilirsa: wss://sunucu:8089/ws</div>
                            </div>
                        </div>

                        <hr class="my-3" />
                        <h6 class="small text-muted mb-3"><i class="bi bi-shield-lock me-1"></i>Guvenlik</h6>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="model.UseSrtp" id="useSrtp" />
                                    <label class="form-check-label small" for="useSrtp">SRTP (Sifrelenmis Ses)</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="model.IsActive" id="isActive" />
                                    <label class="form-check-label small" for="isActive">Aktif</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="model.IsDefault" id="isDefault" />
                                    <label class="form-check-label small" for="isDefault">Varsayilan</label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-3" />
                        <h6 class="small text-muted mb-3"><i class="bi bi-globe me-1"></i>NAT/STUN (Opsiyonel)</h6>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small">STUN Sunucusu</label>
                                <InputText class="form-control form-control-sm" @bind-Value="model.StunServer" placeholder="stun.l.google.com:19302" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">TURN Sunucusu</label>
                                <InputText class="form-control form-control-sm" @bind-Value="model.TurnServer" placeholder="turn.example.com:3478" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">TURN Kullanici Adi</label>
                                <InputText class="form-control form-control-sm" @bind-Value="model.TurnUsername" placeholder="" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">TURN Sifresi</label>
                                <InputText type="password" class="form-control form-control-sm" @bind-Value="model.TurnPassword" />
                            </div>
                        </div>

                        <hr class="my-3" />
                        <h6 class="small text-muted mb-3"><i class="bi bi-telephone me-1"></i>Hatlar (SIP Lines)</h6>

                        @if (!isEditMode)
                        {
                            @* Yeni gateway olusturulurken hat ekleme *@
                            @if (createLines.Count == 0)
                            {
                                <div class="text-center text-muted py-3 border rounded">
                                    <small>Henuz hat eklenmedi. Gateway olusturulduktan sonra da hat ekleyebilirsiniz.</small>
                                </div>
                            }
                            else
                            {
                                @foreach (var (line, idx) in createLines.Select((l, i) => (l, i)))
                                {
                                    <div class="border rounded p-2 mb-2">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <small class="fw-medium">Hat @(idx + 1)</small>
                                            <button type="button" class="btn btn-outline-danger btn-sm py-0 px-1" @onclick="() => RemoveCreateLine(idx)">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                        <div class="row g-2">
                                            <div class="col-md-2">
                                                <label class="form-label small">Kanal</label>
                                                <input type="number" class="form-control form-control-sm" value="@line.ChannelNumber"
                                                       @onchange="(e) => line.ChannelNumber = int.TryParse(e.Value?.ToString(), out var v) ? v : line.ChannelNumber" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small">Kullanici Adi</label>
                                                <input type="text" class="form-control form-control-sm" value="@line.Username"
                                                       @onchange="(e) => line.Username = e.Value?.ToString() ?? string.Empty" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small">Sifre</label>
                                                <input type="password" class="form-control form-control-sm" value="@line.Password"
                                                       @onchange="(e) => line.Password = e.Value?.ToString() ?? string.Empty" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small">Aciklama</label>
                                                <input type="text" class="form-control form-control-sm" value="@line.Description"
                                                       @onchange="(e) => line.Description = e.Value?.ToString()" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            <button type="button" class="btn btn-outline-primary btn-sm mt-1" @onclick="AddCreateLine">
                                <i class="bi bi-plus-lg me-1"></i>Hat Ekle
                            </button>
                        }
                        else
                        {
                            @* Duzenle modunda hatlar ayri API ile yonetilir *@
                            @if (isLoadingLines)
                            {
                                <div class="text-center py-3">
                                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                    <small class="ms-2 text-muted">Hatlar yukleniyor...</small>
                                </div>
                            }
                            else
                            {
                                @if (editLines.Count == 0)
                                {
                                    <div class="text-center text-muted py-3 border rounded">
                                        <small>Bu gateway'e ait hat bulunamadi.</small>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var line in editLines)
                                    {
                                        <div class="border rounded p-2 mb-2">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <small class="fw-medium">Kanal @line.ChannelNumber — @line.Username</small>
                                                <div>
                                                    <span class="badge @(line.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") me-1">
                                                        @(line.IsActive ? "Aktif" : "Pasif")
                                                    </span>
                                                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-1" @onclick="() => DeleteLineAsync(line.Id)" disabled="@isSavingLine">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrEmpty(line.Description))
                                            {
                                                <small class="text-muted">@line.Description</small>
                                            }
                                            @if (!string.IsNullOrEmpty(line.AssignedPersonnelName))
                                            {
                                                <small class="text-muted d-block">Atanan: @line.AssignedPersonnelName</small>
                                            }
                                        </div>
                                    }
                                }

                                @* Yeni hat ekleme formu *@
                                @if (showAddLineForm)
                                {
                                    <div class="border border-primary rounded p-2 mb-2">
                                        <div class="row g-2">
                                            <div class="col-md-2">
                                                <label class="form-label small">Kanal</label>
                                                <input type="number" class="form-control form-control-sm" @bind="newLine.ChannelNumber" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small">Kullanici Adi</label>
                                                <input type="text" class="form-control form-control-sm" @bind="newLine.Username" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small">Sifre</label>
                                                <input type="password" class="form-control form-control-sm" @bind="newLine.Password" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small">Aciklama</label>
                                                <input type="text" class="form-control form-control-sm" @bind="newLine.Description" />
                                            </div>
                                        </div>
                                        <div class="mt-2">
                                            <button type="button" class="btn btn-primary btn-sm" @onclick="AddLineToGatewayAsync" disabled="@isSavingLine">
                                                <i class="bi bi-check-lg me-1"></i>Kaydet
                                            </button>
                                            <button type="button" class="btn btn-secondary btn-sm ms-1" @onclick="() => showAddLineForm = false">Vazgec</button>
                                        </div>
                                    </div>
                                }

                                <button type="button" class="btn btn-outline-primary btn-sm mt-1" @onclick="ShowAddLineForm">
                                    <i class="bi bi-plus-lg me-1"></i>Hat Ekle
                                </button>
                            }
                        }

                        <hr class="my-3" />
                        <h6 class="small text-muted mb-3"><i class="bi bi-soundwave me-1"></i>Codec Tercihleri (Opsiyonel)</h6>

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label small">Codec Oncelik Sirasi</label>
                                <div class="d-flex gap-3 flex-wrap">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="codecOpus" checked="@IsCodecSelected(CodecOpus)" @onchange="ToggleOpus" />
                                        <label class="form-check-label small" for="codecOpus">Opus</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="codecG722" checked="@IsCodecSelected(CodecG722)" @onchange="ToggleG722" />
                                        <label class="form-check-label small" for="codecG722">G.722</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="codecPcmu" checked="@IsCodecSelected(CodecPcmu)" @onchange="TogglePcmu" />
                                        <label class="form-check-label small" for="codecPcmu">PCMU (G.711u)</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="codecPcma" checked="@IsCodecSelected(CodecPcma)" @onchange="TogglePcma" />
                                        <label class="form-check-label small" for="codecPcma">PCMA (G.711a)</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Jitter Buffer Min (ms)</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="model.JitterBufferMinMs" />
                                <div class="form-text small">0 = varsayilan</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Jitter Buffer Max (ms)</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="model.JitterBufferMaxMs" />
                                <div class="form-text small">0 = varsayilan</div>
                            </div>
                        </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="Close">Iptal</button>
                        @if (isEditMode)
                        {
                            <button type="button" class="btn btn-danger btn-sm" @onclick="ShowDeleteConfirm">
                                <i class="bi bi-trash me-1"></i>Sil
                            </button>
                        }
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-check-lg me-1"></i>Kaydet
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback<LocalSipAccount> OnDelete { get; set; }

    private bool isVisible;
    private bool isEditMode;
    private bool isSaving;
    private string? errorMessage;
    private int? editingBackendId;
    private bool showDeleteConfirm;

    // Hat yonetimi
    private List<SipLineCreateDto> createLines = new();
    private List<SipLineListDto> editLines = new();
    private SipLineCreateDto newLine = new();
    private bool isLoadingLines;
    private bool isSavingLine;
    private bool showAddLineForm;

    private SipAccountFormModel model = new();
    private List<string> selectedCodecs = new();

    private const string CodecOpus = "opus";
    private const string CodecG722 = "g722";
    private const string CodecPcmu = "pcmu";
    private const string CodecPcma = "pcma";

    private void ToggleOpus(ChangeEventArgs e) => ToggleCodec(CodecOpus, (bool)e.Value!);
    private void ToggleG722(ChangeEventArgs e) => ToggleCodec(CodecG722, (bool)e.Value!);
    private void TogglePcmu(ChangeEventArgs e) => ToggleCodec(CodecPcmu, (bool)e.Value!);
    private void TogglePcma(ChangeEventArgs e) => ToggleCodec(CodecPcma, (bool)e.Value!);

    private bool IsCodecSelected(string codec) => selectedCodecs.Contains(codec);

    private void ToggleCodec(string codec, bool selected)
    {
        if (selected && !selectedCodecs.Contains(codec))
            selectedCodecs.Add(codec);
        else if (!selected)
            selectedCodecs.Remove(codec);

        model.PreferredCodecs = selectedCodecs.Count > 0
            ? System.Text.Json.JsonSerializer.Serialize(selectedCodecs)
            : null;
    }

    private void LoadCodecsFromModel()
    {
        selectedCodecs = new();
        if (!string.IsNullOrWhiteSpace(model.PreferredCodecs))
        {
            try
            {
                selectedCodecs = System.Text.Json.JsonSerializer.Deserialize<List<string>>(model.PreferredCodecs) ?? new();
            }
            catch { selectedCodecs = new(); }
        }
    }

    public void OpenForCreate()
    {
        isEditMode = false;
        editingBackendId = null;
        createLines = new();
        model = new()
        {
            Port = 5060,
            Transport = "UDP",
            IsActive = true
        };
        LoadCodecsFromModel();
        errorMessage = null;
        isVisible = true;
        StateHasChanged();
    }

    public async void OpenForEdit(SipAccountListDto sip)
    {
        isEditMode = true;
        editingBackendId = sip.Id;
        editLines = new();
        showAddLineForm = false;
        model = new()
        {
            Name = sip.Name,
            Server = sip.Server,
            Port = sip.Port,
            Transport = sip.Transport ?? "UDP",
            WsUri = sip.WsUri,
            UseSrtp = sip.UseSrtp,
            StunServer = sip.StunServer,
            TurnServer = sip.TurnServer,
            PreferredCodecs = sip.PreferredCodecs,
            JitterBufferMinMs = sip.JitterBufferMinMs,
            JitterBufferMaxMs = sip.JitterBufferMaxMs,
            IsDefault = sip.IsDefault,
            IsActive = sip.IsActive
        };
        LoadCodecsFromModel();
        errorMessage = null;
        isVisible = true;
        StateHasChanged();

        // Hatlari API'den yukle
        await LoadLinesAsync(sip.Id);
    }

    private void Close()
    {
        isVisible = false;
        showDeleteConfirm = false;
        showAddLineForm = false;
    }

    private void ShowDeleteConfirm()
    {
        showDeleteConfirm = true;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (!editingBackendId.HasValue) return;

        isSaving = true;
        try
        {
            // OnDelete callback ile parent SipAccounts.razor silmeyi yapar
            await OnDelete.InvokeAsync(new LocalSipAccount { BackendSipAccountId = editingBackendId });
            isVisible = false;
            showDeleteConfirm = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Silme hatasi: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            if (string.IsNullOrWhiteSpace(model.Name))
            {
                errorMessage = "Gateway adi zorunludur.";
                return;
            }

            if (string.IsNullOrWhiteSpace(model.Server))
            {
                errorMessage = "Sunucu adresi zorunludur.";
                return;
            }

            if (isEditMode && editingBackendId.HasValue)
            {
                // PUT ile API'ye gonder
                var updateDto = new SipAccountUpdateDto
                {
                    Name = model.Name,
                    Server = model.Server,
                    Port = model.Port,
                    Domain = model.Domain,
                    Transport = model.Transport,
                    WsUri = model.WsUri,
                    UseSrtp = model.UseSrtp,
                    StunServer = model.StunServer,
                    TurnServer = model.TurnServer,
                    TurnUsername = model.TurnUsername,
                    TurnPassword = model.TurnPassword,
                    PreferredCodecs = model.PreferredCodecs,
                    JitterBufferMinMs = model.JitterBufferMinMs,
                    JitterBufferMaxMs = model.JitterBufferMaxMs,
                    IsDefault = model.IsDefault,
                    IsActive = model.IsActive
                };

                var response = await HttpClient.PutAsJsonAsync($"api/sipaccounts/{editingBackendId.Value}", updateDto);
                if (response.IsSuccessStatusCode)
                {
                    Toast.ShowSuccess("Gateway guncellendi.");
                }
                else
                {
                    // API basarisiz — lokal buffer'a kaydet
                    await SaveToLocalBuffer("Update");
                    Toast.ShowWarning("Gateway guncellendi (cevrimdisi kuyruga eklendi).");
                }
            }
            else
            {
                // POST ile API'ye gonder
                var createDto = new SipAccountCreateDto
                {
                    Name = model.Name,
                    Server = model.Server,
                    Port = model.Port,
                    Domain = model.Domain,
                    Transport = model.Transport,
                    WsUri = model.WsUri,
                    UseSrtp = model.UseSrtp,
                    StunServer = model.StunServer,
                    TurnServer = model.TurnServer,
                    TurnUsername = model.TurnUsername,
                    TurnPassword = model.TurnPassword,
                    PreferredCodecs = model.PreferredCodecs,
                    JitterBufferMinMs = model.JitterBufferMinMs,
                    JitterBufferMaxMs = model.JitterBufferMaxMs,
                    IsDefault = model.IsDefault,
                    CustomerId = PermService.CustomerId ?? 0,
                    Lines = createLines.Count > 0 ? createLines : null
                };

                var response = await HttpClient.PostAsJsonAsync("api/sipaccounts", createDto);
                if (response.IsSuccessStatusCode)
                {
                    Toast.ShowSuccess("Gateway basariyla eklendi.");
                }
                else
                {
                    // API basarisiz — lokal buffer'a kaydet
                    await SaveToLocalBuffer("Create");
                    Toast.ShowWarning("Gateway eklendi (cevrimdisi kuyruga eklendi).");
                }
            }

            isVisible = false;
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            // Network hatasi — lokal buffer'a kaydet
            try
            {
                await SaveToLocalBuffer(isEditMode ? "Update" : "Create");
                Toast.ShowWarning("API erisilemedi, lokal kuyruga kaydedildi.");
                isVisible = false;
                await OnSaved.InvokeAsync();
            }
            catch
            {
                errorMessage = $"Hata: {ex.Message}";
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    // ═══════════════════════════════════════
    // HAT YONETIMI
    // ═══════════════════════════════════════

    private void AddCreateLine()
    {
        createLines.Add(new SipLineCreateDto
        {
            ChannelNumber = createLines.Count + 1,
            Username = string.Empty,
            Password = string.Empty
        });
    }

    private void RemoveCreateLine(int index)
    {
        if (index >= 0 && index < createLines.Count)
            createLines.RemoveAt(index);
    }

    private async Task LoadLinesAsync(int sipAccountId)
    {
        isLoadingLines = true;
        StateHasChanged();

        try
        {
            var lines = await HttpClient.GetFromJsonAsync<List<SipLineListDto>>($"api/sipaccounts/{sipAccountId}/lines");
            editLines = lines ?? new();
        }
        catch
        {
            editLines = new();
        }
        finally
        {
            isLoadingLines = false;
            StateHasChanged();
        }
    }

    private void ShowAddLineForm()
    {
        newLine = new SipLineCreateDto
        {
            ChannelNumber = editLines.Count + 1,
            Username = string.Empty,
            Password = string.Empty
        };
        showAddLineForm = true;
    }

    private async Task AddLineToGatewayAsync()
    {
        if (!editingBackendId.HasValue) return;
        if (string.IsNullOrWhiteSpace(newLine.Username))
        {
            errorMessage = "Hat kullanici adi zorunludur.";
            return;
        }
        if (string.IsNullOrWhiteSpace(newLine.Password))
        {
            errorMessage = "Hat sifresi zorunludur.";
            return;
        }

        isSavingLine = true;
        try
        {
            var response = await HttpClient.PostAsJsonAsync($"api/sipaccounts/{editingBackendId.Value}/lines", newLine);
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Hat eklendi.");
                showAddLineForm = false;
                errorMessage = null;
                await LoadLinesAsync(editingBackendId.Value);
            }
            else
            {
                errorMessage = "Hat ekleme basarisiz.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Hat ekleme hatasi: {ex.Message}";
        }
        finally
        {
            isSavingLine = false;
        }
    }

    private async Task DeleteLineAsync(int lineId)
    {
        isSavingLine = true;
        try
        {
            var response = await HttpClient.DeleteAsync($"api/sipaccounts/lines/{lineId}");
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Hat silindi.");
                if (editingBackendId.HasValue)
                    await LoadLinesAsync(editingBackendId.Value);
            }
            else
            {
                Toast.ShowError("Hat silme basarisiz.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Hat silme hatasi: {ex.Message}");
        }
        finally
        {
            isSavingLine = false;
        }
    }

    private async Task SaveToLocalBuffer(string operation)
    {
        var localAccount = new LocalSipAccount
        {
            Uid = Guid.NewGuid(),
            Name = model.Name,
            Server = model.Server,
            Port = model.Port,
            Domain = model.Domain,
            Username = string.Empty,
            Password = string.Empty,
            Transport = model.Transport,
            WsUri = model.WsUri,
            UseSrtp = model.UseSrtp,
            StunServer = model.StunServer,
            TurnServer = model.TurnServer,
            TurnUsername = model.TurnUsername,
            TurnPassword = model.TurnPassword,
            PreferredCodecs = model.PreferredCodecs,
            JitterBufferMinMs = model.JitterBufferMinMs,
            JitterBufferMaxMs = model.JitterBufferMaxMs,
            IsDefault = model.IsDefault,
            IsActive = model.IsActive,
            IsSyncedToBackend = false,
            BackendSipAccountId = editingBackendId,
            CreatedAt = DateTime.UtcNow
        };

        await LocalRepo.SaveSipAccountAsync(localAccount);
    }

