@page "/contacts"
@attribute [Authorize]
@inject CallCenter.Windows.Services.ContactService ContactService
@inject CallCenter.Windows.Services.ISipService SipService
@inject CallCenter.Windows.Services.ToastService Toast
@inject NavigationManager NavigationManager
@using CallCenter.Windows.Models

<div class="contacts-page">
    <div class="page-header mb-3 d-flex justify-content-between align-items-center">
        <h5><i class="bi bi-people-fill me-2"></i>Rehber</h5>
        <button class="btn btn-sm btn-primary" @onclick="OpenAddDialog">
            <i class="bi bi-plus-circle me-1"></i>Yeni Kisi
        </button>
    </div>

    @* Arama *@
    <div class="mb-3">
        <div class="input-group input-group-sm">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="Isim, numara veya firma ara..."
                   value="@searchQuery" @oninput="OnSearch" />
        </div>
    </div>

    @* Favori filtre *@
    <div class="mb-2">
        <button class="btn btn-sm @(showFavoritesOnly ? "btn-warning" : "btn-outline-secondary")"
                @onclick="ToggleFavorites">
            <i class="bi bi-star-fill me-1"></i>
            @(showFavoritesOnly ? "Tum Kisiler" : "Favoriler")
        </button>
        <span class="text-muted small ms-2">@filteredContacts.Count kisi</span>
    </div>

    @if (filteredContacts.Count == 0)
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-people" style="font-size: 3rem;"></i>
            <p class="mt-2">@(string.IsNullOrEmpty(searchQuery) ? "Henuz kisi eklenmemis." : "Arama sonucu bulunamadi.")</p>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var contact in filteredContacts)
            {
                <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-link p-0" @onclick="() => ToggleFavorite(contact.Id)"
                                title="Favori">
                            <i class="bi @(contact.IsFavorite ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                        </button>
                        <div>
                            <div class="fw-bold small">@contact.Name</div>
                            <div class="text-muted" style="font-size: 0.8rem;">
                                <i class="bi bi-telephone me-1"></i>@contact.Number
                                @if (!string.IsNullOrEmpty(contact.Company))
                                {
                                    <span class="ms-2"><i class="bi bi-building me-1"></i>@contact.Company</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-1">
                        <button class="btn btn-sm btn-success" @onclick="() => CallContact(contact.Number)"
                                title="Ara" disabled="@(!SipService.IsRegistered)">
                            <i class="bi bi-telephone-fill"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditDialog(contact)"
                                title="Duzenle">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteContact(contact.Id)"
                                title="Sil">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Kisi Ekleme/Duzenleme Modal *@
@if (showDialog)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">
                        <i class="bi @(isEditing ? "bi-pencil" : "bi-person-plus") me-2"></i>
                        @(isEditing ? "Kisi Duzenle" : "Yeni Kisi")
                    </h6>
                    <button type="button" class="btn-close" @onclick="CloseDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small">Isim *</label>
                        <input type="text" class="form-control form-control-sm" @bind="editContact.Name" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Numara *</label>
                        <input type="text" class="form-control form-control-sm" @bind="editContact.Number" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Firma</label>
                        <input type="text" class="form-control form-control-sm" @bind="editContact.Company" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">E-posta</label>
                        <input type="email" class="form-control form-control-sm" @bind="editContact.Email" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-secondary" @onclick="CloseDialog">Iptal</button>
                    <button class="btn btn-sm btn-primary" @onclick="SaveContact"
                            disabled="@(string.IsNullOrWhiteSpace(editContact.Name) || string.IsNullOrWhiteSpace(editContact.Number))">
                        <i class="bi bi-check-circle me-1"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Contact> filteredContacts = new();
    private string searchQuery = "";
    private bool showFavoritesOnly;
    private bool showDialog;
    private bool isEditing;
    private Contact editContact = new();

    protected override void OnInitialized()
    {
        RefreshList();
    }

    private void RefreshList()
    {
        filteredContacts = showFavoritesOnly
            ? ContactService.GetFavorites()
            : ContactService.Search(searchQuery);
    }

    private void OnSearch(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        RefreshList();
    }

    private void ToggleFavorites()
    {
        showFavoritesOnly = !showFavoritesOnly;
        RefreshList();
    }

    private void ToggleFavorite(string id)
    {
        ContactService.ToggleFavorite(id);
        RefreshList();
    }

    private void CallContact(string number)
    {
        NavigationManager.NavigateTo($"/dialer?number={number}");
    }

    private void OpenAddDialog()
    {
        editContact = new Contact();
        isEditing = false;
        showDialog = true;
    }

    private void OpenEditDialog(Contact contact)
    {
        editContact = new Contact
        {
            Id = contact.Id,
            Name = contact.Name,
            Number = contact.Number,
            Company = contact.Company,
            Email = contact.Email,
            IsFavorite = contact.IsFavorite,
            CreatedAt = contact.CreatedAt
        };
        isEditing = true;
        showDialog = true;
    }

    private void SaveContact()
    {
        if (isEditing)
        {
            ContactService.Update(editContact);
            Toast.ShowSuccess("Kisi guncellendi");
        }
        else
        {
            ContactService.Add(editContact);
            Toast.ShowSuccess("Kisi eklendi");
        }
        CloseDialog();
        RefreshList();
    }

    private void DeleteContact(string id)
    {
        ContactService.Delete(id);
        Toast.ShowInfo("Kisi silindi");
        RefreshList();
    }

    private void CloseDialog()
    {
        showDialog = false;
        editContact = new();
    }
}
