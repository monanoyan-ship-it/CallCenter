@page "/contacts"
@attribute [Authorize]
@inject CallCenter.Windows.Services.ContactService ContactService
@inject CallCenter.Windows.Services.ISipService SipService
@inject CallCenter.Windows.Services.ToastService Toast
@inject CallCenter.Windows.Services.WindowsPermissionService PermService
@inject NavigationManager NavigationManager
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Helpers
@using CallCenter.Shared.Enums

<div class="contacts-page">
    <div class="page-header mb-3 d-flex justify-content-between align-items-center">
        <h5><i class="bi bi-people-fill me-2"></i>Rehber</h5>
        @if (!isReadOnly)
        {
            <button class="btn btn-sm btn-primary" @onclick="OpenAddDialog">
                <i class="bi bi-plus-circle me-1"></i>Yeni Kisi
            </button>
        }
    </div>

    @* Arama *@
    <div class="mb-3">
        <div class="input-group input-group-sm">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="Isim, numara veya firma ara..."
                   value="@searchQuery" @oninput="OnSearch" />
        </div>
    </div>

    @* Favori filtre *@
    <div class="mb-2">
        <button class="btn btn-sm @(showFavoritesOnly ? "btn-warning" : "btn-outline-secondary")"
                @onclick="ToggleFavorites">
            <i class="bi bi-star-fill me-1"></i>
            @(showFavoritesOnly ? "Tum Kisiler" : "Favoriler")
        </button>
        <span class="text-muted small ms-2">@filteredContacts.Count kisi</span>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (filteredContacts.Count == 0)
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-people" style="font-size: 3rem;"></i>
            <p class="mt-2">@(string.IsNullOrEmpty(searchQuery) ? "Henuz kisi eklenmemis." : "Arama sonucu bulunamadi.")</p>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var contact in filteredContacts)
            {
                <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-link p-0" @onclick="() => ToggleFavorite(contact.Id)"
                                title="Favori">
                            <i class="bi @(contact.IsFavorite ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                        </button>
                        <div>
                            <div class="fw-bold small">@contact.FullName</div>
                            <div class="text-muted" style="font-size: 0.8rem;">
                                <i class="bi bi-telephone me-1"></i>@contact.PhoneNumber
                                @if (!string.IsNullOrEmpty(contact.Company))
                                {
                                    <span class="ms-2"><i class="bi bi-building me-1"></i>@contact.Company</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-1">
                        <button class="btn btn-sm btn-success" @onclick="() => CallContact(contact.PhoneNumber)"
                                title="Ara" disabled="@(!SipService.IsRegistered)">
                            <i class="bi bi-telephone-fill"></i>
                        </button>
                        @if (!isReadOnly)
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditDialog(contact)"
                                    title="Duzenle">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteContact(contact.Id)"
                                    title="Sil">
                                <i class="bi bi-trash"></i>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Kisi Ekleme/Duzenleme Modal *@
@if (showDialog)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">
                        <i class="bi @(isEditing ? "bi-pencil" : "bi-person-plus") me-2"></i>
                        @(isEditing ? "Kisi Duzenle" : "Yeni Kisi")
                    </h6>
                    <button type="button" class="btn-close" @onclick="CloseDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small">Isim *</label>
                        <input type="text" class="form-control form-control-sm" @bind="editFullName" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Numara *</label>
                        <input type="text" class="form-control form-control-sm" @bind="editPhoneNumber" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Firma</label>
                        <input type="text" class="form-control form-control-sm" @bind="editCompany" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">E-posta</label>
                        <input type="email" class="form-control form-control-sm" @bind="editEmail" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-sm btn-secondary" @onclick="CloseDialog">Iptal</button>
                    <button class="btn btn-sm btn-primary" @onclick="SaveContact" disabled="@isSaving"
                            >
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="bi bi-check-circle me-1"></i>Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ContactDto> filteredContacts = new();
    private string searchQuery = "";
    private bool showFavoritesOnly;
    private bool isLoading;
    private bool showDialog;
    private bool isEditing;
    private bool isSaving;
    private bool isReadOnly => PermService.CustomerRoleId == CustomerRoles.Ids.Operator && !PermService.IsAdmin;

    // Edit form alanlari
    private int editContactId;
    private string editFullName = "";
    private string editPhoneNumber = "";
    private string? editCompany;
    private string? editEmail;
    private bool editIsFavorite;

    protected override async Task OnInitializedAsync()
    {
        await RefreshListAsync();
    }

    private async Task RefreshListAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            if (showFavoritesOnly)
                filteredContacts = await ContactService.GetFavoritesAsync();
            else
                filteredContacts = await ContactService.GetAllAsync(searchQuery);
        }
        catch
        {
            filteredContacts = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnSearch(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        await RefreshListAsync();
    }

    private async Task ToggleFavorites()
    {
        showFavoritesOnly = !showFavoritesOnly;
        await RefreshListAsync();
    }

    private async Task ToggleFavorite(int id)
    {
        var success = await ContactService.ToggleFavoriteAsync(id);
        if (success)
            await RefreshListAsync();
        else
            Toast.ShowError("Favori durumu guncellenemedi.");
    }

    private void CallContact(string number)
    {
        NavigationManager.NavigateTo($"/dialer?number={number}");
    }

    private void OpenAddDialog()
    {
        editContactId = 0;
        editFullName = "";
        editPhoneNumber = "";
        editCompany = null;
        editEmail = null;
        editIsFavorite = false;
        isEditing = false;
        showDialog = true;
    }

    private void OpenEditDialog(ContactDto contact)
    {
        editContactId = contact.Id;
        editFullName = contact.FullName;
        editPhoneNumber = contact.PhoneNumber;
        editCompany = contact.Company;
        editEmail = contact.Email;
        editIsFavorite = contact.IsFavorite;
        isEditing = true;
        showDialog = true;
    }

    private async Task SaveContact()
    {
        if (string.IsNullOrWhiteSpace(editFullName) || string.IsNullOrWhiteSpace(editPhoneNumber))
            return;

        isSaving = true;
        StateHasChanged();

        try
        {
            var phone = PhoneHelper.Sanitize(editPhoneNumber);

            if (isEditing)
            {
                var success = await ContactService.UpdateAsync(editContactId, editFullName, phone, editCompany, editEmail, editIsFavorite);
                Toast.ShowSuccess(success ? "Kisi guncellendi" : "Kisi guncellendi (cevrimdisi kuyruga eklendi)");
            }
            else
            {
                var success = await ContactService.CreateAsync(editFullName, phone, editCompany, editEmail);
                Toast.ShowSuccess(success ? "Kisi eklendi" : "Kisi eklendi (cevrimdisi kuyruga eklendi)");
            }

            CloseDialog();
            await RefreshListAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Hata: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteContact(int id)
    {
        var success = await ContactService.DeleteAsync(id);
        Toast.ShowInfo(success ? "Kisi silindi" : "Kisi silindi (cevrimdisi kuyruga eklendi)");
        await RefreshListAsync();
    }

    private void CloseDialog()
    {
        showDialog = false;
    }
}
