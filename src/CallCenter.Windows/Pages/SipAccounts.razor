@page "/sip-accounts"
@attribute [Authorize]
@inject ILocalRepository LocalRepo
@inject ToastService Toast
@inject HttpClient HttpClient
@inject CallCenter.Windows.Services.WindowsPermissionService PermService
@using CallCenter.Windows.LocalData.Entities
@using CallCenter.Windows.LocalData
@using CallCenter.Shared.DTOs

<PageTitle>SIP Hesap Ayarlari - CorpLynk</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bi bi-router-fill me-2 text-primary"></i>SIP Hesap Ayarlari
    </h4>
    <button class="btn btn-primary btn-sm" @onclick="OpenCreateForm">
        <i class="bi bi-plus-lg me-1"></i>Yeni Gateway
    </button>
</div>

@* ─── İŞLEM BUTONLARI ─── *@
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-center">
            <div class="col-auto">
                <button class="btn btn-outline-secondary btn-sm" @onclick="LoadData" disabled="@isLoading">
                    <i class="bi bi-arrow-clockwise me-1"></i>Yenile
                </button>
            </div>
        </div>
    </div>
</div>

@* ─── TABLO ─── *@
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else if (sipAccounts == null || sipAccounts.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-router fs-1 d-block mb-2 opacity-25"></i>
                <span>SIP gateway bulunamadi</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Gateway Adi</th>
                            <th>Sunucu</th>
                            <th>Port</th>
                            <th>Kullanici</th>
                            <th>Transport</th>
                            <th>Varsayilan</th>
                            <th>Durum</th>
                            <th style="width: 100px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sip in sipAccounts)
                        {
                            <tr class="@(!sip.IsActive ? "table-secondary" : "")">
                                <td class="fw-medium">@sip.Name</td>
                                <td>@sip.Server</td>
                                <td class="text-muted">@sip.Port</td>
                                <td>@sip.Username</td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary">@(sip.Transport ?? "UDP")</span>
                                </td>
                                <td class="text-center">
                                    @if (sip.IsDefault)
                                    {
                                        <i class="bi bi-star-fill text-warning"></i>
                                    }
                                </td>
                                <td>
                                    @if (sip.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Pasif</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-outline-primary btn-sm me-1" title="Duzenle"
                                            @onclick="() => OpenEditForm(sip)" disabled="@isLoading">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm" title="Sil"
                                            @onclick="() => DeleteSipAccountAsync(sip)" disabled="@isLoading">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white border-top">
                <small class="text-muted">Toplam: @sipAccounts.Count kayit</small>
            </div>
        }
    </div>
</div>

<SipAccountForm @ref="sipForm" OnSaved="LoadData" OnDelete="HandleFormDelete" />

@code {
    private List<SipAccountListDto>? sipAccounts;
    private bool isLoading;
    private SipAccountForm sipForm = null!;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task HandleFormDelete(LocalSipAccount sip)
    {
        try
        {
            // API'den sil
            if (sip.BackendSipAccountId.HasValue)
            {
                var response = await HttpClient.DeleteAsync($"api/sipaccounts/{sip.BackendSipAccountId.Value}");
                if (!response.IsSuccessStatusCode)
                {
                    Toast.ShowError("Silme islemi basarisiz.");
                    return;
                }
            }
            Toast.ShowSuccess("Gateway basariyla silindi.");
            await LoadData();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Silme islemi basarisiz: {ex.Message}");
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var result = await HttpClient.GetFromJsonAsync<PagedResult<SipAccountListDto>>("api/sipaccounts?pageSize=1000");
            sipAccounts = result?.Items;
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Veri yuklenemedi: {ex.Message}");
            sipAccounts = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateForm()
    {
        sipForm.OpenForCreate();
    }

    private void OpenEditForm(SipAccountListDto sip)
    {
        sipForm.OpenForEdit(sip);
    }

    private async Task DeleteSipAccountAsync(SipAccountListDto sip)
    {
        if (sip == null) return;

        try
        {
            var response = await HttpClient.DeleteAsync($"api/sipaccounts/{sip.Id}");
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("Gateway basariyla silindi.");
                await LoadData();
            }
            else
            {
                Toast.ShowError("Silme islemi basarisiz.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Silme islemi basarisiz: {ex.Message}");
        }
    }
}
