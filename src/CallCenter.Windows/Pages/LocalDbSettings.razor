@page "/local-db-settings"
@attribute [Authorize]
@inject CallCenter.Windows.LocalData.ILocalRepository LocalRepo
@inject CallCenter.Windows.Services.SecureStorage Storage
@inject CallCenter.Windows.Services.ToastService Toast
@inject CallCenter.Windows.Services.WindowsPermissionService PermService
@inject NavigationManager NavigationManager
@using CallCenter.Shared.Enums
@using CallCenter.Windows.LocalData.Providers

<div class="container-fluid py-3">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex align-items-center">
                    <i class="bi bi-folder-fill me-2"></i>
                    <h5 class="mb-0">Lokal Depolama</h5>
                </div>

                <div class="card-body">
                    @* ─── Aciklama ─── *@
                    <div class="alert alert-info d-flex align-items-start mb-4">
                        <i class="bi bi-info-circle-fill me-2 mt-1"></i>
                        <div>
                            <strong>Lokal Depolama</strong><br/>
                            Cagri kayitlari, SIP hesaplari ve ses kaydi metadata'si JSON dosyalarinda saklanir.
                            Backend'e sadece ozet bilgiler senkronlanir. Ses dosyalari asla disari cikmaz.
                        </div>
                    </div>

                    @* ─── Dosya Konumu ─── *@
                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            <i class="bi bi-folder2-open me-1"></i>Depolama Konumu
                        </label>
                        <div class="form-control bg-light font-monospace small"
                             style="word-break: break-all; min-height: 2.5rem; padding-top: 0.5rem;">
                            @storagePath
                        </div>
                    </div>

                    @* ─── Ses Kaydi Klasoru ─── *@
                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            <i class="bi bi-mic-fill me-1"></i>Ses Kaydi Klasoru
                        </label>
                        <input type="text" class="form-control font-monospace"
                               @bind="recordingBasePath" @bind:event="oninput"
                               placeholder="@defaultRecordingPath" />
                        <div class="form-text">
                            Ses dosyalari bu klasorde saklanir. Bos birakilirsa varsayilan kullanilir.
                        </div>
                    </div>

                    @* ─── Dosya Boyutlari ─── *@
                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            <i class="bi bi-hdd-fill me-1"></i>Dosya Boyutlari
                        </label>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Dosya</th>
                                        <th class="text-end">Boyut</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var file in fileSizes)
                                    {
                                        <tr>
                                            <td class="font-monospace">@file.Key</td>
                                            <td class="text-end">@FormatSize(file.Value)</td>
                                        </tr>
                                    }
                                    <tr class="table-light fw-bold">
                                        <td>Toplam</td>
                                        <td class="text-end">@FormatSize(fileSizes.Values.Sum())</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    @* ─── Durum ─── *@
                    <div class="card bg-light mb-4">
                        <div class="card-body">
                            <h6 class="card-title">
                                <i class="bi bi-info-square-fill me-1"></i>Mevcut Durum
                            </h6>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-success">Aktif</span>
                                <span class="text-muted">Veriler JSON dosyalarinda saklanip backend'e senkronlaniyor</span>
                            </div>
                        </div>
                    </div>

                    @* ─── Verileri Temizle ─── *@
                    <div class="card border-danger">
                        <div class="card-body">
                            <h6 class="card-title text-danger">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>Tehlikeli Bolge
                            </h6>
                            <p class="card-text small text-muted mb-2">
                                Tum lokal verileri (cagri kayitlari, SIP hesaplari, ses kaydi metadata'si) siler. Bu islem geri alinamaz.
                            </p>
                            @if (!showClearConfirm)
                            {
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => showClearConfirm = true">
                                    <i class="bi bi-trash3 me-1"></i>Verileri Temizle
                                </button>
                            }
                            else
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-danger fw-bold small">Emin misiniz?</span>
                                    <button class="btn btn-danger btn-sm" @onclick="ClearAllData" disabled="@isClearing">
                                        <i class="bi bi-trash3-fill me-1"></i>
                                        @(isClearing ? "Siliniyor..." : "Evet, Temizle")
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => showClearConfirm = false"
                                            disabled="@isClearing">
                                        Vazgec
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* ─── Kaydet Butonu ─── *@
                <div class="card-footer d-flex justify-content-end">
                    <button class="btn btn-primary" @onclick="SaveSettings" disabled="@isSaving">
                        <i class="bi bi-check-lg me-1"></i>
                        @(isSaving ? "Kaydediliyor..." : "Kaydet")
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private const string RecordingPathKey = "recording_base_path";

    private string storagePath = "";
    private string recordingBasePath = "";
    private Dictionary<string, long> fileSizes = new();
    private bool isSaving;
    private bool isClearing;
    private bool showClearConfirm;

    private readonly string defaultRecordingPath = System.IO.Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
        "CallCenter", "Recordings");

    protected override async Task OnInitializedAsync()
    {
        // Modul guard
        await PermService.LoadAsync();
        if (!PermService.HasModule(PortalModules.Ids.Settings))
        {
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        // Mevcut ayarlari yukle
        recordingBasePath = await Storage.GetAsync(RecordingPathKey) ?? "";

        // Dosya bilgilerini yukle
        LoadFileInfo();
    }

    private void LoadFileInfo()
    {
        if (LocalRepo is FileLocalRepository fileRepo)
        {
            storagePath = fileRepo.BasePath;
            fileSizes = fileRepo.GetFileSizes();
        }
        else
        {
            storagePath = System.IO.Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
                "CallCenter", "Data");
            fileSizes = new Dictionary<string, long>
            {
                { "call-records.json", 0 },
                { "sip-accounts.json", 0 },
                { "recordings.json", 0 }
            };
        }
    }

    private async Task SaveSettings()
    {
        isSaving = true;
        StateHasChanged();

        try
        {
            if (!string.IsNullOrWhiteSpace(recordingBasePath))
                await Storage.SetAsync(RecordingPathKey, recordingBasePath);
            else
                await Storage.RemoveAsync(RecordingPathKey);

            Toast.ShowSuccess("Ayarlar kaydedildi.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Kaydetme hatasi: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ClearAllData()
    {
        isClearing = true;
        StateHasChanged();

        try
        {
            if (LocalRepo is FileLocalRepository fileRepo)
            {
                await fileRepo.ClearAllAsync();
                LoadFileInfo();
                Toast.ShowSuccess("Tum lokal veriler temizlendi.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Temizleme hatasi: {ex.Message}");
        }
        finally
        {
            isClearing = false;
            showClearConfirm = false;
        }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes == 0) return "—";
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }
}
