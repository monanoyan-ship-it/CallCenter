    // ─── Call Actions ───

    private async Task StartCall()
    {
        if (string.IsNullOrWhiteSpace(phoneNumber) || !SipService.IsRegistered) return;

        isCallStarting = true;
        _callEndProcessing = false;
        _callEndedLocally = false;
        callNotes = "";
        isNotesSavedToServer = false;
        showNotesPanel = true;
        sideTab = "notes";
        statusMessage = $"{phoneNumber} araniyor...";
        statusClass = "text-info";

        try
        {
            // Cift yazim: hem lokal DB'ye hem backend'e yazar
            var syncResult = await CallSync.StartCallAsync("me", phoneNumber);
            currentCallUid = syncResult.Uid;
            currentCallId = syncResult.BackendCallId;
            notesCallUid = syncResult.Uid;
            notesCallId = syncResult.BackendCallId;

            await HubService.UpdateStatusAsync(AgentStatuses.Ids.InCall);
            var success = await SipService.MakeCallAsync(phoneNumber);
            StateHasChanged();
            if (!success)
            {
                // SIP basarisiz → cagriyi "missed" olarak isaretle
                if (currentCallUid.HasValue)
                {
                    await CallSync.MissCallAsync(currentCallUid.Value, currentCallId);
                }
                currentCallId = null;
                currentCallUid = null;
                isCallStarting = false;
                statusMessage = "Arama baslatilamadi";
                statusClass = "text-danger";
                Toast.ShowError("Arama baslatilamadi. GoIP cihazi aramayi reddetti veya codec uyumsuzlugu var.");
                await HubService.UpdateStatusAsync(AgentStatuses.Ids.Available);
            }
        }
        catch (Exception ex)
        {
            isCallStarting = false;
            statusMessage = "Arama hatasi: " + ex.Message;
            statusClass = "text-danger";
            Toast.ShowError($"Arama hatasi: {ex.Message}");
            currentCallId = null;
            currentCallUid = null;
        }
    }



    private async Task ToggleHold()
    {
        if (SipService.IsOnHold)
        {
            var success = await SipService.UnholdAsync();
            if (success) { statusMessage = "Gorusme devam ediyor"; statusClass = "text-success"; }
        }
        else
        {
            var success = await SipService.HoldAsync();
            if (success) { statusMessage = "Arama beklemede..."; statusClass = "text-warning"; }
        }
    }

    private async Task EndCall()
    {
        isCallStarting = false;
        _callEndedLocally = true; // UI hemen sifirlansin

        var endUid = currentCallUid;
        var endId = currentCallId;
        var wasRec = SipService.IsRecording;

        // UI'yi hemen sifirla — callback'e bagimli kalma
        StopTimer();
        StopNotesTimer();

        // Bekleyen notu kaydet
        if (endUid.HasValue && !string.IsNullOrWhiteSpace(callNotes))
        {
            try { await CallSync.SaveNotesLocalAsync(endUid.Value, callNotes); }
            catch { }
        }

        currentCallId = null;
        currentCallUid = null;
        _callEndProcessing = true; // HandleCallEnded tekrar tetiklenirse engelle

        statusMessage = wasRec ? "Ses kaydi isleniyor..." : "Kapatiliyor...";
        statusClass = "text-info";
        callDuration = "00:00";
        StateHasChanged();

        // ONCE kaydi durdur (MediaSession kapanmadan), SONRA SIP hangup
        _ = Task.Run(async () =>
        {
            try
            {
                if (wasRec)
                {
                    DiagLog("EndCall: StopRecordingAsync ONCE cagriliyor (HangupAsync oncesi)");
                    await SipService.StopRecordingAsync();
                    DiagLog($"EndCall: StopRecordingAsync tamamlandi. Path={SipService.LastRecordingPath}");
                }

                DiagLog("EndCall: HangupAsync cagriliyor...");
                // HangupAsync senkron bloklanabilir — ayri thread'de calistir
                var hangupTask = Task.Run(async () => await SipService.HangupAsync());
                if (await Task.WhenAny(hangupTask, Task.Delay(10000)) != hangupTask)
                {
                    DiagLog("EndCall: HangupAsync 10sn timeout! Devam ediliyor.");
                }
                else
                {
                    DiagLog("EndCall: HangupAsync tamamlandi.");
                }

                string? recordingPath = SipService.LastRecordingPath;
                DiagLog($"EndCall: endUid={endUid}, endId={endId}, recPath={recordingPath}");

                if (endUid.HasValue)
                {
                    DiagLog("EndCall: CallSync.EndCallAsync cagriliyor...");
                    await CallSync.EndCallAsync(endUid.Value, endId, recordingPath);
                    DiagLog("EndCall: EndCallAsync TAMAMLANDI.");
                }
                else
                {
                    DiagLog("EndCall: endUid null — EndCallAsync CAGRILMADI!");
                }

                await InvokeAsync(() =>
                {
                    statusMessage = wasRec ? "Kayit tamamlandi" : "Arama sonlandirildi";
                    statusClass = wasRec ? "text-success" : "text-muted";
                    _callEndProcessing = false;
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                DiagLog($"EndCall hatasi: {ex.Message}\n{ex.StackTrace}");
                await InvokeAsync(() =>
                {
                    statusMessage = "Arama sonlandirildi";
                    statusClass = "text-muted";
                    _callEndProcessing = false;
                    StateHasChanged();
                });
            }
        });

        await HubService.UpdateStatusAsync(AgentStatuses.Ids.AfterCallWork);
        lines = (await SipService.GetLinesAsync()).ToList();
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            await Task.Delay(5000);
            await HubService.UpdateStatusAsync(AgentStatuses.Ids.Available);
        });
    }

