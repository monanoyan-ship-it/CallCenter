@page "/dialer"
@attribute [Authorize]
@inject CallCenter.Windows.Services.WindowsHubService HubService
@inject CallCenter.Windows.Services.ISipService SipService
@inject HttpClient Http
@inject CallCenter.Windows.Services.ToastService Toast
@inject CallCenter.Windows.Services.CallSyncService CallSync
@inject CallCenter.Windows.LocalData.ILocalRepository LocalRepo
@inject CallCenter.Windows.Services.WindowsPermissionService PermService
@inject NavigationManager NavigationManager
@using CallCenter.Shared.Enums
@using CallCenter.Shared.DTOs
@using CallCenter.Windows.Models
@using CallCenter.Shared.Helpers
@implements IAsyncDisposable

<div class="dialer-page">
            <div class="dialer-card">
                <div class="dialer-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5><i class="bi bi-telephone-fill me-2"></i>Numara Cevirici</h5>
                        <span class="badge @(SipService.IsRegistered ? "bg-success" : "bg-secondary") sip-badge">
                            <i class="bi @(SipService.IsRegistered ? "bi-wifi" : "bi-wifi-off") me-1"></i>
                            @(SipService.IsRegistered ? "SIP Kayitli" : sipStatusText)
                        </span>
                    </div>
                </div>

                @* ─── Hat Gostergesi (Multi-Line) ─── *@
                <div class="line-indicators d-flex gap-1 mb-2">
                    @for (int i = 0; i < SipService.LineCount; i++)
                    {
                        var idx = i;
                        var lineInfo = lines.Count > idx ? lines[idx] : null;
                        var isActive = idx == SipService.ActiveLineIndex;
                        var stateClass = lineInfo?.State switch
                        {
                            LineState.Ringing => "line-ringing",
                            LineState.Connected => "line-connected",
                            LineState.OnHold => "line-hold",
                            LineState.Connecting => "line-connecting",
                            LineState.TransferPending => "line-transfer",
                            _ => "line-idle"
                        };
                        <button class="btn btn-sm line-btn @stateClass @(isActive ? "line-active" : "")"
                                @onclick="() => SwitchLine(idx)"
                                title="@(lineInfo?.RemoteParty ?? $"Hat {idx+1}")">
                            @(idx + 1)
                        </button>
                    }
                </div>

                @* ─── Hizli Eylem Butonlari ─── *@
                <div class="quick-actions d-flex gap-1 mb-2">
                    <button class="btn btn-sm @(SipService.IsDndEnabled ? "btn-danger" : "btn-outline-secondary") quick-btn"
                            @onclick="ToggleDnd" title="Rahatsiz Etmeyin">
                        <i class="bi bi-moon-fill"></i>
                        <span class="d-none d-md-inline ms-1">DND</span>
                    </button>
                    <button class="btn btn-sm @(SipService.IsAutoAnswerEnabled ? "btn-success" : "btn-outline-secondary") quick-btn"
                            @onclick="ToggleAutoAnswer" title="Otomatik Cevap">
                        <i class="bi bi-lightning-fill"></i>
                        <span class="d-none d-md-inline ms-1">Oto</span>
                    </button>
                    @if (SipService.IsInCall)
                    {
                        <button class="btn btn-sm @(SipService.IsMuted ? "btn-warning" : "btn-outline-secondary") quick-btn"
                                @onclick="ToggleMute" title="Sustur">
                            <i class="bi @(SipService.IsMuted ? "bi-mic-mute-fill" : "bi-mic-fill")"></i>
                            <span class="d-none d-md-inline ms-1">@(SipService.IsMuted ? "Acik" : "Kapa")</span>
                        </button>
                        <button class="btn btn-sm @(SipService.IsRecording ? "btn-danger recording-pulse" : "btn-outline-secondary") quick-btn"
                                @onclick="ToggleRecording" title="Kayit">
                            <i class="bi bi-record-circle-fill"></i>
                            <span class="d-none d-md-inline ms-1">Kayit</span>
                        </button>
                    }
                    @if (SipService.VoicemailCount > 0)
                    {
                        <button class="btn btn-sm btn-outline-info quick-btn position-relative"
                                @onclick="DialVoicemail" title="Sesli Mesaj">
                            <i class="bi bi-voicemail"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                  style="font-size: 0.6rem;">
                                @SipService.VoicemailCount
                            </span>
                        </button>
                    }
                </div>

                @* ─── Ses Cihazi Secimi + Volume ─── *@
                <div class="audio-controls mb-2 px-2">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-mic-fill text-muted small" title="Mikrofon"></i>
                        <select class="form-select form-select-sm flex-grow-1 audio-device-select"
                                value="@selectedInputDevice"
                                @onchange="OnInputDeviceChange">
                            @foreach (var dev in inputDevices)
                            {
                                <option value="@dev.DeviceIndex">@dev.DeviceName</option>
                            }
                        </select>
                        <input type="range" class="form-range form-range-sm" style="max-width:80px;"
                               min="0" max="100" step="5"
                               value="@((int)(SipService.MicrophoneVolume * 100))"
                               @oninput="OnMicVolumeChange" />
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-speaker-fill text-muted small" title="Hoparlor"></i>
                        <select class="form-select form-select-sm flex-grow-1 audio-device-select"
                                value="@selectedOutputDevice"
                                @onchange="OnOutputDeviceChange">
                            @foreach (var dev in outputDevices)
                            {
                                <option value="@dev.DeviceIndex">@dev.DeviceName</option>
                            }
                        </select>
                        <input type="range" class="form-range form-range-sm" style="max-width:80px;"
                               min="0" max="100" step="5"
                               value="@((int)(SipService.SpeakerVolume * 100))"
                               @oninput="OnSpeakerVolumeChange" />
                    </div>
                </div>

                @* ─── Numara Gosterge ─── *@
                <div class="number-display">
                    <input type="text" class="form-control number-input"
                           @bind="phoneNumber" @bind:event="oninput"
                           placeholder="Numara girin..."
                           @onkeydown="HandleKeyDown" />
                    @if (!string.IsNullOrEmpty(phoneNumber))
                    {
                        <button class="btn btn-link clear-btn" @onclick="ClearNumber">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                </div>

                @* ─── Tus Takimi ─── *@
                <div class="keypad">
                    @foreach (var row in keypadRows)
                    {
                        <div class="keypad-row">
                            @foreach (var key in row)
                            {
                                <button class="keypad-btn" @onclick="() => PressKey(key.digit)">
                                    <span class="digit">@key.digit</span>
                                    @if (!string.IsNullOrEmpty(key.letters))
                                    {
                                        <span class="letters">@key.letters</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                </div>

                @* ─── Arama Butonlari ─── *@
                <div class="call-actions">
                    @if (!SipService.IsInCall)
                    {
                        <div class="d-flex gap-2 justify-content-center">
                            <button class="btn call-btn call-start"
                                    disabled="@(string.IsNullOrWhiteSpace(phoneNumber) || !SipService.IsRegistered || isCallStarting)"
                                    @onclick="StartCall">
                                <i class="bi bi-telephone-fill"></i>
                                <span>@(isCallStarting ? "Araniyor..." : "Ara")</span>
                            </button>
                            @* Yeni hatta arama *@
                            @if (SipService.IsInCall || lines.Any(l => l.State != LineState.Idle))
                            {
                                <button class="btn call-btn btn-outline-primary btn-sm"
                                        disabled="@(string.IsNullOrWhiteSpace(phoneNumber) || !SipService.IsRegistered)"
                                        @onclick="StartCallOnNewLine"
                                        title="Yeni hatta ara">
                                    <i class="bi bi-plus-circle"></i>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="in-call-actions">
                            <button class="btn call-btn @(SipService.IsOnHold ? "call-resume" : "call-hold")"
                                    @onclick="ToggleHold">
                                <i class="bi @(SipService.IsOnHold ? "bi-play-circle-fill" : "bi-pause-circle-fill")"></i>
                                <span>@(SipService.IsOnHold ? "Devam" : "Beklet")</span>
                            </button>
                            <button class="btn call-btn btn-outline-info" @onclick="OpenTransfer"
                                    title="Transfer">
                                <i class="bi bi-arrow-left-right"></i>
                                <span>Transfer</span>
                            </button>
                            <button class="btn call-btn call-end" @onclick="EndCall">
                                <i class="bi bi-telephone-x-fill"></i>
                                <span>Kapat</span>
                            </button>
                        </div>
                        <div class="call-timer mt-2">
                            <i class="bi bi-clock"></i>
                            <span>@callDuration</span>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <div class="status-message @statusClass">
                        @statusMessage
                    </div>
                }
            </div>
</div>

@* ─── Transfer Dialog ─── *@
<CallCenter.Windows.Components.TransferDialog IsVisible="showTransferDialog"
    OnClosed="CloseTransferDialog" OnTransferred="HandleTransferred" />

@code {
    private string _phoneNumber = "";
    private string phoneNumber
    {
        get => _phoneNumber;
        set => _phoneNumber = PhoneHelper.Sanitize(value);
    }
    private bool isCallStarting;
    private string statusMessage = "";
    private string statusClass = "";
    private List<AudioDeviceInfo> inputDevices = new();
    private List<AudioDeviceInfo> outputDevices = new();
    private int selectedInputDevice = -1;
    private int selectedOutputDevice = -1;
    private string callDuration = "00:00";
    private string sipStatusText = "Baglaniyor...";
    private System.Timers.Timer? callTimer;
    private DateTime callStartTime;
    private int? currentCallId;
    private Guid? currentCallUid;       // Lokal DB referansi (cift yazim)
    private bool showTransferDialog;
    private List<LineInfo> lines = new();

    private readonly (string digit, string letters)[][] keypadRows = new[]
    {
        new[] { ("1", ""), ("2", "ABC"), ("3", "DEF") },
        new[] { ("4", "GHI"), ("5", "JKL"), ("6", "MNO") },
        new[] { ("7", "PQRS"), ("8", "TUV"), ("9", "WXYZ") },
        new[] { ("*", ""), ("0", "+"), ("#", "") }
    };

    protected override async Task OnInitializedAsync()
    {
        // Modul guard: Calls modulu yoksa dashboard'a yonlendir
        await PermService.LoadAsync();
        if (!PermService.HasModule(PortalModules.Ids.Calls))
        {
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        SipService.OnRegistered += HandleSipRegistered;
        SipService.OnRegistrationFailed += HandleSipRegistrationFailed;
        SipService.OnCallAnswered += HandleCallAnswered;
        SipService.OnCallEnded += HandleCallEnded;
        SipService.OnCallFailed += HandleCallFailed;
        SipService.OnLineChanged += HandleLineChanged;
        SipService.OnMuteChanged += HandleMuteChanged;

        lines = await SipService.GetLinesAsync();

        // Ses cihazlarini yukle
        inputDevices = await SipService.GetAudioInputDevicesAsync();
        outputDevices = await SipService.GetAudioOutputDevicesAsync();

        if (SipService.IsRegistered)
        {
            sipStatusText = "SIP Kayitli";
            return;
        }

        await InitializeSip();
    }

    private async Task InitializeSip()
    {
        try
        {
            var account = await LocalRepo.GetDefaultSipAccountAsync();

            if (account == null)
            {
                sipStatusText = "SIP Yok";
                statusMessage = "Gateway tanimli degil. Gateway Yonetimi sayfasindan ekleyin.";
                statusClass = "text-warning";
                return;
            }

            var sipInfo = new SipConnectionInfoDto
            {
                SipUri = $"sip:{account.Username}@{account.Server}",
                WsUri = account.WsUri ?? $"wss://{account.Server}:8089/ws",
                AuthUsername = account.Username,
                AuthPassword = account.Password,
                DisplayName = account.Name,
                Transport = account.Transport ?? "UDP",
                UseSrtp = account.UseSrtp,
                StunServer = account.StunServer,
                TurnServer = account.TurnServer,
                TurnUsername = account.TurnUsername,
                TurnPassword = account.TurnPassword,
                PreferredCodecs = account.PreferredCodecs,
                JitterBufferMinMs = account.JitterBufferMinMs,
                JitterBufferMaxMs = account.JitterBufferMaxMs
            };

            sipStatusText = "Kayit olunuyor...";
            StateHasChanged();

            await SipService.InitializeAsync(sipInfo);
        }
        catch (Exception ex)
        {
            sipStatusText = "SIP Hata";
            statusMessage = "SIP baglanti hatasi: " + ex.Message;
            statusClass = "text-danger";
        }
    }

    // ─── SIP Event Handlers ───

    private async Task HandleSipRegistered()
    {
        sipStatusText = "SIP Kayitli";
        statusMessage = "";

        // Gateway saglik bilgisini hub'a bildir
        var account = await LocalRepo.GetDefaultSipAccountAsync();
        await HubService.UpdateGatewayHealthAsync(new GatewayHealthUpdate
        {
            IsRegistered = true,
            GatewayName = account?.Name,
            SipServer = account?.Server,
            Transport = account?.Transport ?? "UDP"
        });

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleSipRegistrationFailed(string error)
    {
        sipStatusText = "SIP Hata";
        statusMessage = "SIP kayit hatasi: " + error;
        statusClass = "text-danger";

        // Gateway hata bilgisini hub'a bildir
        var account = await LocalRepo.GetDefaultSipAccountAsync();
        await HubService.UpdateGatewayHealthAsync(new GatewayHealthUpdate
        {
            IsRegistered = false,
            GatewayName = account?.Name,
            SipServer = account?.Server,
            Transport = account?.Transport ?? "UDP",
            ErrorMessage = error
        });

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleCallAnswered()
    {
        await InvokeAsync(async () =>
        {
            isCallStarting = false;
            lines = (await SipService.GetLinesAsync()).ToList();

            // Gelen aramada phoneNumber bos olabilir — aktif hattan al
            var activeLine = lines.FirstOrDefault(l => l.State == LineState.Connected);
            if (string.IsNullOrEmpty(phoneNumber) && activeLine != null)
                phoneNumber = activeLine.RemoteParty ?? "";

            statusMessage = $"{phoneNumber} ile gorusme baslatildi";
            statusClass = "text-success";

            // Cift yazim: lokal DB + backend'e "cevaplandi" bilgisi
            if (currentCallUid.HasValue)
            {
                try { await CallSync.AnswerCallAsync(currentCallUid.Value, currentCallId); }
                catch { }
            }

            callStartTime = DateTime.Now;
            callTimer = new System.Timers.Timer(1000);
            callTimer.Elapsed += (s, e) =>
            {
                var elapsed = DateTime.Now - callStartTime;
                callDuration = elapsed.ToString(@"mm\:ss");
                _ = InvokeAsync(StateHasChanged);
            };
            callTimer.Start();

            StateHasChanged();
        });
    }

    private async Task HandleCallEnded()
    {
        await InvokeAsync(async () =>
        {
            StopTimer();
            isCallStarting = false;
            lines = (await SipService.GetLinesAsync()).ToList();

            // Cift yazim: lokal DB + backend'e "bitti" bilgisi
            if (currentCallUid.HasValue)
            {
                try
                {
                    string? recordingPath = SipService.IsRecording ? null : GetLastRecordingPath();
                    await CallSync.EndCallAsync(currentCallUid.Value, currentCallId, recordingPath);
                }
                catch { }
                currentCallId = null;
                currentCallUid = null;
            }

            statusMessage = $"Arama sonlandirildi ({callDuration})";
            statusClass = "text-muted";
            callDuration = "00:00";

            await HubService.UpdateStatusAsync(AgentStatuses.Ids.AfterCallWork);
            StateHasChanged();
        });

        _ = Task.Run(async () =>
        {
            await Task.Delay(5000);
            await HubService.UpdateStatusAsync(AgentStatuses.Ids.Available);
        });
    }

    /// <summary>Son ses kaydi dosya yolunu alir (NativeSipService'ten)</summary>
    private string? GetLastRecordingPath()
    {
        // SipService kayit dosyasini %LOCALAPPDATA%\CallCenter\Recordings altina yazar
        // Bu metod henuz recording entegrasyonu yapilinca detaylandirilacak
        return null;
    }

    private async Task HandleCallFailed(string error)
    {
        await InvokeAsync(() =>
        {
            StopTimer();
            isCallStarting = false;
            statusMessage = "Arama basarisiz: " + error;
            statusClass = "text-danger";
            callDuration = "00:00";
            Toast.ShowError($"Arama basarisiz: {error}");
            StateHasChanged();
        });
    }

    private async Task HandleLineChanged(int lineIndex)
    {
        await InvokeAsync(async () =>
        {
            lines = (await SipService.GetLinesAsync()).ToList();
            StateHasChanged();
        });
    }

    private Task HandleMuteChanged(bool muted)
    {
        return InvokeAsync(StateHasChanged);
    }

    // ─── Keypad ───

    private void PressKey(string key)
    {
        phoneNumber += key;
        if (SipService.IsInCall && !isCallStarting)
        {
            _ = SipService.SendDtmfAsync(key);
        }
    }

    private void ClearNumber() => phoneNumber = "";

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(phoneNumber) && !SipService.IsInCall)
            _ = StartCall();
    }

    // ─── Call Actions ───

    private async Task StartCall()
    {
        if (string.IsNullOrWhiteSpace(phoneNumber) || !SipService.IsRegistered) return;

        isCallStarting = true;
        statusMessage = $"{phoneNumber} araniyor...";
        statusClass = "text-info";

        try
        {
            // Cift yazim: hem lokal DB'ye hem backend'e yazar
            var syncResult = await CallSync.StartCallAsync("me", phoneNumber);
            currentCallUid = syncResult.Uid;
            currentCallId = syncResult.BackendCallId;

            var success = await SipService.MakeCallAsync(phoneNumber);
            StateHasChanged(); // Arama basladi — UI'yi hemen guncelle (Kapat butonu gosterilsin)
            if (!success)
            {
                // SIP basarisiz → cagriyi "missed" olarak isaretle
                if (currentCallUid.HasValue)
                {
                    await CallSync.MissCallAsync(currentCallUid.Value, currentCallId);
                }
                currentCallId = null;
                currentCallUid = null;
                isCallStarting = false;
                statusMessage = "Arama baslatilamadi";
                statusClass = "text-danger";
                Toast.ShowError("Arama baslatilamadi. GoIP cihazi aramayi reddetti veya codec uyumsuzlugu var.");
                await HubService.UpdateStatusAsync(AgentStatuses.Ids.Available);
            }
        }
        catch (Exception ex)
        {
            isCallStarting = false;
            statusMessage = "Arama hatasi: " + ex.Message;
            statusClass = "text-danger";
            Toast.ShowError($"Arama hatasi: {ex.Message}");
            currentCallId = null;
            currentCallUid = null;
        }
    }

    private async Task StartCallOnNewLine()
    {
        if (string.IsNullOrWhiteSpace(phoneNumber) || !SipService.IsRegistered) return;

        var success = await SipService.MakeCallOnNewLineAsync(phoneNumber);
        if (!success)
        {
            statusMessage = "Yeni hatta arama baslatilamadi (tum hatlar dolu olabilir)";
            statusClass = "text-danger";
        }
    }

    private async Task ToggleHold()
    {
        if (SipService.IsOnHold)
        {
            var success = await SipService.UnholdAsync();
            if (success) { statusMessage = "Gorusme devam ediyor"; statusClass = "text-success"; }
        }
        else
        {
            var success = await SipService.HoldAsync();
            if (success) { statusMessage = "Arama beklemede..."; statusClass = "text-warning"; }
        }
    }

    private async Task EndCall() => await SipService.HangupAsync();

    // ─── Quick Actions ───

    private void ToggleDnd()
    {
        SipService.SetDnd(!SipService.IsDndEnabled);
        Toast.ShowInfo(SipService.IsDndEnabled ? "DND aktif — gelen aramalar reddedilecek" : "DND kapatildi");
    }

    private void ToggleAutoAnswer()
    {
        SipService.SetAutoAnswer(!SipService.IsAutoAnswerEnabled);
        Toast.ShowInfo(SipService.IsAutoAnswerEnabled ? "Otomatik cevap aktif" : "Otomatik cevap kapatildi");
    }

    private async Task ToggleMute()
    {
        if (SipService.IsMuted)
            await SipService.UnmuteAsync();
        else
            await SipService.MuteAsync();
    }

    private async Task ToggleRecording()
    {
        if (SipService.IsRecording)
        {
            await SipService.StopRecordingAsync();
            Toast.ShowInfo("Kayit durduruldu");
        }
        else
        {
            await SipService.StartRecordingAsync();
            Toast.ShowInfo("Kayit baslatildi");
        }
    }

    private async Task DialVoicemail()
    {
        await SipService.DialVoicemailAsync();
    }

    private async Task SwitchLine(int lineIndex)
    {
        await SipService.SwitchLineAsync(lineIndex);
        lines = await SipService.GetLinesAsync();
    }

    // ─── Volume ───

    private void OnMicVolumeChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
            SipService.SetMicrophoneVolume(val / 100f);
    }

    private void OnSpeakerVolumeChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
            SipService.SetSpeakerVolume(val / 100f);
    }

    private async Task OnInputDeviceChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var idx))
        {
            selectedInputDevice = idx;
            await SipService.SetAudioInputDeviceAsync(idx);
            var devName = inputDevices.FirstOrDefault(d => d.DeviceIndex == idx)?.DeviceName ?? idx.ToString();
            Toast.ShowInfo($"Mikrofon: {devName} (sonraki aramada gecerli)");
        }
    }

    private async Task OnOutputDeviceChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var idx))
        {
            selectedOutputDevice = idx;
            await SipService.SetAudioOutputDeviceAsync(idx);
            var devName = outputDevices.FirstOrDefault(d => d.DeviceIndex == idx)?.DeviceName ?? idx.ToString();
            Toast.ShowInfo($"Hoparlor: {devName} (sonraki aramada gecerli)");
        }
    }

    // ─── Transfer ───

    private void OpenTransfer() => showTransferDialog = true;
    private void CloseTransferDialog() => showTransferDialog = false;

    private async Task HandleTransferred(bool success)
    {
        showTransferDialog = false;
        if (success)
        {
            lines = await SipService.GetLinesAsync();
        }
    }

    // ─── Timer ───

    private void StopTimer()
    {
        callTimer?.Stop();
        callTimer?.Dispose();
        callTimer = null;
    }

    public async ValueTask DisposeAsync()
    {
        SipService.OnRegistered -= HandleSipRegistered;
        SipService.OnRegistrationFailed -= HandleSipRegistrationFailed;
        SipService.OnCallAnswered -= HandleCallAnswered;
        SipService.OnCallEnded -= HandleCallEnded;
        SipService.OnCallFailed -= HandleCallFailed;
        SipService.OnLineChanged -= HandleLineChanged;
        SipService.OnMuteChanged -= HandleMuteChanged;
        StopTimer();
    }
}
