@page "/dialer"
@page "/dashboard"
@page "/"
@attribute [Authorize]
@inject CallCenter.Windows.Services.WindowsHubService HubService
@inject CallCenter.Windows.Services.ISipService SipService
@inject HttpClient Http
@inject CallCenter.Windows.Services.ToastService Toast
@inject CallCenter.Windows.Services.CallSyncService CallSync
@inject CallCenter.Windows.Services.WindowsPermissionService PermService
@inject CallCenter.Windows.Services.SecureStorage Storage
@inject NavigationManager NavigationManager
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject CallCenter.Windows.Services.ContactService ContactService
@using CallCenter.Shared.Enums
@using CallCenter.Shared.DTOs
@using CallCenter.Windows.Models
@using CallCenter.Shared.Helpers
@using System.IO
@implements IAsyncDisposable

@if (isAdminRole)
{
    <div class="alert alert-warning d-flex align-items-center">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <span>Firma Yoneticisi rolundeki kullanicilar arama yapamaz. Arama yapmak icin Operator veya Ekip Lideri rolune gecin.</span>
    </div>
}

@if (!string.IsNullOrEmpty(_storageWarning))
{
    <div class="alert alert-warning alert-dismissible d-flex align-items-center py-1 px-2 mb-1" style="font-size:0.75rem;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <span>@_storageWarning</span>
    </div>
}

<div class="single-page-layout" style="@(isAdminRole ? "opacity: 0.5; pointer-events: none;" : "")">
    @* ═══ SOL: DIALER ═══ *@
    <div class="dialer-section">
        <div class="dialer-card">
                <div class="dialer-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5><i class="bi bi-telephone-fill me-2"></i>Cagri Takip</h5>
                        <div class="d-flex align-items-center gap-2">
                            @if (_gateways.Count > 1)
                            {
                                <select class="form-select form-select-sm" style="width:auto;max-width:160px;"
                                        value="@_selectedGatewayId" @onchange="OnGatewayChanged"
                                        disabled="@(IsCallActive || _isSwitchingGateway)">
                                    @foreach (var gw in _gateways)
                                    {
                                        <option value="@gw.Id">@gw.Name (@gw.Transport)</option>
                                    }
                                </select>
                            }
                            else if (_activeSipInfo != null)
                            {
                                <span class="badge bg-info text-dark" title="Aktif gateway">
                                    <i class="bi bi-hdd-network me-1"></i>@_activeSipInfo.GatewayName
                                </span>
                            }
                            <span class="badge @(SipService.IsRegistered ? "bg-success" : "bg-secondary") sip-badge">
                                <i class="bi @(SipService.IsRegistered ? "bi-wifi" : "bi-wifi-off") me-1"></i>
                                @(SipService.IsRegistered ? "SIP Kayitli" : sipStatusText)
                            </span>
                        </div>
                    </div>
                </div>

                @* ─── Hizli Eylem Butonlari ─── *@
                <div class="quick-actions d-flex gap-1 mb-2">
                    <button class="btn btn-sm @(SipService.IsDndEnabled ? "btn-danger" : "btn-outline-secondary") quick-btn"
                            @onclick="ToggleDnd" title="Rahatsiz Etmeyin">
                        <i class="bi bi-moon-fill"></i>
                        <span class="d-none d-md-inline ms-1">DND</span>
                    </button>
                    <button class="btn btn-sm @(SipService.IsAutoAnswerEnabled ? "btn-success" : "btn-outline-secondary") quick-btn"
                            @onclick="ToggleAutoAnswer" title="Otomatik Cevap">
                        <i class="bi bi-lightning-fill"></i>
                        <span class="d-none d-md-inline ms-1">Oto</span>
                    </button>
                    @if (IsCallActive)
                    {
                        <button class="btn btn-sm @(SipService.IsMuted ? "btn-warning" : "btn-outline-secondary") quick-btn"
                                @onclick="ToggleMute" title="Sustur">
                            <i class="bi @(SipService.IsMuted ? "bi-mic-mute-fill" : "bi-mic-fill")"></i>
                            <span class="d-none d-md-inline ms-1">@(SipService.IsMuted ? "Acik" : "Kapa")</span>
                        </button>
                        <button class="btn btn-sm @(SipService.IsRecording ? "btn-danger recording-pulse" : "btn-outline-secondary") quick-btn position-relative"
                                @onclick="ToggleRecording" title="@(_autoRecordEnabled ? "Otomatik kayit aktif" : "Kayit")"
                                disabled="@_autoRecordEnabled">
                            <i class="bi bi-record-circle-fill"></i>
                            <span class="d-none d-md-inline ms-1">Kayit</span>
                            @if (_autoRecordEnabled)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-info"
                                      style="font-size: 0.55rem;">OTO</span>
                            }
                        </button>
                    }
                    <span class="btn btn-sm @(_autoRecordEnabled ? "btn-info" : "btn-outline-secondary") quick-btn"
                          title="@(_autoRecordEnabled ? "Otomatik kayit aktif (admin tarafindan)" : "Otomatik kayit kapali")"
                          style="cursor: default;">
                        <i class="bi bi-record-circle-fill me-1"></i>
                        <span class="d-none d-md-inline">OTO</span>
                    </span>
                    @if (SipService.VoicemailCount > 0)
                    {
                        <button class="btn btn-sm btn-outline-info quick-btn position-relative"
                                @onclick="DialVoicemail" title="Sesli Mesaj">
                            <i class="bi bi-voicemail"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                  style="font-size: 0.6rem;">
                                @SipService.VoicemailCount
                            </span>
                        </button>
                    }
                </div>

                @* ─── Volume Kontrol ─── *@
                <div class="audio-controls mb-2 px-2">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-mic-fill text-muted small" title="Mikrofon"></i>
                        <input type="range" class="form-range form-range-sm flex-grow-1"
                               min="0" max="100" step="5"
                               value="@((int)(SipService.MicrophoneVolume * 100))"
                               @oninput="OnMicVolumeChange" />
                        <span class="text-muted" style="font-size:0.65rem;min-width:30px;">@((int)(SipService.MicrophoneVolume * 100))%</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-speaker-fill text-muted small" title="Hoparlor"></i>
                        <input type="range" class="form-range form-range-sm flex-grow-1"
                               min="0" max="100" step="5"
                               value="@((int)(SipService.SpeakerVolume * 100))"
                               @oninput="OnSpeakerVolumeChange" />
                        <span class="text-muted" style="font-size:0.65rem;min-width:30px;">@((int)(SipService.SpeakerVolume * 100))%</span>
                    </div>
                </div>

                @* ─── Numara Gosterge ─── *@
                <div class="number-display">
                    <input type="text" class="form-control number-input"
                           @bind="phoneNumber" @bind:event="oninput"
                           placeholder="Numara girin..."
                           @onkeydown="HandleKeyDown" />
                    @if (!string.IsNullOrEmpty(phoneNumber))
                    {
                        <button class="btn btn-link clear-btn" @onclick="ClearNumber">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                    <button class="btn btn-link contacts-btn" title="Rehberden Sec" @onclick="OpenContactPicker">
                        <i class="bi bi-person-vcard-fill"></i>
                    </button>
                </div>

                @* ─── Tus Takimi ─── *@
                <div class="keypad">
                    @foreach (var row in keypadRows)
                    {
                        <div class="keypad-row">
                            @foreach (var key in row)
                            {
                                <button class="keypad-btn" @onclick="() => PressKey(key.digit)">
                                    <span class="digit">@key.digit</span>
                                    @if (!string.IsNullOrEmpty(key.letters))
                                    {
                                        <span class="letters">@key.letters</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                </div>

                @* ─── Arama Butonlari ─── *@
                <div class="call-actions">
                    @if (!IsCallActive)
                    {
                        <button class="btn call-btn call-start"
                                disabled="@(string.IsNullOrWhiteSpace(phoneNumber) || !SipService.IsRegistered)"
                                @onclick="StartCall">
                            <i class="bi bi-telephone-fill"></i>
                            <span>Ara</span>
                        </button>
                    }
                    else
                    {
                        <div class="in-call-actions">
                            @if (IsCallActive && !isCallStarting)
                            {
                                <button class="btn call-btn @(SipService.IsOnHold ? "call-resume" : "call-hold")"
                                        @onclick="ToggleHold">
                                    <i class="bi @(SipService.IsOnHold ? "bi-play-circle-fill" : "bi-pause-circle-fill")"></i>
                                    <span>@(SipService.IsOnHold ? "Devam" : "Beklet")</span>
                                </button>
                                <button class="btn call-btn btn-outline-info" @onclick="OpenTransfer"
                                        title="Transfer">
                                    <i class="bi bi-arrow-left-right"></i>
                                    <span>Transfer</span>
                                </button>
                            }
                            <button class="btn call-btn call-end" @onclick="EndCall">
                                <i class="bi bi-telephone-x-fill"></i>
                                <span>@(isCallStarting ? "Iptal" : "Kapat")</span>
                            </button>
                        </div>
                        @if (isCallStarting)
                        {
                            <div class="call-timer mt-2 text-info">
                                <i class="bi bi-telephone-outbound-fill"></i>
                                <span>Araniyor...</span>
                            </div>
                        }
                        else
                        {
                            <div class="call-timer mt-2">
                                <i class="bi bi-clock"></i>
                                <span>@callDuration</span>
                            </div>
                        }
                    }
                </div>

                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <div class="status-message @statusClass">
                        @statusMessage
                    </div>
                }
            </div>

        @* ─── Aktif Aramalar Gostergesi ─── *@
        @{
            var activeLines = lines.Where(l => l.State is LineState.Connected or LineState.OnHold or LineState.Ringing or LineState.Connecting or LineState.TransferPending).ToList();
        }
        @if (activeLines.Count > 1)
        {
            <div class="line-panel">
                <div class="line-panel-header">Aktif Aramalar</div>
                @foreach (var lineInfo in activeLines)
                {
                    var idx = lineInfo.Index;
                    var isActive = idx == SipService.ActiveLineIndex;
                    var stateClass = lineInfo.State switch
                    {
                        LineState.Ringing => "line-ringing",
                        LineState.Connected => "line-connected",
                        LineState.OnHold => "line-hold",
                        LineState.Connecting => "line-connecting",
                        LineState.TransferPending => "line-transfer",
                        _ => "line-idle"
                    };
                    <button class="line-item @stateClass @(isActive ? "line-active" : "")"
                            @onclick="() => SwitchLine(idx)"
                            title="@(lineInfo.RemoteParty ?? "...")">
                        <span class="line-remote">@(lineInfo.RemoteParty ?? "...")</span>
                        @if (lineInfo.State == LineState.OnHold)
                        {
                            <span class="line-status-badge">Beklemede</span>
                        }
                    </button>
                }
            </div>
        }
    </div>

    @* ═══ SAG: PANEL (Rehber / Gecmis / Notlar) ═══ *@
    <div class="side-panel">
        <ul class="nav nav-tabs nav-tabs-sm">
            <li class="nav-item">
                <button class="nav-link @(sideTab == "contacts" ? "active" : "")" @onclick='() => sideTab = "contacts"'>
                    <i class="bi bi-person-vcard-fill me-1"></i>Rehber
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(sideTab == "tasks" ? "active" : "")" @onclick='() => sideTab = "tasks"'>
                    <i class="bi bi-clipboard-check me-1"></i>Gorevler
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(sideTab == "history" ? "active" : "")" @onclick='() => sideTab = "history"'>
                    <i class="bi bi-clock-history me-1"></i>Gecmis
                </button>
            </li>
            @if (showNotesPanel)
            {
                <li class="nav-item">
                    <button class="nav-link @(sideTab == "notes" ? "active" : "")" @onclick='() => sideTab = "notes"'>
                        <i class="bi bi-journal-text me-1"></i>Notlar
                        @if (!string.IsNullOrWhiteSpace(callNotes))
                        {
                            <span class="badge bg-primary rounded-pill ms-1" style="font-size:0.6rem;">@callNotes.Length</span>
                        }
                    </button>
                </li>
            }
        </ul>
        <div class="side-panel-body">
            <div style="display: @(sideTab == "tasks" ? "block" : "none")">
                <TasksPanel OnCallRequested="HandleCallFromContact" />
            </div>
            <div style="display: @(sideTab == "contacts" ? "block" : "none")">
                <ContactsPanel OnCallRequested="HandleCallFromContact" />
            </div>
            <div style="display: @(sideTab == "history" ? "block" : "none")">
                <HistoryPanel />
            </div>
            @if (showNotesPanel)
            {
                <div style="display: @(sideTab == "notes" ? "block" : "none")">
                    <div class="notes-panel-inline">
                        <textarea class="notes-textarea" placeholder="Cagri ile ilgili notlarinizi buraya yazin..."
                                  @bind="callNotes" @bind:event="oninput" @bind:after="OnNotesChanged"></textarea>
                        <div class="notes-panel-footer">
                            <span class="text-muted" style="font-size: 0.65rem;">
                                @if (!string.IsNullOrEmpty(callNotes))
                                {
                                    @($"{callNotes.Length} karakter")
                                }
                            </span>
                            <button class="btn btn-sm btn-primary notes-save-btn" @onclick="SaveNotesToServer"
                                    disabled="@(isNotesSaving || string.IsNullOrWhiteSpace(callNotes))">
                                @if (isNotesSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                else if (isNotesSavedToServer)
                                {
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                }
                                else
                                {
                                    <i class="bi bi-cloud-upload me-1"></i>
                                }
                                <span>@(isNotesSavedToServer ? "Kaydedildi" : "Kaydet")</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* ─── Rehber Secici ─── *@
@if (showContactPicker)
{
    <div class="contact-picker-backdrop" @onclick="CloseContactPicker"></div>
    <div class="contact-picker">
        <div class="contact-picker-header">
            <h6 class="mb-0"><i class="bi bi-person-vcard-fill me-2"></i>Rehberden Sec</h6>
            <button class="btn btn-sm btn-link" @onclick="CloseContactPicker"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="contact-picker-search">
            <input type="text" class="form-control form-control-sm" placeholder="Ara..."
                   @bind="contactSearch" @bind:event="oninput" @onkeyup="SearchContacts" />
        </div>
        <div class="contact-picker-list">
            @if (contactResults == null)
            {
                <div class="text-center text-muted py-3">
                    <div class="spinner-border spinner-border-sm" role="status"></div>
                </div>
            }
            else if (contactResults.Count == 0)
            {
                <div class="text-center text-muted py-3 small">Sonuc bulunamadi</div>
            }
            else
            {
                @foreach (var c in contactResults)
                {
                    <button class="contact-pick-item" @onclick="() => PickContact(c)">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-person-circle text-muted"></i>
                            <div>
                                <div class="fw-medium small">@c.FullName</div>
                                <div class="text-muted" style="font-size:0.75rem;">@c.PhoneNumber</div>
                            </div>
                        </div>
                    </button>
                }
            }
        </div>
    </div>
}

@* ─── Transfer Dialog ─── *@
<CallCenter.Windows.Components.TransferDialog IsVisible="showTransferDialog"
    OnClosed="CloseTransferDialog" OnTransferred="HandleTransferred" />

@code {
    private string _phoneNumber = "";
    private string phoneNumber
    {
        get => _phoneNumber;
        set => _phoneNumber = PhoneHelper.Sanitize(value);
    }
    private bool isCallStarting;
    private string statusMessage = "";
    private string statusClass = "";
    private string callDuration = "00:00";
    private string sipStatusText = "Baglaniyor...";
    private System.Timers.Timer? callTimer;
    private DateTime callStartTime;
    private int? currentCallId;
    private Guid? currentCallUid;       // Lokal DB referansi (cift yazim)
    private bool showTransferDialog;
    private bool _autoRecordEnabled;
    private string? _storageWarning;
    private bool isAdminRole;
    private List<LineInfo> lines = new();
    private bool showContactPicker;
    private SipConnectionInfoDto? _activeSipInfo;
    private List<SipGatewaySummaryDto> _gateways = new();
    private int _selectedGatewayId;
    private bool _isSwitchingGateway;
    private string sideTab = "contacts";
    private string contactSearch = "";
    private List<ContactDto>? contactResults;
    private string callNotes = "";
    private bool showNotesPanel;
    private bool isNotesSaving;
    private bool isNotesSavedToServer;
    private Guid? notesCallUid;
    private int? notesCallId;
    private System.Timers.Timer? notesDebounceTimer;

    private readonly (string digit, string letters)[][] keypadRows = new[]
    {
        new[] { ("1", ""), ("2", "ABC"), ("3", "DEF") },
        new[] { ("4", "GHI"), ("5", "JKL"), ("6", "MNO") },
        new[] { ("7", "PQRS"), ("8", "TUV"), ("9", "WXYZ") },
        new[] { ("*", ""), ("0", "+"), ("#", "") }
    };

    protected override async Task OnInitializedAsync()
    {
        // Modul guard + admin rol kontrolu
        await PermService.LoadAsync();
        isAdminRole = PermService.CustomerRoleId != CustomerRoles.Ids.Operator;

        if (!PermService.HasModule(PortalModules.Ids.Calls))
        {
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        SipService.OnRegistered += HandleSipRegistered;
        SipService.OnRegistrationFailed += HandleSipRegistrationFailed;
        SipService.OnCallAnswered += HandleCallAnswered;
        SipService.OnCallEnded += HandleCallEnded;
        SipService.OnCallFailed += HandleCallFailed;
        SipService.OnLineChanged += HandleLineChanged;
        SipService.OnMuteChanged += HandleMuteChanged;

        lines = await SipService.GetLinesAsync();

        // Sifreleme anahtarini SIP servisine aktar
        var encKey = Configuration["Encryption:Key"];
        if (!string.IsNullOrEmpty(encKey))
            SipService.SetEncryptionKey(encKey);

        // Depolama ve otomatik kayit ayarlarini API'den yukle
        try
        {
            var targets = await Http.GetFromJsonAsync<CallCenter.Shared.DTOs.RecordingUploadTargetsDto>("api/recordings/upload-targets");
            _autoRecordEnabled = targets?.AutoRecordCalls ?? false;

            if (targets != null && !targets.UploadToPlatform && !targets.UploadToCustomerStorage)
                _storageWarning = "Depolama ayari yapilmamis! Ses kayitlari sadece bu bilgisayarda kalacak.";
        }
        catch { _autoRecordEnabled = false; }

        // Kayitli volume degerlerini yukle
        var savedMicVol = await Storage.GetAsync("audio_mic_volume");
        var savedSpkVol = await Storage.GetAsync("audio_spk_volume");
        if (savedMicVol != null && int.TryParse(savedMicVol, out var micVol))
            SipService.SetMicrophoneVolume(micVol / 100f);
        if (savedSpkVol != null && int.TryParse(savedSpkVol, out var spkVol))
            SipService.SetSpeakerVolume(spkVol / 100f);

        if (SipService.IsRegistered)
        {
            sipStatusText = "SIP Kayitli";
            return;
        }

        await InitializeSip();
    }

    private static readonly string SipCachePath = Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
        "CallCenter", "Data", "sip-connection.json");

    private async Task InitializeSip()
    {
        try
        {
            SipConnectionInfoDto? sipInfo = null;

            // 1. Lokal dosyadan hizli yukle
            try
            {
                if (File.Exists(SipCachePath))
                {
                    var json = await File.ReadAllTextAsync(SipCachePath);
                    sipInfo = System.Text.Json.JsonSerializer.Deserialize<SipConnectionInfoDto>(json);
                }
            }
            catch { /* bozuk dosya — API'den alacagiz */ }

            // 2. Gateway listesini yukle (hibrit destek — birden fazla gateway)
            try
            {
                var gwResponse = await Http.GetAsync("api/sipaccounts/my/gateways");
                if (gwResponse.IsSuccessStatusCode)
                    _gateways = await gwResponse.Content.ReadFromJsonAsync<List<SipGatewaySummaryDto>>() ?? new();
            }
            catch { /* gateway listesi alinamazsa tek gateway ile devam */ }

            // 3. API'den hat al (gatewayId varsa o gateway'den)
            try
            {
                sipStatusText = "API'den hat isteniyor...";
                StateHasChanged();

                var connUrl = _selectedGatewayId > 0
                    ? $"api/sipaccounts/my/connection?gatewayId={_selectedGatewayId}"
                    : "api/sipaccounts/my/connection";
                var response = await Http.GetAsync(connUrl);
                if (response.IsSuccessStatusCode)
                {
                    var apiInfo = await response.Content.ReadFromJsonAsync<SipConnectionInfoDto>();
                    if (apiInfo != null)
                    {
                        sipInfo = apiInfo;
                        _selectedGatewayId = apiInfo.SipAccountId;
                        // Lokale kaydet
                        var dir = Path.GetDirectoryName(SipCachePath)!;
                        if (!Directory.Exists(dir)) Directory.CreateDirectory(dir);
                        await File.WriteAllTextAsync(SipCachePath,
                            System.Text.Json.JsonSerializer.Serialize(sipInfo));
                    }
                }
                else
                {
                    Console.WriteLine($"[Dialer] API hat istegi basarisiz: {response.StatusCode}");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Dialer] API erisim hatasi: {ex.Message}");
                // API erisim yok — lokal varsa onunla devam
            }

            if (sipInfo == null)
            {
                sipStatusText = "SIP Yok";
                statusMessage = "Gateway tanimli degil. Portal SIP Ayarlarindan ekleyin.";
                statusClass = "text-warning";
                return;
            }

            _activeSipInfo = sipInfo;
            if (_selectedGatewayId == 0)
                _selectedGatewayId = sipInfo.SipAccountId;
            sipStatusText = $"Kayit olunuyor... ({sipInfo.AuthUsername}@{sipInfo.SipUri?.Split('@').LastOrDefault()})";
            statusMessage = $"Transport: {sipInfo.Transport}";
            StateHasChanged();

            Console.WriteLine($"[Dialer] SIP register baslatiliyor: {sipInfo.AuthUsername} -> {sipInfo.SipUri} (Transport={sipInfo.Transport})");
            await SipService.InitializeAsync(sipInfo);
        }
        catch (Exception ex)
        {
            sipStatusText = "SIP Hata";
            statusMessage = "SIP baglanti hatasi: " + ex.Message;
            statusClass = "text-danger";
        }
    }

    private async Task OnGatewayChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var newGatewayId) || newGatewayId == _selectedGatewayId)
            return;

        if (IsCallActive)
        {
            Toast.ShowWarning("Aktif arama sirasinda gateway degistirilemez.");
            return;
        }

        _isSwitchingGateway = true;
        _selectedGatewayId = newGatewayId;
        sipStatusText = "Gateway degistiriliyor...";
        StateHasChanged();

        try
        {
            // Mevcut SIP baglantisini kapat
            await SipService.DisposeAsync();

            // Event handler'lari yeniden bagla (DisposeAsync sonrasi)
            SipService.OnRegistered += HandleSipRegistered;
            SipService.OnRegistrationFailed += HandleSipRegistrationFailed;
            SipService.OnCallAnswered += HandleCallAnswered;
            SipService.OnCallEnded += HandleCallEnded;
            SipService.OnCallFailed += HandleCallFailed;
            SipService.OnLineChanged += HandleLineChanged;
            SipService.OnMuteChanged += HandleMuteChanged;

            // Yeni gateway ile tekrar baglan
            await InitializeSip();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Gateway degistirme hatasi: {ex.Message}");
        }
        finally
        {
            _isSwitchingGateway = false;
            StateHasChanged();
        }
    }

    // ─── SIP Event Handlers ───

    private async Task HandleSipRegistered()
    {
        sipStatusText = "SIP Kayitli";
        statusMessage = "";

        // Gateway saglik bilgisini hub'a bildir
        await HubService.UpdateGatewayHealthAsync(new GatewayHealthUpdate
        {
            IsRegistered = true,
            GatewayName = _activeSipInfo?.DisplayName,
            SipServer = _activeSipInfo?.SipUri,
            Transport = _activeSipInfo?.Transport ?? "UDP"
        });

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleSipRegistrationFailed(string error)
    {
        sipStatusText = "SIP Hata";
        statusMessage = "SIP kayit hatasi: " + error;
        statusClass = "text-danger";

        // Gateway hata bilgisini hub'a bildir
        await HubService.UpdateGatewayHealthAsync(new GatewayHealthUpdate
        {
            IsRegistered = false,
            GatewayName = _activeSipInfo?.DisplayName,
            SipServer = _activeSipInfo?.SipUri,
            Transport = _activeSipInfo?.Transport ?? "UDP",
            ErrorMessage = error
        });

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleCallAnswered()
    {
        await InvokeAsync(async () =>
        {
            isCallStarting = false;
            _callEndedLocally = false;
            _callEndProcessing = false;
            lines = (await SipService.GetLinesAsync()).ToList();

            // Gelen aramada phoneNumber bos olabilir — aktif hattan al
            var activeLine = lines.FirstOrDefault(l => l.State == LineState.Connected);
            if (string.IsNullOrEmpty(phoneNumber) && activeLine != null)
                phoneNumber = activeLine.RemoteParty ?? "";

            statusMessage = $"{phoneNumber} ile gorusme baslatildi";
            statusClass = "text-success";

            // Otomatik kayit
            if (_autoRecordEnabled && !SipService.IsRecording)
            {
                try
                {
                    await SipService.StartRecordingAsync();
                    Toast.ShowInfo("Otomatik kayit baslatildi");
                }
                catch (Exception ex)
                {
                    Toast.ShowError($"Otomatik kayit baslatilamadi: {ex.Message}");
                }
            }

            // Cift yazim: lokal DB + backend'e "cevaplandi" bilgisi
            if (currentCallUid.HasValue)
            {
                try { await CallSync.AnswerCallAsync(currentCallUid.Value, currentCallId); }
                catch { }
            }

            callStartTime = DateTime.Now;
            callTimer = new System.Timers.Timer(1000);
            callTimer.Elapsed += (s, e) =>
            {
                var elapsed = DateTime.Now - callStartTime;
                callDuration = elapsed.ToString(@"mm\:ss");
                _ = InvokeAsync(StateHasChanged);
            };
            callTimer.Start();

            StateHasChanged();
        });
    }

    private bool _callEndProcessing; // Cift tetiklenme korumasi
    private bool _callEndedLocally;  // EndCall/HandleCallEnded sonrasi UI'yi hemen sifirla

    // SipService.IsInCall yerine bunu kullan — EndCall/HandleCallEnded sonrasi hemen false doner
    private bool IsCallActive => !_callEndedLocally && (SipService.IsInCall || isCallStarting);

    private static void DiagLog(string msg)
    {
        try
        {
            var path = System.IO.Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
                "CorpLynk", "dialer-debug.log");
            var line = $"[{DateTime.Now:HH:mm:ss.fff}] {msg}{Environment.NewLine}";
            System.IO.File.AppendAllText(path, line);
        }
        catch { }
    }

    private async Task HandleCallEnded()
    {
        DiagLog("HandleCallEnded CAGIRILDI");
        await InvokeAsync(async () =>
        {
            DiagLog($"InvokeAsync icinde. _callEndProcessing={_callEndProcessing}");
            if (_callEndProcessing) return;
            _callEndProcessing = true;
            _callEndedLocally = true;

            StopTimer();
            isCallStarting = false;

            // ONCE UI'yi guncelle — hicbir await'ten ONCE
            statusMessage = "Arama sonlandirildi";
            statusClass = "text-muted";
            callDuration = "00:00";
            StateHasChanged();
            DiagLog($"UI sifirlandi. IsCallActive={IsCallActive}, IsInCall={SipService.IsInCall}");

            lines = (await SipService.GetLinesAsync()).ToList();

            // Bekleyen notu lokale kaydet
            StopNotesTimer();
            if (currentCallUid.HasValue && !string.IsNullOrWhiteSpace(callNotes))
            {
                try { await CallSync.SaveNotesLocalAsync(currentCallUid.Value, callNotes); }
                catch { }
            }

            var endCallUid = currentCallUid;
            var endCallId = currentCallId;
            var wasRecording = SipService.IsRecording;
            currentCallId = null;
            currentCallUid = null;

            if (wasRecording)
            {
                statusMessage = "Ses kaydi isleniyor...";
                statusClass = "text-info";
                StateHasChanged();
            }

            try { await HubService.UpdateStatusAsync(AgentStatuses.Ids.AfterCallWork); }
            catch (Exception ex) { DiagLog($"HubService hatasi: {ex.Message}"); }

            // Sifreleme + sync arka planda (UI kitlenmesin)
            DiagLog($"HandleCallEnded: endCallUid={endCallUid}, endCallId={endCallId}, wasRecording={wasRecording}");
            if (endCallUid.HasValue)
            {
                _ = Task.Run(async () =>
                {
                    try
                    {
                        DiagLog("HandleCallEnded Task.Run BASLADI");
                        if (wasRecording)
                        {
                            DiagLog("HandleCallEnded: StopRecordingAsync cagriliyor...");
                            var stopTask = Task.Run(async () => await SipService.StopRecordingAsync());
                            if (await Task.WhenAny(stopTask, Task.Delay(15000)) != stopTask)
                            {
                                DiagLog("HandleCallEnded: StopRecordingAsync 15sn TIMEOUT!");
                            }
                            else
                            {
                                DiagLog($"HandleCallEnded: StopRecordingAsync tamamlandi. Path={SipService.LastRecordingPath}");
                            }
                        }

                        string? recordingPath = SipService.LastRecordingPath;
                        DiagLog($"HandleCallEnded: EndCallAsync cagriliyor. uid={endCallUid.Value}, recPath={recordingPath}");
                        await CallSync.EndCallAsync(endCallUid.Value, endCallId, recordingPath);
                        DiagLog("HandleCallEnded: EndCallAsync TAMAMLANDI.");

                        await InvokeAsync(() =>
                        {
                            if (statusMessage == "Ses kaydi isleniyor...")
                            {
                                statusMessage = "Kayit tamamlandi";
                                statusClass = "text-success";
                                StateHasChanged();
                            }
                            _callEndProcessing = false;
                        });
                    }
                    catch (Exception ex)
                    {
                        DiagLog($"HandleCallEnded kayit isleme hatasi: {ex.Message}\n{ex.StackTrace}");
                        await InvokeAsync(() =>
                        {
                            statusMessage = "Kayit isleme hatasi!";
                            statusClass = "text-danger";
                            _callEndProcessing = false;
                            StateHasChanged();
                        });
                    }
                });
            }
            else
            {
                DiagLog("HandleCallEnded: endCallUid NULL — EndCallAsync CAGRILMADI!");
                _callEndProcessing = false;
            }
        });

        _ = Task.Run(async () =>
        {
            await Task.Delay(5000);
            await HubService.UpdateStatusAsync(AgentStatuses.Ids.Available);
        });
    }

