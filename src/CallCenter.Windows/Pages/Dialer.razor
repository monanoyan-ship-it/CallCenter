    // ─── Not Paneli ───

    private void OnNotesChanged()
    {
        isNotesSavedToServer = false;
        notesDebounceTimer?.Stop();
        notesDebounceTimer?.Dispose();
        notesDebounceTimer = new System.Timers.Timer(1000);
        notesDebounceTimer.AutoReset = false;
        notesDebounceTimer.Elapsed += async (s, e) =>
        {
            await SaveNotesLocalAsync();
        };
        notesDebounceTimer.Start();
    }

    private async Task SaveNotesLocalAsync()
    {
        if (!notesCallUid.HasValue) return;

        try
        {
            await CallSync.SaveNotesLocalAsync(notesCallUid.Value, callNotes);
        }
        catch { }
    }

    private async Task SaveNotesToServer()
    {
        if (!notesCallUid.HasValue || string.IsNullOrWhiteSpace(callNotes)) return;

        isNotesSaving = true;
        StateHasChanged();

        try
        {
            StopNotesTimer();
            await CallSync.SaveNotesToServerAsync(notesCallUid.Value, notesCallId, callNotes);
            isNotesSaving = false;
            isNotesSavedToServer = true;
            Toast.ShowInfo("Cagri notu kaydedildi");
        }
        catch
        {
            isNotesSaving = false;
            Toast.ShowError("Not kaydedilemedi");
        }

        StateHasChanged();
    }

    private void CloseNotesPanel()
    {
        StopNotesTimer();
        showNotesPanel = false;
        callNotes = "";
        isNotesSavedToServer = false;
        notesCallUid = null;
        notesCallId = null;
    }

    private void StopNotesTimer()
    {
        notesDebounceTimer?.Stop();
        notesDebounceTimer?.Dispose();
        notesDebounceTimer = null;
    }

    // ─── Timer ───

    private void StopTimer()
    {
        callTimer?.Stop();
        callTimer?.Dispose();
        callTimer = null;
    }

    public async ValueTask DisposeAsync()
    {
        SipService.OnRegistered -= HandleSipRegistered;
        SipService.OnRegistrationFailed -= HandleSipRegistrationFailed;
        SipService.OnCallAnswered -= HandleCallAnswered;
        SipService.OnCallEnded -= HandleCallEnded;
        SipService.OnCallFailed -= HandleCallFailed;
        SipService.OnLineChanged -= HandleLineChanged;
        SipService.OnMuteChanged -= HandleMuteChanged;
        StopTimer();
        StopNotesTimer();

        // Hat tahsisini serbest birak
        try { await Http.PostAsync("api/sipaccounts/my/release", null); }
        catch { /* best effort — SignalR disconnect de yakalayacak */ }
    }
