@inject CallCenter.Windows.Services.ISipService SipService
@inject CallCenter.Windows.Services.SecureStorage Storage

<div class="dropdown">
    <button class="btn btn-link text-muted btn-audio-settings" title="Ses Ayarlari"
            @onclick="ToggleDropdown" @onclick:stopPropagation="true">
        <i class="bi bi-headset"></i>
    </button>

    @if (isOpen)
    {
        <div class="audio-backdrop" @onclick="CloseDropdown"></div>
        <div class="audio-dropdown">
            <div class="audio-dropdown-header">
                <i class="bi bi-headset me-1"></i> Ses Ayarlari
            </div>

            @if (isLoading)
            {
                <div class="text-center p-2">
                    <div class="spinner-border spinner-border-sm" role="status"></div>
                </div>
            }
            else
            {
                @if (microphones.Any())
                {
                    <div class="audio-section">
                        <label class="audio-label">
                            <i class="bi bi-mic-fill me-1"></i>Mikrofon
                        </label>
                        @foreach (var mic in microphones)
                        {
                            <div class="audio-device @(mic.DeviceIndex == selectedMicIndex ? "selected" : "")"
                                 @onclick="() => SelectMic(mic.DeviceIndex)">
                                <i class="bi @(mic.DeviceIndex == selectedMicIndex ? "bi-check-circle-fill text-success" : "bi-circle")"></i>
                                <span>@mic.DeviceName</span>
                            </div>
                        }
                    </div>
                }

                @if (speakers.Any())
                {
                    <div class="audio-section">
                        <label class="audio-label">
                            <i class="bi bi-speaker-fill me-1"></i>Hoparlor
                        </label>
                        @foreach (var spk in speakers)
                        {
                            <div class="audio-device @(spk.DeviceIndex == selectedSpeakerIndex ? "selected" : "")"
                                 @onclick="() => SelectSpeaker(spk.DeviceIndex)">
                                <i class="bi @(spk.DeviceIndex == selectedSpeakerIndex ? "bi-check-circle-fill text-success" : "bi-circle")"></i>
                                <span>@spk.DeviceName</span>
                            </div>
                        }
                    </div>
                }

                @if (!microphones.Any() && !speakers.Any())
                {
                    <div class="text-muted small p-2 text-center">
                        Ses cihazi bulunamadi
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private bool isOpen;
    private bool isLoading;
    private List<CallCenter.Windows.Models.AudioDeviceInfo> microphones = new();
    private List<CallCenter.Windows.Models.AudioDeviceInfo> speakers = new();
    private int selectedMicIndex = -1;
    private int selectedSpeakerIndex = -1;

    protected override async Task OnInitializedAsync()
    {
        // Kayitli cihaz secimlerini yukle
        var savedMic = await Storage.GetAsync("audio_input_device");
        var savedSpk = await Storage.GetAsync("audio_output_device");

        if (savedMic != null && int.TryParse(savedMic, out var micIdx))
            selectedMicIndex = micIdx;
        if (savedSpk != null && int.TryParse(savedSpk, out var spkIdx))
            selectedSpeakerIndex = spkIdx;

        // Kayitli cihazlari SIP servisine uygula
        if (selectedMicIndex >= 0)
            await SipService.SetAudioInputDeviceAsync(selectedMicIndex);
        if (selectedSpeakerIndex >= 0)
            await SipService.SetAudioOutputDeviceAsync(selectedSpeakerIndex);
    }

    private async Task ToggleDropdown()
    {
        isOpen = !isOpen;
        if (isOpen)
            await LoadDevices();
    }

    private void CloseDropdown() => isOpen = false;

    private async Task LoadDevices()
    {
        isLoading = true;
        StateHasChanged();

        microphones = await SipService.GetAudioInputDevicesAsync();
        speakers = await SipService.GetAudioOutputDevicesAsync();

        // Kayitli cihaz hala listede yoksa ilkini sec
        if (selectedMicIndex >= 0 && !microphones.Any(m => m.DeviceIndex == selectedMicIndex) && microphones.Any())
            selectedMicIndex = microphones.First().DeviceIndex;
        if (selectedSpeakerIndex >= 0 && !speakers.Any(s => s.DeviceIndex == selectedSpeakerIndex) && speakers.Any())
            selectedSpeakerIndex = speakers.First().DeviceIndex;

        if (selectedMicIndex == -1 && microphones.Any())
            selectedMicIndex = microphones.First().DeviceIndex;
        if (selectedSpeakerIndex == -1 && speakers.Any())
            selectedSpeakerIndex = speakers.First().DeviceIndex;

        isLoading = false;
    }

    private async Task SelectMic(int deviceIndex)
    {
        selectedMicIndex = deviceIndex;
        await SipService.SetAudioInputDeviceAsync(deviceIndex);
        await Storage.SetAsync("audio_input_device", deviceIndex.ToString());
    }

    private async Task SelectSpeaker(int deviceIndex)
    {
        selectedSpeakerIndex = deviceIndex;
        await SipService.SetAudioOutputDeviceAsync(deviceIndex);
        await Storage.SetAsync("audio_output_device", deviceIndex.ToString());
    }
}
