@inject HttpClient Http
@inject CallCenter.Windows.Services.ToastService Toast
@inject CallCenter.Windows.Services.WindowsHubService HubService
@implements IDisposable
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums

<div class="tasks-panel-inner">
    <div class="nav-tabs-wrapper mb-2">
        <ul class="nav nav-pills nav-justified" style="font-size: 0.75rem;">
            <li class="nav-item">
                <button class="nav-link @(activeTab == "campaign" ? "active" : "")" @onclick='() => SetTab("campaign")'>Kampanya</button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "callback" ? "active" : "")" @onclick='() => SetTab("callback")'>
                    Geri Aramalar
                    @if (callbackItems.Count > 0)
                    {
                        <span class="badge bg-danger ms-1">@callbackItems.Count</span>
                    }
                </button>
            </li>
        </ul>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="text-muted small">
            @if (activeTab == "campaign" && items.Count > 0)
            {
                var pending = items.Count(i => i.StatusId == CampaignContactStatuses.Ids.Pending);
                @($"{pending} bekliyor / {items.Count} toplam")
            }
            else if (activeTab == "callback" && callbackItems.Count > 0)
            {
                @($"{callbackItems.Count} bekleyen arama")
            }
        </span>
        <button class="btn btn-sm btn-outline-secondary border-0" @onclick="LoadList" title="Yenile" disabled="@isLoading">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-4">
            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        </div>
    }
    else
    {
        @if (activeTab == "campaign")
        {
            @if (items.Count == 0)
            {
                <div class="text-center py-4 text-muted small">
                    <i class="bi bi-clipboard-check d-block mb-1" style="font-size: 2rem;"></i>
                    Atanmis kampanya yok
                </div>
            }
            else
            {
                <div class="side-panel-list">
                    @foreach (var item in items)
                    {
                        var status = CampaignContactStatuses.GetById(item.StatusId);
                        var isFinished = CampaignContactStatuses.FinishedIds.Contains(item.StatusId);
                        <div class="task-item @(isFinished ? "task-done" : "") mb-1">
                            <div class="d-flex align-items-start gap-2 p-2 rounded border @(isFinished ? "bg-light" : "bg-white") shadow-sm">
                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <span class="badge @(status?.CssClass ?? "bg-secondary")" style="font-size:0.6rem;">
                                            @(status?.Description ?? "")
                                        </span>
                                        <span class="text-muted" style="font-size:0.6rem;">@item.CampaignName</span>
                                    </div>
                                    <div class="fw-bold small text-truncate">@item.ContactName</div>
                                    <div class="text-muted" style="font-size:0.75rem;">
                                        <i class="bi bi-telephone me-1"></i>@item.PhoneNumber
                                    </div>
                                </div>
                                <div class="d-flex flex-column gap-1 flex-shrink-0">
                                    @if (!isFinished)
                                    {
                                        <button class="btn btn-sm btn-success py-0 px-1" title="Ara" @onclick="() => CallItem(item)">
                                            <i class="bi bi-telephone-fill"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            @if (callbackItems.Count == 0)
            {
                <div class="text-center py-4 text-muted small">
                    <i class="bi bi-check-circle d-block mb-1" style="font-size: 2rem; color: #28a745;"></i>
                    Bekleyen geri arama yok
                </div>
            }
            else
            {
                <div class="side-panel-list">
                    @foreach (var item in callbackItems)
                    {
                        var isInProgress = item.CallbackStatusId == CallbackStatuses.Ids.InProgress;
                        <div class="task-item mb-1">
                            <div class="d-flex align-items-start gap-2 p-2 rounded border bg-white shadow-sm border-start border-4 @(isInProgress ? "border-primary" : "border-danger")">
                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        @if (isInProgress)
                                        {
                                            <span class="badge bg-primary" style="font-size:0.6rem;">ARANIYOR</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark" style="font-size:0.6rem;">BEKLIYOR</span>
                                        }
                                        <span class="text-muted" style="font-size:0.6rem;">@item.StartedAt.ToLocalTime().ToString("dd.MM HH:mm")</span>
                                    </div>
                                    <div class="fw-bold small text-truncate">@item.CallerNumber</div>
                                    @if (!string.IsNullOrEmpty(item.CallbackNote))
                                    {
                                        <div class="text-muted fst-italic mt-1" style="font-size:0.7rem; line-height: 1.1;">
                                            <i class="bi bi-info-circle me-1"></i>@item.CallbackNote
                                        </div>
                                    }
                                </div>
                                <div class="flex-shrink-0">
                                    @if (!isInProgress)
                                    {
                                        <button class="btn btn-sm btn-primary py-1 px-2" title="Geri Ara" @onclick="() => StartCallback(item)">
                                            <i class="bi bi-telephone-outbound-fill"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="spinner-border spinner-border-sm text-primary" title="Arama devam ediyor"></span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    }
</div>

@* Sonuc notu dialog *@
@if (showNoteDialog)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title small">Sonuc Notu</h6>
                    <button type="button" class="btn-close btn-close-sm" @onclick="CloseNoteDialog"></button>
                </div>
                <div class="modal-body py-2">
                    <textarea class="form-control form-control-sm" rows="3" placeholder="Not ekleyin (istege bagli)..."
                              @bind="noteText"></textarea>
                </div>
                <div class="modal-footer py-1">
                    <button class="btn btn-sm btn-secondary" @onclick="CloseNoteDialog">Iptal</button>
                    <button class="btn btn-sm btn-primary" @onclick="ConfirmStatusUpdate">Kaydet</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback<string> OnCallRequested { get; set; }
    [Parameter] public EventCallback<int?> OnActiveCallbackChanged { get; set; }

    private string activeTab = "campaign";
    private List<MyCallListItemDto> items = new();
    private List<PendingCallbackDto> callbackItems = new();
    private bool isLoading;

    private bool showNoteDialog;
    private string noteText = "";
    private int pendingItemId;
    private int pendingStatusId;

    protected override async Task OnInitializedAsync()
    {
        HubService.OnNewCallbackTask += HandleNewCallbackTask;
        HubService.OnCallbackTaskStarted += HandleCallbackUpdate;
        HubService.OnCallbackTaskCompleted += HandleCallbackUpdate;
        HubService.OnCallbackTaskReverted += HandleCallbackUpdate;
        await LoadList();
    }

    private void HandleNewCallbackTask(object data)
    {
        InvokeAsync(async () =>
        {
            await LoadList();
            Toast.ShowInfo("Yeni bir geri arama gorevi atandi.");
        });
    }

    private void HandleCallbackUpdate(object data)
    {
        InvokeAsync(async () => await LoadList());
    }

    public void Dispose()
    {
        HubService.OnNewCallbackTask -= HandleNewCallbackTask;
        HubService.OnCallbackTaskStarted -= HandleCallbackUpdate;
        HubService.OnCallbackTaskCompleted -= HandleCallbackUpdate;
        HubService.OnCallbackTaskReverted -= HandleCallbackUpdate;
    }

    private async Task SetTab(string tab)
    {
        activeTab = tab;
        await LoadList();
    }

    private async Task LoadList()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            if (activeTab == "campaign")
            {
                items = await Http.GetFromJsonAsync<List<MyCallListItemDto>>("api/campaigns/my-list") ?? new();
            }
            else
            {
                callbackItems = await Http.GetFromJsonAsync<List<PendingCallbackDto>>("api/calls/pending-callbacks") ?? new();
            }
        }
        catch { 
            items = new(); 
            callbackItems = new();
        }
        finally { isLoading = false; }
    }

    private async Task CallItem(MyCallListItemDto item)
    {
        await UpdateStatus(item.CampaignContactId, CampaignContactStatuses.Ids.Calling, null);
        await OnCallRequested.InvokeAsync(item.PhoneNumber);
    }

    private async Task StartCallback(PendingCallbackDto item)
    {
        // 1. Callback ID'sini Dialer'a bildir (arama sonucu takibi icin)
        await OnActiveCallbackChanged.InvokeAsync(item.Id);

        // 2. Gorevi uzerine al (InProgress)
        try
        {
            var response = await Http.PostAsync($"api/calls/{item.Id}/start-callback", null);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Toast.ShowError($"Gorev alinamadi: {error}");
                await OnActiveCallbackChanged.InvokeAsync(null);
                return;
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"StartCallback error: {ex.Message}");
            await OnActiveCallbackChanged.InvokeAsync(null);
            return;
        }

        // 3. Aramayi baslat
        await OnCallRequested.InvokeAsync(item.CallerNumber);
    }

    private void MarkStatus(MyCallListItemDto item, int statusId)
    {
        pendingItemId = item.CampaignContactId;
        pendingStatusId = statusId;
        noteText = "";
        showNoteDialog = true;
    }

    private async Task ConfirmStatusUpdate()
    {
        showNoteDialog = false;
        await UpdateStatus(pendingItemId, pendingStatusId, string.IsNullOrWhiteSpace(noteText) ? null : noteText);
        await LoadList();
    }

    private void CloseNoteDialog() => showNoteDialog = false;

    private async Task UpdateStatus(int campaignContactId, int statusId, string? notes)
    {
        try
        {
            var dto = new UpdateCampaignContactStatusRequest
            {
                StatusId = statusId,
                ResultNotes = notes
            };
            await Http.PutAsJsonAsync($"api/campaigns/my-list/{campaignContactId}", dto);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Durum guncellenemedi: {ex.Message}");
        }
    }
}
