@inject CallCenter.Windows.Services.ISipService SipService
@inject CallCenter.Windows.Services.ToastService Toast

@if (IsVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">
                        <i class="bi bi-arrow-left-right me-2"></i>Arama Transfer
                    </h6>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    @* Transfer Turu Secimi *@
                    <div class="btn-group w-100 mb-3" role="group">
                        <button type="button" class="btn btn-sm @(transferType == "blind" ? "btn-primary" : "btn-outline-primary")"
                                @onclick='() => transferType = "blind"'>
                            <i class="bi bi-arrow-right me-1"></i>Blind
                        </button>
                        <button type="button" class="btn btn-sm @(transferType == "attended" ? "btn-primary" : "btn-outline-primary")"
                                @onclick='() => transferType = "attended"'>
                            <i class="bi bi-people-fill me-1"></i>Attended
                        </button>
                    </div>

                    <div class="mb-2">
                        <small class="text-muted">
                            @(transferType == "blind"
                                ? "Arama dogrudan hedefe aktarilir."
                                : "Once hedefle konusursunuz, sonra onaylarsaniz transfer tamamlanir.")
                        </small>
                    </div>

                    @if (!isAttendedInProgress)
                    {
                        <div class="mb-3">
                            <label class="form-label small">Transfer Hedefi</label>
                            <input type="text" class="form-control" placeholder="Numara veya dahili..."
                                   @bind="transferTarget" @bind:event="oninput"
                                   @onkeydown="HandleKeyDown" />
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info small py-2 mb-3">
                            <i class="bi bi-telephone-fill me-1"></i>
                            <strong>@transferTarget</strong> ile gorusuyorsunuz.
                            <br/>Transfer'i tamamlamak veya iptal etmek icin asagidaki butonlari kullanin.
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="text-danger small">@errorMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    @if (!isAttendedInProgress)
                    {
                        <button class="btn btn-sm btn-secondary" @onclick="Close">Iptal</button>
                        <button class="btn btn-sm btn-primary" @onclick="DoTransfer"
                                disabled="@(string.IsNullOrWhiteSpace(transferTarget) || isTransferring)">
                            <i class="bi bi-arrow-left-right me-1"></i>
                            @(isTransferring ? "Transfer ediliyor..." : (transferType == "blind" ? "Transfer Et" : "Hedefi Ara"))
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-danger" @onclick="CancelAttendedTransfer">
                            <i class="bi bi-x-circle me-1"></i>Iptal Et
                        </button>
                        <button class="btn btn-sm btn-success" @onclick="CompleteAttendedTransfer"
                                disabled="@isTransferring">
                            <i class="bi bi-check-circle me-1"></i>Transfer'i Tamamla
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }
    [Parameter] public EventCallback<bool> OnTransferred { get; set; }

    private string transferTarget = "";
    private string transferType = "blind";
    private string errorMessage = "";
    private bool isTransferring;
    private bool isAttendedInProgress;

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(transferTarget))
            _ = DoTransfer();
        else if (e.Key == "Escape")
            _ = Close();
    }

    private async Task DoTransfer()
    {
        if (string.IsNullOrWhiteSpace(transferTarget)) return;

        isTransferring = true;
        errorMessage = "";

        bool success;
        if (transferType == "blind")
        {
            success = await SipService.BlindTransferAsync(transferTarget);
            if (success)
            {
                Toast.ShowSuccess("Arama transfer edildi");
                await OnTransferred.InvokeAsync(true);
                await Close();
            }
            else
            {
                errorMessage = "Transfer baslatilamadi. Hedef numarayi kontrol edin.";
            }
        }
        else
        {
            // Attended: Once hedefi ara
            success = await SipService.AttendedTransferAsync(transferTarget);
            if (success)
            {
                isAttendedInProgress = true;
                Toast.ShowInfo($"{transferTarget} araniyor...");
            }
            else
            {
                errorMessage = "Attended transfer baslatilamadi.";
            }
        }

        isTransferring = false;
    }

    private async Task CompleteAttendedTransfer()
    {
        isTransferring = true;
        var success = await SipService.CompleteAttendedTransferAsync();
        if (success)
        {
            Toast.ShowSuccess("Attended transfer tamamlandi");
            await OnTransferred.InvokeAsync(true);
            await Close();
        }
        else
        {
            errorMessage = "Transfer tamamlanamadi.";
        }
        isTransferring = false;
    }

    private async Task CancelAttendedTransfer()
    {
        await SipService.CancelAttendedTransferAsync();
        isAttendedInProgress = false;
        Toast.ShowWarning("Transfer iptal edildi");
    }

    private async Task Close()
    {
        if (isAttendedInProgress)
        {
            await SipService.CancelAttendedTransferAsync();
        }
        transferTarget = "";
        errorMessage = "";
        isTransferring = false;
        isAttendedInProgress = false;
        transferType = "blind";
        await OnClosed.InvokeAsync();
    }
}
