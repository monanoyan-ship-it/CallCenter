@inject CallCenter.Windows.Services.WindowsHubService HubService
@inject CallCenter.Windows.Services.ISipService SipService
@inject CallCenter.Windows.Services.IncomingCallPipelineService Pipeline
@inject NavigationManager NavigationManager
@using CallCenter.Shared.DTOs
@using CallCenter.Shared.Enums
@implements IDisposable

@if (ivrActive)
{
    <div class="incoming-call-overlay">
        <div class="incoming-call-popup ivr-mode">
            <div class="call-icon-wrapper">
                <div class="call-ring-animation ivr"></div>
                <i class="bi bi-diagram-3-fill call-icon"></i>
            </div>

            <div class="caller-details">
                <span class="call-label">IVR Aktif</span>
                <span class="caller-number">DTMF bekleniyor...</span>
            </div>
        </div>
    </div>
}
else if (incomingCall != null)
{
    <div class="incoming-call-overlay">
        <div class="incoming-call-popup">
            <div class="call-icon-wrapper">
                <div class="call-ring-animation"></div>
                <i class="bi bi-telephone-fill call-icon"></i>
            </div>

            <div class="caller-details">
                <span class="call-label">Gelen Arama</span>
                <span class="caller-number">@(incomingCall.CallerNumber)</span>
                @if (!string.IsNullOrEmpty(incomingCall.QueueName))
                {
                    <span class="call-queue">
                        <i class="bi bi-people-fill me-1"></i>@incomingCall.QueueName
                    </span>
                }
            </div>

            <div class="call-actions">
                <button class="btn call-action-btn accept" @onclick="AcceptCall">
                    <i class="bi bi-telephone-fill"></i>
                    <span>Cevapla</span>
                </button>
                <button class="btn call-action-btn reject" @onclick="RejectCall">
                    <i class="bi bi-telephone-x-fill"></i>
                    <span>Reddet</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    private CallNotification? incomingCall;
    private bool isSipCall;
    private bool ivrActive;

    protected override void OnInitialized()
    {
        HubService.OnIncomingCall += HandleIncomingCall;
        HubService.OnCallEnded += HandleCallEnded;

        // SIP gelen arama artik Pipeline uzerinden yonetiliyor
        SipService.OnIncomingCall += HandleSipIncomingCall;
        SipService.OnCallEnded += HandleSipCallEnded;

        // Pipeline event'leri
        Pipeline.OnShowIncomingCallPopup += HandlePipelineShowPopup;
        Pipeline.OnIvrRouteSelected += HandleIvrRouteSelected;
        Pipeline.OnIvrFallback += HandleIvrFallback;
    }

    private void HandleIncomingCall(CallNotification notification)
    {
        if (notification.StatusId == CallStatuses.Ids.Ringing)
        {
            incomingCall = notification;
            isSipCall = false;
            InvokeAsync(StateHasChanged);
        }
    }

    private void HandleCallEnded(int callId)
    {
        if (incomingCall?.CallId == callId)
        {
            incomingCall = null;
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleSipIncomingCall(string callerUri, string callerDisplay)
    {
        // Pipeline'a yonlendir — IVR kontrolu yapacak
        await Pipeline.HandleIncomingCallAsync(callerUri, callerDisplay);
        ivrActive = Pipeline.IsIvrActive;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Pipeline IVR olmadığında popup göstermemizi ister</summary>
    private Task HandlePipelineShowPopup(string callerUri, string callerDisplay)
    {
        incomingCall = new CallNotification
        {
            CallId = 0,
            CallerNumber = !string.IsNullOrEmpty(callerDisplay) ? callerDisplay : callerUri,
            StatusId = CallStatuses.Ids.Ringing
        };
        isSipCall = true;
        ivrActive = false;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>IVR secenege gore yonlendirme tamamlandi</summary>
    private async Task HandleIvrRouteSelected(int? queueId, string? extension, string? holdMusicPath)
    {
        ivrActive = false;

        // Kuyruga yonlendirme varsa — transfer et
        if (!string.IsNullOrEmpty(extension))
        {
            await SipService.BlindTransferAsync(extension);
        }
        else if (queueId.HasValue)
        {
            // Kuyruk transferi — agent atanana kadar hold muzigi cal
            // TODO: CallDistributionService uzerinden kuyruk yonlendirmesi
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>IVR timeout/fallback — varsayilan kuyruga yonlendir</summary>
    private Task HandleIvrFallback()
    {
        ivrActive = false;
        // TODO: Varsayilan kuyruga yonlendir
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleSipCallEnded()
    {
        if (isSipCall && incomingCall != null)
        {
            incomingCall = null;
            ivrActive = false;
            return InvokeAsync(StateHasChanged);
        }
        if (ivrActive)
        {
            ivrActive = false;
            return InvokeAsync(StateHasChanged);
        }
        return Task.CompletedTask;
    }

    private async Task AcceptCall()
    {
        if (incomingCall == null) return;

        if (isSipCall)
            await SipService.AnswerCallAsync();

        await HubService.UpdateStatusAsync(AgentStatuses.Ids.InCall);

        var callerNumber = incomingCall.CallerNumber;
        incomingCall = null;

        // Dialer sayfasina yonlendir — aramayi yonetebilsin (beklet, kapat, DTMF)
        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (!currentPath.StartsWith("dialer", StringComparison.OrdinalIgnoreCase))
        {
            NavigationManager.NavigateTo($"/dialer?number={Uri.EscapeDataString(callerNumber ?? "")}");
        }
    }

    private async Task RejectCall()
    {
        if (incomingCall == null) return;

        if (isSipCall)
            await SipService.HangupAsync();
        else
            await HubService.NotifyCallEndedAsync(incomingCall.CallId);

        incomingCall = null;
    }

    public void Dispose()
    {
        HubService.OnIncomingCall -= HandleIncomingCall;
        HubService.OnCallEnded -= HandleCallEnded;
        SipService.OnIncomingCall -= HandleSipIncomingCall;
        SipService.OnCallEnded -= HandleSipCallEnded;
        Pipeline.OnShowIncomingCallPopup -= HandlePipelineShowPopup;
        Pipeline.OnIvrRouteSelected -= HandleIvrRouteSelected;
        Pipeline.OnIvrFallback -= HandleIvrFallback;
    }
}
