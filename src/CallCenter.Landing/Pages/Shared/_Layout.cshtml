@{
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var currentLangInfo = LocalizationConstants.Languages.GetValueOrDefault(currentCulture);
    var currentPath = Context.Request.Path.Value ?? "/";

    // URL'den mevcut culture prefix'ini temizle
    var cleanPath = currentPath;
    foreach (var code in LocalizationConstants.SupportedCodes)
    {
        if (cleanPath.StartsWith($"/{code}/", StringComparison.OrdinalIgnoreCase))
        {
            cleanPath = cleanPath[(code.Length + 1)..];
            break;
        }
        if (cleanPath.Equals($"/{code}", StringComparison.OrdinalIgnoreCase))
        {
            cleanPath = "/";
            break;
        }
    }

    var pathSuffix = cleanPath == "/" ? "" : cleanPath;
    var canonicalPath = $"/{currentCulture}{pathSuffix}";
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "CorpLynk — Enterprise Software Solutions")</title>
    <meta name="description" content="@T.T("landing.meta.description", "CorpLynk — Enterprise software solutions. Cloud call center, salon management with online booking, and B2B trade platform. Book your salon appointment online.")" />
    <meta name="keywords" content="salon randevu, online booking, kuafor randevu, guzellik merkezi, call center, B2B trade, CorpLynk" />
    <!-- Canonical & Hreflang -->
    <link rel="canonical" href="https://corplynk.com@(canonicalPath)" />
    @foreach (var lang in LocalizationConstants.Languages.Values)
    {
        <link rel="alternate" hreflang="@lang.Code" href="https://corplynk.com/@(lang.Code)@(pathSuffix)" />
    }
    <link rel="alternate" hreflang="x-default" href="https://corplynk.com@(cleanPath)" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://corplynk.com@(canonicalPath)" />
    <meta property="og:title" content="@(ViewData["Title"] ?? "CorpLynk — Enterprise Software Solutions")" />
    <meta property="og:description" content="@T.T("landing.meta.description", "CorpLynk builds software that connects businesses. Cloud call center, B2B trade platform, and more.")" />
    <meta property="og:site_name" content="CorpLynk" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@@corplynkcmon" />
    <meta name="twitter:title" content="@(ViewData["Title"] ?? "CorpLynk — Enterprise Software Solutions")" />
    <meta name="twitter:description" content="@T.T("landing.meta.description", "CorpLynk builds software that connects businesses. Cloud call center, B2B trade platform, and more.")" />
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @RenderBody()
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function switchLanguage(lang) {
            document.cookie = '.AspNetCore.Culture=c=' + lang + '|uic=' + lang + ';path=/;max-age=31536000';
            window.location.href = '/' + lang + '@(pathSuffix.Replace("'", "\\'"))';
        }
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.lang-dropdown')) {
                var m = document.querySelector('.lang-menu');
                if (m) m.classList.remove('show');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
