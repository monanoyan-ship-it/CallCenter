@{
    var culture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var currentLabel = LocalizationConstants.Languages.GetValueOrDefault(culture)?.Label ?? culture.ToUpperInvariant();
}
<div class="lang-dropdown">
    <span class="lang-toggle nav-btn" style="display:inline-flex;align-items:center;gap:4px;cursor:pointer;"
          onclick="this.nextElementSibling.classList.toggle('show')">
        <i class="bi bi-translate"></i> @currentLabel
    </span>
    <div class="lang-menu">
        @foreach (var lang in LocalizationConstants.Languages.Values)
        {
            <a class="@(lang.Code == culture ? "active" : "")"
               href="javascript:void(0)" onclick="switchLanguage('@lang.Code')">
                @lang.Label — @lang.Name
            </a>
        }
    </div>
</div>
