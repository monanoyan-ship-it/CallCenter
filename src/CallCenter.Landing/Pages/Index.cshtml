@page
@model IndexModel
@{
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var langPrefix = $"/{currentCulture}";
}

<!-- Background -->
<div class="landing-bg">
    <div class="grid-overlay"></div>
</div>

<div class="landing-wrapper">
    <!-- Nav -->
    <nav class="landing-nav">
        <a href="@langPrefix" class="landing-brand">
            <i class="bi bi-hexagon-fill"></i> CorpLynk
        </a>
        <div class="landing-nav-links">
            <a href="#products"><t key="landing.nav.products">Products</t></a>
            <a href="#book"><t key="landing.nav.booking">Book a Salon</t></a>
            <a href="@langPrefix/download"><t key="landing.nav.download">Download</t></a>
            <a href="#about"><t key="landing.nav.about">About</t></a>
            <a href="#contact"><t key="landing.nav.contact">Contact</t></a>
            <a href="https://cc.corplynk.com" class="nav-btn"><t key="landing.nav.signin">Sign In</t></a>
            <partial name="Shared/_LanguageSwitcher" />
        </div>
    </nav>

    <!-- Hero -->
    <main class="landing-main">
        <div class="landing-badge">
            <span class="dot"></span>
            <t key="landing.hero.badge">Enterprise Software Solutions</t>
        </div>

        <h1 class="landing-title">
            <t key="landing.hero.title1">Business Tools,</t><br />
            <span class="gradient-text"><t key="landing.hero.title2">Connected.</t></span>
        </h1>

        <p class="landing-subtitle">
            <t key="landing.hero.subtitle">We build software that connects businesses. Cloud call centers, salon management with online booking — CorpLynk provides the infrastructure your company needs to grow.</t>
        </p>

        <div class="hero-cta">
            <a href="#products" class="cta-btn cta-primary">
                <span><t key="landing.cta.explore">Explore Products</t></span>
                <i class="bi bi-arrow-down"></i>
            </a>
            <a href="#contact" class="cta-btn cta-outline">
                <span><t key="landing.cta.contact">Get in Touch</t></span>
            </a>
        </div>
    </main>

    <!-- Stats -->
    <section class="stats-section">
        <div class="stats-grid">
            <div class="stat-item">
                <div class="stat-number">2</div>
                <div class="stat-label"><t key="landing.stats.products">Products</t></div>
            </div>
            <div class="stat-item">
                <div class="stat-number">SIP</div>
                <div class="stat-label"><t key="landing.stats.voip">VoIP Ready</t></div>
            </div>
            <div class="stat-item">
                <div class="stat-number"><i class="bi bi-scissors"></i></div>
                <div class="stat-label"><t key="landing.stats.salon">Online Booking</t></div>
            </div>
            <div class="stat-item">
                <div class="stat-number">24/7</div>
                <div class="stat-label"><t key="landing.stats.cloud">Cloud Native</t></div>
            </div>
        </div>
    </section>

    <!-- Products -->
    <section class="products-section" id="products">
        <div class="section-header">
            <div class="section-badge"><t key="landing.products.badge">Our Products</t></div>
            <h2 class="section-title"><t key="landing.products.title">Two Platforms, One Vision</t></h2>
            <p class="section-desc"><t key="landing.products.subtitle">Enterprise-grade solutions designed to connect businesses and streamline operations.</t></p>
        </div>

        <div class="products-grid">
            <!-- Call Center -->
            <div class="product-card product-callcenter">
                <div class="product-icon-wrap">
                    <div class="product-icon">
                        <i class="bi bi-headset"></i>
                    </div>
                    <span class="product-status live">Live</span>
                </div>
                <h3 class="product-name"><t key="landing.cc.name">Cloud Call Center</t></h3>
                <p class="product-desc">
                    <t key="landing.cc.desc">Multi-tenant cloud call center with SIP integration, real-time dashboards, intelligent call routing, and encrypted call recordings.</t>
                </p>
                <div class="product-features">
                    <span class="product-tag"><i class="bi bi-telephone-forward"></i> SIP/WebRTC</span>
                    <span class="product-tag"><i class="bi bi-diagram-3"></i> ACD Routing</span>
                    <span class="product-tag"><i class="bi bi-shield-check"></i> KVKK</span>
                    <span class="product-tag"><i class="bi bi-graph-up"></i> Real-Time</span>
                    <span class="product-tag"><i class="bi bi-cloud"></i> Multi-Cloud</span>
                    <span class="product-tag"><i class="bi bi-people"></i> Multi-Tenant</span>
                </div>
                <div class="product-actions">
                    <a href="@langPrefix/call-center" class="product-btn primary">
                        <span><t key="landing.btn.learnmore">Learn More</t></span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                    <a href="https://cc.corplynk.com" class="product-btn outline" target="_blank">
                        <span><t key="landing.btn.openapp">Open App</t></span>
                        <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                </div>
            </div>

            <!-- Salon -->
            <div class="product-card product-salon">
                <div class="product-icon-wrap">
                    <div class="product-icon salon">
                        <i class="bi bi-scissors"></i>
                    </div>
                    <span class="product-status live">Live</span>
                </div>
                <h3 class="product-name"><t key="landing.salon.name">Salon Management</t></h3>
                <p class="product-desc">
                    <t key="landing.salon.desc">Complete salon management platform with appointments, POS, loyalty programs, online booking, staff management, and detailed reports.</t>
                </p>
                <div class="product-features">
                    <span class="product-tag"><i class="bi bi-calendar-check"></i> <t key="landing.salon.tag.appointments">Appointments</t></span>
                    <span class="product-tag"><i class="bi bi-credit-card"></i> POS</span>
                    <span class="product-tag"><i class="bi bi-star"></i> <t key="landing.salon.tag.loyalty">Loyalty</t></span>
                    <span class="product-tag"><i class="bi bi-globe"></i> <t key="landing.salon.tag.booking">Online Booking</t></span>
                    <span class="product-tag"><i class="bi bi-person-badge"></i> <t key="landing.salon.tag.staff">Staff</t></span>
                    <span class="product-tag"><i class="bi bi-bar-chart"></i> <t key="landing.salon.tag.reports">Reports</t></span>
                </div>
                <div class="product-actions">
                    <a href="https://sln.corplynk.com" class="product-btn primary">
                        <span><t key="landing.btn.learnmore">Learn More</t></span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                    <a href="https://sln.corplynk.com" class="product-btn outline" target="_blank">
                        <span><t key="landing.btn.openapp">Open App</t></span>
                        <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                </div>
            </div>

            <!-- B2B Trade — gizli, kendi sayfasi var -->
            <!--
            <div class="product-card product-b2b">
                <div class="product-icon-wrap">
                    <div class="product-icon b2b">
                        <i class="bi bi-globe2"></i>
                    </div>
                    <span class="product-status dev"><t key="landing.status.dev">In Development</t></span>
                </div>
                <h3 class="product-name"><t key="landing.b2b.name">B2B Trade Platform</t></h3>
                <p class="product-desc">
                    <t key="landing.b2b.desc">Next-generation B2B marketplace connecting suppliers, buyers, carriers, and service providers across industries worldwide.</t>
                </p>
                <div class="product-features">
                    <span class="product-tag"><i class="bi bi-shop"></i> Marketplace</span>
                    <span class="product-tag"><i class="bi bi-truck"></i> Logistics</span>
                    <span class="product-tag"><i class="bi bi-shield-lock"></i> Verified</span>
                    <span class="product-tag"><i class="bi bi-chat-dots"></i> Messaging</span>
                    <span class="product-tag"><i class="bi bi-receipt"></i> Orders</span>
                    <span class="product-tag"><i class="bi bi-translate"></i> Multi-Language</span>
                </div>
                <div class="product-actions">
                    <a href="@langPrefix/b2b-trade" class="product-btn primary">
                        <span><t key="landing.btn.learnmore">Learn More</t></span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
            -->
        </div>
    </section>

    <!-- Salon Customers CTA -->
    <section class="salon-cta-section" id="book">
        <div class="section-header">
            <div class="section-badge"><t key="landing.booking.badge">Online Booking</t></div>
            <h2 class="section-title"><t key="landing.booking.title">Book Your Salon Appointment Online</t></h2>
            <p class="section-desc"><t key="landing.booking.subtitle">Find nearby salons, compare prices, and book appointments instantly. No phone calls needed.</t></p>
        </div>
        <div class="booking-features">
            <div class="booking-feature">
                <div class="booking-icon"><i class="bi bi-geo-alt-fill"></i></div>
                <h4><t key="landing.booking.find">Find Nearby Salons</t></h4>
                <p><t key="landing.booking.find.desc">Discover hair salons, beauty centers, and spas in your area with real-time availability.</t></p>
            </div>
            <div class="booking-feature">
                <div class="booking-icon"><i class="bi bi-calendar-check-fill"></i></div>
                <h4><t key="landing.booking.book">Book Instantly</t></h4>
                <p><t key="landing.booking.book.desc">Choose your service, pick a time slot, and confirm your appointment in seconds.</t></p>
            </div>
            <div class="booking-feature">
                <div class="booking-icon"><i class="bi bi-shield-check"></i></div>
                <h4><t key="landing.booking.safe">Safe & Secure</t></h4>
                <p><t key="landing.booking.safe.desc">Your personal data is never shared with salons you haven't joined. KVKK compliant.</t></p>
            </div>
        </div>
        <div class="booking-cta">
            <a href="https://sln.corplynk.com/discover" class="cta-btn cta-primary">
                <span><t key="landing.booking.cta">Discover Salons</t></span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </section>

    <!-- Tech Stack -->
    <section class="tech-section" id="about">
        <div class="section-header">
            <div class="section-badge"><t key="landing.tech.badge">Technology</t></div>
            <h2 class="section-title"><t key="landing.tech.title">Built with Modern Stack</t></h2>
            <p class="section-desc"><t key="landing.tech.subtitle">Enterprise-grade architecture with security and performance at its core.</t></p>
        </div>
        <div class="tech-grid">
            <div class="tech-item">
                <div class="tech-icon"><i class="bi bi-filetype-cs"></i></div>
                <span>.NET 10</span>
            </div>
            <div class="tech-item">
                <div class="tech-icon"><i class="bi bi-database"></i></div>
                <span>PostgreSQL</span>
            </div>
            <div class="tech-item">
                <div class="tech-icon"><i class="bi bi-lightning-charge"></i></div>
                <span>SignalR</span>
            </div>
            <div class="tech-item">
                <div class="tech-icon"><i class="bi bi-window"></i></div>
                <span>Blazor</span>
            </div>
            <div class="tech-item">
                <div class="tech-icon"><i class="bi bi-cloud"></i></div>
                <span>Google Cloud</span>
            </div>
            <div class="tech-item">
                <div class="tech-icon"><i class="bi bi-lock"></i></div>
                <span>AES-256</span>
            </div>
        </div>
    </section>

    <!-- Contact / Waitlist -->
    <section class="contact-section" id="contact">
        <div class="section-header">
            <div class="section-badge"><t key="landing.contact.badge">Stay Updated</t></div>
            <h2 class="section-title"><t key="landing.contact.title">Get Early Access</t></h2>
            <p class="section-desc"><t key="landing.contact.subtitle">Join our mailing list to get notified about updates, new features, and early access to our products.</t></p>
        </div>

        <div class="waitlist-card" id="waitlistForm">
            <form id="waitlistFormInner" class="waitlist-form" autocomplete="off">
                <input
                    type="email"
                    id="waitlistEmail"
                    class="waitlist-input"
                    placeholder="@T.T("landing.contact.placeholder", "Enter your email")"
                    required
                />
                <button type="submit" id="waitlistBtn" class="waitlist-btn">
                    <span id="waitlistBtnText"><t key="landing.contact.subscribe">Subscribe</t></span>
                    <span id="waitlistSpinner" class="spinner-border spinner-border-sm" role="status" style="display: none;"></span>
                    <i class="bi bi-arrow-right"></i>
                </button>
            </form>
            <div id="waitlistError" class="waitlist-error"></div>
            <div id="waitlistSuccess" class="waitlist-success">
                <div class="check-icon"><i class="bi bi-check-lg"></i></div>
                <h4><t key="landing.contact.success.title">You're on the list!</t></h4>
                <p><t key="landing.contact.success.desc">We'll keep you updated on all things CorpLynk.</t></p>
            </div>
        </div>

        <div class="social-proof" id="socialProof" style="display: none;">
            <div class="avatar-stack">
                <div class="avatar">A</div>
                <div class="avatar">M</div>
                <div class="avatar">S</div>
                <div class="avatar">+</div>
            </div>
            <span><t key="landing.contact.join">Join</t> <span class="count" id="waitlistCount">0</span> <t key="landing.contact.others">others</t></span>
        </div>
    </section>

    <!-- Footer -->
    <footer class="landing-footer">
        <div class="footer-top">
            <div class="footer-brand">
                <a href="@langPrefix" class="landing-brand">
                    <i class="bi bi-hexagon-fill"></i> CorpLynk
                </a>
                <p><t key="landing.footer.desc">Enterprise software solutions that connect businesses.</t></p>
            </div>
            <div class="footer-col">
                <h4><t key="landing.nav.products">Products</t></h4>
                <a href="@langPrefix/call-center"><t key="landing.cc.name">Cloud Call Center</t></a>
                <a href="https://sln.corplynk.com"><t key="landing.salon.name">Salon Management</t></a>
                <a href="@langPrefix/b2b-trade"><t key="landing.b2b.name">B2B Trade Platform</t></a>
                <a href="@langPrefix/download"><t key="landing.nav.download">Download</t></a>
            </div>
            <div class="footer-col">
                <h4><t key="landing.footer.company">Company</t></h4>
                <a href="#about"><t key="landing.nav.about">About</t></a>
                <a href="#contact"><t key="landing.nav.contact">Contact</t></a>
            </div>
            <div class="footer-col">
                <h4><t key="landing.footer.connect">Connect</t></h4>
                <a href="https://x.com/corplynkcmon" target="_blank" rel="noopener"><i class="bi bi-twitter-x"></i> Twitter</a>
                <a href="mailto:info@corplynk.com"><i class="bi bi-envelope"></i> Email</a>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 CorpLynk. Tum haklari saklidir.</p>
        </div>
    </footer>
</div>

@section Scripts {
    <script src="~/js/landing.js" asp-append-version="true"></script>
}
