@page
@model IndexModel
@{
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var langPrefix = $"/{currentCulture}";
}

<!-- Background -->
<div class="landing-bg">
    <div class="grid-overlay"></div>
</div>

<div class="landing-wrapper">
    <!-- Nav -->
    <nav class="landing-nav">
        <a href="@langPrefix" class="landing-brand">
            <i class="bi bi-hexagon-fill"></i> CorpLynk
        </a>
        <div class="landing-nav-links">
            <a href="#products"><t key="landing.nav.products">Products</t></a>
            <a href="#pricing">Fiyatlandırma</a>
            <a href="#book"><t key="landing.nav.booking">Book a Salon</t></a>
            <a href="@langPrefix/download"><t key="landing.nav.download">Download</t></a>
            <a href="#about"><t key="landing.nav.about">About</t></a>
            <a href="#contact"><t key="landing.nav.contact">Contact</t></a>
            <a href="https://cc.corplynk.com" class="nav-btn"><t key="landing.nav.signin">Sign In</t></a>
            <partial name="Shared/_LanguageSwitcher" />
        </div>
    </nav>

    <!-- Hero -->
    <main class="landing-main">
        <div class="landing-badge">
            <span class="dot"></span>
            <t key="landing.hero.badge">Enterprise Software Solutions</t>
        </div>

        <h1 class="landing-title">
            <t key="landing.hero.title1">All Your Tools,</t><br />
            <span class="gradient-text"><t key="landing.hero.title2">One Platform.</t></span>
        </h1>

        <p class="landing-subtitle">
            <t key="landing.hero.subtitle">We build software that connects businesses. Cloud call centers, salon management with online booking — CorpLynk provides the infrastructure your company needs to grow.</t>
        </p>

        <div class="hero-cta">
            <a href="#products" class="cta-btn cta-primary">
                <span><t key="landing.cta.explore">Explore Products</t></span>
                <i class="bi bi-arrow-down"></i>
            </a>
            <a href="#contact" class="cta-btn cta-outline">
                <span><t key="landing.cta.contact">Get in Touch</t></span>
            </a>
        </div>
    </main>

    <!-- Stats -->
    <section class="stats-section">
        <div class="stats-grid">
            <div class="stat-item">
                <div class="stat-number">2</div>
                <div class="stat-label"><t key="landing.stats.products">Products</t></div>
            </div>
            <div class="stat-item">
                <div class="stat-number">SIP</div>
                <div class="stat-label"><t key="landing.stats.voip">VoIP Ready</t></div>
            </div>
            <div class="stat-item">
                <div class="stat-number"><i class="bi bi-scissors"></i></div>
                <div class="stat-label"><t key="landing.stats.salon">Online Booking</t></div>
            </div>
            <div class="stat-item">
                <div class="stat-number">24/7</div>
                <div class="stat-label"><t key="landing.stats.cloud">Cloud Native</t></div>
            </div>
        </div>
    </section>

    <!-- Products -->
    <section class="products-section" id="products">
        <div class="section-header">
            <div class="section-badge"><t key="landing.products.badge">Our Products</t></div>
            <h2 class="section-title"><t key="landing.products.title">Two Platforms, One Vision</t></h2>
            <p class="section-desc"><t key="landing.products.subtitle">Enterprise-grade solutions designed to connect businesses and streamline operations.</t></p>
        </div>

        <div class="products-grid">
            <!-- Call Center -->
            <div class="product-card product-callcenter">
                <div class="product-icon-wrap">
                    <div class="product-icon">
                        <i class="bi bi-headset"></i>
                    </div>
                    <span class="product-status live">Live</span>
                </div>
                <h3 class="product-name"><t key="landing.cc.name">Cloud Call Center</t></h3>
                <p class="product-desc">
                    <t key="landing.cc.desc">Multi-tenant cloud call center with SIP integration, real-time dashboards, intelligent call routing, and encrypted call recordings.</t>
                </p>
                <div class="product-features">
                    <span class="product-tag"><i class="bi bi-telephone-forward"></i> SIP/WebRTC</span>
                    <span class="product-tag"><i class="bi bi-diagram-3"></i> ACD Routing</span>
                    <span class="product-tag"><i class="bi bi-shield-check"></i> KVKK</span>
                    <span class="product-tag"><i class="bi bi-graph-up"></i> Real-Time</span>
                    <span class="product-tag"><i class="bi bi-cloud"></i> Multi-Cloud</span>
                    <span class="product-tag"><i class="bi bi-people"></i> Multi-Tenant</span>
                </div>
                <div class="product-actions">
                    <a href="@langPrefix/call-center" class="product-btn primary">
                        <span><t key="landing.btn.learnmore">Learn More</t></span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                    <a href="https://cc.corplynk.com" class="product-btn outline" target="_blank">
                        <span><t key="landing.btn.openapp">Open App</t></span>
                        <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                </div>
            </div>

            <!-- Salon -->
            <div class="product-card product-salon">
                <div class="product-icon-wrap">
                    <div class="product-icon salon">
                        <i class="bi bi-scissors"></i>
                    </div>
                    <span class="product-status live">Live</span>
                </div>
                <h3 class="product-name"><t key="landing.salon.name">Salon Management</t></h3>
                <p class="product-desc">
                    <t key="landing.salon.desc">Complete salon management platform with appointments, POS, loyalty programs, online booking, staff management, and detailed reports.</t>
                </p>
                <div class="product-features">
                    <span class="product-tag"><i class="bi bi-calendar-check"></i> <t key="landing.salon.tag.appointments">Appointments</t></span>
                    <span class="product-tag"><i class="bi bi-credit-card"></i> POS</span>
                    <span class="product-tag"><i class="bi bi-star"></i> <t key="landing.salon.tag.loyalty">Loyalty</t></span>
                    <span class="product-tag"><i class="bi bi-globe"></i> <t key="landing.salon.tag.booking">Online Booking</t></span>
                    <span class="product-tag"><i class="bi bi-person-badge"></i> <t key="landing.salon.tag.staff">Staff</t></span>
                    <span class="product-tag"><i class="bi bi-bar-chart"></i> <t key="landing.salon.tag.reports">Reports</t></span>
                </div>
                <div class="product-actions">
                    <a href="https://sln.corplynk.com" class="product-btn primary">
                        <span><t key="landing.btn.learnmore">Learn More</t></span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                    <a href="https://sln.corplynk.com" class="product-btn outline" target="_blank">
                        <span><t key="landing.btn.openapp">Open App</t></span>
                        <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                </div>
            </div>

            <!-- B2B Trade — gizli, kendi sayfasi var -->
