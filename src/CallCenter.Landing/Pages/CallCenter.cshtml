@page "/call-center"
@model CallCenterModel
@{
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var langPrefix = $"/{currentCulture}";
}

@section Styles {
    <meta property="og:title" content="CorpLynk — Cloud Call Center" />
    <meta property="og:description" content="Multi-tenant cloud call center with SIP integration, real-time dashboards, and intelligent call routing." />
}

<!-- Background -->
<div class="landing-bg">
    <div class="grid-overlay"></div>
</div>

<div class="landing-wrapper">
    <!-- Nav -->
    <nav class="landing-nav">
        <a href="@langPrefix" class="landing-brand">
            <i class="bi bi-hexagon-fill"></i> CorpLynk
        </a>
        <div class="landing-nav-links">
            <a href="@langPrefix"><t key="landing.nav.home">Home</t></a>
            <a href="@langPrefix/b2b-trade">B2B Trade</a>
            <a href="#features"><t key="landing.nav.features">Features</t></a>
            <a href="@langPrefix/download"><t key="landing.nav.download">Download</t></a>
            <a href="https://cc.corplynk.com" class="nav-btn"><t key="landing.btn.openapp">Open App</t></a>
            <partial name="Shared/_LanguageSwitcher" />
        </div>
    </nav>

    <!-- Hero -->
    <main class="landing-main">
        <div class="landing-badge">
            <span class="dot"></span>
            Live
        </div>

        <h1 class="landing-title">
            Cloud Call Center,<br />
            <span class="gradient-text">Reimagined.</span>
        </h1>

        <p class="landing-subtitle">
            Multi-tenant cloud call center with SIP integration, real-time dashboards,
            and intelligent call routing. Built for businesses of all sizes.
        </p>

        <div class="hero-cta">
            <a href="https://cc.corplynk.com" class="cta-btn cta-primary" target="_blank">
                <span>Launch App</span>
                <i class="bi bi-box-arrow-up-right"></i>
            </a>
            <a href="/download" class="cta-btn cta-outline">
                <i class="bi bi-download"></i>
                <span>Download</span>
            </a>
        </div>
    </main>

    <!-- How it Works -->
    <section class="how-section">
        <div class="section-header">
            <div class="section-badge">How It Works</div>
            <h2 class="section-title">Three Steps to Go Live</h2>
        </div>
        <div class="steps-grid">
            <div class="step-card">
                <div class="step-number">1</div>
                <h4>Connect Your SIP</h4>
                <p>Add your SIP trunk, gateway, or use WebRTC directly from the browser. Any provider works.</p>
            </div>
            <div class="step-arrow"><i class="bi bi-arrow-right"></i></div>
            <div class="step-card">
                <div class="step-number">2</div>
                <h4>Set Up Queues</h4>
                <p>Create call queues, assign agents with priorities, and configure routing strategies.</p>
            </div>
            <div class="step-arrow"><i class="bi bi-arrow-right"></i></div>
            <div class="step-card">
                <div class="step-number">3</div>
                <h4>Start Taking Calls</h4>
                <p>Agents log in via browser or desktop app and begin handling calls with real-time monitoring.</p>
            </div>
        </div>
    </section>

    <!-- Features -->
    <section class="features-section" id="features">
        <div class="section-header">
            <div class="section-badge">Features</div>
            <h2 class="section-title">Everything You Need</h2>
            <p class="section-desc">A complete call center solution with enterprise-grade features.</p>
        </div>

        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon"><i class="bi bi-telephone-forward"></i></div>
                <h3 class="feature-title">SIP Integration</h3>
                <p class="feature-desc">Connect SIP trunks, gateways (GoIP), and softphones. WebRTC support for browser-based calling via SIP.js.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="bi bi-people"></i></div>
                <h3 class="feature-title">Multi-Tenant</h3>
                <p class="feature-desc">Each customer gets isolated queues, agents, SIP accounts, and dashboards. Full data separation.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="bi bi-graph-up"></i></div>
                <h3 class="feature-title">Real-Time Dashboard</h3>
                <p class="feature-desc">Live agent status, queue metrics, and call statistics. SignalR-powered instant updates across all clients.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="bi bi-diagram-3"></i></div>
                <h3 class="feature-title">Smart Routing (ACD)</h3>
                <p class="feature-desc">Automatic call distribution with priority-based and least-busy agent strategies. Queue overflow handling.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="bi bi-shield-check"></i></div>
                <h3 class="feature-title">KVKK / GDPR</h3>
                <p class="feature-desc">AES-256 encrypted recordings, comprehensive audit logs, data retention policies, and consent management.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="bi bi-cloud"></i></div>
                <h3 class="feature-title">Cloud Storage</h3>
                <p class="feature-desc">S3, MinIO, Google Drive, OneDrive, Yandex Disk. Bring your own storage provider for call recordings.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="bi bi-window-stack"></i></div>
                <h3 class="feature-title">Multi-Platform</h3>
                <p class="feature-desc">Web app for office agents, Windows desktop for supervisors, mobile app for field staff. One codebase.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="bi bi-key"></i></div>
                <h3 class="feature-title">Granular Permissions</h3>
                <p class="feature-desc">Module-based access control with 14 modules, 32 permission types, and scope levels (All/Own/Customer).</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon"><i class="bi bi-journal-text"></i></div>
                <h3 class="feature-title">Audit Trail</h3>
                <p class="feature-desc">Every action logged with old/new values, IP address, user agent. PostgreSQL partitioned for performance.</p>
            </div>
        </div>
    </section>

    <!-- Platforms -->
    <section class="platforms-section">
        <div class="section-header">
            <div class="section-badge">Platforms</div>
            <h2 class="section-title">Available Everywhere</h2>
        </div>
        <div class="platforms-grid">
            <div class="platform-card">
                <div class="platform-icon"><i class="bi bi-globe2"></i></div>
                <h4>Web Browser</h4>
                <p>Blazor WebAssembly — works in any modern browser. SIP.js for WebRTC calling.</p>
                <span class="platform-tag">Office Agents</span>
            </div>
            <div class="platform-card">
                <div class="platform-icon"><i class="bi bi-pc-display"></i></div>
                <h4>Windows Desktop</h4>
                <p>WPF + Blazor Hybrid with native SIP via SIPSorcery. System tray, hotkeys, call recording.</p>
                <span class="platform-tag">Supervisors</span>
            </div>
            <div class="platform-card">
                <div class="platform-icon"><i class="bi bi-phone"></i></div>
                <h4>Android Mobile</h4>
                <p>React Native with push-based architecture. FCM for incoming calls, foreground service during active calls.</p>
                <span class="platform-tag">Field Staff</span>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="contact-section" id="contact">
        <div class="section-header">
            <h2 class="section-title">Ready to Get Started?</h2>
            <p class="section-desc">Access the cloud call center platform now.</p>
        </div>
        <div class="hero-cta" style="justify-content: center;">
            <a href="https://cc.corplynk.com" class="cta-btn cta-primary" target="_blank">
                <span>Open CorpLynk Call Center</span>
                <i class="bi bi-box-arrow-up-right"></i>
            </a>
            <a href="mailto:info@corplynk.com" class="cta-btn cta-outline">
                <span>Contact Sales</span>
            </a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="landing-footer">
        <div class="footer-top">
            <div class="footer-brand">
                <a href="@langPrefix" class="landing-brand">
                    <i class="bi bi-hexagon-fill"></i> CorpLynk
                </a>
                <p><t key="landing.footer.desc">Enterprise software solutions that connect businesses.</t></p>
            </div>
            <div class="footer-col">
                <h4><t key="landing.nav.products">Products</t></h4>
                <a href="@langPrefix/call-center"><t key="landing.cc.name">Cloud Call Center</t></a>
                <a href="https://sln.corplynk.com"><t key="landing.salon.name">Salon Management</t></a>
                <a href="@langPrefix/b2b-trade"><t key="landing.b2b.name">B2B Trade Platform</t></a>
                <a href="@langPrefix/download"><t key="landing.nav.download">Download</t></a>
            </div>
            <div class="footer-col">
                <h4><t key="landing.footer.connect">Connect</t></h4>
                <a href="https://x.com/corplynkcmon" target="_blank" rel="noopener"><i class="bi bi-twitter-x"></i> Twitter</a>
                <a href="mailto:info@corplynk.com"><i class="bi bi-envelope"></i> Email</a>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 CorpLynk. Tum haklari saklidir.</p>
        </div>
    </footer>
</div>
