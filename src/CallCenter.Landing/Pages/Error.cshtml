@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="landing-bg">
    <div class="grid-overlay"></div>
</div>
<div class="landing-wrapper">
    <div class="landing-main">
        <h1 class="landing-title">Oops!</h1>
        <p class="landing-subtitle">Something went wrong. Please try again later.</p>
        <a href="/" class="waitlist-btn" style="display: inline-flex; text-decoration: none;">
            <span>Go Home</span>
            <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</div>
